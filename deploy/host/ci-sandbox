#!/bin/sh
# CI for nodes on a shared Linux host, without Docker (the node's
# --ci-sandbox): what the pantheon:dev container gives a check, from the host's
# own toolchain.
#
#   ci-sandbox MEMORY CHECKOUT CMD      e.g. ci-sandbox 1536m /tmp/pantheon-check.x 'soma build main.soma'
#
# CMD runs on a copy of CHECKOUT, in bubblewrap: no network, nothing of the
# host's but /usr and the few /etc files a build reads (read-only), Soma's build and its OCaml switches
# (read-only; opam's log directory, which opam writes even to list a
# switch, is a scratch one), and a fresh /tmp. The nodes' homes, keys included, aren't in
# it: what CI prints goes on the chain, in a rejection. A systemd user scope
# holds it to MEMORY with no swap; a build killed for memory ends as 137, as
# a container's does, so the node says CI went over its memory budget.
#
# One check at a time on the whole host, every node's: they wait for
# CI_LOCK (default ~/pantheon/.ci-lock). Four nodes' builds at once could take
# more memory than a small host has.
#
# SOMA_DIR is Soma's checkout (default ~/pantheon/soma). CI_PANTHEON, if
# set, is a Pantheon checkout a check reads at /pantheon (read-only): Soma's
# CI builds it with the bid's Soma (scripts/host.sh soma_ci_cmd). Needs bwrap, flock, a user
# systemd with the memory controller (cgroup v2), and unprivileged user
# namespaces.
set -eu
# the node keeps only a runner's stdout: its own errors go there too
exec 2>&1
[ $# -eq 3 ] || { echo "ci-sandbox: usage: ci-sandbox MEMORY CHECKOUT CMD" >&2; exit 2; }
mem=$1 work=$2 cmd=$3
# Docker's sizes (1536m, 3g) in systemd's spelling (1536M, 3G)
mem=$(printf '%s' "$mem" | tr kmgt KMGT)
soma=${SOMA_DIR:-$HOME/pantheon/soma}
# a diplomat's check (its own user) builds with the node user's opam root and
# switch, read-only: CI_OPAMROOT and CI_SWITCH name them
opam=${CI_OPAMROOT:-$HOME/.opam}
switch=${CI_SWITCH:-$HOME/.cache/soma/ocaml}
# --ro-bind-try: no CI_PANTHEON, no /pantheon
pantheon=${CI_PANTHEON:-/nonexistent/pantheon}
for p in "$soma/_build/install/default/bin/soma" "$opam" "$switch"; do
  [ -e "$p" ] || { echo "ci-sandbox: no $p: build Soma and Pantheon on this host first (scripts/setup-node.sh)"; exit 3; }
done
for tool in bwrap flock setpriv systemd-run; do
  command -v "$tool" >/dev/null || { echo "ci-sandbox: no $tool: install bubblewrap, util-linux and systemd"; exit 3; }
done
# The lock is held on descriptor 9 by this process, which becomes the
# scope's shell below; bwrap gets no descriptor 9 (9>&-), so a check can't
# unlock it and run builds beside other nodes' checks (docs/SECURITY-REVIEW-2.md
# P-15). The shell is outside the sandbox's pid namespace, and the lock file
# isn't in it.
lock=${CI_LOCK:-$HOME/pantheon/.ci-lock}
# a lock another user owns (the node user's, for a diplomat) is locked read-only
if [ -e "$lock" ] && [ ! -w "$lock" ]; then exec 9<"$lock"; else exec 9>>"$lock"; fi
wait=${CI_LOCK_WAIT:-900}
case "$wait" in ''|*[!0-9]*) echo "ci-sandbox: CI_LOCK_WAIT is 0 to 900 seconds"; exit 3 ;; esac
[ "${#wait}" -le 3 ] && [ "$wait" -le 900 ] || { echo "ci-sandbox: CI_LOCK_WAIT exceeds 900 seconds"; exit 3; }
# Waiting is a child process too: cancel it if the runner is killed before
# the exec into systemd's scope. The parent check closes the setup race when
# death preceded installation of the kernel parent-death signal.
setpriv --pdeathsig KILL sh -c '
  [ "$PPID" = "$1" ] || exit 75
  exec flock -w "$2" -E 75 9
' ci-lock "$$" "$wait" || { echo "ci-sandbox: build lock unavailable after ${wait}s"; exit 75; }
# systemd-run's scope ends when its command does; the command reads its own
# cgroup's oom_kill count before that, to tell a kill for memory from a failure
exec systemd-run --user --scope --quiet --collect -p "MemoryMax=$mem" -p MemorySwapMax=0 -p TasksMax=512 -- \
  sh -c '
    soma=$1 switch=$2 work=$3 cmd=$4 opam=$5 pantheon=$6
    # only the /etc files a build reads, not the host /etc and the secrets it may
    # hold (docs/SECURITY-REVIEW-2.md P-12): names, the loader, the time zone,
    # and Debian'\''s alternatives (/usr/bin/awk is a link through them)
    etc=
    for f in passwd group nsswitch.conf ld.so.cache ld.so.conf ld.so.conf.d localtime alternatives; do
      etc="$etc --ro-bind-try /etc/$f /etc/$f"
    done
    # "( $cmd" with a space, and ")" on a line of its own: CMD starts with "("
    # (the node wraps it), and where sh is bash, as on Fedora, "((" starts
    # arithmetic; and a CMD ending in a comment would swallow the ")"
    cg=/sys/fs/cgroup$(sed -n "s/^0:://p" /proc/self/cgroup)
    bwrap --unshare-all --die-with-parent --new-session --cap-drop ALL \
      --ro-bind /usr /usr $etc \
      --symlink usr/bin /bin --symlink usr/sbin /sbin --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
      --proc /proc --dev /dev --tmpfs /tmp \
      --ro-bind "$soma" "$soma" --ro-bind "$opam" "$opam" --ro-bind "$switch" "$switch" \
      --tmpfs "$opam/log" \
      --ro-bind "$work" /work --ro-bind-try "$pantheon" /pantheon \
      --clearenv --setenv HOME /tmp --setenv XDG_CACHE_HOME /tmp/cache --setenv OPAMROOT "$opam" \
      --setenv SOMA_OCAML_SWITCH "$switch" --setenv PATH "$soma/_build/install/default/bin:/usr/bin:/bin" \
      --setenv LANG C.UTF-8 --chdir /tmp \
      sh -c "cp -R /work /tmp/w && cd /tmp/w && ( $cmd
) 2>&1" 9>&-
    r=$?
    if [ $r -ne 0 ] && grep -qs "oom_kill [1-9]" "$cg/memory.events"; then exit 137; fi
    exit $r' ci-sandbox "$soma" "$switch" "$work" "$cmd" "$opam" "$pantheon"
