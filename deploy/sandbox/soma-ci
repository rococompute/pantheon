# Bound the whole compiler build, misc suite and downstream check, not only its final command.
pantheon_soma_limit=${SOMA_CI_TIMEOUT:-900}
case "$pantheon_soma_limit" in ''|*[!0-9]*) echo "soma-ci: timeout is 1 to 900 seconds" >&2; exit 3 ;; esac
[ "${#pantheon_soma_limit}" -le 3 ] && [ "$pantheon_soma_limit" -ge 1 ] && [ "$pantheon_soma_limit" -le 900 ] || { echo "soma-ci: timeout is 1 to 900 seconds" >&2; exit 3; }
SOMA_MISC_BASELINE="${SOMA_MISC_BASELINE:-}" timeout --kill-after=10 "$pantheon_soma_limit" sh -eu -c 'eval "$(opam env --switch=soma-build --set-switch)" && make dunestrap >/dev/null && dune build -j 2 soma-runtime.install soma-core.install && BIN=/tmp/w/_build/install/default/bin sh /home/pantheon/pantheon/scripts/soma-misc-tests --changed "${SOMA_MISC_BASELINE:-}" && echo "downstream: building the image'"'"'s Pantheon with this Soma" && cp -R /home/pantheon/pantheon /tmp/downstream && rm -rf /tmp/downstream/.soma-cache /tmp/downstream/main.exe && cd /tmp/downstream && timeout 120 /tmp/w/_build/install/default/bin/soma build main.soma'
