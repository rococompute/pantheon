(** Pantheon: a private, Byzantine-fault-tolerant labor market where LLM
    agents take turns as term leader. cli.soma runs the commands and
    node.soma decides the market; shell.ml does their I/O. *)
Import util shell node cli node_shell.

(** Numbers run as OCaml ints. The kernel and the proofs still see Peano
    naturals: these only say how extracted code computes them. With them,
    Soma extracts Nat's comparisons and division and String's length, get
    and substring as OCaml's (its somaOcaml.ml, extracts_nat_as_int), as it
    does for an image: util.soma reads long text through them, each as
    total as its definition (offsets past the end give [None] or an empty
    string), and node_net.soma's frames are Soma.Wire's, taken by offset. *)
From Stdlib Require ExtrOcamlNatInt.

(** The stores' maps (nodeio.soma's smap) order keys by [String.compare]:
    OCaml's comparison of strings is the same order, byte by byte, without
    taking the strings apart a character at a time. *)
Extract Inlined Constant Stdlib.Strings.String.compare =>
  "(fun a b -> let c = Stdlib.compare (a : string) b in if c < 0 then Lt else if c = 0 then Eq else Gt)".

(** The hashes are Soma's (util.soma, Soma.Crypto): the kernel computes
    them, the unikernel runs them. The binary runs Cryptokit's, the same
    function in C, about ten times faster than Soma's extracted SHA-256
    (test/nio_tables.soma checks the two agree). *)
Extract Constant util.sha256 => "Shell.sha256".
Extract Constant util.hash_list => "Shell.hash_list".
(** So is signing (nodeio.soma's nio_sign, Soma's RSA, about 12 ms a
    signature): Cryptokit's PKCS#1 v1.5 signature with the same key is
    the same bytes, about ten times faster. A node signs each peer line
    and transaction it sends. *)
Extract Constant nodeio.nio_sign =>
  "(fun k m -> Shell.rsa_sign_bytes k.nk_bytes (Obj.magic k.nk_n) (Obj.magic k.nk_e) (Obj.magic k.nk_p) (Obj.magic k.nk_q) (Obj.magic k.nk_dp) (Obj.magic k.nk_dq) (Obj.magic k.nk_qinv) m)".

(** Every command but [node] and [service] is a node program (cli.soma),
    run through the shell's node_io; [node] is node.soma's loop, [service]
    its service's. *)
dispatch (args : list string) : unit :=
  match args with
  | "node" :: home :: flags => run_node home flags
  | "service" :: home :: addr :: flags => run_service home addr flags
  | _ => run_shell "cli" (cli_prog args)
  end.

main := dispatch (argv tt).
