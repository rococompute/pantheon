(** Pantheon: a private, Byzantine-fault-tolerant labor market where LLM
    agents take turns as term leader. Soma selects commands and node.soma decides the market;
    shell.ml supplies command implementations and I/O. *)
Import util shell node.

(** Numbers run as OCaml ints. The kernel and the proofs still see Peano
    naturals: these only say how extracted code computes them. *)
From Stdlib Require ExtrOcamlNatInt.
Extract Inlined Constant Nat.div => "(fun a b -> if b = 0 then 0 else a / b)".
Extract Inlined Constant Nat.modulo => "(fun a b -> if b = 0 then a else a mod b)".

(** Strings run as OCaml's (ExtrOcamlNativeString), which leaves out the
    operations that count in [nat]. With [nat] as OCaml ints they're
    OCaml's own, each as total as its definition: offsets past the end give
    [None] or an empty string. util.soma reads long text through them. *)
Extract Inlined Constant Stdlib.Strings.String.length => "String.length".
Extract Inlined Constant Stdlib.Strings.String.get =>
  "(fun n s -> if n < String.length s then Some (String.unsafe_get s n) else None)".
Extract Inlined Constant Stdlib.Strings.String.substring =>
  "(fun n m s -> let l = String.length s in if n >= l then """" else String.sub s n (min m (l - n)))".

(** The hashes are Soma's (util.soma, Soma.Crypto): the kernel computes
    them, the unikernel runs them. The binary runs Cryptokit's, the same
    function in C, about ten times faster than Soma's extracted SHA-256
    (test/nio_tables.soma checks the two agree). *)
Extract Constant util.sha256 => "Shell.sha256".
Extract Constant util.hash_list => "Shell.hash_list".

usage : string := "pantheon: a private BFT labor market where LLM agents take turns as term leader.

  One machine:
  pantheon init DIR --repo NAME=GIT-CHECKOUT [--repo ...] [--base-port P] [--block-ms N] [--param name=value]...
  pantheon up DIR [--backends claude=claude,codex=codex,grok=grok,muse=scripted] [node flags]

  One machine per agent (see docs/NETWORK.md):
  pantheon keygen HOME --name NAME --addr HOST:PORT     then add HOME/public.json to NETWORK/parts/
  pantheon genesis HOME NETWORK                         once all 4 parts are in

  pantheon node HOME [--backend B] [--behavior honest|deny|silent] [--goal FILE] [--deny PATH] [--listen HOST]
                     [--ci CMD] [--ci-repo NAME CMD] [--ci-image IMAGE | --ci-sandbox PROGRAM] [--ci-memory 8g] [--bid-window N] [--perspective TEXT] [--max-llm-calls N]
  pantheon status HOME
  pantheon tx HOME post REPO ""spec"" [CONTEXT-PATH...]   (or any market transaction's fields)
  pantheon edits CHECKOUT [NOTE]     a checkout's changes as a patch reply (for models with tools)
  pantheon plan [FILE]              a .plan's open items (default ./.plan; see docs/PLAN.md)
  pantheon apply-edits DIR EDITS.json

Backends: scripted, claude, codex, grok (XAI_API_KEY), cmd:PROGRAM (prompt on stdin, JSON reply on stdout;
a patch request also gets a scratch checkout in $PANTHEON_WORKTREE: see scripts/bidder.sh).
".

dispatch (args : list string) : unit :=
  match args with
  | "init" :: rest => cmd_init (pack_helpers node_helpers) rest
  | "keygen" :: rest => cmd_keygen rest
  | ["genesis", home, net] => cmd_genesis (pack_helpers node_helpers) home net
  | "edits" :: dir :: rest => cmd_edits (pack_helpers node_helpers) dir rest
  | ["plan"] => print_lines (plan_open (read_plan ".plan"))
  | ["plan", file] => print_lines (plan_open (read_plan file))
  | ["apply-edits", dir, file] => cmd_apply_edits (pack_helpers node_helpers) dir file
  | ["check", repo, head, file, out] => cmd_check (pack_helpers node_helpers) repo head file out
  | ["status", home] => cmd_status home
  | "tx" :: home :: field :: rest => cmd_tx home (field :: rest)
  | "up" :: dir :: rest => cmd_up dir rest
  | "node" :: home :: flags => run_node home flags
  | _ => print_text usage
  end.

main := dispatch (argv tt).
