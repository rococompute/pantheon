(** Pantheon: a private, Byzantine-fault-tolerant labor market where LLM
    agents take turns as term leader. cli.soma runs the commands and
    node.soma decides the market; Soma.Host does their I/O. *)
Import util node cli node_shell.
Require Soma.Host.

(** The hashes and signatures are Soma's (util.soma's sha256 and
    hash_list, nodeio.soma's nio_sign, through Soma.Crypto): the kernel
    computes them, and the binary and the unikernel run them. *)

(** Every command but [node] and [service] is a node program (cli.soma),
    run over Soma.Host's primitives (node_shell.soma's run_shell); [node] is node.soma's loop, [service]
    its service's. *)
dispatch (args : list string) : unit :=
  match args with
  | "node" :: home :: flags => run_node home flags
  | "service" :: home :: addr :: flags => run_service home addr flags
  | _ => run_shell (cli_prog args)
  end.

main := dispatch (Host.argv tt).
