(** What is proved about the market, so far. Each theorem is checked whenever
    market.soma is built. docs/PROOFS.md lists what to prove next. *)

(** The leader supplies one approval; fallback supplies at most one more. *)
Theorem without_fallback_attestors_must_approve :
  forall (n : nat) (p : proposal) (age : nat),
    quorum n <= approvals p age 0 ->
    quorum n - 1 <= length (filter snd (pvotes p)).
Proof.
  intros n p age H. unfold approvals in H. simpl in H. lia.
Qed.

Theorem fallback_attestors_must_approve :
  forall (n : nat) (p : proposal) (age fb : nat),
    quorum n <= approvals p age fb ->
    quorum n - 2 <= length (filter snd (pvotes p)).
Proof.
  intros n p age fb H. unfold approvals in H.
  destruct ((0 <? fb) && (fb <=? age)); simpl in H; lia.
Qed.

(** Pure quorum regressions, including the seven-agent scenario and the
    current eight-agent deployment: approvals, rejecting no votes, reveals. *)
Example quorum_four : (quorum 4, reject_quorum 4, quorum 4) = (3, 2, 3).
Proof. reflexivity. Qed.
Example quorum_seven : (quorum 7, reject_quorum 7, quorum 7) = (5, 3, 5).
Proof. reflexivity. Qed.
Example quorum_eight : (quorum 8, reject_quorum 8, quorum 8) = (6, 3, 6).
Proof. reflexivity. Qed.
Example quorum_one : (quorum 1, reject_quorum 1, quorum 1) = (1, 1, 1).
Proof. reflexivity. Qed.

(** The threshold decisions at, just below and just above each threshold,
    for n = 1, 4, 7 and 8: approvals, no votes, and reveals (after the
    window; before it, only all n). *)
Example thresholds_one :
  map (approved_at 1) [0, 1, 2] = [false, true, true] /\
  map (rejected_at 1) [0, 1, 2] = [false, true, true] /\
  map (fun k => draw_ready 1 k true) [0, 1, 2] = [false, true, true] /\
  map (fun k => draw_ready 1 k false) [0, 1] = [false, true].
Proof. repeat split; reflexivity. Qed.
Example thresholds_four :
  map (approved_at 4) [2, 3, 4] = [false, true, true] /\
  map (rejected_at 4) [1, 2, 3] = [false, true, true] /\
  map (fun k => draw_ready 4 k true) [2, 3, 4] = [false, true, true] /\
  map (fun k => draw_ready 4 k false) [3, 4] = [false, true].
Proof. repeat split; reflexivity. Qed.
Example thresholds_seven :
  map (approved_at 7) [4, 5, 6] = [false, true, true] /\
  map (rejected_at 7) [2, 3, 4] = [false, true, true] /\
  map (fun k => draw_ready 7 k true) [4, 5, 6] = [false, true, true] /\
  map (fun k => draw_ready 7 k false) [5, 6, 7] = [false, false, true].
Proof. repeat split; reflexivity. Qed.
Example thresholds_eight :
  map (approved_at 8) [5, 6, 7] = [false, true, true] /\
  map (rejected_at 8) [2, 3, 4] = [false, true, true] /\
  map (fun k => draw_ready 8 k true) [5, 6, 7] = [false, true, true] /\
  map (fun k => draw_ready 8 k false) [6, 7, 8] = [false, false, true].
Proof. repeat split; reflexivity. Qed.

(** The other roster sizes the network runs at, the current six among them:
    n = 2 and 3 tolerate no fault (every agent approves, one no rejects); 5
    and 6 tolerate one, so 4 and 5 approvals merge and 2 no votes reject. *)
Example thresholds_two :
  (quorum 2, reject_quorum 2) = (2, 1) /\
  map (approved_at 2) [1, 2] = [false, true] /\
  map (rejected_at 2) [0, 1] = [false, true] /\
  map (fun k => draw_ready 2 k true) [1, 2] = [false, true].
Proof. repeat split; reflexivity. Qed.
Example thresholds_three :
  (quorum 3, reject_quorum 3) = (3, 1) /\
  map (approved_at 3) [2, 3] = [false, true] /\
  map (rejected_at 3) [0, 1] = [false, true] /\
  map (fun k => draw_ready 3 k true) [2, 3] = [false, true].
Proof. repeat split; reflexivity. Qed.
Example thresholds_five :
  (quorum 5, reject_quorum 5) = (4, 2) /\
  map (approved_at 5) [3, 4, 5] = [false, true, true] /\
  map (rejected_at 5) [1, 2, 3] = [false, true, true] /\
  map (fun k => draw_ready 5 k true) [3, 4, 5] = [false, true, true] /\
  map (fun k => draw_ready 5 k false) [4, 5] = [false, true].
Proof. repeat split; reflexivity. Qed.
Example thresholds_six :
  (quorum 6, reject_quorum 6) = (5, 2) /\
  map (approved_at 6) [4, 5, 6] = [false, true, true] /\
  map (rejected_at 6) [1, 2, 3] = [false, true, true] /\
  map (fun k => draw_ready 6 k true) [4, 5, 6] = [false, true, true] /\
  map (fun k => draw_ready 6 k false) [5, 6] = [false, true].
Proof. repeat split; reflexivity. Qed.

(** Each threshold, for every n, is exactly where the decision turns: below
    it no, at or above it yes. *)
Theorem approved_at_exactly : forall n k : nat, approved_at n k = true <-> quorum n <= k.
Proof. intros n k. unfold approved_at. apply Nat.leb_le. Qed.

Theorem rejected_at_exactly : forall n k : nat, rejected_at n k = true <-> reject_quorum n <= k.
Proof. intros n k. unfold rejected_at. apply Nat.leb_le. Qed.

Theorem draw_after_window_exactly : forall n k : nat, k <= n ->
  draw_ready n k true = true <-> quorum n <= k.
Proof.
  intros n k Hk. unfold draw_ready. simpl. split.
  - intros H. apply Bool.orb_true_iff in H. destruct H as [H | H].
    + apply Nat.eqb_eq in H. subst k. unfold quorum. lia.
    + apply Nat.leb_le in H. exact H.
  - intros H. apply Bool.orb_true_iff. right. apply Nat.leb_le. exact H.
Qed.

(** Inside the reveal window only every agent's reveal draws. *)
Theorem draw_inside_window_exactly : forall n k : nat,
  draw_ready n k false = true <-> k = n.
Proof.
  intros n k. unfold draw_ready. simpl. rewrite Bool.orb_false_r. apply Nat.eqb_eq.
Qed.

(** f = (n-1)/3 is the most faults n agents tolerate: 3f < n. *)
Lemma faults_spec : forall n : nat, 3 * faults n <= n - 1.
Proof.
  intros n. unfold faults.
  assert (H3 : 3 <> 0) by lia.
  pose proof (Nat.div_mod (n - 1) 3 H3) as D.
  pose proof (Nat.mod_upper_bound (n - 1) 3 H3) as M.
  lia.
Qed.

(** An approval quorum and a rejecting quorum together are more than n, so
    for any n the two can't both be reached by n distinct voters. *)
Theorem quorum_plus_reject : forall n : nat, quorum n + reject_quorum n = n + 1.
Proof.
  intros n. pose proof (faults_spec n). unfold quorum, reject_quorum. lia.
Qed.

(** Two approval quorums of n - f share at least f + 1 agents, so with at
    most f faulty, an honest one is in both. *)
Theorem approval_quorums_intersect_in_an_honest_agent : forall n : nat,
  1 <= n -> n + reject_quorum n <= 2 * quorum n.
Proof.
  intros n Hn. pose proof (faults_spec n). unfold quorum, reject_quorum. lia.
Qed.

Theorem approved_and_rejected_exclusive : forall n yes no : nat,
  yes + no <= n -> approved_at n yes = true -> rejected_at n no = true -> False.
Proof.
  intros n yes no H Ha Hr. unfold approved_at, rejected_at in *.
  apply Nat.leb_le in Ha. apply Nat.leb_le in Hr.
  pose proof (quorum_plus_reject n). lia.
Qed.

Lemma votes_split : forall vs : list (string * bool),
  length (filter snd vs) + length (filter (fun v => negb (snd v)) vs) = length vs.
Proof.
  induction vs as [|[a b] vs IH]; simpl; [reflexivity|].
  destruct b; simpl; lia.
Qed.

(** settle's two outcomes exclude each other for every n: when the
    attestors are at most n - 2 (the leader and the bidder don't attest),
    a proposal can't have both n - f approvals, fallback or not, and
    f + 1 no votes. *)
Theorem merge_never_both_approved_and_rejected : forall (n : nat) (p : proposal) (age fb : nat),
  length (pvotes p) + 2 <= n ->
  quorum n <= approvals p age fb ->
  reject_quorum n <= length (filter (fun v => negb (snd v)) (pvotes p)) -> False.
Proof.
  intros n p age fb Hl Hy Hn.
  pose proof (quorum_plus_reject n). pose proof (votes_split (pvotes p)).
  unfold approvals in Hy.
  destruct ((0 <? fb) && (fb <=? age)); simpl in Hy; lia.
Qed.

(** Up to f silent agents can't stop a draw: n - k reveals with k <= f
    are enough once the window has passed. *)
Theorem draw_goes_on_with_f_silent : forall n k : nat,
  k <= faults n -> draw_ready n (n - k) true = true.
Proof.
  intros n k Hk. unfold draw_ready, quorum.
  destruct (n - k =? n); [reflexivity|]. simpl.
  apply Nat.leb_le. lia.
Qed.

(** The same thresholds through settle and maybe_draw themselves, at
    n = 7 (f = 2): the leader's proposal plus three yes votes (four
    approvals) does not merge, plus four (five approvals) does; two no
    votes do not reject, three do; four reveals do not draw, five do.
    Checked here, in the build, rather than in a separate program a CI
    run must compile on top of it. *)
Definition q7_agents : list string := ["a1", "a2", "a3", "a4", "a5", "a6", "a7"].

Definition q7_base : obj :=
  let m := new_market q7_agents in
  let m := setf m "leader" "a1" in
  let m := setf m "h" 10 in
  let m := setf m "repos" ([("calc", "tree0")] : list (string * string)) in
  setf m "awaiting" false.

Definition q7_bidder (m : obj) : string :=
  match task_by m 1 with
  | Some t => match bidders_for m t with a :: _ => a | [] => "" end
  | None => ""
  end.

Definition q7_proposed : obj :=
  let '(m, _, _) := apply q7_base "a1" ["post", "calc", "seven agent task"] in
  let '(m, _, _) := apply m (q7_bidder m) ["bid", "1", "0", "seven bid", "f.txt", "", "x"] in
  let '(m, _, _) := apply m "a1" ["merge", "1", "tree1"] in m.

Definition q7_attestors : list string :=
  filter (fun a => negb (seq a "a1") && negb (seq a (q7_bidder q7_proposed))) q7_agents.

Definition q7_attest (who : list string) (vote : string) : obj :=
  fold_left (fun m a => fst (fst (apply m a (if seq vote "yes" then ["attest", "1", "yes", "tree1"] else ["attest", "1", "no"])))) who q7_proposed.

Definition q7_status (m : obj) : string :=
  match bid_by m 1 with Some b => status_name (bst b) | None => "none" end.

Example q7_five_attestors : length q7_attestors = 5.
Proof. reflexivity. Qed.
Example q7_three_yes_do_not_merge : q7_status (q7_attest (firstn 3 q7_attestors) "yes") = "pending".
Proof. reflexivity. Qed.
Example q7_four_yes_merge : q7_status (q7_attest (firstn 4 q7_attestors) "yes") = "merged".
Proof. reflexivity. Qed.
Example q7_two_no_do_not_reject : q7_status (q7_attest (firstn 2 q7_attestors) "no") = "pending".
Proof. reflexivity. Qed.
Example q7_three_no_reject : q7_status (q7_attest (firstn 3 q7_attestors) "no") = "rejected".
Proof. reflexivity. Qed.

Definition q7_draw (k : nat) : obj :=
  let m := setf q7_base "leader" "" in
  let m := setf m "awaiting" true in
  let m := setf m "asince" 0 in
  let m := setf m "h" 100 in
  setf m "reveals" (map (fun a => (a, append "v-" a)) (firstn k q7_agents)).

Example q7_four_reveals_do_not_draw : awaiting (maybe_draw (q7_draw 4)) = true.
Proof. reflexivity. Qed.
Example q7_five_reveals_draw : awaiting (maybe_draw (q7_draw 5)) = false.
Proof. reflexivity. Qed.
(** inside reveal_window, five of seven wait for the other two; all seven
    draw at once *)
Example q7_five_reveals_wait_inside_the_window : awaiting (maybe_draw (setf (q7_draw 5) "h" 5)) = true.
Proof. reflexivity. Qed.
Example q7_seven_reveals_draw_at_once : awaiting (maybe_draw (setf (q7_draw 7) "h" 5)) = false.
Proof. reflexivity. Qed.

(** Holding back your link in one draw bars you from the next, as long as
    anyone who didn't hold back revealed. So withholding never raises your own
    chance of leading next term, which is what a favor trade would need. *)
Theorem holding_back_bars_you_from_the_next_draw :
  forall (revealed held recent latest : list string) (a b : string),
    mem a held = true -> In b revealed -> mem b held = false ->
    ~ In a (draw_pool revealed held recent latest).
Proof.
  intros revealed held recent latest a b Ha Hb Hbh Hin.
  unfold draw_pool in Hin; cbv zeta in Hin.
  assert (Hf : In b (filter (fun x => negb (mem x held)) revealed)).
  { apply filter_In. split; [exact Hb | rewrite Hbh; reflexivity]. }
  destruct (filter (fun x => negb (mem x held)) revealed) as [|y ys] eqn:F; [destruct Hf|].
  assert (Hsub : In a (y :: ys)).
  { destruct (filter (fun x => negb (mem x recent)) (y :: ys)) as [|z zs] eqn:G.
    - destruct (filter (fun x => negb (mem x latest)) (y :: ys)) as [|w ws] eqn:K.
      + exact Hin.
      + rewrite <- K in Hin. apply filter_In in Hin. tauto.
    - rewrite <- G in Hin. apply filter_In in Hin. tauto. }
  rewrite <- F in Hsub. apply filter_In in Hsub. destruct Hsub as [_ Hm].
  rewrite Ha in Hm. discriminate.
Qed.

(** The pool isn't empty while anyone who didn't hold back revealed. *)
Lemma draw_pool_not_nil :
  forall (revealed held recent latest : list string) (b : string),
    In b revealed -> mem b held = false -> draw_pool revealed held recent latest <> [].
Proof.
  intros revealed held recent latest b Hb Hbh.
  unfold draw_pool; cbv zeta.
  assert (Hf : In b (filter (fun x => negb (mem x held)) revealed)).
  { apply filter_In. split; [exact Hb | rewrite Hbh; reflexivity]. }
  destruct (filter (fun x => negb (mem x held)) revealed) as [|y ys] eqn:F; [destruct Hf|].
  destruct (filter (fun x => negb (mem x recent)) (y :: ys)) as [|z zs]; [|discriminate].
  destruct (filter (fun x => negb (mem x latest)) (y :: ys)) as [|w ws]; discriminate.
Qed.

(** Updating another field cannot change the bids. *)
Lemma getf_setf_other : forall (m : obj) (k q : string) (v : Any),
  seq q k = false -> getf (setf m k v) q = getf m q.
Proof.
  intros m k q v H. induction m as [|[key value] rest IH].
  - change ((if seq q k then v else unk) = unk). rewrite H. reflexivity.
  - change (getf (if seq k key then (k, v) :: rest else
      (key, value) :: setf rest k v) q =
      (if seq q key then value else getf rest q)).
    destruct (seq k key) eqn:E.
    + change ((if seq q k then v else getf rest q) =
        (if seq q key then value else getf rest q)).
      unfold seq in E. apply Stdlib.Strings.String.eqb_eq in E.
      subst key. rewrite H. reflexivity.
    + change ((if seq q key then value else getf (setf rest k v) q) =
        (if seq q key then value else getf rest q)).
      rewrite IH. reflexivity.
Qed.

Lemma leader_setf_other : forall (m : obj) (k : string) (v : Any),
  seq "leader" k = false -> leader (setf m k v) = leader m.
Proof.
  intros m k v H. unfold leader. rewrite getf_setf_other by exact H. reflexivity.
Qed.

Lemma leader_setf_leader : forall (m : obj) (l : string),
  leader (setf m "leader" l) = l.
Proof.
  intros m l. unfold leader. induction m as [|[key value] rest IH].
  - reflexivity.
  - change (cast Any string
      (getf (if seq "leader" key then ("leader", cast string Any l) :: rest
        else (key, value) :: setf rest "leader" l) "leader") = l).
    destruct (seq "leader" key) eqn:E.
    + reflexivity.
    + change (cast Any string (if seq "leader" key then value else
        getf (setf rest "leader" l) "leader") = l).
      rewrite E. exact IH.
Qed.

(** The same at maybe_draw: an agent in held_back, which the previous draw
    recorded, is not the leader this draw picks, as long as someone who
    didn't hold back revealed. When no draw happens, the state is unchanged. *)
Theorem maybe_draw_bars_who_held_back :
  forall (m : obj) (a b : string),
    mem a (held_back m) = true -> In b (revealed m) -> mem b (held_back m) = false ->
    maybe_draw m = m \/ leader (maybe_draw m) <> a.
Proof.
  intros m a b Ha Hb Hbh. unfold maybe_draw.
  destruct (awaiting m && draw_ready (length (roster_now m)) (length (revealed m))
    (asince m + param m "reveal_window" <=? mheight m));
    [right|left; reflexivity].
  cbv zeta. unfold count.
  repeat rewrite leader_setf_other by reflexivity.
  rewrite leader_setf_leader.
  assert (Hne : eligible m <> []).
  { unfold eligible. eapply draw_pool_not_nil; eauto. }
  assert (Hout : ~ In a (eligible m)).
  { unfold eligible. eapply holding_back_bars_you_from_the_next_draw; eauto. }
  intros E. apply Hout. rewrite <- E. apply nth_In. apply Nat.mod_upper_bound.
  intros L. apply Hne. apply length_zero_iff_nil. exact L.
Qed.

Lemma bids_setf_other : forall (m : obj) (k : string) (v : Any),
  seq "bids" k = false -> bids (setf m k v) = bids m.
Proof.
  intros m k v H. unfold bids. rewrite getf_setf_other by exact H. reflexivity.
Qed.

Lemma bids_setf_bids : forall (m : obj) (bs : list bid),
  bids (setf m "bids" bs) = bs.
Proof.
  intros m bs. unfold bids. induction m as [|[key value] rest IH].
  - reflexivity.
  - change (cast Any (list bid)
      (getf (if seq "bids" key then ("bids", cast (list bid) Any bs) :: rest
        else (key, value) :: setf rest "bids" bs) "bids") = bs).
    destruct (seq "bids" key) eqn:E.
    + reflexivity.
    + change (cast Any (list bid) (if seq "bids" key then value else
        getf (setf rest "bids" bs) "bids") = bs).
      rewrite E. exact IH.
Qed.

Definition merged_satisfy (P : bid -> Prop) (m : obj) : Prop :=
  forall b, In b (bids m) -> bst b = Merged -> P b.

Lemma merged_setf_other : forall P m k v,
  seq "bids" k = false -> merged_satisfy P m -> merged_satisfy P (setf m k v).
Proof.
  unfold merged_satisfy. intros P m k v H Hm.
  rewrite bids_setf_other by exact H. exact Hm.
Qed.

Lemma merged_set_bid : forall P m b,
  bst b <> Merged -> merged_satisfy P m -> merged_satisfy P (set_bid m b).
Proof.
  unfold merged_satisfy, set_bid. intros P m b H Hm x Hin Hx.
  rewrite bids_setf_bids in Hin. apply in_map_iff in Hin.
  destruct Hin as [y [E Hy]]. destruct (bidn y =? bidn b).
  - subst x. contradiction.
  - subst x. eauto.
Qed.

Lemma merged_count : forall P m a k,
  merged_satisfy P m -> merged_satisfy P (count m a k).
Proof.
  intros. unfold count. apply merged_setf_other; auto.
Qed.

Lemma merged_clear_fold : forall P (bs : list bid) m f,
  (forall m b, merged_satisfy P m -> merged_satisfy P (f m b)) ->
  merged_satisfy P m -> merged_satisfy P (fold_left f bs m).
Proof.
  intros P bs. induction bs; intros m f H Hm; simpl; auto.
Qed.

Lemma settle_preserves_merged : forall P,
  (forall m p, pending m = Some p -> merged_satisfy P m ->
    merge_quorum m p <= counted_approvals m p ->
    merged_satisfy P (fst (finalize m p))) ->
  forall m, merged_satisfy P m -> merged_satisfy P (fst (settle m)).
Proof.
  intros P Hfinal m Hm. unfold settle.
  destruct (pending m) as [p|] eqn:Hp; [|exact Hm].
  cbv zeta.
  destruct (merge_quorum m p <=? counted_approvals m p) eqn:Hyes.
  - apply Hfinal; [exact Hp|exact Hm|]. apply Nat.leb_le. exact Hyes.
  - destruct (rejected_at (merge_n m p) (counted_noes m p));
      [destruct (bid_by m (pbid p)) as [b|] |
       destruct (param m "attest_window" <=? mheight m - pat p)]; simpl;
      repeat first [apply merged_count | apply merged_setf_other; [reflexivity|] |
        apply merged_set_bid; [discriminate|] | exact Hm].
Qed.

Lemma merged_append_pending : forall P m b,
  bst b <> Merged -> merged_satisfy P m ->
  merged_satisfy P (setf m "bids" (bids m ++ [b])).
Proof.
  unfold merged_satisfy. intros P m b H Hm x Hin Hx.
  rewrite bids_setf_bids in Hin. apply in_app_iff in Hin.
  destruct Hin as [Hin|[E|[]]]; [eauto|subst x; contradiction].
Qed.

Lemma apply_preserves_merged : forall P,
  (forall m p, pending m = Some p -> merged_satisfy P m ->
    merge_quorum m p <= counted_approvals m p ->
    merged_satisfy P (fst (finalize m p))) ->
  forall m a fields, merged_satisfy P m ->
    merged_satisfy P (fst (fst (apply m a fields))).
Proof.
  intros P Hfinal m a fields Hm. unfold apply.
  (* Match the state constructor before applying a preservation lemma: failed
     unification would otherwise unfold whole transaction branches. *)
  Ltac merged_steps :=
    repeat first [ assumption
      | match goal with
        | |- merged_satisfy _ (count _ _ _) => apply merged_count
        | |- merged_satisfy _ (setf _ _ _) =>
            apply merged_setf_other; [reflexivity|]
        | |- merged_satisfy _ (set_bid _ _) =>
            apply merged_set_bid; [discriminate|]
        end ].
  repeat first [solve [merged_steps]
    | solve [match goal with
        | |- merged_satisfy _ (setf _ "bids" _) =>
            apply merged_append_pending; [discriminate|]; merged_steps
        end]
    | solve [match goal with
        | |- merged_satisfy _ (fold_left _ _ _) =>
            apply merged_clear_fold;
              [intros; destruct (_ && _); merged_steps | merged_steps]
        end]
    | match goal with
      | |- merged_satisfy _ (fst (fst (match settle ?s with _ => _ end))) =>
        let Hs := fresh "Hs" in
        assert (Hs : merged_satisfy P (fst (settle s))) by
          (apply settle_preserves_merged; [exact Hfinal|]; merged_steps);
        destruct (settle s) as [sm so] eqn:?;
        cbn [fst] in Hs
      end
    | progress cbn beta iota zeta delta [fst]
    | match goal with
      | |- merged_satisfy _ (fst (fst (match ?x with _ => _ end))) => destruct x
      end ].
Qed.

Lemma end_term_preserves_merged : forall P m,
  merged_satisfy P m -> merged_satisfy P (maybe_end_term m).
Proof.
  intros P m Hm. unfold maybe_end_term.
  repeat first [solve [merged_steps]
    | progress cbn beta iota zeta
    | match goal with |- context [if ?c then _ else _] => destruct c end].
Qed.

Lemma draw_preserves_merged : forall P m,
  merged_satisfy P m -> merged_satisfy P (maybe_draw m).
Proof.
  intros P m Hm. unfold maybe_draw.
  destruct (awaiting m && draw_ready (length (roster_now m)) (length (revealed m))
    (asince m + param m "reveal_window" <=? mheight m));
    [|exact Hm].
  cbv zeta. merged_steps.
  generalize (filter (fun a => negb (mem a (revealed m))) (roster_now m)).
  intros held. induction held as [|a rest IH] using rev_ind.
  - simpl. merged_steps.
  - rewrite fold_left_app. simpl. apply merged_count. exact IH.
Qed.

Lemma prune_preserves_merged : forall P m,
  merged_satisfy P m -> merged_satisfy P (prune m).
Proof.
  unfold merged_satisfy, prune. intros P m Hm b Hin Hb.
  rewrite bids_setf_bids in Hin. apply filter_In in Hin. apply Hm; tauto.
Qed.

Lemma merged_block_fold : forall (P : bid -> Prop)
  (f : (obj * list (list string)) -> string -> obj * list (list string)),
  (forall acc raw, merged_satisfy P (fst acc) -> merged_satisfy P (fst (f acc raw))) ->
  forall txs acc, merged_satisfy P (fst acc) ->
    merged_satisfy P (fst (fold_left f txs acc)).
Proof.
  intros P f Hf txs. induction txs; intros acc H; simpl; auto.
Qed.

(** Any property of Merged bids survives a block if authorized calls to
    finalize preserve it. Every other transition preserves it on its own. *)
Lemma apply_block_preserves_merged : forall P,
  (forall m p, pending m = Some p -> merged_satisfy P m ->
    merge_quorum m p <= counted_approvals m p ->
    merged_satisfy P (fst (finalize m p))) ->
  forall m h txs, merged_satisfy P m ->
    merged_satisfy P (fst (apply_block m h txs)).
Proof.
  intros P Hfinal m h txs Hm. unfold apply_block.
  match goal with |- context [fold_left ?f txs ?initial] =>
    assert (HF : merged_satisfy P (fst (fold_left f txs initial)))
  end.
  { apply merged_block_fold.
    - intros [s outs] raw Hs. cbn [fst] in Hs.
      destruct (decode_tx s raw) as [|a [|n fields]]; cbn [fst]; try exact Hs.
      destruct (num n =? nonce_of s a + 1); cbn [fst]; [|exact Hs].
      assert (Hn : merged_satisfy P (setf s "nonces" (put a (num n) (nonces s))))
        by (apply merged_setf_other; [reflexivity|exact Hs]).
      pose proof (apply_preserves_merged P Hfinal _ a fields Hn) as Ha.
      destruct (apply (setf s "nonces" (put a (num n) (nonces s))) a fields)
        as [[s' o] why] eqn:E.
      cbn [fst] in Ha |- *.
      destruct (seq why "" && is_leader s' a); cbn [fst];
        [apply merged_setf_other; [reflexivity|exact Ha]|exact Ha].
    - cbn [fst]. apply merged_setf_other; [reflexivity|exact Hm]. }
  match type of HF with merged_satisfy _ (fst ?acc) =>
    destruct acc as [s outs] eqn:E
  end.
  cbn [fst] in HF |- *.
  pose proof (settle_preserves_merged P Hfinal s HF) as HS.
  destruct (settle s) as [s' o]. cbn [fst] in HS |- *.
  apply prune_preserves_merged. apply draw_preserves_merged.
  apply end_term_preserves_merged. exact HS.
Qed.

Lemma bid_eq_dec : forall (x y : bid), {x = y} + {x <> y}.
Proof.
  decide equality; repeat decide equality.
Qed.

(** A newly Merged bid in a block came from finalize, at a settlement state
    with the approvals merge_quorum asks: genesis's merge_approvals, or by
    default n-f, n being the agents whose scope has the bid's repository
    (every agent unless genesis excludes some: scope_all). Existing Merged bids may survive a block;
    their presence alone does not assert a new finalization. *)
Theorem merged_only_through_finalize_with_quorum_approvals :
  forall (m : obj) (h : nat) (txs : list string) (b : bid),
    In b (bids (fst (apply_block m h txs))) -> bst b = Merged ->
    ~ In b (bids m) ->
    exists (before : obj) (p : proposal),
      merge_quorum before p <= counted_approvals before p /\
      pending before = Some p /\ ~ In b (bids before) /\
      In b (bids (fst (finalize before p))).
Proof.
  intros m h txs b Hin Hb Hnew.
  let P := constr:(fun b => In b (bids m) \/
    exists before p,
      merge_quorum before p <= counted_approvals before p /\
      pending before = Some p /\ ~ In b (bids before) /\
      In b (bids (fst (finalize before p)))) in
  assert (H : merged_satisfy P (fst (apply_block m h txs))).
  { apply apply_block_preserves_merged.
    - intros before p Hp Hbefore Hyes x Hx Hmerged.
      destruct (in_dec bid_eq_dec x (bids before)) as [Hold|Hfresh].
      + exact (Hbefore x Hold Hmerged).
      + right. exists before, p. auto.
    - intros x Hx Hmerged. left. exact Hx. }
  destruct (H b Hin Hb) as [Hold|Hfinal]; [contradiction|exact Hfinal].
Qed.

(** With nothing excluded, a merge's roster is every agent on the roster at
    the market's height, so the quorum in
    merged_only_through_finalize_with_quorum_approvals is n-f of the whole
    network at that height (the genesis roster while no roster change has
    taken effect: roster_now_without_changes); exclusions only ever shrink it. *)
Theorem scope_all : forall (m : obj) (r : string),
  excluded m = [] -> scope m r = roster_now m.
Proof.
  intros m r H. unfold scope, excludes. rewrite H.
  generalize (roster_now m) as l. induction l as [|a l IH]; simpl; [reflexivity|].
  f_equal. exact IH.
Qed.

Theorem merge_n_le_agents : forall (m : obj) (p : proposal),
  merge_n m p <= length (roster_now m).
Proof.
  intros m p. unfold merge_n, merge_roster. destruct (bid_by m (pbid p)) as [b|]; [|lia].
  unfold scope. generalize (roster_now m) as l. induction l as [|a l IH]; simpl; [lia|].
  destruct (negb _); simpl; lia.
Qed.

(** Selection is bounded even for malformed rosters or exhausted windows. *)
Theorem bidders_for_at_most_two : forall (m : obj) (t : task),
  length (bidders_for m t) <= 2.
Proof.
  intros m t. unfold bidders_for. apply firstn_le_length.
Qed.

Theorem bidders_for_excludes_leader : forall (m : obj) (t : task),
  ~ In (leader m) (bidders_for m t).
Proof.
  intros m t Hin. unfold bidders_for in Hin.
  match type of Hin with In _ (firstn 2 ?xs) =>
    assert (H : In (leader m) xs) by
      (rewrite <- (firstn_skipn 2 xs); apply in_or_app; left; exact Hin)
  end.
  apply filter_In in H. destruct H as [_ H].
  unfold seq in H. rewrite Stdlib.Strings.String.eqb_refl in H. discriminate.
Qed.

(** A leader never merges its own bid (docs/PROOFS.md, item 8): a merge
    naming a bid its sender made fails, with a reason, and leaves the whole
    market as it was, an already pending proposal included. *)
Theorem self_merge_makes_no_proposal : forall (m : obj) (a i tree : string) (b : bid),
  bid_by m (num i) = Some b -> bidder b = a ->
  exists why, why <> "" /\ apply m a ["merge", i, tree] = (m, [], why).
Proof.
  intros m a i tree b Hb Ha. subst a.
  assert (Hs : seq (bidder b) (bidder b) = true)
    by (unfold seq; apply Stdlib.Strings.String.eqb_refl).
  assert (Ho : forall x : bool, (x || true) = true) by (intros [|]; reflexivity).
  unfold apply. cbn beta iota zeta.
  rewrite Hb, Hs, Ho.
  repeat match goal with |- context [if ?c then _ else _] => destruct c eqn:? end.
  all: match goal with |- exists w, _ /\ (_, _, ?r) = _ => exists r end;
       split; [apply Stdlib.Strings.String.eqb_neq; reflexivity|reflexivity].
Qed.

(** A merge checked on a head the repository has moved past makes no
    proposal: its tree is the old head's, and a market that took it would
    record a head no node reaches (bid 68 of the joint network's first
    night, merged by its leader alone). *)
Theorem moved_head_merge_makes_no_proposal : forall (m : obj) (a i tree on : string) (b : bid),
  bid_by m (num i) = Some b -> moved_since m (bid_repo m b) on = true ->
  exists why, why <> "" /\ apply m a ["merge", i, tree, on] = (m, [], why).
Proof.
  intros m a i tree on b Hb Hmv.
  unfold apply. cbn beta iota zeta.
  rewrite Hb, Hmv.
  repeat match goal with |- context [if ?c then _ else _] => destruct c eqn:? end.
  all: match goal with |- exists w, _ /\ (_, _, ?r) = _ => exists r end;
       split; [apply Stdlib.Strings.String.eqb_neq; reflexivity|reflexivity].
Qed.

(** And every merge that goes through names an existing bid made by
    someone else, sent by the term leader. *)
Theorem merge_needs_leader_and_others_bid : forall (m m' : obj) (a i tree : string) (outs : list (list string)),
  apply m a ["merge", i, tree] = (m', outs, "") ->
  exists b, bid_by m (num i) = Some b /\ bidder b <> a /\ is_leader m a = true.
Proof.
  intros m m' a i tree outs H.
  unfold apply in H. cbn beta iota zeta in H.
  Ltac why_differs H :=
    apply (f_equal (fun p => Stdlib.Strings.String.eqb (snd p) "")) in H;
    cbn in H; discriminate H.
  destruct (bid_by m (num i)) as [b|] eqn:Hb; [|why_differs H].
  destruct (is_leader m a) eqn:Hl; [|why_differs H].
  destruct (seq (bidder b) a) eqn:He.
  - assert (Ho : forall x : bool, (x || true) = true) by (intros [|]; reflexivity).
    rewrite Ho in H.
    repeat match type of H with context [if ?c then _ else _] => destruct c eqn:? end;
      why_differs H.
  - exists b. split; [reflexivity|]. split; [|reflexivity].
    unfold seq in He. apply Stdlib.Strings.String.eqb_neq in He. exact He.
Qed.

(** A leader-draw reveal is unique (docs/SECURITY-REVIEW-2.md P-8). What a
    reveal does, the reveal branch of apply on its own. *)
Lemma apply_reveal : forall (m : obj) (a v : string),
  apply m a ["reveal", v] =
  (if negb (awaiting m) then (m, [], "no draw under way")
   else if existsb (fun r => seq (fst r) a) (reveals m) then (m, [], "already revealed")
   else if negb (next_link v (get_or "" a (tips m))) then (m, [], "not a link of this agent's hash chain")
   else (setf (setf m "reveals" (reveals m ++ [(a, v)])) "tips" (put a v (tips m)), [], "")).
Proof.
  intros m a v. reflexivity.
Qed.

Lemma getf_setf_same : forall (m : obj) (k : string) (v : Any),
  getf (setf m k v) k = v.
Proof.
  intros m k v. induction m as [|[key value] rest IH].
  - change ((if seq k k then v else unk) = v).
    unfold seq. rewrite Stdlib.Strings.String.eqb_refl. reflexivity.
  - change (getf (if seq k key then (k, v) :: rest else
      (key, value) :: setf rest k v) k = v).
    destruct (seq k key) eqn:E.
    + change ((if seq k k then v else getf rest k) = v).
      unfold seq. rewrite Stdlib.Strings.String.eqb_refl. reflexivity.
    + change ((if seq k key then value else getf (setf rest k v) k) = v).
      rewrite E. exact IH.
Qed.

Lemma reveals_after_reveal : forall (m : obj) (rs ts : list (string * string)),
  reveals (setf (setf m "reveals" rs) "tips" ts) = rs.
Proof.
  intros m rs ts. unfold reveals.
  rewrite getf_setf_other by reflexivity. rewrite getf_setf_same. reflexivity.
Qed.

(** An accepted reveal hashes, in one step, to the agent's tip: never an
    older link of its chain. *)
Theorem accepted_reveal_is_the_next_link :
  forall (m m' : obj) (a v : string) (outs : list (list string)),
    apply m a ["reveal", v] = (m', outs, "") -> sha256 v = get_or "" a (tips m).
Proof.
  intros m m' a v outs H. rewrite apply_reveal in H.
  destruct (negb (awaiting m)); [discriminate H|].
  destruct (existsb (fun r => seq (fst r) a) (reveals m)); [discriminate H|].
  destruct (next_link v (get_or "" a (tips m))) eqn:E; [|discriminate H].
  unfold next_link, seq in E. apply Stdlib.Strings.String.eqb_eq in E. exact E.
Qed.

(** The regression: with the tip at sha256 (sha256 v), the next link
    sha256 v is accepted, and the older link v, which the 64-step check let
    through, is refused, leaving the market as it was. *)
Theorem reveal_one_step_regression :
  forall (m : obj) (a v : string),
    awaiting m = true -> existsb (fun r => seq (fst r) a) (reveals m) = false ->
    get_or "" a (tips m) = sha256 (sha256 v) -> sha256 v <> sha256 (sha256 v) ->
    (exists m', apply m a ["reveal", sha256 v] = (m', [], "")) /\
    apply m a ["reveal", v] = (m, [], "not a link of this agent's hash chain").
Proof.
  intros m a v Ha Hr Ht Hne.
  rewrite !apply_reveal, Ha, Hr, Ht. unfold next_link, seq.
  rewrite Stdlib.Strings.String.eqb_refl.
  apply Stdlib.Strings.String.eqb_neq in Hne. rewrite Hne.
  split; [eexists; reflexivity | reflexivity].
Qed.

(** Once an agent's reveal is accepted, any second reveal from it in the
    same draw, different or not, is refused before it is admitted. *)
Theorem second_reveal_for_a_draw_is_refused :
  forall (m m' : obj) (a v w : string) (outs : list (list string)),
    apply m a ["reveal", v] = (m', outs, "") ->
    exists why, why <> "" /\ apply m' a ["reveal", w] = (m', [], why).
Proof.
  intros m m' a v w outs H. rewrite apply_reveal in H.
  destruct (negb (awaiting m)); [discriminate H|].
  destruct (existsb (fun r => seq (fst r) a) (reveals m)); [discriminate H|].
  destruct (next_link v (get_or "" a (tips m))); [|discriminate H].
  injection H as Hm Ho. subst m'.
  rewrite apply_reveal.
  match goal with |- context [existsb ?f (reveals ?s)] =>
    assert (Hx : existsb f (reveals s) = true);
    [ rewrite reveals_after_reveal; apply existsb_exists; exists (a, v); split;
      [ apply in_or_app; right; left; reflexivity
      | change (seq a a = true); unfold seq; apply Stdlib.Strings.String.eqb_refl ]
    | rewrite Hx ]
  end.
  match goal with |- context [negb (awaiting ?s)] => destruct (negb (awaiting s)) end;
    [exists "no draw under way" | exists "already revealed"];
    split; [discriminate | reflexivity | discriminate | reflexivity].
Qed.

(** Any two reveals accepted for one agent in one draw are the same link:
    both hash to its tip, and so are equal when the tip has one preimage. *)
Theorem accepted_reveals_for_a_draw_are_equal :
  forall (m m1 m2 : obj) (a v w : string) (o1 o2 : list (list string)),
    apply m a ["reveal", v] = (m1, o1, "") -> apply m a ["reveal", w] = (m2, o2, "") ->
    sha256 v = get_or "" a (tips m) /\ sha256 v = sha256 w /\
    ((forall x y, sha256 x = get_or "" a (tips m) -> sha256 y = get_or "" a (tips m) -> x = y) -> v = w).
Proof.
  intros m m1 m2 a v w o1 o2 Hv Hw.
  pose proof (accepted_reveal_is_the_next_link _ _ _ _ _ Hv) as Ev.
  pose proof (accepted_reveal_is_the_next_link _ _ _ _ _ Hw) as Ew.
  split; [exact Ev|]. split; [congruence|].
  intros U. exact (U v w Ev Ew).
Qed.

(** decode_tx's decisions: the caps, the nonce, the signature's verdict. *)
Example nonce_ok_cases :
  nonce_ok "0" = true /\ nonce_ok "12345678901234567" = true /\
  nonce_ok "123456789012345678" = false /\ nonce_ok "" = false /\
  nonce_ok "1a" = false /\ nonce_ok "-1" = false.
Proof. repeat split; reflexivity. Qed.

Example tx_shape_cases :
  tx_shape_ok "10" "100" "{}" = true /\
  tx_shape_ok "1" "100" "{}" = false /\
  tx_shape_ok "100" "100" "[[[[[1]]]]]" = false /\
  tx_shape_ok "100" "100" "[[[[1]]]]" = true.
Proof. repeat split; reflexivity. Qed.

Example tx_decision_cases :
  tx_decision None (fun _ _ _ _ => true) = [] /\
  tx_decision (Some ("a", ("7", (["post", "x"], "sig")))) (fun _ _ _ _ => true) = ["a", "7", "post", "x"] /\
  tx_decision (Some ("a", ("7", (["post", "x"], "sig")))) (fun _ _ _ _ => false) = [] /\
  tx_decision (Some ("a", ("x7", (["post"], "sig")))) (fun _ _ _ _ => true) = [] /\
  tx_decision (Some ("a", ("", (["post"], "sig")))) (fun _ _ _ _ => true) = [].
Proof. repeat split; reflexivity. Qed.

(** A transaction whose nonce isn't digits is refused whatever its signature. *)
Theorem bad_nonce_refused : forall agent nonce fields sg verified,
  nonce_ok nonce = false -> tx_decision (Some (agent, (nonce, (fields, sg)))) verified = [].
Proof. intros agent nonce fields sg verified H. simpl. rewrite H. reflexivity. Qed.

(** M-3, part: the roster by height. A change committed at height c takes
    effect at c + 1 + delay, so the roster, and every quorum computed from
    it, is the same at c as without the change; a stable roster keeps
    genesis's quorums. *)
Theorem change_takes_effect_after_commit : forall c d : nat, c < effective_height c d.
Proof. intros c d. unfold effective_height. lia. Qed.

Theorem roster_unchanged_at_commit : forall (g : list string) (cs : list (string * bool * nat))
    (a : string) (j : bool) (c d : nat),
  roster_at g (cs ++ [(a, j, effective_height c d)]) c = roster_at g cs c.
Proof.
  intros g cs a j c d. unfold roster_at. rewrite fold_left_app.
  cbn [fold_left]. cbv beta iota.
  assert (H : (effective_height c d <=? c) = false)
    by (apply Nat.leb_gt; unfold effective_height; lia).
  rewrite H. reflexivity.
Qed.

Theorem quorums_from_the_roster_at_the_height : forall (g : list string) (cs : list (string * bool * nat)) (h : nat),
  quorum_at g cs h = quorum (length (roster_at g cs h)) /\
  reject_quorum_at g cs h = reject_quorum (length (roster_at g cs h)).
Proof. intros. split; reflexivity. Qed.

Theorem quorums_unchanged_at_commit : forall (g : list string) (cs : list (string * bool * nat))
    (a : string) (j : bool) (c d : nat),
  quorum_at g (cs ++ [(a, j, effective_height c d)]) c = quorum_at g cs c /\
  reject_quorum_at g (cs ++ [(a, j, effective_height c d)]) c = reject_quorum_at g cs c.
Proof.
  intros. unfold quorum_at, reject_quorum_at. rewrite roster_unchanged_at_commit. split; reflexivity.
Qed.

Theorem stable_roster_keeps_genesis_quorums : forall (g : list string) (h : nat),
  roster_at g [] h = g /\ quorum_at g [] h = quorum (length g) /\
  reject_quorum_at g [] h = reject_quorum (length g).
Proof. intros. repeat split; reflexivity. Qed.

Example absent_blocks_boundary :
  absent_run "a3" [["a1", "a2"], ["a1", "a2"], ["a1", "a2", "a3"]] = 2 /\
  removal_due 3 "a3" [["a1", "a2"], ["a1", "a2"], ["a1", "a2", "a3"]] = false /\
  removal_due 3 "a3" [["a1", "a2"], ["a1", "a2"], ["a1", "a2"], ["a1", "a2", "a3"]] = true /\
  removal_due 3 "a1" [["a1", "a2"], ["a2"], ["a2"]] = false /\
  removal_due 0 "a3" [["a1"], ["a1"]] = false /\
  effective_height 10 1 = 12.
Proof. repeat split; reflexivity. Qed.

Example roster_seven_to_six :
  roster_at ["a1", "a2", "a3", "a4", "a5", "a6", "a7"] [("a7", false, effective_height 10 1)] 11
    = ["a1", "a2", "a3", "a4", "a5", "a6", "a7"] /\
  roster_at ["a1", "a2", "a3", "a4", "a5", "a6", "a7"] [("a7", false, effective_height 10 1)] 12
    = ["a1", "a2", "a3", "a4", "a5", "a6"] /\
  (quorum_at ["a1", "a2", "a3", "a4", "a5", "a6", "a7"] [("a7", false, 12)] 11,
   reject_quorum_at ["a1", "a2", "a3", "a4", "a5", "a6", "a7"] [("a7", false, 12)] 11) = (5, 3) /\
  (quorum_at ["a1", "a2", "a3", "a4", "a5", "a6", "a7"] [("a7", false, 12)] 12,
   reject_quorum_at ["a1", "a2", "a3", "a4", "a5", "a6", "a7"] [("a7", false, 12)] 12) = (5, 2).
Proof. repeat split; reflexivity. Qed.

Example roster_four_to_three_and_back :
  (quorum_at ["a1", "a2", "a3", "a4"] [("a4", false, 10), ("a4", true, 20)] 9,
   reject_quorum_at ["a1", "a2", "a3", "a4"] [("a4", false, 10), ("a4", true, 20)] 9) = (3, 2) /\
  roster_at ["a1", "a2", "a3", "a4"] [("a4", false, 10), ("a4", true, 20)] 15 = ["a1", "a2", "a3"] /\
  (quorum_at ["a1", "a2", "a3", "a4"] [("a4", false, 10), ("a4", true, 20)] 15,
   reject_quorum_at ["a1", "a2", "a3", "a4"] [("a4", false, 10), ("a4", true, 20)] 15) = (3, 1) /\
  roster_at ["a1", "a2", "a3", "a4"] [("a4", false, 10), ("a4", true, 20)] 20 = ["a1", "a2", "a3", "a4"] /\
  (quorum_at ["a1", "a2", "a3", "a4"] [("a4", false, 10), ("a4", true, 20)] 20,
   reject_quorum_at ["a1", "a2", "a3", "a4"] [("a4", false, 10), ("a4", true, 20)] 20) = (3, 2) /\
  roster_at ["a1", "a2", "a3"] [("a2", true, 5)] 6 = ["a1", "a2", "a3"].
Proof. repeat split; reflexivity. Qed.

(** M-3 admission checks, reusing the merged delayed schedule. *)
Theorem admitted_roster_intent_is_authorized : forall p cs certs h l s intent change,
  admit_roster_intent p cs certs h l s intent = Some change ->
  roster_intent_allowed p cs certs h l s intent = true.
Proof.
  intros p cs certs h l s intent change H. unfold admit_roster_intent in H.
  destruct (roster_intent_allowed p cs certs h l s intent) eqn:E; [reflexivity|discriminate H].
Qed.

Theorem admitted_roster_intent_keeps_commit_roster : forall p cs certs h l s intent change,
  admit_roster_intent p cs certs h l s intent = Some change ->
  roster_at (roster_genesis p) (cs ++ [change]) h = roster_at (roster_genesis p) cs h.
Proof.
  intros p cs certs h l s intent change H. unfold admit_roster_intent in H.
  destruct (roster_intent_allowed p cs certs h l s intent); [|discriminate H].
  destruct intent; inversion H; subst change; apply roster_unchanged_at_commit.
Qed.

Theorem admitted_roster_intent_keeps_commit_quorums : forall p cs certs h l s intent change,
  admit_roster_intent p cs certs h l s intent = Some change ->
  quorum_at (roster_genesis p) (cs ++ [change]) h = quorum_at (roster_genesis p) cs h /\
  reject_quorum_at (roster_genesis p) (cs ++ [change]) h = reject_quorum_at (roster_genesis p) cs h.
Proof.
  intros p cs certs h l s intent change H. unfold quorum_at, reject_quorum_at.
  rewrite (admitted_roster_intent_keeps_commit_roster p cs certs h l s intent change H).
  split; reflexivity.
Qed.

Theorem admitted_leave_respects_minimum : forall p cs certs h l s a change,
  admit_roster_intent p cs certs h l s (LeaveRoster a) = Some change ->
  Nat.max 1 (roster_minimum p) <= length (apply_change
    (roster_at (roster_genesis p) cs (effective_height h (roster_delay p))) a false).
Proof.
  intros p cs certs h l s a change H.
  apply admitted_roster_intent_is_authorized in H.
  unfold roster_intent_allowed in H. cbv zeta iota in H.
  apply Bool.andb_true_iff in H. destruct H as [_ H].
  apply Bool.andb_true_iff in H. destruct H as [_ H].
  apply Nat.leb_le. exact H.
Qed.

Theorem admitted_join_is_self_signed : forall p cs certs h l s a change,
  admit_roster_intent p cs certs h l s (JoinRoster a) = Some change -> s = a.
Proof.
  intros p cs certs h l s a change H.
  apply admitted_roster_intent_is_authorized in H.
  unfold roster_intent_allowed in H. cbv zeta iota in H.
  apply Bool.andb_true_iff in H. destruct H as [_ H].
  apply Bool.andb_true_iff in H. destruct H as [H _].
  apply Bool.andb_true_iff in H. destruct H as [H _].
  unfold seq in H. apply Stdlib.Strings.String.eqb_eq. exact H.
Qed.

Theorem admitted_target_is_genesis_member : forall p cs certs h l s intent change,
  admit_roster_intent p cs certs h l s intent = Some change ->
  mem (match intent with LeaveRoster a | JoinRoster a => a end) (roster_genesis p) = true.
Proof.
  intros p cs certs h l s intent change H.
  apply admitted_roster_intent_is_authorized in H.
  unfold roster_intent_allowed in H. cbv zeta in H.
  apply Bool.andb_true_iff in H. destruct H as [H _].
  apply Bool.andb_true_iff in H. destruct H as [H _].
  apply Bool.andb_true_iff in H. exact (proj1 H).
Qed.

Theorem admitted_fields_keep_commit_height_roster : forall p cs records h l s fields next,
  commit_roster_fields p cs records h l s fields = Some next ->
  roster_at (roster_genesis p) next h = roster_at (roster_genesis p) cs h.
Proof.
  intros p cs records h l s fields next H. unfold commit_roster_fields in H.
  destruct (roster_intent_of fields) as [intent|]; [|discriminate H].
  destruct (admit_roster_intent p cs records h l s intent) as [change|] eqn:E; [|discriminate H].
  inversion H; subst next.
  exact (admitted_roster_intent_keeps_commit_roster p cs records h l s intent change E).
Qed.

Theorem certified_admission_keeps_commit_height_roster : forall verify p cs block_at agreed_at h l s fields next,
  commit_certified_roster_fields verify p cs block_at agreed_at h l s fields = Some next ->
  roster_at (roster_genesis p) next h = roster_at (roster_genesis p) cs h.
Proof.
  intros verify p cs block_at agreed_at h l s fields next H.
  unfold commit_certified_roster_fields in H.
  destruct (roster_intent_of fields) as [intent|]; [|discriminate H].
  destruct intent.
  - destruct (2 <=? h); [|discriminate H].
    destruct (certified_commit_window verify (roster_at (roster_genesis p) cs)
      block_at agreed_at (h - 2) (roster_absent_blocks p)) as [records|]; [|discriminate H].
    exact (admitted_fields_keep_commit_height_roster p cs records h l s fields next H).
  - exact (admitted_fields_keep_commit_height_roster p cs [] h l s fields next H).
Qed.

Theorem certified_admission_keeps_commit_height_quorums : forall verify p cs block_at agreed_at h l s fields next,
  commit_certified_roster_fields verify p cs block_at agreed_at h l s fields = Some next ->
  quorum_at (roster_genesis p) next h = quorum_at (roster_genesis p) cs h /\
  reject_quorum_at (roster_genesis p) next h = reject_quorum_at (roster_genesis p) cs h.
Proof.
  intros verify p cs block_at agreed_at h l s fields next H. unfold quorum_at, reject_quorum_at.
  rewrite (certified_admission_keeps_commit_height_roster verify p cs block_at agreed_at h l s fields next H).
  split; reflexivity.
Qed.

(** M-3: the market follows the roster at its height. The rules count
    roster_now, the roster in effect at the market's height, which is the
    genesis roster while no change has taken effect: existing behavior with
    a full, stable roster is unchanged. *)
Theorem roster_now_is_roster_at_the_height : forall m : obj,
  roster_now m = roster_at (agents m) (roster_changes m) (mheight m).
Proof. intros m. reflexivity. Qed.

Theorem roster_now_without_changes : forall m : obj,
  roster_changes m = [] -> roster_now m = agents m.
Proof. intros m H. unfold roster_now. rewrite H. reflexivity. Qed.

(** A change committed at the market's height c takes effect at c + 1 +
    delay: recording it leaves the roster the market counts at c as it was. *)
Theorem committed_change_keeps_market_roster : forall (m : obj) (a : string) (j : bool) (d : nat),
  roster_now (setf m "roster_changes" (roster_changes m ++ [(a, j, effective_height (mheight m) d)])) =
  roster_now m.
Proof.
  intros m a j d. unfold roster_now, agents, mheight, roster_changes.
  rewrite (getf_setf_other m "roster_changes" "agents") by reflexivity.
  rewrite (getf_setf_other m "roster_changes" "h") by reflexivity.
  rewrite getf_setf_same.
  apply roster_unchanged_at_commit.
Qed.

(** By default a merge's quorums are those of the roster at the height. *)
Theorem merge_quorums_are_the_heights : forall (m : obj) (p : proposal),
  param m "merge_approvals" = 0 -> excluded m = [] ->
  merge_quorum m p = quorum_at (agents m) (roster_changes m) (mheight m) /\
  reject_quorum (merge_n m p) = reject_quorum_at (agents m) (roster_changes m) (mheight m).
Proof.
  intros m p Hk He.
  assert (Hn : merge_n m p = length (roster_now m)).
  { unfold merge_n, merge_roster. destruct (bid_by m (pbid p)) as [b|];
      [rewrite (scope_all m (bid_repo m b) He)|]; reflexivity. }
  unfold merge_quorum. rewrite Hk.
  change (quorum (merge_n m p) = quorum_at (agents m) (roster_changes m) (mheight m) /\
    reject_quorum (merge_n m p) = reject_quorum_at (agents m) (roster_changes m) (mheight m)).
  rewrite Hn. split; reflexivity.
Qed.

Lemma market_mem_In : forall (x : string) (l : list string), mem x l = true -> In x l.
Proof.
  intros x l. induction l as [|y r IH]; cbn [mem In]; intro H; [discriminate H|].
  apply Bool.orb_true_iff in H. destruct H as [H|H].
  - left. unfold seq in H. apply Stdlib.Strings.String.eqb_eq in H. symmetry. exact H.
  - right. exact (IH H).
Qed.

Theorem merge_roster_is_on_the_roster : forall (m : obj) (p : proposal) (a : string),
  In a (merge_roster m p) -> In a (roster_now m).
Proof.
  intros m p a H. unfold merge_roster in H.
  destruct (bid_by m (pbid p)) as [b|]; [|exact H].
  unfold scope in H. apply filter_In in H. exact (proj1 H).
Qed.

(** Only votes of agents on the roster at the height count, yes or no: a
    vote cast before its voter was removed counts for nothing. *)
Theorem counted_votes_are_on_the_roster : forall (m : obj) (p : proposal) (v : string * bool),
  In v (counted_votes m p) -> In v (pvotes p) /\ In (fst v) (roster_now m).
Proof.
  intros m p v H. unfold counted_votes in H. apply filter_In in H. destruct H as [Hv Hm].
  split; [exact Hv|]. apply (merge_roster_is_on_the_roster m p). exact (market_mem_In _ _ Hm).
Qed.

Theorem removed_voter_is_not_counted : forall (m : obj) (p : proposal) (a : string) (b : bool),
  ~ In a (roster_now m) -> ~ In (a, b) (counted_votes m p).
Proof.
  intros m p a b Ha H. apply Ha. exact (proj2 (counted_votes_are_on_the_roster m p (a, b) H)).
Qed.

(** The leader and the bidder's fallback supply at most two approvals, so a
    merge at n - f needs n - f - 2 yes votes from attestors on the roster. *)
Theorem counted_attestors_must_approve : forall (n : nat) (m : obj) (p : proposal),
  quorum n <= counted_approvals m p ->
  quorum n - 2 <= length (filter snd (counted_votes m p)).
Proof.
  intros n m p H. unfold counted_approvals in H. cbv zeta in H.
  destruct (mem (pby p) (merge_roster m p)); destruct (_ && _ && _); lia.
Qed.

(** A merge's approvals and rejections at one height still exclude each
    other: the counted voters are at most n - 2 of that height's roster. *)
Theorem counted_merge_never_both : forall (n : nat) (m : obj) (p : proposal),
  length (counted_votes m p) + 2 <= n ->
  quorum n <= counted_approvals m p -> reject_quorum n <= counted_noes m p -> False.
Proof.
  intros n m p Hl Hy Hn. unfold counted_noes in Hn.
  pose proof (quorum_plus_reject n). pose proof (votes_split (counted_votes m p)).
  unfold counted_approvals in Hy. cbv zeta in Hy.
  destruct (mem (pby p) (merge_roster m p)); destruct (_ && _ && _); lia.
Qed.

(** The draw counts reveals of the roster at the height only. *)
Theorem revealed_are_on_the_roster : forall (m : obj) (a : string),
  In a (revealed m) -> In a (roster_now m).
Proof. intros m a H. unfold revealed in H. apply filter_In in H. exact (proj1 H). Qed.

(** A leader the roster no longer has ends its term in that block, a pending
    merge or not. *)
Theorem removed_leader_term_ends : forall m : obj,
  awaiting m = false -> leader_removed m = true ->
  awaiting (maybe_end_term m) = true /\ leader (maybe_end_term m) = "".
Proof.
  intros m Ha Hr. unfold maybe_end_term. rewrite Ha, Hr. cbn [negb andb].
  split.
  - unfold awaiting. rewrite getf_setf_other by reflexivity. rewrite getf_setf_same. reflexivity.
  - repeat rewrite leader_setf_other by reflexivity. apply leader_setf_leader.
Qed.

(** And a removed agent doesn't lead: it isn't the leader to apply. *)
Theorem removed_agent_does_not_lead : forall (m : obj) (a : string),
  on_roster m a = false -> is_leader m a = false.
Proof. intros m a H. unfold is_leader. rewrite H. apply Bool.andb_false_r. Qed.

Theorem chain_admission_keeps_committing_roster : forall verify policy changes block_at h leader sender fields next,
  commit_chain_roster_fields verify policy changes block_at h leader sender fields = Some next ->
  roster_at (roster_genesis policy) next h = roster_at (roster_genesis policy) changes h.
Proof.
  intros verify policy changes block_at h leader sender fields next H.
  unfold commit_chain_roster_fields in H.
  eapply certified_admission_keeps_commit_height_roster. exact H.
Qed.

Theorem chain_admission_keeps_committing_quorums : forall verify policy changes block_at h leader sender fields next,
  commit_chain_roster_fields verify policy changes block_at h leader sender fields = Some next ->
  quorum_at (roster_genesis policy) next h = quorum_at (roster_genesis policy) changes h /\
  reject_quorum_at (roster_genesis policy) next h = reject_quorum_at (roster_genesis policy) changes h.
Proof.
  intros verify policy changes block_at h leader sender fields next H.
  unfold commit_chain_roster_fields in H.
  eapply certified_admission_keeps_commit_height_quorums. exact H.
Qed.
