(** The agent's wrapper: what it does for its agent, from the market's state.
    It asks its model through the shell (a model never sees a key; one with
    tools only gets a scratch checkout), checks every answer against its
    policy, and only then has the shell sign anything. A scripted backend
    answers without a model, for tests and for an agent that has none.

    The market holds no file contents, so a prompt names what it needs and the
    Soma fills it in from the shell's checkout reads: {{REPOS}} lists every repository's
    files, and {{REPO}} gives a task's context files. *)
Import core.util runtime.nodeio core.market core.leader prompts.common prompts.draft prompts.patch prompts.pick prompts.attest.

me (a : obj) : string := getf a "me".
backend (a : obj) : string := getf a "backend".
behavior (a : obj) : string := getf a "behavior".
goal (a : obj) : list string := getf a "goal".
perspective (a : obj) : string := getf a "perspective".
deny (a : obj) : list string := getf a "deny".
inflight (a : obj) : nat := getf a "inflight".
sent_at (a : obj) : nat := getf a "sent_at".
(** the transaction [inflight] names, kept until that nonce lands or is given up *)
inflight_tx (a : obj) : list string := getf a "inflight_tx".
queue (a : obj) : list (list string) := getf a "queue".
asked (a : obj) : list string := getf a "asked".
attempts (a : obj) : list (string * nat) := getf a "attempts".
(** the version each task's patch tries were counted at (bid_duty) *)
attempt_v (a : obj) : list (string * nat) := getf a "attempt_v".
retry_keys (a : obj) : list (string * string) := getf a "retry_keys".
reqs (a : obj) : list (string * list string) := getf a "reqs".
req_contexts (a : obj) : list (string * list string) := getf a "req_contexts".
nreq (a : obj) : nat := getf a "nreq".
bid_window (a : obj) : nat := getf a "bid_window".
(** a leader's judgment that a task is done: task id to the bid that finishes
    it, "0" when what's merged already does *)
done_marks (a : obj) : list (string * string) := getf a "done_marks".
(** a leader's judgment that a task has gone as far as it should for now:
    the work merged on it left the repository better, and what remains is
    better posted again later. Task id to the bid it merges first, "0" when
    none. The task closes with its plan item still open. *)
close_marks (a : obj) : list (string * string) := getf a "close_marks".
merge_titles (a : obj) : list (string * string) := getf a "merge_titles".

(** a title as the market takes it: plain, up to 60 characters *)
short_title (s : string) : string := trim (take_str 60 (clean_text s)).
(** when this agent first saw a task's latest merge: task id and merge count
    to the height *)
merge_seen (a : obj) : list (string * nat) := getf a "merge_seen".
(** the .plan line a leader judged done with its task, to mark *)
plan_lines (a : obj) : list (string * string) := getf a "plan_lines".

new_agent (me : string) : obj :=
  [("me", me : Any), ("backend", "scripted" : Any), ("behavior", "honest" : Any),
   ("goal", ([] : list string) : Any), ("perspective", "" : Any),
   ("deny", ([".git/", ".github/", ".gitmodules", ".gitattributes", "network/"] : list string) : Any),
   ("inflight", 0 : Any), ("sent_at", 0 : Any), ("inflight_tx", ([] : list string) : Any),
   ("queue", ([] : list (list string)) : Any),
   ("asked", ([] : list string) : Any), ("attempts", ([] : list (string * nat)) : Any), ("attempt_v", ([] : list (string * nat)) : Any), ("retry_keys", ([] : list (string * string)) : Any),
   ("reqs", ([] : list (string * list string)) : Any), ("nreq", 0 : Any), ("bid_window", 30 : Any),
   ("req_contexts", ([] : list (string * list string)) : Any),
   ("done_marks", ([] : list (string * string)) : Any), ("close_marks", ([] : list (string * string)) : Any),
   ("merge_seen", ([] : list (string * nat)) : Any),
   ("plan_lines", ([] : list (string * string)) : Any),
   (* the leader's title for each bid it picked to merge, sent with the merge *)
   ("merge_titles", ([] : list (string * string)) : Any)].

is_merged (b : bid) : bool := match bst b with Merged => true | _ => false end.

scripted (a : obj) : bool := seq (backend a) "scripted".

enqueue (a : obj) (tx : list string) : obj :=
  if existsb (fun t => seq (hash_list t) (hash_list tx)) (queue a) then a else setf a "queue" (queue a ++ [tx]).

ask_once (a : obj) (key : string) : bool := negb (mem key (asked a)).
note_asked (a : obj) (key : string) : obj := setf a "asked" (firstn 500 (key :: asked a)).

(** The policy: nothing is signed, merged or approved that edits too many
    files or touches a denied path. The market already refuses unsafe paths. *)
violation (a : obj) (m : obj) (b : bid) : string :=
  if param m "max_files" <? length (edit_paths (edits b)) then "edits too many files"
  else match find (fun p => git_meta_component p) (edit_paths (edits b)) with
       | Some p => append p " is on the denied list"
       | None => match find (fun p => existsb (fun d => starts d p) (deny a)) (edit_paths (edits b)) with
                 | Some p => append p " is on the denied list"
                 | None => ""
                 end
       end.

(** Prompts. Soma replaces {{F}} with a fresh token read from the shell, so
    text from other agents can't close its own fence. *)
fence (label body : string) : string :=
  append prompt_fence_open (append (defang label) (append prompt_fence_body (append (defang body) prompt_fence_close))).

preamble (a : obj) (role : string) : string :=
  append prompt_identity_start (append (me a) (append prompt_role_intro
  (append role (append prompt_role_end (append (perspective a)
  prompt_untrusted_policy))))).

edit_text (e : edit) : string :=
  if negb (seq (eold e) "") then append (fence (append prompt_replace_label (epath e)) (eold e)) (fence prompt_with_label (enew e))
  else if seq (enew e) "" then fence prompt_delete_label (epath e)
  else fence (append prompt_write_label (epath e)) (enew e).

edits_text (b : bid) : string := fold_left (fun s e => append s (edit_text e)) (edits b) "".

(** the repositories in this agent's scope (genesis may exclude some) *)
my_repos (a m : obj) : list (string * string) := filter (fun r => negb (excludes m (me a) (fst r))) (repos m).

repo_names (a m : obj) : string := fold_left (fun s r => append s (append " " (fst r))) (my_repos a m) "".

goal_text (a : obj) : string := fold_left (fun s l => append s (append l "
")) (goal a) "".

(** what became of a task, for a leader drafting the next one: done when its
    leader's mark merged, else closed with work merged (its plan item still
    open), else closed with nothing merged *)
task_label (m : obj) (t : task) : string :=
  let merged := filter (fun b => (btask b =? tid t) && is_merged b) (bids m) in
  if topen t then prompt_task_open_label
  else if existsb (fun b => seq (note b) mark_note) merged then prompt_task_done_label
  else match merged with
       | [] => prompt_task_unfinished_label
       | _ => prompt_task_partial_label
       end.

(** the notes of the bids merged on a task so far, for a bidder or leader
    taking it further: a task stays open across merges until its leader
    judges it done *)
merged_text (m : obj) (t : task) : string :=
  let ms := filter (fun b => (btask b =? tid t) && is_merged b) (bids m) in
  match ms with
  | [] => ""
  | _ => append prompt_merged_heading
           (fold_left (fun s b => append s (fence (append prompt_merged_bid_label (append (show (bidn b)) (append prompt_by_label (bidder b)))) (note b))) ms "")
  end.

(** With tasks open, the leader may add one that runs beside them: its own
    call, on what each task changes and needs. *)
parallel_text (m : obj) : string :=
  match open_tasks m with
  | [] => ""
  | ts => append (append draft_parallel_count_label (show (length ts)))
            (append (append draft_parallel_limit_label (show (param m "max_open_tasks")))
            draft_parallel_guidance)
  end.

leader_context (m : obj) (repo : string) : string :=
  match leader_entries m with
  | [] => ""
  | _ => append prompt_leader_journal_guidance
      (fence prompt_leader_journal_label (leader_recent m repo))
  end.

draft_prompt (a m : obj) : string :=
  append (append (preamble a draft_role) (leader_context m ""))
  (append draft_goal_heading (append (goal_text a)
  (append draft_plan_context
  (append (fold_left (fun s t => append s (fence (append (task_label m t) (trepo t)) (spec t))) (tasks m) "")
  (append draft_closed_task_guidance
  (append (append draft_repository_context (parallel_text m)) (append (append draft_task_instructions (repo_names a m))
  draft_reply_format))))))).

(** Why earlier bids on a task weren't merged, the last four: what they ran
    into helps the next bidder. Other agents wrote them, so they're fenced. *)
rejections (m : obj) (t : task) : string :=
  let rs := filter (fun b => (btask b =? tid t) && match bst b with Rejected => true | _ => false end) (bids m) in
  match rs with
  | [] => ""
  | _ => append patch_rejection_guidance
           (fold_left (fun s b => append s (fence (append patch_rejected_bid_label (append (show (bidn b)) (append patch_by_label (bidder b))))
                                                  (append (note b) (append patch_rejection_label (why b))))) (firstn 4 (rev rs)) "")
  end.

patch_prompt (a m : obj) (t : task) : string :=
  append (preamble a (append patch_role_prefix (trepo t)))
  (append (fence patch_task_label (spec t)) (append (merged_text m t) (append (rejections m t) (append patch_plan_context
  patch_instructions)))).

pick_prompt (a m : obj) (t : task) (bs : list bid) : string :=
  append (append (preamble a pick_role) (leader_context m (trepo t)))
  (append (fence pick_task_label (spec t)) (append (merged_text m t)
  (append (match bs with [] => pick_no_bids | _ => "" end)
  (append (fold_left (fun s b => append s (append pick_bid_label (append (show (bidn b)) (append pick_by_label (append (bidder b)
            (append pick_bid_separator (append (fence pick_note_label (note b)) (edits_text b)))))))) bs "")
  (append pick_plan_context
  pick_instructions))))).

attest_prompt (a m : obj) (t : string) (b : bid) : string :=
  append (preamble a attest_role)
  (append (fence attest_task_label t) (append (fence attest_note_label (note b))
  (append (if seq (note b) mark_note
           then append attest_plan_mark_guidance (match task_by m (btask b) with Some tk => merged_text m tk | None => "" end)
           else "") (append (edits_text b)
  attest_instructions)))).

(** The scripted backend's answers, in the same flattened form the shell
    gives a model's JSON reply: [key; value; key; value...]. *)
scripted_answer (a m : obj) (data : list string) : list string :=
  match data with
  | "draft" :: _ =>
      (* repositories in turn *)
      let r := fst (nth (length (tasks m) mod length (my_repos a m)) (my_repos a m) ("", "")) in
      match find (fun l => negb (existsb (fun t => seq (spec t) l) (tasks m))) (goal a) with
      | Some l => ["task", l, "repo", r] | None => ["task", "null"]
      end
  | "patch" :: t :: _ =>
      let s := match task_by m (num t) with Some tk => spec tk | None => "" end in
      ["edits.0.path", append "work/task-" (append t ".txt"), "edits.0.old", "", "edits.0.new", append s (append "
implemented by " (me a)), "title", append "task " (append t (append " by " (me a))), "note", append "scripted patch from " (me a)]
  | "pick" :: _ :: first :: _ => if seq (behavior a) "deny" then ["merge", "0", "done", "false"] else ["merge", first, "title", append "fulfills a goal line: bid " first, "done", "true"]
  | ["pick", _] => ["merge", "0", "done", if seq (behavior a) "deny" then "false" else "true"]
  | "attest" :: _ => ["approve", if seq (behavior a) "deny" then "false" else "true", "reason", append "scripted " (behavior a)]
  | _ => []
  end.

(** A reason is part of the signed vote, not a discarded model field.
    Empty reasons keep the legacy wire shape for old scripted clients. *)
attestation_fields (bid : string) (approve : bool) (tree reason : string) : list string :=
  let reason := take_str 700 (clean_text (redact reason)) in
  (["attest", bid, if approve then "yes" else "no"] ++ (if approve then [tree] else [])) ++
  (if seq reason "" then [] else [reason]).

(** what a flattened reply says at a key *)
kv_at (kv : list string) (k : string) : string := get_or "" k (pairs kv).

journal_note (a m : obj) (kind repo bid head tree commit context origin info : string) : obj :=
  let data := [kind, repo, bid, head, tree, commit, take_str 2000 (clean_text context),
               take_str 256 (clean_text origin), take_str 4000 (clean_text info)] in
  if leader_fields_ok data then enqueue a ("leader-note" :: data) else a.

Fixpoint edits_from (kv : list string) (i fuel : nat) : list string :=
  match fuel with
  | 0 => []
  | Succ f =>
      let k := append "edits." (show i) in
      let p := kv_at kv (append k ".path") in
      if seq p "" then [] else p :: kv_at kv (append k ".old") :: kv_at kv (append k ".new") :: edits_from kv (i + 1) f
  end.

Fixpoint list_from (kv : list string) (key : string) (i fuel : nat) : list string :=
  match fuel with
  | 0 => []
  | Succ f => let v := kv_at kv (append key (append "." (show i))) in if seq v "" then [] else v :: list_from kv key (i + 1) f
  end.

Fixpoint rejects_from (kv : list string) (i fuel : nat) : list (string * string) :=
  match fuel with
  | 0 => []
  | Succ f =>
      let b := kv_at kv (append "reject." (append (show i) ".bid")) in
      if seq b "" then [] else (b, kv_at kv (append "reject." (append (show i) ".reason"))) :: rejects_from kv (i + 1) f
  end.

(** the title a pick's reply gives the rejection of bid [b] *)
Fixpoint reject_title_at (kv : list string) (b : string) (i fuel : nat) : string :=
  match fuel with
  | 0 => ""
  | Succ f =>
      let k := append "reject." (show i) in
      let x := kv_at kv (append k ".bid") in
      if seq x "" then "" else if seq x b then kv_at kv (append k ".title") else reject_title_at kv b (i + 1) f
  end.
reject_title (kv : list string) (b : string) : string := reject_title_at kv b 0 10.

(** [tx] is a bid for task [t], the task id in decimal. *)
bid_for (tx : list string) (t : string) : bool :=
  match tx with "bid" :: id :: _ => seq id t | "tbid" :: id :: _ => seq id t | _ => false end.

(** A bid for task [t] this agent already has out: pending on the chain, sent
    and not yet in a block, or waiting in the queue. One agent never keeps
    two bids on one task (docs/DOGFOOD-REPORT.md D-5). *)
pending_bid (a m : obj) (t : string) : bool :=
  existsb (fun b => (btask b =? num t) && seq (bidder b) (me a) && is_pending (bst b)) (bids m)
  || bid_for (inflight_tx a) t
  || existsb (fun q => bid_for q t) (queue a).

(** A transaction that has landed (its nonce was used, accepted or refused) or
    sat for 30 blocks without landing is no longer in flight. *)
release_inflight (a m : obj) : obj :=
  let n := nonce_of m (me a) in
  if (0 <? inflight a) && ((inflight a <=? n) || (sent_at a + 30 <=? mheight m))
  then setf (setf a "inflight" 0) "inflight_tx" ([] : list string)
  else a.

(** A model's answer, with the request it answers. Nothing it says is trusted:
    each action is checked against the market and the policy first. *)
on_answer (a m : obj) (data kv : list string) : obj :=
  match data with
  | "draft" :: _ =>
      let t := kv_at kv "task" in
      let r := match kv_at kv "repo", repos m with "", [(r, _)] => r | r, _ => r end in
      (* no task, with none open, in a finishing market: say so (finish) *)
      if seq t "" || seq t "null" then
        (if negb (param m "finish" =? 0) && (length (open_tasks m) =? 0) && is_leader m (me a) then enqueue a ["finish"] else a)
      else enqueue a ("post" :: r :: clean_text t :: firstn 8 (list_from kv "context" 0 8))
  | "patch" :: t :: v :: _ =>
      let a := release_inflight a m in
      let es := edits_from kv 0 (5 * param m "max_files") in
      (* the bid names the version the patch was written on: if merges
         landed while the model thought, the leader's merge check decides
         whether its edits still apply, line by line. A bid already pending
         on the chain or in flight is kept, and this reply is dropped: it
         would be a second bid on the same task. *)
      if seq (hash_list es) (hash_list []) then a
      else if pending_bid a m t then a
      else
        let ti := short_title (kv_at kv "title") in
        enqueue a (if seq ti "" then "bid" :: t :: v :: clean_text (kv_at kv "note") :: es
                   else "tbid" :: t :: v :: ti :: clean_text (kv_at kv "note") :: es)
  | "pick" :: t :: cands =>
      let repo := match task_by m (num t) with Some tk => trepo tk | None => "" end in
      let info := leader_json_object [("task", t), ("selected_bid", kv_at kv "merge"),
        ("done", kv_at kv "done"), ("close", kv_at kv "close"),
        ("handoff", take_str 1200 (redact (kv_at kv "handoff"))),
        ("rejections", take_str 1800 (redact (nio_json_strings kv)))] in
      let head := match kv_at kv "_journal_base" with "" => get_or "" repo (repos m) | h => h end in
      let origin := match kv_at kv "_journal_origin" with "" => append "pick/task/" t | o => o end in
      let a := journal_note a m "review" repo (kv_at kv "merge") head "" ""
        "leader selection; CI and committed merge still required" origin info in
      if negb (is_leader m (me a)) then a else
      let a := fold_left (fun a r =>
                 if mem (fst r) cands then
                   let ti := short_title (reject_title kv (fst r)) in
                   enqueue a (if seq ti "" then ["reject", fst r, clean_text (snd r)] else ["reject", fst r, clean_text (snd r), ti])
                 else a) (rejects_from kv 0 10) a in
      let pick := kv_at kv "merge" in
      let a := match short_title (kv_at kv "title") with "" => a | ti => setf a "merge_titles" (firstn 50 (put pick ti (merge_titles a))) end in
      let merging := mem pick cands && negb (mem pick (map fst (rejects_from kv 0 10))) in
      let a := if seq (kv_at kv "done") "true"
               then setf (setf a "done_marks" (put t (if merging then pick else "0") (done_marks a)))
                         "plan_lines" (put t (plan_line_start (clean_text (kv_at kv "plan_line"))) (plan_lines a))
               else if seq (kv_at kv "close") "true"
               then setf a "close_marks" (put t (if merging then pick else "0") (close_marks a))
               else a in
      if merging then enqueue a ["merge", pick] else a
  | "attest" :: b :: tree :: _ =>
      enqueue a (attestation_fields b (seq (kv_at kv "approve") "true") tree (kv_at kv "reason"))
  | _ => a
  end.

(** Asks the model, or answers at once when scripted. A silent agent's
    model never answers, like one that has died. ctx is a repository and the
    paths the shell puts in the prompt's {{REPO}}; a patch request also gets a
    scratch checkout, for a model with tools. *)
ask_ctx (a m : obj) (data : list string) (prompt : string) (ctx : list string) : obj * list (list string) :=
  if seq (behavior a) "silent" then (a, [])
  else if scripted a then (on_answer a m data (scripted_answer a m data), [])
  else
    let id := show (nreq a + 1) in
    let context := match data with
      | "pick" :: t :: _ => match task_by m (num t) with
        | Some tk => [get_or "" (trepo tk) (repos m), Stdlib.Strings.String.concat "/" ["pick", "term", show (term m), "request", id]]
        | None => [] end
      | _ => [] end in
    let a := setf a "req_contexts" (firstn 50 ((id, context) :: req_contexts a)) in
    (setf (setf a "nreq" (nreq a + 1)) "reqs" (firstn 50 ((id, data) :: reqs a)),
     [("llm" :: id :: hd "" data :: prompt :: ctx)]).

ask (a m : obj) (data : list string) (prompt : string) : obj * list (list string) := ask_ctx a m data prompt [].

with_ask (st : obj * list (list string)) (m : obj) (key : string) (data : list string) (prompt : string) (ctx : list string) : obj * list (list string) :=
  let (a, o) := st in
  if ask_once a key then let (a', o') := ask_ctx (note_asked a key) m data prompt ctx in (a', o ++ o') else (a, o).

(** Asks for key once, and again after each failed call (failed counts it),
    up to three failures: a leader whose model's draft or pick failed asks
    again, as a patch is. with_ask alone asks once, so a leader whose first
    draft failed drafted nothing for the rest of its term. An answered request
    is not asked again. *)
with_retry (st : obj * list (list string)) (m : obj) (key : string) (data : list string) (prompt : string) (ctx : list string) : obj * list (list string) :=
  let (a, o) := st in
  let n := get_or 0 key (attempts a) in
  let k := append key (append "." (show n)) in
  if (3 <=? n) || negb (ask_once a k) then st else
  (* the request ask_ctx is about to make gets the next id *)
  let a := setf a "retry_keys" (firstn 50 ((show (nreq a + 1), key) :: retry_keys a)) in
  with_ask (a, o) m k data prompt ctx.

(** why a task closes with its plan line still open *)
unmarked_close_text (t : string) (done no_line marked closing : bool) : string :=
  append "task " (append t (append " closes with no mark in .plan, so its plan line stays open: "
    (if closing && negb done then "the leader closed it with its work merged, for a later task to take up the rest"
     else if negb done then "no bid could finish it (too many rejected, or open too long)"
     else if marked then "its mark didn't merge"
     else if no_line then "the leader judged it done but named no plan line, or its line couldn't be marked"
     else ""))).

lead (a m : obj) : obj * list (list string) :=
  if negb (is_leader m (me a)) || negb (pending_bid_id m =? 0) then (a, []) else
  let h := mheight m in
  (* close tasks whose work has merged, and tasks no bid could do (too many
     rejected bids, or open too long), once nothing for them is pending: a task
     the agents can't finish would otherwise keep the leader from drafting *)
  let for_task t := filter (fun b => btask b =? tid t) (bids m) in
  (* tasks on a repository outside this agent's scope (genesis may exclude
     some) are left to a leader whose node checks them: no pick, mark or
     close here, and the market doesn't count them against this term *)
  let mine := filter (in_scope m (me a)) in
  (* a leader's own pending bids don't count: no one reviews them this term,
     so waiting for them would keep the task open for as long as it leads *)
  (* a task stays open across merges: its rejections count from its last
     merge, and each merge gives it task_blocks more *)
  let merged_on t := filter is_merged (for_task t) in
  let last_merge t := fold_left (fun n b => Nat.max n (bidn b)) (merged_on t) 0 in
  let stuck t := negb (existsb (fun b => is_pending (bst b) && negb (seq (bidder b) (me a))) (for_task t))
                 && ((param m "task_rejects" <=? length (filter (fun b => (last_merge t <? bidn b) && match bst b with Rejected => true | _ => false end) (for_task t)))
                     || (param m "task_blocks" * (1 + length (merged_on t)) <=? h - posted_at t)) in
  (* done when this leader judged it so, and the bid it named has merged *)
  let judged_done t := match lookup (show (tid t)) (done_marks a) with
                       | Some b => seq b "0" || existsb (fun x => seq (show (bidn x)) b) (merged_on t)
                       | None => false
                       end in
  (* closed for now when this leader judged so, and the bid it named has
     merged: the work stands, the plan item stays open for a later task *)
  let judged_closed t := match lookup (show (tid t)) (close_marks a) with
                         | Some b => seq b "0" || existsb (fun x => seq (show (bidn x)) b) (merged_on t)
                         | None => false
                         end in
  let mark_merged_on t := existsb (fun b => seq (note b) mark_note && is_merged b) (for_task t) in
  (* a task judged done gets its plan line marked first, when it names one:
     the leader's mark, a bid of its own (core/market.soma). Lead runs only with
     no merge pending, so a mark already made has merged or failed. *)
  (* A close that leaves the plan line open is logged, once, with why: a
     task closed unmarked is drafted again from .plan by a later leader, or
     after a new genesis, though its work has merged *)
  let closed := fold_left (fun (st : obj * list (list string)) t =>
             let (a, o) := st in
             let id := show (tid t) in
             let line := get_or "" id (plan_lines a) in
             let marked := existsb (fun b => seq (note b) mark_note) (for_task t) in
             let mark_merged := mark_merged_on t in
             (* a merged mark is a leader's judgment the attestors approved:
                whoever leads now closes the task, not only the leader that
                made it, whose own judgment (done_marks) no other node has *)
             if stuck t || mark_merged || (judged_done t && (seq line "" || marked)) || (negb (judged_done t) && judged_closed t) then
               let a := enqueue a ["close", id] in
               if mark_merged || negb (ask_once a (append "unmarked." id)) then (a, o)
               else (note_asked a (append "unmarked." id),
                     o ++ [["log", unmarked_close_text id (judged_done t) (seq line "") marked (judged_closed t)]])
             else if judged_done t && ask_once a (Stdlib.Strings.String.concat "." ["mark", show (term m), id])
             then (enqueue (note_asked a (Stdlib.Strings.String.concat "." ["mark", show (term m), id])) ["markq", id], o)
             else (a, o)) (mine (open_tasks m)) (a, []) in
  (* review bids once the chosen workers have bid or the window has passed *)
  let st := fold_left (fun (st : obj * list (list string)) (t : task) =>
      (* a task whose mark merged closes above: no pick for it *)
      if mark_merged_on t then st else
      let cands := filter (fun b => (btask b =? tid t) && is_pending (bst b) && negb (seq (bidder b) (me a))) (bids m) in
      (* no bids waiting on a task that has merges: is it done, or done for
         now? asked once a version *)
      if (length cands =? 0) then
        (if (0 <? length (merged_on t)) && negb (judged_done t) && negb (judged_closed t)
         then with_retry st m (append (append "review." (append (show (term m)) ".")) (append (show (tid t)) (append "." (show (version m))))) ["pick", show (tid t)] (pick_prompt (fst st) m t []) []
         else st) else
      if (length cands <? length (bidders_for m t)) && (h <? posted_at t + bid_window (fst st)) then st else
      let key := append (append "pick." (append (show (term m)) ".")) (append (show (tid t)) (append "." (append (hash_list (map (fun b => show (bidn b)) cands)) (append "." (show (version m)))))) in
      let bad := filter (fun b => negb (seq (violation (fst st) m b) "")) cands in
      let good := filter (fun b => seq (violation (fst st) m b) "") cands in
      (* the policy's rejections once; the pick, again if the model failed *)
      let st := if ask_once (fst st) key
                then (fold_left (fun a b => enqueue a ["reject", show (bidn b), clean_text (append "policy: " (violation a m b))]) bad (note_asked (fst st) key), snd st)
                else st in
      match good with
      | [] => st
      | _ => with_retry st m (append key ".ask") ("pick" :: show (tid t) :: map (fun b => show (bidn b)) good) (pick_prompt (fst st) m t good) []
      end) (mine (open_tasks m)) closed in
  (* room for another task: draft the next one from the goal. With tasks
     open, the model writes one only if it judges it can run beside them, and
     asks again when the count of tasks or of open ones changes. Those counts
     can change while a draft is outstanding: finish that request and let its
     post land before asking from the new state, otherwise both replies can
     post the same work. Other leader duties may continue in the meantime. *)
  let a := release_inflight (fst st) m in
  let st := (a, snd st) in
  let posting tx := match tx with "post" :: _ => true | _ => false end in
  let drafting := existsb (fun r => match snd r with "draft" :: _ => true | _ => false end) (reqs a)
                  || existsb posting (queue a) || posting (inflight_tx a) in
  if negb drafting && (length (open_tasks m) <? param m "max_open_tasks") && negb (length (goal a) =? 0) && negb (length (my_repos a m) =? 0) then
    with_retry st m (append "draft." (append (show (term m)) (append "." (append (show (length (tasks m))) (append "." (show (length (open_tasks m)))))))) ["draft"] (draft_prompt (fst st) m) []
  else st.

bid_duty (a m : obj) : obj * list (list string) :=
  let a := release_inflight a m in
  if seq (leader m) "" || is_leader m (me a) then (a, []) else
  if (0 <? get_or 0 (me a) (lastbid m)) && (mheight m <? get_or 0 (me a) (lastbid m) + param m "bid_cooldown") then (a, []) else
  fold_left (fun (st : obj * list (list string)) (t : task) =>
    let (a, o) := st in
    (* a task takes bids until its leader closes it: three tries per merge on it *)
    let finished := existsb (fun b => (btask b =? tid t) && seq (bidder b) (me a) && is_pending (bst b)) (bids m) in
    let k := append (show (tid t)) (append "." (show (length (filter (fun b => (btask b =? tid t) && is_merged b) (bids m))))) in
    (* three tries per version: a merge on any task (another open one too)
       moves the version, and a bid that went stale with it costs nothing:
       the agent writes an updated one *)
    let n := if get_or 0 k (attempt_v a) =? version m then get_or 0 k (attempts a) else 0 in
    (* one patch at a time per task: not while a model is writing one, not while
       one waits to be sent, and not while one has been sent and is not yet in
       a block. The in-flight transaction is that bid, not only its nonce. *)
    let waiting := existsb (fun r => match snd r with "patch" :: x :: _ => seq x (show (tid t)) | _ => false end) (reqs a)
                   || existsb (fun q => bid_for q (show (tid t))) (queue a)
                   || bid_for (inflight_tx a) (show (tid t)) in
    (* after a merge on the task, wait bid_cooldown blocks: a leader who
       judged it done closes it, and a bid then would be wasted *)
    let merges := length (filter (fun b => (btask b =? tid t) && is_merged b) (bids m)) in
    let a := if (0 <? merges) && negb (existsb (fun x => seq (fst x) k) (merge_seen a))
             then setf a "merge_seen" (firstn 50 ((k, mheight m) :: merge_seen a)) else a in
    let settling := (0 <? merges) && (mheight m <? get_or 0 k (merge_seen a) + param m "bid_cooldown") in
    if negb (mem (me a) (bidders_for m t)) || finished || waiting || settling || (3 <=? n) then (a, o) else
    let a := setf (setf a "attempts" (put k (n + 1) (attempts a))) "attempt_v" (put k (version m) (attempt_v a)) in
    with_ask (a, o) m (append "patch." (append k (append "." (append (show (version m)) (append "." (show n))))))
      ["patch", show (tid t), show (version m)] (patch_prompt a m t) (trepo t :: tctx t)) (open_tasks m) (a, []).

(** a check of a bid's edits on the head, by the shell: for an attest, or for
    a merge, which names the tree it gives *)
check_req (a m : obj) (kind : string) (b : bid) (t : string) : obj * list (list string) :=
  let r := bid_repo m b in
  let id := show (nreq a + 1) in
  (* the head the check runs on, last: a merge or mark names it *)
  let head := get_or "" r (repos m) in
  let origin := Stdlib.Strings.String.concat "/" [kind, "term", show (term m), "request", id] in
  let a := journal_note a m "check-start" r (show (bidn b)) head "" "" "queued; no result yet" origin
    "Check requested on this exact base tree. A result may arrive in a later term." in
  (setf (setf a "nreq" (nreq a + 1)) "reqs" ((id, [kind, show (bidn b), t, head, origin, r]) :: reqs a),
   [("check" :: id :: r :: get_or "" r (repos m) :: flat_edits (edits b))]).

(** what an attestation of bid b to the pending merge is asked under: a merge
    proposed again is a new question *)
attest_key (m : obj) (b : string) : string :=
  append "attest." (append b (append "." (match pending m with Some p => show (pat p) | None => "0" end))).

attest_duty (a m : obj) : obj * list (list string) :=
  match pending m with
  | None => (a, [])
  | Some p =>
      match bid_by m (pbid p) with
      | None => (a, [])
      | Some b =>
          if seq (pby p) (me a) || seq (bidder b) (me a) || existsb (fun v => seq (fst v) (me a)) (pvotes p)
             || excludes m (me a) (bid_repo m b) then (a, []) else
          (* asked again after a failed model call, up to three failures, as a
             draft is: a failure asked once left the merge waiting out the
             whole attest window without this agent's vote *)
          let base := attest_key m (show (bidn b)) in
          let n := get_or 0 base (attempts a) in
          let key := append base (append "." (show n)) in
          if (3 <=? n) || negb (ask_once a key) then (a, []) else
          let a := note_asked a key in
          let v := violation a m b in
          if negb (seq v "") then (enqueue a (attestation_fields (show (bidn b)) false "" v), [])
          else
            (* first the shell applies the edits to the head, gets the tree and
               runs CI if it has one; then the model judges *)
            let t := match task_by m (btask b) with Some tk => spec tk | None => "" end in
            check_req a m "check" b t
      end
  end.

reveal_duty (a m : obj) : obj * list (list string) :=
  let key := append "reveal." (append (show (term m)) (append "." (show (mheight m / 15)))) in
  if awaiting m && negb (existsb (fun r => seq (fst r) (me a)) (reveals m)) && ask_once a key
  then (note_asked a key, [["reveal", show (term m + 1), get_or "" (me a) (tips m)]]) else (a, []).

(** One transaction in flight at a time, at the next nonce. The transaction
    itself is kept, not only its nonce, until it lands in a block (accepted
    or refused) or 30 blocks pass without it. A merge without a tree is
    checked first. *)
flush (a m : obj) : obj * list (list string) :=
  let a := release_inflight a m in
  let n := nonce_of m (me a) in
  match queue a with
  | ["merge", b] :: rest =>
      let a := setf a "queue" rest in
      (* a bid merged, rejected or cleared since it was queued isn't checked *)
      if negb (is_leader m (me a)) then (a, []) else
      match bid_by m (num b) with
      | Some bd =>
        let head := get_or "" (bid_repo m bd) (repos m) in
        let running := existsb (fun r => match snd r with
          | "mcheck" :: other :: _ :: on :: _ => seq b other && seq on head
          | _ => false end) (reqs a) in
        if is_pending (bst bd) && negb running then check_req a m "mcheck" bd "" else (a, [])
      | None => (a, [])
      end
  | ["markq", t] :: rest =>
      let a := setf a "queue" rest in
      if negb (is_leader m (me a)) then (a, []) else
      let line := get_or "" t (plan_lines a) in
      match task_by m (num t) with
      | Some tk =>
          let r := trepo tk in
          let id := show (nreq a + 1) in
          let origin := Stdlib.Strings.String.concat "/" ["markcheck", "term", show (term m), "request", id] in
          let a := journal_note a m "check-start" r "0" (get_or "" r (repos m)) "" ""
            "plan mark validation queued" origin (append "Validate completion mark for task " t) in
          (setf (setf a "nreq" (nreq a + 1)) "reqs" ((id, ["markcheck", t, line, get_or "" r (repos m), origin]) :: reqs a),
           [("check" :: id :: r :: get_or "" r (repos m) :: (epath (mark_edit line) :: eold (mark_edit line) :: enew (mark_edit line) :: []))])
      | None => (a, [])
      end
  | tx :: rest =>
      if mem (hd "" tx) ["merge", "mark", "post", "reject", "conflict", "close", "finish"]
         && negb (is_leader m (me a)) then (setf a "queue" rest, []) else
      if inflight a =? 0 then
        (setf (setf (setf (setf a "queue" rest) "inflight" (n + 1)) "sent_at" (mheight m)) "inflight_tx" tx,
         [("submit" :: show (n + 1) :: tx)])
      else (a, [])
  | [] => (a, [])
  end.

(** After every block: each duty, then whatever is ready to send. *)
tick (a m : obj) : obj * list (list string) :=
  let (a, o1) := reveal_duty a m in
  let (a, o2) := lead a m in
  let (a, o3) := bid_duty a m in
  let (a, o4) := attest_duty a m in
  let (a, o5) := flush a m in
  (a, o1 ++ o2 ++ o3 ++ o4 ++ o5).

drop_req (a : obj) (id : string) : obj :=
  setf (setf a "reqs" (filter (fun r => negb (seq (fst r) id)) (reqs a)))
       "req_contexts" (filter (fun r => negb (seq (fst r) id)) (req_contexts a)).

(** A model call failed: forget the request, so the duty can ask again. A
    request asked through with_retry counts a failure for its key, which is
    what lets it be asked again. *)
failed (a : obj) (id : string) : obj :=
  let a := match lookup id (retry_keys a) with
           | Some key => setf a "attempts" (put key (get_or 0 key (attempts a) + 1) (attempts a))
           | None => a
           end in
  drop_req (setf a "retry_keys" (filter (fun r => negb (seq (fst r) id)) (retry_keys a))) id.

(** A check that couldn't run on this node says nothing about the bid: the
    agent abstains, and says why. *)
abstain (a : obj) (kv : list string) : obj * list (list string) :=
  (a, [["log", append "a check couldn't run on this node, so this agent abstains: " (kv_at kv "why")]]).

(** A model or a check answered request id: kv is the flattened reply. *)
answered (a m : obj) (id : string) (kv : list string) : obj * list (list string) :=
  let req := lookup id (reqs a) in
  let kv := match lookup id (req_contexts a) with
    | Some [head, origin] => ["_journal_base", head, "_journal_origin", origin] ++ kv
    | _ => kv end in
  let a := drop_req a id in
  let a := match req with
    | Some ("markcheck" :: t :: _ :: head :: origin :: _) =>
        match task_by m (num t) with
        | Some tk => journal_note a m (if seq (kv_at kv "ok") "true" then "check-pass" else "check-fail")
            (trepo tk) "0" head (kv_at kv "tree") (kv_at kv "commit") (kv_at kv "context") origin
            (leader_json_object [("task", t), ("base_commit", kv_at kv "base_commit"),
              ("result", kv_at kv "ok"), ("reason", take_str 700 (redact (kv_at kv "why"))),
              ("output", take_str 2000 (kv_at kv "details"))])
        | None => a
        end
    | Some (kind :: b :: _ :: head :: origin :: more) =>
      if mem kind ["check", "mcheck"] then
        let repo := match more with r :: _ => r | [] =>
          match bid_by m (num b) with Some bd => bid_repo m bd | None => "" end end in
        journal_note a m (if seq (kv_at kv "ok") "true" then "check-pass" else "check-fail")
            repo b head (kv_at kv "tree") (kv_at kv "commit") (kv_at kv "context") origin
            (leader_json_object [("result", kv_at kv "ok"), ("stage", kv_at kv "stage"),
              ("base_commit", kv_at kv "base_commit"), ("reason", take_str 700 (redact (kv_at kv "why"))),
              ("reused_local_check", kv_at kv "reused"),
              ("verified_request", kv_at kv "verified_request"), ("check_key", kv_at kv "check_key"),
              ("output", take_str 2000 (kv_at kv "details"))])
      else a
    | _ => a
    end in
  match req with
  | Some ("check" :: b :: t :: _) =>
      if seq (kv_at kv "ok") "error" then abstain a kv
      else if seq (kv_at kv "ok") "true" then
        match bid_by m (num b) with
        | Some bd => (* the model's call gets the next id; if it fails, attest_duty asks again *)
                     let a := setf a "retry_keys" (firstn 50 ((show (nreq a + 1), attest_key m b) :: retry_keys a)) in
                     let '(a, o) := ask a m ["attest", b, kv_at kv "tree"] (attest_prompt a m t bd) in
                     let '(a, o') := flush a m in (a, o ++ o')
        | None => (a, [])
        end
      else flush (enqueue a (attestation_fields b false "" (kv_at kv "why"))) m
  | Some ("markcheck" :: t :: line :: rest) =>
      if negb (is_leader m (me a)) then flush a m else
      let on := match rest with o :: _ => o | [] => "" end in
      (* a merge landed while the check ran: its answer is the old head's,
         so the mark is checked again on the head *)
      if match task_by m (num t) with Some tk => moved_since m (trepo tk) on | None => false end
      then flush (enqueue a ["markq", t]) m
      else if seq (kv_at kv "ok") "true" then flush (enqueue a ["mark", t, line, kv_at kv "tree", on]) m
      else
        let a := setf a "plan_lines" (put t "" (plan_lines a)) in
        let '(a, o) := flush a m in
        (a, ["log", append "the plan line of task " (append t (append " can't be marked, so it closes unmarked: " (kv_at kv "why")))] :: o)
  | Some ("mcheck" :: b :: rest) =>
      (* Late checks remain useful journal entries, but leadership is checked
         again before spending another check or trying to merge/reject. *)
      if negb (is_leader m (me a)) then flush a m else
      if negb (match bid_by m (num b) with Some bd => is_pending (bst bd) | None => false end)
      then flush a m else
      (* the head the check ran on; none recorded is taken as the head *)
      let on := match rest with _ :: o :: _ => o | _ => "" end in
      if seq (kv_at kv "ok") "error" then abstain a kv
      (* a merge landed while the check ran (bid 68 of the joint network's
         first night): whatever it said, it said it of the old head, so the
         bid is checked again on the head *)
      else if match bid_by m (num b) with Some bd => moved_since m (bid_repo m bd) on | None => false end
      then flush (enqueue a ["merge", b]) m
      else if seq (kv_at kv "ok") "true" then
        flush (enqueue a (["merge", b, kv_at kv "tree", on] ++ match get_or "" b (merge_titles a) with "" => [] | ti => [ti] end)) m
      else if seq (kv_at kv "stage") "node" then abstain a kv
      (* edits that don't apply to the head, on a bid made before a merge
         since, conflict with that merge: the bid is cleared, not rejected,
         and its bidder writes an updated one. On a bid made at the head they
         were wrong all along: rejected *)
      else if seq (kv_at kv "stage") "apply" && match bid_by m (num b) with Some bd => base bd <? version m | None => false end
      then flush (enqueue a ["conflict", b]) m
      else flush (enqueue a ["reject", b, clean_text (redact
             (if seq (kv_at kv "stage") "ci" then append "CI failed on the merged tree: " (kv_at kv "why")
              else append "its edits don't apply to the head: " (kv_at kv "why")))]) m
  | Some data => flush (on_answer a m data kv) m
  | None => (a, [])
  end.
