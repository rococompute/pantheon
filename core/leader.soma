(** An append-only, hash-linked handoff journal. Entries are signed market
    transactions, ordered by the existing consensus. A check is an observation,
    never an approval or evidence that a contribution actually merged. *)
Import core.util runtime.nodeio.

Record leader_entry := {
  le_number : nat; le_parent : string; le_hash : string;
  le_height : nat; le_term : nat; le_author : string; le_chain : string;
  le_fields : list string }.

(** The bounded prompt projection. Every entry still goes to the complete
    append-only leader-chain.git archive through [leader-record]; head and
    count commit to that full history, not just the projection. *)
leader_entries (m : obj) : list leader_entry := getf m "leader_entries".
leader_tip (m : obj) : string := getf m "leader_tip".
leader_count (m : obj) : nat := getf m "leader_count".

leader_hex (s : string) : bool := negb (seq s "") && forallb (fun c =>
  match json_hex c with Some _ => true | None => false end) (chars s).

leader_json_object (fields : list (string * string)) : string :=
  append "{" (append (Stdlib.Strings.String.concat "," (map (fun p =>
    append (nio_json_string (fst p)) (append ":" (nio_json_string (snd p)))) fields)) "}").

leader_entry_json (e : leader_entry) : string :=
  leader_json_object
    ([("sequence", show (le_number e)), ("parent", le_parent e), ("hash", le_hash e),
      ("height", show (le_height e)), ("term", show (le_term e)), ("author", le_author e), ("chain", le_chain e)]
     ++ combine ["kind", "repo", "bid", "base_tree", "tree", "commit", "context", "origin", "info"] (le_fields e)).

leader_fields_ok (fields : list string) : bool :=
  match fields with
  | [kind, repo, bid, base, tree, commit, context, origin, info] =>
    mem kind ["check-start", "check-pass", "check-fail", "review", "note"]
    && forallb plain_text fields && (slen info <=? 4000) && (slen context <=? 2000)
    && forallb (fun s => slen s <=? 256) [repo, bid, origin]
    && (seq base "" || ((slen base =? 40) && leader_hex base))
    && (seq tree "" || ((slen tree =? 40) && leader_hex tree))
    && (seq commit "" || ((slen commit =? 40) && leader_hex commit))
    && (negb (seq kind "check-pass") || (negb (seq tree "") && negb (seq commit "")))
  | _ => false
  end.

leader_repo (e : leader_entry) : string := nth 1 (le_fields e) "".

(** Keep the newest [keep] of this repo without changing chronological
    order or the windows of other configured repos. Market admission checks
    that the repo exists; at most twelve entries per configured repo remain. *)
Fixpoint leader_trim_repo (repo : string) (keep : nat) (entries : list leader_entry) : list leader_entry :=
  match entries with
  | [] => []
  | e :: rest =>
      if seq (leader_repo e) repo then
        match keep with
        | 0 => leader_trim_repo repo 0 rest
        | Succ k => e :: leader_trim_repo repo k rest
        end
      else e :: leader_trim_repo repo keep rest
  end.

leader_window (e : leader_entry) (entries : list leader_entry) : list leader_entry :=
  e :: leader_trim_repo (leader_repo e) 11 entries.

leader_append (m : obj) (height term : nat) (author : string) (fields : list string)
    : obj * list (list string) :=
  let previous := leader_tip m in
  let number := S (leader_count m) in
  let chain := (getf m "chain" : string) in
  let digest := hash_list (["pantheon-leader-v1", chain, previous, show number, show height, show term, author] ++ fields) in
  let e := {| le_number := number; le_parent := previous; le_hash := digest;
              le_height := height; le_term := term; le_author := author; le_chain := chain; le_fields := fields |} in
  (setf (setf (setf m "leader_entries" (leader_window e (leader_entries m))) "leader_tip" digest) "leader_count" number,
   [["leader-record", previous, digest, leader_entry_json e]]).

(** Recent entries for prompts, unchanged from taking the newest twelve of
    the full archive. The complete archive is never pruned. *)
leader_recent (m : obj) (repo : string) : string :=
  Stdlib.Strings.String.concat newline (map leader_entry_json
    (rev (firstn 12 (filter (fun e => match le_fields e with
      | _ :: r :: _ => seq repo "" || seq r repo | _ => false end) (leader_entries m))))).
