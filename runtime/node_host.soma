(** The host's work, in the kernel (U-1; docs/SHELL-IN-SOMA.md, "The
    host's work"): what a node asks of its checkouts, its model and CI,
    carried out by the kernel (runtime/node_kernel.soma) over a few primitives a
    runner does: git in a directory ([IoGit], [IoGitEnv]), a path's bytes
    ([IoPathProbe] ... [IoReadText]), temporary files and directories, a
    program run to its end ([IoRun]), and processes started, read and
    stopped ([IoProcStart], [IoProcKill], their [job_bytes] and
    [job_ended] events). The binary and the unikernel (whose service runs
    those primitives on the host) do it the same way. What it keeps: the
    model's call count, its limit and the requests held for it, the
    inbox's last poll, and the jobs: what each one's end becomes, what
    goes with it, its time limit, whether the node stopped it, and CI's
    turns. *)
Import core.util runtime.nodeio core.leader.

(** What the host's work knows from the node's setup: the home (absolute),
    the backend, the governed repositories with their genesis commits, the
    most model calls (the --max-llm-calls text), and CI: the command, by
    repository too, its memory, its Docker image and the sandbox runner
    that stands in for Docker ("" for none). *)
Record hworld := {
  hw_home : string;
  hw_backend : string;
  hw_repos : list (string * string);
  hw_max_calls : string;
  hw_ci : string;
  hw_ci_repo : list (string * string);
  hw_ci_memory : string;
  hw_ci_image : string;
  hw_ci_sandbox : string }.

(** what a job's end becomes, given its outcome (runtime/node.soma's job_result):
    a model's raw output, codex's (its reply file beside it), a check's (a
    tree, or a failure), a CI run's *)
Inductive job_done :=
| DoneModel (id kind prompt : string) (ctx : list string)
| DoneCodex (id kind prompt out : string) (ctx : list string)
| DoneCheck (id out ci : string) (evidence : list string)
| DoneCi (id tree memory runner : string) (evidence : list string)
| DoneCleanup (path : string).

(** what goes when it's over: a file, a directory's tree (in the
    background), a container *)
Inductive job_clean := CleanFile (path : string) | CleanTree (path : string) | CleanContainer (name : string).

(** A job: the runner's name for it, when it started, how long it may run
    (seconds), what its end becomes and what goes with it, and whether the
    node stopped it for running past its limit or printing too much. *)
Record hjob := {
  j_id : string;
  j_started : PrimFloat.float;
  j_limit : PrimFloat.float;
  j_done : job_done;
  j_clean : list job_clean;
  j_overtime : bool;
  j_flooded : bool }.

(** What it keeps: model calls so far; the limit (until when, why, the next
    backoff) and whether a release is probing; the requests held for it,
    newest first ([id, kind, prompt, ctx...]); the inbox's last poll; the
    jobs running, newest first, and those that ended and wait for the
    node's outcome; whether a CI run has the turn, and those waiting for it
    ([id, out, tree, ci, container]); and the events their ends queued. *)
Record host_state := {
  hs_calls : nat;
  hs_until : PrimFloat.float;
  hs_reason : string;
  hs_backoff : PrimFloat.float;
  hs_held : list (list string);
  hs_probing : bool;
  hs_inbox : PrimFloat.float;
  hs_jobs : list hjob;
  hs_ended : list hjob;
  hs_ci_busy : bool;
  hs_ci_blocked : bool;
  hs_ci_waiting : list (list string);
  hs_events : list (list string);
  (** Only native CI successes populate this process-local cache. Journal
      claims never populate it; restarting a node revalidates its environment. *)
  hs_verified : list (string * list string) }.

host_start : host_state :=
  {| hs_calls := 0; hs_until := PrimFloat.zero; hs_reason := ""; hs_backoff := nio_small 900;
     hs_held := []; hs_probing := false; hs_inbox := PrimFloat.zero;
     hs_jobs := []; hs_ended := []; hs_ci_busy := false; hs_ci_blocked := false; hs_ci_waiting := []; hs_events := []; hs_verified := [] |}.

hnl : string := Stdlib.Strings.String.String (Ascii.ascii_of_nat 10) Stdlib.Strings.String.EmptyString.

(** a governed repository's checkout: HOME/repos/NAME *)
hrepo_dir (hw : hworld) (r : string) : string := hjoin (hjoin (hw_home hw) "repos") r.

(** The committed handoff stream has its own append-only Git history. Each
    record also has a create-only ref, so replay is idempotent even when the
    branch is already ahead. Fixed metadata makes every replica's Git history
    identical. The governed repositories' HEADs are never moved here. *)
leader_git_env : list string :=
  ["GIT_AUTHOR_NAME=Pantheon", "GIT_AUTHOR_EMAIL=pantheon@localhost",
   "GIT_COMMITTER_NAME=Pantheon", "GIT_COMMITTER_EMAIL=pantheon@localhost",
   "GIT_AUTHOR_DATE=2000-01-01T00:00:00+0000", "GIT_COMMITTER_DATE=2000-01-01T00:00:00+0000"].

hjournal (hw : hworld) (previous digest entry : string) : nprog nanswer :=
  let dir := hjoin (hw_home hw) "leader-chain.git" in
  let branch := "refs/heads/leader-chain" in
  let record := append "refs/pantheon/entries/" digest in
  let zero := "0000000000000000000000000000000000000000" in
  nbind (nask (IoFileExists (hjoin dir "HEAD"))) (fun present =>
  nbind (if fst present then NDone ans_ok else
    nbind (nask (IoGit (hw_home hw) ["init", "--bare", "--quiet", dir])) (fun initialized =>
      if fst initialized then nask (IoGit dir ["symbolic-ref", "HEAD", branch]) else NDone initialized)) (fun init =>
  if negb (fst init) then NDone init else
  nbind (if nio_eq previous "" then NDone (ans_data true [zero]) else
    nask (IoGit dir ["rev-parse", "--verify", append "refs/pantheon/entries/" previous])) (fun parent =>
  if negb (fst parent) then NDone parent else
  let old := trim (ans_one parent) in
  nbind (nask (IoGit dir ["mktree"])) (fun tree =>
  nbind (nask (IoGitEnv dir entry leader_git_env
    (["commit-tree", trim (ans_one tree)] ++ (if nio_eq old zero then [] else ["-p", old])))) (fun made =>
  if negb (fst made) then NDone made else
  let commit := trim (ans_one made) in
  nbind (nask (IoGit dir ["rev-parse", "--verify", "--quiet", record])) (fun existing =>
  nbind (if fst existing then NDone (ans_flag (nio_eq (trim (ans_one existing)) commit))
         else nask (IoGit dir ["update-ref", record, commit, zero])) (fun indexed =>
  if negb (fst indexed) then NDone indexed else
  nbind (nask (IoGit dir ["rev-parse", "--verify", "--quiet", branch])) (fun tip =>
  if (negb (fst tip) && nio_eq old zero) || nio_eq (trim (ans_one tip)) old
  then nask (IoGit dir ["update-ref", branch, commit, old])
  else if fst tip then nask (IoGit dir ["merge-base", "--is-ancestor", commit, trim (ans_one tip)])
  else NDone (ans_flag false))))))))).

(** decimal text added, digit by digit (a node's numbers stay text: a
    unikernel's naturals may count one by one) *)
hdigit (l : list Ascii.ascii) : nat := match l with c :: _ => Ascii.nat_of_ascii c - 48 | [] => 0 end.

Fixpoint hadd_rev (fuel : nat) (a b : list Ascii.ascii) (carry : nat) : list Ascii.ascii :=
  match fuel with
  | 0 => []
  | S f =>
      match a, b with
      | [], [] => if Nat.eqb carry 0 then [] else [Ascii.ascii_of_nat (48 + carry)]
      | _, _ =>
          let d := hdigit a + hdigit b + carry in
          Ascii.ascii_of_nat (48 + Nat.modulo d 10) :: hadd_rev f (List.tl a) (List.tl b) (Nat.div d 10)
      end
  end.

hdec_add (a b : string) : string :=
  of_chars (rev_onto (hadd_rev (S (slen a + slen b)) (rev_onto (chars a) []) (rev_onto (chars b) []) 0) []).

(** git's output, trimmed, as OCaml's String.trim trims it *)
hgit_out (dir : string) (args : list string) : nprog string :=
  nbind (nask (IoGit dir args)) (fun a => NDone (trim (ans_one a))).

hok (a : nanswer) : string := if fst a then "true" else "false".

(** each checkout's short head ([repo, head, ...]); a checkout git can't
    read (none to read, as in a unikernel with no service) is at its
    genesis commit *)
Fixpoint hheads (hw : hworld) (repos : list (string * string)) : nprog (list string) :=
  match repos with
  | [] => NDone []
  | (r, genesis) :: rest =>
      nbind (nask (IoGit (hrepo_dir hw r) ["rev-parse", "--short", "HEAD"])) (fun a =>
      nbind (hheads hw rest) (fun others =>
      NDone (r :: (if fst a then trim (ans_one a) else genesis) :: others)))
  end.

(** a merge's commit: its message on standard input, no hooks, kept as
    written *)
merge_commit_args : list string := ["commit", "-q", "--allow-empty", "--no-verify", "--cleanup=verbatim", "-F", "-"].

(** the environment entries a merge's commit sets: a fixed author and
    committer, and the date *)
merge_who_names : list string :=
  ["GIT_AUTHOR_NAME=", "GIT_AUTHOR_EMAIL=", "GIT_COMMITTER_NAME=", "GIT_COMMITTER_EMAIL=", "GIT_AUTHOR_DATE=",
   "GIT_COMMITTER_DATE="].

(** a merge's author and committer, at [date] *)
merge_who (date : string) : list string :=
  ["GIT_AUTHOR_NAME=Pantheon", "GIT_AUTHOR_EMAIL=pantheon@localhost", "GIT_COMMITTER_NAME=Pantheon",
   "GIT_COMMITTER_EMAIL=pantheon@localhost", append "GIT_AUTHOR_DATE=" date, append "GIT_COMMITTER_DATE=" date].

(** A decided merge's commit, the same on every node: a fixed author and a
    date from the version, the message on git's standard input (the spec
    in it is the leader's text, which an argument can't carry whole:
    docs/SECURITY-REVIEW-2.md P-17). Its tree and short id, or none when
    git commit failed; runtime/node.soma's perform_merge decides the rest. *)
hmerge_commit (dir version tree bid task bidder spec : string) : nprog nanswer :=
  let date := hcat ["@", hdec_add "1700000000" version, " +0000"] in
  let msg := hcat ["Merge bid ", bid, " for task ", task, " by ", bidder, hnl, hnl, spec, hnl, hnl,
                   "Pantheon-Version: ", nio_count (num version), hnl, "Pantheon-Bid: ", bid, hnl,
                   "Pantheon-Tree: ", tree, hnl] in
  nbind (nask (IoGit dir ["add", "-A", "-f"])) (fun _ =>
  nbind (nask (IoGitEnv dir msg (merge_who date) merge_commit_args)) (fun c =>
  if negb (fst c) then NDone (ans_data false []) else
  nbind (hgit_out dir ["rev-parse", "HEAD^{tree}"]) (fun t =>
  nbind (hgit_out dir ["rev-parse", "--short", "HEAD"]) (fun short =>
  NDone (ans_data true [t, short]))))).

(** a cmd: patch's fresh checkout of [dir]'s head, its git directory
    outside the worktree: [worktree, git directory, whether it worked] *)
htool_checkout (dir : string) : nprog nanswer :=
  nbind (nask (IoTempDir "pantheon-work")) (fun t =>
  let wt := ans_one t in
  let gd := append wt ".git" in
  nbind (hgit_out dir ["rev-parse", "HEAD"]) (fun commit =>
  nbind (nask (IoGit "." ["clone", "--quiet", "--shared", "--no-checkout", append "--separate-git-dir=" gd, dir, wt])) (fun cl =>
  nbind (if fst cl then nask (IoGit wt ["checkout", "-q", "--detach", commit]) else NDone (ans_flag false)) (fun co =>
  NDone (ans_data true [wt, gd, hok co]))))).

hkeep (s : host_state) (a : nanswer) : nprog (nanswer * host_state) := NDone (a, s).

hpass (s : host_state) (op : node_op) : nprog (nanswer * host_state) := nbind (nask op) (fun a => NDone (a, s)).


(** ---- Jobs ----
    A job is a process the host runs for the node: a model call, a check,
    a CI run. The runner starts it ([IoProcStart], from a fresh scratch
    directory), gives its output and its end as events ([job_bytes],
    [job_ended]) and stops it ([IoProcKill]); the rest is here. *)

done_event (d : job_done) (t : string) : list string :=
  match d with
  | DoneModel id kind prompt ctx => "llm_output" :: id :: kind :: prompt :: t :: ctx
  | DoneCodex id kind prompt out ctx => "codex_file" :: id :: kind :: prompt :: t :: out :: ctx
  | DoneCheck id out ci evidence => "check_apply_out" :: id :: out :: ci :: t :: evidence
  | DoneCi id tree memory runner evidence => "ci_done" :: id :: tree :: memory :: runner :: t :: evidence
  | DoneCleanup path => ["cleanup_done", path, t]
  end.

done_ci (d : job_done) : bool := match d with DoneCi _ _ _ _ _ => true | _ => false end.

(** Cleanup stays asynchronous for large trees, but it is a real tracked
    process: its completion/failure is observed like every other host job.
    Cleanup jobs own no scratch directory, so cleaning one never recursively
    creates another cleanup job. The startup receipt reports failures too. *)
hcleanup_targets (s : host_state) (targets : list string) : nprog (nanswer * host_state) :=
  let label := Stdlib.Strings.String.concat " + " targets in
  nbind (nask IoEnvEntries) (fun env =>
  nbind (nask (IoProcStart "rm" "" "" (ans_list env) (["-rf", "--"] ++ targets))) (fun a =>
  if negb (fst a) then
    nbind (nexec (IoLog (hcat ["cleanup could not start: ", label, ": ", ans_one a])))
      (fun _ => NDone (a, s))
  else nbind (nask IoClock) (fun now =>
    let j := {| j_id := ans_one a; j_started := ans_float now; j_limit := nio_small 3600;
                j_done := DoneCleanup label; j_clean := []; j_overtime := false; j_flooded := false |} in
    NDone (ans_data true ["cleanup scheduled", ans_one a], {| s with hs_jobs := j :: hs_jobs s |})))) .

hcleanup_tree (s : host_state) (p : string) : nprog (nanswer * host_state) :=
  hcleanup_targets s [p].

(** The tool explicitly requests [git, worktree]. One asynchronous job owns
    both exact operands, so a single service capability is not raced by aliases. *)
Fixpoint hcleanup (s : host_state) (l : list job_clean) : nprog host_state :=
  match l with
  | [] => NDone s
  | CleanTree p :: rest =>
      match rest with
      | CleanTree root :: more =>
          if seq p (append root ".git") then
            nbind (hcleanup_targets s [p, root]) (fun r => hcleanup (snd r) more)
          else nbind (hcleanup_tree s p) (fun r => hcleanup (snd r) rest)
      | _ => nbind (hcleanup_tree s p) (fun r => hcleanup (snd r) rest)
      end
  | CleanContainer name :: rest =>
      nbind (nask (IoRun "docker" ["rm", "-f", name])) (fun removed =>
      if fst removed then hcleanup s rest else
      (* --rm may already have removed a completed container. Only a
         successful daemon query with no exact-name match proves absence;
         a daemon/socket error is never mistaken for an absent container. *)
      nbind (nask (IoRun "docker" ["ps", "-a", "-q", "--filter", hcat ["name=^/", name, "$"]])) (fun found =>
      if fst found && seq (trim (ans_one found)) "" then hcleanup s rest else
      nbind (nexec (IoLog (hcat ["CI infrastructure blocked: container teardown failed: ", name])))
        (fun _ => hcleanup {| s with hs_ci_blocked := true |} rest)))
  | CleanFile p :: rest =>
      nbind (nask (IoDiscardFile p)) (fun _ => hcleanup s rest)
  end.

hpush (s : host_state) (ev : list string) : host_state := {| s with hs_events := hs_events s ++ [ev] |}.

hpush_opt (s : host_state) (ev : option (list string)) : host_state :=
  match ev with Some e => hpush s e | None => s end.

(** the events queued, taken: an answer's data, framed *)
hdrain (s : host_state) : nanswer * host_state :=
  (ans_data true (nio_frame_lists (hs_events s)), {| s with hs_events := [] |}).

(** A job started: a fresh scratch directory to run from, the process
    (reading [stdin], with [env] its environment), and the job kept. One
    that can't start ends at once: its end's event ("!" and why) comes
    back, and what would have gone with it goes now. *)
hstart_job (s : host_state) (limit : PrimFloat.float) (prog stdin : string) (args env : list string)
    (d : job_done) (clean : list job_clean) : nprog (host_state * option (list string)) :=
  nbind (nask (IoTempDir "pantheon-llm")) (fun t =>
  if negb (fst t) then
    nbind (hcleanup s clean) (fun s =>
    NDone (s, Some (done_event d (append "!could not allocate job directory: " (ans_one t)))))
  else let cwd := ans_one t in
  nbind (nask (IoProcStart prog stdin cwd env args)) (fun a =>
  if fst a then
    nbind (nask IoClock) (fun c =>
    let j := {| j_id := ans_one a; j_started := ans_float c; j_limit := limit; j_done := d;
                j_clean := CleanTree cwd :: clean; j_overtime := false; j_flooded := false |} in
    NDone ({| s with hs_jobs := j :: hs_jobs s |}, None))
  else
    nbind (hcleanup s (CleanTree cwd :: clean)) (fun s =>
    NDone (s, Some (done_event d (append "!" (ans_one a))))))).

(** A CI run's script: its output and errors together, and its exit as the
    node reads it. Exits other than 0, 124 and 137 (the run's time and
    memory budgets, also the bid's) are 86, the bid's failure; any other
    failing exit of the runner (docker's own 125-127, ci-sandbox's 2 and 3)
    is the runner's, so this node's (runtime/node.soma's ci_outcome). A build
    the kernel killed for the container's memory (oom_kill in its cgroup)
    ends as 137, as docker ends the container itself
    (docs/SECURITY-REVIEW-2.md P-6). "( " with a space: where sh is bash
    (Fedora), "((" starts arithmetic. *)
ci_wrap (ci : string) : string :=
  hcat ["( ", ci, hnl, ") 2>&1; r=$?; if [ $r -ne 0 ] && grep -qs 'oom_kill [1-9]' /sys/fs/cgroup/memory.events; then exit 137; fi; ",
        "case $r in 0|124|137) exit $r;; esac; exit 86"].

(** CI's container: no network, a read-only root, a memory and process cap
    and nobody's uid, the tree read-only at /work, [script] run by sh *)
ci_docker_args (name mem out image script : string) : list string :=
  ["run", "--rm", "--name", name, "--network=none", "--read-only", "--tmpfs", append "/tmp:exec,size=" mem,
   "--cap-drop=ALL", "--security-opt=no-new-privileges", "--pids-limit=512", append "--memory=" mem,
   append "--memory-swap=" mem, "--user=65534:65534", "-e", "HOME=/tmp", "-v", append out ":/work:ro",
   "-w", "/work", image, "sh", "-c", script].

(** A CI run started on a tree Soma already accepted: in the sandbox
    runner, or in a container with no network, a read-only root, a memory
    and process cap and nobody's uid, the tree read-only at /work. An hour
    at most. What its outcome is (passed, the bid's failure or this node's
    problem) is runtime/node.soma's ci_outcome, from the node's own signals. *)
hci_start (hw : hworld) (env : list string) (s : host_state) (w : list string) : nprog (host_state * option (list string)) :=
  match w with
  | id :: out :: tree :: ci :: name :: evidence =>
      if hs_ci_blocked s then
        nbind (hcleanup s [CleanTree out]) (fun s =>
        NDone (s, Some (done_event (DoneCi id tree (hw_ci_memory hw) "infrastructure" evidence)
          "!CI infrastructure blocked by failed container teardown; repair this node before running more CI")))
      else let mem := hw_ci_memory hw in
      let evidence := evidence ++ ["context", leader_json_object [("command", ci),
        ("memory", mem), ("image", hw_ci_image hw), ("runner", hw_ci_sandbox hw)]] in
      if negb (nio_eq (hw_ci_sandbox hw) "") then
        hstart_job s (nio_small 3600) (hw_ci_sandbox hw) "" [mem, out, ci_wrap ci] env
          (DoneCi id tree mem "sandbox" evidence) [CleanTree out]
      else
        hstart_job s (nio_small 3600) "docker" "" (ci_docker_args name mem out (hw_ci_image hw) (ci_wrap ci)) env
          (DoneCi id tree mem "docker" evidence) [CleanContainer name, CleanTree out]
  | _ => NDone (s, None)
  end.

(** The next CI run waiting, started: one that can't start ends at once
    (its ci_done queued) and the one after it goes. With none waiting, CI
    is free. *)
Fixpoint hci_next (fuel : nat) (hw : hworld) (env : list string) (s : host_state) : nprog host_state :=
  match fuel with
  | 0 => NDone {| s with hs_ci_busy := false |}
  | S f =>
      match hs_ci_waiting s with
      | [] => NDone {| s with hs_ci_busy := false |}
      | w :: rest =>
          nbind (hci_start hw env {| s with hs_ci_waiting := rest |} w) (fun r =>
          match snd r with
          | None => NDone (fst r)
          | Some ev => hci_next f hw env (hpush (fst r) ev)
          end)
      end
  end.

hci_after (hw : hworld) (env : list string) (s : host_state) : nprog host_state :=
  hci_next (S (List.length (hs_ci_waiting s))) hw env s.

(** One CI run at a time on this node, the rest waiting their turn: two at
    once (a leader's merge check beside an attest) can take more memory
    than the machine has, and a build killed for memory reads as the bid's
    fault. *)
hci_launch (hw : hworld) (env : list string) (s : host_state) (w : list string) : nprog host_state :=
  if hs_ci_blocked s then nbind (hci_start hw env s w) (fun r => NDone (hpush_opt (fst r) (snd r)))
  else if hs_ci_busy s then NDone {| s with hs_ci_waiting := hs_ci_waiting s ++ [w] |}
  else
    nbind (hci_start hw env {| s with hs_ci_busy := true |} w) (fun r =>
    match snd r with
    | None => NDone (fst r)
    | Some ev => hci_after hw env (hpush (fst r) ev)
    end).

(** A check for an attestor: the node's own binary applies the bid's
    edits on the head in a fresh clone (app/cli.soma's [pantheon check]); its
    output, a tree or why not, becomes runtime/node.soma's check_apply_out. The
    tree goes on to the repository's CI, if it has one, which removes it
    after; without CI it goes with the job. *)
hcheck_fresh (hw : hworld) (s : host_state) (id repo head key : string) (edits : list string) : nprog (nanswer * host_state) :=
  let ci := match List.find (fun p => nio_eq (fst p) repo) (hw_ci_repo hw) with Some p => snd p | None => hw_ci hw end in
  nbind (nask (IoTempDir "pantheon-check")) (fun o =>
  if negb (fst o) then hkeep (hpush s (done_event (DoneCheck id "" ci ["check_key", key])
      (append "!could not allocate check directory: " (ans_one o)))) ans_ok else
  let out := ans_one o in
  nbind (nask (IoTempFile "pantheon-edits" ".json" (nio_json_strings edits))) (fun e =>
  if negb (fst e) then nbind (hcleanup s [CleanTree out]) (fun s =>
    hkeep (hpush s (done_event (DoneCheck id out ci ["check_key", key])
      (append "!could not allocate edits file: " (ans_one e)))) ans_ok) else
  let ef := ans_one e in
  nbind (nask IoSelfExe) (fun self =>
  nbind (nask IoEnvEntries) (fun env =>
  nbind (hstart_job s (nio_small 600) (ans_one self) "" ["check", hrepo_dir hw repo, head, ef, out, "--record"] (ans_list env)
           (DoneCheck id out ci ["check_key", key]) (CleanFile ef :: (if nio_eq ci "" then [CleanTree out] else []))) (fun r =>
  hkeep (hpush_opt (fst r) (snd r)) ans_ok))))).

hcheck (hw : hworld) (s : host_state) (id repo head : string) (edits : list string) : nprog (nanswer * host_state) :=
  let ci := match List.find (fun p => nio_eq (fst p) repo) (hw_ci_repo hw) with Some p => snd p | None => hw_ci hw end in
  nbind (if nio_eq ci "" then NDone (ans_flag false) else
    if nio_eq (hw_ci_sandbox hw) "" then
      nask (IoRun "docker" ["image", "inspect", "--format={{.Id}}", hw_ci_image hw])
    else nask (IoReadText (hw_ci_sandbox hw))) (fun runner =>
  let key := if fst runner then hash_list
    (["pantheon-local-check-v1", repo, head, ci, hw_ci_memory hw, hw_ci_image hw,
      hw_ci_sandbox hw, sha256 (ans_one runner)] ++ edits) else "" in
  let fresh := hcheck_fresh hw s id repo head key edits in
  match lookup key (hs_verified s) with
  | None => fresh
  | Some evidence =>
    let get k := get_or "" k (pairs evidence) in
    nbind (nask (IoGit (hrepo_dir hw repo) ["rev-parse", "HEAD^{tree}"])) (fun base =>
    nbind (nask (IoGit (hrepo_dir hw repo) ["rev-parse", append (get "commit") "^{tree}"])) (fun tree =>
    if fst base && fst tree && nio_eq (trim (ans_one base)) head && nio_eq (trim (ans_one tree)) (get "tree")
    then nbind (nask (IoLog (append "reusing this node's verified check for request " id))) (fun _ =>
      hkeep (hpush s (["check_result", id] ++ evidence ++ ["reused", "true"])) ans_ok)
    else fresh))
  end).

(** CI for a tree: its checkout's .git goes first (a --shared clone's
    objects live in this node's own repository, which isn't in CI's
    sandbox, so git there saw a broken repository and its errors led a
    rejection's reason), and everyone may read the rest; then its turn.
    The events queued so far come back. *)
hci (hw : hworld) (s : host_state) (id out tree ci : string) (evidence : list string) : nprog (nanswer * host_state) :=
  nbind (nask (IoRun "rm" ["-rf", hjoin out ".git"])) (fun _ =>
  nbind (nask (IoRun "chmod" ["-R", "a+rX", out])) (fun _ =>
  nbind (nask (IoRandomHex "8")) (fun tok =>
  nbind (nask IoEnvEntries) (fun env =>
  nbind (hci_launch hw (ans_list env) s ([id, out, tree, ci, append "pantheon-ci-" (substr (ans_one tok) 0 12)] ++ evidence)) (fun s =>
  NDone (hdrain s)))))).

hswap (mark out : string) (args : list string) : list string :=
  List.map (fun a => if nio_eq a mark then out else a) args.

(** A model process for a prompt Soma assembled from [raw] ([launch]:
    the program, its time limit, the backend's mode, then its arguments).
    codex writes its reply to a file (@OUT@); grok's header text, which
    holds the key, goes in a file of its own (@HDR@) that goes with the
    job; a cmd: backend's tool checkout ([clean]) goes with it too. The
    prompt is the process's standard input. Found: it couldn't start, and
    this is its output's event at once. *)
hllm (s : host_state) (id kind raw prompt : string) (ctx clean launch env : list string) : nprog (nanswer * host_state) :=
  let started r := hkeep (fst r) (match snd r with Some ev => ans_data true ev | None => ans_data false [] end) in
  match launch with
  | prog :: lim :: mode :: rest =>
      let limit := float_of_digits lim in
      if nio_eq mode "codex" then
        nbind (nask (IoTempFile "pantheon-codex" ".txt" "")) (fun o =>
        let out := ans_one o in
        nbind (hstart_job s limit prog prompt (hswap "@OUT@" out rest) env (DoneCodex id kind raw out ctx) []) started)
      else match mode, rest with
           | "grok", hdr_text :: args =>
               nbind (nask (IoTempFile "pantheon-h" ".txt" hdr_text)) (fun h =>
               let hdr := ans_one h in
               nbind (hstart_job s limit prog prompt (hswap "@HDR@" (append "@" hdr) args) env (DoneModel id kind raw ctx)
                        [CleanFile hdr]) started)
           | _, _ => nbind (hstart_job s limit prog prompt rest env (DoneModel id kind raw ctx) (List.map CleanTree clean)) started
           end
  | _ => hkeep s (ans_data false [])
  end.

hjob_set (s : host_state) (id : string) (f : hjob -> hjob) : host_state :=
  {| s with hs_jobs := List.map (fun j => if nio_eq (j_id j) id then f j else j) (hs_jobs s) |}.

hfind_job (id : string) (l : list hjob) : option hjob := List.find (fun j => nio_eq (j_id j) id) l.

hwithout (id : string) (l : list hjob) : list hjob := List.filter (fun j => negb (nio_eq (j_id j) id)) l.

(** A job the node stops (for its time limit or its output), marked so its
    end says so, and killed once. *)
hstop (s : host_state) (id : string) (marked : hjob -> bool) (mark : hjob -> hjob) : nprog (nanswer * host_state) :=
  match hfind_job id (hs_jobs s) with
  | Some j => if marked j then hkeep s ans_ok
              else nbind (nask (IoProcKill id)) (fun answer =>
                if fst answer then hkeep (hjob_set s id mark) ans_ok else hkeep s answer)
  | None => hkeep s ans_ok
  end.

(** A finished job resumed with the node's outcome (runtime/node.soma's
    job_result): what its end becomes queued (a CI run's frees CI for the
    next), what went with it removed, and the events queued so far. *)
hcomplete (hw : hworld) (s : host_state) (id result : string) : nprog (nanswer * host_state) :=
  match hfind_job id (hs_ended s) with
  | None => hkeep s (ans_data true [])
  | Some j =>
      let s := {| s with hs_ended := hwithout id (hs_ended s) |} in
      match j_done j with
      | DoneCleanup p =>
          nbind (nexec (IoLog (hcat [if starts "!" result then "cleanup failed: " else "cleanup complete: ", p,
                                    if seq result "" then "" else append ": " result])))
            (fun _ => NDone (hdrain s))
      | _ =>
          let s := hpush s (done_event (j_done j) result) in
          (* Stop/remove a completed run's container before starting the next
             CI job; its resource slot cannot be reused before teardown. *)
          nbind (hcleanup s (j_clean j)) (fun s =>
          nbind (if done_ci (j_done j) then nbind (nask IoEnvEntries) (fun env => hci_after hw (ans_list env) s) else NDone s)
            (fun s => NDone (hdrain s)))
      end
  end.

(** What the runner saw of the jobs, as the node's events: their output as
    it is, and a job's end ([job_ended]: how it ended, the runner's facts)
    as runtime/node.soma's [job_finished], with the time limit it was stopped for
    ("%.0f", "" if none) and whether it printed too much; the job waits
    for its outcome. The events queued since the last look come first. *)
hevent (s : host_state) (ev : list string) : host_state * list string :=
  match ev with
  | ["job_ended", id, tag, value] =>
      match hfind_job id (hs_jobs s) with
      | Some j =>
          ({| s with hs_jobs := hwithout id (hs_jobs s); hs_ended := hs_ended s ++ [j] |},
           ["job_finished", id, tag, value, if j_overtime j then float_text (j_limit j) else "",
            if j_flooded j then "1" else "0"])
      | None => (s, ["job_finished", id, tag, value, "", "0"])
      end
  | _ => (s, ev)
  end.

Fixpoint hevents_go (s : host_state) (evs acc : list (list string)) : host_state * list (list string) :=
  match evs with
  | [] => (s, rev_onto acc [])
  | ev :: rest => let r := hevent s ev in hevents_go (fst r) rest (snd r :: acc)
  end.

host_events (s : host_state) (evs : list (list string)) : list (list string) * host_state :=
  let r := hevents_go s evs [] in (hs_events (fst r) ++ snd r, {| (fst r) with hs_events := [] |}).

(** One of the host's operations, as the kernel carries it out (none: not
    one of them). A checkout's work is git and paths in HOME/repos/NAME;
    the model's budget, limit and held requests, and the inbox's poll, are
    what it keeps; model calls, checks and CI are jobs. *)
host_op (hw : hworld) (s : host_state) (op : node_op) : option (nprog (nanswer * host_state)) :=
  match op with
  | IoRepoNames => Some (hkeep s (ans_data true (List.map fst (hw_repos hw))))
  | IoLsFiles r => Some (nbind (hgit_out (hrepo_dir hw r) ["ls-files"]) (fun l => hkeep s (ans_data true [l])))
  | IoHeadFile r p =>
      Some (nbind (nask (IoGit (hrepo_dir hw r) ["show", append "HEAD:" p])) (fun a =>
            hkeep s (if fst a then ans_data true [ans_one a] else ans_data false [])))
  | IoCheckoutHeads => Some (nbind (hheads hw (hw_repos hw)) (fun l => hkeep s (ans_data true l)))
  | IoMergeReset r =>
      let dir := hrepo_dir hw r in
      Some (nbind (nask (IoGit dir ["reset", "-q", "--hard", "HEAD"])) (fun _ =>
            nbind (nask (IoGit dir ["clean", "-q", "-f", "-d", "-x"])) (fun _ => hkeep s ans_ok)))
  | IoMergeProbe r p => Some (hpass s (IoPathProbe (hrepo_dir hw r) p))
  | IoMergeRead r p => Some (hpass s (IoReadText (hjoin (hrepo_dir hw r) p)))
  | IoMergeWrite r p text => Some (hpass s (IoPathWrite (hrepo_dir hw r) p text))
  | IoMergeRemove r p => Some (hpass s (IoPathRemove (hrepo_dir hw r) p))
  | IoMergeCommit r v tree bid task bidder spec =>
      Some (nbind (hmerge_commit (hrepo_dir hw r) v tree bid task bidder spec) (hkeep s))
  | IoToolCheckout r => Some (nbind (htool_checkout (hrepo_dir hw r)) (hkeep s))
  | IoLlmBudget =>
      let s := {| s with hs_calls := S (hs_calls s) |} in
      Some (hkeep s (ans_data true [nio_count (hs_calls s), hw_max_calls hw]))
  | IoLlmHold id kind prompt ctx => Some (hkeep {| s with hs_held := (id :: kind :: prompt :: ctx) :: hs_held s |} ans_ok)
  | IoLimitSet until reason backoff =>
      Some (hkeep {| s with hs_until := float_of_digits until; hs_reason := reason;
                            hs_backoff := float_of_digits backoff; hs_probing := false |} ans_ok)
  | IoLimitClear backoff => Some (hkeep {| s with hs_backoff := float_of_digits backoff; hs_probing := false |} ans_ok)
  | IoReleaseState => Some (hkeep s (true, (hs_backoff s, [if hs_probing s then "true" else "false"])))
  | IoHeldRequests => Some (hkeep s (ans_data true (nio_frame_lists (hs_held s))))
  | IoHeldStore probing requests =>
      Some (hkeep {| s with hs_held := List.filter (fun r => Nat.leb 3 (List.length r)) requests;
                            hs_probing := nio_eq probing "true" |} ans_ok)
  | IoLimitInfo =>
      Some (hkeep s (true, (hs_until s, [hw_backend hw, nio_count (List.length (hs_held s)), hs_reason s])))
  | IoInboxState => Some (hkeep s (true, (hs_inbox s, [hjoin (hw_home hw) "inbox"])))
  | IoInboxStamp stamp => Some (hkeep {| s with hs_inbox := float_of_digits stamp |} ans_ok)
  | IoLlmStart id kind raw prompt ctx clean launch env => Some (hllm s id kind raw prompt ctx clean launch env)
  | IoCheck id repo head edits => Some (hcheck hw s id repo head edits)
  | IoRememberCheck key evidence => Some (hkeep
      (if nio_eq key "" then s else {| s with hs_verified := firstn 128 (put key evidence (hs_verified s)) |}) ans_ok)
  | IoLeaderRecord previous digest entry => Some (
      nbind (hjournal hw previous digest entry) (fun result =>
      if fst result then hkeep s result else
      nbind (nask (IoFail "leader chain could not append or verify its Git history")) (hkeep s)))
  | IoCiLaunch id out tree ci evidence => Some (hci hw s id out tree ci evidence)
  | IoRemoveTree p => Some (hcleanup_tree s p)
  | IoJobComplete id result => Some (hcomplete hw s id result)
  | IoJobs =>
      Some (hkeep s (ans_data true (nio_frame_lists (List.map (fun j =>
              [j_id j, float_wire (j_started j), float_wire (j_limit j), if j_overtime j then "true" else "false"]) (hs_jobs s)))))
  | IoJobExpire id => Some (hstop s id j_overtime (fun j => {| j with j_overtime := true |}))
  | IoJobFlood id => Some (hstop s id j_flooded (fun j => {| j with j_flooded := true |}))
  | _ => None
  end.

(** the host's world from the node's setup (app/cli.soma's node_setup: the
    settings, CI commands by repository at index 4, the repositories at
    index 6, [name, genesis commit, ...]) *)
hworld_of (config : list (list string)) : hworld :=
  let settings := match config with s :: _ => s | [] => [] end in
  let setting i := List.nth i settings "" in
  let part i := nio_pairs (List.nth i config []) in
  {| hw_home := setting 0; hw_backend := setting 5; hw_repos := part 6; hw_max_calls := setting 11;
     hw_ci := setting 7; hw_ci_repo := part 4; hw_ci_memory := setting 8; hw_ci_image := setting 9;
     hw_ci_sandbox := setting 10 |}.
