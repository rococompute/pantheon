(** What runtime/node.soma's pure effect order does, checked without running a node:
    no sockets, no timers, only [order_effects] on made-up steps. A snapshot
    effect appears only when consensus changed (as [empty_node]'s has not),
    decided outputs come before it, and the rest come after. *)

Example model_env_drops_only_the_nodes_own_settings :
  model_env_entries ["PANTHEON_X=1", "HOME=/h", "PANTHEON_", "PANTHEON=1", "APANTHEON_X=2", "PATH=/bin"] =
    ["HOME=/h", "PANTHEON_", "PANTHEON=1", "APANTHEON_X=2", "PATH=/bin"] /\
  model_env_entries [] = [].
Proof. repeat split; computed. Qed.

Example backend_launches_are_fixed_data :
  backend_launch "claude" = ["claude", "600", "prompt", "-p", "--tools", "", "--strict-mcp-config", "--no-session-persistence", "--setting-sources", "", "--output-format", "text"] /\
  hd "" (tl (tl (backend_launch "codex"))) = "codex" /\ backend_launch "cmd:my-model" = ["my-model", "", "cmd"] /\
  backend_launch "cmd:" = [] /\ backend_launch "Claude" = [] /\ backend_launch "" = [] /\
  backend_launch "scripted" = [] /\ backend_launch "grok" = ["curl", "600", "grok", "-s", "-m", "600", "-H", "@HDR@", "-d", "@-", "https://api.x.ai/v1/chat/completions"].
Proof. repeat split; computed. Qed.

Example feed_chunks_splits_lines_and_keeps_the_partial :
  feed_chunks [] "one
tw" = (["one"], ["tw"]) /\
  feed_chunks ["tw"] "o
three
" = (["two", "three"], []) /\
  feed_chunks [] "a
b
c
" = (["a", "b", "c"], []) /\
  feed_chunks [] "" = ([], [""]) /\
  feed_chunks ["ab"] "cd" = ([], ["ab", "cd"]) /\
  feed_chunks [] "
" = ([""], []) /\
  feed_chunks [] "no newline at all" = ([], ["no newline at all"]) /\
  chunks_len ["ab", "cde"] = 5 /\ chunks_len [] = 0.
Proof. repeat split; computed. Qed.

Example peer_buffers_live_in_node_state :
  peer_buffer empty_node "7" = [] /\
  pbufs (peer_remember empty_node "7" ["tw"]) = [("7", ["tw"])] /\
  peer_buffer (peer_remember (peer_remember empty_node "7" ["tw"]) "8" ["x"]) "7" = ["tw"] /\
  peer_buffer (peer_remember (peer_remember empty_node "7" ["tw"]) "7" ["three"]) "7" = ["three"] /\
  pbufs (peer_remember (peer_remember empty_node "7" ["tw"]) "7" []) = [] /\
  peer_buffer (peer_forget (peer_remember empty_node "7" ["tw"]) "7") "7" = [] /\
  pbufs (peer_forget (peer_remember (peer_remember empty_node "7" ["tw"]) "8" ["x"]) "8") =
    [("7", ["tw"])].
Proof. repeat split; computed. Qed.

Example connection_admission_and_line_cap_edges :
  admit_decision_of 15 63 = AdmitNew /\ admit_decision_of 16 0 = AdmitRefuse /\
  admit_decision_of 0 64 = AdmitEvict /\ admit_decision_of 16 64 = AdmitRefuse /\
  admit_decision_of 15 64 = AdmitEvict /\ admit_decision_of 0 0 = AdmitNew /\
  oldest_conn [] = "" /\ oldest_conn [("a", 5%float)] = "a" /\
  oldest_conn [("a", 5%float), ("b", 3%float), ("c", 3%float)] = "b" /\
  oldest_conn [("a", 1%float), ("b", 2%float)] = "a" /\
  buffer_over 10 10 = false /\ buffer_over 11 10 = true /\ buffer_over 0 0 = false.
Proof. repeat split; computed. Qed.

(** A job's output bytes. Two reads join to the same text as one read while
    the first stays under the cap, including once the cap trims the tail.
    Newlines stay bytes: several lines, an empty line and a trailing partial
    are kept. A malformed chunk is kept and is not an event. The cap is
    strict, the same test as [buffer_over]. *)
Example job_feed_chunks_lines_and_cap :
  job_feed [] "hel" 8 4 = (["hel"], false) /\
  job_feed ["hel"] "lo
x" 8 4 = (["hel", "lo
x"], false) /\
  chunks_join (fst (job_feed ["hel"] "lo
x" 8 4)) = "hello
x" /\
  chunks_join (fst (job_feed [] "hello
x" 8 4)) = "hello
x" /\
  job_feed [] "one

two
par" 20 4 = (["one

two
par"], false) /\
  job_feed [] "
" 8 4 = (["
"], false) /\
  job_feed [] "{bad}" 8 4 = (["{bad}"], false) /\
  job_feed ["abcdef"] "gh" 8 4 = (["abcdef", "gh"], false) /\
  job_feed ["abcdef"] "ghi" 8 4 = (["fghi"], true) /\
  job_feed ["abcdef"] "ghij" 8 4 = (["ghij"], true) /\
  job_feed [] "abcdefghij" 8 4 = (["ghij"], true) /\
  job_feed ["ghij"] "xy" 8 4 = (["ghij", "xy"], false) /\
  job_feed ["ghij"] "xyzABC" 8 4 = (["zABC"], true) /\
  job_feed ["ab"] "" 8 4 = (["ab", ""], false) /\
  seq job_keep_text "65536" = true.
Proof. repeat split; computed. Qed.

Theorem job_feed_under_cap_appends : forall chunks chunk limit keep,
  (chunks_len chunks + slen chunk <=? limit) = true ->
  job_feed chunks chunk limit keep = (chunks ++ [chunk], false).
Proof.
  intros chunks chunk limit keep H.
  unfold job_feed.
  destruct (limit <? chunks_len chunks + slen chunk) eqn:E.
  - apply Nat.ltb_lt in E. apply Nat.leb_le in H. lia.
  - reflexivity.
Qed.

Theorem job_feed_over_is_buffer_over : forall chunks chunk limit keep,
  snd (job_feed chunks chunk limit keep) = buffer_over (chunks_len chunks + slen chunk) limit.
Proof.
  intros chunks chunk limit keep.
  unfold job_feed, buffer_over.
  destruct (limit <? chunks_len chunks + slen chunk); reflexivity.
Qed.

Theorem job_feed_over_keeps_the_tail : forall chunks chunk limit keep,
  buffer_over (chunks_len chunks + slen chunk) limit = true ->
  fst (job_feed chunks chunk limit keep) =
    let joined := chunks_join (chunks ++ [chunk]) in
    let n := slen joined in
    [if n <=? keep then joined else substr joined (n - keep) keep].
Proof.
  intros chunks chunk limit keep H.
  unfold job_feed, buffer_over in *.
  destruct (limit <? chunks_len chunks + slen chunk).
  - reflexivity.
  - discriminate.
Qed.

Theorem job_feed_under_split_same_bytes : forall a b limit keep,
  (slen a + slen b <=? limit) = true ->
  chunks_join (fst (job_feed (fst (job_feed [] a limit keep)) b limit keep))
  = chunks_join [a, b].
Proof.
  intros a b limit keep H.
  assert (Ha : (slen a <=? limit) = true).
  { apply Nat.leb_le. apply Nat.leb_le in H. lia. }
  assert (E1 : job_feed [] a limit keep = ([a], false)).
  { apply job_feed_under_cap_appends. cbn. exact Ha. }
  rewrite E1. cbn.
  assert (E2 : job_feed [a] b limit keep = ([a, b], false)).
  { apply job_feed_under_cap_appends. cbn. rewrite Nat.add_0_r. exact H. }
  rewrite E2. cbn. reflexivity.
Qed.

Example decided_snapshot_rest :
  order_effects ["msg", "peer", "x"] empty_node (with_cons empty_node (new_consensus "me" ["me"] 2))
    [["broadcast", "vote"], ["decided", "1", "tx"], ["status", "s"]]
  = [["perform", "decided", "1", "tx"], ["save_snapshot"], ["perform", "broadcast", "vote"], ["perform", "status", "s"]].
Proof. computed. Qed.

Example refused_tx_is_remembered :
  order_effects ["tx", "raw"] empty_node empty_node []
  = [["refuse", "raw"]]
  /\ order_effects ["tx", "raw"] empty_node (with_pool empty_node ["raw"]) []
  = [].
Proof. repeat split; computed. Qed.

Example empty_step_has_no_effects :
  order_effects ["timeout", "commit", "1", "0"] empty_node empty_node [] = [].
Proof. computed. Qed.

Example only_some_kinds :
  order_effects ["msg", "peer"] empty_node empty_node [["status", "s"], ["log", "hi"]]
  = [["perform", "status", "s"], ["perform", "log", "hi"]]
  /\ order_effects ["msg", "peer"] empty_node (with_cons empty_node (new_consensus "me" ["me"] 2)) [["broadcast", "vote"]]
  = [["save_snapshot"], ["perform", "broadcast", "vote"]]
  /\ order_effects ["msg", "peer"] empty_node empty_node [["decided", "3", "tx"]]
  = [["perform", "decided", "3", "tx"]].
Proof. repeat split; computed. Qed.

Example vote_saves_before_it_sends :
  order_effects ["msg", "peer"] empty_node (with_cons empty_node (new_consensus "me" ["me"] 2)) [["broadcast", "prevote", "1"]]
  = [["save_snapshot"], ["perform", "broadcast", "prevote", "1"]].
Proof. computed. Qed.

(** A vote is signed before the snapshot that says it was cast, and sent
    after it; a block ([done]) is no vote. *)
Example vote_signs_saves_then_sends :
  order_effects ["msg", "peer"] empty_node (with_cons empty_node (new_consensus "me" ["me"] 2))
    [["broadcast", "precommit", "4", "0", "0", "v"], ["broadcast", "done", "3", "0", "0", "h"]]
  = [["sign", "precommit", "4", "0", "0", "v"], ["save_snapshot"],
     ["perform", "broadcast", "precommit", "4", "0", "0", "v"], ["perform", "broadcast", "done", "3", "0", "0", "h"]] /\
  startup_effects [["broadcast", "proposal", "4", "1", "0", "v", "tx"]] =
    [["sign", "proposal", "4", "1", "0", "v", "tx"], ["save_snapshot"], ["perform", "broadcast", "proposal", "4", "1", "0", "v", "tx"]].
Proof. split; computed. Qed.

(** Step 4's output decisions are pure plans for the actual bindings. *)
Example timer_selects_delay_and_timeout_fields :
  plan_output ["timer", "commit", "7", "2", "350"] =
    SetTimer "350" ["timeout", "commit", "7", "2"].
Proof. computed. Qed.

Example log_selects_exact_text :
  plan_output ["log", "line one
line two"] = WriteLog "line one
line two".
Proof. computed. Qed.

Example height_selects_the_new_height :
  plan_output ["height", "12"] = SetHeight "12" /\
  plan_output ["height"] = LegacyOutput ["height"] /\
  plan_output ["height", "1", "2"] = LegacyOutput ["height", "1", "2"].
Proof. repeat split; computed. Qed.

Example decided_selects_height_and_all_transactions :
  plan_output ["decided", "7", "tx one", "tx two"] =
    DecidedBlock "7" ["tx one", "tx two"] /\
  plan_output ["decided", "8"] = DecidedBlock "8" [].
Proof. split; computed. Qed.

Example malformed_outputs_keep_the_old_fallback :
  plan_output ["timer", "commit", "7", "2"] =
    LegacyOutput ["timer", "commit", "7", "2"] /\
  plan_output ["log", "one", "two"] = LegacyOutput ["log", "one", "two"] /\
  plan_output ["decided"] = LegacyOutput ["decided"] /\
  plan_output ["reveal"] = LegacyOutput ["reveal"].
Proof. repeat split; computed. Qed.

Example reveal_selects_draw_policy :
  plan_output ["reveal", "3", "tip"] = RevealLink "3" "tip".
Proof. computed. Qed.

Example honest_reveal_queues_the_exact_link :
  reveal_plan "" "4" "secret" "2" (draw_link 3 "secret") =
    [QueueAction ["local_tx", "reveal", sha256 (sha256 "secret")]].
Proof. computed. Qed.

Example withhold_odd_draw_only_logs :
  reveal_plan "withhold" "4" "secret" "3" (draw_link 3 "secret") =
    [LogAction "FAULT INJECTION: holding back my link for draw 3"] /\
  reveal_plan "withhold" "4" "secret" "5" (draw_link 3 "secret") =
    [LogAction "FAULT INJECTION: holding back my link for draw 5"].
Proof. split; computed. Qed.

Example withhold_even_draw_reveals :
  reveal_plan "withhold" "4" "secret" "2" (draw_link 3 "secret") =
    [QueueAction ["local_tx", "reveal", sha256 (sha256 "secret")]].
Proof. computed. Qed.

Example withhold_once_misses_only_the_first_draw :
  reveal_plan "withhold-once" "4" "secret" "1" (draw_link 4 "secret") =
    [LogAction "FAULT INJECTION: holding back my link for draw 1"] /\
  reveal_plan "withhold-once" "4" "secret" "2" (draw_link 4 "secret") =
    [QueueAction ["local_tx", "reveal", draw_link 3 "secret"]] /\
  reveal_plan "withhold-once" "4" "secret" "3" (draw_link 3 "secret") =
    [QueueAction ["local_tx", "reveal", draw_link 2 "secret"]].
Proof. repeat split; computed. Qed.

Example exhausted_chain_queues_nothing :
  reveal_plan "" "4" "secret" "4" "secret" = [] /\
  reveal_plan "" "4" "secret" "5" "secret" = [] /\
  draw_link 0 "secret" = "secret".
Proof. repeat split; computed. Qed.

(** The runtime selects a preimage of the agreed tip, never one chosen by
    a term index. This is also the market's acceptance condition. *)
Theorem draw_preimage_is_next_link : forall fuel candidate tip link,
  draw_preimage fuel candidate tip = Some link -> sha256 link = tip.
Proof.
  induction fuel as [|fuel IH]; intros candidate tip link H; simpl in H; [discriminate H|].
  destruct (seq (sha256 candidate) tip) eqn:E.
  - injection H as <-. unfold seq in E. apply Stdlib.Strings.String.eqb_eq in E. exact E.
  - exact (IH _ _ _ H).
Qed.

Example missing_draws_do_not_skip_the_outstanding_link :
  reveal_plan "" "4" "secret" "1" (draw_link 4 "secret") =
    reveal_plan "" "4" "secret" "3" (draw_link 4 "secret") /\
  reveal_plan "" "4" "secret" "100" (draw_link 3 "secret") =
    [QueueAction ["local_tx", "reveal", draw_link 2 "secret"]].
Proof. split; computed. Qed.

Example new_decision_requests_one_store :
  decided_plan "7" ["tx"] None = [StoreAction "7" ["tx"]] /\
  decided_plan "8" [] None = [StoreAction "8" []].
Proof. split; computed. Qed.

Example repeated_decision_requests_no_store :
  decided_plan "7" ["tx"] (Some ["tx"]) = [] /\
  decided_plan "7" ["different"] (Some []) = [].
Proof. split; computed. Qed.

Example startup_saves_before_votes_even_without_a_changed_snapshot :
  startup_effects [["broadcast", "vote"], ["decided", "7", "tx"], ["timer", "commit", "8", "0", "0"]] =
    [["perform", "decided", "7", "tx"], ["save_snapshot"],
     ["perform", "broadcast", "vote"], ["perform", "timer", "commit", "8", "0", "0"]] /\
  startup_effects [] = [["save_snapshot"]].
Proof. split; computed. Qed.

(** Catch-up decisions name the actual table writes, reads, and sends. *)
Example behind_selects_catchup_and_malformed_arity_is_unchanged :
  plan_output ["behind", "peer", "3"] = CatchupPeer "peer" "3" /\
  plan_output ["behind", "peer"] = LegacyOutput ["behind", "peer"] /\
  plan_output ["behind", "peer", "3", "extra"] = LegacyOutput ["behind", "peer", "3", "extra"].
Proof. repeat split; computed. Qed.

Example catchup_remembers_before_reading_each_block :
  catchup_plan "peer" "3" "6" 10%float None true false =
    [RememberPeer "peer" "3" 10%float, ReadPeerBlock "peer" 3,
     ReadPeerBlock "peer" 4, ReadPeerBlock "peer" 5].
Proof. computed. Qed.

Example catchup_duplicate_requests_no_bindings :
  catchup_plan "peer" "3" "6" 10%float (Some 9%float) true false = [].
Proof. computed. Qed.

Example catchup_at_two_seconds_can_send_again :
  catchup_plan "peer" "3" "4" 10%float (Some 8%float) true false =
    [RememberPeer "peer" "3" 10%float, ReadPeerBlock "peer" 3, SendSigned "peer" 3].
Proof. computed. Qed.

Example catchup_backward_clock_still_throttles :
  catchup_plan "peer" "3" "6" 10%float (Some 11%float) true false = [].
Proof. computed. Qed.

Example catchup_silent_or_absent_peer_still_remembers :
  catchup_plan "peer" "3" "6" 10%float None true true =
    [RememberPeer "peer" "3" 10%float] /\
  catchup_plan "peer" "3" "6" 10%float None false false =
    [RememberPeer "peer" "3" 10%float].
Proof. split; computed. Qed.

Example catchup_empty_range_still_remembers :
  catchup_plan "peer" "6" "6" 10%float None true false =
    [RememberPeer "peer" "6" 10%float] /\
  catchup_plan "peer" "7" "6" 10%float None true false =
    [RememberPeer "peer" "7" 10%float].
Proof. split; computed. Qed.

Example catchup_caps_reads_at_fifty_one :
  catchup_plan "peer" "3" "100" 10%float None true false =
    RememberPeer "peer" "3" 10%float :: map (ReadPeerBlock "peer") (List.seq 3 51).
Proof. computed. Qed.

Example catchup_one_behind_also_gets_the_signed_messages :
  catchup_plan "peer" "5" "6" 10%float None true false =
    [RememberPeer "peer" "5" 10%float, ReadPeerBlock "peer" 5, SendSigned "peer" 5] /\
  catchup_plan "peer" "5" "6" 10%float None true true = [RememberPeer "peer" "5" 10%float].
Proof. split; computed. Qed.

Example signed_slots_by_height :
  nio_slot_at "5" "precommit/5/0" = true /\ nio_slot_at "5" "proposal/5/12" = true /\
  nio_slot_at "5" "precommit/50/0" = false /\ nio_slot_at "5" "prevote/15/1" = false /\
  nio_slot_at "5" "5/1" = false /\ nio_slot_at "5" "" = false.
Proof. repeat split; computed. Qed.

Example started_again_sends_its_signed_votes_again :
  resume_plan "" 3 [["prevote", "5", "0", "0", "v"]] =
    [RememberBroadcast "5" "all" ["prevote", "5", "0", "0", "v"] ["prevote", "5", "0", "0", "v"],
     SendEveryone ["prevote", "5", "0", "0", "v"]] /\
  resume_plan "silent" 3 [["prevote", "5", "0", "0", "v"]] = [] /\
  resume_plan "" 3 [] = [].
Proof. repeat split; computed. Qed.

Example catchup_missing_block_requests_no_send :
  catchup_send "peer" 4 None = None.
Proof. computed. Qed.

Example catchup_existing_and_empty_blocks_request_exact_peer_send :
