Proof. repeat split; computed. Qed.

Example status_preserves_line_order_and_final_newline :
  status_output ["height 3", "version 2"] [("calc", "abc"), ("notes", "def")]
    [("calc", "bad tree")] true "codex" "09:05" "2" "quota" =
  Stdlib.Strings.String.concat newline
    ["height 3", "version 2", "checkout calc abc", "checkout notes def",
     "DIVERGED calc at merge bad tree", "LIMIT codex until 09:05, 2 model requests held: quota", ""].
Proof. computed. Qed.

Example status_without_a_limit_omits_all_limit_fields :
  status_output ["pool 0"] [] [] false "ignored" "ignored" "7" "ignored" =
    append "pool 0" newline /\
  status_output [] [] [] false "" "" "" "" = newline.
Proof. split; computed. Qed.

Example status_limit_uses_a_strict_wall_clock_boundary :
  status_limit_active 9%float 10%float = true /\
  status_limit_active 10%float 10%float = false /\
  status_limit_active 11%float 10%float = false.
Proof. repeat split; computed. Qed.

Example submission_log_keeps_empty_and_short_fields :
  submission_message ["bid", "", "multi word"] = "sending bid  multi word" /\
  submission_message [] = "sending ".
Proof. split; computed. Qed.

Example submission_log_truncates_only_past_sixty_bytes :
  submission_message ["012345678901234567890123456789012345678901234567890123456789"] =
    "sending 012345678901234567890123456789012345678901234567890123456789" /\
  submission_message ["012345678901234567890123456789012345678901234567890123456789X"] =
    "sending 012345678901234567890123456789012345678901234567890123456789...".
Proof. split; computed. Qed.

Example ordinary_submission_publishes_once_with_its_original_nonce :
  submission_plan "" false "007" ["reveal", "link"] =
    [PublishTransaction "007" ["reveal", "link"] (Some "sending reveal link")] /\
  submission_plan "future-nonce" true "7" ["withdraw", "0"] =
    [PublishTransaction "7" ["withdraw", "0"] (Some "sending withdraw 0")].
Proof. split; computed. Qed.

Example future_nonce_marks_before_its_six_hundred_extra_submissions :
  submission_plan "future-nonce" false "7" ["withdraw", "0"] =
    PublishTransaction "7" ["withdraw", "0"] (Some "sending withdraw 0") ::
    MarkNonceFlood :: LogAction "FAULT INJECTION: flooding 600 future-nonce transactions" ::
    map (fun k => PublishTransaction (show (7 + k)) ["withdraw", "0"] None) (List.seq 4 600).
Proof. computed. Qed.

Example future_nonce_range_is_four_through_six_hundred_three :
  length (submission_plan "future-nonce" false "7" []) = 603 /\
  nth 3 (submission_plan "future-nonce" false "7" []) MarkNonceFlood =
    PublishTransaction "11" ["withdraw", "0"] None /\
  nth 602 (submission_plan "future-nonce" false "7" []) MarkNonceFlood =
    PublishTransaction "610" ["withdraw", "0"] None.
Proof. repeat split; computed. Qed.

Example submission_silence_only_suppresses_the_peer_send :
  submission_send "silent" "signed tx" = None /\
  submission_send "" "signed tx" = Some ["tx", "signed tx"] /\
  submission_plan "silent" false "7" ["withdraw", "0"] =
    [PublishTransaction "7" ["withdraw", "0"] (Some "sending withdraw 0")].
Proof. repeat split; computed. Qed.

Example storage_ops_travel_the_one_interface :
  io_wire (IoStore "7" ["tx1", "tx2"]) = ["store", "7", "tx1", "tx2"] /\
  io_of_wire ["store", "7", "tx1", "tx2"] = Some (IoStore "7" ["tx1", "tx2"]) /\
  io_wire (IoStore "8" []) = ["store", "8"] /\
  io_wire (IoSetHeight "9") = ["set_height", "9"] /\
  io_of_wire ["set_height", "9"] = Some (IoSetHeight "9") /\
  io_wire (IoWriteStatus "height 3") = ["write_status", "height 3"] /\
  io_of_wire ["write_status", "height 3"] = Some (IoWriteStatus "height 3") /\
  action_io (StoreAction "7" ["tx1"]) = Some (IoStore "7" ["tx1"]) /\
  io_of_wire ["store"] = None.
Proof. repeat split; computed. Qed.

Example broadcast_selects_its_fields_and_leaves_other_outputs :
  plan_output ["broadcast", "prevote", "1", "0", "-1", "v", "nil"] =
    Broadcast ["prevote", "1", "0", "-1", "v", "nil"] /\
  plan_output ["broadcast"] = Broadcast [] /\
  plan_output ["not-broadcast"] = LegacyOutput ["not-broadcast"].
Proof. repeat split; computed. Qed.

Example broadcast_records_a_new_vote_then_sends_it_to_every_peer :
  broadcast_plan "" 2 ["prevote", "1", "0", "-1", "v", "nil"]
    (Some ("prevote", "1", "0", "v")) None None =
    [RememberVote "prevote/1/0" "v" ["prevote", "1", "0", "-1", "v", "nil"],
     RememberBroadcast "1" "all" ["prevote", "1", "0", "-1", "v", "nil"]
       ["prevote", "1", "0", "-1", "v", "nil"],
     SendEveryone ["prevote", "1", "0", "-1", "v", "nil"]].
Proof. computed. Qed.

Example broadcast_refuses_a_second_value_when_nothing_was_stored :
  broadcast_plan "" 2 ["prevote", "1", "0", "-1", "w", "nil"]
    (Some ("prevote", "1", "0", "w")) (Some "v") None =
    [LogAction "refusing to sign a second prevote at prevote/1/0: already signed v"].
Proof. computed. Qed.

Example broadcast_resends_the_stored_vote :
  broadcast_plan "" 1 ["prevote", "1", "0", "-1", "w", "nil"]
    (Some ("prevote", "1", "0", "w")) (Some "v")
    (Some ["prevote", "1", "0", "-1", "v", "nil"]) =
    [LogAction "already signed a prevote at prevote/1/0: sending that one again",
     RememberBroadcast "1" "all" ["prevote", "1", "0", "-1", "v", "nil"]
       ["prevote", "1", "0", "-1", "v", "nil"],
     SendEveryone ["prevote", "1", "0", "-1", "v", "nil"]].
Proof. computed. Qed.

Example broadcast_silent_records_the_vote_and_sends_nothing :
  broadcast_plan "silent" 2 ["prevote", "1", "0", "-1", "v", "nil"]
    (Some ("prevote", "1", "0", "v")) None None =
    [RememberVote "prevote/1/0" "v" ["prevote", "1", "0", "-1", "v", "nil"]] /\
  broadcast_subject ["done", "4", "0", "0", "abc", "tx"] = None /\
  broadcast_plan "" 1 ["ping"] None None None = [SendEveryone ["ping"]].
Proof. repeat split; computed. Qed.

Example broadcast_equivocates_and_double_votes_per_peer :
  broadcast_plan "equivocate" 2 ["proposal", "3", "1", "0", "vid", "val"] None None None =
    [RememberBroadcast "3" "each" ["proposal", "3", "1", "0", "vid", "val"]
       ["proposal", "3", "1", "0", hash_list ["equivocation", "3", "1"], "equivocation", "3", "1"],
     SendPeer "0" ["proposal", "3", "1", "0", "vid", "val"],
     SendPeer "1" ["proposal", "3", "1", "0", hash_list ["equivocation", "3", "1"], "equivocation", "3", "1"]] /\
  broadcast_plan "double-vote" 2 ["prevote", "3", "1", "0", "vid", "val", "tail"]
    (Some ("prevote", "3", "1", "vid")) (Some "vid") None =
    [RememberBroadcast "3" "each" ["prevote", "3", "1", "0", "vid", "val", "tail"]
       ["prevote", "3", "1", "0", "", "val", "tail"],
     SendPeer "0" ["prevote", "3", "1", "0", "vid", "val", "tail"],
     SendPeer "1" ["prevote", "3", "1", "0", "", "val", "tail"]].
Proof. repeat split; computed. Qed.

(** A decided merge's pure part: its gate, its edits and the texts said. *)
Example merge_output_selects_merge_and_short_forms_stay_legacy :
  plan_output ["merge", "calc", "2", "tree", "7", "3", "codex", "spec", "a.txt", "x", "y"] =
    MergeRequest "calc" "2" "tree" "7" "3" "codex" "spec" ["a.txt", "x", "y"] /\
  plan_output ["merge", "calc", "2", "tree", "7", "3", "codex"] =
    LegacyOutput ["merge", "calc", "2", "tree", "7", "3", "codex"].
Proof. split; computed. Qed.

Example merge_gate_unknown_applied_newer_and_diverged :
  merge_gate_of None "2" false = MergeUnknown /\
  merge_gate_of (Some "2") "2" false = MergeSkip /\
  merge_gate_of (Some "3") "2" false = MergeSkip /\
  merge_gate_of (Some "1") "2" true = MergeSkip /\
  merge_gate_of (Some "1") "2" false = MergeApply.
Proof. repeat split; computed. Qed.

Example edit_triples_in_order_dropping_a_short_tail :
  edit_triples ["a", "o", "n", "b", "", "whole", "c", "x"] = [("a", "o", "n"), ("b", "", "whole")].
Proof. computed. Qed.

Example edit_plan_of_cases :
  edit_plan_of "../x" "o" "n" "file" = EditFail "unsafe path ../x" /\
  edit_plan_of "a" "o" "n" "symlink" = EditFail "a goes through a symlink" /\
  edit_plan_of "a" "o" "n" "dir" = EditFail "a is a directory" /\
  edit_plan_of "a" "" "" "file" = EditRemove "a" /\
  edit_plan_of "a" "" "" "none" = EditFail "a: nothing to delete" /\
  edit_plan_of "a" "" "whole" "none" = EditWrite "a" "whole" /\
  edit_plan_of "a" "o" "n" "none" = EditFail "a: no such file to edit" /\
  edit_plan_of "a" "o" "n" "file" = EditRead "a".
Proof. repeat split; computed. Qed.

Example merge_edit_once_zero_one_several :
  edit_apply "a" "x" "y" "abc" = EditFail "a: the old text isn't in the file" /\
  edit_apply "a" "b" "y" "abc" = EditWrite "a" "ayc" /\
  edit_apply "a" "b" "y" "abcb" = EditFail "a: the old text appears more than once, so give more of it".
Proof. repeat split; computed. Qed.

Example merge_tree_check_and_texts :
  merge_tree_check "t" None = Some "git commit failed" /\
  merge_tree_check "t" (Some ("t", "abc1234")) = None /\
  merge_tree_check "t" (Some ("u", "abc1234")) = Some "got tree u, attested t" /\
  merge_diverged_text "calc" "07" "boom" = "DIVERGED: repository calc, merge 7: boom. Stopped taking merges for it.".
Proof. repeat split; reflexivity. Qed.

(** The llm output: its request, the budget and hold, its log lines, and
    the prompt assembled from what the shell reads. *)
Example llm_output_selects_a_model_request :
  plan_output ["llm", "3", "patch", "P", "calc", "a.txt"] = LlmRequest "3" "patch" "P" ["calc", "a.txt"] /\
  plan_output ["llm", "3", "draft", "P"] = LlmRequest "3" "draft" "P" [] /\
  plan_output ["llm", "3", "draft"] = LegacyOutput ["llm", "3", "draft"].
Proof. repeat split; computed. Qed.

Example llm_gate_budget_then_a_strict_limit :
  llm_gate_of "101" "100" 0%float 50%float = LlmOverBudget /\
  llm_gate_of "100" "100" 5%float 10%float = LlmHeld /\
  llm_gate_of "100" "100" 10%float 10%float = LlmAsk /\
  llm_gate_of "1" "0" 0%float 0%float = LlmOverBudget.
Proof. repeat split; computed. Qed.

Theorem llm_over_budget_whatever_the_limit : forall calls max now until,
  (num max <? num calls) = true -> llm_gate_of calls max now until = LlmOverBudget.
Proof. intros calls max now until H. unfold llm_gate_of. rewrite H. reflexivity. Qed.

Example llm_log_lines :
  llm_budget_text "100" = "model call budget of 100 used up: restart with a higher --max-llm-calls" /\
  llm_hold_text "4" "pick" "claude" "15" = "holding request 4 (a pick): claude is limited for 15 more minutes" /\
  llm_ask_text "codex" "patch" "7" "3" "100" = "asking codex for a patch (request 7, call 3 of 100)".
Proof. repeat split; computed. Qed.

Example llm_fence_and_listing :
  shell_fence "T" "file a" "x" = "<<<UNTRUSTED T file a>>>
x
<<<END UNTRUSTED T>>>
" /\
  listing_text "a
b
c" 2 = "a
b
(and 1 more)" /\
  listing_text "a
b" 2 = "a
b" /\
  listing_text "" 2 = "".
Proof. repeat split; computed. Qed.

Example llm_plan_text_open_none_and_absent :
  plan_text_of "T" [("calc", None)] = "(no repository has a .plan)
" /\
  plan_text_of "T" [("calc", Some "- gone"), ("web", None)] =
    shell_fence "T" "plan of calc: open items" "(none: every item is done or dropped)" /\
  plan_text_of "T" [("calc", Some "one
+ done
two")] = shell_fence "T" "plan of calc: open items" "one
two".
Proof. repeat split; computed. Qed.

(** Each file is cut at the cap, and the budget spends what was quoted,
    the cut note included: once it's spent, a file is only the note. *)
Example llm_repo_files_cap_and_budget :
  repo_files_text "T" 10 100 [("a", Some "hi")] = shell_fence "T" "file a" "hi" /\
  repo_files_text "T" 4 6 [("a", Some "abcdef"), ("b", None), ("c", Some "")] =
    append (shell_fence "T" "file a" (append "abcd" (append newline "(cut here: the file goes on)")))
      (append (shell_fence "T" "file b" (append newline "(cut here: the file goes on)"))
        (shell_fence "T" "file c" "")) /\
  repo_files_text "T" 100 100 [("b", None)] = shell_fence "T" "file b" "(no such file at the head)".
Proof. repeat split; computed. Qed.

Example llm_repo_text_known_and_unknown :
  repo_text_of "T" "nope" None [] 1 1 = "(no repository nope)
" /\
  repo_text_of "T" "calc" (Some "x.txt") [("x.txt", Some "hi")] 10 100 =
    append (shell_fence "T" "files in calc" "x.txt") (shell_fence "T" "file x.txt" "hi").
Proof. repeat split; computed. Qed.

(** Placeholders in order; {{REPO}} needs a context, and text put in for a
    placeholder already done isn't replaced again. *)
Example llm_prompt_assembly :
  prompt_assemble "T" "A {{F}} {{REPOS}} {{PLAN}} {{REPO}}" ["calc", "x"]
    (fun _ => "R") (fun _ => "P") (fun r ps => append r (hd "" ps)) = "A T R P calcx" /\
  prompt_assemble "T" "{{REPO}} {{F}}" [] (fun _ => "R") (fun _ => "P") (fun r _ => r) = "{{REPO}} T" /\
  prompt_assemble "T" "{{REPOS}}" [] (fun _ => "{{F}}") (fun _ => "P") (fun r _ => r) = "{{F}}" /\
  prompt_assemble "T" "plain" ["calc"] (fun _ => "R") (fun _ => "P") (fun r _ => r) = "plain".
Proof. repeat split; computed. Qed.

(** The incremental reader preserves ordering, missing files, and the
    exhausted-budget note, including an empty file after exhaustion. *)
Example llm_incremental_context :
  repo_read_text "T" 4 6
    (fun p => (p, lookup p [("a", "abcdef"), ("c", "")])) ["a", "b", "c"] =
  append (shell_fence "T" "file a" (append "abcd" (append newline "(cut here: the file goes on)")))
    (append (shell_fence "T" "file b" (append newline "(cut here: the file goes on)"))
      (shell_fence "T" "file c" "")) /\
  repo_read_text "T" 4 6 (fun p => (p, Some "unused")) [] = "".
Proof. split; computed. Qed.

(** Held model requests' release: when, how many, and what is said. *)
Example release_plan_cases :
  release_plan_of 0 true false true = ReleaseNone /\
  release_plan_of 2 false false true = ReleaseNone /\
  release_plan_of 2 true true true = ReleaseNone /\
  release_plan_of 2 true false true = ReleaseOne /\
  release_plan_of 2 true false false = ReleaseAll /\
  release_plan_of 1 true false false = ReleaseAll.
Proof. repeat split; computed. Qed.

Example release_texts :
  release_one_text "claude" "3" = "the limit's wait is over: asking claude one held request first (3 held)" /\
  release_all_text "claude" "3" = "claude answers again: asking its 3 held requests".
Proof. split; computed. Qed.

(** What a model's output becomes (step 5): a limit noticed, when it
    resets, how long it holds, and a reply's outcome. *)
Example is_limit_words_any_case :
  is_limit "Error: Rate Limit exceeded" = true /\
  is_limit "You've hit your limit" = true /\
  is_limit "API error (status 402 Payment Required): Grok Build usage balance exhausted" = true /\
  is_limit "RESOURCE_EXHAUSTED" = true /\
  is_limit "all good" = false /\
  is_limit "" = false.
Proof. repeat split; computed. Qed.

Example is_limit_429_only_as_its_own_number :
  is_limit "429" = true /\
  is_limit "HTTP 429 Too" = true /\
  is_limit "status=429." = true /\
  is_limit "k429" = false /\
  is_limit "14290" = false /\
  is_limit "4290 k429 x" = false /\
  is_limit "k429 then 429" = true.
Proof. repeat split; computed. Qed.

Example reset_in_claude_deadline :
  reset_in digits_float 1735999000%float "Claude AI usage limit reached|1736000000" = Some 1000%float /\
  reset_in digits_float 1735999000%float "Claude AI usage limit reached|1736000000
" = Some 1000%float /\
  reset_in digits_float 1736000001%float "Claude AI usage limit reached|1736000000" = None /\
  reset_in digits_float 0%float "limit|1736000000 more" = None /\
  reset_in digits_float 0%float "limit|" = None.
Proof. repeat split; computed. Qed.

Example reset_in_phrases_and_units :
  reset_in digits_float 0%float "Rate limit: try again in 5 minutes" = Some 300%float /\
  reset_in digits_float 0%float "Try again in  2 hours" = Some 7200%float /\
  reset_in digits_float 0%float "quota resets in 30s" = Some 30%float /\
  reset_in digits_float 0%float "try again in 7" = Some 420%float /\
  reset_in digits_float 0%float "try again later; resets in 1h" = Some 3600%float /\
  reset_in digits_float 0%float "try again in a bit" = None /\
  reset_in digits_float 0%float "usage limit" = None /\
  reset_in digits_float 0%float "resets in 3 hours" = Some 10800%float.
Proof. repeat split; computed. Qed.

Example limit_wait_and_backoff :
  limit_wait (Some 300%float) 900%float = 310%float /\
  limit_wait (Some 0%float) 900%float = 900%float /\
  limit_wait None 1800%float = 1800%float /\
  limit_next_backoff 900%float = 1800%float /\
  limit_next_backoff 3600%float = 7200%float /\
  limit_next_backoff 7200%float = 7200%float.
Proof. repeat split; computed. Qed.

Example limit_log_line :
  limit_log_text "claude" "15" "usage limit" =
    "LIMIT: claude says it has hit its limit, so its model calls are held for 15 minutes: usage limit".
Proof. computed. Qed.

Example reply_outcomes :
  reply_outcome_of "!process failed (exit 1): usage limit reached" (fun _ => None) =
    ReplyHold "process failed (exit 1): usage limit reached" /\
  reply_outcome_of "!boom" (fun _ => None) = ReplyError "boom" /\
  reply_outcome_of "!" (fun _ => None) = ReplyError "" /\
  reply_outcome_of "{""a"": ""quota""}" (fun _ => Some ["a", "quota"]) = ReplyFields ["a", "quota"] /\
  reply_outcome_of "sorry, rate limit" (fun _ => None) = ReplyHold "sorry, rate limit" /\
  reply_outcome_of "  hello
there " (fun _ => None) = ReplyError "the reply had no JSON object: hello there" /\
  reply_outcome_of "
 " (fun _ => None) = ReplyError "the reply was empty" /\
  reply_outcome_of "" (fun _ => None) = ReplyError "the reply was empty".
Proof. repeat split; computed. Qed.

Example reply_no_json_cut_at_two_hundred :
  reply_no_json_text (append (Stdlib.Strings.String.concat "" (repeat "0123456789" 20)) "X") =
    append "the reply had no JSON object: " (append (Stdlib.Strings.String.concat "" (repeat "0123456789" 20)) "...") /\
  reply_no_json_text (Stdlib.Strings.String.concat "" (repeat "0123456789" 20)) =
    append "the reply had no JSON object: " (Stdlib.Strings.String.concat "" (repeat "0123456789" 20)).
Proof. split; computed. Qed.

(** A reply with no JSON object never becomes a reply event. *)
Theorem no_json_no_reply : forall text kv,
  reply_outcome_of text (fun _ => None) <> ReplyFields kv.
Proof.
  intros text kv. unfold reply_outcome_of.
  destruct (starts "!" text); destruct (is_limit text); discriminate.
Qed.

(** A failed job never becomes a reply event either, whatever its JSON. *)
Theorem failed_job_no_reply : forall text f kv,
  starts "!" text = true -> reply_outcome_of text f <> ReplyFields kv.
Proof.
  intros text f kv H. unfold reply_outcome_of. rewrite H.
  destruct (is_limit text); discriminate.
Qed.

(** A JSON reply from a job that didn't fail is that reply, limit words or not. *)
Theorem json_reply_is_the_reply : forall text f kv,
  starts "!" text = false -> f text = Some kv -> reply_outcome_of text f = ReplyFields kv.
Proof.
  intros text f kv H J. unfold reply_outcome_of. rewrite H, J. reflexivity.
Qed.

(** A reply's JSON object: the slice from the first "{" through the last
    "}", the cap, and the shallow_json guard. Offsets and the cap are
    decimal strings, the way they cross the binding. *)
Example json_in_reply_slice_bounds_and_depth :
  json_in_reply "{""a"":{""b"":""c""}}" "15" (Some "0") (Some "14") = Some "{""a"":{""b"":""c""}}" /\
  json_in_reply "{""a"":{""b"":""c""}}" "14" (Some "0") (Some "14") = None /\
  json_in_reply "abcd" "4" (Some "0") (Some "3") = Some "abcd" /\
  json_in_reply "abcd" "3" (Some "0") (Some "3") = None /\
  json_in_reply "{""a"":1}" "100" None (Some "6") = None /\
  json_in_reply "{""a"":1}" "100" (Some "0") None = None /\
  json_in_reply "}{" "15" (Some "1") (Some "0") = None /\
  json_in_reply "{}" "15" (Some "0") (Some "0") = None /\
  json_in_reply "{}" "15" (Some "0") (Some "1") = Some "{}" /\
  json_in_reply " pre {""k"":""v""} " "100" (Some "5") (Some "13") = Some "{""k"":""v""}" /\
  json_in_reply "{{{{{x}}}}}" "100" (Some "0") (Some "10") = None /\
  json_in_reply "{{{{x}}}}" "100" (Some "0") (Some "8") = Some "{{{{x}}}}".
Proof. repeat split; computed. Qed.

(** The braces are found in Soma: the first "{" and the last "}", by
    byte offset, as OCaml's index_opt and rindex_opt found them. *)
Example reply_brace_offsets :
  reply_open_at " pre {""a"":1} {""b"":2} post" = Some "5" /\
  reply_close_at " pre {""a"":1} {""b"":2} post" = Some "19" /\
  reply_open_at "none" = None /\ reply_close_at "none" = None /\
  reply_open_at "" = None /\ reply_close_at "" = None /\
  reply_open_at "}{" = Some "1" /\ reply_close_at "}{" = Some "0" /\
  reply_close_at "{}" = Some "1".
Proof. repeat split; computed. Qed.

(** Flattened tokens: nested objects, list indices, scalars, empty and
    duplicate keys, in the old left-to-right order. *)
Example flatten_reply_shapes :
  flatten_reply ["A", "0"] = [] /\
  flatten_reply ["A", "1", "a", "A", "0"] = [] /\
  flatten_reply ["A", "1", "a", "S", "hi"] = ["a", "hi"] /\
  flatten_reply ["A", "2", "b", "S", "1", "a", "A", "1", "c", "S", "2"] = ["b", "1", "a.c", "2"] /\
  flatten_reply ["A", "1", "files", "L", "2", "A", "1", "path", "S", "a", "A", "1", "path", "S", "b"]
    = ["files.0.path", "a", "files.1.path", "b"] /\
  flatten_reply ["A", "4", "ok", "B", "true", "z", "U", "n", "I", "0", "f", "F", "2"]
    = ["ok", "true", "z", "null", "n", "0", "f", "2"] /\
  flatten_reply ["A", "1", "a", "L", "0"] = [] /\
  flatten_reply ["A", "2", "a", "S", "1", "a", "S", "2"] = ["a", "1", "a", "2"] /\
  flatten_reply ["L", "2", "I", "7", "S", "q"] = [".0", "7", ".1", "q"] /\
  flatten_reply ["A", "1", "a", "S", ""] = ["a", ""].
Proof. repeat split; computed. Qed.

(** The slice and the tokens together are the fields. A slice yojson
    refuses, or no slice at all, is no fields. *)
Example reply_fields_of_nested_and_absent :
  reply_fields_of "{""a"":{""b"":""c""}}" "15" (Some "0") (Some "14")
    (fun _ => Some ["A", "1", "a", "A", "1", "b", "S", "c"]) = Some ["a.b", "c"] /\
  reply_fields_of "{x}" "10" (Some "0") (Some "2") (fun _ => None) = None /\
  reply_fields_of "no json here" "100" None None (fun _ => Some ["A", "0"]) = None /\
  reply_fields_of "{}" "1" (Some "0") (Some "1") (fun _ => Some ["A", "0"]) = None /\
  reply_fields_of "{}" "2" (Some "0") (Some "1") (fun _ => Some ["A", "0"]) = Some [].
Proof. repeat split; computed. Qed.

(** No braces: there is no object, so the job is not a reply event. *)
Theorem reply_without_braces_is_not_a_reply : forall text limit tokens kv,
  reply_outcome_of text (fun _ => reply_fields_of text limit None None tokens) <> ReplyFields kv.
Proof.
  intros text limit tokens kv. unfold reply_outcome_of.
  destruct (starts "!" text).
  - destruct (is_limit text); discriminate.
  - unfold reply_fields_of, json_in_reply.
    destruct (num limit <? slen text); destruct (is_limit text); discriminate.
Qed.

(** Past the output cap: not a reply event, whatever the braces were. *)
Theorem reply_over_limit_is_not_a_reply : forall text limit open_at close_at tokens kv,
  (num limit <? slen text) = true ->
  reply_outcome_of text (fun _ => reply_fields_of text limit open_at close_at tokens) <> ReplyFields kv.
Proof.
  intros text limit open_at close_at tokens kv H. unfold reply_outcome_of.
  destruct (starts "!" text).
  - destruct (is_limit text); discriminate.
  - unfold reply_fields_of, json_in_reply. rewrite H.
    destruct (is_limit text); discriminate.
Qed.

(** A slice that parses becomes a reply whose fields are exactly the
    flattened tokens. *)
Theorem flattened_object_is_the_reply : forall text limit open_at close_at tokens raw toks,
  starts "!" text = false ->
  json_in_reply text limit open_at close_at = Some raw ->
  tokens raw = Some toks ->
  reply_outcome_of text (fun _ => reply_fields_of text limit open_at close_at tokens)
    = ReplyFields (flatten_reply toks).
Proof.
  intros text limit open_at close_at tokens raw toks H S T.
  unfold reply_outcome_of. rewrite H.
  unfold reply_fields_of. rewrite S. rewrite T. reflexivity.
Qed.

Example peer_shape_item_and_depth_boundaries :
  peer_line_shape "2" "{""x"":0}" = true /\
  peer_line_shape "1" "{""x"":0}" = false /\
  peer_line_shape "4" "{""x"":0,""y"":1}" = true /\
  peer_line_shape "3" "{""x"":0,""y"":1}" = false /\
  peer_line_shape "100" "{""x"":[[[]]]}" = true /\
  peer_line_shape "100" "{""x"":[[[[]]]]}" = false.
Proof. repeat split; computed. Qed.

Example peer_wire_fields_preserve_sender_signature_and_field_order :
  peer_wire_fields "me" (fun _ => false) (Some ("peer", ("sig", ["prevote", "3", "2"]))) =
    ["peer_line", "0", "0", "peer", "sig", "prevote", "3", "2"] /\
  peer_wire_fields "me" (fun _ => false) (Some ("peer", ("sig", []))) =
    ["peer_line", "0", "0", "peer", "sig"].
Proof. split; computed. Qed.

Example peer_own_and_refused_flags_precede_signature_verification :
  peer_wire_fields "me" (fun _ => false) (Some ("me", ("sig", ["tx", "raw"]))) =
    ["peer_line", "1", "0", "me", "sig", "tx", "raw"] /\
  peer_wire_fields "me" (fun raw => seq raw "bad") (Some ("peer", ("sig", ["tx", "bad"]))) =
    ["peer_line", "0", "1", "peer", "sig", "tx", "bad"] /\
  peer_wire_fields "me" (fun _ => true) (Some ("peer", ("sig", ["tx", "raw", "extra"]))) =
    ["peer_line", "0", "0", "peer", "sig", "tx", "raw", "extra"] /\
  line_dropped "1" "0" = true /\ line_dropped "0" "1" = true.
Proof. repeat split; computed. Qed.

Example peer_bad_members_produce_no_event :
  peer_wire_fields "me" (fun _ => false) None = [] /\
  peer_raw_event "100" "me" "{bad}" (fun _ => None) (fun _ => false) = [] /\
  peer_raw_event "1" "me" "{""x"":0}"
    (fun _ => Some ("peer", ("sig", ["tx", "raw"]))) (fun _ => false) = [].
Proof. repeat split; computed. Qed.

Theorem malformed_peer_shape_needs_no_json_members : forall cap me raw parts refused,
  peer_line_shape cap raw = false -> peer_raw_event cap me raw parts refused = [].
Proof. intros cap me raw parts refused H. unfold peer_raw_event. rewrite H. reflexivity. Qed.

(** U-1: the node's operations as one interface. The dispatch produces
    [node_op] values; each crosses the binding as its wire form, which
    reads back as the same operation. *)
Lemma resend_parts_reads_fields : forall fields alternate,
  resend_parts (resend_fields fields ++ ("alternate" :: alternate)) = Some (fields, alternate).
Proof.
  induction fields as [|field rest IH]; intros alternate.
  - reflexivity.
  - change (match resend_parts (resend_fields rest ++ ("alternate" :: alternate)) with
      | Some (fields, alt) => Some (field :: fields, alt)
      | None => None end = Some (field :: rest, alternate)).
    rewrite IH. reflexivity.
Qed.

Lemma nio_lists_acc_frame : forall l rest cur,
  nio_lists_acc (resend_fields l ++ ("alternate" :: rest)) cur = (List.rev cur ++ l) :: nio_lists_acc rest [].
Proof.
  induction l as [|v l IH]; intros rest cur.
  - cbn. rewrite List.app_nil_r. reflexivity.
  - cbn. rewrite IH. cbn. rewrite <- List.app_assoc. reflexivity.
Qed.

(** Lists of lists on one wire read back. *)
Lemma nio_lists_reads_frames : forall ls, nio_lists (nio_frame_lists ls) = ls.
Proof.
  induction ls as [|l rest IH]; [reflexivity|]. unfold nio_lists in *. cbn [nio_frame_lists].
  rewrite nio_lists_acc_frame, IH. reflexivity.
Qed.

Theorem io_wire_reads_back : forall op, io_of_wire (io_wire op) = Some op.
Proof.
  intros op. destruct op as [text | ms event | event | fields | index fields |
    who fields | height txs | height | text | previous digest entry | key evidence | slot vid fields | raw | |
    id repo head edits | repo version | repo entry | | height kind fields alternate |
    offer mode target | conn | job | job | who | | repo | who first | who first timestamp |
    | height | | | slot | slot | height | nonce fields | | | | | stamp |
    repo | repo | repo path | repo path | repo path text | repo path |
    repo version tree bid task bidder spec | | id kind prompt ctx |
    id kind raw prompt ctx clean launch env | repo | | | | repo | repo path |
    until reason backoff | backoff | | | probing requests | job result | id out tree ci evidence | path | path |
    raw | | raw | who | | | | stamp | path | | | timers | | | wait |
    | | height txs | | slot vid fields | message | text | code | path | path mode | path | | count | dir args |
    url dir commit | prog log args | pids | path | dir path | dir path text | dir path | prefix | path | dir stdin extra args | prog stdin cwd env args | job | prog args | prefix suffix text | host port backlog | host port | ms reads writes | fd nonblock | fd | fd data | fd | fd | path durable text | path text | | prog stdin cwd env args | pid | pid | path text sync | root path text | root path | path text sync | path | src dst | dir | path | path | prefix suffix | prog args | text | | address port | wait | conn found stamp fields |
    address port | ms | address port ms | conn data | conn | name | name durable text | name text ];
    try reflexivity.
  - change (match resend_parts (resend_fields fields ++ ("alternate" :: alternate)) with
    | Some (original, alt) => Some (IoRememberBroadcast height kind original alt)
    | None => None end = Some (IoRememberBroadcast height kind fields alternate)).
    rewrite resend_parts_reads_fields. reflexivity.
  - change (match resend_parts (resend_fields ctx ++ ("alternate" ::
            resend_fields clean ++ ("alternate" :: resend_fields launch ++ ("alternate" :: env)))) with
    | Some (ctx, rest) =>
        match resend_parts rest with
        | Some (clean, rest) =>
            match resend_parts rest with
            | Some (launch, env) => Some (IoLlmStart id kind raw prompt ctx clean launch env)
            | None => None
            end
        | None => None
        end
    | None => None end = Some (IoLlmStart id kind raw prompt ctx clean launch env)).
    rewrite !resend_parts_reads_fields. reflexivity.
  - change (Some (IoHeldStore probing (nio_lists (nio_frame_lists requests))) =
            Some (IoHeldStore probing requests)).
    rewrite nio_lists_reads_frames. reflexivity.
  - change (Some (IoSetTimers (nio_lists (nio_frame_lists timers))) = Some (IoSetTimers timers)).
    rewrite nio_lists_reads_frames. reflexivity.
  - change (match resend_parts (resend_fields extra ++ ("alternate" :: args)) with
    | Some (extra, args) => Some (IoGitEnv dir stdin extra args)
    | None => None end = Some (IoGitEnv dir stdin extra args)).
    rewrite resend_parts_reads_fields. reflexivity.
  - change (match resend_parts (resend_fields env ++ ("alternate" :: args)) with
    | Some (env, args) => Some (IoProcStart prog stdin cwd env args)
    | None => None end = Some (IoProcStart prog stdin cwd env args)).
    rewrite resend_parts_reads_fields. reflexivity.
  - change (match resend_parts (resend_fields reads ++ ("alternate" :: writes)) with
    | Some (reads, writes) => Some (IoSockSelect ms reads writes)
    | None => None end = Some (IoSockSelect ms reads writes)).
    rewrite resend_parts_reads_fields. reflexivity.
  - change (match resend_parts (resend_fields env ++ ("alternate" :: args)) with
    | Some (env, args) => Some (IoSpawn prog stdin cwd env args)
    | None => None end = Some (IoSpawn prog stdin cwd env args)).
    rewrite resend_parts_reads_fields. reflexivity.
Qed.

Example io_wire_forms :
  io_wire (IoLog "hi there") = ["log", "hi there"] /\
  io_wire (IoTimer "350" ["timeout", "commit", "7", "2"]) = ["timer", "350", "timeout", "commit", "7", "2"] /\
  io_wire (IoQueue ["tx", "raw"]) = ["push", "tx", "raw"] /\
  io_wire (IoSendAll ["prevote", "1"]) = ["send_all", "prevote", "1"] /\
  io_wire (IoSendPeer "0" []) = ["send_peer", "0"] /\
  io_wire (IoPeerSend "codex" ["done", "4"]) = ["peer_send", "codex", "done", "4"] /\
  io_wire IoClock = ["clock"] /\ io_of_wire ["clock"] = Some IoClock /\
  io_of_wire ["clock", "extra"] = None /\
  io_of_wire ["log"] = None /\ io_of_wire ["log", "a", "b"] = None /\
  io_of_wire ["timer"] = None /\ io_of_wire [] = None /\ io_of_wire ["nope", "x"] = None.
Proof. repeat split; computed. Qed.

Example outputs_become_operations :
  output_io ["timer", "commit", "7", "2", "350"] = Some (IoTimer "350" ["timeout", "commit", "7", "2"]) /\
  output_io ["log", "line"] = Some (IoLog "line") /\
  output_io ["timer", "commit", "7", "2"] = None /\
  output_io ["height", "3"] = None.
Proof. repeat split; computed. Qed.

Example plans_become_operations :
  map action_io (reveal_plan "withhold" "4" "secret" "3" (draw_link 3 "secret")) =
    [Some (IoLog "FAULT INJECTION: holding back my link for draw 3")] /\
  map action_io (reveal_plan "" "4" "secret" "2" (draw_link 3 "secret")) =
    [Some (IoQueue ["local_tx", "reveal", sha256 (sha256 "secret")])] /\
  map action_io (broadcast_plan "equivocate" 2 ["proposal", "3", "1", "0", "vid", "val"] None None None) =
    [Some (IoRememberBroadcast "3" "each" ["proposal", "3", "1", "0", "vid", "val"]
       ["proposal", "3", "1", "0", hash_list ["equivocation", "3", "1"], "equivocation", "3", "1"]),
     Some (IoSendPeer "0" ["proposal", "3", "1", "0", "vid", "val"]),
     Some (IoSendPeer "1" ["proposal", "3", "1", "0", hash_list ["equivocation", "3", "1"], "equivocation", "3", "1"])] /\
  map action_io (broadcast_plan "" 2 ["ping"] None None None) = [Some (IoSendAll ["ping"])] /\
  action_io (StoreAction "7" []) = Some (IoStore "7" []).
Proof. repeat split; computed. Qed.

(** U-1: the signed-vote log, the own-transaction table, the nonce-flood
    mark, the CI check and a merge's records are operations too. *)
Example writes_and_check_travel_the_one_interface :
  io_wire (IoSignVote "prevote/1/0" "v" ["prevote", "1"]) = ["sign_vote", "prevote/1/0", "v", "prevote", "1"] /\
  io_of_wire ["sign_vote", "s", "v"] = Some (IoSignVote "s" "v" []) /\
  io_of_wire ["sign_vote", "s"] = None /\
  io_wire (IoTrackTx "raw") = ["track_tx", "raw"] /\
  io_of_wire ["track_tx", "a", "b"] = None /\
  io_wire IoMarkNonceFlood = ["mark_nonce_flood"] /\
  io_wire (IoCheck "9" "calc" "head1" ["a", "o", "n"]) = ["check", "9", "calc", "head1", "a", "o", "n"] /\
  io_of_wire ["check", "9", "calc"] = None /\
  io_wire (IoMergeApplied "calc" "2") = ["merge_applied", "calc", "2"] /\
  io_wire (IoMergeDiverged "calc" "2: boom") = ["merge_diverged", "calc", "2: boom"] /\
  io_of_wire ["merge_applied", "calc"] = None.
Proof. repeat split; computed. Qed.

Example votes_floods_and_checks_become_operations :
  map action_io (broadcast_plan "" 2 ["prevote", "1", "0", "-1", "v", "nil"]
    (Some ("prevote", "1", "0", "v")) None None) =
    [Some (IoSignVote "prevote/1/0" "v" ["prevote", "1", "0", "-1", "v", "nil"]),
     Some (IoRememberBroadcast "1" "all" ["prevote", "1", "0", "-1", "v", "nil"] ["prevote", "1", "0", "-1", "v", "nil"]),
     Some (IoSendAll ["prevote", "1", "0", "-1", "v", "nil"])] /\
  map action_io (firstn 3 (submission_plan "future-nonce" false "7" ["withdraw", "0"])) =
    [None, Some IoMarkNonceFlood, Some (IoLog "FAULT INJECTION: flooding 600 future-nonce transactions")] /\
  check_request_op "9" "calc" "head1" ["e1", "e2"] [] [] = IoCheck "9" "calc" "head1" ["e1", "e2"] /\
  output_io ["check", "9", "calc"] = None.
Proof. repeat split; computed. Qed.

(** An action that is one operation is the program of exactly that
    operation, and the timer and log outputs are carried out as theirs. *)
Theorem single_actions_are_their_operation : forall action op,
  action_io action = Some op -> action_prog action = nexec op.
Proof.
  intros action op H. destruct action; cbn in H; try discriminate H;
    injection H as <-; reflexivity.
Qed.

Theorem single_outputs_are_their_operation : forall out op,
  output_io out = Some op -> output_prog out = nexec op.
Proof.
  intros out op H. unfold output_io in H. unfold output_prog.
  destruct (plan_output out); try discriminate H; injection H as <-; reflexivity.
Qed.

(** A local transaction from the inbox: a JSON list of strings, and the
    shapes that are malformed. *)
Example inbox_tx_shapes :
  inbox_tx (Some ["L", "2", "S", "post", "S", "calc task"]) = Some ["post", "calc task"] /\
  inbox_tx (Some ["L", "0"]) = Some [] /\
  inbox_tx None = None /\
  inbox_tx (Some ["A", "0"]) = None /\
  inbox_tx (Some ["L", "2", "S", "a", "I", "3"]) = None /\
  inbox_tx (Some ["L", "1", "S", "a", "S", "b"]) = None /\
  inbox_tx (Some ["L", "2", "S", "a"]) = None /\
  inbox_tx (Some ["S", "x"]) = None.
Proof. repeat split; computed. Qed.

(** A job past its limit is stopped once. The same instant as the limit,
    a time before it, and a clock behind the start are not. *)
Example job_deadline_is_strict_and_once :
  job_should_expire 10%float 0%float 10%float false = false /\
  job_should_expire 11%float 0%float 10%float false = true /\
  job_should_expire 11%float 0%float 10%float true = false /\
  job_should_expire 9%float 0%float 10%float false = false /\
  job_should_expire 0%float 5%float 10%float false = false.
Proof. repeat split; computed. Qed.

Theorem marked_job_is_kept : forall now started limit,
  job_should_expire now started limit true = false.
Proof. reflexivity. Qed.

(** Due timers are those at or before now, in the stored order; the rest
    stay in that order too. *)
Theorem timers_due_partitions : forall now l,
  timers_due now l =
    (filter (fun p => PrimFloat.leb (fst p) now) l,
     filter (fun p => negb (PrimFloat.leb (fst p) now)) l).
Proof.
  intros now l. induction l as [|p r IH].
  - reflexivity.
  - simpl. rewrite IH. destruct (PrimFloat.leb (fst p) now) eqn:E; reflexivity.
Qed.

Example timer_edges_and_old_sort_order :
  timers_due 10%float [] = ([], []) /\
  timers_due 10%float [(10%float, ["now"]), (11%float, ["later"]), (9%float, ["early"])]
    = ([(10%float, ["now"]), (9%float, ["early"])], [(11%float, ["later"])]) /\
  timer_events (sort_timers [(10%float, ["timeout", "b"]), (10%float, ["timeout", "a"]),
                             (10%float, ["timeout"]), (9%float, ["early"]),
                             (10%float, ["timeout", "a"])])
    = [["early"], ["timeout"], ["timeout", "a"], ["timeout", "a"], ["timeout", "b"]] /\
  str_ord "a" "b" = OrdLt /\ str_ord "b" "a" = OrdGt /\ str_ord "aa" "aa" = OrdEq /\
  str_ord "" "a" = OrdLt /\
  strs_ord ["timeout"] ["timeout", "commit"] = OrdLt /\
  strs_ord ["timeout", "a"] ["timeout", "b"] = OrdLt.
Proof. repeat split; computed. Qed.

(** No wait while an event is already queued. An empty timer list waits
    the old fifth of a second. A sooner timer waits that gap, and a
    deadline already past does not wait. *)
Example select_wait_cap_gap_and_queued :
  select_wait 100%float false [(101%float, ["t"])] = 0%float /\
  select_wait 100%float true [] = select_cap /\
  select_wait 100%float true [(101%float, ["t"])] = select_cap /\
  select_wait 100%float true [(PrimFloat.add 100%float 0.125%float, ["soon"])] = 0.125%float /\
  select_wait 100%float true [(99%float, ["past"])] = 0%float /\
  select_wait 100%float true [(PrimFloat.add 100%float 0.5%float, ["late"]),
                              (PrimFloat.add 100%float 0.125%float, ["soon"])] = 0.125%float.
Proof. repeat split; computed. Qed.

Theorem select_does_not_wait_on_a_queued_event : forall now timers,
  select_wait now false timers = 0%float.
Proof. reflexivity. Qed.

(** A CI check's outcome: passed, the bid's failures (with the budget named
    or the output's tail), and this node's problems, from the node's own
    exit codes only. *)
Example ci_outcome_cases :
  ci_outcome "tree ok" false "3g" = (true, ("", "")) /\
  ci_outcome "!process failed (exit 86): boom" false "3g" = (false, ("CI failed: !process failed (exit 86): boom", "ci")) /\
  ci_outcome "!process failed (exit 137): x" false "3g" = (false, ("CI went over its memory budget (3g, no swap): the build needs less memory than that to merge", "ci")) /\
  ci_outcome "!process failed (exit 124): x" false "3g" = (false, ("CI went over its time budget: the build has to finish within the limit its CI command gives", "ci")) /\
  ci_outcome "!process failed (exit 2): no docker" false "3g" = (false, ("node problem: docker: !process failed (exit 2): no docker", "node")) /\
  ci_outcome "!process failed (exit 2): x" true "3g" = (false, ("node problem: ci-sandbox: !process failed (exit 2): x", "node")) /\
  ci_outcome "!couldn't start" false "3g" = (false, ("node problem: docker: !couldn't start", "node")) /\
  ci_outcome "!process failed (signal 9): x" false "3g" = (false, ("CI failed: !process failed (signal 9): x", "ci")) /\
  ci_outcome "!process failed (printed more than 4 MB): x" false "3g" = (false, ("CI printed more than 4 MB: a check has to print less than that", "ci")).
Proof. repeat split; computed. Qed.

Example ci_exit_codes_and_tail :
  ci_exit_code "exit 0" = Some 0 /\ ci_exit_code "exit 12x" = None /\ ci_exit_code "exit " = None /\
  ci_exit_code "signal 9" = None /\
  ci_node_problem false (Some "exit 1") = true /\ ci_node_problem false (Some "exit 128") = false /\
  ci_node_problem false (Some "exit 86") = false /\ ci_node_problem true None = false /\
  ci_tail "  a
b  " = "CI failed: a b".
Proof. repeat split; computed. Qed.

(** A check that failed applying a bid: the bid's (exit 1, or a signal),
    or this node's (couldn't run, or another exit code). *)
Example check_apply_stage_cases :
  check_apply_stage "!process failed (exit 1): the old text isn't in the file" = "apply" /\
  check_apply_stage "!process failed (signal 9): x" = "apply" /\
  check_apply_stage "!process failed (exit 2): x" = "node" /\
  check_apply_stage "!process failed (exit 0): x" = "node" /\
  check_apply_stage "!couldn't start the check" = "node".
Proof. repeat split; computed. Qed.

(** A check's output: "!" is a failure even when this node lies about trees
    or has CI; otherwise the tree is the trim, and CI emits nothing yet. *)
Example check_apply_plan_cases :
  check_apply_plan_of "bad-tree" "make test" "!process failed (exit 1): no" = CheckApplyFailed /\
  check_apply_plan_of "" "" "!" = CheckApplyFailed /\
  check_apply_plan_of "" "" " !x" = CheckApplyTree false false "!x" /\
  check_apply_plan_of "" "" "  ab" = CheckApplyTree false false "ab" /\
  check_apply_plan_of "" "make test" "ab" = CheckApplyTree true false "ab" /\
  check_apply_plan_of "bad-tree" "" "ab" = CheckApplyTree false true "ab" /\
  check_apply_plan_of "bad-sig" "" "ab" = CheckApplyTree false false "ab" /\
  check_apply_plan_of "" " " "ab" = CheckApplyTree true false "ab" /\
  check_apply_choice "HASH" "id" "!no" CheckApplyFailed = [["check_failed", "id", "!no"]] /\
  check_apply_choice "HASH" "id" "ab" (CheckApplyTree false false "ab") =
    [["check_result", "id", "ok", "true", "tree", "ab", "why", "", "stage", ""]] /\
  check_apply_choice "HASH" "id" "ab" (CheckApplyTree false true "ab") =
    [["check_result", "id", "ok", "true", "tree", "HASH", "why", "", "stage", ""]] /\
  check_apply_choice "HASH" "id" "ab" (CheckApplyTree true true "ab") = [].
Proof. repeat split; computed. Qed.

Example goal_events_cases :
  goal_events "" = [] /\
  goal_events "stay open" = [["agent", "goal", "stay open"]] /\
  goal_events (append "a" (append newline (append newline (append "b" newline)))) =
    [["agent", "goal", "a"], ["agent", "goal", "b"]].
Proof. repeat split; computed. Qed.

Theorem check_apply_bang_is_failed : forall byz ci raw,
  starts "!" raw = true ->
  check_apply_plan_of byz ci raw = CheckApplyFailed.
Proof. intros byz ci raw H. unfold check_apply_plan_of. rewrite H. reflexivity. Qed.

Theorem check_apply_otherwise_trims : forall byz ci raw,
  starts "!" raw = false ->
  kv_at (check_evidence raw) "tree" = "" ->
  check_apply_plan_of byz ci raw =
    CheckApplyTree (negb (seq ci "")) (seq byz "bad-tree") (ocaml_trim raw).
Proof.
  intros byz ci raw H Hplain. unfold check_apply_plan_of, check_raw_tree.
  rewrite H, Hplain. reflexivity.
Qed.

Example recorded_check_extracts_the_tree_and_commit :
  check_apply_plan_of "" "test" "{""tree"":""ab"",""commit"":""cd""}" = CheckApplyTree true false "ab" /\
  kv_at (check_evidence "{""tree"":""ab"",""commit"":""cd""}") "commit" = "cd".
Proof. split; computed. Qed.

Theorem check_failure_ignores_the_lie : forall lie id raw ci,
  starts "!" raw = true ->
  check_apply_choice lie id raw (check_apply_plan_of "bad-tree" ci raw) =
    [["check_failed", id, raw]].
Proof.
  intros lie id raw ci H.
  unfold check_apply_choice, check_apply_plan_of.
  rewrite H. reflexivity.
Qed.

(** --backend: scripted and a longer scripted: suffix, and scripted: alone
    stays llm with no behavior. *)
Example backend_flag_cases :
  backend_kind_name "scripted" = "scripted" /\ backend_behavior_event "scripted" = [] /\
  backend_kind_name "scripted:stay" = "scripted" /\
  backend_behavior_event "scripted:stay" = [["agent", "behavior", "stay"]] /\
  backend_kind_name "scripted:" = "llm" /\ backend_behavior_event "scripted:" = [] /\
  backend_kind_name "llm" = "llm" /\ backend_behavior_event "scripted:a:b" = [["agent", "behavior", "a:b"]].
Proof. repeat split; computed. Qed.

Example check_eligibility_scope_precedence :
  check_request_op "9" "calc" "head" [] ["calc"] ["calc"] =
    IoQueue ["check_unchecked_repo", "9", "calc", "true"].
Proof. computed. Qed.

Theorem wait_exit_preserves_code : forall codes code,
  job_wait_status codes "exit" code = Some (JobExit code).
Proof. reflexivity. Qed.

Theorem wait_signal_uses_platform_constants : forall codes raw,
  job_wait_status codes "signal" raw = Some (JobSignal (job_signal_name codes raw)).
Proof. reflexivity. Qed.

Theorem wait_stop_uses_platform_constants : forall codes raw,
  job_wait_status codes "stop" raw = Some (JobStop (job_signal_name codes raw)).
Proof. reflexivity. Qed.

Theorem unknown_wait_tag_has_no_status : forall codes tag raw,
  seq tag "exit" = false -> seq tag "signal" = false -> seq tag "stop" = false ->
  job_wait_status codes tag raw = None.
Proof.
  intros codes tag raw He Hs Ht. unfold job_wait_status, job_status_of.
  rewrite He, Hs, Ht. reflexivity.
Qed.

Theorem served_result_presence : forall now,
  served_result (true,(now,[])) = Some now /\ served_result (false,(now,[])) = None.
Proof. intros; split; reflexivity. Qed.

(** The status file reads its facts in the order the bindings did (the
    checkouts' heads, the divergences, the clock, the limit) and then
    writes it; with no limit on, it reads no time of day. *)
Theorem status_reads_in_order : forall ans lines,
  status_limit_active (ans_float (ans IoClock)) (ans_float (ans IoLimitInfo)) = false ->
  exists text, ntrace ans (status_prog lines) =
    [IoCheckoutHeads, IoDivergences, IoClock, IoLimitInfo, IoWriteStatus text].
Proof.
  intros ans lines H. unfold status_prog, ans_float, status_limit_active in *. simpl.
  rewrite H.
  repeat match goal with |- context [match ?e with _ => _ end] => destruct e end;
  eexists; reflexivity.
Qed.

(** A merge that writes one new file, with every operation carried out:
    the gate's reads, the reset, the look at the path, the write, the
    commit (reaching the attested tree), the applied version, the log line;
    and one whose commit reaches another tree diverges instead. *)
merge_answers (tree : string) (op : node_op) : nanswer :=
  match op with
  | IoIsDiverged _ => (false,(0%float,[]))
  | IoAppliedVersion _ => (true,(0%float,["0"]))
  | IoMergeProbe _ _ => (true,(0%float,["none"]))
  | IoMergeWrite _ _ _ => (true,(0%float,[""]))
  | IoMergeCommit _ _ _ _ _ _ _ => (true,(0%float,[tree, "abc1234"]))
  | _ => (true,(0%float,[]))
  end.

Example merge_trace :
  ntrace (merge_answers "t1") (merge_prog "calc" "1" "t1" "b" "task" "codex" "spec" ["a.txt", "", "hi"]) =
  [IoIsDiverged "calc", IoAppliedVersion "calc", IoMergeReset "calc", IoMergeProbe "calc" "a.txt",
   IoMergeWrite "calc" "a.txt" "hi", IoMergeCommit "calc" "1" "t1" "b" "task" "codex" "spec",
   IoMergeApplied "calc" "1", IoLog "merged bid b into calc: abc1234"].
Proof. computed. Qed.

Example merge_wrong_tree_diverges :
  ntrace (merge_answers "t2") (merge_prog "calc" "1" "t1" "b" "task" "codex" "spec" ["a.txt", "", "hi"]) =
  [IoIsDiverged "calc", IoAppliedVersion "calc", IoMergeReset "calc", IoMergeProbe "calc" "a.txt",
   IoMergeWrite "calc" "a.txt" "hi", IoMergeCommit "calc" "1" "t1" "b" "task" "codex" "spec",
   IoLog (merge_diverged_text "calc" "1" "got tree t2, attested t1"),
   IoMergeDiverged "calc" "1: got tree t2, attested t1"].
Proof. computed. Qed.

(** The prompt a model call's program assembles is [prompt_assemble]'s,
    for the texts its parts' programs end with: the placeholders, their
    order and when each part is read are the same. *)
Theorem prompt_prog_assembles : forall ans token prompt ctx repos plan repo,
  nresult ans (prompt_prog token prompt ctx repos plan repo) =
  prompt_assemble token prompt ctx (fun _ => nresult ans repos) (fun _ => nresult ans plan)
    (fun r ps => nresult ans (repo r ps)).
Proof.
  intros ans token prompt ctx repos plan repo. unfold prompt_prog, prompt_assemble. cbv beta zeta.
  rewrite nresult_nbind.
  destruct (prompt_has ReposSlot (prompt_parts prompt)); cbn;
  rewrite nresult_nbind;
  destruct (prompt_has PlanSlot (prompt_parts prompt)); cbn;
  rewrite nresult_nbind.
  all: destruct ctx as [|name paths]; cbn.
  all: try reflexivity.
  all: destruct (prompt_has RepoSlot (prompt_parts prompt)); cbn;
       rewrite ?nresult_nbind; reflexivity.
Qed.

(** A model call over its budget reads the budget, the clock and the
    limit, and queues the error; one asked of claude logs, takes a fence
    token, reads the backend and the environment, and starts the process
    on the prompt (here one with no placeholders, so no files are read). *)
llm_answers (calls : string) (op : node_op) : nanswer :=
  match op with
  | IoLlmBudget => (true,(0%float,[calls, "3"]))
  | IoClock => (true,(5%float,[]))
  | IoLimitInfo => (true,(0%float,["claude", "0", ""]))
  | IoRandomHex _ => (true,(0%float,["T"]))
  | IoEnvEntries => (true,(0%float,["A=1", "PANTHEON_HOME=/x"]))
  | IoLlmStart _ _ _ _ _ _ _ _ => (false,(0%float,[]))
  | _ => (true,(0%float,[]))
  end.

Example llm_over_budget_trace :
  ntrace (llm_answers "4") (llm_prog "7" "ask" "p" []) =
  [IoLlmBudget, IoClock, IoLimitInfo, IoQueue ["llm_error", "7", llm_budget_text "3"]].
Proof. computed. Qed.

Example llm_asked_trace :
  ntrace (llm_answers "1") (llm_prog "7" "ask" "p" []) =
  [IoLlmBudget, IoClock, IoLimitInfo, IoLog (llm_ask_text "claude" "ask" "7" "1" "3"),
   IoRandomHex "8", IoLimitInfo, IoEnvEntries,
   IoLlmStart "7" "ask" "p" "p" [] [] (backend_launch "claude") ["A=1"]].
Proof. computed. Qed.

(** A task's files, read by operations, are [repo_read_text]'s, reading
    each with the answer to [IoHeadFile]. *)
Theorem repo_read_prog_reads : forall ans token r cap files budget,
  nresult ans (repo_read_prog token r cap budget files) =
  repo_read_text token cap budget (fun p => (p, ans_found_one (ans (IoHeadFile r p)))) files.
Proof.
  intros ans token r cap files. induction files as [|p rest IH]; intros budget; [reflexivity|].
  cbn [repo_read_prog repo_read_text]. rewrite nresult_nbind. cbn [nresult nask].
  rewrite nresult_nbind. rewrite IH. reflexivity.
Qed.

(** Giving held requests back reads the limit, the release state and
    the clock before anything else, as the bindings were read. *)
Theorem release_reads_first : forall ans,
  firstn 3 (ntrace ans release_prog) = [IoLimitInfo, IoReleaseState, IoClock].
Proof.
  intros ans. unfold release_prog, ans_list. cbn.
  destruct (snd (snd (ans IoLimitInfo))) as [|b [|n r]]; reflexivity.
Qed.

(** An inbox poll that isn't due reads the inbox's state and the turn's
    clock and nothing else: no directory listing, no file. *)
Theorem inbox_poll_not_due : forall ans,
  inbox_poll_due (ans_float (ans IoTurnNow)) (ans_float (ans IoInboxState)) = false ->
  ntrace ans poll_inbox_prog = [IoInboxState, IoTurnNow].
Proof. intros ans H. unfold poll_inbox_prog. cbn -[inbox_poll_due ans_float]. rewrite H. reflexivity. Qed.

(** Cleanup is best effort after an inbox fact has been queued. Its actual
    unlink result remains available to IO ownership bookkeeping, but it cannot
    starve the remaining inbox actions. Generic ndo/queue failure stays closed. *)
Theorem inbox_cleanup_continues : forall ans path rest,
  nresult ans (inbox_actions_prog (InboxRemove path :: rest)) =
  nresult ans (inbox_actions_prog rest).
Proof.
  intros ans path rest. cbn [inbox_actions_prog nask nbind nexec nresult].
  destruct (fst (ans (IoDiscardFile path))); reflexivity.
Qed.

(** A fresh node (no signed.log, no snapshot, nothing to replay) reads
    signed.log, then its boot events, then how many blocks it replayed:
    no refusal, no replay log line before the start step. *)
Example fresh_boot_reads :
  firstn 3 (ntrace (fun op => match op with
                              | IoSignedText => (true,(0%float,[""]))
                              | IoReplayCount => (true,(0%float,["0"]))
                              | _ => (true,(0%float,[]))
                              end) (boot_prog None)) =
  [IoSignedText, IoBootEvents, IoReplayCount].
Proof. computed. Qed.

Theorem remember_peer_is_served_operation : forall who first now,
  action_prog (RememberPeer who first now) =
    nexec (IoMarkServed who first (float_wire now)).
Proof. reflexivity. Qed.

(** Output actions that are each one operation: when every operation is
    carried out, their program does exactly those operations, in order,
    whoever interprets it (the binary's [run_shell] or a unikernel's). *)
Theorem single_actions_trace : forall ans actions ops,
  (forall op, fst (ans op) = true) ->
  map action_io actions = map Some ops ->
  ntrace ans (actions_prog actions) = ops.
Proof.
  intros ans actions. induction actions as [| a rest IH];
    intros ops Hok Hmap; destruct ops as [| op ops]; cbn in Hmap; try discriminate Hmap.
  - reflexivity.
  - injection Hmap as Ha Hrest. cbn [actions_prog]. rewrite nand_trace.
    rewrite (single_actions_are_their_operation a op Ha). cbn.
    rewrite Hok. rewrite (IH ops Hok Hrest). reflexivity.
Qed.

Example honest_vote_trace :
  ntrace (fun _ => (true,(0%float,[])))
    (actions_prog (broadcast_plan "" 2 ["prevote", "1", "0", "-1", "v", "nil"]
       (Some ("prevote", "1", "0", "v")) None None)) =
  [IoSignVote "prevote/1/0" "v" ["prevote", "1", "0", "-1", "v", "nil"],
   IoRememberBroadcast "1" "all" ["prevote", "1", "0", "-1", "v", "nil"] ["prevote", "1", "0", "-1", "v", "nil"],
   IoSendAll ["prevote", "1", "0", "-1", "v", "nil"]].
Proof. computed. Qed.

(** consensus.state's text reads back as the state it was written from,
    lock, valid value and log included; anything else is refused *)
Example snapshot_reads_back :
  let c := {| consensus.me := "a"; consensus.nodes := ["a", "b", "c", "d"]; consensus.height := 12;
              consensus.round := 2; consensus.step := 2; consensus.lockr := 3; consensus.lockv := ["A:1", ""];
              consensus.validr := 3; consensus.validv := ["A:1", ""]; consensus.once := ["x"]; consensus.block_ms := 500;
              consensus.log := [{| kd := Prevote; frm := "b"; mh := 12; mr := 2; vr := 0; vid := "v"; value := [] |},
                                {| kd := Proposal; frm := "c"; mh := 12; mr := 2; vr := 3; vid := "w"; value := ["t1", "t:2"] |}] |} in
  match snapshot_of (snapshot_text c) with Some d => cons_eq c d = true | None => False end.
Proof. vm_compute. reflexivity. Qed.

Example snapshot_refuses_others :
  snapshot_of "broken" = None /\ snapshot_of "" = None
  /\ snapshot_of (append (snapshot_text (new_consensus "a" ["a"] 1)) "x") = None.
Proof. repeat split; vm_compute; reflexivity. Qed.

(** The node's service answers its own operations, for the node's token
    only: a wrong token, an operation that is the image's own (a vote, a
    block, a peer send, a merge's checkout work, the model's budget or a
    job's bookkeeping, which its kernel carries out over git, paths and
    processes) or junk is refused;
    events are their own request. *)
Example service_answers_only_its_own :
  service_request_of "tok" ["tok", "git", "/h/repos/calc", "ls-files"] = ServeOp (IoGit "/h/repos/calc" ["ls-files"]) /\
  service_request_of "tok" ["tok", "path_probe", "/h/repos/calc", "a.txt"] = ServeOp (IoPathProbe "/h/repos/calc" "a.txt") /\
  service_request_of "tok" ["tok", "events", "0"] = ServeEvents /\
  service_request_of "tok" ["bad", "git", "/h/repos/calc", "ls-files"] = ServeRefused /\
  service_request_of "tok" ["tok", "merge_reset", "calc"] = ServeRefused /\
  service_request_of "tok" ["tok", "llm_budget"] = ServeRefused /\
  service_request_of "tok" ["tok", "proc_kill", "3"] = ServeOp (IoProcKill "3") /\
  service_request_of "tok" ["tok", "job_expire", "3"] = ServeRefused /\
  service_request_of "tok" ["tok", "sign_vote", "prevote/1/0", "v"] = ServeRefused /\
  service_request_of "tok" ["tok", "store", "1"] = ServeRefused /\
  service_request_of "tok" ["tok", "send_all", "x"] = ServeRefused /\
  service_request_of "tok" ["tok", "write_file", "/etc/x", "y"] = ServeRefused /\
  service_request_of "tok" ["tok", "nonsense"] = ServeRefused /\
  service_request_of "tok" [] = ServeRefused.
Proof. repeat split; computed. Qed.

Example service_keeps_job_events_and_batches :
  service_kept [["job_bytes", "1", "x"], ["conn_offer", "0", "h"], ["peer_bytes", "1", "y"], ["ci_done", "2"]] =
    [["job_bytes", "1", "x"], ["ci_done", "2"]] /\
  service_batch 0 [] = ([], []) /\
  service_batch 0 [["a"], ["b"]] = ([["a"], ["b"]], []) /\
  service_address "192.168.105.1:39990" = ("192.168.105.1", "39990").
Proof. repeat split; computed. Qed.

(** ---- Never two votes at one slot ----
    An honest node signs at most one vote for a kind, height and round (a
    slot, [broadcast_key]). [sign_prog], which signs a vote ahead of its
    snapshot, signs only when the signed-vote table has nothing at its
    slot; and [broadcast_plan], once the slot has a vote, sends that vote
    again or nothing, never another, and never records another. A node
    the draw made Byzantine ("equivocate", "double-vote") is the test
    harness's, not an honest node. *)

(** what an action sends to the peers or records as sent *)
sends (a : output_action) (g : list string) : Prop :=
  match a with
  | SendPeer _ f => g = f
  | SendEveryone f => g = f
  | RememberBroadcast _ _ f alt => g = f \/ g = alt
  | _ => False
  end.

remembers_vote (a : output_action) : bool := match a with RememberVote _ _ _ => true | _ => false end.

(** an honest node's broadcast goes to every peer, the same message *)
Lemma honest_mode_is_all : forall fields, broadcast_mode "" fields = "all".
Proof.
  intros fields. unfold broadcast_mode.
  repeat match goal with |- context [match ?x with _ => _ end] => is_var x; destruct x end; reflexivity.
Qed.

Lemma honest_deliver : forall n f,
  broadcast_deliver "" n f =
    match f with _ :: ht :: _ => [RememberBroadcast ht "all" f f] | _ => [] end ++ [SendEveryone f].
Proof.
  intros n f. unfold broadcast_deliver. rewrite honest_mode_is_all. cbn [seq].
  destruct f as [| x [| ht rest]]; reflexivity.
Qed.

(** what an honest node delivers is its message, and records no vote *)
Lemma honest_deliver_sends_its_fields : forall n f a g,
  In a (broadcast_deliver "" n f) -> remembers_vote a = false /\ (sends a g -> g = f).
Proof.
  intros n f a g H. rewrite honest_deliver in H.
  destruct f as [| x [| ht rest]]; cbn in H;
    repeat (destruct H as [H | H]; [subst a; cbn; split; [reflexivity | intuition] |]); contradiction.
Qed.

(** The slot's first vote is recorded before it is sent. *)
Theorem first_vote_at_a_slot_is_recorded : forall n fields k ht r vid,
  broadcast_plan "" n fields (Some (k, ht, r, vid)) None None =
    RememberVote (broadcast_key k ht r) vid fields :: broadcast_deliver "" n fields.
Proof. reflexivity. Qed.

(** Once a slot has a vote, an honest node records no other there, and
    sends only the vote asked for when it is that same vote, or else the
    one stored, or nothing (it refuses, and says so). *)
Theorem honest_node_never_sends_a_second_vote : forall n fields k ht r vid v prior a g,
  In a (broadcast_plan "" n fields (Some (k, ht, r, vid)) (Some v) prior) ->
  remembers_vote a = false /\ (sends a g -> (v = vid /\ g = fields) \/ prior = Some g).
Proof.
  intros n fields k ht r vid v prior a g H. unfold broadcast_plan in H.
  destruct (seq v vid) eqn:E; cbn [negb andb seq] in H.
  - apply Stdlib.Strings.String.eqb_eq in E. subst v.
    destruct (honest_deliver_sends_its_fields n fields a g H) as [R S].
    split; [exact R | intro Hs; left; split; [reflexivity | exact (S Hs)]].
  - destruct prior as [saved |].
    + destruct H as [H | H]; [subst a; cbn; split; [reflexivity | intuition] |].
      destruct (honest_deliver_sends_its_fields n saved a g H) as [R S].
      split; [exact R | intro Hs; right; rewrite (S Hs); reflexivity].
    + destruct H as [H | H]; [subst a; cbn; split; [reflexivity | intuition] | contradiction].
Qed.

(** [sign_prog] looks the slot up first, and signs only when it is empty. *)
Theorem sign_prog_signs_only_an_empty_slot : forall ans fields slot vid f,
  In (IoSignVote slot vid f) (ntrace ans (sign_prog fields)) ->
  ans_found_one (ans (IoSignedVote slot)) = None.
Proof.
  intros ans fields slot vid f H. unfold sign_prog in H.
  destruct (broadcast_subject fields) as [[[[k ht] r] v] |]; [| contradiction].
  cbn [nbind nask ntrace] in H.
  destruct (ans_found_one (ans (IoSignedVote (broadcast_key k ht r)))) eqn:E; cbn in H.
  - destruct H as [H | H]; [discriminate H | contradiction].
  - destruct H as [H | [H | H]]; [discriminate H | | contradiction].
    injection H as Hs _ _. subst slot. exact E.
Qed.

(** and what it does, exactly: the look-up, then the signing only when
    the slot is empty *)
Theorem sign_prog_trace : forall ans k ht r x vid rest,
  seq k "done" = false ->
  let fields := k :: ht :: r :: x :: vid :: rest in
  let slot := broadcast_key k ht r in
  ntrace ans (sign_prog fields) =
    IoSignedVote slot ::
      match ans_found_one (ans (IoSignedVote slot)) with Some _ => [] | None => [IoSignVote slot vid fields] end.
Proof.
  intros ans k ht r x vid rest Hk fields slot. unfold sign_prog, fields. cbn [broadcast_subject]. rewrite Hk.
  cbn [nbind nask ntrace]. fold slot. destruct (ans_found_one (ans (IoSignedVote slot))); reflexivity.
Qed.

(** The signed-vote table keeps one vote a slot within a height: the one
    just signed is the one found, and the other slots keep theirs. *)
Lemma signed_slot_list_found : forall slot vid (fields : list string) (here : list (string * (string * list string))),
  nio_lookup slot ((slot, (vid, fields)) :: List.filter (fun v => negb (nio_eq (fst v) slot)) here) = Some (vid, fields).
Proof. intros. cbn. unfold nio_eq. rewrite Stdlib.Strings.String.eqb_refl. reflexivity. Qed.

Lemma lookup_filter_other : forall slot other (l : list (string * (string * list string))),
  other <> slot ->
  nio_lookup other (List.filter (fun v => negb (nio_eq (fst v) slot)) l) = nio_lookup other l.
Proof.
  intros slot other l Hne. induction l as [| [x w] rest IH]; [reflexivity |].
  cbn [List.filter fst]. destruct (nio_eq x slot) eqn:Ex; cbn [negb nio_lookup].
  - apply Stdlib.Strings.String.eqb_eq in Ex. subst x.
    assert (Hs : nio_eq slot other = false) by (apply Stdlib.Strings.String.eqb_neq; congruence).
    rewrite Hs. exact IH.
  - destruct (nio_eq x other); [reflexivity | exact IH].
Qed.

Lemma signed_slot_list_others : forall slot other vid (fields : list string) (here : list (string * (string * list string))),
  other <> slot ->
  nio_lookup other ((slot, (vid, fields)) :: List.filter (fun v => negb (nio_eq (fst v) slot)) here) = nio_lookup other here.
Proof.
  intros slot other vid fields here Hne. cbn [nio_lookup].
  assert (Hs : nio_eq slot other = false) by (apply Stdlib.Strings.String.eqb_neq; congruence). rewrite Hs.
  apply lookup_filter_other. exact Hne.
Qed.

(** ---- runtime/node.soma: the snapshot reads back ----
    [snapshot_of (snapshot_text c) = Some c]: a node that saves its
    consensus state and starts again from the file has the state it
    saved, its lock and valid value among it. The one premise is the
    reader's own: every number it reads back has at most 18 digits (what
    [num_opt] accepts), the state's numbers and each saved string's
    length. *)

From Stdlib Require DecimalNat.

Abbreviation sapp := Stdlib.Strings.String.append.

(** at most 18 decimal digits, as [num_opt] reads *)
Definition digits18 (n : nat) : Prop := slen (show n) <= 18.

Lemma sapp_nil_r : forall s, sapp s "" = s.
Proof. induction s as [|c s IH]; cbn; [reflexivity|now rewrite IH]. Qed.

Lemma sapp_assoc : forall a b c, sapp (sapp a b) c = sapp a (sapp b c).
Proof. induction a as [|x a IH]; intros; cbn; [reflexivity|now rewrite IH]. Qed.

Lemma slen_sapp : forall a b, slen (sapp a b) = slen a + slen b.
Proof. unfold slen. induction a as [|x a IH]; intros; cbn; [reflexivity|now rewrite IH]. Qed.

Lemma substr_at : forall t a b m, t = sapp a b -> substr t (slen a) m = substr b 0 m.
Proof. unfold substr, slen. intros t a b m ->. induction a as [|x a IH]; cbn; [reflexivity|exact IH]. Qed.

Lemma substr_prefix : forall a b, substr (sapp a b) 0 (slen a) = a.
Proof. unfold substr, slen. induction a as [|x a IH]; intros; cbn; [now destruct b|now rewrite IH]. Qed.

Lemma concat_empty_cons : forall a l,
  Stdlib.Strings.String.concat "" (a :: l) = sapp a (Stdlib.Strings.String.concat "" l).
Proof. intros a [|b l]; cbn; [symmetry; apply sapp_nil_r|reflexivity]. Qed.

Lemma counted_cons : forall x l, counted (x :: l) = sapp (show (slen x)) (SCons ":" (sapp x (counted l))).
Proof. intros. unfold counted. cbn [flat_map app]. rewrite !concat_empty_cons. reflexivity. Qed.

(** ---- [show] and [num_opt] ---- *)

Lemma digits_uint : forall d acc,
  digits (DecimalString.NilEmpty.string_of_uint d) acc = Nat.of_uint_acc d acc.
Proof.
  unfold digits, chars. induction d as [|d IH|d IH|d IH|d IH|d IH|d IH|d IH|d IH|d IH|d IH]; intro acc;
    [reflexivity|..];
    cbn [DecimalString.NilEmpty.string_of_uint Stdlib.Strings.String.list_ascii_of_string fold_left Nat.of_uint_acc];
    rewrite IH; f_equal; rewrite Nat.tail_mul_spec;
    match goal with |- context [nat_of_ascii ?c] =>
      let v := eval vm_compute in (nat_of_ascii c) in change (nat_of_ascii c) with v end;
    cbn [Nat.sub]; lia.
Qed.

Lemma uint_digits : forall d,
  forallb (fun c => (48 <=? nat_of_ascii c) && (nat_of_ascii c <=? 57)) (chars (DecimalString.NilEmpty.string_of_uint d)) = true.
Proof.
  unfold chars. induction d as [|d IH|d IH|d IH|d IH|d IH|d IH|d IH|d IH|d IH|d IH]; [reflexivity|..];
    cbn [DecimalString.NilEmpty.string_of_uint Stdlib.Strings.String.list_ascii_of_string forallb];
    rewrite IH; reflexivity.
Qed.

Lemma show_digits : forall n,
  forallb (fun c => (48 <=? nat_of_ascii c) && (nat_of_ascii c <=? 57)) (chars (show n)) = true.
Proof.
  intro n. change (show n) with (DecimalString.NilZero.string_of_uint (Nat.to_uint n)).
  destruct (Nat.to_uint n); [reflexivity|apply uint_digits ..].
Qed.

Lemma num_opt_nonempty : forall s, s <> SNil -> num_opt s = if short_digits s 18 then Some (num s) else None.
Proof. intros [|c s] H; [congruence|reflexivity]. Qed.

Lemma num_opt_uint : forall u, u <> Decimal.Nil ->
  slen (DecimalString.NilEmpty.string_of_uint u) <= 18 ->
  num_opt (DecimalString.NilEmpty.string_of_uint u) = Some (Nat.of_uint u).
Proof.
  intros u Hu Hs. rewrite num_opt_nonempty by (destruct u; cbn; congruence).
  unfold short_digits. rewrite uint_digits, (proj2 (Nat.leb_le _ _) Hs). cbn [andb].
  unfold num. rewrite digits_uint. reflexivity.
Qed.

(** a number shown reads back, when it has at most 18 digits *)
Lemma num_opt_show : forall n, digits18 n -> num_opt (show n) = Some n.
Proof.
  unfold digits18. intros n Hn. pose proof (DecimalNat.Unsigned.of_to n) as Hof.
  change (show n) with (DecimalString.NilZero.string_of_uint (Nat.to_uint n)) in *.
  destruct (Nat.to_uint n) eqn:E; [cbn in Hof; subst n; reflexivity|..];
    (rewrite <- Hof; apply num_opt_uint; [discriminate|exact Hn]).
Qed.

(** ---- [uncount] reads [counted]'s strings back ---- *)

Lemma substring_zero : forall s, Stdlib.Strings.String.substring 0 0 s = "".
Proof. now destruct s. Qed.

Lemma find_go_colon : forall d pre rest t fuel,
  t = sapp pre (sapp d (SCons ":" rest)) ->
  forallb (fun c => (48 <=? nat_of_ascii c) && (nat_of_ascii c <=? 57)) (chars d) = true ->
  slen d < fuel -> find_go fuel ":" t (slen pre) = Some (slen pre + slen d).
Proof.
  induction d as [|c d IH]; intros pre rest t fuel Ht Hd Hf; (destruct fuel as [|f]; [cbn in Hf; lia|]);
    cbn [find_go]; change (slen ":") with 1; change (substr ":" 0 1) with ":";
    rewrite !(substr_at t pre _ _ Ht).
  - cbn. rewrite substring_zero, Nat.add_0_r. reflexivity.
  - assert (Hx : substr (sapp (SCons c d) (SCons ":" rest)) 0 1 = SCons c "") by (cbn; now rewrite substring_zero).
    assert (Hc : seq (SCons c "") ":" = false).
    { apply Stdlib.Strings.String.eqb_neq. intro H. injection H as ->. discriminate Hd. }
    rewrite Hx, Hc. cbn [orb andb Nat.eqb].
    assert (Hs : S (slen pre) = slen (sapp pre (SCons c ""))) by (rewrite slen_sapp; cbn; lia).
    rewrite Hs. cbn in Hd. apply andb_prop in Hd as [_ Hd].
    rewrite (IH (sapp pre (SCons c "")) rest t f); [|rewrite Ht, sapp_assoc; reflexivity|exact Hd|unfold slen in *; cbn in Hf; lia].
    rewrite slen_sapp. unfold slen. cbn. f_equal. lia.
Qed.

Lemma find_str_colon : forall d pre rest t,
  t = sapp pre (sapp d (SCons ":" rest)) ->
  forallb (fun c => (48 <=? nat_of_ascii c) && (nat_of_ascii c <=? 57)) (chars d) = true ->
  find_str ":" t (slen pre) = Some (slen pre + slen d).
Proof.
  intros d pre rest t Ht Hd. unfold find_str.
  assert (Hl : slen t = slen pre + slen d + S (slen rest)) by (rewrite Ht, !slen_sapp; unfold slen in *; cbn in *; lia).
  replace (slen t <? slen ":" + slen pre) with false by (symmetry; apply Nat.ltb_ge; unfold slen in *; cbn in *; lia).
  apply (find_go_colon d pre rest); [exact Ht|exact Hd|]. cbn. lia.
Qed.

Lemma counted_length : forall l, length l <= slen (counted l).
Proof.
  induction l as [|x l IH]; [unfold slen in *; cbn in *; lia|]. rewrite counted_cons, !slen_sapp. cbn. rewrite slen_sapp. lia.
Qed.

Lemma uncount_counted : forall l t pre acc fuel,
  t = sapp pre (counted l) -> Forall (fun x => digits18 (slen x)) l -> length l < fuel ->
  uncount fuel t (slen pre) acc = Some (rev acc ++ l).
Proof.
  induction l as [|x l IH]; intros t pre acc fuel Ht Hl Hf; (destruct fuel as [|f]; [cbn in Hf; lia|]); cbn [uncount].
  - assert (Hp : slen t = slen pre) by (rewrite Ht; cbn; rewrite sapp_nil_r; reflexivity).
    rewrite Hp, Nat.leb_refl, Nat.eqb_refl, app_nil_r. reflexivity.
  - apply Forall_cons_iff in Hl as [Hx Hr]. rewrite counted_cons in Ht.
    set (d := show (slen x)) in *. set (rest := sapp x (counted l)) in *.
    assert (Hlen : slen t = slen pre + slen d + S (slen x + slen (counted l)))
      by (rewrite Ht, !slen_sapp; unfold rest;
          change (slen (SCons ":" (sapp x (counted l)))) with (S (slen (sapp x (counted l)))); rewrite slen_sapp; lia).
    replace (slen t <=? slen pre) with false by (symmetry; apply Nat.leb_gt; lia).
    rewrite (find_str_colon d pre rest t Ht (show_digits _)).
    replace (slen pre + slen d - slen pre) with (slen d) by lia.
    assert (Hn : num_opt d = Some (slen x)) by exact (num_opt_show _ Hx).
    rewrite (substr_at t pre _ _ Ht), substr_prefix, Hn.
    replace (slen t <? slen pre + slen d + 1 + slen x) with false by (symmetry; apply Nat.ltb_ge; lia).
    set (pre' := sapp pre (sapp d ":")).
    assert (Ht' : t = sapp pre' (sapp x (counted l))) by (subst pre' rest; rewrite Ht, !sapp_assoc; reflexivity).
    assert (Hp' : slen pre + slen d + 1 = slen pre') by (subst pre'; rewrite !slen_sapp; unfold slen in *; cbn in *; lia).
    rewrite Hp', (substr_at t pre' _ _ Ht'), substr_prefix.
    assert (Hp'' : slen pre' + slen x = slen (sapp pre' x)) by (rewrite slen_sapp; reflexivity).
    rewrite Hp'', (IH t (sapp pre' x)); [|rewrite Ht', sapp_assoc; reflexivity|exact Hr|cbn in Hf; lia].
    cbn [rev]. rewrite <- app_assoc. reflexivity.
Qed.

(** ---- the state back ---- *)

Lemma kind_of_name_reads_kind_name : forall k, kind_of_name (kind_name k) = Some k.
Proof. destruct k; reflexivity. Qed.

Lemma msgs_of_frames_reads_log : forall log,
  Forall (fun m => digits18 (mh m) /\ digits18 (mr m) /\ digits18 (vr m)) log ->
  msgs_of_frames (map msg_frame log) = Some log.
Proof.
  induction log as [|m log IH]; intro H; [reflexivity|]. inversion H as [|? ? (H1 & H2 & H3) Hr]; subst.
  cbn [map msgs_of_frames]. unfold msg_frame at 1. cbn [msg_of_frame].
  rewrite kind_of_name_reads_kind_name, (num_opt_show _ H1), (num_opt_show _ H2), (num_opt_show _ H3), (IH Hr).
  destruct m; reflexivity.
Qed.

(** what the reader asks of a state: each number it reads back has at most
    18 digits *)
Definition snapshot_fits (c : consensus_state) : Prop :=
  digits18 (consensus.height c) /\ digits18 (consensus.round c) /\ digits18 (consensus.step c) /\
  digits18 (consensus.lockr c) /\ digits18 (consensus.validr c) /\ digits18 (consensus.block_ms c) /\
  Forall (fun m => digits18 (mh m) /\ digits18 (mr m) /\ digits18 (vr m)) (consensus.log c) /\
  Forall (fun s => digits18 (slen s)) (nio_frame_lists (snapshot_frames c)).

Lemma snapshot_parse_reads_text : forall c, snapshot_fits c -> snapshot_parse (snapshot_text c) = Some c.
Proof.
  intros c (Hh & Hr & Hs & Hlr & Hvr & Hbm & Hlog & Hw). unfold snapshot_parse.
  assert (Hu : uncount (slen (snapshot_text c) + 1) (snapshot_text c) 0 [] = Some (nio_frame_lists (snapshot_frames c))).
  { apply (uncount_counted _ _ "" [] _); [reflexivity|exact Hw|].
    pose proof (counted_length (nio_frame_lists (snapshot_frames c))) as Hc. unfold snapshot_text.
    rewrite Nat.add_1_r. apply Nat.lt_succ_r. exact Hc. }
  rewrite Hu.
  rewrite nio_lists_reads_frames. unfold snapshot_frames. cbn [app].
  rewrite Stdlib.Strings.String.eqb_refl. cbn [negb].
  rewrite (num_opt_show _ Hh), (num_opt_show _ Hr), (num_opt_show _ Hs), (num_opt_show _ Hlr), (num_opt_show _ Hvr),
    (num_opt_show _ Hbm), (msgs_of_frames_reads_log _ Hlog).
  destruct c; reflexivity.
Qed.

(** A node that saves its consensus state reads back the same state: its
    lock, valid value, round and step, and every vote it remembers. *)
Theorem snapshot_text_reads_back : forall c, snapshot_fits c -> snapshot_of (snapshot_text c) = Some c.
Proof.
  intros c Hc. unfold snapshot_of. rewrite (snapshot_parse_reads_text c Hc).
  unfold seq. rewrite Stdlib.Strings.String.eqb_refl. reflexivity.
Qed.

(** The premise holds of the states a node keeps: a new chain's, for one. *)
Example new_consensus_fits : snapshot_fits (new_consensus "a" ["a", "b", "c", "d"] 1).
Proof.
  unfold snapshot_fits, digits18. vm_compute.
  repeat match goal with
  | |- _ /\ _ => split
  | |- Forall _ [] => apply Forall_nil
  | |- Forall _ (_ :: _) => apply Forall_cons
  | |- _ <= _ => lia
  end.
Qed.

Theorem grok_tokens_require_a_bounded_envelope : forall text tokens,
  grok_envelope_tokens text = Some tokens ->
  (slen text <=? num job_output_limit) = true /\ shallow_json "8" "16384" text = true.
Proof.
  intros text tokens H. unfold grok_envelope_tokens in H.
  destruct ((slen text <=? num job_output_limit) && shallow_json "8" "16384" text) eqn:E;
    [apply Bool.andb_true_iff in E; exact E|discriminate H].
Qed.

Theorem retained_peer_chunks_fit_aggregate_budget : forall st cid chunks,
  peer_kept_fits st cid chunks = true ->
  peer_other_buffer_bytes st cid + chunks_len chunks <= num peer_buffer_byte_limit.
Proof.
  intros st cid chunks H. unfold peer_kept_fits in H.
  exact (budget_fits_bound (peer_other_buffer_bytes st cid) (chunks_len chunks) (num peer_buffer_byte_limit) H).
Qed.

Example provider_holds_are_bounded :
  limit_wait (Some 999999999%float) 900%float = 7200%float /\
  limit_wait (Some 7195%float) 900%float = 7200%float /\
  limit_wait None 999999999%float = 7200%float /\
  limit_wait None (-1)%float = 900%float /\
  limit_wait_adjusted (Some 999999999%float) 900%float = true /\
  limit_wait_adjusted (Some 300%float) 900%float = false /\
  num_after digits_float "9999999999999999999" 0 = None.
Proof. repeat split; computed. Qed.
