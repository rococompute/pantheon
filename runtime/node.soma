(** A node: consensus, the market it orders blocks for, its agent, and a
    pool of transactions waiting for a block. [step] is everything the shell
    runs: it takes one event and gives back what to do. *)
Import core.util runtime.nodeio core.consensus core.market core.agent app.cli prompts.context.
(* [float] and its literals, OCaml's (Soma.OCaml) *)
From Soma Require Import OCaml.
From Stdlib Require Import Ascii.

Record node_state := { cons : consensus_state; mkt : obj; ag : obj; pool : list string; live : bool;
                       pbufs : list (string * list string); jbufs : list (string * list string) }.

with_cons (c : node_state) (v : consensus_state) : node_state :=
  {| cons := v; mkt := mkt c; ag := ag c; pool := pool c; live := live c; pbufs := pbufs c; jbufs := jbufs c |}.

with_mkt (c : node_state) (v : obj) : node_state :=
  {| cons := cons c; mkt := v; ag := ag c; pool := pool c; live := live c; pbufs := pbufs c; jbufs := jbufs c |}.

with_ag (c : node_state) (v : obj) : node_state :=
  {| cons := cons c; mkt := mkt c; ag := v; pool := pool c; live := live c; pbufs := pbufs c; jbufs := jbufs c |}.

with_pool (c : node_state) (v : list string) : node_state :=
  {| cons := cons c; mkt := mkt c; ag := ag c; pool := v; live := live c; pbufs := pbufs c; jbufs := jbufs c |}.

with_live (c : node_state) (v : bool) : node_state :=
  {| cons := cons c; mkt := mkt c; ag := ag c; pool := pool c; live := v; pbufs := pbufs c; jbufs := jbufs c |}.

with_pbufs (c : node_state) (v : list (string * list string)) : node_state :=
  {| cons := cons c; mkt := mkt c; ag := ag c; pool := pool c; live := live c; pbufs := v; jbufs := jbufs c |}.

(** A peer connection's buffered read chunks live here, keyed by the
    connection id the shell names: the shell only reads the bytes. *)
peer_buffer (c : node_state) (cid : string) : list string := get_or [] cid (pbufs c).

peer_forget (c : node_state) (cid : string) : node_state :=
  with_pbufs c (filter (fun kv => negb (seq cid (fst kv))) (pbufs c)).

peer_remember (c : node_state) (cid : string) (kept : list string) : node_state :=
  match kept with
  | [] => peer_forget c cid
  | _ => with_pbufs c (put cid kept (pbufs c))
  end.

(** Process output belongs to Soma, separately from peer line buffers. *)
with_jbufs (c : node_state) (v : list (string * list string)) : node_state :=
  {| c with jbufs := v |}.

job_buffer (c : node_state) (id : string) : list string := get_or [] id (jbufs c).

job_forget (c : node_state) (id : string) : node_state :=
  with_jbufs c (filter (fun kv => negb (seq id (fst kv))) (jbufs c)).

job_remember (c : node_state) (id : string) (chunks : list string) : node_state :=
  match chunks with
  | [] => job_forget c id
  | _ => with_jbufs c (put id chunks (jbufs c))
  end.

(** A snapshot from a completed height may remain if the process crashed
    after syncing blocks.log. Never roll the replayed chain back. *)
restore_cons (n : node_state) (c : consensus_state) : node_state :=
  if height c =? height (cons n) then with_cons n c else n.

empty_node : node_state :=
  {| cons := new_consensus "" [] 1; mkt := new_market []; ag := new_agent ""; pool := []; live := false;
     pbufs := []; jbufs := [] |}.

(** How far ahead of an agent's next nonce the pool looks, and how many of
    one agent's transactions it keeps (docs/SECURITY-REVIEW-2.md P-5). A block
    only takes the next nonce, so a transaction further ahead could sit in
    the pool for good; a flood of them would fill it. *)
nonce_window : nat := 4.
max_pool_per_agent : nat := 8.

(** OCaml's portable signal numbers, as a job's wait status reports them:
    Sys.sigkill, sigterm, sigsegv, sigabrt and sigint, the same on every
    platform (OCaml's own numbering, not the OS's). *)
job_signal_codes : list string := ["-7", "-11", "-10", "-1", "-6"].

(** The cap on what a job may print, 4 MB (16 times a transaction's). *)
job_output_limit : string := "4194304".

(** a transaction worth keeping: well formed, for a nonce not yet used and
    at most nonce_window ahead of the sender's next *)
poolable (m : obj) (raw : string) : bool :=
  match decode_tx m raw with
  | a :: n :: _ => (nonce_of m a <? num n) && (num n <=? nonce_of m a + nonce_window)
  | _ => false
  end.

tx_sender (m : obj) (raw : string) : string := match decode_tx m raw with a :: _ => a | _ => "" end.

(** how many of the pool's transactions agent a sent *)
pooled_by (m : obj) (p : list string) (a : string) : nat := length (filter (fun raw => seq (tx_sender m raw) a) p).

and_status (n : node_state) (outs : list (list string)) : node_state * list (list string) :=
  (n, outs ++ [("status" :: status_lines (mkt n) ++ [append "pool " (show (length (pool n)))])]).

(** A decided block: apply it, drop what it used from the pool, and let the
    agent react. *)
on_decided (n : node_state) (h : nat) (txs : list string) : node_state * list (list string) :=
  let was := finished (mkt n) in
  let (m, o) := apply_block (mkt n) h txs in
  (* the market finished in this block: the node stops 10 seconds on *)
  let o := if finished m && negb was
           then o ++ [["log", append "the market finished at height " (append (show h) ": every agent, as leader, found no more tasks. This node stops in 10 seconds")], ["finish", "10000"]]
           else o in
  (* M-3: consensus counts the next height on that height's roster *)
  let n := with_cons n (enter_roster (cons n) (roster_at (agents m) (roster_changes m) (h + 1))) in
  let n := with_pool (with_mkt n m) (filter (fun raw => negb (mem raw txs) && poolable m raw) (pool n)) in
  if live n then
    let (a, o') := tick (ag n) m in
    and_status (with_ag n a) (o ++ o')
  else (n, o).

Fixpoint decisions (outs : list (list string)) : list (nat * list string) :=
  match outs with
  | ("decided" :: h :: txs) :: rest => (num h, txs) :: decisions rest
  | _ :: rest => decisions rest
  | [] => []
  end.

(** Runs consensus to rest, applying each block it decides before going on,
    so that the next height's proposals are judged against the new state. *)
Fixpoint drive (fuel : nat) (n : node_state) (outs : list (list string)) : node_state * list (list string) :=
  match fuel with
  | 0 => (n, outs)
  | Succ f =>
      let m := mkt n in
      let (c, o) := consensus.settle 64 (cons n) (block_ok m) (build_block m (pool n)) [] in
      let n := with_cons n c in
      match decisions o with
      | (h, txs) :: _ => let (n, o') := on_decided n h txs in drive f n (outs ++ o ++ o')
      | [] => (n, outs ++ o)
      end
  end.

consensus_event (n : node_state) (r : consensus_state * list (list string)) : node_state * list (list string) :=
  let (c, o) := r in
  let (n, o') := drive 8 (with_cons n c) [] in
  (n, o ++ o').

set_agent (n : node_state) (k : string) (v : Any) : node_state := with_ag n (setf (ag n) k v).

agent_event (n : node_state) (r : obj * list (list string)) : node_state * list (list string) :=
  let (a, o) := r in (with_ag n a, o).

step (n : node_state) (ev : list string) : node_state * list (list string) :=
  match ev with
  (* setup, before "start": genesis, then the blocks already on disk *)
  | "agents" :: names =>
      let c := cons n in
      (with_cons (with_mkt n (new_market names)) {| c with nodes := names |}, [])
  | ["tip", a, t] => (with_mkt n (setf (mkt n) "tips" (put a t (tips (mkt n)))), [])
  | ["chain", id] => (with_mkt n (setf (mkt n) "chain" id), [])
  | ["key", a, size, kn, ke] =>
      (with_mkt n (setf (mkt n) "keys" (put a [size, kn, ke] (getf (mkt n) "keys" : list (string * list string)))), [])
  | ["param", k, v] =>
      let c := cons n in
      if seq k "block_ms" then (with_cons n {| c with block_ms := num v |}, [])
      else (with_mkt n (setf (mkt n) "params" (put k (num v) (params (mkt n)))), [])
  | ["repo", r, tree] => (with_mkt n (setf (mkt n) "repos" (put r tree (repos (mkt n)))), [])
  | ["exclude", a, r] => (with_mkt n (setf (mkt n) "excluded" (excluded (mkt n) ++ [(a, r)] : list (string * string))), [])
  | ["me", who] => let c := cons n in (with_ag (with_cons n {| c with consensus.me := who |}) (setf (ag n) "me" who), [])
  | ["agent", "goal", line] => (set_agent n "goal" (goal (ag n) ++ [line] : Any), [])
  | ["agent", "deny", p] => (set_agent n "deny" (deny (ag n) ++ [p] : Any), [])
  | ["agent", "bid_window", v] => (set_agent n "bid_window" (num v : Any), [])
  | ["agent", k, v] => (set_agent n k (v : Any), [])
  | "replay" :: h :: txs =>
      let (n, o) := on_decided n (num h) txs in
      let c := cons n in
      (with_cons n {| c with height := num h + 1; log := ([] : list msg) |}, o)
  | ["start"] =>
      let n := with_live n true in
      let h := height (cons n) in
      let (a, o) := tick (ag n) (mkt n) in
      if (round (cons n) =? 0) && (step (cons n) =? 0) && (lockr (cons n) =? 0) then
        and_status (with_ag n a) (o ++ [["height", show h], timer "commit" h 0 0])
      else and_status (with_ag n a) (o ++ [["height", show h]] ++ resume_timers (cons n))
  (* running *)
  | "msg" :: from :: fields => consensus_event n (receive (cons n) from fields)
  | "timeout" :: fields => consensus_event n (timeout (cons n) fields (build_block (mkt n) (pool n)))
  | ["tx", raw] =>
      if mem raw (pool n) || negb (poolable (mkt n) raw) || (500 <=? length (pool n))
         || (max_pool_per_agent <=? pooled_by (mkt n) (pool n) (tx_sender (mkt n) raw)) then (n, [])
      else (with_pool n (pool n ++ [raw]), [])
  | "local_tx" :: fields => agent_event n (flush (enqueue (ag n) fields) (mkt n))
  | "llm_reply" :: id :: kv => agent_event n (answered (ag n) (mkt n) id kv)
  | "check_result" :: id :: kv => agent_event n (answered (ag n) (mkt n) id kv)
  | ["llm_error", id, why] => (with_ag n (failed (ag n) id), [["log", append "model call failed: " why]])
  | ["finished"] => (n, [["exit", "0"]])
  | _ => (n, [])
  end.

(** ---- Step 2 (docs/SHELL-IN-SOMA.md): the node loop in Soma ----
    The loop holds the state and drives [step]; the shell once bound
    [node_open] (I/O setup; gone: runtime/node_net.soma), startup data, [events] (one select turn),
    smaller output bindings (every output case is decided in Soma),
    the snapshot ([IoSnapshotSave]), [note_refused] and [forever]. An effect is a field list: ["perform"; output...],
    ["save_snapshot"], ["sign"; vote...] or ["refuse"; raw]. [order_effects] is pure: it takes
    the event, the state before and after [step], and the outputs, and puts
    decided outputs first, then the votes signed ([sign_effects]), then
    the snapshot when consensus changed, then the rest. A transaction [step] refused leaves the pool unchanged and is
    remembered; an accepted one enters the pool. *)

Fixpoint eq_strs (a b : list string) : bool :=
  match a, b with
  | [], [] => true
  | x :: r, y :: s => seq x y && eq_strs r s
  | _, _ => false
  end.

msg_eq (a b : msg) : bool :=
  kind_eq (kd a) (kd b) && seq (frm a) (frm b) && (mh a =? mh b) && (mr a =? mr b)
  && (vr a =? vr b) && seq (vid a) (vid b) && eq_strs (value a) (value b).

Fixpoint eq_msgs (a b : list msg) : bool :=
  match a, b with
  | [], [] => true
  | x :: r, y :: s => msg_eq x y && eq_msgs r s
  | _, _ => false
  end.

cons_eq (a b : consensus_state) : bool :=
  seq (consensus.me a) (consensus.me b) && eq_strs (consensus.nodes a) (consensus.nodes b) && (consensus.height a =? consensus.height b)
  && (consensus.round a =? consensus.round b) && (consensus.step a =? consensus.step b) && (consensus.lockr a =? consensus.lockr b)
  && eq_strs (consensus.lockv a) (consensus.lockv b) && (consensus.validr a =? consensus.validr b) && eq_strs (consensus.validv a) (consensus.validv b)
  && eq_msgs (consensus.log a) (consensus.log b) && eq_strs (consensus.once a) (consensus.once b) && (consensus.block_ms a =? consensus.block_ms b).

(** ---- the consensus snapshot (U-1) ----
    consensus.state's text, Soma's own, so the binary and a unikernel
    save and read the same bytes through [IoSnapshotSave] and
    [IoSnapshotLoad]: the state as frames of strings ([nio_frame_lists]),
    each string written as its length in decimal, ":" and itself. A
    header names the format. Reading it back is strict: the text must be
    exactly what [snapshot_text] writes for the state it reads, or it is
    malformed and the node refuses to start, since a node that signed
    votes must not start without its lock. *)
snapshot_header : string := "pantheon-consensus 1".

kind_of_name (s : string) : option kind :=
  if seq s "proposal" then Some Proposal else if seq s "prevote" then Some Prevote
  else if seq s "precommit" then Some Precommit else if seq s "done" then Some Done else None.

msg_frame (m : msg) : list string :=
  kind_name (kd m) :: frm m :: show (mh m) :: show (mr m) :: show (vr m) :: vid m :: value m.

snapshot_frames (c : consensus_state) : list (list string) :=
  [[snapshot_header], [consensus.me c], consensus.nodes c,
   [show (consensus.height c), show (consensus.round c), show (consensus.step c),
    show (consensus.lockr c), show (consensus.validr c), show (consensus.block_ms c)],
   consensus.lockv c, consensus.validv c, consensus.once c] ++ map msg_frame (consensus.log c).

counted (l : list string) : string :=
  Stdlib.Strings.String.concat "" (flat_map (fun x => [show (slen x), ":", x]) l).

snapshot_text (c : consensus_state) : string := counted (nio_frame_lists (snapshot_frames c)).

(** [counted]'s strings back, by offset; None unless they end exactly at
    the end of the text *)
Fixpoint uncount (fuel : nat) (t : string) (i : nat) (acc : list string) : option (list string) :=
  match fuel with
  | 0 => None
  | S f =>
      if slen t <=? i then (if i =? slen t then Some (rev acc) else None) else
      match find_str ":" t i with
      | None => None
      | Some j =>
          match num_opt (substr t i (j - i)) with
          | Some n => if slen t <? j + 1 + n then None else uncount f t (j + 1 + n) (substr t (j + 1) n :: acc)
          | None => None
          end
      end
  end.

msg_of_frame (l : list string) : option msg :=
  match l with
  | k :: f :: h :: r :: v :: id :: value =>
      match kind_of_name k, num_opt h, num_opt r, num_opt v with
      | Some kd, Some h, Some r, Some v => Some {| kd := kd; frm := f; mh := h; mr := r; vr := v; vid := id; value := value |}
      | _, _, _, _ => None
      end
  | _ => None
  end.

Fixpoint msgs_of_frames (l : list (list string)) : option (list msg) :=
  match l with
  | [] => Some []
  | x :: r => match msg_of_frame x, msgs_of_frames r with Some m, Some ms => Some (m :: ms) | _, _ => None end
  end.

snapshot_parse (t : string) : option consensus_state :=
  match uncount (slen t + 1) t 0 [] with
  | None => None
  | Some w =>
      match nio_lists w with
      | [hdr] :: [who] :: nodes :: [h, r, st, lr, vr, bm] :: lockv :: validv :: once :: msgs =>
          if negb (seq hdr snapshot_header) then None else
          match num_opt h, num_opt r, num_opt st, num_opt lr, num_opt vr, num_opt bm, msgs_of_frames msgs with
          | Some h, Some r, Some st, Some lr, Some vr, Some bm, Some log =>
              Some {| consensus.me := who; consensus.nodes := nodes; consensus.height := h; consensus.round := r;
                      consensus.step := st; consensus.lockr := lr; consensus.lockv := lockv; consensus.validr := vr;
                      consensus.validv := validv; consensus.log := log; consensus.once := once; consensus.block_ms := bm |}
          | _, _, _, _, _, _, _ => None
          end
      | _ => None
      end
  end.

snapshot_of (t : string) : option consensus_state :=
  match snapshot_parse t with
  | Some c => if seq (snapshot_text c) t then Some c else None
  | None => None
  end.

snapshot_malformed_text : string :=
  "consensus.state is malformed or from an older Pantheon: a node that signed votes can't start without its lock. Restore it, or start a new chain".

is_decided (o : list string) : bool :=
  match o with "decided" :: _ => true | _ => false end.

(** The votes among the outputs, to sign before the snapshot is saved (a
    [done] is a block, not a vote, as [broadcast_subject] has it). The
    snapshot says a vote was cast, and the node, started again, goes on
    to the next round without casting it again: signed first, the vote is
    in signed.log whenever the snapshot says so, and a node started again
    sends it ([resume_signed_prog]). Saved first, a node stopped between
    the two had a vote it never signed or sent, and with exactly a quorum
    up the others waited for it in the round it left. *)
sign_effects (outs : list (list string)) : list (list string) :=
  flat_map (fun o => match o with
    | "broadcast" :: (k :: _ :: _ :: _ :: _ :: _) as fields => if seq k "done" then [] else [("sign" :: fields)]
    | _ => [] end) outs.

order_effects (ev : list string) (before after : node_state) (outs : list (list string)) : list (list string) :=
  let refused :=
    match ev with
    | ["tx", raw] => if mem raw (pool after) && negb (mem raw (pool before)) then [] else [["refuse", raw]]
    | _ => []
    end in
  let decided := map (fun o => "perform" :: o) (filter is_decided outs) in
  let save := if cons_eq (cons before) (cons after) then [] else [["save_snapshot"]] in
  let rest := map (fun o => "perform" :: o) (filter (fun o => negb (is_decided o)) outs) in
  refused ++ decided ++ sign_effects outs ++ save ++ rest.

(** Step 4: classify outputs in Soma. Every case has its own small
    bindings; an output no case names does nothing, as the shell's old
    handle did with it. *)
Inductive output_request :=
| SetTimer (ms : string) (event : list string)
| WriteLog (text : string)
| RecordLeader (previous digest entry : string)
| RevealLink (term tip : string)
| DecidedBlock (height : string) (txs : list string)
| SetHeight (height : string)
| CatchupPeer (who first : string)
| WriteStatus (lines : list string)
| SubmitTransaction (nonce : string) (fields : list string)
| Broadcast (fields : list string)
| CheckRequest (id repo head : string) (edits : list string)
| MergeRequest (r v tree bid task bidder spec : string) (edits : list string)
| LlmRequest (id kind prompt : string) (ctx : list string)
(* the market finished: stop after ms, so peers still get this node's votes *)
| FinishNode (ms : string)
| ExitNode (code : string)
| LegacyOutput (out : list string).

plan_output (out : list string) : output_request :=
  match out with
  | ["timer", name, h, r, ms] => SetTimer ms ["timeout", name, h, r]
  | ["log", text] => WriteLog text
  | ["reveal", t, tip] => RevealLink t tip
  | "decided" :: h :: txs => DecidedBlock h txs
  | ["height", h] => SetHeight h
  | ["behind", who, first] => CatchupPeer who first
  | "status" :: lines => WriteStatus lines
  | "submit" :: nonce :: fields => SubmitTransaction nonce fields
  | "broadcast" :: fields => Broadcast fields
  | "check" :: id :: r :: head :: edits => CheckRequest id r head edits
  | "merge" :: r :: v :: tree :: bid :: task :: bidder :: spec :: edits =>
      MergeRequest r v tree bid task bidder spec edits
  | "llm" :: id :: kind :: prompt :: ctx => LlmRequest id kind prompt ctx
  | ["leader-record", previous, digest, entry] => RecordLeader previous digest entry
  | ["finish", ms] => FinishNode ms
  | ["exit", code] => ExitNode code
  | _ => LegacyOutput out
  end.

Inductive output_action :=
| LogAction (text : string)
| QueueAction (event : list string)
| StoreAction (height : string) (txs : list string)
| RememberPeer (who first : string) (now : float)
| ReadPeerBlock (who : string) (height : nat)
| SendSigned (who : string) (height : nat)
| PublishTransaction (nonce : string) (fields : list string) (message : option string)
| MarkNonceFlood
| RememberVote (slot vid : string) (fields : list string)
| RememberBroadcast (height kind : string) (fields alt : list string)
| SendPeer (index : string) (fields : list string)
| SendEveryone (fields : list string).

(** The node's operations, [node_op], and its programs, [nprog], are
    runtime/nodeio.soma's: an interface with no shell under it, so Sandbox can
    interpret the same values (U-1). *)

(** Eligibility is decided before any check process or temporary checkout
    is created. Preserve the queued fact and scope-over-flag precedence. *)
check_request_op (id repo head : string) (edits denied excluded : list string) : node_op :=
  let outside := mem repo excluded in
  if mem repo denied || outside then
    IoQueue ["check_unchecked_repo", id, repo, (if outside then "true" else "false")]
  else IoCheck id repo head edits.

(** A missing served record uses false as presence, not effect failure.
    The raw timestamp result is never passed through display formatting. *)
served_result (answer : nanswer) : option float :=
  if fst answer then Some (ans_float answer) else None.
(** The output actions that are a single operation, and the operation. *)
action_io (action : output_action) : option node_op :=
  match action with
  | LogAction text => Some (IoLog text)
  | QueueAction ev => Some (IoQueue ev)
  | SendPeer index fields => Some (IoSendPeer index fields)
  | SendEveryone fields => Some (IoSendAll fields)
  | StoreAction height txs => Some (IoStore height txs)
  | RememberVote slot vid fields => Some (IoSignVote slot vid fields)
  | RememberBroadcast height kind fields alternate => Some (IoRememberBroadcast height kind fields alternate)
  | RememberPeer who first now => Some (IoMarkServed who first (float_wire now))
  | MarkNonceFlood => Some IoMarkNonceFlood
  | _ => None
  end.

(** Outputs that are unconditionally a single operation (timer and log).
    Check requests first consult the eligibility metadata. *)
output_io (out : list string) : option node_op :=
  match plan_output out with
  | SetTimer ms ev => Some (IoTimer ms ev)
  | WriteLog text => Some (IoLog text)
  | RecordLeader previous digest entry => Some (IoLeaderRecord previous digest entry)
  | _ => None
  end.

Fixpoint draw_link (n : nat) (secret : string) : string :=
  match n with
  | 0 => secret
  | Succ k => draw_link k (sha256 secret)
  end.

(** The agreed tip counts accepted reveals, whereas the term counts draws,
    including ones whose link was lost or withheld. Find exactly its next
    preimage in our bounded chain. Nothing local advances on an attempted
    send: replay and a session restart select the same outstanding link. *)
Fixpoint draw_preimage (fuel : nat) (candidate tip : string) : option string :=
  match fuel with
  | 0 => None
  | Succ remaining =>
      let next := sha256 candidate in
      if seq next tip then Some candidate else draw_preimage remaining next tip
  end.

reveal_plan (byz limit secret term tip : string) : list output_action :=
  let t := num term in
  if seq byz "withhold" && (t mod 2 =? 1) then
    [LogAction (append "FAULT INJECTION: holding back my link for draw " (show t))]
  (* As before, never publish the root secret itself: the usable links are
     H(secret) through H^(limit-1)(secret). Exhaustion is a property of the
     accepted tip, not how many draws have passed. *)
  else match draw_preimage (num limit - 1) (sha256 secret) tip with
    | Some link => [QueueAction ["local_tx", "reveal", link]]
    | None => []
    end.

decided_plan (h : string) (txs : list string) (stored : option (list string))
    : list output_action :=
  match stored with
  | None => [StoreAction h txs]
  | Some _ => []
  end.

(** The inclusive old bound [first .. min (current-1) (first+50)]
    contains at most 51 heights. A request at or above current is empty. *)
catchup_heights (first current : nat) : list nat :=
  List.seq first (min 51 (current - first)).

catchup_due (now : float) (last : option float) : bool :=
  match last with
  | None => true
  | Some t => negb (PrimFloat.ltb (PrimFloat.sub now t) 2%float)
  end.

(** Remember first, including silent/absent peers and empty ranges. A
    duplicate in the two-second window performs no writes or block reads.

    A peer one height behind also gets this node's own messages at its
    height again, as they were signed (signed.log's). The blocks alone,
    as [done], need f + 1 senders: a node that decided the height and
    whose precommit never reached the others (lost, or the node stopped
    after saving it and before sending it, then booted again and decided
    from its snapshot) is the only one ahead, and with exactly a quorum
    running the chain would stop. Its precommit completes the others'
    quorum instead, and consensus decides on it as on any. A peer two or
    more behind needs none of this: a quorum decided the height after,
    so f + 1 honest nodes are past this one and send its block. Sent only
    one height ahead, two nodes past a height don't keep sending each
    other its messages. *)
catchup_plan (who first current : string) (now : float) (last : option float)
    (has_peer silent : bool) : list output_action :=
  if catchup_due now last then
    RememberPeer who first now ::
    (if has_peer && negb silent then
       map (ReadPeerBlock who) (catchup_heights (num first) (num current)) ++
       (if num current =? Succ (num first) then [SendSigned who (num first)] else [])
     else [])
  else [].

catchup_send (who : string) (height : nat) (block : option (list string))
    : option (string * list string) :=
  match block with
  | None => None
  | Some txs => Some (who, "done" :: show height :: "0" :: "0" :: hash_list txs :: txs)
  end.

(** Status formatting is pure; the shell only reads metadata, converts a
    timestamp to local clock text, and atomically writes the result. *)
status_limit_active (now until : float) : bool := PrimFloat.ltb now until.

status_output (lines : list string) (heads bad : list (string * string))
    (limited : bool) (backend until held reason : string) : string :=
  let heads := map (fun p => append "checkout " (append (fst p) (append " " (snd p)))) heads in
  let bad := map (fun p => append "DIVERGED " (append (fst p) (append " at merge " (snd p)))) bad in
  let lim := if limited then
    [append "LIMIT " (append backend (append " until " (append until
      (append ", " (append held (append " model requests held: " reason))))))]
    else [] in
  append (Stdlib.Strings.String.concat newline (lines ++ heads ++ bad ++ lim)) newline.

submission_message (fields : list string) : string :=
  append "sending " (Stdlib.Strings.String.concat " "
    (map (fun f => if 60 <? slen f then append (take_str 60 f) "..." else f) fields)).

(** One ordinary transaction first; a future-nonce fault runs only once,
    marks that fact before logging/signing, and sends offsets 4 through 603. *)
submission_plan (byz : string) (flooded : bool) (nonce : string) (fields : list string)
    : list output_action :=
  PublishTransaction nonce fields (Some (submission_message fields)) ::
  (if seq byz "future-nonce" && negb flooded then
     MarkNonceFlood :: LogAction "FAULT INJECTION: flooding 600 future-nonce transactions" ::
     map (fun k => PublishTransaction (show (num nonce + k)) ["withdraw", "0"] None) (List.seq 4 600)
   else []).

submission_send (byz raw : string) : option (list string) :=
  if seq byz "silent" then None else Some ["tx", raw].

(** A vote is guarded only when it names a kind, height, round, valid-round
    and value id. [done] is a block, not a vote, so it is never guarded. *)
broadcast_subject (fields : list string) : option (string * string * string * string) :=
  match fields with
  | k :: ht :: r :: _ :: vid :: _ => if seq k "done" then None else Some (k, ht, r, vid)
  | _ => None
  end.

broadcast_key (k ht r : string) : string :=
  append k (append "/" (append ht (append "/" r))).

broadcast_repeat_log (k slot : string) : string :=
  append "already signed a " (append k (append " at " (append slot ": sending that one again"))).

broadcast_refuse_log (k slot v : string) : string :=
  append "refusing to sign a second " (append k (append " at " (append slot (append ": already signed " v)))).

broadcast_counted (k : string) : bool := if seq k "prevote" then true else seq k "precommit".

(** Equivocation and double-voting are per peer; silence sends nothing;
    everything else is one message to every peer. *)
broadcast_mode (byz : string) (fields : list string) : string :=
  match fields with
  | "proposal" :: _ :: _ :: _ :: _ :: _ =>
      if seq byz "equivocate" then "each" else
      if seq byz "silent" then "none" else "all"
  | k :: _ :: _ :: _ :: _ :: _ =>
      if seq byz "double-vote" && broadcast_counted k then "each" else
      if seq byz "silent" then "none" else "all"
  | _ => if seq byz "silent" then "none" else "all"
  end.

broadcast_alt (byz : string) (fields : list string) : list string :=
  if seq byz "equivocate" then
    match fields with
    | "proposal" :: h :: r :: vr :: _ =>
        ["proposal", h, r, vr, hash_list ["equivocation", h, r], "equivocation", h, r]
    | _ => fields
    end
  else
    match fields with
    | k :: h :: r :: vr :: _ :: rest => k :: h :: r :: vr :: "" :: rest
    | _ => fields
    end.

broadcast_deliver (byz : string) (peers : nat) (fields : list string) : list output_action :=
  let mode := broadcast_mode byz fields in
  let alt := if seq mode "each" then broadcast_alt byz fields else fields in
  let noted := match fields with
    | _ :: ht :: _ => if seq mode "none" then [] else [RememberBroadcast ht mode fields alt]
    | _ => [] end in
  let sent :=
    if seq mode "none" then []
    else if seq mode "each" then
      map (fun i => SendPeer (show i) (if i =? 0 then fields else alt)) (List.seq 0 peers)
    else [SendEveryone fields] in
  noted ++ sent.

(** An honest node never signs two values for one kind, height and round.
    A different ask resends the stored vote, or refuses when there is none. *)
broadcast_plan (byz : string) (peers : nat) (fields : list string)
    (subject : option (string * string * string * string))
    (prior_vid : option string) (prior_msg : option (list string)) : list output_action :=
  match subject with
  | None => broadcast_deliver byz peers fields
  | Some (k, ht, r, vid) =>
      let slot := broadcast_key k ht r in
      match prior_vid with
      | None => RememberVote slot vid fields :: broadcast_deliver byz peers fields
      | Some v =>
          if negb (seq v vid) && seq byz "" then
            match prior_msg with
            | Some saved => LogAction (broadcast_repeat_log k slot) :: broadcast_deliver byz peers saved
            | None => [LogAction (broadcast_refuse_log k slot v)]
            end
          else broadcast_deliver byz peers fields
      end
  end.

(** An output action as a node program, with no binding of its own: most
    are one operation ([action_io]); a submission is signed ([IoEncodeTx]),
    then tracked, logged, queued and sent unless the node is silent; a
    catch-up block is read ([IoBlock]) and sent. Each [ndo] goes on only
    when its operation was carried out, as the [&&] chain this replaced did,
    and each read is an operation in its place in that order. *)
(** Messages to one peer, in order, stopping at the first not sent. *)
Fixpoint actions_send (who : string) (messages : list (list string)) : nprog bool :=
  match messages with
  | [] => NDone true
  | m :: rest => nand (nexec (IoPeerSend who m)) (fun _ => actions_send who rest)
  end.

action_prog (action : output_action) : nprog bool :=
  match action with
  | PublishTransaction nonce fields message =>
      nbind (nask (IoEncodeTx nonce fields)) (fun signed =>
      let raw := ans_one signed in
      ndo (IoTrackTx raw) (fun _ =>
      nand (match message with Some text => nexec (IoLog text) | None => NDone true end) (fun _ =>
      ndo (IoQueue ["tx", raw]) (fun _ =>
      nbind (nask IoDraw) (fun draw =>
      match submission_send (fst (ans_draw draw)) raw with
      | None => NDone true
      | Some fields => nexec (IoSendAll fields)
      end)))))
  | ReadPeerBlock who k =>
      nbind (nask (IoBlock (show k))) (fun block =>
      match catchup_send who k (ans_found block) with
      | None => NDone true
      | Some (peer, fields) => nexec (IoPeerSend peer fields)
      end)
  | SendSigned who k =>
      nbind (nask (IoSignedAt (show k))) (fun signed =>
      actions_send who (nio_lists (ans_list signed)))
  | _ => match action_io action with Some op => nexec op | None => NDone true end
  end.

(** The actions in order, stopping at the first not carried out. Each is
    built when the ones before it have run. *)
Fixpoint actions_prog (actions : list output_action) : nprog bool :=
  match actions with
  | [] => NDone true
  | action :: rest => nand (action_prog action) (fun _ => actions_prog rest)
  end.

(** A decided merge: the same edits on this node's checkout, committed the
    same way on every node. A repository this node doesn't have is said, a
    version already applied or a diverged checkout is passed over, and a
    checkout that doesn't reach the attested tree has diverged: that's
    loud, and it takes no more merges. The shell only resets, reads,
    writes, removes and commits. *)
Inductive merge_gate := MergeUnknown | MergeSkip | MergeApply.

merge_gate_of (applied : option string) (v : string) (diverged : bool) : merge_gate :=
  match applied with
  | None => MergeUnknown
  | Some a => if num v <=? num a then MergeSkip else if diverged then MergeSkip else MergeApply
  end.

merge_diverged_text (r v why : string) : string :=
  append "DIVERGED: repository " (append r (append ", merge " (append (show (num v))
    (append ": " (append why ". Stopped taking merges for it."))))).

merge_tree_check (tree : string) (committed : option (string * string)) : option string :=
  match committed with
  | None => Some "git commit failed"
  | Some (got, _) =>
      if seq got tree then None
      else Some (append "got tree " (append got (append ", attested " tree)))
  end.

merge_diverge_prog (r v why : string) : nprog bool :=
  nand (nexec (IoLog (merge_diverged_text r v why))) (fun _ =>
  nexec (IoMergeDiverged r (append (show (num v)) (append ": " why)))).

(** A commit's answer: the tree and short hash it made, or none. *)
merge_committed (a : nanswer) : option (string * string) :=
  match ans_found a with Some [got, short] => Some (got, short) | _ => None end.

(** A decided merge, as a node program: the gate's reads, then the reset,
    the edits, the commit and the tree check, each an operation. *)
merge_prog (r v tree bid task bidder spec : string) (edits : list string) : nprog bool :=
  nbind (nask (IoIsDiverged r)) (fun diverged =>
  nbind (nask (IoAppliedVersion r)) (fun applied =>
  match merge_gate_of (ans_found_one applied) v (fst diverged) with
  | MergeUnknown => nexec (IoLog (append "a merge for repository " (append r ", which this node doesn't have")))
  | MergeSkip => NDone true
  | MergeApply =>
      ndo (IoMergeReset r) (fun _ =>
      nbind (edits_prog (InRepo r) (edit_triples edits)) (fun failed =>
      match failed with
      | Some why => merge_diverge_prog r v why
      | None =>
          nbind (nask (IoMergeCommit r v tree bid task bidder spec)) (fun c =>
          let committed := merge_committed c in
          match merge_tree_check tree committed with
          | Some why => merge_diverge_prog r v why
          | None =>
              let short := match committed with Some (_, s) => s | None => "" end in
              ndo (IoMergeApplied r v) (fun _ =>
              nexec (IoLog (append "merged bid " (append bid (append " into " (append r (append ": " short)))))))
          end)
      end))
  end)).

(** ---- A model call (the "llm" output) ----
    Soma decides the call budget and the rate-limit hold, writes the log
    lines, and assembles the prompt: the fence token for {{F}}, every
    repository's file list for {{REPOS}}, each .plan's open items for
    {{PLAN}} and a task's files for {{REPO}}. The shell reads files at a
    checkout's head, lists them, and runs the model process; a reply that
    says the model is limited holds the raw request, which the shell hands
    back as an [llm_release] event so its prompt is assembled again then. *)
Inductive llm_gate := LlmOverBudget | LlmHeld | LlmAsk.

(** [calls] already counts this call: the budget is [max] calls in all. *)
llm_gate_of (calls max : string) (now until : float) : llm_gate :=
  if num max <? num calls then LlmOverBudget
  else if PrimFloat.ltb now until then LlmHeld
  else LlmAsk.

llm_budget_text (max : string) : string :=
  append "model call budget of " (append max " used up: restart with a higher --max-llm-calls").

llm_hold_text (id kind backend minutes : string) : string :=
  append "holding request " (append id (append " (a " (append kind (append "): "
    (append backend (append " is limited for " (append minutes " more minutes"))))))).

llm_ask_text (backend kind id calls max : string) : string :=
  append "asking " (append backend (append " for a " (append kind (append " (request "
    (append id (append ", call " (append calls (append " of " (append max ")"))))))))).

shell_fence (token label body : string) : string :=
  append context_fence_open (append token (append context_fence_space (append label (append context_fence_body (append newline
    (append body (append newline (append context_fence_close (append token (append context_fence_body newline)))))))))).

(** Runtime context is inserted after template parsing, so unusual names
    need an actual fresh-token fence rather than a template-token fence. *)
shell_name (token name : string) : string :=
  if seq (prompt_name name) name then name
  else shell_fence token prompts.common.prompt_name_label name.

(** git ls-files' output, at most [cap] names, then how many more *)
listing_text (files : string) (cap : nat) : string :=
  let fs := filter (fun l => negb (seq l "")) (split_lines files) in
  append (Stdlib.Strings.String.concat newline (firstn cap fs))
    (if cap <? length fs
     then append newline (append context_listing_more_start (append (show (length fs - cap)) context_listing_more_end))
     else "").

repos_text_of (token : string) (listings : list (string * string)) : string :=
  Stdlib.Strings.String.concat ""
    (map (fun p => shell_fence token (append context_files_label (fst p)) (listing_text (snd p) 200)) listings).

(** each repository's .plan at its head (None: it has none) *)
plan_text_of (token : string) (plans : list (string * option string)) : string :=
  let parts := flat_map (fun p =>
      match snd p with
      | None => []
      | Some c =>
          [shell_fence token (append context_plan_label (append (fst p) context_open_items_label))
             (match plan_open c with
              | [] => context_plan_closed
              | items => Stdlib.Strings.String.concat newline items
              end)]
      end) plans in
  match parts with
  | [] => append context_plan_absent newline
  | _ => Stdlib.Strings.String.concat "" parts
  end.

(** a task's files, each cut at [cap] and all of them within [budget]
    characters, the cut ones included with their note; None: no such file *)
(** Read and truncate one file before reading the next. In particular, do
    not build a list retaining every full context blob before budgeting. *)
Fixpoint repo_read_text {A : Type} (token : string) (cap budget : nat)
    (read : A -> string * option string) (files : list A) : string :=
  match files with
  | [] => ""
  | file :: rest =>
      let (p, got) := read file in
      let c := match got with Some t => t | None => context_file_absent end in
      let lim := Nat.min budget cap in
      let c := if lim <? slen c then append (substr c 0 lim) (append newline context_file_truncated) else c in
      append (shell_fence token (append context_file_label p) c)
        (repo_read_text token cap (budget - slen c) read rest)
  end.

repo_files_text (token : string) (cap budget : nat) (files : list (string * option string)) : string :=
  repo_read_text token cap budget (fun file => file) files.

(** None: no such repository *)
repo_text_of (token r : string) (listing : option string) (files : list (string * option string))
    (cap budget : nat) : string :=
  match listing with
  | None => append context_repo_absent_start (append (shell_name token r) (append context_repo_absent_end newline))
  | Some l => append (shell_fence token (append context_files_label r) (listing_text l 300))
                     (repo_files_text token cap budget files)
  end.

(** Parse only the original template. Inserted repository/plan text and
    even the fence token are literal values, never another template. Keep
    complete literal chunks so assembly is linear in template and output. *)
Inductive prompt_slot := FenceSlot | ReposSlot | PlanSlot | RepoSlot.
Inductive prompt_part := PromptLiteral (text : string) | PromptSlot (slot : prompt_slot).

Fixpoint prompt_lex_go (cs literal : list ascii) (parts : list prompt_part) : list prompt_part :=
  let flush := PromptLiteral (of_chars (rev_onto literal [])) :: parts in
  match cs with
  | "{"%char :: "{"%char :: "F"%char :: "}"%char :: "}"%char :: rest =>
      prompt_lex_go rest [] (PromptSlot FenceSlot :: flush)
  | "{"%char :: "{"%char :: "R"%char :: "E"%char :: "P"%char :: "O"%char :: "S"%char :: "}"%char :: "}"%char :: rest =>
      prompt_lex_go rest [] (PromptSlot ReposSlot :: flush)
  | "{"%char :: "{"%char :: "P"%char :: "L"%char :: "A"%char :: "N"%char :: "}"%char :: "}"%char :: rest =>
      prompt_lex_go rest [] (PromptSlot PlanSlot :: flush)
  | "{"%char :: "{"%char :: "R"%char :: "E"%char :: "P"%char :: "O"%char :: "}"%char :: "}"%char :: rest =>
      prompt_lex_go rest [] (PromptSlot RepoSlot :: flush)
  | c :: rest => prompt_lex_go rest (c :: literal) parts
  | [] => rev_onto flush []
  end.

prompt_parts (text : string) : list prompt_part := prompt_lex_go (chars text) [] [].

prompt_has (slot : prompt_slot) (parts : list prompt_part) : bool :=
  existsb (fun part => match part, slot with
    | PromptSlot FenceSlot, FenceSlot | PromptSlot ReposSlot, ReposSlot
    | PromptSlot PlanSlot, PlanSlot | PromptSlot RepoSlot, RepoSlot => true
    | _, _ => false end) parts.

prompt_render (parts : list prompt_part) (token repos plan : string) (repo : option string) : string :=
  Stdlib.Strings.String.concat "" (map (fun part => match part with
    | PromptLiteral text => text
    | PromptSlot FenceSlot => token
    | PromptSlot ReposSlot => repos
    | PromptSlot PlanSlot => plan
    | PromptSlot RepoSlot => match repo with Some text => text | None => "{{REPO}}" end
    end) parts).

prompt_assemble (token prompt : string) (ctx : list string) (repos plan : unit -> string)
    (repo : string -> list string -> string) : string :=
  let parts := prompt_parts prompt in
  let r := if prompt_has ReposSlot parts then repos tt else "" in
  let p := if prompt_has PlanSlot parts then plan tt else "" in
  let x := match ctx with
    | name :: paths => if prompt_has RepoSlot parts then Some (repo name paths) else None
    | [] => None end in
  prompt_render parts token r p x.

(** ---- What a model call's output becomes (step 5) ----
    A reply is held for a usage limit, fails, or becomes an llm_reply
    event with its JSON's fields; when the model says when its limit
    resets, the hold lasts that long. The shell reads a run of digits as
    a float, keeps the limit's state, and for the JSON only reports the
    output cap, the brace offsets and yojson's tokens. *)
limit_words : list string :=
  ["usage limit", "rate limit", "rate-limit", "ratelimit", "limit reached", "limit exceeded", "quota",
   "too many requests", "hit your limit", "out of credits", "credit balance", "resource_exhausted",
   (* Grok Build: "API error (status 402 Payment Required): Grok Build usage balance exhausted" *)
   "balance exhausted", "payment required", "insufficient credit", "insufficient balance"].

code_at (t : string) (i : nat) : nat :=
  match char_at t i with Some c => nat_of_ascii c | None => 256 end.

alnum_at (t : string) (i : nat) : bool :=
  let n := code_at t i in ((97 <=? n) && (n <=? 122)) || ((48 <=? n) && (n <=? 57)).

(** [w] in [t] as a number of its own: no letter or digit right before or
    after it (HTTP 429, but not "k429" or "14290") *)
Fixpoint has_number_go (fuel : nat) (t w : string) (i : nat) : bool :=
  match fuel with
  | 0 => false
  | Succ f =>
      match find_str w t i with
      | None => false
      | Some k =>
          if (if k =? 0 then true else negb (alnum_at t (k - 1))) && negb (alnum_at t (k + slen w))
          then true else has_number_go f t w (Succ k)
      end
  end.

has_number (t w : string) : bool := has_number_go (slen t + 1) t w 0.

(** a model's output saying it has hit a subscription or rate limit *)
is_limit (text : string) : bool :=
  let t := lower text in existsb (fun w => contains w t) limit_words || has_number t "429".

(** OCaml's String.trim blanks: space, form feed, newline, return, tab *)
ocaml_blank (n : nat) : bool := (n =? 32) || (n =? 12) || (n =? 10) || (n =? 13) || (n =? 9).

Fixpoint blank_from (fuel : nat) (t : string) (i : nat) : nat :=
  match fuel with
  | 0 => i
  | Succ f => if ocaml_blank (code_at t i) then blank_from f t (Succ i) else i
  end.

Fixpoint blank_back (fuel : nat) (t : string) (j : nat) : nat :=
  match fuel, j with
  | Succ f, Succ j' => if ocaml_blank (code_at t j') then blank_back f t j' else j
  | _, _ => j
  end.

(** [t] without OCaml's leading and trailing blanks *)
ocaml_trim (t : string) : string :=
  let a := blank_from (slen t) t 0 in
  let b := blank_back (slen t) t (slen t) in
  if b <=? a then "" else substr t a (b - a).

Fixpoint digits_end (fuel : nat) (t : string) (i : nat) : nat :=
  match fuel with
  | 0 => i
  | Succ f => let n := code_at t i in if (48 <=? n) && (n <=? 57) then digits_end f t (Succ i) else i
  end.

(** the run of digits at [i], read by [of_digits], and the offset after it *)
num_after (of_digits : string -> float) (t : string) (i : nat) : option (float * nat) :=
  let j := digits_end (slen t) t i in
  if (i <? j) && (j - i <=? 18) then Some (of_digits (substr t i (j - i)), j) else None.

Fixpoint last_bar (fuel : nat) (t : string) (j : nat) : option nat :=
  match fuel, j with
  | Succ f, Succ j' => if code_at t j' =? 124 then Some j' else last_bar f t j'
  | _, _ => None
  end.

Fixpoint skip_spaces (fuel : nat) (t : string) (k : nat) : nat :=
  match fuel with
  | 0 => k
  | Succ f => if code_at t k =? 32 then skip_spaces f t (Succ k) else k
  end.

(** a number's unit, from the first of the next twelve characters that
    isn't blank: hours, seconds, or else minutes *)
unit_secs (t : string) (j : nat) : float :=
  let r := substr t j 12 in
  let n := code_at r (blank_from 12 r 0) in
  if n =? 104 then 3600%float else if n =? 115 then 1%float else 60%float.

reset_after (of_digits : string -> float) (t phrase : string) : option float :=
  match find_str phrase t 0 with
  | Some k =>
      match num_after of_digits t (skip_spaces (slen t) t (k + slen phrase)) with
      | Some (n, j) => Some (PrimFloat.mul n (unit_secs t j))
      | None => None
      end
  | None => None
  end.

(** Seconds until the limit resets, if the message says: Claude Code's
    message ends with "|" and the reset's Unix time; others say "try again
    in N" or "resets in N" minutes, hours or seconds. *)
reset_in (of_digits : string -> float) (now : float) (text : string) : option float :=
  let t := lower text in
  let at_end :=
    match last_bar (slen t) t (slen t) with
    | Some i =>
        match num_after of_digits t (i + 1) with
        | Some (e, j) => if (j =? slen (ocaml_trim t)) && PrimFloat.ltb now e then Some (PrimFloat.sub e now) else None
        | None => None
        end
    | None => None
    end in
  match at_end with
  | Some x => Some x
  | None =>
      match reset_after of_digits t "try again in" with
      | Some x => Some x
      | None => reset_after of_digits t "resets in"
      end
  end.

(** A digit run as a float, exactly for up to 15 digits: the Examples' reader
    (the node reads with OCaml's float_of_string, a binding). *)
digit_float (c : nat) : float :=
  nth (c - 48) [0%float, 1%float, 2%float, 3%float, 4%float, 5%float, 6%float, 7%float, 8%float, 9%float] 0%float.

digits_float (s : string) : float :=
  fold_left (fun a c => PrimFloat.add (PrimFloat.mul a 10%float) (digit_float (nat_of_ascii c))) (chars s) 0%float.

(** Provider reset text is untrusted. Keep every accepted hold finite,
    positive and no longer than the existing two-hour backoff maximum. NaN,
    zero and negative state use the normal fifteen-minute fallback. *)
limit_bound_wait (wait : float) : float :=
  if PrimFloat.ltb 0%float wait then
    if PrimFloat.leb wait 7200%float then wait else 7200%float
  else 900%float.

limit_requested_wait (reset : option float) (backoff : float) : float :=
  match reset with
  | Some x => if PrimFloat.ltb 0%float x then PrimFloat.add x 10%float else backoff
  | None => backoff
  end.

limit_wait (reset : option float) (backoff : float) : float :=
  limit_bound_wait (limit_requested_wait reset backoff).

limit_wait_adjusted (reset : option float) (backoff : float) : bool :=
  negb (PrimFloat.eqb (limit_requested_wait reset backoff) (limit_wait reset backoff)).

(** The sanitized backoff doubles, to at most two hours. *)
limit_next_backoff (backoff : float) : float :=
  limit_bound_wait (PrimFloat.mul (limit_bound_wait backoff) 2%float).

limit_clamped_note : string := " [wait bounded to two hours; invalid wait ignored]".

limit_reason_of (text : string) : string := take_str 300 text.

limit_log_text (backend minutes reason : string) : string :=
  append "LIMIT: " (append backend (append " says it has hit its limit, so its model calls are held for "
    (append minutes (append " minutes: " reason)))).

(** what came back instead of JSON, on one line, so the log shows why *)
reply_no_json_text (text : string) : string :=
  let t := ocaml_trim (map_chars (fun c => let n := nat_of_ascii c in
                                   if (n =? 10) || (n =? 13) then " "%char else c) text) in
  if seq t "" then "the reply was empty"
  else append "the reply had no JSON object: " (append (take_str 200 t) (if 200 <? slen t then "..." else "")).

Inductive reply_outcome :=
| ReplyHold (text : string)
| ReplyError (why : string)
| ReplyFields (kv : list string).

(** A job's output: "!..." when it failed (or couldn't start). [fields] is
    the reply's JSON object flattened, None when it has none; it is asked
    only when the job didn't fail, and a JSON reply is never a limit. *)
reply_outcome_of (text : string) (fields : string -> option (list string)) : reply_outcome :=
  if starts "!" text then
    if is_limit text then ReplyHold (drop_str 1 text) else ReplyError (drop_str 1 text)
  else
    match fields text with
    | Some kv => ReplyFields kv
    | None => if is_limit text then ReplyHold text else ReplyError (reply_no_json_text text)
    end.

(** One JSON value while it is flattened. [FramePairs] and [FrameElems]
    still have [left] children to walk, left to right, under [prefix]. *)
Inductive reply_frame :=
| FrameValue (prefix : string)
| FramePairs (left : nat) (prefix : string)
| FrameElems (left : nat) (prefix : string) (index : nat).

(** Tokens from the yojson binding, in order: "A" count, then each key and
    its value; "L" count, then each element; "S" text; "B" "true" or
    "false"; "U"; "I" digits; "F" the binding's "%.0f" text. The same
    key, value, ... list the old walk produced, dotted names and list
    indices included. A list index is always ".<n>", even at the root. *)
Fixpoint flatten_walk (fuel : nat) (stack : list reply_frame) (toks acc : list string) : list string :=
  match fuel, stack with
  | Succ f, FrameValue prefix :: stack =>
      match toks with
      | "A" :: ns :: rest => flatten_walk f (FramePairs (num ns) prefix :: stack) rest acc
      | "L" :: ns :: rest => flatten_walk f (FrameElems (num ns) prefix 0 :: stack) rest acc
      | "S" :: s :: rest => flatten_walk f stack rest (s :: prefix :: acc)
      | "B" :: b :: rest => flatten_walk f stack rest (b :: prefix :: acc)
      | "U" :: rest => flatten_walk f stack rest ("null" :: prefix :: acc)
      | "I" :: s :: rest => flatten_walk f stack rest (s :: prefix :: acc)
      | "F" :: s :: rest => flatten_walk f stack rest (s :: prefix :: acc)
      | _ => flatten_walk f stack [] acc
      end
  | Succ f, FramePairs n prefix :: stack =>
      match n, toks with
      | 0, _ => flatten_walk f stack toks acc
      | Succ n', k :: rest =>
          let p := if seq prefix "" then k else append prefix (append "." k) in
          flatten_walk f (FrameValue p :: FramePairs n' prefix :: stack) rest acc
      | _, [] => rev_onto acc []
      end
  | Succ f, FrameElems n prefix i :: stack =>
      match n with
      | 0 => flatten_walk f stack toks acc
      | Succ n' =>
          let p := append prefix (append "." (show i)) in
          flatten_walk f (FrameValue p :: FrameElems n' prefix (Succ i) :: stack) toks acc
      end
  | _, _ => rev_onto acc []
  end.

(** Two steps a token, plus the frame that opens each container. *)
flatten_reply (toks : list string) : list string :=
  flatten_walk (length toks + length toks + length toks + 1) (FrameValue "" :: []) toks [].

(** The object's text, from the first "{" through the last "}", when the
    reply is within the job's output cap and that slice passes the old
    shallow_json guard (depth 4, 4096 items). The cap and the two offsets
    are decimal strings: an output is up to 4 MB, and that length is not
    a unary nat. Missing braces, a close that is not after the open, and
    a slice that is too deep or too wide are no object. *)
json_in_reply (text limit : string) (open_at close_at : option string) : option string :=
  if num limit <? slen text then None
  else match open_at, close_at with
       | Some a, Some b =>
           let i := num a in
           let j := num b in
           if i <? j then
             let raw := substr text i (j - i + 1) in
             if shallow_json "4" "4096" raw then Some raw else None
           else None
       | _, _ => None
       end.

(** [tokens] is yojson on the slice (none: it did not parse). Empty
    objects flatten to an empty field list, which is still a reply. *)
reply_fields_of (text limit : string) (open_at close_at : option string)
    (tokens : string -> option (list string)) : option (list string) :=
  match json_in_reply text limit open_at close_at with
  | None => None
  | Some raw =>
      match tokens raw with
      | None => None
      | Some toks => Some (flatten_reply toks)
      end
  end.

(** Where a reply's braces are, by byte offset (as OCaml's String.index_opt
    and String.rindex_opt found them): a tail-recursive scan by [char_at],
    no substring per step, so a 4 MB reply is one pass each way. *)
Fixpoint first_code (fuel : nat) (t : string) (c i : nat) : option nat :=
  match fuel with
  | 0 => None
  | Succ f => if code_at t i =? c then Some i else first_code f t c (Succ i)
  end.

Fixpoint last_code (fuel : nat) (t : string) (c j : nat) : option nat :=
  match fuel, j with
  | Succ f, Succ j' => if code_at t j' =? c then Some j' else last_code f t c j'
  | _, _ => None
  end.

(** The offsets cross to [json_in_reply] as decimal strings, as before. *)
reply_open_at (text : string) : option string :=
  match first_code (slen text) text 123 0 with Some i => Some (show i) | None => None end.

reply_close_at (text : string) : option string :=
  match last_code (slen text) text 125 (slen text) with Some j => Some (show j) | None => None end.

(** Over the cap, the braces are not even looked up: the same short
    circuit as before, and no walk of a multi-megabyte output. *)
reply_fields (text : string) : option (list string) :=
  let limit := job_output_limit in
  if num limit <? slen text then None
  else reply_fields_of text limit (reply_open_at text) (reply_close_at text) json_tokens.

(** The outcome carried out: a limit is noted (its wait, reason and doubled
    backoff, the log line) and the raw request held; otherwise the backoff
    goes back to 15 minutes and the reply or error is the event. *)
reply_prog (id kind prompt0 text : string) (ctx : list string) : nprog (list (list string)) :=
  match reply_outcome_of text reply_fields with
  | ReplyHold body =>
      nbind (nask IoClock) (fun clock =>
      let now := ans_float clock in
      nbind (nask IoReleaseState) (fun release =>
      let backoff := ans_float release in
      nbind (nask IoLimitInfo) (fun limit =>
      let backend := hd "" (ans_list limit) in
      let wait := limit_wait (reset_in float_of_digits now body) backoff in
      let reason := limit_reason_of body in
      let reported := if limit_wait_adjusted (reset_in float_of_digits now body) backoff
                      then append reason limit_clamped_note else reason in
      nbind (nand (nexec (IoLimitSet (float_wire (PrimFloat.add now wait)) reason
                                     (float_wire (limit_next_backoff backoff)))) (fun _ =>
             nand (nexec (IoLog (limit_log_text backend (float_text (PrimFloat.div wait 60%float)) reported)))
                  (fun _ => nexec (IoLlmHold id kind prompt0 ctx)))) (fun held =>
      NDone (if held then [] else [["llm_error", id, "the request couldn't be held"]])))))
  | ReplyError why =>
      nbind (nexec (IoLimitClear (float_wire 900%float))) (fun ok =>
      NDone (if ok then [["llm_error", id, why]] else []))
  | ReplyFields kv =>
      nbind (nexec (IoLimitClear (float_wire 900%float))) (fun ok =>
      NDone (if ok then [("llm_reply" :: id :: kv)] else []))
  end.

(** ---- Grok's reply: the chat completion's choices.0.message.content ----
    Over the yojson binding's tokens (as in [flatten_reply]), with the
    shell's old Yojson.Safe.Util semantics: [member] takes the first key
    that matches, and a missing key, a non-object, an empty or non-list
    choices, or content that isn't a string is no content. *)

(** Skip tokens: [pending] says what is left, a key (true) or a whole
    value (false). None: the tokens end too soon. *)
Fixpoint json_skip (fuel : nat) (pending : list bool) (toks : list string) : option (list string) :=
  match fuel with
  | 0 => None
  | Succ f =>
      match pending, toks with
      | [], _ => Some toks
      | true :: p, _ :: rest => json_skip f p rest
      | false :: p, "A" :: ns :: rest =>
          json_skip f (flat_map (fun _ => [true, false]) (List.seq 0 (num ns)) ++ p) rest
      | false :: p, "L" :: ns :: rest =>
          json_skip f (map (fun _ => false) (List.seq 0 (num ns)) ++ p) rest
      | false :: p, "U" :: rest => json_skip f p rest
      | false :: p, _ :: _ :: rest => json_skip f p rest
      | _, _ => None
      end
  end.

Fixpoint json_member_go (n : nat) (k : string) (toks : list string) : option (list string) :=
  match n with
  | 0 => None
  | Succ n' =>
      match toks with
      | key :: rest =>
          if seq key k then Some rest
          else match json_skip (Succ (length rest)) [false] rest with
               | Some after => json_member_go n' k after
               | None => None
               end
      | [] => None
      end
  end.

(** the tokens of an object's value at key [k], from its first such key *)
json_member (k : string) (toks : list string) : option (list string) :=
  match toks with
  | "A" :: ns :: rest => json_member_go (num ns) k rest
  | _ => None
  end.

(** the tokens of a nonempty list's first element *)
json_first (toks : list string) : option (list string) :=
  match toks with
  | "L" :: ns :: rest => if 0 <? num ns then Some rest else None
  | _ => None
  end.

grok_content (toks : list string) : option string :=
  match json_member "choices" toks with
  | None => None
  | Some t1 =>
      match json_first t1 with
      | None => None
      | Some t2 =>
          match json_member "message" t2 with
          | None => None
          | Some t3 =>
              match json_member "content" t3 with
              | Some ("S" :: s :: _) => Some s
              | _ => None
              end
          end
      end
  end.

(** what grok's output becomes: its content, or the error with the
    output's first 300 bytes (None: the output isn't JSON) *)
grok_reply_of (toks : option (list string)) (text : string) : option string * string :=
  match toks with
  | Some t => (grok_content t, append "grok: " (take_str 300 text))
  | None => (None, append "grok: " (take_str 300 text))
  end.

(** A model's raw output: grok's is its content first (an error that
    isn't JSON content goes straight to llm_error, never a limit hold, as
    the shell did); every other backend's is the reply itself. *)
model_reply_prog (id kind prompt0 text : string) (ctx : list string) : nprog (list (list string)) :=
  nbind (nask IoLimitInfo) (fun limit =>
  if seq (hd "" (ans_list limit)) "grok" then
    match grok_reply_of (json_tokens text) text with
    | (Some content, _) => reply_prog id kind prompt0 content ctx
    | (None, why) => NDone [["llm_error", id, why]]
    end
  else reply_prog id kind prompt0 text ctx).

(** The operating system's wait status, decoded without deciding its
    meaning. The shell supplies raw platform signal constants; Soma names them. *)
Inductive job_status := JobExit (code : string) | JobSignal (name : string) | JobStop (name : string).

job_status_of (tag value : string) : option job_status :=
  if seq tag "exit" then Some (JobExit value)
  else if seq tag "signal" then Some (JobSignal value)
  else if seq tag "stop" then Some (JobStop value)
  else None.

(** Signal formatting is a decision over native constants, not an OS call.
    Keep signed integer text: OCaml's portable signal codes may be negative. *)
job_signal_name (codes : list string) (raw : string) : string :=
  match codes with
  | [kill, term, segv, abrt, interrupt] =>
      if seq raw kill then "SIGKILL" else if seq raw term then "SIGTERM"
      else if seq raw segv then "SIGSEGV" else if seq raw abrt then "SIGABRT"
      else if seq raw interrupt then "SIGINT" else append "signal " raw
  | _ => append "signal " raw
  end.

job_wait_status (codes : list string) (tag raw : string) : option job_status :=
  job_status_of tag
    (if seq tag "signal" || seq tag "stop" then job_signal_name codes raw else raw).

(** The same final 3000 bytes as the old process failure report. *)
job_failure_tail (out : string) : string :=
  if 3000 <? slen out then append "..." (substr out (slen out - 3000) 3000) else out.

job_failure_reason (status : job_status) (timeout : option string) (flooded : bool) (max_mb : string) : string :=
  if flooded then append "it printed more than " (append max_mb " MB, so the node stopped it")
  else match status with
  | JobExit code => append "exit " code
  | JobSignal name =>
      match timeout with
      | Some seconds => append "it ran past its time limit of " (append seconds " s, so the node stopped it")
      | None => append "killed by " name
      end
  | JobStop name => append "stopped by " name
  end.

job_result (status : job_status) (timeout : option string) (flooded : bool) (max_mb out : string) : string :=
  let success := match status with JobExit code => seq code "0" && negb flooded | _ => false end in
  if success then (if seq out "" then "pending" else out)
  else append "!process failed (" (append (job_failure_reason status timeout flooded max_mb)
         (append "): " (job_failure_tail out))).

(** Codex writes its answer to a separate file. Process failures win over
    that file, including a stale or empty file; a failed read is an error.
    The reader is lazy so a failed job never needs the file's contents. *)
codex_reply_of (text : string) (read : unit -> option string) : string :=
  if starts "!" text then text
  else match read tt with Some out => out | None => "!codex wrote no reply" end.

(** A failed process must never open its reply file. Resolve the text
    before removing the file; cleanup also runs when the read fails. *)
codex_file_prog (text path : string) : nprog string :=
  nbind (if starts "!" text then NDone None
         else nbind (nask (IoReadText path)) (fun got => NDone (ans_found_one got))) (fun got =>
  let reply := codex_reply_of text (fun _ => got) in
  nbind (nexec (IoDiscardFile path)) (fun _ => NDone reply)).

(** A check job's output, once the edits have been applied. An output that
    starts with "!" is the job failing; [check_apply_stage] still says whose
    fault that is. Otherwise the tree is [ocaml_trim] of the output.
    [with_ci] means this repository has a CI command, so the shell starts
    that run and no success event is emitted yet. [lie] is the bad-tree
    fault: the caller substitutes the lie hash and does not use [tree]. *)
Inductive check_apply_plan :=
| CheckApplyFailed
| CheckApplyTree (with_ci : bool) (lie : bool) (tree : string).

check_evidence (raw : string) : list string :=
  match json_tokens raw with Some toks => flatten_reply toks | None => [] end.

check_raw_tree (raw : string) : string :=
  let tree := kv_at (check_evidence raw) "tree" in
  if seq tree "" then ocaml_trim raw else tree.

check_apply_plan_of (byz ci raw : string) : check_apply_plan :=
  if starts "!" raw then CheckApplyFailed
  else CheckApplyTree (negb (seq ci "")) (seq byz "bad-tree") (check_raw_tree raw).

(** A check's result event, chosen here (step 5): ok is "true", "error"
    when the failure is this node's own (stage "node": the agent abstains)
    or "false" (the bid's). why is the bid's own output, so its control
    characters become spaces (clean_text, the bytes the market's
    plain_text accepts, docs/SECURITY-REVIEW-2.md P-17) before it can reach
    a rejection's reason. *)
check_ok_text (ok : bool) (stage : string) : string :=
  if ok then "true" else if seq stage "node" then "error" else "false".

check_result_event (id : string) (ok : bool) (tree why stage : string) : list string :=
  ["check_result", id, "ok", check_ok_text ok stage, "tree", tree, "why", clean_text why, "stage", stage].

(** A repository this node doesn't check (--no-check, or outside its
    genesis scope): a failure that is this node's own, so it abstains. *)
check_unchecked_event (id why : string) : list string := check_result_event id false "" why "node".

(** The shell reports only the repository and scope membership. The reason
    and the resulting abstention event are selected here. *)
check_unchecked_reason (repo : string) (excluded : bool) : string :=
  append "this node doesn't check " (append repo
    (if excluded then " (outside its scope: its genesis part excludes it)"
     else append " (--no-check " (append repo ")"))).

check_unchecked_repo_event (id repo : string) (excluded : bool) : list string :=
  check_unchecked_event id (check_unchecked_reason repo excluded).

(** The success event the shell's push_check_result used to queue, with an empty why. *)
check_result_ready (id tree : string) : list string :=
  ["check_result", id, "ok", "true", "tree", tree, "why", "", "stage", ""].

(** Events this output becomes. CI adds none: the shell starts the run, and
    [ci_done] comes back when it ends. [lie_hash] is used only when the plan
    says to lie. *)
check_apply_choice (lie_hash id raw : string) (plan : check_apply_plan) : list (list string) :=
  match plan with
  | CheckApplyFailed => [["check_failed", id, raw]]
  | CheckApplyTree with_ci lie tree =>
      if with_ci then [] else [check_result_ready id (if lie then lie_hash else tree)]
  end.

(** The first 40 hex characters of sha256("lie" ^ id), the old fault. *)
check_lie_tree (id : string) : string := substr (sha256 (append "lie" id)) 0 40.

check_apply_tree (plan : check_apply_plan) (lie_hash : string) : string :=
  match plan with
  | CheckApplyTree _ true _ => lie_hash
  | CheckApplyTree _ _ tree => tree
  | CheckApplyFailed => ""
  end.

(** The shell queued the raw output. Log the fault, ask the shell to start
    CI, or return the event, in the old order. Events an immediate CI start
    failure queued come back with these, so they stay in this turn. *)
check_apply_record_prog (id out ci raw : string) (native_evidence : list string) : nprog (list (list string)) :=
  nbind (nask IoDraw) (fun draw =>
  let plan := check_apply_plan_of (fst (ans_draw draw)) ci raw in
  let lying := match plan with CheckApplyTree _ true _ => true | _ => false end in
  let lie_hash := if lying then check_lie_tree id else "" in
  nbind (if lying then nexec (IoLog "FAULT INJECTION: naming a wrong tree") else NDone true) (fun noted =>
  let evidence := native_evidence ++ flat (filter (fun p => mem (fst p) ["commit", "base_commit"]) (pairs (check_evidence raw))) in
  let evs := map (fun ev => if seq (hd "" ev) "check_result" && negb (seq (kv_at evidence "commit") "")
    then ev ++ evidence ++ ["context", "apply-only; no CI configured"] else ev)
    (check_apply_choice lie_hash id raw plan) in
  if noted then
    match plan with
    | CheckApplyTree true _ _ =>
        nbind (nask (IoCiLaunch id out (check_apply_tree plan lie_hash) ci evidence)) (fun started =>
        NDone (evs ++ nio_lists (ans_list started)))
    | _ => NDone evs
    end
  else NDone [])).

check_apply_prog (id out ci raw : string) : nprog (list (list string)) := check_apply_record_prog id out ci raw [].

(** Generated model replies are interpreted before the turn's events run,
    at the finished job's original queue position. Codex's file remains
    until Soma has applied the process-failure guard and resolved it.
    A check's raw output is decided here too, before those events run. *)
model_output_prog (ev : list string) : nprog (list (list string)) :=
  match ev with
  | "llm_output" :: id :: kind :: prompt0 :: text :: ctx => model_reply_prog id kind prompt0 text ctx
  | "codex_file" :: id :: kind :: prompt0 :: text :: path :: ctx =>
      nbind (codex_file_prog text path) (fun reply => model_reply_prog id kind prompt0 reply ctx)
  | "codex_output" :: id :: kind :: prompt0 :: text :: "1" :: out :: ctx =>
      model_reply_prog id kind prompt0 (codex_reply_of text (fun _ => Some out)) ctx
  | "codex_output" :: id :: kind :: prompt0 :: text :: "0" :: ctx =>
      model_reply_prog id kind prompt0 (codex_reply_of text (fun _ => None)) ctx
  | "check_apply_out" :: id :: out :: ci :: raw :: evidence => check_apply_record_prog id out ci raw evidence
  | _ => NDone [ev]
  end.

(** The events each output becomes, in order: one output's effects all
    happen before the next one's. *)
Fixpoint model_outputs_prog (evs : list (list string)) : nprog (list (list string)) :=
  match evs with
  | [] => NDone []
  | ev :: rest =>
      nbind (model_output_prog ev) (fun first =>
      nbind (model_outputs_prog rest) (fun others => NDone (first ++ others)))
  end.

(** A finished job, as a node program: resumed with its outcome, and the
    events its callback queued turned into what they become. *)
job_output_prog (st : node_state) (ev : list string) : nprog (node_state * list (list string)) :=
  match ev with
  | ["job_finished", id, tag, value, timeout, flooded] =>
      let out := Stdlib.Strings.String.concat "" (job_buffer st id) in
      let st := job_forget st id in
      match job_wait_status job_signal_codes tag value with
      | None => NDone (st, [])
      | Some status =>
          let seconds := if seq timeout "" then None else Some timeout in
          let result := job_result status seconds (seq flooded "1")
                          (show (num job_output_limit / num "1048576")) out in
          nbind (nask (IoJobComplete id result)) (fun done =>
          nbind (model_outputs_prog (nio_lists (ans_list done))) (fun evs => NDone (st, evs)))
      end
  | ["check_unchecked", id, why] => NDone (st, [check_unchecked_event id why])
  | ["check_unchecked_repo", id, repo, excluded] =>
      NDone (st, [check_unchecked_repo_event id repo (seq excluded "true")])
  | _ => nbind (model_output_prog ev) (fun evs => NDone (st, evs))
  end.

Fixpoint job_outputs_go_prog (st : node_state) (evs acc : list (list string))
    : nprog (node_state * list (list string)) :=
  match evs with
  | [] => NDone (st, rev_onto acc [])
  | ev :: rest =>
      nbind (job_output_prog st ev) (fun r =>
      let (st, out) := r in job_outputs_go_prog st rest (rev_onto out acc))
  end.

job_outputs_prog (st : node_state) (evs : list (list string)) : nprog (node_state * list (list string)) :=
  job_outputs_go_prog st evs [].

(** A prompt's parts as node programs: each repository's listing
    ([IoLsFiles]), each .plan at its head ([IoHeadFile]), and a task's
    files, each read and cut before the next is read. *)
Fixpoint llm_listings_prog (names : list string) : nprog (list (string * string)) :=
  match names with
  | [] => NDone []
  | n :: rest =>
      nbind (nask (IoLsFiles n)) (fun l =>
      nbind (llm_listings_prog rest) (fun ls => NDone ((n, ans_one l) :: ls)))
  end.

Fixpoint llm_plans_prog (names : list string) : nprog (list (string * option string)) :=
  match names with
  | [] => NDone []
  | n :: rest =>
      nbind (nask (IoHeadFile n ".plan")) (fun c =>
      nbind (llm_plans_prog rest) (fun ps => NDone ((n, ans_found_one c) :: ps)))
  end.

llm_repos_prog (token : string) : nprog string :=
  nbind (nask IoRepoNames) (fun names =>
  nbind (llm_listings_prog (ans_list names)) (fun ls => NDone (repos_text_of token ls))).

llm_plan_prog (token : string) : nprog string :=
  nbind (nask IoRepoNames) (fun names =>
  nbind (llm_plans_prog (ans_list names)) (fun ps => NDone (plan_text_of token ps))).

(** [repo_read_text], reading each file with [IoHeadFile]: a file is read
    and cut before the next is asked for. *)
Fixpoint repo_read_prog (token r : string) (cap budget : nat) (files : list string) : nprog string :=
  match files with
  | [] => NDone ""
  | p :: rest =>
      nbind (nask (IoHeadFile r p)) (fun got =>
      let c := match ans_found_one got with Some t => t | None => "(no such file at the head)" end in
      let lim := Nat.min budget cap in
      let c := if lim <? slen c then append (substr c 0 lim) (append newline "(cut here: the file goes on)") else c in
      nbind (repo_read_prog token r cap (budget - slen c) rest) (fun tail =>
      NDone (append (shell_fence token (append "file " p) c) tail)))
  end.

llm_repo_prog (token r : string) (paths : list string) : nprog string :=
  nbind (nask IoRepoNames) (fun names =>
  if mem r (ans_list names) then
    nbind (nask (IoLsFiles r)) (fun l =>
    nbind (repo_read_prog token r (64 * 1024) (200 * 1024) (filter shell_safe_path paths)) (fun files =>
    NDone (append (shell_fence token (append "files in " r) (listing_text (ans_one l) 300)) files)))
  else NDone (repo_text_of token r None [] 0 0)).

(** [prompt_assemble] as a node program: a part's program runs only when
    its placeholder is there (runtime/node.exp's prompt_prog_assembles: the
    same text). *)
prompt_prog (token prompt : string) (ctx : list string) (repos plan : nprog string)
    (repo : string -> list string -> nprog string) : nprog string :=
  let parts := prompt_parts prompt in
  nbind (if prompt_has ReposSlot parts then repos else NDone "") (fun r =>
  nbind (if prompt_has PlanSlot parts then plan else NDone "") (fun p =>
  nbind (match ctx with
    | name :: paths => if prompt_has RepoSlot parts then nbind (repo name paths) (fun text => NDone (Some text)) else NDone None
    | [] => NDone None end) (fun x =>
  NDone (prompt_render parts token r p x)))).

(** events queued in order, stopping at the first not queued *)
Fixpoint queue_prog (evs : list (list string)) : nprog bool :=
  match evs with
  | [] => NDone true
  | ev :: rest => ndo (IoQueue ev) (fun _ => queue_prog rest)
  end.

(** Only patch requests for a governed repository receive a writable
    tool checkout. Other requests may read code through their tools but
    receive no checkout. The native binding only creates the chosen checkout;
    its git directory stays outside the model's writable worktree. *)
llm_checkout (kind : string) (ctx names : list string) : option string :=
  match ctx with
  | r :: _ => if seq kind "patch" && mem r names then Some r else None
  | [] => None
  end.


(** A backend's whole launch, as data: the program, its time limit in
    seconds (empty for cmd:, whose limit follows the tool checkout),
    how its input and output files work ("prompt", "codex" or "grok";
    anything else is the prompt on stdin), and its fixed arguments.
    [\@OUT\@] and [\@HDR\@] name files the shell makes. An unknown
    backend launches nothing: the caller reports it. *)
backend_launch (backend : string) : list string :=
  if seq backend "claude" then
    ["claude", "600", "prompt", "-p", "--tools", "", "--strict-mcp-config",
     "--no-session-persistence", "--setting-sources", "", "--output-format", "text"]
  else if seq backend "codex" then
    ["codex", "600", "codex", "exec", "--skip-git-repo-check", "--ephemeral",
     "--sandbox", "read-only", "--disable", "shell_tool", "--disable", "unified_exec",
     "--disable", "apps", "--disable", "browser_use", "-c", "approval_policy=""never""",
     "-c", "mcp_servers={}", "-o", "@OUT@", "-"]
  else if seq backend "grok" then
    ["curl", "600", "grok", "-s", "-m", "600", "-H", "@HDR@", "-d", "@-",
     "https://api.x.ai/v1/chat/completions"]
  else if starts "cmd:" backend && (4 <? slen backend) then
    [drop_str 4 backend, "", "cmd"]
  else [].


(** A model job's environment is Soma's filter: the node's own
    PANTHEON_ settings never reach a model, except for a name that is
    exactly the prefix (the shell asked for more than nine bytes).
    The grok launch keeps the whole environment, as the shell did. *)
model_env_entries (entries : list string) : list string :=
  filter (fun kv => negb ((9 <? slen kv) && starts "PANTHEON_" kv)) entries.

(** how a launch's input and output files work: its third entry *)
launch_mode (launch : list string) : string := hd "" (tl (tl launch)).

(** A cmd: job, decided from its tool checkout: none asked (1200 s, no
    extra environment, nothing to remove), one the shell made (1800 s, the
    worktree, git directory, repository and the node's binary in the
    environment) or one whose clone or checkout failed (600 s). Both of a
    made checkout's directories are removed when the job is over, the git
    directory first (a service allows it while the worktree it sits beside
    is one it made: runtime/node_service.soma). *)
Record tool_job := { tool_limit : string; tool_env : list string; tool_clean : list string }.

tool_job_of (checkout : option string) (made : option ((string * string) * bool)) (self : string) : tool_job :=
  match checkout, made with
  | Some r, Some (dirs, ok) =>
      let (wt, gd) := dirs in
      if ok then
        {| tool_limit := "1800";
           tool_env := [append "PANTHEON_WORKTREE=" wt, append "PANTHEON_GITDIR=" gd,
                        append "PANTHEON_REPO=" r, append "PANTHEON_BIN=" self];
           tool_clean := [gd, wt] |}
      else {| tool_limit := "600"; tool_env := []; tool_clean := [gd, wt] |}
  | _, _ => {| tool_limit := "1200"; tool_env := []; tool_clean := [] |}
  end.

(** a cmd: launch with its limit filled in, the job's extra environment
    before the rest, and what to remove after; any other launch as it is *)
tool_launch (launch env : list string) (tj : tool_job) : list string * (list string * list string) :=
  match launch with
  | prog :: _ :: mode :: args => (prog :: tool_limit tj :: mode :: args, (tool_env tj ++ env, tool_clean tj))
  | _ => (launch, (env, tool_clean tj))
  end.

(** an environment entry's value: the first NAME=, as getenv finds it *)
env_value (name : string) (env : list string) : option string :=
  let pre := append name "=" in
  match find (starts pre) env with
  | Some kv => Some (drop_str (slen pre) kv)
  | None => None
  end.

(** Grok's request: the header file's text and the JSON body around the
    prompt ([json] quotes a string, yojson's way), with GROK_MODEL or
    grok-4.7; none without an XAI_API_KEY. *)
grok_request (json : string -> string) (env : list string) (prompt : string) : option (string * string) :=
  match env_value "XAI_API_KEY" env with
  | None => None
  | Some k =>
      if seq k "" then None else
      let model := match env_value "GROK_MODEL" env with Some m => m | None => "grok-4.7" end in
      Some (append "Authorization: Bearer " (append k (append newline (append "Content-Type: application/json" newline))),
            append "{""model"":" (append (json model) (append ",""messages"":[{""role"":""user"",""content"":"
              (append (json prompt) "}]}"))))
  end.

(** the grok launch with its header text after the mode *)
grok_launch (hdr : string) (launch : list string) : list string :=
  match launch with
  | prog :: lim :: mode :: args => prog :: lim :: mode :: hdr :: args
  | _ => launch
  end.

(** Starting the model process; when it couldn't start, its output is
    here at once, and what it becomes is queued. *)
llm_begin_prog (id kind prompt input : string) (ctx clean launch env : list string) : nprog bool :=
  nbind (nask (IoLlmStart id kind prompt input ctx clean launch env)) (fun started =>
  match ans_found started with
  | None => NDone true
  | Some ev => nbind (model_output_prog ev) queue_prog
  end).

(** a tool checkout's answer: its directories and whether it worked *)
tool_made (a : nanswer) : (string * string) * bool :=
  match ans_list a with [wt, gd, ok] => ((wt, gd), seq ok "true") | _ => (("", ""), false) end.

(** A model call, asked: a fence token, the backend, the environment, the
    prompt assembled, and for a cmd: patch its tool checkout, then the
    process started; each an operation, in the order the bindings were. *)
llm_call_prog (id kind prompt : string) (ctx : list string) : nprog bool :=
  nbind (nask (IoRandomHex "8")) (fun tok =>
  let token := ans_one tok in
  nbind (nask IoLimitInfo) (fun limit =>
  let backend := hd "" (ans_list limit) in
  match backend_launch backend with
  | [] => nexec (IoQueue ["llm_error", id, append "unknown backend " backend])
  | launch =>
      nbind (nask IoEnvEntries) (fun envs =>
      let all_env := ans_list envs in
      nbind (prompt_prog token prompt ctx (llm_repos_prog token) (llm_plan_prog token) (llm_repo_prog token)) (fun text =>
      if seq (launch_mode launch) "grok" then
        match grok_request nio_json_string all_env text with
        | None => nexec (IoQueue ["llm_error", id, "backend grok needs XAI_API_KEY"])
        | Some (hdr, body) => llm_begin_prog id kind prompt body ctx [] (grok_launch hdr launch) all_env
        end
      else if seq (launch_mode launch) "cmd" then
        nbind (nask IoRepoNames) (fun names =>
        let co := llm_checkout kind ctx (ans_list names) in
        nbind (match co with
               | Some r => nbind (nask (IoToolCheckout r)) (fun m => NDone (Some (tool_made m)))
               | None => NDone None
               end) (fun made =>
        nbind (nask IoSelfExe) (fun self =>
        let (l, rest) := tool_launch launch (model_env_entries all_env) (tool_job_of co made (ans_one self)) in
        llm_begin_prog id kind prompt text ctx (snd rest) l (fst rest))))
      else llm_begin_prog id kind prompt text ctx [] launch (model_env_entries all_env)))
  end)).

(** A model call (the "llm" output), as a node program: the budget (the
    count bumped for this call), the clock and the limit, then the gate. *)
llm_prog (id kind prompt : string) (ctx : list string) : nprog bool :=
  nbind (nask IoLlmBudget) (fun b =>
  let (calls, max) := match ans_list b with [c, m] => (c, m) | _ => ("", "") end in
  nbind (nask IoClock) (fun clock =>
  let now := ans_float clock in
  nbind (nask IoLimitInfo) (fun limit =>
  let until := ans_float limit in
  let backend := hd "" (ans_list limit) in
  match llm_gate_of calls max now until with
  | LlmOverBudget => nexec (IoQueue ["llm_error", id, llm_budget_text max])
  | LlmHeld =>
      nand (nexec (IoLog (llm_hold_text id kind backend
                            (float_text (PrimFloat.div (PrimFloat.sub until now) 60%float)))))
           (fun _ => nexec (IoLlmHold id kind prompt ctx))
  | LlmAsk =>
      nand (nexec (IoLog (llm_ask_text backend kind id calls max))) (fun _ => llm_call_prog id kind prompt ctx)
  end))).

(** The status file, as a node program: its facts are operations, read
    in the order the bindings were (the checkouts' heads, the divergences,
    the clock, the limit, and the limit's end as a time of day only when
    a limit is on). *)
status_prog (lines : list string) : nprog bool :=
  nbind (nask IoCheckoutHeads) (fun heads =>
  nbind (nask IoDivergences) (fun bad =>
  nbind (nask IoClock) (fun now =>
  nbind (nask IoLimitInfo) (fun limit =>
  let until := ans_float limit in
  let (backend, rest) := match ans_list limit with b :: r => (b, r) | [] => ("", []) end in
  let (held, reason) := match rest with x :: y :: _ => (x, y) | [x] => (x, "") | [] => ("", "") end in
  let limited := status_limit_active (ans_float now) until in
  let write clock := nexec (IoWriteStatus (status_output lines (ans_pairs heads) (ans_pairs bad)
                                             limited backend clock held reason)) in
  if limited then nbind (nask (IoLocalTime (float_wire until))) (fun t => write (ans_one t))
  else write "")))).

(** What an output does, as a node program: its reads are operations
    ([IoDraw], [IoBlock], [IoHeight], [IoPeerCount], the signed-vote
    table, the check exclusions, the status file's facts, a merge's
    checkout work, a model call's), and so is everything it does. *)
output_prog (out : list string) : nprog bool :=
  match plan_output out with
  | SetTimer ms ev => nexec (IoTimer ms ev)
  | WriteLog text => nexec (IoLog text)
  | RecordLeader previous digest entry => nexec (IoLeaderRecord previous digest entry)
  | RevealLink term tip =>
      nbind (nask IoDraw) (fun draw =>
      let (byz, chain) := ans_draw draw in
      let (limit, secret) := chain in
      actions_prog (reveal_plan byz limit secret term tip))
  | DecidedBlock height txs =>
      nbind (nask (IoBlock height)) (fun block =>
      actions_prog (decided_plan height txs (ans_found block)))
  | SetHeight height => nexec (IoSetHeight height)
  | CatchupPeer who first =>
      nbind (nask IoClock) (fun clock =>
      nbind (nask (IoServedAt who first)) (fun last =>
      nbind (nask IoDraw) (fun draw =>
      nbind (nask IoHeight) (fun current =>
      nbind (nask (IoPeerExists who)) (fun has_peer =>
      actions_prog (catchup_plan who first (ans_one current) (ans_float clock)
                      (served_result last) (fst has_peer) (seq (fst (ans_draw draw)) "silent")))))))
  | WriteStatus lines => status_prog lines
  | SubmitTransaction nonce fields =>
      nbind (nask IoDraw) (fun draw =>
      nbind (nask IoNonceFlooded) (fun flooded =>
      actions_prog (submission_plan (fst (ans_draw draw)) (fst flooded) nonce fields)))
  | Broadcast fields =>
      nbind (nask IoDraw) (fun draw =>
      nbind (nask IoPeerCount) (fun count =>
      let byz := fst (ans_draw draw) in
      let n := num (ans_one count) in
      match broadcast_subject fields with
      | None => actions_prog (broadcast_plan byz n fields None None None)
      | Some (k, ht, r, vid) =>
          let slot := broadcast_key k ht r in
          nbind (nask (IoSignedVote slot)) (fun vote =>
          nbind (nask (IoSignedBody slot)) (fun body =>
          actions_prog (broadcast_plan byz n fields (Some (k, ht, r, vid))
                          (ans_found_one vote) (ans_found body))))
      end))
  | CheckRequest id r head edits =>
      nbind (nask IoCheckExclusions) (fun ex =>
      let (denied, excluded) := ans_exclusions ex in
      nexec (check_request_op id r head edits denied excluded))
  | MergeRequest r v tree bid task bidder spec edits => merge_prog r v tree bid task bidder spec edits
  | LlmRequest id kind prompt ctx => llm_prog id kind prompt ctx
  | FinishNode ms => nexec (IoTimer ms ["finished"])
  | ExitNode code => nexec (IoExit code)
| LegacyOutput _ => NDone true
  end.

(** A vote signed ahead of its snapshot ([sign_effects]): written to the
    signed-vote table and signed.log unless its slot has one. Sending it
    is the broadcast's, after the snapshot, which finds it signed and so
    doesn't sign it again; a different vote at a slot already signed is
    the broadcast's to refuse or send as it was. *)
sign_prog (fields : list string) : nprog bool :=
  match broadcast_subject fields with
  | Some (k, ht, r, vid) =>
      let slot := broadcast_key k ht r in
      nbind (nask (IoSignedVote slot)) (fun vote =>
      match ans_found_one vote with
      | Some _ => NDone true
      | None => nexec (IoSignVote slot vid fields)
      end)
  | None => NDone true
  end.

(** Effects return whether they were carried out, and the loop keeps the
    new state only when they were: a unit result would be a cast the
    extraction can erase, and with it the call. *)
carry_effect_prog (snap : consensus_state) (eff : list string) : nprog bool :=
  match eff with
  | "perform" :: out => output_prog out
  | ["save_snapshot"] => nexec (IoSnapshotSave (snapshot_text snap))
  | ["refuse", raw] => nexec (IoRefuse raw)
  | "sign" :: fields => sign_prog fields
  | _ => NDone true
  end.

Fixpoint carry_all_prog (snap : consensus_state) (effs : list (list string)) : nprog bool :=
  match effs with
  | [] => NDone true
  | e :: rest => nand (carry_effect_prog snap e) (fun _ => carry_all_prog snap rest)
  end.

(** A model request held for a limit, handed back by the shell once the
    limit's wait is over: asked now, its prompt assembled again, with no
    second count against the budget. It isn't a [step] event: the state is
    the same either way (the branches differ only so extraction keeps the
    call). *)
(** A peer line, parsed by the shell (JSON and signature stay
    bindings): dropped when it is this node's own or an
    already-refused transaction -- neither pays for a verify -- and
    otherwise turned into the event it carries once verified. *)
(** The peer JSON scan has the old depth four and caller-supplied item
    cap. Invalid structure is refused before any JSON member reads. *)
peer_line_shape (items raw : string) : bool := shallow_json "4" items raw.

peer_wire_fields (me : string) (refused : string -> bool)
    (parts : option (string * (string * list string))) : list string :=
  match parts with
  | None => []
  | Some (from, (sig, fields)) =>
      let self := if seq from me then "1" else "0" in
      let seen := match fields with
                  | ["tx", raw] => if refused raw then "1" else "0"
                  | _ => "0"
                  end in
      "peer_line" :: self :: seen :: from :: sig :: fields
  end.

(** A peer line's members, read in Soma from the yojson binding's tokens
    with Yojson.Safe.Util's old rules: the first key that matches wins, and
    a missing member, a member of another kind or a non-object is None.
    One walk over the top level's members, skipping each value with one
    shared fuel (every step uses a token), so a wide object costs linear
    work, never a recount per member. A member's value is kept as the
    token tail where it starts, read after the walk. *)
peer_first (k key : string) (rest : list string) (cur : option (list string)) : option (list string) :=
  match cur with
  | Some _ => cur
  | None => if seq key k then Some rest else None
  end.

Fixpoint peer_members_go (fuel left : nat) (pending : list bool) (toks : list string)
    (from sg fields : option (list string))
    : option (option (list string) * (option (list string) * option (list string))) :=
  match fuel with
  | 0 => None
  | Succ f =>
      match pending with
      | true :: p =>
          match toks with
          | _ :: rest => peer_members_go f left p rest from sg fields
          | [] => None
          end
      | false :: p =>
          match toks with
          | "A" :: ns :: rest =>
              peer_members_go f left (flat_map (fun _ => [true, false]) (List.seq 0 (num ns)) ++ p) rest from sg fields
          | "L" :: ns :: rest =>
              peer_members_go f left (map (fun _ => false) (List.seq 0 (num ns)) ++ p) rest from sg fields
          | "U" :: rest => peer_members_go f left p rest from sg fields
          | _ :: _ :: rest => peer_members_go f left p rest from sg fields
          | _ => None
          end
      | [] =>
          match left, toks with
          | 0, _ => Some (from, (sg, fields))
          | Succ l, key :: rest =>
              peer_members_go f l [false] rest
                (peer_first "from" key rest from) (peer_first "sig" key rest sg)
                (peer_first "fields" key rest fields)
          | Succ _, [] => None
          end
      end
  end.

(** A JSON list of strings, tail recursive (a block's list can be long). *)
Fixpoint peer_strings_go (n : nat) (toks acc : list string) : option (list string) :=
  match n, toks with
  | 0, _ => Some (rev_onto acc [])
  | Succ j, "S" :: s :: rest => peer_strings_go j rest (s :: acc)
  | _, _ => None
  end.

peer_string_list (toks : list string) : option (list string) :=
  match toks with
  | "L" :: n :: rest => peer_strings_go (num n) rest []
  | _ => None
  end.

peer_line_parts (toks : list string) : option (string * (string * list string)) :=
  match toks with
  | "A" :: ns :: rest =>
      match peer_members_go (Succ (length rest)) (num ns) [] rest None None None with
      | Some (Some ("S" :: from :: _), (Some ("S" :: sig :: _), Some fv)) =>
          match peer_string_list fv with
          | Some fields => Some (from, (sig, fields))
          | None => None
          end
      | _ => None
      end
  | _ => None
  end.

(** What the shell's Yojson member reads gave: the line through the JSON
    token binding, then its members in Soma. *)
node_line_parts (raw : string) : option (string * (string * list string)) :=
  match json_tokens raw with
  | Some toks => peer_line_parts toks
  | None => None
  end.

peer_raw_event (items me raw : string)
    (parts : string -> option (string * (string * list string)))
    (refused : string -> bool) : list string :=
  if peer_line_shape items raw then peer_wire_fields me refused (parts raw) else [].

line_dropped (self refused : string) : bool :=
  seq self "1" || seq refused "1".

line_event (from : string) (fields : list string) : list string :=
  match fields with
  | ["tx", raw] => ["tx", raw]
  | _ => "msg" :: from :: fields
  end.


(** ---- Step 5, connection admission and line limits, in Soma ----
    [admit_decision_of] is the old accept test: at the per-host cap the
    new socket is refused; at the overall cap the quietest connection
    (the one [oldest_conn] names, first of equals in list order) makes
    room; otherwise the socket joins. [buffer_over] is the buffered-line
    byte cap, compared as numbers the bindings pass as decimal strings,
    never as unary literals built in Soma. *)
Inductive admit_decision := AdmitRefuse | AdmitEvict | AdmitNew.

admit_decision_of (same_host total : nat) : admit_decision :=
  if 16 <=? same_host then AdmitRefuse
  else if 64 <=? total then AdmitEvict
  else AdmitNew.

Fixpoint oldest_go (best : string * float) (rest : list (string * float)) : string :=
  match rest with
  | [] => fst best
  | (id, last) :: r =>
      if PrimFloat.ltb last (snd best) then oldest_go (id, last) r
      else oldest_go best r
  end.

oldest_conn (l : list (string * float)) : string :=
  match l with [] => "" | b :: r => oldest_go b r end.

buffer_over (len limit : nat) : bool := limit <? len.

(** An offered socket's counts, from the host it came from and the hosts
    of the connections held when it was accepted (the shell lists them; it
    no longer counts): how many share its host, and how many there are.
    At most 64 connections are held, so these are small numbers. *)
conn_offer_counts (host : string) (hosts : list string) : nat * nat :=
  (length (filter (fun x => seq x host) hosts), length hosts).

(** The event the offer becomes: what [admit_decision_of] decides on. *)
conn_offer_decision (host : string) (hosts : list string) : admit_decision :=
  let (same, total) := conn_offer_counts host hosts in admit_decision_of same total.


(** ---- Step 5, bytes into lines, in Soma ----
    A connection's buffer is its read chunks, in order, never joined
    until a newline arrives in the newest one: then the completed
    lines are joined once (as the shell's Buffer.contents did), and
    the trailing partial line stays as one chunk. So how the bytes
    were split into reads changes nothing, and a long line costs its
    length once, not once per read. [feed_chunks] returns the complete
    lines and the chunks to keep; [chunks_len] is their byte count,
    for [buffer_over]. *)
feed_chunks (chunks : list string) (chunk : string) : list string * list string :=
  match find_str newline chunk 0 with
  | None => ([], chunks ++ [chunk])
  | Some _ =>
      let parts := split_lines (Stdlib.Strings.String.concat "" (chunks ++ [chunk])) in
      (firstn (length parts - 1) parts,
       match last_n 1 parts with [rest] => if seq rest "" then [] else [rest] | _ => [] end)
  end.

Fixpoint chunks_len (chunks : list string) : nat :=
  match chunks with [] => 0 | c :: r => slen c + chunks_len r end.

chunks_join (chunks : list string) : string := Stdlib.Strings.String.concat "" chunks.

(** The tail a flooded job keeps, one 64 KiB read, as a decimal string:
    not a unary nat. *)
job_keep_text : string := "65536".

(** A job's buffered chunks plus one read. Under the output cap the chunk
    is kept on its own, so a long output is not rebuilt on every read.
    Past the cap ([buffer_over] of the new length) the last [keep] bytes
    of the whole buffer stay, as one chunk: the end a failed check shows.
    The shell only reads the descriptor, stores these chunks and, when
    this says the job is over, signals the process once. The outcome text
    is still [job_result]. *)
job_feed (chunks : list string) (chunk : string) (limit keep : nat) : list string * bool :=
  if limit <? chunks_len chunks + slen chunk then
    let joined := chunks_join (chunks ++ [chunk]) in
    let n := slen joined in
    (* [n <= keep] keeps the whole buffer: the tail is everything, and the
       subtraction stays in range once [nat] is an OCaml int *)
    let tail := if n <=? keep then joined else substr joined (n - keep) keep in
    ([tail], true)
  else (chunks ++ [chunk], false).

(** One peer read's complete parsing plan. Complete lines are queued even
    when the trailing partial exceeds the cap, before closing the socket. *)
Record peer_feed_result := {
  peer_lines : list string;
  peer_kept : list string;
  peer_over : bool
}.

peer_feed_n (chunks : list string) (chunk : string) (limit : nat) : peer_feed_result :=
  let (lines, kept) := feed_chunks chunks chunk in
  {| peer_lines := lines; peer_kept := kept;
     peer_over := buffer_over (chunks_len kept) limit |}.

peer_feed (chunks : list string) (chunk limit : string) : peer_feed_result :=
  peer_feed_n chunks chunk (num limit).

(** The longest line a peer may leave buffered: a proposal of 60
    transactions at the transaction byte cap, each quoted (at most twice
    its bytes). The cap arrives as a decimal string ([tx_byte_cap]); the
    product is an OCaml int by extraction, never a unary literal. *)
peer_line_cap (tx_cap : string) : nat := num tx_cap * 120.

(** One peer read, whole: the chunks to keep, the events its complete
    lines become (each a [peer_raw] fact, in order, which [run_event]
    turns into a [peer_line] and then a [tx] or [msg]), and whether the
    connection is closed for the cap. An empty read keeps the buffer and
    makes no event; EOF is the shell's [peer_closed]. *)
peer_read_events (chunks : list string) (chunk : string) (limit : nat)
    : list string * (list (list string) * bool) :=
  let r := peer_feed_n chunks chunk limit in
  (peer_kept r, (map (fun l => ["peer_raw", l]) (peer_lines r), peer_over r)).

(** How an offered socket is carried out: the mode the shell takes
    ("refuse", "new" or "evict") and, when evicting, the connection to
    close: the one [oldest_conn] names among the live ones. *)
conn_admit_plan (d : admit_decision) (conns : list (string * float)) : string * string :=
  match d with
  | AdmitRefuse => ("refuse", "")
  | AdmitNew => ("new", "")
  | AdmitEvict => ("evict", oldest_conn conns)
  end.

(** A local transaction the operator drops in the node's inbox: a JSON list
    of strings, read through the JSON token binding. Anything else (not
    JSON, not a list, an element that isn't a string) is malformed and
    becomes no event. *)
Fixpoint inbox_strings (k : nat) (toks : list string) : option (list string) :=
  match k, toks with
  | 0, [] => Some []
  | Succ j, "S" :: s :: rest =>
      match inbox_strings j rest with Some r => Some (s :: r) | None => None end
  | _, _ => None
  end.

inbox_tx (tokens : option (list string)) : option (list string) :=
  match tokens with
  | Some ("L" :: n :: rest) => inbox_strings (num n) rest
  | _ => None
  end.

(** ---- A CI check's outcome (step 5) ----
    The shell hands back a CI run's raw output as a ci_done fact. Whether
    it passed, whose a failure is, and why are decided here from the node's
    own signals only: the "!process failed (HOW): " prefix and its exit
    code, never what the bid printed (docs/SECURITY-REVIEW-2.md P-6). The
    runner failing to start or exiting with a code of its own (1 to 127,
    neither the bid's 86 nor timeout's 124) is this node's problem; a run
    ended by a signal is the bid's. *)
ci_job_how (t : string) : option string :=
  let pre := "!process failed (" in
  if (slen pre <? slen t) && starts pre t then
    let rest := drop_str (slen pre) t in
    match find_str ")" rest 0 with Some i => Some (take_str i rest) | None => Some "" end
  else None.

Fixpoint ci_digits (fuel : nat) (s : string) (i : nat) : bool :=
  match fuel with
  | 0 => true
  | Succ f =>
      match char_at s i with
      | None => true
      | Some c => let n := nat_of_ascii c in if (48 <=? n) && (n <=? 57) then ci_digits f s (Succ i) else false
      end
  end.

ci_exit_code (how : string) : option nat :=
  if (5 <? slen how) && starts "exit " how then
    let d := drop_str 5 how in if ci_digits (slen d) d 0 then Some (num d) else None
  else None.

ci_node_problem (ok : bool) (how : option string) : bool :=
  if ok then false
  else match how with
       | None => true
       | Some h =>
           match ci_exit_code h with
           | Some c => (1 <=? c) && (c <? 128) && negb (c =? 86) && negb (c =? 124)
           | None => false
           end
       end.

ci_blank (c : ascii) : bool :=
  let n := nat_of_ascii c in Nat.eqb n 32 || Nat.eqb n 9 || Nat.eqb n 10 || Nat.eqb n 12 || Nat.eqb n 13.

Fixpoint ci_blank_from (fuel : nat) (s : string) (i : nat) : nat :=
  match fuel with
  | 0 => i
  | Succ f => match char_at s i with Some c => if ci_blank c then ci_blank_from f s (Succ i) else i | None => i end
  end.

Fixpoint ci_blank_back (fuel : nat) (s : string) (j : nat) : nat :=
  match fuel, j with
  | Succ f, Succ k => match char_at s k with Some c => if ci_blank c then ci_blank_back f s k else j | None => j end
  | _, _ => j
  end.

(** OCaml's String.trim: space, tab, newline, form feed, carriage return *)
ci_trim (s : string) : string :=
  let a := ci_blank_from (slen s) s 0 in
  let b := ci_blank_back (slen s) s (slen s) in
  if b <=? a then "" else substr s a (b - a).

(** the end of what CI said, on one line, where its error is *)
ci_tail (t : string) : string :=
  let one := ci_trim (replace_all (replace_all t newline " ") (SCons (ascii_of_nat 13) SNil) " ") in
  let n := slen one in
  append "CI failed: " (if 400 <? n then append "..." (substr one (n - 400) 400) else one).

(** passed, why, and the stage ("" passed, "node" this node's, "ci" the bid's) *)
ci_outcome (t : string) (sandbox : bool) (memory : string) : bool * (string * string) :=
  let ok := negb (starts "!" t) in
  let how_opt := ci_job_how t in
  let down := ci_node_problem ok how_opt in
  let how := match how_opt with Some h => h | None => "" end in
  let why :=
    if ok then ""
    else if down then append "node problem: " (append (if sandbox then "ci-sandbox: " else "docker: ") t)
    else if contains "printed more than" how then append "CI " (append how ": a check has to print less than that")
    else if seq how "exit 137" then append "CI went over its memory budget (" (append memory ", no swap): the build needs less memory than that to merge")
    else if seq how "exit 124" then "CI went over its time budget: the build has to finish within the limit its CI command gives"
    else ci_tail t in
  (ok, (why, if ok then "" else if down then "node" else "ci")).

(** A check that failed before CI (applying the bid's edits): the bid's
    when the check itself exited with its own code for that (1) or ended
    some other way it reports (a signal), this node's when the check
    couldn't run or exited with any other code. From the node's own
    signals only, never what the bid's edits printed. *)
check_apply_stage (t : string) : string :=
  match ci_job_how t with
  | None => "node"
  | Some h =>
      match ci_exit_code h with
      | Some c => if c =? 1 then "apply" else "node"
      | None => "apply"
      end
  end.

check_failed_prog (id t : string) : nprog bool :=
  nand (nexec (IoLog (append "check of request " (append id (append " failed: " t))))) (fun _ =>
  nexec (IoQueue (check_result_event id false "" t (check_apply_stage t)))).

ci_done_record_prog (id tree memory runner t : string) (evidence : list string) : nprog bool :=
  let (ok, rest) := ci_outcome t (seq runner "sandbox") memory in
  let (why, stage) := rest in
  nand (nexec (IoLog (append "CI for request " (append id (append ": " (if ok then "passed" else "failed")))))) (fun _ =>
  nand (if ok then NDone true
        else nexec (IoLog (append "CI for request " (append id (append " said: " (replace_all t newline " ")))))) (fun _ =>
  let result := check_result_event id ok tree why stage ++ evidence ++
    (if seq (kv_at evidence "check_key") "" then [] else ["verified_request", id]) ++
    (if seq (kv_at evidence "commit") "" then [] else ["details", take_str 3000 (clean_text (redact (ci_tail t)))]) in
  nand (if ok && negb (seq (kv_at evidence "check_key") "") then
    nexec (IoRememberCheck (kv_at evidence "check_key") (skipn 2 result)) else NDone true) (fun _ =>
  nexec (IoQueue result)))).

ci_done_prog (id tree memory runner t : string) : nprog bool := ci_done_record_prog id tree memory runner t [].

(** A peer line as the shell read it: its shape scanned, its members
    read, and for a transaction whether it was refused before
    ([IoSeenRefused], asked only then); this node's name ([IoIdentity])
    says whether it's its own. *)
peer_raw_prog (raw : string) : nprog (list string) :=
  nbind (nask IoIdentity) (fun me =>
  let shaped := peer_line_shape (show (Succ (slen raw))) raw in
  let parts := if shaped then node_line_parts raw else None in
  nbind (match parts with
         | Some (_, (_, ["tx", tx])) => nexec (IoSeenRefused tx)
         | _ => NDone false
         end) (fun seen =>
  NDone (if shaped then peer_wire_fields (ans_one me) (fun _ => seen) parts else []))).

(** a connection, a timer, a job on the wire *)
conns_of (ls : list (list string)) : list (string * float) :=
  flat_map (fun l => match l with [c, t] => [(c, float_of_digits t)] | _ => [] end) ls.

(** The step an event takes, and its effects carried: the new state only
    when they all were. *)
step_prog (st : node_state) (ev : list string) : nprog node_state :=
  let (s, outs) := step st ev in
  nbind (carry_all_prog (cons s) (order_effects ev st s outs)) (fun ok => NDone (if ok then s else st)).

kept (st : node_state) (ok : bool) : node_state := if ok then st else with_live st (live st).

(** One event, as a node program. *)
run_event_prog (st : node_state) (ev : list string) : nprog node_state :=
  nbind (match ev with ["peer_raw", raw] => peer_raw_prog raw | _ => NDone ev end) (fun ev =>
  match ev with
  | [] => NDone st
  | "llm_release" :: id :: kind :: prompt :: ctx =>
      nbind (llm_call_prog id kind prompt ctx) (fun ok => NDone (kept st ok))
  | "peer_line" :: self :: refused :: from :: sig :: fields =>
      if line_dropped self refused then NDone st
      else nbind (nask (IoPeerKey from)) (fun key =>
           if nio_line_verify (ans_list key) from sig fields then step_prog st (line_event from fields) else NDone st)
  | "conn_offer" :: oid :: host :: hosts =>
      let d := conn_offer_decision host hosts in
      nbind (match d with
             | AdmitEvict => nbind (nask IoConns) (fun a => NDone (conns_of (nio_lists (ans_list a))))
             | _ => NDone []
             end) (fun conns =>
      let (mode, target) := conn_admit_plan d conns in
      nbind (nexec (IoConnAdmit oid mode target)) (fun ok =>
      NDone (if ok then (if seq mode "evict" then peer_forget st target else st) else with_live st (live st))))
  | ["peer_closed", cid] => NDone (peer_forget st cid)
  | ["check_failed", id, t] => nbind (check_failed_prog id t) (fun ok => NDone (kept st ok))
  | "ci_done" :: id :: tree :: memory :: runner :: t :: evidence =>
      nbind (ci_done_record_prog id tree memory runner t evidence) (fun ok => NDone (kept st ok))
  | ["inbox_file", path, content] =>
      match inbox_tx (json_tokens content) with
      | Some fields => step_prog st ("local_tx" :: fields)
      | None => nbind (nexec (IoLog (append "ignoring malformed " path))) (fun ok => NDone (kept st ok))
      end
  | ["peer_bytes", cid, chunk] =>
      let (kept_lines, rest) := peer_read_events (peer_buffer st cid) chunk (peer_line_cap tx_byte_cap) in
      let (evs, over) := rest in
      let st := peer_remember st cid kept_lines in
      nbind (queue_prog evs) (fun queued =>
      if queued then
        if over then nbind (nexec (IoConnClose cid)) (fun ok => NDone (if ok then peer_forget st cid else with_live st (live st)))
        else NDone st
      else NDone (with_live st (live st)))
  | ["job_bytes", id, chunk] =>
      let (kept_out, over) := job_feed (job_buffer st id) chunk
                                (num job_output_limit) (num job_keep_text) in
      let st := job_remember st id kept_out in
      if over then nbind (nexec (IoJobFlood id)) (fun ok => NDone (kept st ok)) else NDone st
  | _ => step_prog st ev
  end).

Fixpoint run_events_prog (st : node_state) (evs : list (list string)) : nprog node_state :=
  match evs with
  | [] => NDone st
  | ev :: rest => nbind (run_event_prog st ev) (fun st => run_events_prog st rest)
  end.

(** After a limit's wait, held model requests go back: one first while the
    backoff is up (only when it comes back without the limit, which resets
    the backoff, do the rest go), all of them otherwise; none while the
    limit lasts, while that first one is out, or when none are held. *)
Inductive release_plan := ReleaseNone | ReleaseOne | ReleaseAll.

release_plan_of (held : nat) (over probing backed_off : bool) : release_plan :=
  if (held =? 0) || negb over || probing then ReleaseNone
  else if backed_off then ReleaseOne else ReleaseAll.

release_one_text (backend held : string) : string :=
  append "the limit's wait is over: asking " (append backend
    (append " one held request first (" (append held " held)"))).

release_all_text (backend held : string) : string :=
  append backend (append " answers again: asking its " (append held " held requests")).

(** Raw stored model requests become events here, including an absent
    single request. Context fields keep their exact bytes and order. *)
held_request_event (request : string * string * string * list string) : list string :=
  let '(id, kind, prompt, ctx) := request in "llm_release" :: id :: kind :: prompt :: ctx.

held_one_events (request : option (string * string * string * list string)) : list (list string) :=
  match request with None => [] | Some r => [held_request_event r] end.

(** A batch preserves the newest-first storage order and emits oldest
    first. Empty queues produce no event, as held_one_events None does. *)
held_request : Type := string * string * string * list string.
Record held_batch := {
  held_remaining : list held_request;
  held_probe : bool;
  held_events : list (list string)
}.
held_batch_of (plan : release_plan) (probing : bool) (requests : list held_request) : held_batch :=
  match plan with
  | ReleaseNone => {| held_remaining := requests; held_probe := probing; held_events := [] |}
  | ReleaseOne =>
      match rev_onto requests [] with
      | [] => {| held_remaining := []; held_probe := probing; held_events := [] |}
      | oldest :: rest => {| held_remaining := rev_onto rest []; held_probe := true;
                            held_events := [held_request_event oldest] |}
      end
  | ReleaseAll => {| held_remaining := []; held_probe := probing;
                    held_events := map held_request_event (rev_onto requests []) |}
  end.
(** a held request on the wire, and back *)
held_request_wire (r : string * string * string * list string) : list string :=
  match r with (id, kind, prompt, ctx) => id :: kind :: prompt :: ctx end.

held_requests_of (ls : list (list string)) : list (string * string * string * list string) :=
  flat_map (fun l => match l with id :: kind :: prompt :: ctx => [(id, kind, prompt, ctx)] | _ => [] end) ls.

held_batch_prog (plan : release_plan) (probing : bool) : nprog (list (list string)) :=
  nbind (nask IoHeldRequests) (fun held =>
  let batch := held_batch_of plan probing (held_requests_of (nio_lists (ans_list held))) in
  nbind (nexec (IoHeldStore (if held_probe batch then "true" else "false")
                            (map held_request_wire (held_remaining batch)))) (fun stored =>
  NDone (if stored then held_events batch else []))).

(** The held requests this turn gives back, oldest first, as llm_release
    events, as a node program: the limit, the release state, the clock,
    then the plan's log line and the store. *)
release_prog : nprog (list (list string)) :=
  nbind (nask IoLimitInfo) (fun limit =>
  let until := ans_float limit in
  let (backend, held) := match ans_list limit with b :: n :: _ => (b, n) | [b] => (b, "") | [] => ("", "") end in
  nbind (nask IoReleaseState) (fun release =>
  let backoff := ans_float release in
  let probing := seq (ans_one release) "true" in
  nbind (nask IoClock) (fun clock =>
  let over := negb (PrimFloat.ltb (ans_float clock) until) in
  match release_plan_of (num held) over probing (PrimFloat.ltb 900%float backoff) with
  | ReleaseNone => NDone []
  | ReleaseOne =>
      nbind (nexec (IoLog (release_one_text backend held))) (fun ok =>
      if ok then held_batch_prog ReleaseOne probing else NDone [])
  | ReleaseAll =>
      nbind (nexec (IoLog (release_all_text backend held))) (fun ok =>
      if ok then held_batch_prog ReleaseAll probing else NDone [])
  end))).

(** ---- Step 5: job deadlines and which timers fire ----
    A job is stopped once the elapsed time is greater than its limit, and
    not again after that. A timer fires when its deadline is at or before
    the turn's clock. Due timers are ordered as the shell's sort was:
    earliest deadline, then the event list byte by byte, and equal events
    in the order the list stored them. The select waits at most a fifth of
    a second, or until the next timer, and not at all when the queue
    already has an event. The shell samples one clock reading, stores the
    timers and signals the job Soma names. *)
job_should_expire (now started limit : float) (marked : bool) : bool :=
  negb marked && PrimFloat.ltb limit (PrimFloat.sub now started).

(** the operations a turn's deadline pass issues: one IoJobExpire per job
    past its limit and not yet marked, in the jobs' order *)
Fixpoint expire_ops (now : float) (jobs : list (string * (float * (float * bool)))) : list node_op :=
  match jobs with
  | [] => []
  | (id, (started, (limit, marked))) :: r =>
      if job_should_expire now started limit marked then IoJobExpire id :: expire_ops now r
      else expire_ops now r
  end.

(** operations in order, stopping at the first not carried out *)
Fixpoint ops_prog (ops : list node_op) : nprog bool :=
  match ops with [] => NDone true | op :: rest => ndo op (fun _ => ops_prog rest) end.

jobs_of (ls : list (list string)) : list (string * (float * (float * bool))) :=
  flat_map (fun l => match l with
                     | [id, started, limit, stopped] =>
                         [(id, (float_of_digits started, (float_of_digits limit, seq stopped "true")))]
                     | _ => []
                     end) ls.

(** Deadlines at or before [now], and the rest, each in list order. *)
Fixpoint timers_due (now : float) (l : list (float * list string))
    : list (float * list string) * list (float * list string) :=
  match l with
  | [] => ([], [])
  | p :: r =>
      let (d, later) := timers_due now r in
      if PrimFloat.leb (fst p) now then (p :: d, later) else (d, p :: later)
  end.

Inductive ord := OrdLt | OrdEq | OrdGt.

Fixpoint str_ord_go (fuel : nat) (a b : string) (i : nat) : ord :=
  match fuel with
  | 0 => OrdEq
  | Succ f =>
      match char_at a i, char_at b i with
      | None, None => OrdEq
      | None, Some _ => OrdLt
      | Some _, None => OrdGt
      | Some ca, Some cb =>
          let na := nat_of_ascii ca in
          let nb := nat_of_ascii cb in
          if na <? nb then OrdLt
          else if nb <? na then OrdGt
          else str_ord_go f a b (Succ i)
      end
  end.

str_ord (a b : string) : ord := str_ord_go (slen a + slen b + 1) a b 0.

Fixpoint strs_ord (a b : list string) : ord :=
  match a, b with
  | [], [] => OrdEq
  | [], _ => OrdLt
  | _, [] => OrdGt
  | x :: xs, y :: ys => match str_ord x y with OrdEq => strs_ord xs ys | c => c end
  end.

(** OCaml's polymorphic order on a (deadline, event) pair. *)
timer_ord (a b : float * list string) : ord :=
  if PrimFloat.ltb (fst a) (fst b) then OrdLt
  else if PrimFloat.ltb (fst b) (fst a) then OrdGt
  else strs_ord (snd a) (snd b).

(** Stable: an equal pair stays in front of the one inserted later. *)
Fixpoint insert_timer (x : float * list string) (l : list (float * list string))
    : list (float * list string) :=
  match l with
  | [] => [x]
  | y :: r => match timer_ord x y with OrdGt => y :: insert_timer x r | _ => x :: y :: r end
  end.

Fixpoint sort_timers (l : list (float * list string)) : list (float * list string) :=
  match l with
  | [] => []
  | x :: r => insert_timer x (sort_timers r)
  end.

Fixpoint timer_events (l : list (float * list string)) : list (list string) :=
  match l with [] => [] | (_, ev) :: r => ev :: timer_events r end.

float_min (a b : float) : float := if PrimFloat.ltb a b then a else b.

(** The old select cap, a fifth of a second. One divided by five is that
    double, so the literal that is not a binary64 value stays out. *)
select_cap : float := PrimFloat.div 1%float 5%float.

Fixpoint next_gap (now acc : float) (timers : list (float * list string)) : float :=
  match timers with
  | [] => acc
  | (t, _) :: r => next_gap now (float_min acc (PrimFloat.sub t now)) r
  end.

select_wait (now : float) (queue_empty : bool) (timers : list (float * list string)) : float :=
  if queue_empty then
    let gap := next_gap now select_cap timers in
    if PrimFloat.ltb gap 0%float then 0%float else gap
  else 0%float.

(** Local inbox acquisition. The selected names stay in readdir order;
    stamp before listing, and enqueue each fact before removing its file. *)
inbox_poll_due (now last : float) : bool :=
  PrimFloat.ltb 1%float (PrimFloat.sub now last).

inbox_json_name (name : string) : bool :=
  let n := slen name in
  (5 <=? n) && seq (substr name (n - 5) 5) ".json".

inbox_paths (directory : string) (names : list string) : list string :=
  map (fun name => append directory (append "/" name)) (filter inbox_json_name names).

Inductive inbox_file_action :=
| InboxQueue (path content : string)
| InboxRemove (path : string).

inbox_file_plan (path : string) (read : option string) : list inbox_file_action :=
  [InboxQueue path (match read with Some text => text | None => "" end), InboxRemove path].

Fixpoint inbox_actions_prog (actions : list inbox_file_action) : nprog bool :=
  match actions with
  | [] => NDone true
  | InboxQueue path content :: rest =>
      ndo (IoQueue ["inbox_file", path, content]) (fun _ => inbox_actions_prog rest)
  | InboxRemove path :: rest => ndo (IoDiscardFile path) (fun _ => inbox_actions_prog rest)
  end.

Fixpoint read_inbox_prog (paths : list string) : nprog bool :=
  match paths with
  | [] => NDone true
  | path :: rest =>
      nbind (nask (IoReadText path)) (fun got =>
      nand (inbox_actions_prog (inbox_file_plan path (ans_found_one got))) (fun _ => read_inbox_prog rest))
  end.

poll_inbox_prog : nprog bool :=
  nbind (nask IoInboxState) (fun inbox =>
  let last := ans_float inbox in
  let directory := ans_one inbox in
  nbind (nask IoTurnNow) (fun turn =>
  let now := ans_float turn in
  if inbox_poll_due now last then
    ndo (IoInboxStamp (float_wire now)) (fun _ =>
    nbind (nask (IoDirEntries directory)) (fun names =>
    read_inbox_prog (inbox_paths directory (ans_list names))))
  else NDone true)).

timers_of (ls : list (list string)) : list (float * list string) :=
  flat_map (fun l => match l with d :: ev => [(float_of_digits d, ev)] | [] => [] end) ls.

timer_wire (t : float * list string) : list string := float_wire (fst t) :: snd t.

(** Stop overdue jobs, keep the timers that have not fired, and queue the
    due ones. Dial, resend and the inbox have already run, so their events
    stay ahead of these, and both run before select. *)
clock_arm_prog : nprog bool :=
  nbind (nask IoTurnNow) (fun turn =>
  let now := ans_float turn in
  nbind (nask IoTimers) (fun timers =>
  let (due, later) := timers_due now (timers_of (nio_lists (ans_list timers))) in
  nbind (nask IoJobs) (fun jobs =>
  nand (ops_prog (expire_ops now (jobs_of (nio_lists (ans_list jobs))))) (fun _ =>
  ndo (IoSetTimers (map timer_wire later)) (fun _ =>
  queue_prog (timer_events (sort_timers due))))))).

(** A turn of the event loop, as one node program: released requests
    first; then dial, resend and the inbox, then deadlines and due timers,
    then one select, and what its events become. The binary runs it with
    [run_shell], an image with Sandbox's [run_image]. *)
node_tick_prog (st : node_state) : nprog node_state :=
  nbind release_prog (fun released =>
  nbind (run_events_prog st released) (fun st =>
  nbind (nexec IoPollPrep) (fun prepped =>
  if negb prepped then NDone st else
  nbind poll_inbox_prog (fun polled =>
  if negb polled then NDone st else
  nbind clock_arm_prog (fun armed =>
  if negb armed then NDone st else
  nbind (nask IoTurnNow) (fun turn =>
  nbind (nask IoQueueEmpty) (fun empty =>
  nbind (nask IoTimers) (fun timers =>
  let wait := select_wait (ans_float turn) (fst empty) (timers_of (nio_lists (ans_list timers))) in
  nbind (nask (IoEvents (float_wire wait))) (fun got =>
  nbind (job_outputs_prog st (nio_lists (ans_list got))) (fun r =>
  let (st, evs) := r in run_events_prog st evs)))))))))).

(** Replay has no consensus snapshot effects, just as before: a restored
    snapshot is checked against the fully replayed height before start. *)
Fixpoint outputs_prog (outs : list (list string)) : nprog bool :=
  match outs with
  | [] => NDone true
  | out :: rest => nand (output_prog out) (fun _ => outputs_prog rest)
  end.

(** One blocks.log line, as the yojson binding's tokens. The height has to
    be the next one ([expect], an int), and every transaction a string;
    anything else is skipped, as a line that failed to parse was. *)
Fixpoint json_strings_go (n : nat) (toks : list string) : option (list string) :=
  match n, toks with
  | 0, _ => Some []
  | Succ j, "S" :: s :: rest =>
      match json_strings_go j rest with Some r => Some (s :: r) | None => None end
  | _, _ => None
  end.

json_string_list (toks : list string) : option (list string) :=
  match toks with
  | "L" :: n :: rest => json_strings_go (num n) rest
  | _ => None
  end.

json_int (toks : list string) : option string :=
  match toks with "I" :: s :: _ => Some s | _ => None end.

block_log_replay (toks : option (list string)) (expect : string) : option (string * list string) :=
  match toks with
  | None => None
  | Some t =>
      let hv := match json_member "h" t with Some v => v | None => [] end in
      match json_int hv with
      | None => None
      | Some h =>
          if negb (seq h expect) then None else
          match json_member "txs" t with
          | None => None
          | Some v =>
              match json_string_list v with Some txs => Some (h, txs) | None => None end
          end
      end
  end.

(** The boot events, as a node program: each step's outputs carried, the
    first not carried out stopping the replay where it is. *)
Fixpoint run_boot_prog (st : node_state) (evs : list (list string)) : nprog node_state :=
  match evs with
  | [] => NDone st
  | ("applied_body" :: repo :: body :: _) :: rest =>
      nbind (nexec (IoMergeApplied repo (commit_version body))) (fun ok =>
      if ok then run_boot_prog st rest else NDone st)
  | ("block_log" :: line :: _) :: rest =>
      match block_log_replay (json_tokens line) (show (height (cons st))) with
      | None => run_boot_prog st rest
      | Some (bh, txs) =>
          nbind (nexec (IoRememberBlock bh txs)) (fun remembered =>
          if remembered then
            let (s, outs) := step st ("replay" :: bh :: txs) in
            nbind (outputs_prog outs) (fun ok => if ok then run_boot_prog s rest else NDone st)
          else run_boot_prog st rest)
      end
  | ev :: rest =>
      let (s, outs) := step st ev in
      nbind (outputs_prog outs) (fun ok => if ok then run_boot_prog s rest else NDone st)
  end.

(** Start always persists its snapshot before any vote, including when the
    restored consensus is unchanged. Decisions still reach blocks.log first. *)
startup_effects (outs : list (list string)) : list (list string) :=
  map (fun out => "perform" :: out) (filter is_decided outs) ++
  sign_effects outs ++ [["save_snapshot"]] ++
  map (fun out => "perform" :: out) (filter (fun out => negb (is_decided out)) outs).

start_node_prog (st : node_state) : nprog node_state :=
  let (s, outs) := step st ["start"] in
  nbind (carry_all_prog (cons s) (startup_effects outs)) (fun ok => NDone (if ok then s else st)).

(** Started again, the node sends what it signed at its height again and
    keeps it in resend memory, as when it first sent it. Resend memory
    doesn't outlive the process, and the snapshot says these were sent:
    consensus doesn't ask for them again. A node stopped after signing a
    vote (signed.log, then the snapshot) and before sending it would never
    send it, and with exactly a quorum up the others wait for it, and it
    with them. *)
resume_plan (byz : string) (peers : nat) (signed : list (list string)) : list output_action :=
  flat_map (broadcast_deliver byz peers) signed.

resume_signed_prog (st : node_state) : nprog bool :=
  nbind (nask (IoSignedAt (show (height (cons st))))) (fun signed =>
  nbind (nask IoDraw) (fun draw =>
  nbind (nask IoPeerCount) (fun count =>
  actions_prog (resume_plan (fst (ans_draw draw)) (num (ans_one count)) (nio_lists (ans_list signed)))))).

(** ---- signed.log at startup (step 5) ----
    Each line is "SLOT VID VOTE-AS-JSON". A line with no space is not a
    vote and is passed over quietly. A line cut short (a node stopped while
    writing it) is no vote either: the line is written before the vote is
    sent, so that vote never went out, and taking it as signed, with
    nothing to send again, left a node refusing to vote at that height. It
    is said and skipped: no vote after the slot, a value id that is
    neither empty nor 64 bytes, or a vote that isn't a JSON list of
    strings. [tokens] is the yojson binding's (json_tokens). *)
Inductive signed_entry :=
| SignedVote (slot vid : string) (fields : list string)
| SignedCut (slot why : string)
| SignedSkip.

signed_log_entry (tokens : string -> option (list string)) (line : string) : signed_entry :=
  match find_str " " line 0 with
  | None => SignedSkip
  | Some i =>
      let k := substr line 0 i in
      let rest := drop_str (i + 1) line in
      match find_str " " rest 0 with
      | None => SignedCut k "no vote in it"
      | Some j =>
          let v := substr rest 0 j in
          let js := drop_str (j + 1) rest in
          if negb (seq v "") && negb (slen v =? 64) then SignedCut k "its value id is cut"
          else
            match tokens js with
            | None => SignedCut k "its vote doesn't parse"
            | Some t =>
                match json_string_list t with
                | Some f => SignedVote k v f
                | None => SignedCut k "its vote doesn't parse"
                end
            end
      end
  end.

signed_cut_text (slot why : string) : string :=
  append "signed.log: skipping " (append slot (append ", a line cut short ("
    (append why "): that vote was never sent"))).

(** The lines in order (a later line for a slot replaces an earlier one, in
    the shell's table). The second of the pair: whether any vote was read. *)
Fixpoint restore_signed_prog (lines : list string) (found : bool) : nprog (bool * bool) :=
  match lines with
  | [] => NDone (true, found)
  | l :: rest =>
      match signed_log_entry json_tokens l with
      | SignedVote k v f =>
          nbind (nexec (IoSignedRestore k v f)) (fun ok =>
          if ok then restore_signed_prog rest true else NDone (false, found))
      | SignedCut k why =>
          nbind (nexec (IoLog (signed_cut_text k why))) (fun ok =>
          if ok then restore_signed_prog rest found else NDone (false, found))
      | SignedSkip => restore_signed_prog rest found
      end
  end.

(** A log file's lines (blocks.log, signed.log) and a --goal file: the bytes
    split at each newline, empty lines dropped, as the shell's old [lines]
    did with String.split_on_char. A missing file comes as "", which has
    none. [split_lines] reads by offset, so a long log is one pass. *)
log_lines (text : string) : list string := filter (fun l => negb (seq l "")) (split_lines text).

(** One --goal file, in order. The shell feeds its bytes as one goal_text
    boot event ("" when the file is missing). *)
goal_events (text : string) : list (list string) :=
  map (fun l => ["agent", "goal", l]) (log_lines text).

(** Votes signed with no consensus.state to go with them: a node that
    started would forget its lock, so it doesn't start. *)
signed_needs_snapshot (snapshot_missing votes_found : bool) : bool := snapshot_missing && votes_found.

signed_missing_text : string := "missing consensus.state with existing votes: start a new chain".

(** ---- genesis.json at startup (step 5) ----
    The shell only reads the file; Soma turns its JSON tokens (the yojson
    binding's) into the boot events, in the old order: the roster, each
    agent's tip, block_ms, the params in file order (repeats included), the
    repositories, then each agent's excludes. A member is its object's
    first such key, as Yojson's member read it. Every walk shares one fuel
    bound and skips each value once, so a wide genesis costs linear work,
    and there is no cap on how many agents, params or excludes it holds.
    What the old reads refused (a tip, name or param that isn't a string,
    a block_ms that isn't an int, an exclude that isn't a string) gives
    None, and the node refuses to start. *)
Fixpoint genesis_pairs_go (fuel n : nat) (toks : list string) (acc : list (string * list string))
    : option (list (string * list string)) :=
  match n with
  | 0 => Some (rev_onto acc [])
  | Succ m =>
      match toks with
      | key :: rest =>
          match json_skip fuel [false] rest with
          | Some after => genesis_pairs_go fuel m after ((key, rest) :: acc)
          | None => None
          end
      | [] => None
      end
  end.

Fixpoint genesis_items_go (fuel n : nat) (toks : list string) (acc : list (list string))
    : option (list (list string)) :=
  match n with
  | 0 => Some (rev_onto acc [])
  | Succ m =>
      match json_skip fuel [false] toks with
      | Some after => genesis_items_go fuel m after (toks :: acc)
      | None => None
      end
  end.

(** an object's members, each with the tokens where its value starts *)
genesis_pairs (fuel : nat) (toks : list string) : option (list (string * list string)) :=
  match toks with
  | "A" :: ns :: rest => genesis_pairs_go fuel (num ns) rest []
  | _ => None
  end.

(** a list's elements, each as the tokens where it starts *)
genesis_items (fuel : nat) (toks : list string) : option (list (list string)) :=
  match toks with
  | "L" :: ns :: rest => genesis_items_go fuel (num ns) rest []
  | _ => None
  end.

Fixpoint genesis_member (k : string) (pairs : list (string * list string)) : option (list string) :=
  match pairs with
  | [] => None
  | (key, v) :: rest => if seq key k then Some v else genesis_member k rest
  end.

genesis_text (v : option (list string)) : option string :=
  match v with Some ("S" :: s :: _) => Some s | _ => None end.

(** One agent: its name, its tip and its excludes (absent or not a list:
    none, as before; a list must hold strings). *)
genesis_agent (fuel : nat) (a : list string) : option (string * (string * list string)) :=
  match genesis_pairs fuel a with
  | None => None
  | Some ps =>
      match genesis_text (genesis_member "name" ps), genesis_text (genesis_member "tip" ps) with
      | Some name, Some tip =>
          match genesis_member "exclude" ps with
          | Some (("L" :: _) as ex) =>
              match peer_string_list ex with
              | Some rs => Some (name, (tip, rs))
              | None => None
              end
          | _ => Some (name, (tip, []))
          end
      | _, _ => None
      end
  end.

Fixpoint genesis_all {A B : Type} (f : A -> option B) (l : list A) (acc : list B) : option (list B) :=
  match l with
  | [] => Some (rev_onto acc [])
  | x :: r => match f x with Some y => genesis_all f r (y :: acc) | None => None end
  end.

genesis_param (kv : string * list string) : option (list string) :=
  match genesis_text (Some (snd kv)) with
  | Some v => if genesis_param_valid (fst kv) v then Some ["param", fst kv, v] else None
  | None => None
  end.

genesis_repo (fuel : nat) (r : list string) : option (list string) :=
  match genesis_pairs fuel r with
  | Some ps =>
      match genesis_text (genesis_member "name" ps), genesis_text (genesis_member "tree" ps) with
      | Some n, Some tree => Some ["repo", n, tree]
      | _, _ => None
      end
  | None => None
  end.

genesis_events (tokens : option (list string)) : option (list (list string)) :=
  match tokens with
  | None => None
  | Some t =>
      let fuel := Succ (length t) in
      match genesis_pairs fuel t with
      | None => None
      | Some top =>
          let items (k : string) : option (list (list string)) :=
                       match genesis_member k top with
                         | Some v => genesis_items fuel v
                         | None => None
                         end in
          match items "agents", genesis_member "block_ms" top,
                (match genesis_member "params" top with Some v => genesis_pairs fuel v | None => None end),
                items "repos" with
          | Some agents, Some ("I" :: ms :: _), Some params, Some repos =>
              if negb (genesis_param_valid "block_ms" ms) then None else
              match genesis_all (genesis_agent fuel) agents [],
                    genesis_all genesis_param params [],
                    genesis_all (genesis_repo fuel) repos [] with
              | Some ags, Some pevs, Some revs =>
                  Some ((("agents" :: map fst ags) ::
                         map (fun a => ["tip", fst a, fst (snd a)]) ags) ++
                        [["param", "block_ms", ms]] ++ pevs ++ revs ++
                        flat_map (fun a => map (fun r => ["exclude", fst a, r]) (snd (snd a))) ags)
              | _, _, _ => None
              end
          | _, _, _, _ => None
          end
      end
  end.

(** --backend. "scripted" and "scripted:" plus a suffix are the scripted
    kind. Only a suffix longer than the nine-character prefix is a behavior,
    and it is fed after the other agent flags, as before. "scripted:" alone
    is not that prefix, so it stays the llm kind. *)
scripted_backend (raw : string) : bool :=
  seq raw "scripted" || ((9 <? slen raw) && starts "scripted:" raw).

backend_kind_name (raw : string) : string :=
  if scripted_backend raw then "scripted" else "llm".

backend_behavior_event (raw : string) : list (list string) :=
  if (9 <? slen raw) && starts "scripted:" raw then [["agent", "behavior", drop_str 9 raw]] else [].

genesis_refused_text : string := "genesis.json is not a genesis this node can start from".

(** The shell's ["genesis", raw] boot event becomes the events above. *)
boot_expand_one (ev : list string) : nprog (list (list string)) :=
  match ev with
  | ["genesis", raw] =>
      match genesis_events (json_tokens raw) with
      | Some gevs => NDone gevs
      | None => nbind (nexec (IoFail genesis_refused_text)) (fun ok => NDone (if ok then [] else [["genesis_refused"]]))
      end
  | ["block_log_text", text] => NDone (map (fun l => ["block_log", l]) (log_lines text))
  | ["goal_text", text] => NDone (goal_events text)
  | ["backend_kind_of", raw] => NDone [["agent", "backend", backend_kind_name raw]]
  | ["backend_behavior_of", raw] => NDone (backend_behavior_event raw)
  | _ => NDone [ev]
  end.

Fixpoint boot_expand_prog (evs : list (list string)) : nprog (list (list string)) :=
  match evs with
  | [] => NDone []
  | ev :: rest =>
      nbind (boot_expand_one ev) (fun first =>
      nbind (boot_expand_prog rest) (fun others => NDone (first ++ others)))
  end.

(** Startup, as a node program: signed.log read back (refusing to start
    when it has votes and there's no snapshot), the boot events expanded
    and replayed, the replay logged, the snapshot restored, the start
    step carried, and the votes signed at its height sent again
    ([resume_signed_prog]). None: the node doesn't start. [snap] is the snapshot
    read back ([boot_snapshot_prog]). *)
boot_prog (snap : option consensus_state) : nprog (option node_state) :=
  nbind (nask IoSignedText) (fun signed =>
  nbind (restore_signed_prog (log_lines (ans_one signed)) false) (fun r =>
  let (restored, found) := r in
  let missing := match snap with None => true | Some _ => false end in
  nbind (if signed_needs_snapshot missing found then nexec (IoFail signed_missing_text) else NDone true) (fun guarded =>
  if restored && guarded then
    nbind (nask IoBootEvents) (fun boot =>
    nbind (boot_expand_prog (nio_lists (ans_list boot))) (fun evs =>
    nbind (run_boot_prog empty_node evs) (fun st =>
    nbind (nask IoReplayCount) (fun count =>
    let n := ans_one count in
    nbind (if seq n "0" then NDone true else nexec (IoLog (append "replayed " (append n " blocks from disk")))) (fun logged =>
    let st := match snap with Some c => restore_cons st c | None => st end in
    if logged then
      nbind (start_node_prog st) (fun st =>
      nbind (resume_signed_prog st) (fun _ => NDone (Some st)))
    else NDone None)))))
  else NDone None))).


(** the snapshot read back, then startup: no consensus.state is a node
    that never voted; one Soma can't read refuses to start *)
boot_snapshot_prog : nprog (option node_state) :=
  nbind (nask IoSnapshotLoad) (fun a =>
  match ans_found_one a with
  | None => boot_prog None
  | Some t =>
      match snapshot_of t with
      | Some c => boot_prog (Some c)
      | None => nbind (nexec (IoFail snapshot_malformed_text)) (fun _ => NDone None)
      end
  end).


(** ---- The node's service (docs/SHELL-IN-SOMA.md, "The node's service") ----
    A unikernel runs no processes and has no checkouts: [pantheon service
    HOME HOST:PORT] does that for it on the host, with the node's own
    runtime (Soma.Host's, from HOME's setup), and the image asks it for the
    operations [service_op] names, over one TCP connection. Each request
    is the token and an operation's wire form; it is run as the binary
    runs it, and its answer goes back. The token is the node's: a hash of
    its private key, which the image and the service each have. *)
service_token (d : string) : string := sha256 (append "pantheon service " d).

(** the token, from the setup's key row ([size, n, e, d, ...]) *)
service_token_of (config : list (list string)) : string :=
  match config with _ :: (_ :: _ :: _ :: d :: _) :: _ => service_token d | _ => "" end.

(** What the service's jobs gave that the image takes: the service's own
    listener isn't the image's, so its connections' events stay out. *)
service_kept (evs : list (list string)) : list (list string) :=
  filter (fun e => match e with
    | "conn_offer" :: _ | "peer_bytes" :: _ | "peer_closed" :: _ => false
    | _ => true end) evs.

(** As many events as fit in one reply (a Sandbox frame is 1 MiB at
    most), at least one; the rest wait for the next ask. *)
Fixpoint service_batch (used : nat) (evs : list (list string)) : list (list string) * list (list string) :=
  match evs with
  | [] => ([], [])
  | e :: rest =>
      let n := fold_left (fun a f => a + slen f + 16) e (used + 16) in
      if negb (used =? 0) && (num "600000" <? n) then ([], evs)
      else let (now, later) := service_batch n rest in (e :: now, later)
  end.

(** What a request gets: an operation the service answers, its answer; a
    wrong token or any other operation, refused (not found, nothing). *)
Inductive service_request := ServeOp (op : node_op) | ServeEvents | ServeRefused.

service_request_of (token : string) (fields : list string) : service_request :=
  match fields with
  | tok :: wire =>
      if seq tok token then
        match io_of_wire wire with
        | Some (IoEvents _) => ServeEvents
        | Some op => if service_op op then ServeOp op else ServeRefused
        | None => ServeRefused
        end
      else ServeRefused
  | [] => ServeRefused
  end.

(** HOST:PORT, at its first colon (IPv4) *)
service_address (a : string) : string * string :=
  match find_str ":" a 0 with
  | Some i => (substr a 0 i, drop_str (i + 1) a)
  | None => (a, "")
  end.

(** Listening, said in the log (the test waits for it), or why not. *)
service_start_prog (addr : string) : nprog bool :=
  let (host, port) := service_address addr in
  nbind (nask (IoServeListen host port)) (fun a =>
  if fst a then nexec (IoLog (append "service listening on " addr))
  else nbind (nexec (IoFail (append "service: cannot listen on " addr))) (fun _ => NDone false)).
