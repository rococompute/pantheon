(** The unikernel's runner (U-1; docs/SHELL-IN-SOMA.md, "One kernel, two
    runners"): node_kernel.soma's primitives carried out with Sandbox, as
    node_shell.soma carries them out with shell.ml for the binary. The
    kernel is the same: the same node programs, tables, peer links and
    file bytes (blocks.log, signed.log, status.txt, as Sandbox's named
    files). Connections are Sandbox's, named by their number; what peers'
    connections do comes from Sandbox's mailbox.

    What a unikernel can't do itself (git in checkouts, model calls, CI
    and checks, the processes they run, the host's reply files and
    inbox: nodeio.soma's [service_op]) it asks the node's service for,
    [pantheon service] on the host, over one TCP connection: the
    operation in its wire form, run there by the binary's own runtime.
    With no service, those answer that they aren't there. Checked without
    booting by test/node-sandbox.sh ([soma build --no-image]), booted
    among binaries by test/node-image.sh, and with its service by
    test/node-image-service.sh. *)
Require Import Sandbox.
From Stdlib Require Import NArith.BinNat PArith.BinPos.
Import util nodeio node node_kernel.

(** What only the unikernel's runner needs: each checkout's head as
    [IoCheckoutHeads] answers ([repo, head, ...]: with no service, its
    genesis commit), the backend [IoLimitInfo] names, the node's service
    at this IP address and port ("" for none) and the token its requests
    carry. *)
Record img_world := {
  iw_heads : list string;
  iw_backend : string;
  iw_service_host : string;
  iw_service_port : nat;
  iw_token : string }.

(** the connection to the service, and when to try opening one again
    after it couldn't be (Sandbox's milliseconds) *)
Record img_state := { i_service : option connection; i_service_retry : N }.

iconn (c : string) : connection := Connection (num c).
iconn_id (c : connection) : string := match c with Connection n => show n end.

(** Sandbox's clock is monotonic milliseconds as a binary number; the
    node's is seconds as a float. *)
Fixpoint ipos_float (p : positive) : PrimFloat.float :=
  match p with
  | xH => PrimFloat.one
  | xO q => PrimFloat.add (ipos_float q) (ipos_float q)
  | xI q => PrimFloat.add PrimFloat.one (PrimFloat.add (ipos_float q) (ipos_float q))
  end.

iseconds (ms : N) : PrimFloat.float :=
  match ms with
  | N0 => PrimFloat.zero
  | Npos p => PrimFloat.div (ipos_float p) (nio_small 1000)
  end.

(** what the mailbox gave, as the kernel reads it *)
imail (e : link_event) : list string :=
  match e with
  | LinkOpened c host => ["opened", iconn_id c, host]
  | LinkBytes c data => ["bytes", iconn_id c, data]
  | LinkClosed c => ["closed", iconn_id c]
  end.

(** ---- the node's service ----
    A request is a frame of frames, one a field: the token, then an
    operation's wire form ([io_wire]). Its answer is one too: found, the
    float's text, then the data. *)
iframes (fields : list string) : string :=
  List.fold_right (fun f acc => Stdlib.Strings.String.append (frame f) acc) "" fields.

Fixpoint iunframes (fuel : nat) (data : string) : list string :=
  match fuel with
  | 0 => []
  | S k => match take_frame max_frame data with Whole d rest => d :: iunframes k rest | _ => [] end
  end.

ianswer_of (fields : list string) : nanswer :=
  match fields with
  | found :: stamp :: data => (nio_eq found "true", (nio_num stamp, data))
  | _ => ans_flag false
  end.

(** one request on [c] and its answer; none when the connection failed *)
iservice_ask (c : connection) (request : string) : io (option nanswer) :=
  sent <- send_frame c request ;;
  match sent with
  | SendClosed => ret None
  | Sent =>
      got <- receive_frame c 120 ;;
      match got with
      | Frame d => ret (Some (ianswer_of (iunframes (Stdlib.Strings.String.length d) d)))
      | _ => ret None
      end
  end.

iservice_open (w : img_world) (s : img_state) : io (option connection * img_state) :=
  ms <- monotonic_ms ;;
  if N.ltb ms (i_service_retry s) then ret (None, s)
  else
    r <- connect_within (iw_service_host w) (iw_service_port w) 300%N ;;
    match r with
    | Connected c => ret (Some c, {| s with i_service := Some c |})
    | _ => ret (None, {| i_service := None; i_service_retry := (ms + 2000)%N |})
    end.

(** An operation asked of the service: on the connection open, or, when
    that one has failed (the service started again), on a new one. With
    none reachable, the answer is that it isn't there. *)
iservice_call (w : img_world) (s : img_state) (wire : list string) : io (nanswer * img_state) :=
  let request := iframes (iw_token w :: wire) in
  first <- (match i_service s with
            | Some c => a <- iservice_ask c request ;;
                match a with Some x => ret (Some x) | None => close c ;; ret None end
            | None => ret None
            end) ;;
  match first with
  | Some a => ret (a, s)
  | None =>
      o <- iservice_open w {| s with i_service := None |} ;;
      match fst o with
      | None => ret (ans_flag false, snd o)
      | Some c =>
          a <- iservice_ask c request ;;
          match a with
          | Some x => ret (x, snd o)
          | None => close c ;; ret (ans_flag false, {| (snd o) with i_service := None |})
          end
      end
  end.

ihas_service (w : img_world) : bool := negb (nio_eq (iw_service_host w) "").

(** With no service, what the host's work answers: a CI check is
    reported and comes to nothing; the checkouts are at their genesis
    commits; the model has no limit; there are no jobs, reply files or
    inbox; a file the commands write is a named file; the rest isn't
    there. *)
ialone (w : img_world) (op : node_op) : io nanswer :=
  match op with
  | IoCheck id _ _ _ => print (Stdlib.Strings.String.append "no CI service for check " id) ;; ret ans_ok
  | IoCheckoutHeads => ret (ans_data true (iw_heads w))
  | IoLimitInfo => ret (true, (PrimFloat.zero, [iw_backend w, "0", ""]))
  | IoJobs | IoDirEntries _ => ret (ans_data true [])
  | IoJobFlood _ | IoJobExpire _ | IoDiscardFile _ | IoRemoveFile _ | IoInboxStamp _ => ret ans_ok
  | IoInboxState => ret (true, (PrimFloat.zero, ["inbox"]))
  | IoReadText path => got <- read_file path ;;
      ret (match got with Some t => ans_data true [t] | None => ans_data false [] end)
  | IoWriteFile path text => write_file path text ;; ret ans_ok
  | IoFileExists path => got <- read_file path ;; ret (ans_flag (match got with Some _ => true | None => false end))
  | _ => ret (ans_flag false)
  end.

(** One primitive, or an operation the kernel handed on: the network and
    the named files are Sandbox's; logging prints; the clock is Sandbox's
    (monotonic: a unikernel has no time of day yet, so a timestamp is
    shown as it is); the host's events, and the host's work, are the
    service's, or nothing without one. A mailbox waits a fifth of a
    second at most with a service: a job's output there doesn't wake it. *)
iop (w : img_world) (s : img_state) (op : node_op) : io (nanswer * img_state) :=
  match op with
  | IoNetListen _ port => listen_mailbox (num port) ;; ret (ans_ok, s)
  | IoNetMailbox ms =>
      let most := N.of_nat (num ms) in
      got <- mailbox (if ihas_service w then N.min 200 most else most) ;;
      ret (ans_data true (nio_frame_lists (List.map imail got)), s)
  | IoNetConnect host port ms =>
      r <- connect_within host (num port) (N.of_nat (num ms)) ;;
      ret (match r with Connected c => ans_data true [iconn_id c] | _ => ans_flag false end, s)
  | IoNetSend c data =>
      r <- send (iconn c) data ;;
      ret (ans_flag (match r with Sent => true | SendClosed => false end), s)
  | IoNetClose c => close (iconn c) ;; ret (ans_ok, s)
  | IoFileRead name => got <- read_file name ;;
      ret (match got with Some t => ans_data true [t] | None => ans_data false [] end, s)
  | IoFileWrite name _ text => write_file name text ;; ret (ans_ok, s)
  | IoFileAppend name text => append_file name text ;; ret (ans_ok, s)
  | IoLog text | IoSay text | IoPrint text => print text ;; ret (ans_ok, s)
  | IoClock => ms <- monotonic_ms ;; ret (ans_time (iseconds ms), s)
  | IoLocalTime stamp => ret (ans_data true [stamp], s)
  | IoFail message => print message ;; ret (ans_flag false, s)
  | _ =>
      if ihas_service w && service_op op then iservice_call w s (io_wire op)
      else match op with
           | IoEvents _ => ret (ans_data true [], s)
           | _ => a <- ialone w op ;; ret (a, s)
           end
  end.

(** A program of the kernel's primitives, run by the unikernel: each in
    order, each answer handed to the rest. *)
Fixpoint run_image {A : Type} (w : img_world) (p : nprog A) (s : img_state) : io (A * img_state) :=
  match p with
  | NDone a => ret (a, s)
  | NStep op k => r <- iop w s op ;; run_image w (k (fst r)) (snd r)
  end.

(** ---- A node as a unikernel ---- *)
Fixpoint ipairs (l : list string) : list (string * string) :=
  match l with
  | a :: b :: rest => (a, b) :: ipairs rest
  | _ => []
  end.

img_world_of (config : list (list string)) (service : string) : img_world :=
  let backend := match config with (_ :: _ :: _ :: _ :: _ :: b :: _) :: _ => b | _ => "" end in
  let repos := match config with _ :: _ :: _ :: _ :: _ :: _ :: r :: _ => r | _ => [] end in
  let a := kaddr service in
  {| iw_heads := flat_map (fun r => [fst r, snd r]) (ipairs repos);
     iw_backend := backend;
     iw_service_host := if nio_eq service "" then "" else fst a;
     iw_service_port := if nio_eq service "" then 0 else num (snd a);
     iw_token := service_token_of config |}.

(** [pantheon node] as a unikernel: the kernel from the node's setup,
    started (listening on its genesis port, then startup), then the event
    loop's turns, each from the state the last left, its primitives
    carried out with Sandbox. Its files are the image's storage device's;
    its IP address is the one in the genesis, given to the image
    (solo5-hvt's --ipv4). [service] is where its service listens. *)
run_node_image_at (config : list (list string)) (service : string) : io unit :=
  match kernel_world config with
  | None => print "the node's setup came back malformed, or this node is not one of the genesis's agents"
  | Some w =>
      let iw := img_world_of config service in
      r <- run_image iw (kernel_boot_prog "" w (kernel_start (w_identity w) config))
             {| i_service := None; i_service_retry := 0%N |} ;;
      match fst r with
      | Some p =>
          Sandbox.iterate (fun (q : prod (prod node_state nio_kernel) img_state) =>
            r' <- run_image iw (kernel_tick_prog "" w (fst q)) (snd q) ;; ret (fst r', snd r'))
            (p, snd r)
      | None => print "the node did not start"
      end
  end.

(** with no service: it votes and keeps the chain, and can't merge, bid or
    check *)
run_node_image (config : list (list string)) : io unit := run_node_image_at config "".
