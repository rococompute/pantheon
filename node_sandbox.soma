(** A unikernel's interpreter of node programs (U-1; docs/SHELL-IN-SOMA.md,
    "Two directions, and the unikernel"): nodeio.soma's operations carried
    out with Sandbox, as node.soma's [run_shell] carries them out with
    shell.ml for the binary. The same [nprog] values, the same file bytes
    (blocks.log, signed.log, status.txt, as Sandbox's named files) and the
    same tables (nodeio.soma's [nio_table_op]).

    What Sandbox doesn't give yet is the program's to supply, in
    [nio_world]: a message's bytes on a peer link (the binary signs it with
    the node's RSA key; Sandbox has no RSA: Soma's "SHA-256 and RSA" item)
    and starting a CI check (the binary starts a process; a unikernel asks
    a CI service, which needs Soma's "services" item: an HTTP POST with a
    timeout). Checked without booting by test/node-sandbox.sh
    ([soma build --no-image]). *)
Require Import Sandbox.
From Stdlib Require Import NArith.BinNat PArith.BinPos.
Import nodeio.

Record nio_world := {
  (** the chain's id, this node's key and each agent's public key, from
      the genesis and the key file: a peer line and a transaction are
      signed and checked with Soma's RSA (nodeio's [nio_wire_line],
      [nio_encode_tx], [nio_line_verify] with [IoPeerKey]'s key), as the
      binary signs and checks them *)
  w_chain : string;
  w_key : nio_key;
  w_keys : list (string * nio_key);
  (** start the CI check of a bid's edits; its result comes back as an event *)
  w_check : string -> string -> string -> list string -> io unit;
  (** this epoch's draw: the Byzantine flag, the chain's length and the
      link secret, as the binary's [h_draw] *)
  w_draw : list string;
  (** the fields this node won't check and the excluded alternates, in
      [IoCheckExclusions]'s wire form *)
  w_exclusions : list string;
  (** each checkout's head, as [IoCheckoutHeads] answers ([repo, head,
      ...]): a unikernel's repositories are a git service's *)
  w_heads : list string;
  (** the model backend the status names; its limit is the model calls',
      which aren't operations yet, so a unikernel reports none *)
  w_backend : string;
  (** a time of day for a timestamp's text (Sandbox's clock is monotonic,
      not the time of day) *)
  w_local_time : string -> string;
  (** a merge's checkout work ([IoMergeReset] ... [IoMergeCommit], in
      their wire form): a unikernel's checkouts are a git service's, which
      needs Soma's "services" item *)
  w_git : list string -> io nanswer;
  (** a model call's work ([IoLlmBudget] ... [IoToken], in their wire
      form): a model service, which needs Soma's "services" item *)
  w_llm : list string -> io nanswer;
  (** CI started for a tree ([IoCiLaunch]): a CI service *)
  w_ci : list string -> io nanswer;
  (** this node's name *)
  w_identity : string;
  (** a time as text, node_float_wire's way (Soma's floats have no
      printer yet) *)
  w_float_text : PrimFloat.float -> string;
  (** the boot events before blocks.log's (genesis, this node's name, the
      backend, agent events): a unikernel's are its image's *)
  w_boot : list (list string) }.

(** The interpreter's state: the operations' tables and the peer links,
    in genesis order, by name. *)
Record nio_kernel := { k_tables : nio_tables; k_peers : list (string * connection) }.

nio_kernel_tables (s : nio_kernel) (t : nio_tables) : nio_kernel :=
  {| k_tables := t; k_peers := k_peers s |}.

(** Sandbox's clock is monotonic milliseconds as a binary number; the
    node's is seconds as a float. *)
Fixpoint nio_pos_float (p : positive) : PrimFloat.float :=
  match p with
  | xH => PrimFloat.one
  | xO q => PrimFloat.add (nio_pos_float q) (nio_pos_float q)
  | xI q => PrimFloat.add PrimFloat.one (PrimFloat.add (nio_pos_float q) (nio_pos_float q))
  end.

nio_seconds (ms : N) : PrimFloat.float :=
  match ms with
  | N0 => PrimFloat.zero
  | Npos p => PrimFloat.div (nio_pos_float p) (nio_small 1000)
  end.

nio_newline : string := Stdlib.Strings.String.String (Ascii.ascii_of_nat 10) Stdlib.Strings.String.EmptyString.

Fixpoint nio_send_each (cs : list connection) (line : string) : io unit :=
  match cs with
  | [] => ret tt
  | c :: rest => _ <- send_line c line ;; nio_send_each rest line
  end.

Fixpoint nio_nth_peer (k : nat) (ps : list (string * connection)) : list connection :=
  match ps, k with
  | [], _ => []
  | p :: _, 0 => [snd p]
  | _ :: rest, S j => nio_nth_peer j rest
  end.

(** a count in decimal, as the binary's [string_of_int] *)
Fixpoint nio_show_digits (fuel n : nat) (acc : string) : string :=
  match fuel with
  | 0 => acc
  | S f =>
      let acc' := Stdlib.Strings.String.String (Ascii.ascii_of_nat (48 + Nat.modulo n 10)) acc in
      if Nat.ltb n 10 then acc' else nio_show_digits f (Nat.div n 10) acc'
  end.
nio_show_nat (n : nat) : string := nio_show_digits (S n) n Stdlib.Strings.String.EmptyString.

nio_index (s : string) : nat :=
  fst (nio_nat_digits (Stdlib.Strings.String.list_ascii_of_string s) 0).

(** An operation of the tables or the in-memory stores (decided blocks,
    signed votes, the height), at Sandbox's clock. *)
nio_kernel_stores (s : nio_kernel) (op : node_op) : io (nanswer * nio_kernel) :=
  ms <- monotonic_ms ;;
  match nio_store_op (nio_seconds ms) (k_tables s) op with
  | Some (answer, t) => ret (answer, nio_kernel_tables s t)
  | None => ret (ans_flag false, s)
  end.

(** One operation: the answer the binary's [node_io] gives, and the new
    state. Logging prints; the clock is Sandbox's; storage appends or
    writes the named file; peer sends go on the links; a CI check asks
    [w_check]; connection and job control have nothing to do in a
    unikernel (its links are its listen handlers', and it runs no
    processes); the draw, signing a transaction, the check exclusions,
    the checkouts' heads, the backend, the time of day, the git work and
    a model call's are [nio_world]'s; the rest is the tables' and the stores'. *)
nio_kernel_op (w : nio_world) (s : nio_kernel) (op : node_op)
    : io (nanswer * nio_kernel) :=
  match op with
  | IoLog text => print text ;; ret (nio_ok, s)
  | IoClock => ms <- monotonic_ms ;; ret (ans_time (nio_seconds ms), s)
  | IoStore height txs =>
      append_file "blocks.log" (Stdlib.Strings.String.append (nio_block_line height txs) nio_newline) ;;
      nio_kernel_stores s op
  | IoSignVote slot vid fields =>
      append_file "signed.log" (Stdlib.Strings.String.append (nio_vote_line slot vid fields) nio_newline) ;;
      nio_kernel_stores s op
  | IoDraw => ret (ans_data true (w_draw w), s)
  | IoPeerCount => ret (ans_data true [nio_show_nat (List.length (k_peers s))], s)
  | IoEncodeTx nonce fields =>
      ret (ans_data true [nio_encode_tx (w_chain w) (w_identity w) (w_key w) nonce fields], s)
  | IoCheckExclusions => ret (ans_data true (w_exclusions w), s)
  | IoCheckoutHeads => ret (ans_data true (w_heads w), s)
  | IoLimitInfo => ret ((true, (PrimFloat.zero, [w_backend w, "0", ""])), s)
  | IoLocalTime stamp => ret (ans_data true [w_local_time w stamp], s)
  | IoMergeReset _ | IoMergeProbe _ _ | IoMergeRead _ _ | IoMergeWrite _ _ _
  | IoMergeRemove _ _ | IoMergeCommit _ _ _ _ _ _ _
  | IoRepoNames | IoLsFiles _ | IoHeadFile _ _ =>
      a <- w_git w (io_wire op) ;; ret (a, s)
  | IoLlmBudget | IoLlmHold _ _ _ _ | IoLlmStart _ _ _ _ _ _ _ _ | IoToolCheckout _
  | IoSelfExe | IoEnvEntries | IoToken | IoLimitSet _ _ _ | IoLimitClear _ | IoReleaseState
  | IoHeldRequests | IoHeldStore _ _ | IoJobComplete _ _ =>
      a <- w_llm w (io_wire op) ;; ret (a, s)
  | IoWriteStatus text => write_file "status.txt" text ;; ret (nio_ok, s)
  | IoSendAll fields => nio_send_each (List.map snd (k_peers s)) (nio_wire_line (w_chain w) (w_identity w) (w_key w) fields) ;; ret (nio_ok, s)
  | IoSendPeer index fields =>
      nio_send_each (nio_nth_peer (nio_index index) (k_peers s)) (nio_wire_line (w_chain w) (w_identity w) (w_key w) fields) ;; ret (nio_ok, s)
  | IoPeerSend who fields =>
      nio_send_each (List.map snd (List.filter (fun p => nio_eq (fst p) who) (k_peers s))) (nio_wire_line (w_chain w) (w_identity w) (w_key w) fields) ;;
      ret (nio_ok, s)
  | IoPeerExists who =>
      ret (ans_flag (List.existsb (fun p => nio_eq (fst p) who) (k_peers s)), s)
  | IoCheck id repo head edits => w_check w id repo head edits ;; ret (nio_ok, s)
  | IoCiLaunch _ _ _ _ => a <- w_ci w (io_wire op) ;; ret (a, s)
  | IoReadText path => got <- read_file path ;;
      ret (match got with Some t => ans_data true [t] | None => ans_data false [] end, s)
  (* Sandbox's named files can't be removed or listed yet: a reply file is
     a model service's, and a unikernel has no inbox directory *)
  | IoDiscardFile _ | IoRemoveFile _ | IoInboxStamp _ => ret (nio_ok, s)
  | IoInboxState => ret ((true, (PrimFloat.zero, ["inbox"])), s)
  | IoDirEntries _ => ret (ans_data true [], s)
  | IoIdentity => ret (ans_data true [w_identity w], s)
  | IoPeerKey who =>
      ret (match List.find (fun p => nio_eq (fst p) who) (w_keys w) with
           | Some p => ans_data true [w_chain w, nio_show_nat (nk_bytes (snd p)),
                                     Crypto.hex_of_bytes (nk_n (snd p)), Crypto.hex_of_bytes (nk_e (snd p))]
           | None => ans_data false []
           end, s)
  | IoConns => ret (ans_data true (nio_frame_lists (List.map (fun p => [fst p, "0"]) (k_peers s))), s)
  (* dialing and resending: a unikernel's links are its listen handlers' *)
  | IoPollPrep => ret (nio_ok, s)
  | IoTurnNow => ms <- monotonic_ms ;; ret (ans_time (nio_seconds ms), s)
  | IoTimers =>
      ret (ans_data true (nio_frame_lists (List.map (fun p => w_float_text w (fst p) :: snd p)
                                            (t_timers (k_tables s)))), s)
  (* it runs no processes *)
  | IoJobs => ret (ans_data true [], s)
  (* startup: the image's boot events, then blocks.log's text, as the
     binary feeds them; signed.log's; refusing to start says why and
     answers false (a unikernel can't exit with a status) *)
  | IoBootEvents =>
      blocks <- read_file "blocks.log" ;;
      ret (ans_data true (nio_frame_lists (w_boot w ++
             [["block_log_text", match blocks with Some b => b | None => "" end]])), s)
  | IoSignedText =>
      got <- read_file "signed.log" ;;
      ret (ans_data true [match got with Some t => t | None => "" end], s)
  | IoFail message => print message ;; ret (ans_flag false, s)
  (* the commands' I/O (cli.soma): a unikernel prints; it has no
     processes, keys to make, git, or directories to make, and doesn't exit *)
  | IoSay text | IoPrint text => print text ;; ret (nio_ok, s)
  | IoWriteFile path text => write_file path text ;; ret (nio_ok, s)
  | IoFileExists path => got <- read_file path ;;
      ret (ans_flag (match got with Some _ => true | None => false end), s)
  | IoSnapshotSave text => write_file "consensus.state" text ;; ret (nio_ok, s)
  | IoSnapshotLoad => got <- read_file "consensus.state" ;;
      ret (match got with Some t => ans_data true [t] | None => ans_data false [] end, s)
  | IoExit _ | IoChmod _ _ | IoMakeDirs _ | IoCwd | IoNewKey _ | IoRandomHex _ | IoGit _ _
  | IoClone _ _ _ | IoSpawnNode _ _ | IoAwaitNodes _ | IoCheckoutEdits _ | IoApplyEdits _ _
  | IoCheckTree _ _ _ _ => ret (ans_flag false, s)
  | IoConnAdmit _ _ _ => ret (nio_ok, s)
  | IoConnClose _ => ret (nio_ok, s)
  | IoJobFlood _ => ret (nio_ok, s)
  | IoJobExpire _ => ret (nio_ok, s)
  | _ => nio_kernel_stores s op
  end.

(** A node program, run by the unikernel: each operation in order, each
    answer handed to the rest, as [run_shell] does for the binary. *)
Fixpoint run_kernel {A : Type} (w : nio_world) (p : nprog A) (s : nio_kernel) : io (A * nio_kernel) :=
  match p with
  | NDone a => ret (a, s)
  | NStep op k => r <- nio_kernel_op w s op ;; run_kernel w (k (fst r)) (snd r)
  end.
