#!/bin/sh
# A Pantheon network as a cmux workspace: the market's plan on the left half
# (the goal, each repository's .plan with its marks, the tasks; it follows
# the chain), and on the right a tab per agent: its diplomat's session
# (Claude Code, codex, Grok Build, Muse) working its node's inbox, or,
# for an agent without one, its node. The workspace's sidebar shows each
# node's height, term and leader. A watchdog nudges a diplomat that stopped
# working its inbox, and notifies you when one waits on a person (an
# approval, a question).
# Run it on a Mac with cmux; it follows integrations/herdr's plan.
#
#   pantheon-cmux up NET [options] [-- NODE ARGS...]
#                                  a workspace for the network in NET (made by `pantheon init NET`),
#                                  every node started in it; NODE ARGS go to each node as they would
#                                  to `pantheon up` (--goal FILE, --bid-window N, --ci CMD, ...)
#       --diplomats "A B"          these agents answer through an interactive session (default: none)
#       --backends A=B,...         the other agents' backends, as for `pantheon up` (default: scripted)
#       --yolo                     start the diplomats' CLIs with their approvals off (read "Isolation")
#       --layout plan|grid         plan (default): the left half the network's (the market's plan, live,
#                                  with status and the watchdog as tabs), the right a pane per agent (its
#                                  diplomat's session, then its node's tab); grid: a pane per agent
#   pantheon-cmux status NET       the sidebar's and the plan's loop (up starts it in a "status" tab)
#   pantheon-cmux watchdog NET [--check|--once]
#                                  the watchdog's loop, a pass a minute (up starts it in a "watchdog"
#                                  tab when there are diplomats); --check: what it sees now, nudging
#                                  no one; --once: one pass, nudging
#   pantheon-cmux down NET         close the workspace, which stops its nodes and sessions
#
# Isolation: every pane runs as you, and the node homes in NET hold the
# agents' keys. Without --yolo each CLI asks before it runs a command (Claude
# Code in --permission-mode manual, Grok Build in default, whatever their
# saved defaults), and
# you answer in its tab (the watchdog notifies you). With --yolo nothing
# stands between a diplomat and the keys: use it only for a network whose
# keys and repositories don't matter. integrations/cmux/README.md says what
# would isolate them (a Lima VM per diplomat, as scripts/host.sh does for Muse).
#
# Settings, from the environment:
#   PANTHEON      the pantheon binary (default: pantheon on PATH, else this checkout's main.exe)
#   CMUX          the cmux CLI (default: cmux on PATH, else the one inside cmux.app)
#   DIPLOMAT_CLI  a command to start every diplomat with instead of its provider's CLI (it gets
#                 the prompt as its last argument); for another CLI, or for a test
#   GROK_MODEL    Grok Build's model for a grok diplomat (default: Grok Build's own)
#
# What it keeps lives in NET/.cmux: the workspace's id, and for each agent
# its node's script, and a diplomat's inbox, desk (its inbox wrapper and
# instructions), backend and its tab's id. A diplomat's inbox is not the
# node's own NET/AGENT/inbox (that one is for transactions).
set -eu
here=$(cd "$(dirname "$0")/../.." && pwd)
self=$here/integrations/cmux/pantheon-cmux
export CMUX_QUIET=1
GROK_MODEL=${GROK_MODEL:-}

say() { printf 'pantheon-cmux: %s\n' "$*"; }
die() { printf 'pantheon-cmux: %s\n' "$*" >&2; exit 1; }
# a word for sh, single-quoted
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

if [ -z "${CMUX_BIN:-}" ]; then
  if [ -n "${CMUX:-}" ]; then CMUX_BIN=$CMUX
  elif command -v cmux >/dev/null 2>&1; then CMUX_BIN=cmux
  elif [ -n "${CMUX_BUNDLED_CLI_PATH:-}" ] && [ -x "$CMUX_BUNDLED_CLI_PATH" ]; then CMUX_BIN=$CMUX_BUNDLED_CLI_PATH
  else CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux
  fi
fi
cm() { "$CMUX_BIN" "$@"; }
need_cmux() {
  command -v "$CMUX_BIN" >/dev/null 2>&1 || [ -x "$CMUX_BIN" ] || die "no cmux CLI at $CMUX_BIN: install cmux (cmux.com), or set CMUX to its CLI"
  cm list-workspaces >/dev/null 2>&1 || die "cmux doesn't answer: start cmux.app (or run this from a cmux terminal)"
}
need_pantheon() {
  if [ -z "${PANTHEON:-}" ]; then
    if command -v pantheon >/dev/null 2>&1; then PANTHEON=$(command -v pantheon)
    elif [ -x "$here/main.exe" ]; then PANTHEON=$here/main.exe
    else die "no pantheon: install it, or build it here (soma build main.soma), or set PANTHEON"
    fi
  fi
}

# the network's agents: NET's directories with a key and a genesis
agents_of() {
  for d in "$1"/*/; do
    a=$(basename "$d")
    [ -f "$d/key.json" ] && [ -f "$d/genesis.json" ] && printf '%s\n' "$a"
  done | sort
}
kind() { printf '%s' "${1%%-*}"; }
in_list() { case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
net_arg() {
  [ -n "${1:-}" ] || die "which network? pantheon-cmux $2 NET (a directory made by pantheon init)"
  [ -d "$1" ] || die "no directory $1: make a network with pantheon init $1 first"
  NET=$(cd "$1" && pwd) ST=$NET/.cmux
  [ -n "$(agents_of "$NET")" ] || die "$NET has no network (no agent with key.json and genesis.json): run pantheon init $1 first"
}
workspace() { cat "$ST/workspace" 2>/dev/null || true; }
workspace_alive() {
  w=$(workspace); [ -n "$w" ] || return 1
  cm --json --id-format uuids list-workspaces 2>/dev/null | grep -q "$w"
}

# "OK surface:N (UUID) ..." -> the first UUID, or the first ref
first_uuid() { grep -o '([0-9A-F-]\{36\})' | head -1 | tr -d '()'; }
# the pane that holds surface S (a ref or UUID) in workspace W
pane_of() {
  cm --json --id-format both list-panes --workspace "$1" | python3 -c '
import json, sys
s = sys.argv[1]
for p in json.load(sys.stdin)["panes"]:
    if s in p.get("surface_refs", []) + p.get("surface_ids", []):
        print(p["id"]); break' "$2"
}

# backends from --backends A=B,C=D
backend_of() {
  printf '%s\n' "$2" | tr ',' '\n' | while IFS= read -r pair; do
    case $pair in "$1"=*) printf '%s' "${pair#*=}"; break ;; esac
  done
}

# the command that starts a diplomat's session for AGENT
diplomat_cli() {
  if [ -n "${DIPLOMAT_CLI:-}" ]; then printf '%s' "$DIPLOMAT_CLI"; return 0; fi
  case $(kind "$1") in
    # without --yolo, the asking mode, whatever the CLI's saved default (a saved
    # auto or always-approve would let it run commands unasked)
    claude) if [ -n "$yolo" ]; then printf 'claude --dangerously-skip-permissions'; else printf 'claude --permission-mode manual'; fi ;;
    codex)  printf 'codex%s' "${yolo:+ --dangerously-bypass-approvals-and-sandbox}" ;;
    # Grok Build, xAI's CLI (grok login), as scripts/bidder.sh uses it
    grok)   printf 'grok %s%s' "$([ -n "$yolo" ] && echo --always-approve || echo '--permission-mode default')" "${GROK_MODEL:+ --model $(q "$GROK_MODEL")}" ;;
    muse)   printf 'muse%s' "${yolo:+ --yolo}" ;;
    *) return 1 ;;
  esac
}

# a diplomat's inbox, desk, instructions, backend and session script
prepare_diplomat() {
  a=$1 d=$ST/$a
  mkdir -p "$d/inbox" "$d/desk"
  # requests left by an earlier run's node (none runs now: up checked)
  find "$d/inbox" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  # the inbox in your own group: bidder-inbox makes each request setgid,
  # which fails in a directory of a group you're not in (wheel, under /tmp)
  chgrp "$(id -g)" "$d/inbox"
  cat > "$d/desk/pantheon-inbox" <<W
#!/bin/sh
PANTHEON_INBOX=$(q "$d/inbox") exec $(q "$here/scripts/pantheon-inbox") "\$@"
W
  # the node strips PANTHEON_* from a backend's environment: the backend sets its own
  cat > "$d/backend.sh" <<B
#!/bin/sh
PANTHEON_INBOX=$(q "$d/inbox") exec $(q "$here/scripts/bidder-inbox.sh")
B
  chmod 755 "$d/desk/pantheon-inbox" "$d/backend.sh"
  # the values reach Python through its environment, never its source
  R_AGENT=$a R_NET=$NET R_DESK=$d/desk R_PANTHEON=$PANTHEON python3 - "$here/integrations/cmux/diplomat.md" "$d/desk/instructions.md" <<'PY'
import os, sys
t = open(sys.argv[1]).read()
for k in ["AGENT", "NET", "DESK", "PANTHEON"]:
    t = t.replace("{{%s}}" % k, os.environ["R_" + k])
open(sys.argv[2], "w").write(t)
PY
  cli=$(diplomat_cli "$a") || { say "$a: no CLI for its provider ($(kind "$a")): set DIPLOMAT_CLI; it runs as a plain node"; return 1; }
  prompt="Read $d/desk/instructions.md: it is your job, as $a's diplomat in a Pantheon network. Follow it now."
  printf '#!/bin/sh\ncd %s || exit 1\nexec %s %s\n' "$(q "$d/desk")" "$cli" "$(q "$prompt")" > "$d/session.sh"
  chmod 755 "$d/session.sh"
}

# a tab in pane P running COMMAND, named NAME, at position INDEX: its id
tab() {
  t_s=$(cm --id-format both new-surface --pane "$1" --workspace "$w" --focus false --command "$2" | first_uuid)
  [ -n "$t_s" ] || die "cmux didn't make the tab $3"
  cm rename-tab --workspace "$w" --surface "$t_s" "$3" >/dev/null
  cm reorder-surface --workspace "$w" --surface "$t_s" --index "$4" >/dev/null 2>&1 || true
  printf '%s' "$t_s"
}

# The left half is the network's: the market's plan (cmux's markdown
# viewer, on the file the status loop keeps), with status and the watchdog
# as tabs beside it. The right half is the agents': a pane per agent, in a
# grid of two rows, each with the agent's tab (its diplomat's session, else
# its node) and then, for a diplomat, its node's tab.
layout_plan() {
  render_plan
  cm rename-tab --workspace "$w" --surface "$s1" "$first" >/dev/null
  mo=$(cm --id-format both markdown open "$ST/plan.md" --workspace "$w" --surface "$s1" --direction left --focus false) \
    || say "cmux didn't open the plan's view: open $ST/plan.md in it by hand"
  # the agents' grid, split from the first agent's pane (the right half)
  cols=$(( (n + 1) / 2 )) i=1 tops=$s1
  for a in $agents; do
    if [ "$i" -gt 1 ]; then
      if [ "$i" -le "$cols" ]; then from=$(printf '%s\n' $tops | tail -1) dir=right
      else from=$(printf '%s\n' $tops | sed -n "$((i - cols))p") dir=down; fi
      s=$(cm --id-format both new-split "$dir" --workspace "$w" --surface "$from" --focus false --command "sh $(q "$(main_of "$a")")" | first_uuid)
      [ -n "$s" ] || die "cmux didn't split a pane for $a"
      [ "$i" -le "$cols" ] && tops="$tops $s"
      cm rename-tab --workspace "$w" --surface "$s" "$a" >/dev/null
    else s=$s1; fi
    if in_list "$a" "$sessions"; then printf '%s\n' "$s" > "$ST/$a/surface"; else printf '%s\n' "$s" > "$ST/$a/node-surface"; fi
    i=$((i + 1))
  done
  # a diplomat's node, in its agent's pane
  for a in $sessions; do
    s=$(tab "$(pane_of "$w" "$(cat "$ST/$a/surface")")" "sh $(q "$ST/$a/node.sh")" "$a node" 1)
    printf '%s\n' "$s" > "$ST/$a/node-surface"
  done
  # the plan's pane, from what markdown open says (pane=pane:N (UUID)); without
  # one, status and the watchdog go in the first agent's pane
  lp=$(printf '%s' "$mo" | sed -n 's/.*pane=pane:[0-9]* (\([0-9A-Fa-f-]*\)).*/\1/p')
  plan_s=$(printf '%s' "$mo" | first_uuid)
  if [ -n "$lp" ]; then j=1; else lp=$(pane_of "$w" "$s1") j=2 plan_s=""; fi
  tab "$lp" "sh $(q "$self") status $(q "$NET")" status "$j" >/dev/null
  [ -z "$sessions" ] || tab "$lp" "sh $(q "$self") watchdog $(q "$NET")" watchdog "$((j + 1))" >/dev/null
  # (each new tab is selected as it's made: back to each diplomat's session,
  # the plan, and last the first agent's tab, which keeps the focus)
  for a in $sessions; do
    cm reorder-surface --workspace "$w" --surface "$(cat "$ST/$a/surface")" --index 0 --focus true >/dev/null 2>&1 || true
  done
  [ -z "$plan_s" ] || cm reorder-surface --workspace "$w" --surface "$plan_s" --index 0 --focus true >/dev/null 2>&1 || true
  cm reorder-surface --workspace "$w" --surface "$s1" --index 0 --focus true >/dev/null 2>&1 || true
}

# A pane per agent in a grid of two rows, its node's tab and its diplomat's;
# status and the watchdog in the first pane
layout_grid() {
  cm rename-tab --workspace "$w" --surface "$s1" "$first node" >/dev/null
  cols=$(( (n + 1) / 2 )) i=1 tops=$s1
  for a in $agents; do
    if [ "$i" -gt 1 ]; then
      if [ "$i" -le "$cols" ]; then from=$(printf '%s\n' $tops | tail -1) dir=right
      else from=$(printf '%s\n' $tops | sed -n "$((i - cols))p") dir=down; fi
      s=$(cm --id-format both new-split "$dir" --workspace "$w" --surface "$from" --focus false --command "sh $(q "$ST/$a/node.sh")" | first_uuid)
      [ -n "$s" ] || die "cmux didn't split a pane for $a"
      [ "$i" -le "$cols" ] && tops="$tops $s"
      cm rename-tab --workspace "$w" --surface "$s" "$a node" >/dev/null
    else s=$s1; fi
    printf '%s\n' "$s" > "$ST/$a/node-surface"
    i=$((i + 1))
  done
  for a in $sessions; do
    s=$(tab "$(pane_of "$w" "$(cat "$ST/$a/node-surface")")" "sh $(q "$ST/$a/session.sh")" "$a diplomat" 1)
    printf '%s\n' "$s" > "$ST/$a/surface"
  done
  p1=$(pane_of "$w" "$s1")
  k=1; in_list "$first" "$sessions" && k=2
  tab "$p1" "sh $(q "$self") status $(q "$NET")" status "$k" >/dev/null
  [ -z "$sessions" ] || tab "$p1" "sh $(q "$self") watchdog $(q "$NET")" watchdog "$((k + 1))" >/dev/null
}

cmd_up() {
  net_arg "${1:-}" up; shift
  dips="" backends="" yolo="" layout=plan
  while [ $# -gt 0 ]; do
    case $1 in
      --diplomats) dips=${2:?--diplomats wants agent names}; shift 2 ;;
      --backends) backends=${2:?--backends wants agent=backend,...}; shift 2 ;;
      --yolo) yolo=1; shift ;;
      --layout) layout=${2:?--layout wants plan or grid}; shift 2 ;;
      --) shift; break ;;
      *) die "unknown option $1 (node arguments go after --)" ;;
    esac
  done
  case $layout in plan|grid) ;; *) die "--layout $layout: plan (the market's plan beside a tab per agent) or grid (a pane per agent)" ;; esac
  need_cmux; need_pantheon
  agents=$(agents_of "$NET")
  for a in $dips; do in_list "$a" "$(echo $agents)" || die "--diplomats: $a isn't an agent of $NET ($(echo $agents))"; done
  if workspace_alive; then die "$NET is up already, in workspace $(workspace): pantheon-cmux down $NET first"; fi
  if pgrep -f -- "node $NET/" >/dev/null 2>&1; then
    die "$NET's nodes are running outside cmux (pantheon up?): stop them first ($(pgrep -f -- "node $NET/" | tr '\n' ' '))"
  fi
  mkdir -p "$ST"
  # each node's script: the node in the foreground, its output on screen and in node.log
  # relative paths in them (--goal) are as they were where this runs, as for pantheon up
  nargs="" goalf="" prev="" from_dir=$(pwd)
  for x in "$@"; do nargs="$nargs $(q "$x")"; [ "$prev" = --goal ] && goalf=$x; prev=$x; done
  sessions=""
  for a in $agents; do
    mkdir -p "$ST/$a"
    if in_list "$a" "$dips" && prepare_diplomat "$a"; then
      b="cmd:$ST/$a/backend.sh"; sessions="$sessions $a"
    else
      b=$(backend_of "$a" "$backends"); b=${b:-scripted}
    fi
    printf '#!/bin/sh\ncd %s || exit 1\n%s node %s --backend %s%s 2>&1 | tee -a %s\n' \
      "$(q "$from_dir")" "$(q "$PANTHEON")" "$(q "$NET/$a")" "$(q "$b")" "$nargs" "$(q "$NET/$a/node.log")" > "$ST/$a/node.sh"
    chmod 755 "$ST/$a/node.sh"
  done
  set -- $agents; n=$#; first=$1
  goal=$( [ -n "$goalf" ] && head -1 "$goalf" 2>/dev/null || true)
  # the goal file, for the plan's view
  rm -f "$ST/goal"
  if [ -n "$goalf" ]; then case $goalf in /*) echo "$goalf" ;; *) echo "$from_dir/$goalf" ;; esac > "$ST/goal"; fi
  # what an agent's tab runs in the plan layout: its diplomat, else its node
  main_of() { if in_list "$1" "$sessions"; then echo "$ST/$1/session.sh"; else echo "$ST/$1/node.sh"; fi; }
  if [ "$layout" = plan ]; then start=$(main_of "$first"); else start=$ST/$first/node.sh; fi
  out=$(cm --id-format both new-workspace --name "pantheon: $(basename "$NET")" --description "${goal:-a Pantheon network}" \
    --cwd "$NET" --command "sh $(q "$start")") || die "cmux couldn't make the workspace: $out"
  # new-workspace names it by ref only: its id, for later
  ref=$(printf '%s' "$out" | grep -o 'workspace:[0-9]*' | head -1)
  # (it is listed a moment after it's made)
  w="" tries=0
  while [ -z "$w" ] && [ "$tries" -lt 20 ]; do
    w=$(cm --json --id-format both list-workspaces | python3 -c '
import json, sys
for x in json.load(sys.stdin)["workspaces"]:
    if x.get("ref") == sys.argv[1]: print(x["id"]); break' "$ref")
    [ -n "$w" ] || { tries=$((tries + 1)); sleep 0.5; }
  done
  [ -n "$w" ] || die "cmux made a workspace but it isn't listed: $out"
  printf '%s\n' "$w" > "$ST/workspace"
  s1=$(cm --json --id-format both list-panes --workspace "$w" | python3 -c 'import json,sys; print(json.load(sys.stdin)["panes"][0]["surface_ids"][0])')
  if [ "$layout" = plan ]; then layout_plan; else layout_grid; fi
  say "$NET is up in cmux workspace \"pantheon: $(basename "$NET")\" ($w): $([ "$layout" = plan ] && echo "the market's plan on the left with status and the watchdog, a pane per agent on the right (the agent, then its node)" || echo "a pane per agent") ($(echo $agents))"
  [ -z "$sessions" ] || say "diplomats:$sessions, in their agents' tabs$([ -n "$yolo" ] && echo ', approvals off' || echo '; answer their approvals there')"
  say "stop it with: pantheon-cmux down $NET"
}

# a node's line for the sidebar, from its status.txt
status_of() {
  f=$NET/$1/status.txt
  [ -f "$f" ] || { echo "starting"; return 0; }
  if grep -q '^LIMIT' "$f"; then echo "limited: $(grep '^LIMIT' "$f" | head -1 | cut -c7-60)"; return 0; fi
  head -1 "$f" | awk '{ for (i = 1; i < NF; i += 2) v[$i] = $(i + 1); printf "h%s t%s · leader %s", v["height"], v["term"], v["leader"] }'
}

# The market as markdown, for the plan's view: the chain, the goal, each
# repository's .plan at the market's head (a node's checkout: every node has
# the same commits) with its marks, and the tasks. Written only when it
# changed, so the view doesn't redraw for nothing.
render_plan() {
  a1=$(agents_of "$NET" | head -1) f=$NET/$a1/status.txt
  # (no title or chain line: the height, term and leader are in the sidebar and
  # the status tab, and with them here the file changed with every block)
  {
    g=$(cat "$ST/goal" 2>/dev/null || true)
    if [ -n "$g" ] && [ -f "$g" ]; then printf '## Goal\n\n'; cat "$g"; printf '\n'; fi
    for r in "$NET/$a1"/repos/*/; do
      # at the node's head (its checkout follows it), else as the file is
      plan=$(git -C "$r" show HEAD:.plan 2>/dev/null || cat "$r/.plan" 2>/dev/null) || continue
      [ -n "$plan" ] || continue
      printf '## Plan: %s\n\n' "$(basename "$r")"
      # .plan: "# " comments, a date per day, an item a line: "+ " or "* " done, "- " dropped
      awk '/^#/ || /^[ \t]*$/ { next }
           /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/ { printf "%s### %s\n\n", (days++ ? "\n" : ""), $0; next }
           /^[+*] / { printf "- [x] %s\n", substr($0, 3); next }
           /^- / { printf "- ~~%s~~\n", substr($0, 3); next }
           { printf "- [ ] %s\n", $0 }' <<EOF
$plan
EOF
      printf '\n'
    done
    if [ -f "$f" ] && grep -q '^task ' "$f"; then
      printf '## Tasks\n\n'
      grep '^task ' "$f" | tail -20 | sed 's/^task \([0-9]*\) \[\([a-z]*\)\] /- **#\1** `\2` /'
      printf '\n'
    fi
  } > "$ST/plan.md.tmp"
  [ -s "$ST/plan.md.tmp" ] || printf 'No goal, plan or tasks yet.\n' > "$ST/plan.md.tmp"
  if cmp -s "$ST/plan.md.tmp" "$ST/plan.md"; then rm -f "$ST/plan.md.tmp"; else mv "$ST/plan.md.tmp" "$ST/plan.md"; fi
}

cmd_status() {
  net_arg "${1:-}" status; need_cmux
  w=$(workspace); [ -n "$w" ] || die "$NET isn't up in cmux: pantheon-cmux up $NET"
  while :; do
    clear 2>/dev/null || true
    printf 'Pantheon network %s, %s\n\n' "$NET" "$(date '+%H:%M:%S')"
    for a in $(agents_of "$NET"); do
      line=$(status_of "$a")
      printf '  %-10s %s\n' "$a" "$line"
      # keyed pantheon.AGENT: cmux keeps some agents' names (codex, grok) for its own
      cm set-status "pantheon.$a" "$line" --workspace "$w" >/dev/null 2>&1 || true
    done
    render_plan
    sleep 10
  done
}

# AGENT's session state, from cmux's hooks: working, idle, done, completed,
# waiting, needs_input, blocked, or none (no agent seen in its tab)
session_state() {
  s=$(cat "$ST/$1/surface" 2>/dev/null) || { echo none; return 0; }
  cm --json current --limit 200 2>/dev/null | python3 -c '
import json, sys
s = sys.argv[1].lower()
for it in json.load(sys.stdin).get("items", []):
    refs = [e.get("reference", "").lower() for e in it.get("evidence", [])]
    if any(r.endswith(s) for r in refs):
        states = [a.get("state", "") for a in it.get("agents", [])]
        print(states[0] if states else "none"); break
else:
    print("none")' "$s"
}

watch_agent() {
  a=$1 st=$ST/$a/watchdog
  [ -f "$ST/$a/surface" ] || return 0
  # its node holds requests for a usage limit: it's right to stop
  if grep -q '^LIMIT' "$NET/$a/status.txt" 2>/dev/null; then
    rm -f "$st"; [ -z "${dry:-}" ] || say "watchdog: $a limited"; return 0
  fi
  state=$(session_state "$a")
  case $state in
    idle|done|completed) idle=1 ;;
    needs_input|blocked|waiting)
      # a person's call: say so once, and nudge no one
      if [ ! -f "$st.asked" ] && [ -z "${dry:-}" ]; then
        cm notify --title "Pantheon: $a" --body "$a's diplomat waits on you ($state): its tab is \"$a diplomat\"" --workspace "$(workspace)" --surface "$(cat "$ST/$a/surface")" >/dev/null 2>&1 || true
        : > "$st.asked"
      fi
      idle=0 ;;
    *) rm -f "$st.asked"; idle=0 ;;
  esac
  [ -z "${dry:-}" ] || { say "watchdog: $a $state"; return 0; }
  [ "$idle" = 1 ] || { rm -f "$st"; return 0; }
  n=$(( $(cat "$st" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$st"
  [ "$n" -ge 2 ] && [ $(( (n - 2) % 5 )) -eq 0 ] || return 0
  msg="You stopped working your inbox, and your node keeps sending requests that nothing answers. Keep at it for as long as this session runs: wait, answer, repeat, and don't end your turn between requests (your instructions: $ST/$a/desk/instructions.md). If your provider says you've hit a usage limit, report it with limited as they say, then stop. Start now."
  cm paste --workspace "$(workspace)" --surface "$(cat "$ST/$a/surface")" --submit "$msg" >/dev/null \
    && say "watchdog: $a's session had stopped (idle for $n checks): nudged it back to its inbox"
}

cmd_watchdog() {
  net_arg "${1:-}" watchdog; need_cmux
  [ -n "$(workspace)" ] || die "$NET isn't up in cmux: pantheon-cmux up $NET"
  case ${2:-} in
    --check) for a in $(agents_of "$NET"); do dry=1 watch_agent "$a"; done; return 0 ;;
    --once) for a in $(agents_of "$NET"); do watch_agent "$a" || true; done; return 0 ;;
  esac
  say "watching the diplomats of $NET every minute"
  while :; do for a in $(agents_of "$NET"); do watch_agent "$a" || true; done; sleep 60; done
}

cmd_down() {
  net_arg "${1:-}" down; need_cmux
  if workspace_alive; then
    cm close-workspace --force --workspace "$(workspace)" >/dev/null && say "closed $NET's workspace"
  else say "$NET has no cmux workspace up"; fi
  rm -f "$ST/workspace"
  # its nodes end with their terminals, in a few seconds; one that doesn't is terminated
  tries=0
  while pgrep -f -- "node $NET/" >/dev/null 2>&1 && [ "$tries" -lt 20 ]; do tries=$((tries + 1)); sleep 0.5; done
  if pgrep -f -- "node $NET/" >/dev/null 2>&1; then
    pkill -TERM -f -- "node $NET/" && say "terminated $NET's nodes that outlived their terminals"
  fi
  say "$NET's nodes are stopped"
}

c=${1:-}; [ $# -gt 0 ] && shift
case $c in
  up|status|watchdog|down) "cmd_$c" "$@" ;;
  *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; [ -z "$c" ] || [ "$c" = help ] || [ "$c" = -h ] || exit 1 ;;
esac
