#!/bin/sh
# A Pantheon network as a cmux workspace: the market's plan on the left half
# (the goal, each repository's .plan with its marks, the tasks; it follows
# the chain), and on the right a tab per agent: its diplomat's session
# (Claude Code, codex, Grok Build, Muse) working its node's inbox, or,
# for an agent without one, its node. The workspace is named for the market:
# Market (X leader), then Done. A watchdog keeps the name and the plan,
# says each term's leader, nudges a diplomat that stopped working its inbox,
# and notifies you when one waits on a person (an approval, a question).
# Run it on a Mac with cmux; it follows integrations/herdr's plan.
#
#   pantheon-cmux up NET [options] [-- NODE ARGS...]
#                                  a workspace for the network in NET (made by `pantheon init NET`),
#                                  every node started in it; NODE ARGS go to each node as they would
#                                  to `pantheon up` (--goal FILE, --bid-window N, --ci CMD, ...)
#       --diplomats "A B"          these agents answer through an interactive session (default: none)
#       --backends A=B,...         the other agents' backends, as for `pantheon up` (default: scripted)
#       --yolo                     accepted, and the default: every diplomat runs with approvals off (read "Isolation")
#       --layout plan|grid         plan (default): the left half the network's (the market's plan, live,
#                                  with the watchdog as a tab), the right a pane per agent (its
#                                  diplomat's session, then its node's tab); grid: a pane per agent
#   pantheon-cmux watchdog NET [--check|--once]
#                                  the watchdog's loop (up starts it in a "watchdog" tab): the name,
#                                  the plan and each term's leader every 10 seconds, the diplomats a
#                                  pass a minute; --check: what it sees of the diplomats now, nudging
#                                  no one; --once: one pass, nudging
#   pantheon-cmux down NET         close the workspace, which stops its nodes and sessions
#   pantheon-cmux render-plan NET --goal FILE --output FILE [--plain]
#                                  render committed market state without a terminal frontend;
#                                  --plain emits Markdown without HTML disclosure blocks
#
# Isolation: every pane runs as you, and the node homes in NET hold the
# agents' keys. Every diplomat runs without asking (claude
# --dangerously-skip-permissions, codex
# --dangerously-bypass-approvals-and-sandbox, grok --always-approve, muse
# --yolo), so nothing stands between any of them and the keys: use it only for a network whose
# keys and repositories don't matter. integrations/cmux/README.md says what
# would isolate them (a Lima VM per diplomat, as scripts/host.sh does for Muse).
#
# Settings, from the environment:
#   PANTHEON      the pantheon binary (default: pantheon on PATH, else this checkout's main.exe)
#   CMUX          the cmux CLI (default: cmux on PATH, else the one inside cmux.app)
#   DIPLOMAT_CLI  a command to start every diplomat with instead of its provider's CLI (it gets
#                 the prompt as its last argument); for another CLI, or for a test
#   GROK_MODEL    Grok Build's model for a grok diplomat (default: Grok Build's own)
#   PANTHEON_RUNS where each run's record is kept (default: ~/.pantheon/runs)
#   PANTHEON_EVENTS 0 disables the local event socket and agent-hook relay (default: on)
#
# Every run is recorded by default, outside NET, so removing NET loses
# nothing: PANTHEON_RUNS/NAME-YYYYMMDD-HHMMSS holds each node's blocks.log
# (every signed transaction: tasks, bids with their patches, picks, merges,
# rejections and their reasons, closes, votes), status.txt, node.log and
# genesis.json (never key.json), leaders.log, plan.md, the goal, and, once the
# market finished or went down, a git bundle of each repository as the market
# left it. up makes it, the watchdog keeps it current, down finishes it.
#
# What it keeps lives in NET/.cmux: the workspace's id, and for each agent
# its node's script, and a diplomat's inbox, desk (its inbox wrapper and
# instructions), backend and its tab's id. A diplomat's inbox is not the
# node's own NET/AGENT/inbox (that one is for transactions).
set -eu
here=$(cd "$(dirname "$0")/../.." && pwd)
GROK_MODEL=${GROK_MODEL:-}

# The multiplexer: cmux, or with PANTHEON_MUX=c11 (integrations/c11/pantheon-c11)
# c11, whose adapter (integrations/c11/mux.sh) replaces the mux_* calls below.
# MUX names it in messages, MUX_STATE is NET's directory for what this keeps.
MUX=cmux MUX_STATE=.cmux prog=pantheon-cmux
self=$here/integrations/cmux/pantheon-cmux

say() { printf '%s: %s\n' "$prog" "$*"; }
die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
# a word for sh, single-quoted
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# "OK surface:N (UUID) ..." -> the first UUID, or the first ref
first_uuid() { grep -o '([0-9A-Fa-f-]\{36\})' | head -1 | tr -d '()'; }

# --- cmux: every call to the multiplexer goes through these ---------------
mux_setup() {
  export CMUX_QUIET=1
  if [ -z "${CMUX_BIN:-}" ]; then
    if [ -n "${CMUX:-}" ]; then CMUX_BIN=$CMUX
    elif [ -n "${CMUX_BUNDLED_CLI_PATH:-}" ] && [ -x "$CMUX_BUNDLED_CLI_PATH" ]; then CMUX_BIN=$CMUX_BUNDLED_CLI_PATH
    elif [ -x /Applications/cmux.app/Contents/Resources/bin/cmux ]; then CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux
    elif command -v cmux >/dev/null 2>&1; then CMUX_BIN=cmux
    else CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux
    fi
  fi
}
cm() { "$CMUX_BIN" "$@"; }
mux_need() {
  command -v "$CMUX_BIN" >/dev/null 2>&1 || [ -x "$CMUX_BIN" ] || die "no cmux CLI at $CMUX_BIN: install cmux (cmux.com), or set CMUX to its CLI"
  cm list-workspaces >/dev/null 2>&1 || die "cmux doesn't answer: start cmux.app (or run this from a cmux terminal)"
}
# is workspace W open
mux_alive() { cm --json --id-format uuids list-workspaces 2>/dev/null | grep -q "$1"; }
# a workspace named NAME, described DESC, in CWD, its first tab running CMD: its id
mux_new_workspace() {
  out=$(cm --id-format both new-workspace --name "$1" --description "$2" \
    --cwd "$3" --command "$4") || die "cmux couldn't make the workspace: $out"
  # new-workspace names it by ref only: its id, for later
  ref=$(printf '%s' "$out" | grep -o 'workspace:[0-9]*' | head -1)
  # (it is listed a moment after it's made)
  nw="" tries=0
  while [ -z "$nw" ] && [ "$tries" -lt 20 ]; do
    nw=$(cm --json --id-format both list-workspaces | python3 -c '
import json, sys
for x in json.load(sys.stdin)["workspaces"]:
    if x.get("ref") == sys.argv[1]: print(x["id"]); break' "$ref")
    [ -n "$nw" ] || { tries=$((tries + 1)); sleep 0.5; }
  done
  [ -n "$nw" ] || die "cmux made a workspace but it isn't listed: $out"
  printf '%s' "$nw"
}
# workspace W's first tab
mux_first_surface() {
  cm --json --id-format both list-panes --workspace "$1" | python3 -c 'import json,sys; print(json.load(sys.stdin)["panes"][0]["surface_ids"][0])'
}
# the pane that holds surface S (a ref or UUID) in workspace W
mux_pane_of() {
  cm --json --id-format both list-panes --workspace "$1" | python3 -c '
import json, sys
s = sys.argv[1]
for p in json.load(sys.stdin)["panes"]:
    if s in p.get("surface_ids", []) + p.get("surface_refs", []):
        print(p["id"]); break' "$2"
}
# a new pane DIR (right, down) of surface FROM in workspace W running CMD: its tab's id
mux_split() { cm --id-format both new-split "$1" --workspace "$2" --surface "$3" --focus false --command "$4" | first_uuid; }
# a new tab in pane P of workspace W running CMD: its id
mux_new_tab() { cm --id-format both new-surface --pane "$1" --workspace "$2" --focus false --command "$3" | first_uuid; }
mux_rename_tab() { cm rename-tab --workspace "$1" --surface "$2" "$3" >/dev/null; }
# tab S of workspace W to position INDEX, selected if FOCUS is true
mux_reorder() { cm reorder-surface --workspace "$1" --surface "$2" --index "$3" ${4:+--focus "$4"} >/dev/null 2>&1 || true; }
# the plan's view of FILE (plan.md), left of surface S in workspace W: "PANE SURFACE", or nothing
mux_markdown() {
  mo=$(cm --id-format both markdown open "$1" --workspace "$2" --surface "$3" --direction left --focus false) || return 0
  printf '%s %s' "$(printf '%s' "$mo" | sed -n 's/.*pane=pane:[0-9]* (\([0-9A-Fa-f-]*\)).*/\1/p')" "$(printf '%s' "$mo" | first_uuid)"
}
mux_rename_ws() { cm rename-workspace --workspace "$1" "$2" >/dev/null 2>&1; }
# a notification TITLE, BODY about workspace W (and tab S)
mux_notify() { cm notify --title "$3" --body "$4" --workspace "$1" ${2:+--surface "$2"} >/dev/null 2>&1 || true; }
# a diplomat's tab S in workspace W, once it's made
mux_diplomat_tab() { :; }
# the session state in tab S, from cmux's hooks: working, idle, done, completed,
# waiting, needs_input, blocked, or none (no agent seen in it)
mux_state() {
  cm --json current --limit 200 2>/dev/null | python3 -c '
import json, sys
s = sys.argv[1].lower()
for it in json.load(sys.stdin).get("items", []):
    refs = [e.get("reference", "").lower() for e in it.get("evidence", [])]
    if any(r.endswith(s) for r in refs):
        states = [a.get("state", "") for a in it.get("agents", [])]
        print(states[0] if states else "none"); break
else:
    print("none")' "$1"
}
# TEXT to the agent in tab S, through its provider's hooks
mux_message() { cm agent message "$1" --from Pantheon -- "$2" >/dev/null; }
mux_close() { cm close-workspace --force --workspace "$1" >/dev/null; }
# Called in a background subshell: exec keeps the watchdog as Python's parent.
# Keep paths as arguments, never split/glob a serialized command line.
mux_events() {
  exec python3 "$here/integrations/cmux/events.py" "$NET" --state "$MUX_STATE" --cmux "$CMUX_BIN" --parent "$$"
}
# plan.md was rewritten: cmux's markdown view follows the file on its own
mux_plan_changed() {
  :
}
# what diplomat.md says of the multiplexer
MUX_NOTICES="Pantheon event notices arrive through cmux's agent hooks, including while you are working."
# --------------------------------------------------------------------------

[ "${PANTHEON_MUX:-cmux}" = cmux ] || . "$here/integrations/${PANTHEON_MUX}/mux.sh"
mux_setup
need_cmux() { mux_need; }
need_pantheon() {
  if [ -z "${PANTHEON:-}" ]; then
    if command -v pantheon >/dev/null 2>&1; then PANTHEON=$(command -v pantheon)
    elif [ -x "$here/main.exe" ]; then PANTHEON=$here/main.exe
    else die "no pantheon: install it, or build it here (soma build main.soma), or set PANTHEON"
    fi
  fi
}

# the network's agents: NET's directories with a key and a genesis
agents_of() {
  for d in "$1"/*/; do
    a=$(basename "$d")
    [ -f "$d/key.json" ] && [ -f "$d/genesis.json" ] && printf '%s\n' "$a"
  done | sort
}
kind() { printf '%s' "${1%%-*}"; }
in_list() { case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
net_arg() {
  [ -n "${1:-}" ] || die "which network? $prog $2 NET (a directory made by pantheon init)"
  [ -d "$1" ] || die "no directory $1: make a network with pantheon init $1 first"
  NET=$(cd "$1" && pwd) ST=$NET/$MUX_STATE
  [ -n "$(agents_of "$NET")" ] || die "$NET has no network (no agent with key.json and genesis.json): run pantheon init $1 first"
}
workspace() { cat "$ST/workspace" 2>/dev/null || true; }
workspace_alive() {
  w=$(workspace); [ -n "$w" ] || return 1
  mux_alive "$w"
}
pane_of() { mux_pane_of "$@"; }

# backends from --backends A=B,C=D
backend_of() {
  printf '%s\n' "$2" | tr ',' '\n' | while IFS= read -r pair; do
    case $pair in "$1"=*) printf '%s' "${pair#*=}"; break ;; esac
  done
}

# the command that starts a diplomat's session for AGENT
diplomat_cli() {
  if [ -n "${DIPLOMAT_CLI:-}" ]; then printf '%s' "$DIPLOMAT_CLI"; return 0; fi
  case $(kind "$1") in
    # every CLI in its mode that runs without asking: the operator's choice
    # (read "Isolation")
    claude) printf 'claude --dangerously-skip-permissions' ;;
    codex)  printf 'codex --dangerously-bypass-approvals-and-sandbox' ;;
    # Grok Build, xAI's CLI (grok login), as scripts/bidder.sh uses it
    grok)   printf 'grok --always-approve%s' "${GROK_MODEL:+ --model $(q "$GROK_MODEL")}" ;;
    muse)   printf 'muse --yolo' ;;
    *) return 1 ;;
  esac
}

# a diplomat's inbox, desk, instructions, backend and session script
prepare_diplomat() {
  a=$1 d=$ST/$a
  mkdir -p "$d/inbox" "$d/desk"
  # requests left by an earlier run's node (none runs now: up checked)
  find "$d/inbox" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
  # the inbox in your own group: bidder-inbox makes each request setgid,
  # which fails in a directory of a group you're not in (wheel, under /tmp)
  chgrp "$(id -g)" "$d/inbox"
  cat > "$d/desk/pantheon-inbox" <<W
#!/bin/sh
PANTHEON_INBOX=$(q "$d/inbox") exec $(q "$here/scripts/pantheon-inbox") "\$@"
W
  # the node strips PANTHEON_* from a backend's environment: the backend sets its own
  cat > "$d/backend.sh" <<B
#!/bin/sh
PANTHEON_INBOX=$(q "$d/inbox") exec $(q "$here/scripts/bidder-inbox.sh")
B
  chmod 755 "$d/desk/pantheon-inbox" "$d/backend.sh"
  # the values reach Python through its environment, never its source
  R_AGENT=$a R_NET=$NET R_DESK=$d/desk R_PANTHEON=$PANTHEON R_MUX=$MUX R_INBOX=$d/inbox R_NOTICES=$MUX_NOTICES \
    python3 - "$here/integrations/cmux/diplomat.md" "$d/desk/instructions.md" <<'PY'
import os, sys
t = open(sys.argv[1]).read()
for k in ["AGENT", "NET", "DESK", "PANTHEON", "MUX", "INBOX", "NOTICES"]:
    t = t.replace("{{%s}}" % k, os.environ["R_" + k])
open(sys.argv[2], "w").write(t)
PY
  cli=$(diplomat_cli "$a") || { say "$a: no CLI for its provider ($(kind "$a")): set DIPLOMAT_CLI; it runs as a plain node"; return 1; }
  prompt="Read $d/desk/instructions.md: it is your job, as $a's diplomat in a Pantheon network. Follow it now."
  printf '#!/bin/sh\ncd %s || exit 1\nexec %s %s\n' "$(q "$d/desk")" "$cli" "$(q "$prompt")" > "$d/session.sh"
  chmod 755 "$d/session.sh"
}

# a tab in pane P running COMMAND, named NAME, at position INDEX: its id
tab() {
  t_s=$(mux_new_tab "$1" "$w" "$2")
  [ -n "$t_s" ] || die "$MUX didn't make the tab $3"
  mux_rename_tab "$w" "$t_s" "$3"
  mux_reorder "$w" "$t_s" "$4"
  printf '%s' "$t_s"
}

# The left half is the network's: the market's plan (cmux's markdown
# viewer, on the file the watchdog keeps), with the watchdog as a tab beside
# it. The right half is the agents': a pane per agent, in a
# grid of two rows, each with the agent's tab (its diplomat's session, else
# its node) and then, for a diplomat, its node's tab.
layout_plan() {
  render_plan
  mux_rename_tab "$w" "$s1" "$first"
  mo=$(mux_markdown "$ST/plan.md" "$w" "$s1")
  [ -n "${mo# }" ] || say "$MUX didn't open the plan's view: open $ST/plan.md in it by hand"
  # the agents' grid, split from the first agent's pane (the right half)
  cols=$(( (n + 1) / 2 )) i=1 tops=$s1
  for a in $agents; do
    if [ "$i" -gt 1 ]; then
      if [ "$i" -le "$cols" ]; then from=$(printf '%s\n' $tops | tail -1) dir=right
      else from=$(printf '%s\n' $tops | sed -n "$((i - cols))p") dir=down; fi
      s=$(mux_split "$dir" "$w" "$from" "sh $(q "$(main_of "$a")")")
      [ -n "$s" ] || die "$MUX didn't split a pane for $a"
      [ "$i" -le "$cols" ] && tops="$tops $s"
      mux_rename_tab "$w" "$s" "$a"
    else s=$s1; fi
    if in_list "$a" "$sessions"; then printf '%s\n' "$s" > "$ST/$a/surface"; mux_diplomat_tab "$w" "$s"; else printf '%s\n' "$s" > "$ST/$a/node-surface"; fi
    i=$((i + 1))
  done
  # a diplomat's node, in its agent's pane
  for a in $sessions; do
    s=$(tab "$(pane_of "$w" "$(cat "$ST/$a/surface")")" "sh $(q "$ST/$a/node.sh")" "$a node" 1)
    printf '%s\n' "$s" > "$ST/$a/node-surface"
  done
  # the plan's pane and tab, from mux_markdown; without
  # one, the watchdog goes in the first agent's pane
  lp=${mo%% *} plan_s=${mo#* }
  if [ -n "$lp" ]; then j=1; else lp=$(pane_of "$w" "$s1") j=2 plan_s=""; fi
  tab "$lp" "sh $(q "$self") watchdog $(q "$NET")" watchdog "$j" >/dev/null
  # (each new tab is selected as it's made: back to each diplomat's session,
  # the plan, and last the first agent's tab, which keeps the focus)
  for a in $sessions; do
    mux_reorder "$w" "$(cat "$ST/$a/surface")" 0 true
  done
  [ -z "$plan_s" ] || mux_reorder "$w" "$plan_s" 0 true
  mux_reorder "$w" "$s1" 0 true
}

# A pane per agent in a grid of two rows, its node's tab and its diplomat's;
# the watchdog in the first pane
layout_grid() {
  mux_rename_tab "$w" "$s1" "$first node"
  cols=$(( (n + 1) / 2 )) i=1 tops=$s1
  for a in $agents; do
    if [ "$i" -gt 1 ]; then
      if [ "$i" -le "$cols" ]; then from=$(printf '%s\n' $tops | tail -1) dir=right
      else from=$(printf '%s\n' $tops | sed -n "$((i - cols))p") dir=down; fi
      s=$(mux_split "$dir" "$w" "$from" "sh $(q "$ST/$a/node.sh")")
      [ -n "$s" ] || die "$MUX didn't split a pane for $a"
      [ "$i" -le "$cols" ] && tops="$tops $s"
      mux_rename_tab "$w" "$s" "$a node"
    else s=$s1; fi
    printf '%s\n' "$s" > "$ST/$a/node-surface"
    i=$((i + 1))
  done
  for a in $sessions; do
    s=$(tab "$(pane_of "$w" "$(cat "$ST/$a/node-surface")")" "sh $(q "$ST/$a/session.sh")" "$a diplomat" 1)
    printf '%s\n' "$s" > "$ST/$a/surface"
    mux_diplomat_tab "$w" "$s"
  done
  p1=$(pane_of "$w" "$s1")
  k=1; in_list "$first" "$sessions" && k=2
  tab "$p1" "sh $(q "$self") watchdog $(q "$NET")" watchdog "$k" >/dev/null
}

cmd_up() {
  net_arg "${1:-}" up; shift
  dips="" backends="" layout=plan
  while [ $# -gt 0 ]; do
    case $1 in
      --diplomats) dips=${2:?--diplomats wants agent names}; shift 2 ;;
      --backends) backends=${2:?--backends wants agent=backend,...}; shift 2 ;;
      --yolo) shift ;;   # the default now; kept so older commands still work
      --layout) layout=${2:?--layout wants plan or grid}; shift 2 ;;
      --) shift; break ;;
      *) die "unknown option $1 (node arguments go after --)" ;;
    esac
  done
  case $layout in plan|grid) ;; *) die "--layout $layout: plan (the market's plan beside a tab per agent) or grid (a pane per agent)" ;; esac
  need_cmux; need_pantheon
  agents=$(agents_of "$NET")
  for a in $dips; do in_list "$a" "$(echo $agents)" || die "--diplomats: $a isn't an agent of $NET ($(echo $agents))"; done
  if workspace_alive; then die "$NET is up already, in workspace $(workspace): $prog down $NET first"; fi
  if pgrep -f -- "node $NET/" >/dev/null 2>&1; then
    die "$NET's nodes are running outside $MUX (pantheon up?): stop them first ($(pgrep -f -- "node $NET/" | tr '\n' ' '))"
  fi
  mkdir -p "$ST"
  # each node's script: the node in the foreground, its output on screen and in node.log
  # relative paths in them (--goal) are as they were where this runs, as for pantheon up
  nargs="" goalf="" prev="" from_dir=$(pwd)
  for x in "$@"; do nargs="$nargs $(q "$x")"; [ "$prev" = --goal ] && goalf=$x; prev=$x; done
  sessions=""
  for a in $agents; do
    mkdir -p "$ST/$a"
    if in_list "$a" "$dips" && prepare_diplomat "$a"; then
      b="cmd:$ST/$a/backend.sh"; sessions="$sessions $a"
    else
      b=$(backend_of "$a" "$backends"); b=${b:-scripted}
    fi
    printf '#!/bin/sh\ncd %s || exit 1\n%s node %s --backend %s%s 2>&1 | tee -a %s\n' \
      "$(q "$from_dir")" "$(q "$PANTHEON")" "$(q "$NET/$a")" "$(q "$b")" "$nargs" "$(q "$NET/$a/node.log")" > "$ST/$a/node.sh"
    chmod 755 "$ST/$a/node.sh"
  done
  set -- $agents; n=$#; first=$1
  goal=$( [ -n "$goalf" ] && head -1 "$goalf" 2>/dev/null || true)
  # the goal file, for the plan's view
  rm -f "$ST/goal"
  if [ -n "$goalf" ]; then case $goalf in /*) echo "$goalf" ;; *) echo "$from_dir/$goalf" ;; esac > "$ST/goal"; fi
  # what an agent's tab runs in the plan layout: its diplomat, else its node
  main_of() { if in_list "$1" "$sessions"; then echo "$ST/$1/session.sh"; else echo "$ST/$1/node.sh"; fi; }
  if [ "$layout" = plan ]; then start=$(main_of "$first"); else start=$ST/$first/node.sh; fi
  w=$(mux_new_workspace Market "${goal:-a Pantheon network}" "$NET" "sh $(q "$start")")
  [ -n "$w" ] || die "$MUX didn't make the workspace"
  printf '%s\n' "$w" > "$ST/workspace"
  # the run's record, outside NET
  rec=${PANTHEON_RUNS:-$HOME/.pantheon/runs}/$(basename "$NET" | sed 's/^\.//')-$(date +%Y%m%d-%H%M%S)
  mkdir -p "$rec" && printf '%s\n' "$rec" > "$ST/record"
  { printf 'network %s\nstarted %s\ndiplomats%s\nnode arguments%s\n' "$NET" "$(date)" "${sessions:- none}" "$nargs"; } > "$rec/run.txt"
  record
  s1=$(mux_first_surface "$w")
  if [ "$layout" = plan ]; then layout_plan; else layout_grid; fi
  say "$NET is up in a $MUX workspace named for its market (Market, then Market (X leader), then Done) ($w): $([ "$layout" = plan ] && echo "the market's plan on the left with the watchdog, a pane per agent on the right (the agent, then its node)" || echo "a pane per agent") ($(echo $agents))"
  [ -z "$sessions" ] || say "diplomats:$sessions, in their agents' tabs, with approvals off"
  say "its record (chain, statuses, logs; repositories once it ends) is kept in $rec"
  say "stop it with: $prog down $NET"
}

# The market as markdown, for the plan's view: the chain, the goal, each
# repository's .plan at the market's head (a node's checkout: every node has
# the same commits) with its marks, and the tasks. Written only when it
# changed, so the view doesn't redraw for nothing.
# An item's icon, from the task that covers it (status.txt: "task N [state]
# SPEC", "bid N [state ...] task N by A"): done, a bid for it merged (its
# task closes some blocks later); being bid on, a task for it open with bids;
# else not picked up yet. A
# task belongs to its unique strongest matching item: an explicit leading
# step reference, then a full quotation, then a paraphrase. Background mentions
# cannot give one task to multiple goals; ambiguous matches stay unassigned.
# ITEMS=goal: the goal file's list
# lines lead with their icon, its other lines as they are; ITEMS=plan: each
# .plan item folds its full text under a short summary with its status.
ITEMS_AWK='
function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
function item(text, mark, dropped,   title) {
  title = text
  if (length(title) > 60) title = substr(title, 1, 59) "…"
  title = esc(title)
  if (dropped) title = "<s>" title "</s>"
  else title = mark " " title
  printf "<details>\n<summary>%s</summary>\n\n%s%s%s\n\n</details>\n\n", title, (dropped ? "~~" : ""), esc(text), (dropped ? "~~" : "")
}
function norm(s) { s = tolower(s); gsub(/[^a-z0-9]/, "", s); return s }
# Score all items before assigning a task, rather than independently letting
# each item claim it. A paraphrase must also mention its literal code names.
function score(id, text, num,   k, w, i, m, hit, rest, code) {
  if (num != "" && raw[id] ~ ("^[^:]*: *(goal )?step " num "([^0-9]|$)")) return 2000
  k = norm(text); if (length(k) >= 8 && index(spec[id], k)) return 1000
  rest = text
  while (match(rest, /`[^`]+`/)) {
    code = norm(substr(rest, RSTART + 1, RLENGTH - 2))
    if (code != "" && !index(spec[id], code)) return 0
    rest = substr(rest, RSTART + RLENGTH)
  }
  m = split(tolower(text), w, /[^a-z0-9_]+/); hit = 0; k = 0
  for (i = 1; i <= m; i++) if (length(w[i]) >= 3) { k++; if ((id SUBSEP w[i]) in words) hit++ }
  return k >= 2 && hit * 10 >= k * 9 ? int(hit * 100 / k) : 0
}
function icon(which,   j, id, st) {
  st = ""
  for (j = 1; j <= n; j++) { id = ids[j]
    if (chosen[id] == which) st = st state(id)
  }
  return st ~ /B/ ? "🌱" : st ~ /P/ ? "🪴" : st ~ /C/ ? "🌳" : "🫘"
}
function state(id) {
  if (items == "goal" && st_[id] == "closed") return "C"
  return merged[id] ? "P" : (st_[id] == "open" && bids[id]) ? "B" : "-"
}
FILENAME == ARGV[1] {
  if ($1 == "task") { id = $2; s = $3; gsub(/[^a-z]/, "", s); st_[id] = s
    line = $0; sub(/^task [0-9]+ \[[a-z]+\] /, "", line); spec[id] = norm(line); raw[id] = tolower(line); ids[++n] = id
    m = split(raw[id], w, /[^a-z0-9_]+/); for (i = 1; i <= m; i++) words[id, w[i]] = 1 }
  else if ($1 == "bid") { for (i = 3; i < NF; i++) if ($i == "task") { t = $(i + 1); if ($3 ~ /^\[pending/) bids[t]++; if ($3 ~ /merged/) merged[t]++; break } }
  next
}
{
  source[++lines] = $0
  if (items == "goal") {
    if (!match($0, /^[ \t]*([-*+]|[0-9]+[.)])[ \t]+/)) next
    marker = substr($0, 1, RLENGTH); text = substr($0, RLENGTH + 1)
    num = ""; if (marker ~ /[0-9]/) { num = marker; gsub(/[^0-9]/, "", num) }
  } else {
    if (/^#/ || /^[ \t]*$/ || /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) next
    text = $0; sub(/^[+*-] /, "", text); num = ""
  }
  line_item[lines] = ++targets; target_text[targets] = text; target_num[targets] = num
  next
}
END {
  for (j = 1; j <= n; j++) {
    id = ids[j]; best = 0; ties = 0; candidate = 0
    for (k = 1; k <= targets; k++) {
      value = score(id, target_text[k], target_num[k])
      if (value > best) { best = value; candidate = k; ties = 1 }
      else if (value == best && value > 0) ties++
    }
    if (best > 0 && ties == 1) chosen[id] = candidate
  }
  for (line = 1; line <= lines; line++) {
    $0 = source[line]; which = line_item[line]
    if (items == "goal") {
      if (which) printf "\n%s %s\n\n", icon(which), target_text[which]
      else print
    } else {
      if (/^#/ || /^[ \t]*$/) continue
      if (/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) { printf "%s### %s\n\n", (days++ ? "\n" : ""), $0; continue }
      if (/^[+*] /) { item(substr($0, 3), "🌳", 0); continue }
      if (/^- /) { item(substr($0, 3), "", 1); continue }
      item($0, icon(which), 0)
    }
  }
}'

# Keep the opening goal paragraph visible; fold its remaining instructions.
# Work on the rendered goal so numbered/list items keep their activity icons.
GOAL_AWK='
/^[ \t]*$/ {
  if (started) details = 1
  if (details) body = body "\n"
  next
}
{
  if (!details) { print; started = 1 }
  else body = body $0 "\n"
}
END {
  if (body ~ /[^[:space:]]/) {
    sub(/^\n+/, "", body); sub(/\n+$/, "", body)
    printf "\n<details>\n<summary>Details</summary>\n\n%s\n\n</details>\n", body
  }
}'

# The bids, the last 20, each a
# details block: its outcome's icon and its title in the summary (the leader's for a merge or a rejection, else its
# bidder's, else the start of its note), then the bidder's title and note and
# the leader's reason inside. Chart increasing, merged; ticket, pending; chart decreasing, rejected;
# headstone, cleared or withdrawn (stale in the legend). Their text is HTML-escaped: other agents wrote it.
BIDS_AWK='
function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
function rest(n,   s) { s = $0; sub("^[a-z]+ " n " ?", "", s); return s }
$1 == "bid" { n++; id[n] = $2; st = $3; gsub(/[^a-z]/, "", st); state[$2] = st
  for (i = 3; i < NF; i++) if ($i == "task") { by[$2] = $(i + 3); w = $0; sub("^.* task [0-9]+ by [^ ]+ ?", "", w); why[$2] = w; break } }
$1 == "title" { title[$2] = rest($2) }
$1 == "verdict" { verdict[$2] = rest($2) }
$1 == "note" { note[$2] = rest($2) }
END {
  for (j = (n > 20 ? n - 19 : 1); j <= n; j++) { b = id[j]; s = state[b]
    icon = s == "merged" ? "📈" : s == "pending" ? "🎫" : s == "rejected" ? "📉" : "🪦"
    t = (s == "merged" || s == "rejected") && verdict[b] != "" ? verdict[b] : title[b] != "" ? title[b] : note[b]
    if (s == "rejected" && verdict[b] == "" && title[b] == "" && why[b] != "") t = why[b]
    if (t == "") t = "bid " b
    if (length(t) > 60) t = substr(t, 1, 59) "…"
    printf "<details>\n<summary>%s (%s) %s</summary>\n\n_bid %s by %s, %s_\n\n", icon, esc(by[b]), esc(t), b, by[b], s
    if (title[b] != "" && title[b] != t) printf "**%s**\n\n", esc(title[b])
    if (note[b] != "") printf "%s\n\n", esc(note[b])
    if (why[b] != "") printf "_%s: %s_\n\n", (s == "rejected" ? "Rejected" : "Why"), esc(why[b])
    printf "</details>\n\n"
  }
}'

# One shared monotone observer supplies the view, readiness and history.
# Each watchdog reader owns its snapshot file, so the relay cannot replace
# it midway through rendering. Metadata is data, never evaluated as shell.
status_observe() {
  obs_=$(python3 "$here/integrations/cmux/events.py" "$NET" --state "${MUX_STATE:-$(basename "$ST")}" \
    --status-view --status-output "$ST/status-view.$$.txt") || obs_='{}'
  STATUS_FILE=$(printf '%s' "$obs_" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("file") or "/dev/null")')
  STATUS_AGENT=$(printf '%s' "$obs_" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("agent") or "")')
  STATUS_STATE=$(printf '%s' "$obs_" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("state") or "unavailable")')
  STATUS_HEIGHT=$(printf '%s' "$obs_" | python3 -c 'import json,sys; v=json.load(sys.stdin).get("height"); print(v if v is not None else "unknown")')
  STATUS_SAME_CHAIN=$(printf '%s' "$obs_" | python3 -c 'import json,sys; print("yes" if json.load(sys.stdin).get("same_chain") else "no")')
}

# The market's title, the goal's heading and the workspace's name: Market (X
# leader) while X leads, Market while a leader is drawn, and Done once the
# market finished. In a finishing market (genesis finish=1) whose leaders
# have begun to say there are no more tasks, the count joins it: Market (X
# leader, N/K to done), N of the K agents on the roster having said so.
# (No height or term: with them it changed with every block; the leader
# changes once a term.)
market_title() {
  if [ "$#" -gt 0 ]; then f_=$1 state_=${2:-available}; else
    status_observe; f_=$STATUS_FILE state_=$STATUS_STATE
  fi
  label_=Market
  if [ -f "$f_" ]; then
    mode_=$(awk '$1 == "market-mode" { print $2; exit }' "$f_")
    case $mode_ in monopoly) label_=Monopoly ;; oligopoly) label_=Oligopoly ;; esac
  fi
  if [ "$state_" != available ]; then printf '%s (status %s)' "$label_" "$state_"; return 0; fi
  [ -f "$f_" ] || { printf 'Market'; return 0; }
  grep -q '^finished:' "$f_" && { if [ "$label_" = Market ]; then printf 'Done'; else printf '%s (Done)' "$label_"; fi; return 0; }
  awk -v label="$label_" 'NR == 1 { for (i = 1; i < NF; i++) if ($i == "leader") l = $(i + 1) }
    /^no more tasks: [0-9]+ of [0-9]+/ { v = $4 "/" $6; sub(/,$/, "", v); v = v " to done" }
    END { p = (l == "" || l ~ /^\(/) ? "" : l " leader"
          if (v != "") p = (p == "" ? v : p ", " v)
          printf "%s", (p == "" ? label : label " (" p ")") }' "$f_"
}

render_plan() {
  if [ "$#" -ge 4 ]; then
    f=$1 a1=$2 state_=$3 observed_=$4
  else
    status_observe
    a1=$STATUS_AGENT f=$STATUS_FILE state_=$STATUS_STATE observed_=$STATUS_HEIGHT
  fi
  sf=$f; [ -f "$sf" ] || sf=/dev/null
  {
    head=$(market_title "$sf" "$state_")
    if [ "$state_" != available ]; then
      printf '_Status observation: %s; last accepted committed height %s._\n\n' "$state_" "$observed_"
    fi
    g=$(cat "$ST/goal" 2>/dev/null || true)
    if [ -n "$g" ] && [ -f "$g" ]; then
      printf '## %s\n\n' "$head"
      awk -v items=goal "$ITEMS_AWK" "$sf" "$g" | awk "$GOAL_AWK"; printf '\n'
    fi
    for r in "$NET/$a1"/repos/*/; do
      [ -n "$a1" ] || break
      repo_name_=$(basename "$r")
      tree_=$(awk -v repo="$repo_name_" '$1 == "repo" && $2 == repo { print $3; exit }' "$sf")
      if [ -n "$tree_" ]; then
        # Read exactly the committed tree named by this status, rather than
        # a newer HEAD or an uncommitted working copy at the selected node.
        plan=$(git -C "$r" show "$tree_:.plan" 2>/dev/null) || continue
      else
        plan=$(git -C "$r" show HEAD:.plan 2>/dev/null || cat "$r/.plan" 2>/dev/null) || continue
      fi
      [ -n "$plan" ] || continue
      printf '## Goals\n\n'
      printf '_🫘 open  🌱 working  🪴 progressing  🌳 done_\n\n'
      # .plan: "# " comments, a date per day, an item a line: "+ " or "* " done, "- " dropped
      printf '%s\n' "$plan" | awk -v items=plan "$ITEMS_AWK" "$sf" -
      printf '\n'
    done
    if [ -f "$f" ] && grep -q '^bid ' "$f"; then
      printf '## Contributions\n\n'
      printf '_🎫 pending  📈 accepted  📉 rejected  🪦 stale_\n\n'
      awk "$BIDS_AWK" "$f"
    fi
  } > "$ST/plan.md.tmp" || return 1
  [ -s "$ST/plan.md.tmp" ] || printf 'No goal, plan or tasks yet.\n' > "$ST/plan.md.tmp"
  if cmp -s "$ST/plan.md.tmp" "$ST/plan.md"; then
    rm -f "$ST/plan.md.tmp"
  else
    mv "$ST/plan.md.tmp" "$ST/plan.md" || return 1
    : > "$ST/plan-update-pending"
  fi
  # Failed browser delivery must retry even when the Markdown is unchanged.
  if [ -e "$ST/plan-update-pending" ]; then
    mux_plan_changed || return 1
    rm -f "$ST/plan-update-pending"
  fi
}

# The run's record (see the top): every node's chain, status and log, never a
# key; with BUNDLE=1, a git bundle of each repository at the first node's head
# (HEAD itself: the node keeps the market's merges on a detached HEAD, which
# --all alone leaves out)
record() {
  rec=$(cat "$ST/record" 2>/dev/null) || return 0
  [ -n "$rec" ] && mkdir -p "$rec" || return 0
  for a_ in $(agents_of "$NET"); do
    mkdir -p "$rec/$a_"
    for x in blocks.log status.txt node.log genesis.json; do
      [ -f "$NET/$a_/$x" ] && ! cmp -s "$NET/$a_/$x" "$rec/$a_/$x" && cp "$NET/$a_/$x" "$rec/$a_/$x"
    done
    if [ "${BUNDLE:-}" = 1 ] && [ -d "$NET/$a_/leader-chain.git" ]; then
      git -C "$NET/$a_/leader-chain.git" bundle create "$rec/$a_/leader-chain.bundle" --all >/dev/null 2>&1 || true
    fi
    if [ "${BUNDLE:-}" = 1 ]; then
      # Candidate refs belong to the checking author, so keep every node's
      # objects, not only the first node's accepted checkout below.
      for ar_ in "$NET/$a_"/repos/*/; do
        [ -d "$ar_/.git" ] || continue
        mkdir -p "$rec/$a_/repos"
        git -C "$ar_" bundle create "$rec/$a_/repos/$(basename "$ar_").bundle" --all HEAD >/dev/null 2>&1 || true
      done
    fi
  done
  for x in leaders.log plan.md; do [ -f "$ST/$x" ] && cp "$ST/$x" "$rec/$x"; done
  [ ! -f "$ST/events/state.json" ] || cp "$ST/events/state.json" "$rec/events.json"
  g_=$(cat "$ST/goal" 2>/dev/null || true); [ -n "$g_" ] && [ -f "$g_" ] && cp "$g_" "$rec/goal.txt"
  if [ "${BUNDLE:-}" = 1 ]; then
    for r_ in "$NET/$(agents_of "$NET" | head -1)"/repos/*/; do
      [ -d "$r_/.git" ] || continue
      mkdir -p "$rec/repos" && git -C "$r_" bundle create "$rec/repos/$(basename "$r_").bundle" --all HEAD >/dev/null 2>&1 || true
    done
  fi
  return 0
}

# One pass of what the watchdog keeps: the workspace's name (the market's
# title, renamed when it changes), the plan, and, once a finishing market
# (genesis finish=1) finished (its nodes stop on their own), word to the
# diplomats (their inbox wait says so) and to you, once
status_pass() {
  status_observe
  pass_file_=$STATUS_FILE pass_agent_=$STATUS_AGENT pass_state_=$STATUS_STATE
  pass_height_=$STATUS_HEIGHT pass_chain_=$STATUS_SAME_CHAIN
  w=$(workspace) title=$(market_title "$pass_file_" "$pass_state_")
  if ! render_plan "$pass_file_" "$pass_agent_" "$pass_state_" "$pass_height_"; then
    say "plan view update failed; retrying before publishing $title" >&2
    record
    return 0
  fi
  if [ "$title" != "$(cat "$ST/title" 2>/dev/null || true)" ]; then
    mux_rename_ws "$w" "$title" && printf '%s\n' "$title" > "$ST/title"
  fi
  record
  if [ ! -e "$ST/finished" ] && market_finished "$pass_file_" "$pass_state_" "$pass_chain_"; then
    BUNDLE=1 record
    : > "$ST/finished"
    for a in $(agents_of "$NET"); do [ -d "$ST/$a/inbox" ] && : > "$ST/$a/inbox/finished"; done
    mux_notify "$w" "" "Pantheon: the market finished" "Every agent, as leader, found no more tasks: the nodes stopped. $prog down $NET closes the workspace."
  fi
}

# AGENT's session state, from the multiplexer (mux_state): working, idle,
# done, completed, waiting, needs_input, blocked, or none (no agent seen in its tab)
session_state() {
  s=$(cat "$ST/$1/surface" 2>/dev/null) || { echo none; return 0; }
  mux_state "$s"
}

# a finishing market (genesis finish=1) that finished: its nodes stopped, and
# no request will come, so a diplomat that stopped is done, not stuck
market_finished() {
  if [ "$#" -ge 3 ]; then
    finished_file_=$1 finished_state_=$2 finished_chain_=$3
  else
    status_observe
    finished_file_=$STATUS_FILE finished_state_=$STATUS_STATE finished_chain_=$STATUS_SAME_CHAIN
  fi
  [ "$finished_state_" != conflict ] && [ "$finished_chain_" = yes ] \
    && [ -f "$finished_file_" ] && grep -q '^finished:' "$finished_file_"
}

# An unanswered request whose backend is still waiting. Claimed requests
# count too: a diplomat can stop after taking one. Replies and expired or
# malformed requests must never cause a wake-up.
pending_inbox_request() {
  ir_now=$(date +%s)
  for ir_dir in "$ST/$1/inbox"/*; do
    [ -f "$ir_dir/prompt.txt" ] || continue
    [ ! -e "$ir_dir/expired" ] && [ ! -e "$ir_dir/reply.txt" ] && [ ! -e "$ir_dir/done" ] || continue
    ir_deadline=$(cat "$ir_dir/deadline" 2>/dev/null) || continue
    case $ir_deadline in ''|*[!0-9]*) continue ;; esac
    if [ "$ir_deadline" -gt "$ir_now" ]; then basename "$ir_dir"; return 0; fi
  done
  return 1
}

# pantheon-inbox wait owns this lease only while its process is alive.
# No provider-specific screen scraping is needed for background waits.
inbox_waiting() {
  iw_now=$(date +%s)
  for iw_marker in "$ST/$1/inbox"/.waiting.*; do
    [ -f "$iw_marker" ] || continue
    iw_pid=${iw_marker##*.}
    case $iw_pid in ''|*[!0-9]*) continue ;; esac
    [ "$iw_pid" -gt 1 ] || continue
    iw_deadline=$(cat "$iw_marker" 2>/dev/null) || continue
    case $iw_deadline in ''|*[!0-9]*) continue ;; esac
    if [ "$iw_deadline" -gt "$iw_now" ] && kill -0 "$iw_pid" 2>/dev/null; then return 0; fi
  done
  return 1
}

watch_agent() {
  a=$1 st=$ST/$a/watchdog
  [ -f "$ST/$a/surface" ] || return 0
  # the market finished: a nudge would only wake it to look for requests that won't come
  if market_finished; then
    [ -n "${dry:-}" ] || rm -f "$st" "$st.request"
    [ -z "${dry:-}" ] || say "watchdog: $a finished"; return 0
  fi
  # its node holds requests for a usage limit: it's right to stop
  if grep -q '^LIMIT' "$NET/$a/status.txt" 2>/dev/null; then
    [ -n "${dry:-}" ] || rm -f "$st" "$st.request"
    [ -z "${dry:-}" ] || say "watchdog: $a limited"; return 0
  fi
  state=$(session_state "$a")
  case $state in
    idle|done|completed)
      idle=1
      reason=""
      if inbox_waiting "$a"; then reason="waiting for inbox"
      elif request=$(pending_inbox_request "$a"); then :
      else reason="no unanswered request"; fi
      if [ -n "$reason" ]; then
        [ -n "${dry:-}" ] || rm -f "$st" "$st.request" "$st.asked"
        [ -z "${dry:-}" ] || say "watchdog: $a $state ($reason)"
        return 0
      fi ;;
    needs_input|blocked|waiting)
      # a person's call: say so once, and nudge no one
      if [ ! -f "$st.asked" ] && [ -z "${dry:-}" ]; then
        mux_notify "$(workspace)" "$(cat "$ST/$a/surface")" "Pantheon: $a" "$a's diplomat waits on you ($state): its tab is \"$a diplomat\""
        : > "$st.asked"
      fi
      idle=0 ;;
    *) rm -f "$st.asked"; idle=0 ;;
  esac
  [ -z "${dry:-}" ] || { say "watchdog: $a $state"; return 0; }
  [ "$idle" = 1 ] || { rm -f "$st" "$st.request"; return 0; }
  # Count consecutive idle passes for the same outstanding request, not
  # time spent legitimately waiting or an earlier request already answered.
  if [ "$(cat "$st.request" 2>/dev/null || true)" != "$request" ]; then
    rm -f "$st"
    printf '%s\n' "$request" > "$st.request"
  fi
  n=$(( $(cat "$st" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$st"
  [ "$n" -ge 2 ] && [ $(( (n - 2) % 5 )) -eq 0 ] || return 0
  msg="Your inbox still has an unanswered request ($request). Check it and continue the wait, answer, repeat loop (your instructions: $ST/$a/desk/instructions.md). If your provider says you've hit a usage limit, report it with limited as they say, then stop."
  mux_message "$(cat "$ST/$a/surface")" "$msg" \
    && say "watchdog: $a idle with request $request unanswered for $n checks: nudged it back to its inbox"
}

# Each term's leader, from status.txt's history line (the last 8 terms'
# leaders, in order, the last the term's on the first line; so a term shorter
# than a pass isn't missed): a new one is said, and kept in
# NET/.cmux/leaders.log, a line a term: TERM LEADER HEIGHT TIME, the height
# and time the watchdog saw it at
note_leaders() {
  status_observe
  [ "$STATUS_STATE" = available ] || return 0
  f=$STATUS_FILE
  [ -f "$f" ] || return 0
  seen=0; [ -s "$ST/leaders.log" ] && seen=$(tail -1 "$ST/leaders.log" | cut -d' ' -f1)
  awk -v seen="$seen" -v now="$(date '+%H:%M:%S')" '
    NR == 1 { for (i = 1; i < NF; i++) { if ($i == "height") h = $(i + 1); if ($i == "term") t = $(i + 1) } }
    $1 == "history" { for (i = 2; i <= NF; i++) { k = t - (NF - i); if (k > seen) printf "%d %s %s %s\n", k, $i, h, now }; exit }' "$f" > "$ST/leaders.new"
  while read -r term ldr hh tm; do say "term $term: $ldr leads (seen at h$hh)"; done < "$ST/leaders.new"
  cat "$ST/leaders.new" >> "$ST/leaders.log"; rm -f "$ST/leaders.new"
}

cmd_watchdog() {
  net_arg "${1:-}" watchdog; need_cmux
  [ -n "$(workspace)" ] || die "$NET isn't up in $MUX: $prog up $NET"
  case ${2:-} in
    --check) for a in $(agents_of "$NET"); do dry=1 watch_agent "$a"; done; return 0 ;;
    --once) note_leaders; for a in $(agents_of "$NET"); do watch_agent "$a" || true; done; return 0 ;;
  esac
  events_pid=""
  if [ "${PANTHEON_EVENTS:-1}" != 0 ]; then
    mkdir -p "$ST/events"
    mux_events >> "$ST/events/relay.log" 2>&1 &
    events_pid=$!
    trap 'stop_events' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
  fi
  say "keeping $NET's workspace name and plan, saying each term's leader (all of them in $ST/leaders.log), and watching its diplomats every minute"
  p=0
  while :; do
    status_pass; note_leaders
    # Stop only after status_pass published completion to the view and inboxes.
    # A node can finish between that pass and this check; another read of its
    # status could otherwise stop us with a stale view and diplomats waiting.
    if [ -e "$ST/finished" ]; then say "the market finished, so the diplomats are done: the watchdog stops, and nudges no one"; return 0; fi
    if [ $((p % 6)) -eq 0 ]; then for a in $(agents_of "$NET"); do watch_agent "$a" || true; done; fi
    p=$((p + 1)); sleep 10
  done
}

stop_events() {
  if [ -n "${events_pid:-}" ]; then
    kill -TERM "$events_pid" 2>/dev/null || true
    wait "$events_pid" 2>/dev/null || true
    events_pid=""
    record
  fi
}

cmd_down() {
  net_arg "${1:-}" down; need_cmux
  # the record, before anything stops
  BUNDLE=1 record; rec=$(cat "$ST/record" 2>/dev/null || true)
  if ! workspace_alive; then say "$NET has no $MUX workspace up"; rm -f "$ST/workspace"
  elif mux_close "$(workspace)"; then say "closed $NET's workspace"; rm -f "$ST/workspace"
  else say "$MUX didn't close $NET's workspace ($(workspace)); its nodes stop anyway. Close it yourself, or run down again"; fi
  # its nodes end with their terminals, in a few seconds; one that doesn't is terminated
  tries=0
  while pgrep -f -- "node $NET/" >/dev/null 2>&1 && [ "$tries" -lt 20 ]; do tries=$((tries + 1)); sleep 0.5; done
  if pgrep -f -- "node $NET/" >/dev/null 2>&1; then
    pkill -TERM -f -- "node $NET/" && say "terminated $NET's nodes that outlived their terminals"
  fi
  # and again once they stopped: their last blocks
  BUNDLE=1 record
  say "$NET's nodes are stopped"
  [ -z "$rec" ] || say "its record (chain, statuses, logs, repositories) is kept in $rec"
}

cmd_render_plan() {
  MUX_STATE=.agora-view
  net_arg "${1:-}" render-plan
  shift
  goal_="" output_="" plain_=0
  while [ "$#" -gt 0 ]; do
    case $1 in
      --goal) [ "$#" -ge 2 ] || die "--goal needs a file"; goal_=$2; shift ;;
      --output) [ "$#" -ge 2 ] || die "--output needs a file"; output_=$2; shift ;;
      --plain) plain_=1 ;;
      *) die "unknown render-plan option: $1" ;;
    esac
    shift
  done
  [ -f "$goal_" ] && [ -n "$output_" ] || die "render-plan requires --goal FILE --output FILE"
  mkdir -p "$ST"
  printf '%s\n' "$goal_" > "$ST/goal"
  # Rendering is an observer: no mux calls, node startup, hooks or nudges.
  mux_plan_changed() { :; }
  render_plan
  python3 - "$ST/plan.md" "$output_" "$plain_" <<'PY'
import html, os, re, sys, tempfile
from pathlib import Path
source, target = map(Path, sys.argv[1:3])
text = source.read_text()
if sys.argv[3] == '1':
    text = re.sub(r'^</?details>\s*$', '', text, flags=re.M)
    text = re.sub(r'^<summary>(.*?)</summary>$', r'**\1**', text, flags=re.M)
    text = html.unescape(text)
if target.exists() and target.read_text() == text:
    sys.exit(0)
target.parent.mkdir(parents=True, exist_ok=True)
fd, temporary = tempfile.mkstemp(prefix=target.name + '.', dir=target.parent)
try:
    with os.fdopen(fd, 'w') as stream:
        stream.write(text)
    os.replace(temporary, target)
finally:
    if os.path.exists(temporary): os.unlink(temporary)
PY
}

c=${1:-}; [ $# -gt 0 ] && shift
case $c in
  up|watchdog|down|render-plan) "cmd_$(printf '%s' "$c" | tr - _)" "$@" ;;
  *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; [ -z "$c" ] || [ "$c" = help ] || [ "$c" = -h ] || exit 1 ;;
esac
