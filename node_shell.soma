(** The binary's runner: node programs (nodeio.soma's [nprog]) carried
    out by Soma.Host's primitives, each operation the one Soma.Host
    declares for it ([host_prim]), and [pantheon node]'s loop: the node's
    kernel (node_kernel.soma), whose network and named files are
    node_net.soma's here over the host's sockets and paths, as the
    unikernel's runner carries them out with Sandbox
    (node_sandbox.soma), and whose git and programs are node_git.soma's
    over the host's. Nothing else of the node calls the host: node.soma,
    cli.soma and what they import are Soma over the node's operations. *)
Import util nodeio node node_kernel node_net node_git node_path node_file node_service cli.
Require Soma.Host.

(** One primitive on the host: the operation's fields handed to the
    Soma.Host primitive for it (Soma carries them out). An operation that
    is none (the kernel's, or one a runner carries out itself) reaching
    here is a bug: the binary refuses to go on, naming it. *)
host_prim (op : node_op) : nanswer :=
  match op with
  | IoClock => Host.clock tt
  | IoLog text => Host.log text
  | IoLocalTime stamp => Host.local_time stamp
  | IoFail message => Host.fail message
  | IoPrint text => Host.print text
  | IoExit code => Host.exit code
  | IoCwd => Host.cwd tt
  | IoRandomHex count =>
      match Host.random_bytes count with
      | (true, (_, [b])) => ans_data true [Crypto.hex_of_bytes (Crypto.bytes_of_string b)]
      | a => a
      end
  | IoReadText path => Host.read_text path
  | IoFileExists path => Host.file_exists path
  | IoDirEntries path => Host.dir_entries path
  | IoChmod path mode => Host.chmod path mode
  | IoAppendSynced path text => Host.append_synced path text
  | IoFilePut path text sync => Host.file_put path text sync
  | IoFileMode path => Host.file_mode path
  | IoRename src dst => Host.rename src dst
  | IoSyncDir dir => Host.sync_dir dir
  | IoMakeDir path => Host.make_dir path
  | IoRemoveFile path => Host.remove_file path
  | IoTempNew prefix suffix => Host.temp_new prefix suffix
  | IoTempDir prefix => Host.temp_dir prefix
  | IoStartDetached prog args => Host.start_detached prog args
  | IoSelfExe => Host.self_exe tt
  | IoEnvEntries => Host.env_entries tt
  | IoPathStat path => Host.path_stat path
  | IoSpawn prog stdin cwd env args => Host.spawn prog stdin cwd env args
  | IoWaitPid pid => Host.wait_pid pid
  | IoKillPid pid => Host.kill_pid pid
  | IoNoSigpipe => Host.no_sigpipe tt
  | IoStartLogged prog log args => Host.start_logged prog log args
  | IoStopOnSignal pids => Host.stop_on_signal pids
  | IoSockListen host port backlog => Host.sock_listen host port backlog
  | IoSockDial host port => Host.sock_dial host port
  | IoSockSelect ms reads writes =>
      let '(ok, (r, w)) := Host.sock_select ms reads writes in
      if ok then ans_data true (nio_frame_lists [r, w]) else ans_data false r
  | IoSockAccept fd nonblock => Host.sock_accept fd nonblock
  | IoSockRead fd => Host.sock_read fd
  | IoSockWrite fd data => Host.sock_write fd data
  | IoSockError fd => Host.sock_error fd
  | IoSockClose fd => Host.sock_close fd
  | _ => Host.fail (append "unknown node operation " (Stdlib.Strings.String.concat " " (io_wire op)))
  end.

(** The host's primitives: each operation through [host_prim], in
    order, each answer handed to the rest of the program. Every operation
    the binary does goes through here. *)
Fixpoint run_prims {A : Type} (p : nprog A) : A :=
  match p with
  | NDone a => a
  | NStep op k => run_prims (k (host_prim op))
  end.

(** One operation as the binary carries it out: git and programs as
    node_git.soma runs them ([git_op]), a path in a checkout looked at as
    node_path.soma does ([path_op]), a file written whole, directories
    made and files removed as node_file.soma does ([file_op]), each over
    the shell's primitives;
    the rest by the shell's primitives *)
shell_answer (op : node_op) : nanswer :=
  match git_op op with
  | Some q => run_prims q
  | None =>
      match path_op op with
      | Some q => run_prims q
      | None =>
          match file_op op with
          | Some q => run_prims q
          | None => host_prim op
          end
      end
  end.

(** The binary's interpreter of a node program: each operation carried
    out in order ([shell_answer]), each answer handed to the rest of the
    program. A unikernel runs the same programs with Sandbox's
    ([run_image]). *)
Fixpoint run_shell {A : Type} (p : nprog A) : A :=
  match p with
  | NDone a => a
  | NStep op k => run_shell (k (shell_answer op))
  end.

(** A node's or the service's program: the network's, the named files'
    and the service socket's operations carried out by node_net.soma
    ([net_op]) from its state, which it hands on; the rest by the shell *)
Fixpoint run_net {A : Type} (s : net_state) (p : nprog A) : A * net_state :=
  match p with
  | NDone a => (a, s)
  | NStep op k =>
      match net_op s op with
      | Some q => let r := run_shell q in run_net (snd r) (k (fst r))
      | None => run_net s (k (shell_answer op))
      end
  end.

(** The boot events, expanded (tests read them) *)
boot_expand (evs : list (list string)) : list (list string) :=
  run_shell (boot_expand_prog evs).

(** the network's state, from the node's home (what node_setup decided:
    its first row's first field) *)
net_open (config : list (list string)) : net_state :=
  net_start (match config with (home :: _) :: _ => home | _ => "" end).

(** a program, after making a write to a closed connection an error rather
    than the end of the process *)
no_sigpipe {A : Type} (p : nprog A) : nprog A := nbind (nexec IoNoSigpipe) (fun _ => p).

(** [pantheon node]: the setup (cli.soma's node_setup, run with no node),
    the network's state from it, then the kernel: listening, startup and
    the loop's turns, each from the state the last left *)
run_node (home : string) (flags : list string) : unit :=
  match run_shell (node_setup home flags) with
  | Some config =>
      match kernel_world config with
      | Some w =>
          match run_net (net_open config) (no_sigpipe (kernel_boot_prog w (kernel_start (w_identity w) config))) with
          | (Some p, s) => Host.forever (fun ps => run_net (snd ps) (kernel_tick_prog w (fst ps))) (p, s)
          | (None, _) => tt
          end
      | None => run_shell (nbind (nask (IoFail "the node's setup came back malformed")) (fun _ => NDone tt))
      end
  | None => tt
  end.

(** [pantheon service HOME HOST:PORT]: the setup, the network's state as
    [pantheon node] makes it, what the service knows of itself, then the
    requests of the node's unikernel answered as the node's own host work
    asks (node_service.soma's [service_tick_prog]) *)
run_service (home addr : string) (flags : list string) : unit :=
  match run_shell (node_setup home flags) with
  | Some config =>
      match run_net (net_open config)
              (no_sigpipe (nbind (service_start_prog addr) (fun ok =>
               if ok then nbind (service_world_prog config) (fun w => NDone (Some w)) else NDone None))) with
      | (Some w, s) => Host.forever (fun ps => run_net (snd ps) (service_tick_prog w (fst ps))) (service_begin, s)
      | (None, _) => tt
      end
  | None => tt
  end.
