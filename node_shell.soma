(** The binary's runner: node programs (nodeio.soma's [nprog]) carried
    out by shell.ml, through its one interpreting binding, [node_io], and
    [pantheon node]'s loop: the node's kernel (node_kernel.soma), whose
    primitives shell.ml carries out on the host's sockets and files, as
    the unikernel's runner carries them out with Sandbox
    (node_sandbox.soma). Nothing else of the node calls the shell:
    node.soma, cli.soma and what they import are Soma over the node's
    operations. *)
Import util shell nodeio node node_kernel cli.

(** The binary's interpreter of a node program: each operation through
    [node_io], in its wire form, in order, each answer handed to the rest
    of the program. A unikernel runs the same programs with Sandbox's
    ([run_image]). Every operation the binary does goes through here. *)
Fixpoint run_shell {A : Type} (h : node_t) (p : nprog A) : A :=
  match p with
  | NDone a => a
  | NStep op k => run_shell h (k (node_io h (io_wire op)))
  end.

(** The boot events, expanded (tests read them) *)
boot_expand (h : node_t) (evs : list (list string)) : list (list string) :=
  run_shell h (boot_expand_prog evs).

(** [pantheon node]: the setup (cli.soma's node_setup, run with no node),
    the host's runtime built from it, then the kernel: listening, startup
    and the loop's turns, each from the state the last left *)
run_node (home : string) (flags : list string) : unit :=
  match run_shell "" (node_setup home flags) with
  | Some config =>
      match kernel_world config with
      | Some w =>
          let h := node_open (pack_helpers node_helpers) (nio_frame_lists config) in
          match run_shell h (kernel_boot_prog h w (kernel_start (w_identity w) config)) with
          | Some p => forever (fun p => run_shell h (kernel_tick_prog h w p)) p
          | None => tt
          end
      | None => run_shell "" (nbind (nask (IoFail "the node's setup came back malformed")) (fun _ => NDone tt))
      end
  | None => tt
  end.

(** [pantheon service HOME HOST:PORT]: the setup, the node's runtime built
    from it as [pantheon node] builds it, then the requests of the node's
    unikernel answered (node.soma's [service_tick_prog]) *)
run_service (home addr : string) (flags : list string) : unit :=
  match run_shell "" (node_setup home flags) with
  | Some config =>
      let h := node_open (pack_helpers node_helpers) (nio_frame_lists config) in
      if run_shell h (service_start_prog addr) then
        forever (fun pending => run_shell h (service_tick_prog (service_token_of config) pending)) []
      else tt
  | None => tt
  end.
