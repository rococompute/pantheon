(** Pantheon's commands: init, keygen, genesis, up, status, tx, plan, edits,
    apply-edits and check, as node programs (U-1; docs/SHELL-IN-SOMA.md).
    Each is a value of [nprog unit] over [node_op]: the binary runs it
    through shell.ml's [node_io] (main.soma's [dispatch]), whose path-only
    arms answer the commands' operations with no node. What a command
    decides is here: its arguments, its messages, a new agent's files, the
    genesis's bytes and every check on them. The operations do the I/O:
    printing, files, git, a new RSA key, starting nodes, and the edits
    machinery (still OCaml's). [pantheon node] is node.soma's [run_node]. *)
Import util nodeio.
(* [float] and its literals, OCaml's (Soma.OCaml) *)
From Soma Require Import OCaml.
From Stdlib Require Import Ascii.

cat (l : list string) : string := Stdlib.Strings.String.concat "" l.
join (sep : string) (l : list string) : string := Stdlib.Strings.String.concat sep l.

(** ---- running ---- *)

(** What a program that was refused stops with (a unikernel's [IoFail]
    comes back): nothing, or no result. *)
Class Stops (A : Type) := stop : A.
#[export] Instance stops_unit : Stops unit := tt.
#[export] Instance stops_option {B : Type} : Stops (option B) := None.

(** [op], then [rest], whatever it answered *)
cli_do {R : Type} (op : node_op) (rest : unit -> nprog R) : nprog R := NStep op (fun _ => rest tt).

(** [op], then [rest] given its answer *)
cli_ask {R : Type} (op : node_op) (rest : nanswer -> nprog R) : nprog R := NStep op rest.

(** the message on stderr after "error: ", exit 1 (the binary never comes
    back; a unikernel prints it and stops) *)
cli_fail {R : Type} `{Stops R} (message : string) : nprog R := NStep (IoFail message) (fun _ => NDone stop).

cli_say {R : Type} (text : string) (rest : unit -> nprog R) : nprog R := cli_do (IoSay text) rest.

cli_exists {R : Type} (path : string) (rest : bool -> nprog R) : nprog R :=
  cli_ask (IoFileExists path) (fun a => rest (fst a)).

(** each of [l] in order, each given what comes after it *)
Fixpoint cli_each {A R : Type} (l : list A) (f : A -> (unit -> nprog R) -> nprog R)
  (k : unit -> nprog R) : nprog R :=
  match l with [] => k tt | x :: r => f x (fun _ => cli_each r f k) end.

(** each of [l] in order, each giving a value; then [k] with them all *)
Fixpoint cli_map {A B R : Type} (l : list A) (f : A -> (B -> nprog R) -> nprog R)
  (k : list B -> nprog R) : nprog R :=
  match l with [] => k [] | x :: r => f x (fun b => cli_map r f (fun bs => k (b :: bs))) end.

(** ---- paths, as OCaml's Filename ---- *)

(** Filename.concat: a separator unless [dir] is empty or ends in one *)
path (dir file : string) : string :=
  if (slen dir =? 0) || ends "/" dir then append dir file else cat [dir, "/", file].

is_relative (p : string) : bool := negb (starts "/" p).

Fixpoint drop_slashes (l : list ascii) : list ascii :=
  match l with c :: r => if Ascii.eqb c "/"%char then drop_slashes r else l | [] => [] end.

Fixpoint take_name (l : list ascii) (acc : list ascii) : list ascii :=
  match l with c :: r => if Ascii.eqb c "/"%char then acc else take_name r (c :: acc) | [] => acc end.

(** Filename.basename: the last name, trailing separators dropped *)
basename (s : string) : string :=
  if seq s "" then "." else
  match drop_slashes (List.rev (chars s)) with
  | [] => "/"
  | r => of_chars (take_name r [])
  end.

(** String.split_on_char *)
Fixpoint split_go (c : ascii) (l cur : list ascii) (acc : list string) : list string :=
  match l with
  | [] => List.rev (of_chars (List.rev cur) :: acc)
  | x :: r => if Ascii.eqb x c then split_go c r [] (of_chars (List.rev cur) :: acc) else split_go c r (x :: cur) acc
  end.

split_on (c : ascii) (s : string) : list string := split_go c (chars s) [] [].

(** ---- ordering, as OCaml's compare on strings: by bytes ---- *)

Fixpoint chars_le (a b : list ascii) : bool :=
  match a, b with
  | [], _ => true
  | _ :: _, [] => false
  | x :: a', y :: b' =>
      let m := nat_of_ascii x in let n := nat_of_ascii y in
      if m <? n then true else if n <? m then false else chars_le a' b'
  end.

str_le (a b : string) : bool := chars_le (chars a) (chars b).
str_lt (a b : string) : bool := negb (str_le b a).

Fixpoint insert_str (x : string) (l : list string) : list string :=
  match l with [] => [x] | y :: r => if str_le x y then x :: l else y :: insert_str x r end.

sort_strings (l : list string) : list string := fold_right insert_str [] l.

(** ---- JSON, as Yojson.Safe reads and writes it ----
    A value read from json_tokens' tokens, and written as
    Yojson.Safe.to_string does: no spaces, strings escaped as
    [nio_json_string]. A number keeps its digits; a float keeps the
    tokens' text (rounded to an integer: the node reads them so too). *)
Local Set Warnings "-register-all".
Inductive json :=
| JStr (s : string)
| JBool (b : string)
| JNull
| JNum (digits : string)
| JFloat (text : string)
| JList (l : list json)
| JObj (members : list (string * json)).

Fixpoint json_text (j : json) : string :=
  match j with
  | JStr s => nio_json_string s
  | JBool b => b
  | JNull => "null"
  | JNum d => d
  | JFloat d => d
  | JList l => cat ["[", join "," (List.map json_text l), "]"]
  | JObj kv => cat ["{", join "," (List.map (fun p => match p with (k, v) => cat [nio_json_string k, ":", json_text v] end) kv), "}"]
  end.

(** what Yojson.Safe.to_file writes: the text and a newline *)
json_file (j : json) : string := append (json_text j) newline.

Fixpoint json_value (fuel : nat) (t : list string) {struct fuel} : option (json * list string) :=
  match fuel with
  | 0 => None
  | S f =>
      match t with
      | "S" :: s :: r => Some (JStr s, r)
      | "B" :: b :: r => Some (JBool b, r)
      | "U" :: r => Some (JNull, r)
      | "I" :: d :: r => Some (JNum d, r)
      | "F" :: d :: r => Some (JFloat d, r)
      | "L" :: n :: r =>
          match json_values f (num n) r with Some (l, r') => Some (JList l, r') | None => None end
      | "A" :: n :: r =>
          match json_members f (num n) r with Some (l, r') => Some (JObj l, r') | None => None end
      | _ => None
      end
  end
with json_values (fuel count : nat) (t : list string) {struct fuel} : option (list json * list string) :=
  match fuel with
  | 0 => None
  | S f =>
      match count with
      | 0 => Some ([], t)
      | S c =>
          match json_value f t with
          | Some (v, r) => match json_values f c r with Some (l, r') => Some (v :: l, r') | None => None end
          | None => None
          end
      end
  end
with json_members (fuel count : nat) (t : list string) {struct fuel} : option (list (string * json) * list string) :=
  match fuel with
  | 0 => None
  | S f =>
      match count, t with
      | 0, _ => Some ([], t)
      | S c, k :: rest =>
          match json_value f rest with
          | Some (v, r) => match json_members f c r with Some (l, r') => Some ((k, v) :: l, r') | None => None end
          | None => None
          end
      | S _, [] => None
      end
  end.

(** a JSON text's value; every value and member takes a token or more,
    and each takes one step of fuel on each side *)
json_of (raw : string) : option json :=
  match json_tokens raw with
  | Some t => match json_value (3 * length t + 3) t with Some (j, []) => Some j | _ => None end
  | None => None
  end.

(** Yojson.Safe.Util.member: the first member named [k]; null when none *)
json_member (k : string) (j : json) : json :=
  match j with JObj kv => match lookup k kv with Some v => v | None => JNull end | _ => JNull end.

json_string (j : json) : option string := match j with JStr s => Some s | _ => None end.

Fixpoint json_strings (l : list json) : option (list string) :=
  match l with
  | [] => Some []
  | JStr s :: r => match json_strings r with Some ss => Some (s :: ss) | None => None end
  | _ => None
  end.

Fixpoint kv_insert (x : string * json) (l : list (string * json)) : list (string * json) :=
  match l with [] => [x] | y :: r => if str_lt (fst x) (fst y) then x :: l else y :: kv_insert x r end.

(** members by name, as a stable sort (List.sort) leaves them *)
kv_sort (l : list (string * json)) : list (string * json) := fold_left (fun acc x => kv_insert x acc) l [].

cli_read_text {R : Type} `{Stops R} (p : string) (missing : string) (k : string -> nprog R) : nprog R :=
  cli_ask (IoReadText p) (fun a => match ans_found_one a with Some t => k t | None => cli_fail missing end).

(** a home's JSON file: refusing it says what's wrong *)
cli_read_json {R : Type} `{Stops R} (p : string) (k : json -> nprog R) : nprog R :=
  let refused := cat ["cannot read ", p, ": is this a home made by `pantheon init`?"] in
  cli_read_text p refused (fun t => match json_of t with Some j => k j | None => cli_fail refused end).

cli_str {R : Type} `{Stops R} (j : json) (refused : string) (k : string -> nprog R) : nprog R :=
  match json_string j with Some s => k s | None => cli_fail refused end.

(** ---- keys ---- *)

(** the draw's hash chain: the tip is the secret hashed this many times *)
chain_len : nat := 100 * 1000.

Fixpoint iterate (n : nat) (x : string) : string :=
  match n with 0 => x | S m => iterate m (sha256 x) end.

agents_default : list string := ["claude", "codex", "grok", "muse"].

(** a key as key.json and public.json hold it, from [IoNewKey]'s
    [size, n, e, d, p, q, dp, dq, qinv]; the private parts only in key.json *)
key_json (k : list string) (priv : bool) : json :=
  match k with
  | [size, n, e, d, p, q, dp, dq, qinv] =>
      JObj ([("size", JNum size), ("n", JStr n), ("e", JStr e)]
            ++ if priv then [("d", JStr d), ("p", JStr p), ("q", JStr q), ("dp", JStr dp), ("dq", JStr dq), ("qinv", JStr qinv)] else [])
  | _ => JNull
  end.

(** An agent's keys, made on its own machine: key.json and chain.json stay
    there; public.json is what the network needs. [k] gets its path. *)
make_keys (home name addr : string) (k : string -> nprog unit) : nprog unit :=
  cli_exists (path home "key.json") (fun has =>
  if has then cli_fail (cat [home, " already has keys. They are this agent's identity: keep them. To start over, remove the directory first"]) else
  cli_do (IoMakeDirs home) (fun _ =>
  cli_do (IoChmod home "700") (fun _ =>
  (* e = 65537, not Cryptokit's random 2048-bit default: Soma checks
     signatures (Soma.Crypto), in about 1 ms with it against 90 *)
  cli_ask (IoNewKey "2048") (fun key =>
  let key := ans_list key in
  cli_ask (IoRandomHex "32") (fun secret =>
  let secret := ans_one secret in
  let priv f j := cli_do (IoWriteFile (path home f) (json_file j)) (fun _ => cli_do (IoChmod (path home f) "600") (fun _ => NDone tt)) in
  nbind (priv "key.json" (JObj [("agent", JStr name), ("key", key_json key true)])) (fun _ =>
  nbind (priv "chain.json" (JObj [("secret", JStr secret)])) (fun _ =>
  let pub := path home "public.json" in
  cli_do (IoWriteFile pub (json_file (JObj [("name", JStr name), ("addr", JStr addr), ("pubkey", key_json key false),
                                             ("tip", JStr (iterate chain_len secret))]))) (fun _ =>
  k pub)))))))).

Fixpoint keygen_args (args : list string) (home name addr : string) : (string * string * string) + string :=
  match args with
  | "--name" :: n :: r => keygen_args r home n addr
  | "--addr" :: a :: r => keygen_args r home name a
  | h :: r => if seq home "" then keygen_args r h name addr else inr (append "unknown keygen argument " h)
  | [] => inl (home, name, addr)
  end.

cmd_keygen (args : list string) : nprog unit :=
  match keygen_args args "" "" "" with
  | inr e => cli_fail e
  | inl (home, name, addr) =>
      if seq home "" || seq name "" || seq addr "" then
        cli_fail "usage: pantheon keygen HOME --name NAME --addr HOST:PORT (HOST: a name or address the other agents reach over the VPN)"
      else make_keys home name addr (fun pub =>
        cli_say (cat ["wrote ", pub, ". Add it to the network as NETWORK/parts/", name,
                      ".json (a pull request is a good way), then, once every agent's part is in, run: pantheon genesis ",
                      home, " NETWORK"]) (fun _ => NDone tt))
  end.

(** ---- genesis ---- *)

(** relative repository URLs are relative to the network directory *)
repo_url (net url : string) : string :=
  if contains "://" url || starts "/" url || ((4 <? slen url) && starts "git@" url) then url else path net url.

(** A checkout of a governed repository at its genesis commit, or a check
    that the one already there descends from it. [k] gets its directory. *)
ensure_repo {R : Type} `{Stops R} (home name url commit : string) (k : string -> nprog R) : nprog R :=
  let dir := path (path home "repos") name in
  cli_exists (path dir ".git") (fun has =>
  if negb has then
    cli_do (IoMakeDirs (path home "repos")) (fun _ =>
    cli_ask (IoClone url dir commit) (fun cloned =>
    if fst cloned then k dir
    else cli_fail (cat ["couldn't clone ", name, " from ", url, " at ", commit, ": check the URL, and that this machine can fetch it"])))
  else
    cli_ask (IoGit dir ["merge-base", "--is-ancestor", commit, "HEAD"]) (fun ok =>
    if fst ok then k dir
    else cli_fail (cat [dir, " holds a checkout of ", name, " that doesn't descend from its genesis commit ", commit, ": move it aside and run again"]))).

part_refused (pdir f what : string) : string := cat [pdir, "/", f, ": ", what].

(** names in order: the first that came before *)
Fixpoint check_names (pdir : string) (l : list (string * json)) (seen : list string) (k : unit -> nprog unit) : nprog unit :=
  match l with
  | [] => k tt
  | (f, j) :: r =>
      cli_str (json_member "name" j) (part_refused pdir f "name is a string") (fun n =>
      if mem n seen then cli_fail (cat ["duplicate part name ", n, " in genesis parts in ", pdir, ": each agent must add exactly one part under its own name"])
      else check_names pdir r (n :: seen) k)
  end.

(** a key as the duplicate check compares it: its members by name *)
key_text (j : json) : string := match j with JObj kv => json_text (JObj (kv_sort kv)) | other => json_text other end.

Fixpoint check_keys (pdir : string) (l : list (string * json)) (seen : list (string * string)) (k : unit -> nprog unit) : nprog unit :=
  match l with
  | [] => k tt
  | (f, j) :: r =>
      cli_str (json_member "name" j) (part_refused pdir f "name is a string") (fun n =>
      let key := key_text (json_member "pubkey" j) in
      match lookup key seen with
      | Some other => cli_fail (cat ["duplicate public key in genesis parts in ", pdir, ": ", other, " and ", n,
                                     " share the same public key; each part must carry its own agent's key"])
      | None => check_keys pdir r ((key, n) :: seen) k
      end)
  end.

(** a part as the genesis holds it, with its name and what it excludes *)
genesis_part (pdir : string) (fj : string * json) (k : (string * list string * json) -> nprog unit) : nprog unit :=
  let '(f, j) := fj in
  cli_str (json_member "name" j) (part_refused pdir f "name is a string") (fun n =>
  if negb (seq (append n ".json") f) then cli_fail (cat [pdir, "/", f, " is named ", n, " inside: rename the file to ", n, ".json"]) else
  let refused := cli_fail (part_refused pdir f "exclude is a list of repository names") in
  let go ex :=
    k (n, ex, JObj ([("name", json_member "name" j), ("addr", json_member "addr" j), ("pubkey", json_member "pubkey" j),
                     ("tip", json_member "tip" j)]
                    ++ match ex with [] => [] | _ => [("exclude", JList (List.map JStr ex))] end)) in
  match json_member "exclude" j with
  | JList l => match json_strings l with Some ex => go ex | None => refused end
  | JNull => go []
  | _ => refused
  end).

genesis_repo (home net : string) (r : json) (k : (string * json) -> nprog unit) : nprog unit :=
  let refused := cli_fail "network.json: a repository's name, url and commit are strings" in
  match json_string (json_member "name" r), json_string (json_member "url" r), json_string (json_member "commit" r) with
  | Some name, Some url, Some commit =>
      if negb (shell_safe_path name) || contains "/" name then cli_fail (append "bad repository name " name) else
      ensure_repo home name (repo_url net url) commit (fun dir =>
      cli_ask (IoGit dir ["rev-parse", append commit "^{tree}"]) (fun tree =>
      k (name, JObj [("name", JStr name), ("url", JStr url), ("commit", JStr commit), ("tree", JStr (trim (ans_one tree)))])))
  | _, _, _ => refused
  end.

Fixpoint foreign_exclusion (rnames : list string) (parts : list (string * list string * json)) : option (string * string) :=
  match parts with
  | [] => None
  | (n, ex, _) :: rest =>
      match List.find (fun r => negb (mem r rnames)) ex with
      | Some r => Some (n, r)
      | None => foreign_exclusion rnames rest
      end
  end.

key_n (j : json) : option string := json_string (json_member "n" j).

(** genesis.json, from NETWORK/network.json and NETWORK/parts/*.json: every
    agent builds the same bytes from the same files, so they compare one hash *)
build_genesis (home net : string) (k : unit -> nprog unit) : nprog unit :=
  cli_read_json (path net "network.json") (fun netj =>
  let pdir := path net "parts" in
  cli_ask (IoDirEntries pdir) (fun entries =>
  let files := sort_strings (List.filter (ends ".json") (ans_list entries)) in
  (* at least four agents: n >= 3f + 1 tolerates f = (n - 1) / 3 faulty
     ones, consensus's quorum being n - f; 4, 7 and 10 are the n that need
     the fewest votes for their f, and any n of 4 or more is safe *)
  let n := show (length files) in
  if length files <? 4 then
    cli_fail (cat ["genesis must have at least 4 parts, got ", n, " (", pdir, " has ", n,
                   " parts; n agents tolerate (n - 1) / 3 faulty ones, so four is the fewest that tolerate one. Each agent runs `pantheon keygen` and adds its public.json there)"])
  else
  cli_map files (fun f k => cli_read_json (path pdir f) (fun j => k (f, j))) (fun raw_parts =>
  check_names pdir raw_parts [] (fun _ =>
  check_keys pdir raw_parts [] (fun _ =>
  cli_map raw_parts (genesis_part pdir) (fun parts =>
  match json_member "repos" netj with
  | JList rs =>
      cli_map rs (genesis_repo home net) (fun repos =>
      (* a part's exclude names repositories outside that agent's scope:
         each is one of the network's, and every repository keeps someone
         whose scope has it, or no one could merge there *)
      let rnames := List.map fst repos in
      match foreign_exclusion rnames parts with
      | Some (pn, r) =>
          cli_fail (cat [pdir, "/", pn, ".json excludes ", r, ", which isn't one of the network's repositories (", join ", " rnames, ")"])
      | None =>
      match List.find (fun r => forallb (fun p => match p with (_, ex, _) => mem r ex end) parts) rnames with
      | Some r =>
          cli_fail (cat ["every part in ", pdir, " excludes repository ", r,
                         ": no agent could merge there; drop it from network.json or from one part's exclude"])
      | None =>
      let body := [("block_ms", match json_member "block_ms" netj with JNum i => JNum i | _ => JNum "1000" end),
                   ("agents", JList (List.map (fun p => match p with (_, _, j) => j end) parts)),
                   ("params", match json_member "params" netj with JObj kv => JObj kv | _ => JObj [] end),
                   ("repos", JList (List.map snd repos))] in
      let id := append "pantheon-" (substr (sha256 (json_text (JObj body))) 0 16) in
      let text := json_text (JObj (("chain_id", JStr id) :: body)) in
      let gp := path home "genesis.json" in
      let ours := path home "key.json" in
      cli_exists ours (fun has_key =>
      let written _ :=
        cli_ask (IoReadText gp) (fun old =>
        cli_exists (path home "blocks.log") (fun has_blocks =>
        let differs := match ans_found_one old with Some t => negb (seq t text) | None => false end in
        if differs && has_blocks then
          cli_fail (cat [home, " already runs a different chain (it has blocks). A new genesis is a new chain: use a new home, or remove blocks.log and signed.log on purpose"])
        else
        cli_do (IoWriteFile gp text) (fun _ =>
        cli_say (cat ["wrote ", gp, ": chain ", id, ", genesis hash ", sha256 text, ". Every agent should get the same hash"]) k))) in
      if negb has_key then written tt else
      cli_read_json ours (fun kj =>
      match json_string (json_member "agent" kj), key_n (json_member "key" kj) with
      | Some me, Some kn =>
          if List.existsb (fun p => match p with (pn, _, j) =>
               seq pn me && match key_n (json_member "pubkey" j) with Some pk => seq pk kn | None => false end end) parts
          then written tt
          else cli_fail (cat [me, "'s key isn't in ", pdir, ": add this agent's public.json as parts/", me, ".json"])
      | _, _ => cli_fail (cat ["cannot read ", ours, ": is this a home made by `pantheon init`?"])
      end))
      end
      end)
  | _ => cli_fail "network.json: repos is a list of repositories"
  end)))))).

cmd_genesis (home net : string) : nprog unit := build_genesis home net (fun _ => NDone tt).

(** ---- init: a whole network on one machine, for trying Pantheon and for tests ---- *)

(** "name=value" as (name, value); refusing it names the flag *)
kv_arg (flag kv : string) : (string * string) + string :=
  match find_str "=" kv 0 with
  | Some i => inl (substr kv 0 i, substr kv (i + 1) (slen kv - i - 1))
  | None => inr (cat [flag, " wants name=value, got ", kv])
  end.

Record init_args := { ia_dir : string; ia_repos : list (string * string); ia_port : nat;
                      ia_params : list (string * string); ia_block_ms : nat }.

number_arg (flag v : string) : nat + string :=
  match num_opt v with Some n => inl n | None => inr (cat [flag, " wants a number, got ", v]) end.

Fixpoint init_parse (args : list string) (a : init_args) : init_args + string :=
  match args with
  | "--repo" :: kv :: r =>
      match kv_arg "--repo" kv with
      | inl p => init_parse r {| ia_dir := ia_dir a; ia_repos := ia_repos a ++ [p]; ia_port := ia_port a;
                                ia_params := ia_params a; ia_block_ms := ia_block_ms a |}
      | inr e => inr e
      end
  | "--base-port" :: p :: r =>
      match number_arg "--base-port" p with
      | inl n => init_parse r {| ia_dir := ia_dir a; ia_repos := ia_repos a; ia_port := n;
                                ia_params := ia_params a; ia_block_ms := ia_block_ms a |}
      | inr e => inr e
      end
  | "--block-ms" :: p :: r =>
      match number_arg "--block-ms" p with
      | inl n => init_parse r {| ia_dir := ia_dir a; ia_repos := ia_repos a; ia_port := ia_port a;
                                ia_params := ia_params a; ia_block_ms := n |}
      | inr e => inr e
      end
  | "--param" :: kv :: r =>
      match kv_arg "--param" kv with
      | inl p => init_parse r {| ia_dir := ia_dir a; ia_repos := ia_repos a; ia_port := ia_port a;
                                ia_params := ia_params a ++ [p]; ia_block_ms := ia_block_ms a |}
      | inr e => inr e
      end
  | d :: r =>
      if seq (ia_dir a) "" then
        init_parse r {| ia_dir := d; ia_repos := ia_repos a; ia_port := ia_port a;
                        ia_params := ia_params a; ia_block_ms := ia_block_ms a |}
      else inr (append "unknown init argument " d)
  | [] => inl a
  end.

Fixpoint indexed {A : Type} (i : nat) (l : list A) : list (nat * A) :=
  match l with [] => [] | x :: r => (i, x) :: indexed (S i) r end.

cmd_init (args : list string) : nprog unit :=
  match init_parse args {| ia_dir := ""; ia_repos := []; ia_port := 26700; ia_params := []; ia_block_ms := 500 |} with
  | inr e => cli_fail e
  | inl a =>
  let dir := ia_dir a in
  if seq dir "" || match ia_repos a with [] => true | _ => false end then
    cli_fail "usage: pantheon init DIR --repo NAME=GIT-CHECKOUT [--repo ...] [--base-port P] [--block-ms N] [--param name=value]..."
  else
  let net := path dir "network" in
  cli_exists net (fun has =>
  if has then cli_fail (cat [dir, " already holds a network, keys included. To discard it, stop its nodes and remove the directory; to keep it, pick another DIR"]) else
  cli_do (IoMakeDirs (path net "parts")) (fun _ =>
  cli_ask IoCwd (fun cwd =>
  let abs p := if is_relative p then path (ans_one cwd) p else p in
  cli_map (ia_repos a) (fun np k =>
    let '(n, p) := np in
    let p := abs p in
    cli_ask (IoGit p ["rev-parse", "HEAD"]) (fun commit =>
    let commit := trim (ans_one commit) in
    if seq commit "" then cli_fail (append p " is not a git checkout with a commit")
    else k (JObj [("name", JStr n), ("url", JStr p), ("commit", JStr commit)]))) (fun repos =>
  cli_do (IoWriteFile (path net "network.json")
            (json_file (JObj [("block_ms", JNum (show (ia_block_ms a))),
                              ("params", JObj (List.map (fun kv => (fst kv, JStr (snd kv))) (ia_params a))),
                              ("repos", JList repos)]))) (fun _ =>
  cli_each (indexed 0 agents_default) (fun ia k =>
    let '(i, n) := ia in
    cli_say (append "making keys for " n) (fun _ =>
    make_keys (path dir n) n (append "127.0.0.1:" (show (ia_port a + i))) (fun pub =>
    cli_read_text pub (append "cannot read " pub) (fun t =>
    cli_do (IoWriteFile (path (path net "parts") (append n ".json")) t) k)))) (fun _ =>
  cli_each agents_default (fun n k => build_genesis (path dir n) net k) (fun _ =>
  cli_ask IoSelfExe (fun self =>
  cli_say (cat ["made a 4-agent network in ", dir, ". Run it with: ", ans_one self, " up ", dir]) (fun _ => NDone tt)))))))))
  end.

(** ---- up: a network's nodes, each logging to its node.log ---- *)

Fixpoint backend_pairs (l : list string) : option (list (string * string)) :=
  match l with
  | [] => Some []
  | kv :: r =>
      match split_on "="%char kv, backend_pairs r with
      | [a, b], Some rest => Some ((a, b) :: rest)
      | _, _ => None
      end
  end.

Fixpoint up_args (args : list string) (backends : list (string * string)) (pass : list string)
  : (list (string * string) * list string) + string :=
  match args with
  | "--backends" :: b :: r =>
      match backend_pairs (split_on ","%char b) with
      | Some bs => up_args r bs pass
      | None => inr "--backends wants agent=backend,..."
      end
  | x :: r => up_args r backends (pass ++ [x])
  | [] => inl (backends, pass)
  end.

Fixpoint with_keys (dir : string) (names : list string) (k : list string -> nprog unit) : nprog unit :=
  match names with
  | [] => k []
  | a :: r => cli_exists (path (path dir a) "key.json") (fun has => with_keys dir r (fun rest => k (if has then a :: rest else rest)))
  end.

cmd_up (dir : string) (rest : list string) : nprog unit :=
  match up_args rest [] [] with
  | inr e => cli_fail e
  | inl (backends, pass) =>
  cli_ask IoSelfExe (fun self =>
  cli_ask (IoDirEntries dir) (fun entries =>
  with_keys dir (sort_strings (ans_list entries)) (fun agents =>
  if match agents with [] => true | _ => false end then cli_fail (cat [dir, " has no network: run `pantheon init ", dir, "` first"]) else
  cli_map agents (fun a k =>
    let home := path dir a in
    cli_exists (path home "genesis.json") (fun has =>
    if negb has then cli_fail (cat [dir, " has no network: run `pantheon init ", dir, "` first"]) else
    let b := match lookup a backends with Some b => b | None => "scripted" end in
    cli_ask (IoSpawnNode (path home "node.log") (["node", home, "--backend", b] ++ pass)) (fun pid => k (ans_one pid)))) (fun pids =>
  cli_say (cat ["running 4 nodes; logs in ", dir, "/<agent>/node.log; watch with: ", ans_one self, " status ", dir, "/claude"]) (fun _ =>
  cli_do (IoAwaitNodes pids) (fun _ => NDone tt))))))
  end.

(** ---- status, tx, plan ---- *)

cmd_status (home : string) : nprog unit :=
  cli_read_text (path home "status.txt")
    (cat ["no status in ", home, " yet: is its node running? Start it with `pantheon node ", home, "` or `pantheon up DIR`"])
    (fun t => cli_do (IoPrint t) (fun _ => NDone tt)).

(** the clock's microseconds as SECONDS.MICROSECONDS, an inbox file's name
    (the node reads them in name order) *)
stamp_text (us : string) : string :=
  let n := slen us in if n <? 7 then us else cat [substr us 0 (n - 6), ".", substr us (n - 6) 6].

cmd_tx (home : string) (fields : list string) : nprog unit :=
  let d := path home "inbox" in
  cli_do (IoMakeDirs d) (fun _ =>
  cli_ask IoClock (fun now =>
  let name := append (stamp_text (float_text (PrimFloat.mul (ans_float now) 1000000%float))) ".json" in
  cli_do (IoWriteFile (path d name) (nio_json_strings fields)) (fun _ =>
  cli_say (cat ["queued for ", basename home, "'s agent: ", join " " fields, " (it signs and sends it next; see `pantheon status ", home, "`)"])
    (fun _ => NDone tt)))).

lines_text (l : list string) : string := cat (List.map (fun x => append x newline) l).

cmd_plan (file : string) : nprog unit :=
  cli_read_text file (cat ["no ", file, " here: a repository's plan is .plan at its root (docs/PLAN.md)"]) (fun t =>
  cli_do (IoPrint (lines_text (plan_open t))) (fun _ => NDone tt)).

(** ---- edits, apply-edits, check ---- *)

Fixpoint edits_items (l : list (list string)) : list json :=
  match l with
  | [p, o, n] :: r => JObj [("path", JStr p), ("old", JStr o), ("new", JStr n)] :: edits_items r
  | _ :: r => edits_items r
  | [] => []
  end.

(** for a model with tools: what it changed in its checkout, as the reply a
    patch request wants *)
cmd_edits (dir : string) (rest : list string) : nprog unit :=
  cli_ask (IoCheckoutEdits dir) (fun a =>
  if negb (fst a) then cli_fail (ans_one a) else
  match nio_lists (ans_list a) with
  | skipped :: edits =>
      let note := append (join " " rest)
                    (match skipped with [] => "" | _ => cat [" (skipped, can't be edits: ", join ", " skipped, ")"] end) in
      cli_do (IoPrint (append (json_text (JObj [("edits", JList (edits_items edits)), ("note", JStr (trim note))])) newline))
        (fun _ => NDone tt)
  | [] => cli_fail "the checkout's edits came back malformed"
  end).

(** an edits file: a JSON list of strings, each edit's path, old and new *)
edits_file (file : string) (k : list string -> nprog unit) : nprog unit :=
  let refused := cat ["cannot read ", file, ": edits are a JSON list of strings (path, old, new for each edit)"] in
  cli_read_text file refused (fun t =>
  match json_of t with
  | Some (JList l) => match json_strings l with Some s => k s | None => cli_fail refused end
  | _ => cli_fail refused
  end).

cmd_apply_edits (dir file : string) : nprog unit :=
  edits_file file (fun edits =>
  cli_ask (IoApplyEdits dir edits) (fun a =>
  if fst a then cli_say "applied" (fun _ => NDone tt) else cli_fail (ans_one a))).

(** how `pantheon check` says the failure is the edits' (they don't apply):
    any other failing exit is this node's (node.soma reads them so) *)
check_bid_failed : string := "1".
check_node_failed : string := "3".

cmd_check (repo head file out : string) : nprog unit :=
  edits_file file (fun edits =>
  cli_ask (IoCheckTree repo head out edits) (fun a =>
  match fst a, ans_list a with
  | true, [tree] => cli_do (IoPrint tree) (fun _ => NDone tt)
  | false, ["bid", e] => cli_do (IoPrint e) (fun _ => cli_do (IoExit check_bid_failed) (fun _ => NDone tt))
  | _, ["node", e] => cli_do (IoPrint e) (fun _ => cli_do (IoExit check_node_failed) (fun _ => NDone tt))
  | _, _ => cli_do (IoPrint "node problem: the check came back malformed") (fun _ => cli_do (IoExit check_node_failed) (fun _ => NDone tt))
  end)).

(** ---- the commands ---- *)

usage : string := "pantheon: a private BFT labor market where LLM agents take turns as term leader.

  One machine:
  pantheon init DIR --repo NAME=GIT-CHECKOUT [--repo ...] [--base-port P] [--block-ms N] [--param name=value]...
  pantheon up DIR [--backends claude=claude,codex=codex,grok=grok,muse=scripted] [node flags]

  One machine per agent (see docs/NETWORK.md):
  pantheon keygen HOME --name NAME --addr HOST:PORT     then add HOME/public.json to NETWORK/parts/
  pantheon genesis HOME NETWORK                         once all 4 parts are in

  pantheon node HOME [--backend B] [--behavior honest|deny|silent] [--goal FILE] [--deny PATH] [--listen HOST]
                     [--ci CMD] [--ci-repo NAME CMD] [--ci-image IMAGE | --ci-sandbox PROGRAM] [--ci-memory 8g] [--bid-window N] [--perspective TEXT] [--max-llm-calls N]
  pantheon status HOME
  pantheon tx HOME post REPO ""spec"" [CONTEXT-PATH...]   (or any market transaction's fields)
  pantheon edits CHECKOUT [NOTE]     a checkout's changes as a patch reply (for models with tools)
  pantheon plan [FILE]              a .plan's open items (default ./.plan; see docs/PLAN.md)
  pantheon apply-edits DIR EDITS.json
  pantheon image HOME FILE [--service HOST:PORT] [node flags]   the node as a MirageOS unikernel's source (soma build FILE)
  pantheon service HOME HOST:PORT [node flags]   git, model calls and CI for HOME's unikernel, at HOST:PORT

Backends: scripted, claude, codex, grok (XAI_API_KEY), cmd:PROGRAM (prompt on stdin, JSON reply on stdout;
a patch request also gets a scratch checkout in $PANTHEON_WORKTREE: see scripts/bidder.sh).
".


(** ---- the node's setup (pantheon node) ----
    What [node_open] needed decided before it builds the node's runtime
    (its tables, sockets and jobs, still the shell's): the home as an
    absolute path, kept private; genesis.json, key.json and chain.json
    read and checked; the node's flags; the governed repositories checked
    out and checked against the genesis's trees; and which already carry
    a merge. [node_setup] gives it all to [node_open] as frames: the
    settings, this node's key, its excluded repositories, the repositories
    it can't check, the per-repository CI commands, the agents, the
    repositories, those still at genesis, then the boot events. *)

(** the node's flags: settings by name, the agent's events, CI commands
    by repository and repositories it can't check (both newest first, as
    the shell kept them) *)
Fixpoint node_flags (args : list string) (set : list (string * string)) (events : list (list string))
  (ci_repo : list (string * string)) (no_check : list string)
  : (list (string * string) * list (list string) * list (string * string) * list string) + string :=
  match args with
  | "--backend" :: b :: r => node_flags r (put "backend" b set) events ci_repo no_check
  | "--behavior" :: b :: r => node_flags r set (events ++ [["agent", "behavior", b]]) ci_repo no_check
  | "--goal" :: f :: r => node_flags r set (events ++ [["goal_file", f]]) ci_repo no_check
  | "--deny" :: p :: r => node_flags r set (events ++ [["agent", "deny", p]]) ci_repo no_check
  | "--bid-window" :: n :: r => node_flags r set (events ++ [["agent", "bid_window", n]]) ci_repo no_check
  | "--perspective" :: t :: r => node_flags r set (events ++ [["agent", "perspective", t]]) ci_repo no_check
  | "--ci" :: c :: r => node_flags r (put "ci" c set) events ci_repo no_check
  | "--ci-repo" :: n :: c :: r => node_flags r set events ((n, c) :: ci_repo) no_check
  (* a repository this node can't build (Soma's CI on a small host): its
     checks end as this node's problem, so the agent abstains on that
     repository's bids rather than say yes after only applying the edits *)
  | "--no-check" :: n :: r => node_flags r set events ci_repo (n :: no_check)
  | "--listen" :: h :: r => node_flags r (put "listen" h set) events ci_repo no_check
  | "--ci-memory" :: m :: r => node_flags r (put "ci_memory" m set) events ci_repo no_check
  | "--ci-image" :: i :: r => node_flags r (put "ci_image" i set) events ci_repo no_check
  (* CI without Docker: PROGRAM MEMORY CHECKOUT CMD runs CMD on a copy of
     the read-only CHECKOUT, with no network, within MEMORY
     (deploy/host/ci-sandbox) *)
  | "--ci-sandbox" :: p :: r => node_flags r (put "ci_sandbox" p set) events ci_repo no_check
  | "--max-llm-calls" :: n :: r =>
      match num_opt n with
      | Some k => node_flags r (put "max_calls" (show k) set) events ci_repo no_check
      | None => inr (append "--max-llm-calls wants a number, got " n)
      end
  | x :: _ => inr (append "unknown node flag " x)
  | [] => inl (set, events, ci_repo, no_check)
  end.

node_flag_defaults : list (string * string) :=
  [("backend", "scripted"), ("listen", "0.0.0.0"), ("ci", ""), ("ci_memory", "8g"), ("ci_image", "alpine:3.20"),
   ("ci_sandbox", ""), ("max_calls", "100")].

(** a --goal's file read in (nothing when it isn't there) *)
goal_event {R : Type} (ev : list string) (k : list string -> nprog R) : nprog R :=
  match ev with
  | ["goal_file", f] => cli_ask (IoReadText f) (fun a => k ["goal_text", match ans_found_one a with Some t => t | None => "" end])
  | _ => k ev
  end.

Fixpoint env_value (name : string) (entries : list string) : string :=
  match entries with
  | [] => ""
  | e :: r => if starts (append name "=") e then substr e (S (slen name)) (slen e) else env_value name r
  end.

(** a genesis agent as the node needs it: name, addr, and its key's size, n and e *)
genesis_agent (j : json) : option (list string) :=
  let pk := json_member "pubkey" j in
  match json_string (json_member "name" j), json_string (json_member "addr" j), json_member "size" pk with
  | Some n, Some a, JNum size =>
      Some [n, a, size, match json_string (json_member "n" pk) with Some x => x | None => "" end,
            match json_string (json_member "e" pk) with Some x => x | None => "" end]
  | _, _, _ => None
  end.

Fixpoint genesis_agents (l : list json) : option (list (list string)) :=
  match l with
  | [] => Some []
  | j :: r => match genesis_agent j, genesis_agents r with Some a, Some rest => Some (a :: rest) | _, _ => None end
  end.

(** the repositories a genesis part excludes (none when it says nothing) *)
part_excludes (me : string) (l : list json) : list string :=
  flat_map (fun a => if match json_string (json_member "name" a) with Some n => seq n me | None => false end then
                       match json_member "exclude" a with JList x => match json_strings x with Some s => s | None => [] end | _ => [] end
                     else []) l.

genesis_repo_fields (j : json) : option (list string) :=
  match json_string (json_member "name" j), json_string (json_member "url" j),
        json_string (json_member "commit" j), json_string (json_member "tree" j) with
  | Some n, Some u, Some c, Some t => Some [n, u, c, t]
  | _, _, _, _ => None
  end.

key_field (j : json) (k : string) : string := match json_string (json_member k j) with Some x => x | None => "" end.

(** each governed repository checked out at its genesis commit with the
    genesis's tree, and then either still at genesis or carrying a merge
    (its last commit's message, for Pantheon-Version) *)
node_repo (home : string) (r : list string) (k : (string * option string) -> nprog (option (list (list string))))
  : nprog (option (list (list string))) :=
  match r with
  | [n, url, commit, tree] =>
      ensure_repo home n (repo_url (path home "network") url) commit (fun dir =>
      cli_ask (IoGit dir ["rev-parse", append commit "^{tree}"]) (fun t =>
      if negb (seq (trim (ans_one t)) tree) then
        cli_fail (cat ["genesis says repository ", n, "'s commit ", commit, " has tree ", tree, "; this clone disagrees"])
      else
      cli_ask (IoGit dir ["rev-parse", "HEAD"]) (fun headc =>
      cli_ask (IoGit dir ["rev-parse", commit]) (fun genc =>
      if seq (trim (ans_one headc)) (trim (ans_one genc)) then k (n, None) else
      cli_ask (IoGit dir ["log", "-1", "--format=%B"]) (fun body => k (n, Some (ans_one body)))))))
  | _ => cli_fail "genesis.json: a repository has a name, url, commit and tree"
  end.

node_setup (home : string) (flags : list string) : nprog (option (list (list string))) :=
  (* jobs run from scratch directories: every path the node hands out is absolute *)
  cli_ask IoCwd (fun cwd =>
  let home := if is_relative home then path (ans_one cwd) home else home in
  (* the home holds this agent's keys: nobody else reads it, models included *)
  cli_do (IoChmod home "700") (fun _ =>
  let gp := path home "genesis.json" in
  let refused p := cat ["cannot read ", p, ": is this a home made by `pantheon init`?"] in
  cli_read_text gp (refused gp) (fun gtext =>
  match json_of gtext with None => cli_fail (refused gp) | Some gen =>
  cli_read_json (path home "key.json") (fun keyf =>
  match json_string (json_member "agent" keyf), json_member "key" keyf with
  | Some me, JObj _ =>
  let kj := json_member "key" keyf in
  cli_read_json (path home "chain.json") (fun chain =>
  match json_string (json_member "secret" chain), json_string (json_member "chain_id" gen), json_member "agents" gen with
  | Some secret, Some chain_id, JList agents_j =>
  match genesis_agents agents_j with None => cli_fail "genesis.json: each agent has a name, an addr and a pubkey with its size" | Some agents =>
  if negb (List.existsb (fun a => match a with n :: _ => seq n me | [] => false end) agents) then
    cli_fail (cat [me, " isn't one of genesis.json's agents: is this home's key.json from another network?"]) else
  cli_ask IoEnvEntries (fun env =>
  let byz := env_value "PANTHEON_BYZ" (ans_list env) in
  let faulty k := if seq byz "" then k tt else cli_say (cat ["FAULT INJECTION: this node misbehaves on purpose (", byz, ")"]) k in
  faulty (fun _ =>
  match node_flags flags node_flag_defaults [] [] [] with
  | inr e => cli_fail e
  | inl (set, events, ci_repo, no_check) =>
  let setting k := get_or "" k set in
  (* Soma reads the raw --backend string (backend_kind_name, backend_behavior_event) *)
  cli_map events goal_event (fun events =>
  let events := events ++ [["backend_behavior_of", setting "backend"]] in
  let repos := match json_member "repos" gen with JList l => l | _ => [] end in
  match fold_right (fun r acc => match genesis_repo_fields r, acc with Some f, Some rest => Some (f :: rest) | _, _ => None end)
                   (Some []) repos with
  | None => cli_fail "genesis.json: a repository has a name, url, commit and tree"
  | Some repos =>
  cli_map repos (node_repo home) (fun states =>
  NDone (Some (
    [[home, me, secret, chain_id, byz, setting "backend", setting "listen", setting "ci", setting "ci_memory",
      setting "ci_image", setting "ci_sandbox", setting "max_calls"],
     [match json_member "size" kj with JNum s => s | _ => "0" end, key_field kj "n", key_field kj "e", key_field kj "d",
      key_field kj "p", key_field kj "q", key_field kj "dp", key_field kj "dq", key_field kj "qinv"],
     part_excludes me agents_j,
     no_check,
     flat_map (fun p => [fst p, snd p]) ci_repo,
     List.concat agents,
     flat_map (fun r => match r with n :: _ :: c :: _ => [n, c] | _ => [] end) repos,
     flat_map (fun s => match s with (n, None) => [n] | _ => [] end) states]
    (* the boot events: genesis (node.soma's genesis_events reads the
       roster, tips, block_ms, params, repositories and excludes from its
       text), the chain's id and each agent's key (what a transaction's
       signature is checked with: its size in bytes, n and e as hex), this
       node, the backend, the flags' events, then the merges the checkouts
       already carry *)
    ++ [["genesis", gtext], ["chain", chain_id]]
    ++ flat_map (fun a => match a with
                          | [n, _, size, kn, ke] => [["key", n, show (num size / 8), kn, ke]]
                          | _ => [] end) agents
    ++ [["me", me], ["backend_kind_of", setting "backend"]] ++ events
    ++ flat_map (fun s => match s with (n, Some body) => [["applied_body", n, body]] | _ => [] end) states)))
  end)
  end))
  end
  | _, _, _ => cli_fail (refused (path home "chain.json"))
  end)
  | _, _ => cli_fail (refused (path home "key.json"))
  end)
  end))).

(** ---- pantheon image ----
    A node as a MirageOS unikernel: [node_setup] run here, on the home's
    files, and what it decided written into FILE as a Soma program that
    boots it (node_sandbox.soma's [run_node_image]). FILE goes in a
    Pantheon checkout, so its imports resolve; [soma build FILE] makes the
    image, which keeps blocks.log, signed.log and consensus.state on its
    storage device. *)
soma_quote (s : string) : string :=
  let q := Ascii.ascii_of_nat 34 in
  of_chars (q :: rev_onto (fold_left (fun acc c => if Ascii.eqb c q then q :: q :: acc else c :: acc) (chars s) []) [q]).

soma_strings (l : list string) : string :=
  cat ["[", Stdlib.Strings.String.concat ", " (map soma_quote l), "]"].

image_text (home service : string) (config : list (list string)) : string :=
  cat ["(** A Pantheon node as a MirageOS unikernel: ", home, "'s setup, made by
    `pantheon image`. Build it with soma build; boot it with solo5-hvt and
    its storage device (--block:storage=DISK). *)
Require Import Sandbox.
Import node_sandbox.

(* the stores' maps compare keys as OCaml compares strings, as the binary does *)
Extract Inlined Constant Stdlib.Strings.String.compare =>
  ""(fun a b -> let c = Stdlib.compare (a : string) b in if c < 0 then Lt else if c = 0 then Eq else Gt)"".

node_config : list (list string) := [
  ", Stdlib.Strings.String.concat ",
  " (map soma_strings config), "].

main : io unit := run_node_image_at node_config ", soma_quote service, ".
"].

(** [--service HOST:PORT] taken out of the flags: where the image asks for
    git, model calls and CI (node_sandbox.soma's service), "" for none *)
Fixpoint image_service (flags : list string) : string * list string :=
  match flags with
  | "--service" :: a :: rest => (a, snd (image_service rest))
  | f :: rest => let (a, others) := image_service rest in (a, f :: others)
  | [] => ("", [])
  end.

cmd_image (home file : string) (flags : list string) : nprog unit :=
  let (service, flags) := image_service flags in
  nbind (node_setup home flags) (fun config =>
  match config with
  | None => NDone tt
  | Some c =>
      cli_ask (IoWriteFile file (image_text home service c)) (fun a =>
      if fst a then cli_say (cat ["wrote ", file, ": soma build it to make the node's image"]) (fun _ => NDone tt)
      else cli_fail (cat ["cannot write ", file]))
  end).

(** every command but [node], as one program *)
cli_prog (args : list string) : nprog unit :=
  match args with
  | "init" :: rest => cmd_init rest
  | "keygen" :: rest => cmd_keygen rest
  | ["genesis", home, net] => cmd_genesis home net
  | "edits" :: dir :: rest => cmd_edits dir rest
  | ["plan"] => cmd_plan ".plan"
  | ["plan", file] => cmd_plan file
  | ["apply-edits", dir, file] => cmd_apply_edits dir file
  | ["check", repo, head, file, out] => cmd_check repo head file out
  | ["status", home] => cmd_status home
  | "tx" :: home :: field :: rest => cmd_tx home (field :: rest)
  | "up" :: dir :: rest => cmd_up dir rest
  | "image" :: home :: file :: flags => cmd_image home file flags
  | _ => cli_do (IoPrint usage) (fun _ => NDone tt)
  end.
