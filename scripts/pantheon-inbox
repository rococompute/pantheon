#!/bin/sh
# An interactive agent's side of a Pantheon node. The node's backend
# (scripts/bidder-inbox.sh) puts each request it has for the model in the
# inbox and waits; the agent takes them one at a time and answers:
#
#   pantheon-inbox wait [SECONDS]      the next request (waits up to SECONDS, default 300)
#   pantheon-inbox reply ID < FILE     answer a request with the JSON object its prompt asks for
#   pantheon-inbox done ID NOTE...     a patch request: the checkout is edited; NOTE says what changed
#   pantheon-inbox skip ID WHY...      a patch request you won't bid on (it can't be done in time, say)
#   pantheon-inbox list                what's in the inbox
#
# For a patch you hand to a worker elsewhere (your provider's cloud machines):
#   pantheon-inbox base ID             the branch a worker should start from, and whether it has your checkout's commit
#   pantheon-inbox pull ID BRANCH      the worker's own change on BRANCH (since it left the shared branch), applied to the request's checkout
#   pantheon-inbox apply ID [FILE]     a diff (FILE, or stdin) applied to the request's checkout
#   pantheon-inbox check ID            your node's CI on the request's checkout, in the host's sandbox (one at a time)
#   pantheon-inbox limited WHAT...     your provider says you've hit your usage limit: WHAT it said (with when it resets,
#                                      if it said); your node holds its requests until then, and asks again
#
# PANTHEON_INBOX is the inbox (default /var/lib/pantheon-inbox). PANTHEON_REMOTE
# is the git remote workers share (a GitHub URL), PANTHEON_BRANCH the branch
# there the market publishes to (default: the remote's default branch), and
# PANTHEON_CHECK the command that checks a checkout (scripts/host.sh check).
set -eu
INBOX=${PANTHEON_INBOX:-/var/lib/pantheon-inbox}
now() { date +%s; }
case ${1:-} in ''|-h|--help|help) ;; *)
  [ -d "$INBOX" ] || { echo "pantheon-inbox: no inbox at $INBOX: set PANTHEON_INBOX to your inbox (some agent CLIs drop it from the environment their commands get: use the wrapper your instructions name)" >&2; exit 1; } ;;
esac
die() { echo "pantheon-inbox: $*" >&2; exit 1; }
# bids carry regular files only: a symlink would make the node read whatever it
# points at (its keys) into the bid, and a submodule isn't a file at all
no_links() { ! grep -Eq '^(new file mode|new mode|index [0-9a-f]+\.\.[0-9a-f]+) (120000|160000)$' "$1" \
  || die "$2 makes a symlink or a submodule (mode 120000 or 160000): bids carry regular files only. Have the worker commit the file itself"; }
req() {
  printf '%s' "$1" | grep -Eqx '[0-9]+-[0-9a-f]+' || die "no request $1: ids look like 1794091815-1a2b3c4d (pantheon-inbox list)"
  r=$INBOX/$1
  [ -f "$r/prompt.txt" ] || die "no request $1 in $INBOX: it was answered, or it expired and the node moved on"
  [ ! -e "$r/expired" ] || die "request $1 expired: the node moved on without it. Take the next one: pantheon-inbox wait"
}
# open: not expired, and not past its deadline (a request left by a node that
# stopped never gets its expired mark)
open_requests() { t=$(now); ls -1 "$INBOX" 2>/dev/null | sort | while read -r d; do [ -f "$INBOX/$d/prompt.txt" ] && [ ! -e "$INBOX/$d/expired" ] && [ "$(cat "$INBOX/$d/deadline" 2>/dev/null || echo 0)" -gt "$t" ] && echo "$d"; done; true; }

case ${1:-} in
  wait)
    limit=${2:-300}; end=$(( $(now) + limit ))
    while :; do
      for d in $(open_requests); do
        r=$INBOX/$d
        [ -e "$r/claimed" ] && continue
        : > "$r/claimed"
        kind=$(cat "$r/kind"); left=$(( $(cat "$r/deadline") - $(now) ))
        echo "request $d: $kind, ${left}s left to answer"
        if [ "$kind" = patch ]; then
          echo "checkout: $(cat "$r/worktree")"
          echo "edit the files there (soma build, tests), then: pantheon-inbox done $d \"one line on what you changed\""
        else
          echo "answer with the JSON object the prompt asks for: pantheon-inbox reply $d < FILE   (or: echo '{...}' | pantheon-inbox reply $d)"
        fi
        size=$(wc -c < "$r/prompt.txt" | tr -d ' ')
        if [ "$size" -le 24000 ]; then echo "prompt:"; cat "$r/prompt.txt"
        else echo "prompt: $r/prompt.txt ($size bytes): read it whole"
        fi
        exit 0
      done
      [ "$(now)" -lt "$end" ] || { echo "no request in ${limit}s. Run pantheon-inbox wait again."; exit 0; }
      sleep 2
    done ;;
  reply)
    [ $# -eq 2 ] || die "usage: pantheon-inbox reply ID < FILE"
    req "$2"
    cat > "$r/.reply"
    [ -s "$r/.reply" ] || die "the reply was empty: pipe in the JSON object"
    mv "$r/.reply" "$r/reply.txt"
    echo "answered $2. Next: pantheon-inbox wait" ;;
  done)
    [ $# -ge 3 ] || die "usage: pantheon-inbox done ID NOTE..."
    id=$2; shift 2; req "$id"
    [ "$(cat "$r/kind")" = patch ] || die "$id is not a patch request: answer it with pantheon-inbox reply $id"
    printf '%s\n' "$*" > "$r/.done" && mv "$r/.done" "$r/done"
    echo "handed in $id: the node turns the checkout's changes into the bid. Next: pantheon-inbox wait" ;;
  skip)
    [ $# -ge 3 ] || die "usage: pantheon-inbox skip ID WHY..."
    id=$2; shift 2; req "$id"
    [ "$(cat "$r/kind")" = patch ] || die "$id is not a patch request: answer it with pantheon-inbox reply $id"
    why=$(printf '%s' "$*" | head -c 300 | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' ')
    printf '{"edits": [], "note": "skipped: %s"}\n' "$why" > "$r/.reply" && mv "$r/.reply" "$r/reply.txt"
    echo "skipped $id: your node bids nothing for it. Next: pantheon-inbox wait" ;;
  limited)
    [ $# -ge 2 ] || die "usage: pantheon-inbox limited WHAT YOUR PROVIDER SAID"
    shift; printf '%s\n' "$*" > "$INBOX/.limited" && mv "$INBOX/.limited" "$INBOX/limited"
    echo "told your node: it holds its requests until the limit should have reset, then asks again. Stop until then; when a request comes, the limit is over." ;;
  base|pull|apply|check)
    c=$1; [ $# -ge 2 ] || die "usage: pantheon-inbox $c ID ..."
    id=$2; req "$id"
    [ "$(cat "$r/kind")" = patch ] || die "$id is not a patch request"
    wt=$(cat "$r/worktree"); head=$(git -C "$wt" rev-parse HEAD)
    remote=${PANTHEON_REMOTE:-}; branch=${PANTHEON_BRANCH:-}
    if [ -z "$branch" ] && [ -n "$remote" ]; then
      branch=$(git ls-remote --symref "$remote" HEAD 2>/dev/null | sed -n 's|^ref: refs/heads/\(.*\)	HEAD$|\1|p')
    fi
    branch=${branch:-master}
    # the shared branch's commit, fetched into the checkout's repository
    shared() {
      out=$(git -C "$wt" fetch --quiet "$remote" "refs/heads/$branch" 2>&1) || die "can't fetch $branch from $remote: $out"
      git -C "$wt" rev-parse FETCH_HEAD
    }
    case $c in
      base)
        [ -n "$remote" ] || die "no PANTHEON_REMOTE: there's no remote workers share. Do the patch here, or skip it"
        at=$(git ls-remote "$remote" "refs/heads/$branch" 2>&1 | cut -f1) || die "can't reach $remote: $at"
        echo "your checkout: $head"
        echo "workers start from: $remote, branch $branch, at ${at:-nothing}"
        if [ -z "$at" ]; then echo "$branch isn't on the remote: workers can't start from the market's head"
        elif [ "$at" = "$head" ]; then echo "same commit: a worker's change on top of $branch applies to your checkout as is"
        else
          at=$(shared)
          if git -C "$wt" merge-base --is-ancestor "$head" "$at"; then
            echo "$branch has your checkout's commit, and work from outside the market on top: pull takes only the worker's own change, so start workers from $branch"
          elif git -C "$wt" merge-base --is-ancestor "$at" "$head"; then
            echo "$branch is behind your checkout: the mirror publishes the market's head every 30s, so wait a minute and look again; pull still applies a change made on an older commit if it doesn't conflict"
          else
            echo "$branch doesn't have your checkout's commit (a conflict the mirror couldn't merge?): pull applies a worker's change if it doesn't conflict; or do the patch here"
          fi
        fi ;;
      pull)
        [ $# -eq 3 ] || die "usage: pantheon-inbox pull ID BRANCH"
        [ -n "$remote" ] || die "no PANTHEON_REMOTE to pull from"
        base=$(shared)
        out=$(git -C "$wt" fetch --quiet "$remote" "refs/heads/$3" 2>&1) || die "can't fetch $3 from $remote: $out"
        tip=$(git -C "$wt" rev-parse FETCH_HEAD)
        # where the worker left the shared branch: its change is what came after
        mb=$(git -C "$wt" merge-base "$tip" "$base" 2>/dev/null) || die "$3 doesn't share history with $branch: it wasn't started from $branch"
        git -C "$wt" diff --binary "$mb" "$tip" > "$r/pulled.diff"
        [ -s "$r/pulled.diff" ] || die "$3 has no change on top of $branch ($(git -C "$wt" rev-parse --short "$mb"))"
        no_links "$r/pulled.diff" "$3's change"
        out=$(git -C "$wt" apply --3way "$r/pulled.diff" 2>&1) || die "$3's change doesn't apply to your checkout: $out"
        git -C "$wt" reset -q; git -C "$wt" status --short | head -40
        echo "applied $3's change (since $(git -C "$wt" rev-parse --short "$mb")). Check it (pantheon-inbox check $id), then: pantheon-inbox done $id \"note\"" ;;
      apply)
        f=${3:--}; [ "$f" = - ] && { cat > "$r/applied.diff"; f=$r/applied.diff; }
        [ -s "$f" ] || die "the diff is empty"
        no_links "$f" "the diff"
        out=$(git -C "$wt" apply --3way "$f" 2>&1) || die "the diff doesn't apply to your checkout ($head): $out"
        git -C "$wt" reset -q; git -C "$wt" status --short | head -40
        echo "applied. Check it (pantheon-inbox check $id), then: pantheon-inbox done $id \"note\"" ;;
      check)
        [ -n "${PANTHEON_CHECK:-}" ] || die "no PANTHEON_CHECK: there's no check on this machine; your node's CI checks the bid"
        echo "checking $wt (it waits its turn if another check is running)"
        $PANTHEON_CHECK "$wt"; s=$?
        [ $s -eq 0 ] && echo "check passed" || echo "check failed ($s)$([ $s = 137 ] && echo ': over its memory budget')"
        exit $s ;;
    esac ;;
  list)
    for d in $(open_requests); do
      printf '%s %s %ss left%s\n' "$d" "$(cat "$INBOX/$d/kind")" $(( $(cat "$INBOX/$d/deadline") - $(now) )) "$([ -e "$INBOX/$d/claimed" ] && echo ', taken')"
    done ;;
  *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; [ -z "${1:-}" ] || exit 1 ;;
esac
