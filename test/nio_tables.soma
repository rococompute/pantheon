(** nodeio.soma's pure part, which any interpreter shares: the lines blocks.log and signed.log get (Yojson's bytes, as the old shell's writers made them), the clock's decimal text read back, and what the table operations do. No node, no unikernel. *)
Import util nodeio.
Require Soma.Host.
From Soma Require Import OCaml.

check (label : string) (ok : bool) : string := append (if ok then "ok " else "FAIL ") label.

float_eq (a b : float) : bool := negb (PrimFloat.ltb a b) && negb (PrimFloat.ltb b a).

(** equal within rounding: a billionth *)
near (a b : float) : bool := PrimFloat.ltb (PrimFloat.abs (PrimFloat.sub a b)) 0.000000001%float.

dec (s : string) : option float := nio_decimal s.

served (t : nio_tables) (who first : string) : nanswer :=
  match nio_table_op 0%float t (IoServedAt who first) with Some (a, _) => a | None => (false,(9%float,[])) end.

after (now : float) (t : nio_tables) (ops : list node_op) : nio_tables :=
  fold_left (fun t op => match nio_table_op now t op with Some (_, t') => t' | None => t end) ops t.

stores (t : nio_tables) (ops : list node_op) : nio_tables :=
  fold_left (fun t op => match nio_store_op 0%float t op with Some (_, t') => t' | None => t end) ops t.

stored (t : nio_tables) (op : node_op) : nanswer :=
  match nio_store_op 0%float t op with Some (a, _) => a | None => (false,(9%float,["not the stores'"])) end.

t2 : nio_tables :=
  stores nio_empty [IoStore "1" ["a"], IoStore "2" ["b", "c"], IoStore "1" ["a2"],
                    IoSignVote "prevote/3/0" "v1" ["prevote", "3"], IoSignVote "prevote/3/0" "v2" ["prevote", "3", "x"],
                    IoSetHeight "3"].

t1 : nio_tables :=
  after 100%float nio_empty
    [IoTimer "350" ["timeout", "commit", "2", "0"], IoQueue ["a"], IoQueue ["b"],
     IoRememberBroadcast "3" "all" ["prevote", "3"] ["prevote", "3"],
     IoRememberBroadcast "5" "all" ["prevote", "5"] ["prevote", "5"],
     IoSetHeight "4", IoMarkServed "codex" "7" "1794505802.25", IoMarkServed "codex" "7" "12.5",
     IoMergeApplied "calc" "1", IoMergeApplied "calc" "2", IoMergeDiverged "soma" "3 bad", IoTrackTx "raw"].

(** A 2048-bit key of Cryptokit's (fresh for this test; its public
    exponent is random, as [RSA.new_key] makes them), and a transaction
    and a peer line that the old shell's encode_tx and wire signed with it
    (chain pantheon-0123456789abcdef, claude, nonce 7; a field with a
    quote, a newline, a tab, a check mark and a control character), as
    hex: Soma's RSA signs the same bytes. *)
nl : string := Stdlib.Strings.String.String (Ascii.ascii_of_nat 10) "".
unhex (s : string) : list PrimInt63.int := match Crypto.bytes_of_hex s with Some l => l | None => [] end.
test_key : nio_key :=
  {| nk_bytes := 256;
     nk_n := unhex "";
     nk_e := unhex "";
     nk_p := unhex "ecf9a7de0233a388e4d69926229b55ede6dc7a72e02d2770336d4815c13ac8dc5a0278ded173ca3e5b5106e8c77435985e9f5b8f5ee8cb86d38ffade1a0895c665a8851e565f1fb8fd2f7938e9093f750ee88940bef793fb684e66989268878aabf109a643781bc087f7cb49836981caa6bf70bc5d459894de94aa9f8d7a8bbb";
     nk_q := unhex "9b4d639ab0188ed6a5ce0085160bafccfe9781d6936072261875e2ceafbe9b201c31c2d95baeb81c17339145e3636a0c61349674477586a1bf719a42ebfb0d578f1e74f7cfa8ce11d762bb4dd0f2ca112e16b6177fb8b5d094f982fc7023bf65466e288967f374f590ad429f19c7223de238b879c1f2de74f6e76106c410f461";
     nk_dp := unhex "b18b89f52e0c48cee62aa9806549196b35fd6900df5190f2804d2dc1449fb605b4ca10747da976357fa13e7553840359fb96c6648374ac78306111f0f020fbdcb9b4cbd8e0c2e949a8416b1efc1d7c0a5a8fb334c8d261544370d03ddcba93dd1c9cc6b442252ba99cb145c40bbbced596858178e74ec7215821496bc87d00b9";
     nk_dq := unhex "0ae4c5ae514900a157384cb9073bee87353ca85f357177b25ccb53f712facf9a73f8960d605b9c0ec58453336ea6c61bc5010630e45d5cd6e6a8a8b649d9d2316ebd45cb70e4cbd125839026455429746d7a5494c58f6240421e372214df964b6b586f7cd232989ec2bedff7fc1d6ae474985101b11d0ad5749e7e7e7edc3451";
     nk_qinv := unhex "c66b03312335d327f91ccbece6222d668d2f18464aed2f4910ce09fd7e90f3c41211bd1b19c251e416c2ccbc1d515f0a0fca2f4e48d48e8b5cbb3a1aadf95cf53ddad767a498c813e40d07645dc548454c60a7619c2ff6af1c575c6cf9aeacb1bbae2d2264101e99b6655f98a2a389392c8c1969a2b55779bfb7d34fcb349e1c" |}.
shell_tx : string := Crypto.string_of_bytes (unhex "").
shell_wire : string := Crypto.string_of_bytes (unhex "").
test_chain : string := "pantheon-0123456789abcdef".
test_key_wire : list string :=
  [test_chain, "256", Crypto.hex_of_bytes (nk_n test_key), Crypto.hex_of_bytes (nk_e test_key)].
test_fields : list string :=
  ["post", "repo", Stdlib.Strings.String.concat "" ["a ""quoted"" spec", nl, "with",
     Stdlib.Strings.String.String (Ascii.ascii_of_nat 9) "", "tabs ",
     Crypto.string_of_bytes (unhex "e29c93"), " and ", Stdlib.Strings.String.String (Ascii.ascii_of_nat 1) ""]].

checks : list string := [
  check "a block's line is Yojson's" (seq (nio_block_line "1" ["tx ""a""", "tx2"]) "{""h"":1,""txs"":[""tx \""a\"""",""tx2""]}"),
  check "control characters and DEL as Yojson escapes them"
    (seq (nio_json_strings ["a\b", append "tab" (SCons (Ascii.ascii_of_nat 9) "here"), append "nl" (SCons (Ascii.ascii_of_nat 10) "x"),
                            SCons (Ascii.ascii_of_nat 1) (SCons (Ascii.ascii_of_nat 31) (SCons (Ascii.ascii_of_nat 127) "")),
                            SCons (Ascii.ascii_of_nat 8) (SCons (Ascii.ascii_of_nat 12) (SCons (Ascii.ascii_of_nat 13) "")),
                            SCons (Ascii.ascii_of_nat 195) (SCons (Ascii.ascii_of_nat 169) "")])
         (append "[""a\\b"",""tab\there"",""nl\nx"",""\u0001\u001f\u007f"",""\b\f\r"","""
          (SCons (Ascii.ascii_of_nat 195) (SCons (Ascii.ascii_of_nat 169) """]")))),
  check "a vote's line is the slot, the value and the fields" (seq (nio_vote_line "prevote/1/0" "v" ["prevote", "1"]) "prevote/1/0 v [""prevote"",""1""]"),
  check "no fields is an empty list" (seq (nio_json_strings []) "[]"),
  check "the clock's text reads back" (match dec "1794505802.25" with Some f => float_eq f 1794505802.25%float | None => false end),
  check "an exponent" (match dec "1.5e-3" with Some f => near f 0.0015%float | None => false end),
  check "a negative whole number" (match dec "-42" with Some f => float_eq f (-42)%float | None => false end),
  check "not a number" (match dec "12x", dec "", dec ".5" with None, None, None => true | _, _, _ => false end),
  check "a timer is due its milliseconds after now"
    (match t_timers t1 with [(due, ev)] => near due 100.35%float && (match ev with ["timeout", "commit", "2", "0"] => true | _ => false end) | _ => false end),
  check "events queue in order" (match t_queue t1 with [["a"], ["b"]] => true | _ => false end),
  check "the height drops resend memory below it" (seq (t_height t1) "4" && (match t_mine t1 with [(h, _)] => seq h "5" | _ => false end)),
  check "the served table keeps the newest time a key" (match served t1 "codex" "7" with (true, (f, _)) => float_eq f 12.5%float | _ => false end),
  check "a key never served is absent" (match served t1 "grok" "7" with (false, _) => true | _ => false end),
  check "one applied version a repository" (match t_applied t1 with [("calc", "2")] => true | _ => false end),
  check "a diverged repository reads back" (match nio_table_op 0%float t1 (IoIsDiverged "soma"), nio_table_op 0%float t1 (IoIsDiverged "calc") with
     | Some ((true, _), _), Some ((false, _), _) => true | _, _ => false end),
  check "the node's own transactions are stamped" (match t_txs t1 with [(stamp, "raw")] => float_eq stamp 100%float | _ => false end),
  check "the flood mark reads back" (match nio_table_op 0%float (after 0%float nio_empty [IoMarkNonceFlood]) IoNonceFlooded with Some ((true, _), _) => true | _ => false end),
  check "logging, the clock, storage and links aren't the tables'"
    (match nio_table_op 0%float nio_empty (IoLog "x"), nio_table_op 0%float nio_empty IoClock,
           nio_table_op 0%float nio_empty (IoStore "1" []), nio_table_op 0%float nio_empty (IoSendAll []) with
     | None, None, None, None => true | _, _, _, _ => false end),
  check "a stored block reads back, one a height"
    (match stored t2 (IoBlock "1"), stored t2 (IoBlock "2"), stored t2 (IoBlock "9") with
     | (true, (_, ["a2"])), (true, (_, ["b", "c"])), (false, (_, [])) => true | _, _, _ => false end),
  check "the signed vote a slot, and its body"
    (match stored t2 (IoSignedVote "prevote/3/0"), stored t2 (IoSignedBody "prevote/3/0"), stored t2 (IoSignedVote "prevote/4/0") with
     | (true, (_, ["v2"])), (true, (_, ["prevote", "3", "x"])), (false, (_, [])) => true | _, _, _ => false end),
  check "every message signed at a height, and none of another"
    (match nio_lists (ans_list (stored (stores nio_empty [IoSignVote "prevote/3/0" "v" ["prevote", "3"],
             IoSignVote "precommit/3/1" "v" ["precommit", "3"], IoSignVote "prevote/30/0" "w" ["prevote", "30"]]) (IoSignedAt "3"))),
           nio_lists (ans_list (stored nio_empty (IoSignedAt "3"))) with
     | [["prevote", "3"], ["precommit", "3"]], [] => true | _, _ => false end),
  check "the height reads back" (match stored t2 IoHeight with (true, (_, ["3"])) => true | _ => false end),
  check "the diverged repositories, as pairs"
    (match nio_table_op 0%float t1 IoDivergences with Some (a, _) => (match ans_pairs a with [("soma", "3 bad")] => true | _ => false end) | None => false end),
  check "pairs on the wire read back" (match nio_pairs (nio_flat_pairs [("a", "1"), ("b", "2")]) with [("a", "1"), ("b", "2")] => true | _ => false end),
  check "a refused transaction is seen again"
    (match stored (stores nio_empty [IoRefuse "raw1"]) (IoSeenRefused "raw1"), stored nio_empty (IoSeenRefused "raw1") with
     | (true, _), (false, _) => true | _, _ => false end),
  check "a select drains the queue, framed"
    (match nio_store_op 0%float (stores nio_empty [IoQueue ["a", "1"], IoQueue ["b"]]) (IoEvents "0.2") with
     | Some (a, t) => (match nio_lists (ans_list a), t_queue t with [["a", "1"], ["b"]], [] => true | _, _ => false end)
     | None => false end),
  check "the queue is empty, then not"
    (match stored nio_empty IoQueueEmpty, stored (stores nio_empty [IoQueue ["a"]]) IoQueueEmpty with
     | (true, _), (false, _) => true | _, _ => false end),
  check "stored timers replace the list"
    (match t_timers (stores (stores nio_empty [IoTimer "5" ["x"]]) [IoSetTimers [["1.5", "t", "1"]]]) with
     | [(d, ["t", "1"])] => near d 1.5%float | _ => false end),
  check "a replayed block is remembered for catch-up and counted"
    (match stored (stores nio_empty [IoRememberBlock "1" ["a"], IoRememberBlock "2" ["b"]]) (IoBlock "1"),
           stored (stores nio_empty [IoRememberBlock "1" ["a"], IoRememberBlock "2" ["b"]]) IoReplayCount with
     | (true, (_, ["a"])), (true, (_, ["2"])) => true | _, _ => false end),
  check "a vote read back from signed.log is the slot's"
    (match stored (stores nio_empty [IoSignedRestore "prevote/1/0" "v" ["prevote", "1"]]) (IoSignedVote "prevote/1/0") with
     | (true, (_, ["v"])) => true | _ => false end),
  check "the stores hand the tables' operations on" (match stored t2 IoNonceFlooded with (false, (_, [])) => true | _ => false end),
  check "Soma's sha256 is SHA-256"
    (seq (sha256 "abc") "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"),
  check "hash_list frames each string by its length, as the binary's"
    (seq (hash_list ["ab", "c"]) "430fb1b4ac43316eca81fab27a1930ab8eff8fef6a1dc7903dce44bbc2790dc5" && seq (hash_list []) "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"),
  check "a transaction signed by Soma's RSA is the line the binary's encode_tx signed"
    (Stdlib.Strings.String.eqb (nio_encode_tx test_chain "claude" test_key "7" test_fields) shell_tx),
  check "a peer line signed by Soma's RSA is the binary's wire line"
    (Stdlib.Strings.String.eqb (append (nio_wire_line test_chain "claude" test_key test_fields) nl) shell_wire),
  check "the binary's peer line verifies with the sender's key, as IoPeerKey gives it"
    (nio_line_verify test_key_wire "claude" (substr shell_wire (Nat.sub (slen shell_wire) 515) 512) test_fields),
  check "a peer line verifies only for its own fields, and not without a key"
    (negb (nio_line_verify test_key_wire "claude"
       (substr shell_wire (Nat.sub (slen shell_wire) 515) 512) ["post", "repo", "other"])
     && negb (nio_line_verify [] "claude" (substr shell_wire (Nat.sub (slen shell_wire) 515) 512) test_fields)
     && negb (nio_line_verify ["x", "2s6", "00", "03"] "claude" (substr shell_wire (Nat.sub (slen shell_wire) 515) 512) test_fields)),
  check "the binary's transaction verifies with its agent's key, as tx_key gives it"
    (nio_tx_verify test_key_wire "claude" "7" test_fields (substr shell_tx (Nat.sub (slen shell_tx) 514) 512)
     && negb (nio_tx_verify test_key_wire "claude" "8" test_fields (substr shell_tx (Nat.sub (slen shell_tx) 514) 512)))
].

main := Host.print_lines checks.
