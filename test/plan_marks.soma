(** The leader's mark on a long plan line, deterministically.

    The leader's prompt shows each open .plan item cut at 400 characters,
    and most items are longer. A mark names the line by its start, as the
    prompt shows it: the "..." comes off (plan_line_start), and the mark's
    edit replaces the line's start together with the newline before it
    (core/market.soma mark_edit), so it marks the whole line, only where a line
    begins with it, and only if one line does. A task that closes with its
    line still open is logged once, with why: a later leader, or a new
    genesis, would draft it again. A task whose mark merged is closed by
    whoever leads. Run with test/plan-marks.sh. *)
Import core.util core.market core.agent.
Require Soma.Host.

say (cond : bool) (what : string) : list string :=
  [if cond then append "ok " what else append "FAIL " what].

has (s sub : string) : bool := contains sub s.

(** an item of 5 + 60 * 10 = 605 characters, like most of Pantheon's *)
long : string := append "M-2: " (Stdlib.Strings.String.concat "" (repeat "the market" 60)).

plan_text : string :=
  append "# a plan" (append newline (append "2026-11-11" (append newline
    (append long (append newline (append "M-20: another item" newline)))))).

shown : string := plan_line_start (truncate_line long).

mark_on (text line : string) : option string :=
  edit_once text (eold (mark_edit line)) (enew (mark_edit line)).

lines_edit : list string :=
  let marked := match mark_on plan_text shown with Some t => t | None => "" end in
  say (400 <? slen long) "the item is longer than the prompt shows"
  ++ say (negb (ends "..." shown) && (slen shown =? 400) && starts shown long) "its shown line, without the ..., is the line's first 400 characters"
  ++ say (seq (plan_line_start (append (take_str 30 long) ellipsis)) (take_str 30 long)) "a line cut with … comes off the same way"
  ++ say (seq (plan_line_start "  M-20: another item ") "M-20: another item") "a whole line is kept, trimmed"
  ++ say (has marked (append newline (append "+ " long))) "a mark by the line's start marks the whole line"
  ++ say (negb (existsb (fun l => starts "M-2: " l) (plan_open marked))) "the marked line isn't open any more"
  ++ say (existsb (fun l => seq l "M-20: another item") (plan_open marked)) "the other item is still open"
  ++ say (match mark_on (append "#" (append newline (append "abc one" (append newline (append "zz abc two" newline))))) "abc" with
          | Some t => has t (append newline "+ abc one") && has t "zz abc two" | None => false end)
         "a start that also appears inside another line marks only the line it begins"
  ++ say (match mark_on (append "#" (append newline (append "M-1: a" (append newline (append "M-1: b" newline))))) "M-1" with
          | Some _ => false | None => true end)
         "a start two lines begin with marks neither".

(** ---- the market and the agent ---- *)

base : obj :=
  let m := new_market ["claude", "codex", "grok", "muse"] in
  let m := setf m "leader" "claude" in
  let m := setf m "h" 10 in
  let m := setf m "repos" ([("calc", "tree0")] : list (string * string)) in
  setf m "awaiting" false.

posted : obj := let '(m, _, _) := apply base "claude" ["post", "calc", "a long plan item"] in m.

llm (who : string) : obj := setf (new_agent who) "backend" "llm".

(** a leader that judged task 1 done, with the plan line it named *)
judged (line : string) : obj :=
  setf (setf (llm "claude") "done_marks" ([("1", "0")] : list (string * string)))
    "plan_lines" ([("1", line)] : list (string * string)).

logs (o : list (list string)) : list string :=
  flat_map (fun x => match x with ["log", t] => [t] | _ => [] end) o.

queued (a : obj) (k : string) : bool :=
  existsb (fun q => match q with x :: _ => seq x k | _ => false end) (queue a).

lines_agent : list string :=
  let '(mk, _, wk) := apply posted "claude" ["mark", "1", shown, "tree1", "tree0"] in
  let edit_ok := match bid_by mk 1 with
                 | Some b => match edits b with [e] => seq (eold e) (append newline shown) | _ => false end
                 | None => false end in
  let pa := on_answer (llm "claude") posted ["pick", "1"]
                   ["merge", "0", "done", "true", "plan_line", truncate_line long] in
  let (named, on) := lead (judged shown) posted in
  let (unnamed, un) := lead (judged "") posted in
  let (_, again) := lead unnamed posted in
  let (_, stuck) := lead (llm "claude") (setf posted "h" 100000) in
  say (seq wk "") "the market takes a mark that names a line by its start"
  ++ say edit_ok "the mark's edit is the line's start after a newline"
  ++ say (seq (get_or "" "1" (plan_lines pa)) shown) "a pick's plan_line shown cut is kept without the ..."
  ++ say (queued named "markq" && (length (logs on) =? 0)) "a task judged done with its line named is marked first, and nothing is logged"
  ++ say (queued unnamed "close" && existsb (fun l => has l "task 1 closes with no mark in .plan" && has l "named no plan line") (logs un))
         "a task judged done with no line closes, and the log says its line stays open"
  ++ say (length (logs again) =? 0) "that is logged once"
  ++ say (existsb (fun l => has l "task 1 closes with no mark" && has l "no bid could finish it") (logs stuck))
         "a task no bid could finish closes, logged the same way".

(** task 1 marked by claude, the mark merged, and codex leading now: it
    has no judgment of its own on the task (done_marks), yet closes it *)
mark_merged_under_codex : obj :=
  let '(m, _, _) := apply posted "claude" ["mark", "1", shown, "tree1", "tree0"] in
  let m := match bid_by m 1 with Some b => set_bid m (with_status b Merged "") | None => m end in
  setf (setf m "pending" (None : option proposal)) "leader" "codex".

picks (o : list (list string)) : nat :=
  length (filter (fun x => match x with "llm" :: _ :: "pick" :: _ => true | _ => false end) o).

lines_other_leader : list string :=
  let (ac, oc) := lead (llm "codex") mark_merged_under_codex in
  say (queued ac "close" && (length (logs oc) =? 0)) "a task whose mark merged is closed by whoever leads, with nothing logged"
  ++ say (picks oc =? 0) "and no pick is asked for it".

(** a leader may close a task that its merges left better without finishing
    it: the task closes with its plan line open, for a later task, and a
    later draft sees it as closed with work merged *)
closing (bid : string) : obj :=
  setf (llm "claude") "close_marks" ([("1", bid)] : list (string * string)).

(** task 1 with a bid on it merged, and the task closed *)
merged_and_closed : obj :=
  (* only the task's two rotating bidders may bid on it *)
  let who := match task_by posted 1 with Some t => hd "codex" (bidders_for posted t) | None => "codex" end in
  let '(m, _, _) := apply posted who ["bid", "1", "0", "a step", "a.txt", "", "one"] in
  let m := match bid_by m 1 with Some b => set_bid m (with_status b Merged "") | None => m end in
  let '(m, _, _) := apply m "claude" ["close", "1"] in m.

lines_close : list string :=
  let pa := on_answer (llm "claude") posted ["pick", "1"] ["merge", "0", "done", "false", "close", "true"] in
  let pd := on_answer (llm "claude") posted ["pick", "1"] ["merge", "0", "done", "true", "close", "true", "plan_line", shown] in
  let (ac, oc) := lead (closing "0") posted in
  let (aw, _) := lead (closing "7") posted in
  let label := match task_by merged_and_closed 1 with Some t => task_label merged_and_closed t | None => "" end in
  say (seq (get_or "" "1" (close_marks pa)) "0" && (length (done_marks pa) =? 0))
      "a pick that closes the task for now is kept as the leader's close, not as done"
  ++ say (seq (get_or "" "1" (done_marks pd)) "0" && (length (close_marks pd) =? 0))
      "done wins over close"
  ++ say (queued ac "close" && existsb (fun l => has l "the leader closed it with its work merged") (logs oc))
      "a task closed for now closes, and the log says a later task takes up the rest"
  ++ say (negb (queued aw "close")) "a close that names a bid waits for that bid to merge"
  ++ say (has label "closed with work merged on it") "a later draft sees the task as closed with work merged".

report : list string := lines_edit ++ lines_agent ++ lines_other_leader ++ lines_close.

main := Host.print_lines report.
