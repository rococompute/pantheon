Example completed_job_exact_outcomes :
  job_result (JobExit "0") None false "4" "" = "pending" /\
  job_result (JobExit "2") None false "4" "oops" = "!process failed (exit 2): oops" /\
  job_result (JobSignal "SIGKILL") (Some "600") true "4" "" =
    "!process failed (it printed more than 4 MB, so the node stopped it): ".
Proof. repeat split; computed. Qed.

Example completed_job_and_peer_framing :
  feed_chunks ["hel"] "lo
partial" = (["hello"], ["partial"]) /\
  feed_chunks [] "one

two
" = (["one", "", "two"], []) /\
  buffer_over (chunks_len ["abc", "de"]) 4 = true /\
  job_status_of "unknown" "0" = None.
Proof. repeat split; computed. Qed.

Theorem job_success_bytes_unchanged : forall out seconds cap,
  out <> "" -> job_result (JobExit "0") seconds false cap out = out.
Proof.
  intros out seconds cap H. unfold job_result.
  change ((if seq out "" then "pending" else out) = out).
  unfold seq. destruct (Stdlib.Strings.String.eqb out "") eqn:E; [|reflexivity].
  apply Stdlib.Strings.String.eqb_eq in E. contradiction.
Qed.

Theorem job_flood_reason_dominates : forall status seconds cap,
  job_failure_reason status seconds true cap = append "it printed more than " (append cap " MB, so the node stopped it").
Proof. reflexivity. Qed.

Theorem job_exited_reason_ignores_timeout : forall code seconds cap,
  job_failure_reason (JobExit code) seconds false cap = append "exit " code.
Proof. reflexivity. Qed.
