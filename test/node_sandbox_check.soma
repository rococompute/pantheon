(** A unikernel that runs a node program with node_sandbox.soma's
    interpreter: what test/node-sandbox.sh checks with soma build
    --no-image (the MirageOS project type-checks, no image is booted). *)
Require Import Sandbox.
Import nodeio node_host node_kernel node_sandbox.

world : kworld :=
  {| w_chain := "pantheon-test";
     w_key := {| nk_bytes := 0; nk_n := []; nk_e := []; nk_p := []; nk_q := [];
                 nk_dp := []; nk_dq := []; nk_qinv := [] |};
     w_keys := [];
     w_draw := ["false", "1", "secret"];
     w_exclusions := ["alternate"];
     w_identity := "claude";
     w_boot := [["me", "claude"]];
     w_backend := "claude";
     w_listen := "0.0.0.0";
     w_port := "9000";
     w_host := {| hw_home := "/home"; hw_backend := "claude"; hw_repos := [("calc", "abc1234")];
                  hw_max_calls := "100"; hw_ci := ""; hw_ci_repo := []; hw_ci_memory := "2g";
                  hw_ci_image := ""; hw_ci_sandbox := "" |} |}.

iworld : img_world :=
  {| iw_service_host := ""; iw_service_port := 0; iw_token := "" |}.

(** A decided block as node.soma's outputs make it: logged, stored, the
    height set, the status written, a timer armed; the block and the peer
    count read back. *)
demo : nprog bool :=
  ndo (IoLog "decided 1") (fun _ =>
  ndo (IoStore "1" ["tx ""a""", "tx2"]) (fun _ =>
  ndo (IoSetHeight "2") (fun _ =>
  ndo (IoWriteStatus "height 2") (fun _ =>
  ndo (IoTimer "350" ["timeout", "commit", "2", "0"]) (fun _ =>
  nbind (nask (IoBlock "1")) (fun block =>
  nbind (nask IoPeerCount) (fun peers =>
  nand (nexec (IoLog (match ans_found block with
                      | Some (tx :: _) => Stdlib.Strings.String.append tx (ans_one peers)
                      | _ => "no block" end)))
       (fun _ => nexec (IoLog "read back"))))))))).

main : io unit :=
  r <- run_image iworld (kernel_run world demo (kernel_start "claude" [])) {| i_service := None; i_service_retry := 0%N |} ;;
  stored <- read_file "blocks.log" ;;
  print (match stored with Some s => s | None => "no block log" end) ;;
  print (if fst (fst r) then "program ended true" else "program stopped at a false answer").
