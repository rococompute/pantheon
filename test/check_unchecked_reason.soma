(** The check_result event Soma chooses, through the real plain-text
    binding: the old fields in the old order, control characters made
    spaces (tab and newline kept), and a no-check refusal as this node's own.
    No node, no disk. *)
Import util shell node node_shell.
From Stdlib Require ExtrOcamlNatInt.
Extract Inlined Constant Nat.div => "(fun a b -> if b = 0 then 0 else a / b)".
Extract Inlined Constant Nat.modulo => "(fun a b -> if b = 0 then a else a mod b)".
Extract Inlined Constant Stdlib.Strings.String.length => "String.length".
Extract Inlined Constant Stdlib.Strings.String.get =>
  "(fun n s -> if n < String.length s then Some (String.unsafe_get s n) else None)".
Extract Inlined Constant Stdlib.Strings.String.substring =>
  "(fun n m s -> let l = String.length s in if n >= l then """" else String.sub s n (min m (l - n)))".
From Stdlib Require Import Ascii.

check (label : string) (ok : bool) : string := append (if ok then "ok " else "FAIL ") label.

ch (n : nat) : string := Stdlib.Strings.String.String (ascii_of_nat n) Stdlib.Strings.String.EmptyString.

main := print_lines [
  check "explicit no-check reason" (seq (check_unchecked_reason "soma" false)
    "this node doesn't check soma (--no-check soma)"),
  check "scope reason wins" (seq (check_unchecked_reason "pantheon" true)
    "this node doesn't check pantheon (outside its scope: its genesis part excludes it)"),
  check "exact abstention event" (eq_strs (check_unchecked_repo_event "9" "soma" true)
    ["check_result", "9", "ok", "error", "tree", "", "why",
     "this node doesn't check soma (outside its scope: its genesis part excludes it)", "stage", "node"]),
  check "raw fact is interpreted" (eq_strs
    (hd [] (snd (run_shell (job_output_prog empty_node
      ["check_unchecked_repo", "7", "soma", "false"]))))
    (check_unchecked_repo_event "7" "soma" false))
].
