(** M-3 part: the roster by height, run as extracted code on fixed inputs
    (core/market.exp checks the same in the kernel). No node, no timing. *)
Import core.util core.market.
Require Soma.Host.

check (label : string) (ok : bool) : string := append (if ok then "ok " else "FAIL ") label.

Fixpoint same (a b : list string) : bool :=
  match a, b with
  | [], [] => true
  | x :: r, y :: t => seq x y && same r t
  | _, _ => false
  end.

seven : list string := ["a1", "a2", "a3", "a4", "a5", "a6", "a7"].
four : list string := ["a1", "a2", "a3", "a4"].
leave7 : list (string * bool * nat) := [("a7", false, effective_height 10 1)].
cycle4 : list (string * bool * nat) := [("a4", false, effective_height 8 1), ("a4", true, effective_height 18 1)].
pcs (missing : nat) : list (list string) :=
  map (fun _ => ["a1", "a2"]) (List.seq 0 missing) ++ [["a1", "a2", "a3"]].

main := Host.print_lines [
  check "absent for absent_blocks - 1 blocks is kept" (negb (removal_due 3 "a3" (pcs 2))),
  check "absent for absent_blocks blocks is proposed for removal" (removal_due 3 "a3" (pcs 3)),
  check "present in the latest block resets the run" (absent_run "a1" (pcs 5) =? 0),
  check "a change committed at 10 takes effect at 12, not 10" (effective_height 10 1 =? 12),
  check "seven agents until the removal's height" (length (roster_at seven leave7 11) =? 7),
  check "six from it" (same (roster_at seven leave7 12) ["a1", "a2", "a3", "a4", "a5", "a6"]),
  check "seven to six: approvals 5 then 5" ((quorum_at seven leave7 11 =? 5) && (quorum_at seven leave7 12 =? 5)),
  check "seven to six: rejections 3 then 2" ((reject_quorum_at seven leave7 11 =? 3) && (reject_quorum_at seven leave7 12 =? 2)),
  check "four to three: approvals 3, rejections 2 then 1"
    ((quorum_at four cycle4 9 =? 3) && (reject_quorum_at four cycle4 9 =? 2) &&
     (quorum_at four cycle4 10 =? 3) && (reject_quorum_at four cycle4 10 =? 1)),
  check "rejoin at its effective height" (same (roster_at four cycle4 20) four && (length (roster_at four cycle4 19) =? 3)),
  check "quorums after the rejoin" ((quorum_at four cycle4 20 =? 3) && (reject_quorum_at four cycle4 20 =? 2)),
  check "a stable roster keeps genesis's quorums" ((quorum_at seven [] 100 =? quorum 7) && same (roster_at seven [] 100) seven)
].
