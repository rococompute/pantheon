Fixpoint strs_eq (a b : list string) : bool :=
  match a, b with [], [] => true | x :: r, y :: q => seq x y && strs_eq r q | _, _ => false end.

opt_eq (a b : option (list string)) : bool :=
  match a, b with Some x, Some y => strs_eq x y | None, None => true | _, _ => false end.

float_fails : list string :=
  flat_map (fun (c : string * (string * string)) => let (s, wt) := c in let (w, t) := wt in
    let f := float_of_digits s in
    let w' := float_wire f in let t' := float_text f in
    if seq w w' && seq t t' then [] else [append "FAIL float " (append s (append " gave " (append w' (append " " t'))))])
  float_cases.

json_fails : list string :=
  flat_map (fun (c : string * option (list string)) => let (s, expected) := c in
    if opt_eq (json_tokens s) expected then [] else [append "FAIL json " s]) json_cases.

(** bytes a literal can't hold: raw control characters and UTF-8 pass as
    they are, \u gives UTF-8 *)
ch (n : nat) : string := Stdlib.Strings.String.String (Ascii.ascii_of_nat n) "".
byte_checks : list string :=
  let raw := append """" (append (ch 1) (append (ch 10) (append (ch 195) (append (ch 169) """")))) in
  (if opt_eq (json_tokens raw) (Some ["S", append (ch 1) (append (ch 10) (append (ch 195) (ch 169)))]) then [] else ["FAIL raw bytes"])
  ++ (if opt_eq (json_tokens """é€😀""")
         (Some ["S", append (ch 195) (append (ch 169) (append (ch 226) (append (ch 130) (append (ch 172)
                       (append (ch 240) (append (ch 159) (append (ch 152) (ch 128))))))))]) then [] else ["FAIL utf8"]).

results : list string :=
  float_fails ++ json_fails ++ byte_checks
  ++ [append "ok " (append (show (length float_cases)) (append " floats, " (append (show (length json_cases)) " JSON cases")))].
main := print_lines results.
