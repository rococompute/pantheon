(** The version in a merge commit's message. Fixed strings, no git. *)
Import core.util core.market.
Require Soma.Host.

check (label got expected : string) : string :=
  append (if seq got expected then "ok " else "FAIL ") label.

msg : string :=
  append "Merge bid 3 for task 1 by ada" (append newline
  (append newline (append "the spec" (append newline
  (append newline (append "Pantheon-Version: 4" (append newline
  (append "Pantheon-Bid: 3" (append newline "Pantheon-Tree: abc"))))))))).

checks : list string := [
  check "an empty message is version 0" (commit_version "") "0",
  check "no version line is version 0" (commit_version "just a note") "0",
  check "the version the merge commit writes" (commit_version msg) "4",
  check "a later version replaces the earlier one"
    (commit_version (append "Pantheon-Version: 2" (append newline "Pantheon-Version: 9"))) "9",
  check "a non-numeric version is left alone"
    (commit_version (append "Pantheon-Version: 2" (append newline "Pantheon-Version: no"))) "2",
  check "an extra word is not the version line"
    (commit_version "Pantheon-Version: 4 extra") "0",
  check "two spaces are not the one space the line is written with"
    (commit_version "Pantheon-Version:  4") "0"
].

main := Host.print_lines checks.
