(** Codex reply selection on fixed inputs; no running node. *)
Import core.util core.market core.agent runtime.node.
Require Soma.Host.

check (label got expected : string) : string :=
  append (if seq got expected then "ok " else "FAIL ") label.

checks : list string := [
  check "file wins over stdout" (codex_reply_of "diagnostics" (fun _ => Some "{}")) "{}",
  check "empty file stays empty" (codex_reply_of "pending" (fun _ => Some "")) "",
  check "missing file" (codex_reply_of "pending" (fun _ => None)) "!codex wrote no reply",
  check "failure wins over file" (codex_reply_of "!failed" (fun _ => Some "{}")) "!failed",
  check "failure wins over missing file" (codex_reply_of "!spawn" (fun _ => None)) "!spawn",
  check "empty stdout uses file" (codex_reply_of "" (fun _ => Some "reply")) "reply",
  check "embedded bang is success" (codex_reply_of "log!" (fun _ => Some "reply")) "reply",
  check "file bytes unchanged" (codex_reply_of "pending" (fun _ => Some "  {}
")) "  {}
"
].
main := Host.print_lines checks.
