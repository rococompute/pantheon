(** Fixed held-request event construction. No running node, no sockets. *)
Import util shell node.
From Stdlib Require ExtrOcamlNatInt.

check (label : string) (ok : bool) : string := append (if ok then "ok " else "FAIL ") label.
eq_events (a b : list (list string)) : bool :=
  (length a =? length b) && forallb (fun p => eq_strs (fst p) (snd p)) (combine a b).

main := print_lines [
  check "absent request" (eq_events (held_one_events None) []),
  check "empty fields stay present" (eq_events (held_one_events (Some ("", "", "", [])))
    [["llm_release", "", "", ""]]),
  check "context and prompt bytes preserved" (eq_strs
    (held_request_event ("id", "patch", "line
prompt", ["repo", "a", ""]))
    ["llm_release", "id", "patch", "line
prompt", "repo", "a", ""]),
  check "multiple requests preserve oldest-first input order"
    (eq_events (map held_request_event [("old", "draft", "p", []), ("new", "pick", "q", ["r"])])
      [["llm_release", "old", "draft", "p"], ["llm_release", "new", "pick", "q", "r"]]),
  check "no requests" (eq_events (map held_request_event []) [])
].
