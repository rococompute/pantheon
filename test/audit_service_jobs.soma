(** Actual Soma host-job state transitions; no model, daemon or shell mocks. *)
Import core.util runtime.nodeio runtime.node runtime.node_host runtime.node_service runtime.node_net.
Require Soma.Host.

check (name : string) (ok : bool) : string := append (if ok then "ok " else "FAIL ") name.
world : hworld := {| hw_home := "/home"; hw_backend := ""; hw_repos := []; hw_max_calls := "0";
  hw_ci := ""; hw_ci_repo := []; hw_ci_memory := "256m"; hw_ci_image := "image"; hw_ci_sandbox := "/runner" |}.
service : service_world := {| sw_token := "token"; sw_world := world; sw_self := "/node"; sw_env := ["PATH=/usr/bin:/bin"] |}.
answers (op : node_op) : nanswer :=
  match op with
  | IoProcStart _ _ _ _ _ => ans_data true ["cleanup-job"]
  | IoClock => ans_data true []
  | IoEnvEntries => ans_data true ["PATH=/usr/bin:/bin"]
  | _ => ans_ok
  end.
failed_start (op : node_op) : nanswer :=
  match op with IoProcStart _ _ _ _ _ => ans_data false ["spawn refused"] | _ => answers op end.
started : host_state := nresult answers (hcleanup host_start [CleanTree "/tree"]).
ended : host_state := fst (hevent started ["job_ended", "cleanup-job", "exit", "1"]).
kill_failed (op : node_op) : nanswer :=
  match op with IoProcKill _ => ans_data false ["permission denied"] | _ => answers op end.
check_answers (op : node_op) : nanswer :=
  match op with
  | IoTempDir prefix => ans_data true [if seq prefix "pantheon-check" then "/tmp/check-owned" else "/tmp/job-owned"]
  | IoTempFile _ _ _ => ans_data true ["/tmp/edits-owned"]
  | IoSelfExe => ans_data true ["/node"]
  | _ => answers op
  end.
actual_check : list node_op := ntrace check_answers (hcheck_fresh world host_start "id" "calc" "head" "key" []).
check_roots : list string := ["/tmp/check-owned", "/tmp/job-owned", "/tmp/edits-owned"].
pid_kill_failed (op : node_op) : nanswer :=
  match op with IoKillPid _ => ans_data false ["permission denied"] | _ => answers op end.
process_state : net_state := {| (net_start "/home") with
  ns_procs := [{| p_job := "job"; p_fd := "fd"; p_pid := "pid" |}] |}.
failed_trace : list node_op := ntrace answers (hcomplete world ended "cleanup-job" "!process failed (exit 1):").
success_trace : list node_op := ntrace answers (hcomplete world ended "cleanup-job" "").
no_recursive_cleanup : bool :=
  match hs_jobs started with [j] => match j_done j with
    DoneCleanup p => seq p "/tree" && (length (j_clean j) =? 0) | _ => false end | _ => false end.
logs (needle : string) (trace : list node_op) : bool :=
  existsb (fun op => match op with IoLog text => contains needle text | _ => false end) trace.

main := Host.print_lines [
  check "tree removal is a tracked rm process with a literal operand"
    (existsb (fun op => match op with
      IoProcStart prog _ _ _ args => seq prog "rm" && eq_strs args ["-rf", "--", "/tree"]
      | _ => false end) (ntrace answers (hcleanup host_start [CleanTree "/tree"]))),
  check "cleanup job owns no scratch tree and cannot recursively schedule cleanup" no_recursive_cleanup,
  check "failed cleanup startup is visible and creates no running job"
    ((length (hs_jobs (nresult failed_start (hcleanup host_start [CleanTree "/tree"]))) =? 0)
      && logs "cleanup could not start" (ntrace failed_start (hcleanup host_start [CleanTree "/tree"]))),
  check "actual failed cleanup completion is logged" (logs "cleanup failed: /tree" failed_trace),
  check "actual successful cleanup completion is logged" (logs "cleanup complete: /tree" success_trace),
  check "completed cleanup job leaves no recursive job"
    (length (hs_jobs (snd (nresult answers (hcomplete world ended "cleanup-job" "")))) =? 0),
  check "runner exit 3 is already an infrastructure problem" (ci_node_problem false (Some "exit 3")),
  check "Docker runner exit 125 is already an infrastructure problem" (ci_node_problem false (Some "exit 125")),
  check "wrapped bid failure exit 86 is the bid's failure" (negb (ci_node_problem false (Some "exit 86"))),
  check "lock wait infrastructure status 75 is a node problem" (ci_node_problem false (Some "exit 75")),
  check "service permits the same tracked cleanup for a tree it made"
    (sv_allowed service ["/tree"] (IoProcStart "rm" "" "/tree" ["PATH=/usr/bin:/bin"] ["-rf", "--", "/tree"])),
  check "service refuses arbitrary cleanup targets"
    (negb (sv_allowed service ["/tree"] (IoProcStart "rm" "" "/tree" ["PATH=/usr/bin:/bin"] ["-rf", "--", "/elsewhere"]))),
  check "service keeps the path probe for tracked cleanup"
    (match sv_guard service ["/tree"] (IoProcStart "rm" "" "/tree" [] ["-rf", "--", "/tree"]) with
     Some (root, rel) => seq root "/tree" && seq rel "" | None => false end),
  check "tracked cleanup revokes the temporary root capability once started"
    (length (sv_after ["/tree"] (IoProcStart "rm" "" "/tree" [] ["-rf", "--", "/tree"]) ans_ok) =? 0),
  check "cleanup startup receipt never claims scheduling after spawn failure"
    (negb (fst (fst (nresult failed_start (hcleanup_tree host_start "/tree"))))),
  check "failed cancellation remains a failure"
    (negb (fst (fst (nresult kill_failed (hstop started "cleanup-job" j_overtime (fun j => {| j with j_overtime := true |})))))),
  check "failed cancellation never marks a live job timed out"
    (match hs_jobs (snd (nresult kill_failed (hstop started "cleanup-job" j_overtime (fun j => {| j with j_overtime := true |})))) with
     [j] => negb (j_overtime j) | _ => false end),
  check "actual recorded hcheck_fresh process is served by the image host"
    (existsb (fun op => match op with IoProcStart _ _ _ _ _ => true | _ => false end) actual_check &&
     forallb (fun op => match op with IoProcStart _ _ _ _ _ => sv_allowed service check_roots op | _ => true end) actual_check),
  check "service refuses unrecognized extra check flags"
    (negb (sv_allowed service check_roots (IoProcStart "/node" "" "/tmp/job-owned" []
      ["check", "/home/repos/calc", "head", "/tmp/edits-owned", "/tmp/check-owned", "--not-record"]))),
  check "tracked cleanup has no blanket repository-root authority"
    (negb (sv_allowed service [] (IoProcStart "rm" "" "/home/repos" [] ["-rf", "--", "/home/repos"]))),
  check "failed PID cancellation is reported and never forces process completion"
    (negb (fst (fst (nresult pid_kill_failed (net_proc_kill process_state "job")))) &&
     (length (ns_cut (snd (nresult pid_kill_failed (net_proc_kill process_state "job")))) =? 0)),
  check "successful PID cancellation permits normal forced completion"
    (fst (fst (nresult answers (net_proc_kill process_state "job"))) &&
     eq_strs (ns_cut (snd (nresult answers (net_proc_kill process_state "job")))) ["pid"]),
  "--PAYLOAD--", ci_wrap "exit 3", "--END-PAYLOAD--"
].
