(** Fixed chain lookups, not local observations. The verification model checks
    exact signed fields; production's callback is node_verify_line. *)
Import core.util core.consensus core.market.
Require Soma.Host.
check (b : bool) (s : string) : string := append (if b then "ok " else "FAIL ") s.
body (h : nat) : list string := ["block", show h].
block_at (h : nat) : option (list string) := if h =? 0 then None else Some (body h).
seal (a : string) (fields : list string) : string := hash_list ("chain" :: a :: fields).
verify (a sg : string) (fields : list string) : bool := seq sg (seal a fields).
vote (h : nat) (a : string) : signed_precommit :=
  let fields := ["precommit", show h, "2", "0", hash_list (body h)] in
  {| commit_signer := a; commit_signature := seal a fields; commit_fields := fields |}.
cert (h : nat) (names : list string) : commit_certificate :=
  {| certificate_height := h; certificate_round := 2; certificate_votes := map (vote h) names |}.
agreed (names : list string) (h : nat) : option commit_certificate :=
  if (0 <? h) && (h <=? 3) then Some (cert h names) else None.
g4 : list string := ["a", "b", "c", "d"].
g7 : list string := ["a", "b", "c", "d", "e", "f", "g"].
p4 : roster_policy := {| roster_genesis := g4; roster_minimum := 3; roster_delay := 1; roster_absent_blocks := 3 |}.
p7 : roster_policy := {| roster_genesis := g7; roster_minimum := 6; roster_delay := 1; roster_absent_blocks := 3 |}.
window (lookup : nat -> option commit_certificate) : option (list (list string)) :=
  certified_commit_window verify (fun _ => g4) block_at lookup 3 3.
no_window (x : option (list (list string))) : bool := match x with None => true | _ => false end.
no_change (x : option (list (string * bool * nat))) : bool := match x with None => true | _ => false end.
changes (x : option (list (string * bool * nat))) : list (string * bool * nat) := match x with Some cs => cs | _ => [] end.
request_certified (p : roster_policy) (cs : list (string * bool * nat)) (lookup : nat -> option commit_certificate)
      (h : nat) (s : string) (fields : list string) : option (list (string * bool * nat)) :=
  commit_certified_roster_fields verify p cs block_at lookup h "a" s fields.
gap (h : nat) : option commit_certificate := if h =? 2 then None else agreed ["a", "b", "c"] h.
leave4 : list (string * bool * nat) := changes (request_certified p4 [] (agreed ["a", "b", "c"]) 5 "a" ["roster", "leave", "d"]).
leave7 : list (string * bool * nat) := changes (request_certified p7 [] (agreed ["a", "b", "c", "d", "e"]) 5 "a" ["roster", "leave", "g"]).
join4 : list (string * bool * nat) := changes (request_certified p4 leave4 (fun _ => None) 7 "d" ["roster", "join", "d"]).
height_roster (h : nat) : list string := roster_at g7 [("g", false, 2)] h.

main := Host.print_lines [
 check (match window (agreed ["a", "b", "c"]) with Some [a,b,c] =>
          (length a =? 3) && (length b =? 3) && (length c =? 3) | _ => false end) "exact certified window",
 check (no_window (window (fun h => if h =? 3 then None else agreed ["a", "b", "c"] h))) "missing head refused",
 check (no_window (window gap)) "missing intermediate record refused",
 check (no_window (window (fun _ => Some (cert 1 ["a", "b", "c"])))) "wrong certificate height refused",
 check (match certified_commit_window verify (fun _ => g4) (fun _ => None) (agreed ["a", "b", "c"]) 3 3 with
         None => true | _ => false end) "missing actual block refused",
 check (match certified_commit_window verify (fun _ => g4) (fun h => Some ("other" :: body h)) (agreed ["a", "b", "c"]) 3 3 with
         None => true | _ => false end) "wrong actual block refused",
 check (match certified_commit_window (fun _ _ _ => false) (fun _ => g4) block_at (agreed ["a", "b", "c"]) 3 3 with
         None => true | _ => false end) "bad signature refused",
 check (no_window (window (agreed ["a", "b"]))) "insufficient quorum refused",
 check (match certified_commit_window verify (fun _ => g4) block_at (agreed ["a", "b", "c"]) 0 1 with
         None => true | _ => false end) "no height zero certificate",
 check (match certified_commit_window verify (fun _ => g4) block_at (fun _ => None) 0 0 with
         Some [] => true | _ => false end) "zero window is empty",
 check (length leave4 =? 1) "certified leave admitted",
 check (no_change (request_certified p4 [] gap 5 "a" ["roster", "leave", "d"])) "gap cannot authorize leave",
 check (no_change (request_certified p4 [] (fun h => agreed (if h =? 3 then ["a", "b", "d"] else ["a", "b", "c"]) h)
         5 "a" ["roster", "leave", "d"])) "latest heartbeat resets absence",
 check (no_change (request_certified p4 [] (agreed ["a", "b", "c"]) 4 "a" ["roster", "leave", "d"]))
       "two observations cannot meet three-block threshold",
 check ((length (roster_at g7 leave7 5) =? 7) && (length (roster_at g7 leave7 6) =? 7) &&
        (length (roster_at g7 leave7 7) =? 6)) "certified seven-to-six activation",
 check ((quorum_at g7 leave7 6 =? 5) && (quorum_at g7 leave7 7 =? 5) &&
        (reject_quorum_at g7 leave7 6 =? 3) && (reject_quorum_at g7 leave7 7 =? 2)) "certified seven-to-six quorums",
 check ((quorum_at g4 leave4 6 =? 3) && (quorum_at g4 leave4 7 =? 3) &&
        (reject_quorum_at g4 leave4 6 =? 2) && (reject_quorum_at g4 leave4 7 =? 1)) "certified four-to-three quorums",
 check ((length (roster_at g4 join4 8) =? 3) && (length (roster_at g4 join4 9) =? 4) &&
        (quorum_at g4 join4 9 =? 3) && (reject_quorum_at g4 join4 9 =? 2)) "certified delayed rejoin",
 check (no_change (request_certified {| p4 with roster_minimum := 4 |} [] (agreed ["a", "b", "c"])
          5 "a" ["roster", "leave", "d"])) "minimum roster enforced",
 check (length (roster_at g4 (changes (request_certified {| p4 with roster_delay := 0 |} [] (agreed ["a", "b", "c"])
          5 "a" ["roster", "leave", "d"])) 6) =? 3) "zero delay still later",
 check (match verify_height_certificate verify height_roster block_at 1 (cert 1 ["a", "b", "c", "d", "g"]) with
          Some ns => length ns =? 5 | _ => false end) "previous roster chosen by certificate height",
 check (match verify_height_certificate verify height_roster block_at 2 (cert 2 ["a", "b", "c", "d", "g"]) with
          None => true | _ => false end) "removed signer refused at later height",
 check (no_change (request_certified p7 leave7 (agreed ["a", "b", "c", "d", "e"]) 5 "a" ["roster", "leave", "f"]))
       "pending removals share minimum",
 check (no_change (request_certified p4 [] (agreed ["a", "b", "c"]) 5 "b" ["roster", "leave", "d"])) "nonleader cannot remove",
 check (no_change (request_certified p4 leave4 (fun _ => None) 7 "a" ["roster", "join", "d"])) "another member cannot request rejoin",
 check (no_change (request_certified p4 leave4 (fun _ => None) 7 "outsider" ["roster", "join", "outsider"])) "nongenesismember cannot join"
].
