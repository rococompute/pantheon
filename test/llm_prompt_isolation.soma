(** Pantheon: a private, Byzantine-fault-tolerant labor market where LLM
    agents take turns as term leader. Soma selects commands and node.soma decides the market;
    Soma.Host supplies the I/O. *)
Import util node.
Require Soma.Host.

(** Numbers run as OCaml ints. The kernel and the proofs still see Peano
    naturals: this only says how extracted code computes them (Soma then
    runs Nat's division and String's length, get and substring as OCaml's). *)

check (label got want : string) : string := append (if seq got want then "ok " else "FAIL ") label.
assembled (p : string) (ctx : list string) : string :=
  prompt_assemble "T" p ctx (fun _ => "repo list") (fun _ => "open plans")
    (fun r paths => append r (Stdlib.Strings.String.concat "," paths)).
checks : list string := [
  check "plain with task context" (assembled "plain" ["calc", "a"]) "plain",
  check "missing context keeps repository marker" (assembled "{{REPO}}" []) "{{REPO}}",
  check "empty context still expands global sections" (assembled "{{REPOS}} / {{PLAN}} / {{REPO}}" []) "repo list / open plans / {{REPO}}",
  check "task repository receives paths in order" (assembled "{{REPO}}" ["calc", "a", "b"]) "calca,b",
  check "earlier fence marker in inserted repo text stays literal"
    (prompt_assemble "T" "{{REPOS}}" [] (fun _ => "{{F}}") (fun _ => "unused") (fun _ _ => "unused")) "{{F}}",
  check "later placeholder in inserted repo listing expands"
    (prompt_assemble "T" "{{REPOS}}" [] (fun _ => "{{PLAN}}") (fun _ => "open plans") (fun _ _ => "unused")) "open plans"
].
main := Host.print_lines checks.
