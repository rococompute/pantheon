(** Git and programs as the binary runs them (node_git.soma), whatever the
    host's processes answer: a program's input goes in a file made for
    it and removed right after the start; a program run to its end leaves nothing
    behind (its pipe read only, then closed, then the process waited
    for); one that couldn't start runs nothing more; it succeeded only
    when the process exited with 0; and git runs only as "git", with the
    fixed config flags, from where the binary is, in an environment that
    has none of the host's own GIT_ entries. What the host's processes
    do (that a read gives the program's output) is the host's. *)

Lemma ntrace_nbind : forall (A B : Type) ans (p : nprog A) (f : A -> nprog B),
  ntrace ans (nbind p f) = ntrace ans p ++ ntrace ans (f (nresult ans p)).
Proof. intros A B ans p f. induction p as [a | op k IH]; cbn; [reflexivity | rewrite IH; reflexivity]. Qed.

Lemma nresult_nbind : forall (A B : Type) ans (p : nprog A) (f : A -> nprog B),
  nresult ans (nbind p f) = nresult ans (f (nresult ans p)).
Proof. intros A B ans p f. induction p as [a | op k IH]; cbn; [reflexivity | apply IH]. Qed.

(** ---- a program run to its end ---- *)

(** reading a pipe only reads that pipe *)
Lemma read_out_reads : forall fuel ans pipe acc,
  exists n, ntrace ans (read_out fuel pipe acc) = repeat (IoSockRead pipe) n.
Proof.
  induction fuel as [| f IH]; intros ans pipe acc; [exists 0; reflexivity |].
  cbn -[seq ans_list]. destruct (ans_list (ans (IoSockRead pipe))) as [| t [| d [| x rest]]]; cbn -[seq].
  - exists 1. reflexivity.
  - destruct (seq t "again"); [destruct (IH ans pipe acc) as [n H]; exists (S n); rewrite H; reflexivity | exists 1; reflexivity].
  - destruct (seq t "bytes"); [destruct (IH ans pipe (d :: acc)) as [n H]; exists (S n); rewrite H; reflexivity | exists 1; reflexivity].
  - exists 1. reflexivity.
Qed.

(** ---- a program's input ---- *)

(** no input: the start alone, from /dev/null *)
Theorem spawn_fed_none : forall prog cwd env args,
  spawn_fed prog "" cwd env args = nask (IoSpawn prog "" cwd env args).
Proof. reflexivity. Qed.

(** input, its file made: the text put in it, the start (only when the
    put worked) from that file, and the file removed, whatever the start
    answered *)
Theorem spawn_fed_removes_its_file : forall ans prog stdin cwd env args,
  stdin <> "" -> fst (ans (IoTempNew "pantheon-in" ".txt")) = true ->
  let f := ans_one (ans (IoTempNew "pantheon-in" ".txt")) in
  ntrace ans (spawn_fed prog stdin cwd env args) =
    IoTempNew "pantheon-in" ".txt" :: IoFilePut f stdin "false" ::
    (if fst (ans (IoFilePut f stdin "false")) then [IoSpawn prog f cwd env args] else []) ++ [IoRemoveFile f].
Proof.
  intros ans prog stdin cwd env args Hs Ht f. unfold spawn_fed.
  destruct (seq stdin "") eqn:E; [apply Stdlib.Strings.String.eqb_eq in E; contradiction |].
  cbn [nbind nask ntrace]. rewrite Ht. cbn [negb nbind nask ntrace]. fold f.
  destruct (fst (ans (IoFilePut f stdin "false"))); reflexivity.
Qed.

(** what starting with input does: the start, a temporary file made,
    the input put in it, a file removed, nothing else *)
Lemma spawn_fed_ops : forall ans prog stdin cwd env args op,
  In op (ntrace ans (spawn_fed prog stdin cwd env args)) ->
  (exists f, op = IoSpawn prog f cwd env args) \/ op = IoTempNew "pantheon-in" ".txt" \/
  (exists f, op = IoFilePut f stdin "false" \/ op = IoRemoveFile f).
Proof.
  intros ans prog stdin cwd env args op H. unfold spawn_fed in H.
  destruct (seq stdin ""); cbn [nbind nask ntrace] in H.
  - destruct H as [H | []]. left. exists "". symmetry. exact H.
  - destruct H as [H | H]; [right; left; symmetry; exact H |].
    destruct (fst (ans (IoTempNew "pantheon-in" ".txt"))); cbn [negb ntrace] in H; [| destruct H].
    set (f := ans_one (ans (IoTempNew "pantheon-in" ".txt"))) in H.
    destruct H as [H | H]; [right; right; exists f; left; symmetry; exact H |].
    destruct (fst (ans (IoFilePut f stdin "false"))); cbn [nbind nask ntrace] in H.
    + destruct H as [H | [H | []]]; [left; exists f | right; right; exists f; right]; symmetry; exact H.
    + destruct H as [H | []]. right; right. exists f. right. symmetry. exact H.
Qed.

(** ---- a program run to its end ---- *)

(** one that started leaves nothing behind: its start, reads of its pipe,
    the pipe closed, the process waited for, and nothing else *)
Theorem exec_leaves_nothing : forall fuel ans prog stdin env args pid pipe,
  fst (nresult ans (spawn_fed prog stdin "" env args)) = true ->
  ans_list (nresult ans (spawn_fed prog stdin "" env args)) = [pid, pipe] ->
  exists n, ntrace ans (exec_go fuel prog stdin env args) =
    ntrace ans (spawn_fed prog stdin "" env args) ++ repeat (IoSockRead pipe) n ++ [IoSockClose pipe, IoWaitPid pid].
Proof.
  intros fuel ans prog stdin env args pid pipe Hf Hl. unfold exec_go. rewrite ntrace_nbind. cbv beta.
  rewrite Hf, Hl. rewrite ntrace_nbind. destruct (read_out_reads fuel ans pipe []) as [n Hn].
  exists n. rewrite Hn. reflexivity.
Qed.

(** one that couldn't start: nothing more, not found, and why *)
Theorem exec_failed_start_ends : forall fuel ans prog stdin env args,
  fst (nresult ans (spawn_fed prog stdin "" env args)) = false ->
  ntrace ans (exec_go fuel prog stdin env args) = ntrace ans (spawn_fed prog stdin "" env args) /\
  nresult ans (exec_go fuel prog stdin env args) = ans_data false [ans_one (nresult ans (spawn_fed prog stdin "" env args))].
Proof.
  intros fuel ans prog stdin env args Hf. unfold exec_go. rewrite ntrace_nbind, nresult_nbind. cbv beta.
  rewrite Hf. split; [apply app_nil_r | reflexivity].
Qed.

(** it succeeded only when it started and its wait said it exited with 0 *)
Theorem exec_ok_only_on_exit_0 : forall fuel ans prog stdin env args,
  fst (nresult ans (exec_go fuel prog stdin env args)) = true ->
  exists pid pipe, fst (nresult ans (spawn_fed prog stdin "" env args)) = true /\
    ans_list (nresult ans (spawn_fed prog stdin "" env args)) = [pid, pipe] /\
    ans_list (ans (IoWaitPid pid)) = ["exit", "0"].
Proof.
  intros fuel ans prog stdin env args H. unfold exec_go in H. rewrite nresult_nbind in H. cbv beta in H.
  destruct (fst (nresult ans (spawn_fed prog stdin "" env args))) eqn:Hf; [| discriminate H].
  destruct (ans_list (nresult ans (spawn_fed prog stdin "" env args))) as [| pid [| pipe [| x rest]]] eqn:Hl; try (cbn in H; discriminate H).
  exists pid, pipe. split; [reflexivity | split; [reflexivity |]].
  rewrite nresult_nbind in H. cbn [nbind nask nresult] in H. unfold exited_ok in H. cbn [fst ans_data] in H.
  destruct (ans_list (ans (IoWaitPid pid))) as [| how [| c [| y more]]]; try (cbn in H; discriminate H).
  apply Bool.andb_true_iff in H as [H1 H2].
  apply Stdlib.Strings.String.eqb_eq in H1, H2. subst. reflexivity.
Qed.

(** ---- git ---- *)

(** git's environment has none of the host's own GIT_ entries: each is
    one asked for, one of the fixed three, or the host's without GIT_ *)
Theorem git_env_keeps_host_git_out : forall extra env kv,
  In kv (git_env extra env) ->
  In kv extra \/ In kv ["GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL=/dev/null", "GIT_TERMINAL_PROMPT=0"]
  \/ (In kv env /\ starts "GIT_" kv = false).
Proof.
  intros extra env kv H. unfold git_env in H. apply List.in_app_or in H as [H | H]; [left; exact H |].
  apply List.in_app_or in H as [H | H]; [right; left; exact H |].
  apply List.filter_In in H as [H1 H2]. right; right. split; [exact H1 | destruct (starts "GIT_" kv); [discriminate H2 | reflexivity]].
Qed.

(** git runs only as "git", from where the binary is, with the fixed
    config flags and that environment, its input (if any) from a file
    made for it and removed; the rest of it is reading its pipe, closing
    it and waiting *)
Theorem git_runs_only_git : forall ans dir stdin extra args op,
  In op (ntrace ans (git_prog dir stdin extra args)) ->
  op = IoEnvEntries \/
  (exists f, op = IoSpawn "git" f "" (git_env extra (ans_list (ans IoEnvEntries))) (git_args dir args)) \/
  op = IoTempNew "pantheon-in" ".txt" \/
  (exists x, op = IoFilePut x stdin "false" \/ op = IoRemoveFile x \/
             op = IoSockRead x \/ op = IoSockClose x \/ op = IoWaitPid x).
Proof.
  intros ans dir stdin extra args op H. unfold git_prog, exec_prog in H. cbn [nbind nask ntrace] in H.
  destruct H as [H | H]; [left; symmetry; exact H |]. unfold exec_go in H.
  rewrite ntrace_nbind in H. apply List.in_app_or in H as [H | H].
  - apply spawn_fed_ops in H as [[f H] | [H | [x [H | H]]]].
    + right; left. exists f. exact H.
    + right; right; left. exact H.
    + right; right; right. exists x. left. exact H.
    + right; right; right. exists x. right; left. exact H.
  - right; right; right. cbv beta in H.
    set (s := nresult ans (spawn_fed "git" stdin "" (git_env extra (ans_list (ans IoEnvEntries))) (git_args dir args))) in H.
    destruct (fst s); [| destruct H].
    destruct (ans_list s) as [| pid [| pipe [| x rest]]]; [destruct H | destruct H | | destruct H].
    rewrite ntrace_nbind in H. apply List.in_app_or in H as [H | H].
    + destruct (read_out_reads exec_fuel ans pipe []) as [n Hn]. rewrite Hn in H. apply List.repeat_spec in H.
      exists pipe. right; right; left. exact H.
    + cbn [ntrace] in H. destruct H as [H | [H | []]]; [exists pipe; right; right; right; left | exists pid; right; right; right; right]; symmetry; exact H.
Qed.
