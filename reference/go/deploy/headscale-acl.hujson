// Headscale ACL for a Pantheon deployment. Tag each of the four hosts tag:pantheon.
// Only CometBFT's authenticated p2p port is open between them, and Prometheus only
// to a monitor. RPC stays on 127.0.0.1, because the wrapper is on the same host.
{
  "tagOwners": {
    "tag:pantheon": ["group:operators"],
    "tag:pantheon-monitor": ["group:operators"]
  },
  "groups": {
    "group:operators": []
  },
  "acls": [
    { "action": "accept", "src": ["tag:pantheon"], "dst": ["tag:pantheon:26656"] },
    { "action": "accept", "src": ["tag:pantheon-monitor"], "dst": ["tag:pantheon:26660"] }
  ]
}
