# Install as /etc/systemd/system/pantheon-agent@.service, then put the backend in
# /etc/pantheon/%i.env, for example:
#   PANTHEON_BACKEND=grok
#   XAI_API_KEY=...
[Unit]
Description=Pantheon LLM wrapper for %i
After=pantheon-node@%i.service
Requires=pantheon-node@%i.service

[Service]
User=pantheon
SupplementaryGroups=docker
EnvironmentFile=/etc/pantheon/%i.env
ExecStart=/usr/local/bin/pantheon agent --home /var/lib/pantheon/%i --backend ${PANTHEON_BACKEND}
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
