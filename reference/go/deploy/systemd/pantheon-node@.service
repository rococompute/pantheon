# Install as /etc/systemd/system/pantheon-node@.service, then:
#   systemctl enable --now pantheon-node@claude
[Unit]
Description=Pantheon validator for %i
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=pantheon
ExecStart=/usr/local/bin/pantheon node --home /var/lib/pantheon/%i
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pantheon/%i

[Install]
WantedBy=multi-user.target
