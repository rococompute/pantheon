(** What app/cli.soma's pure pieces compute, checked whenever app/cli.soma is
    built: paths as OCaml's Filename gives them, the commands' argument
    parsing as the old shell's did it, and JSON as Yojson.Safe prints it. *)

Example path_as_filename_concat :
  path "a" "b" = "a/b" /\ path "a/" "b" = "a/b" /\ path "" "b" = "b" /\ path "/" "b" = "/b".
Proof. repeat split; computed. Qed.

Example basename_as_filename :
  basename "a/b" = "b" /\ basename "a/b/" = "b" /\ basename "b" = "b" /\ basename "/" = "/"
  /\ basename "" = "." /\ basename "net/claude//" = "claude".
Proof. repeat split; computed. Qed.

Example split_on_as_ocaml :
  split_on ","%char "a=b,c=d" = ["a=b", "c=d"] /\ split_on ","%char "" = [""]
  /\ split_on "="%char "a=" = ["a", ""] /\ split_on ","%char ",x," = ["", "x", ""].
Proof. repeat split; computed. Qed.

Example sorted_by_bytes :
  sort_strings ["muse", "claude", "grok", "codex"] = ["claude", "codex", "grok", "muse"]
  /\ sort_strings ["b", "B", "a", "ab"] = ["B", "a", "ab", "b"].
Proof. repeat split; computed. Qed.

Example kv_arg_splits_at_the_first :
  kv_arg "--param" "a=b=c" = inl ("a", "b=c") /\ kv_arg "--param" "a=" = inl ("a", "")
  /\ kv_arg "--repo" "calc" = inr "--repo wants name=value, got calc".
Proof. repeat split; computed. Qed.

Example keygen_args_as_before :
  keygen_args ["h", "--name", "n", "--addr", "a:1"] "" "" "" = inl ("h", "n", "a:1")
  /\ keygen_args ["--addr", "a:1", "h", "--name", "n"] "" "" "" = inl ("h", "n", "a:1")
  /\ keygen_args ["h", "x"] "" "" "" = inr "unknown keygen argument x"
  (* a flag with no value is taken as the home, as the OCaml match did *)
  /\ keygen_args ["--name"] "" "" "" = inl ("--name", "", "").
Proof. repeat split; computed. Qed.

Example up_args_as_before :
  up_args ["--backends", "claude=claude,muse=scripted", "--bid-window", "6"] [] []
    = inl ([("claude", "claude"), ("muse", "scripted")], ["--bid-window", "6"])
  /\ up_args ["--backends", "claude"] [] [] = inr "--backends wants agent=backend,..."
  /\ up_args ["--backends"] [] [] = inl ([], ["--backends"]).
Proof. repeat split; computed. Qed.

Example init_args_as_before :
  match init_parse ["d", "--repo", "calc=src", "--block-ms", "200", "--param", "a=b"]
          {| ia_dir := ""; ia_repos := []; ia_port := 26700; ia_params := []; ia_block_ms := 500; ia_allow_closed := false |} with
  | inl a => ia_dir a = "d" /\ ia_repos a = [("calc", "src")] /\ ia_port a = 26700
             /\ ia_params a = [("a", "b")] /\ ia_block_ms a = 200
  | inr _ => False
  end.
Proof. cbn. repeat split; reflexivity. Qed.

Example init_refuses_as_before :
  init_parse ["d", "e"] {| ia_dir := ""; ia_repos := []; ia_port := 0; ia_params := []; ia_block_ms := 0; ia_allow_closed := false |}
    = inr "unknown init argument e"
  /\ init_parse ["--base-port", "x"] {| ia_dir := ""; ia_repos := []; ia_port := 0; ia_params := []; ia_block_ms := 0; ia_allow_closed := false |}
    = inr "--base-port wants a number, got x".
Proof. split; computed. Qed.

Example json_as_yojson_prints :
  json_text (JObj [("block_ms", JNum "500"), ("params", JObj []), ("s", JStr "a""b\"),
                   ("l", JList [JNull, JBool "true", JList []])])
    = "{""block_ms"":500,""params"":{},""s"":""a\""b\\"",""l"":[null,true,[]]}".
Proof. computed. Qed.

Example json_reads_tokens :
  json_value 30 ["A", "2", "a", "I", "1", "b", "L", "2", "S", "x", "U"]
    = Some (JObj [("a", JNum "1"), ("b", JList [JStr "x", JNull])], []).
Proof. computed. Qed.

Example key_text_sorts_members :
  key_text (JObj [("size", JNum "2048"), ("n", JStr "ab"), ("e", JStr "01")])
    = "{""e"":""01"",""n"":""ab"",""size"":2048}".
Proof. computed. Qed.

Example stamp_as_seconds_and_microseconds :
  stamp_text "1794540934705916" = "1794540934.705916".
Proof. computed. Qed.

Example repo_urls_as_before :
  repo_url "/net" "src" = "/net/src" /\ repo_url "/net" "/abs" = "/abs"
  /\ repo_url "/net" "https://h/r" = "https://h/r" /\ repo_url "/net" "git@h:r" = "git@h:r"
  /\ repo_url "/net" "git@" = "/net/git@".
Proof. repeat split; computed. Qed.

Example node_flags_as_before :
  node_flags ["--backend", "claude", "--goal", "g.txt", "--ci-repo", "a", "make", "--ci-repo", "b", "dune",
              "--no-check", "a", "--no-check", "b", "--bid-window", "6", "--max-llm-calls", "007"]
             node_flag_defaults [] [] []
    = inl (put "max_calls" "7" (put "backend" "claude" node_flag_defaults),
           [["goal_file", "g.txt"], ["agent", "bid_window", "6"]],
           [("b", "dune"), ("a", "make")], ["b", "a"])
  /\ node_flags ["--bogus"] [] [] [] [] = inr "unknown node flag --bogus"
  (* --ci-repo takes two values: with one it isn't a flag *)
  /\ node_flags ["--ci-repo", "x"] [] [] [] [] = inr "unknown node flag --ci-repo"
  /\ node_flags ["--max-llm-calls", "x"] [] [] [] [] = inr "--max-llm-calls wants a number, got x".
Proof. repeat split; computed. Qed.

Example env_value_as_getenv :
  env_value "PANTHEON_BYZ" ["HOME=/h", "PANTHEON_BYZ=silent", "PANTHEON_BYZ=x"] = "silent"
  /\ env_value "PANTHEON_BYZ" ["PANTHEON_BYZANTINE=1"] = "" /\ env_value "A" ["A="] = "".
Proof. repeat split; computed. Qed.

Example image_strings_quote :
  soma_strings ["a""b", ""] = "[""a""""b"", """"]".
Proof. computed. Qed.

Example fallback_help_succeeds :
  cli_fallback_of [] = FallbackHelp
  /\ cli_fallback_of ["help"] = FallbackHelp
  /\ cli_fallback_of ["--help"] = FallbackHelp
  /\ cli_fallback_of ["-h"] = FallbackHelp
  /\ cli_fallback_of ["help", "status"] = FallbackHelp.
Proof. repeat split; reflexivity. Qed.

Example fallback_unknown_command_stops :
  cli_fallback_of ["bogus"] = FallbackUsage "unknown command ""bogus"" (run `pantheon help` for the commands)"
  /\ cli_fallback_of ["bogus", "home"] = FallbackUsage "unknown command ""bogus"" (run `pantheon help` for the commands)".
Proof. split; computed. Qed.

Example fallback_wrong_arguments_stops :
  cli_fallback_of ["status"] = FallbackUsage "pantheon status: wrong arguments (run `pantheon help` for usage)"
  /\ cli_fallback_of ["status", "home", "extra"] =
       FallbackUsage "pantheon status: wrong arguments: [""home"", ""extra""] (run `pantheon help` for usage)"
  /\ cli_fallback_of ["node"] = FallbackUsage "pantheon node: wrong arguments (run `pantheon help` for usage)"
  /\ cli_fallback_of ["service", "home"] =
       FallbackUsage "pantheon service: wrong arguments: [""home""] (run `pantheon help` for usage)".
Proof. repeat split; computed. Qed.

(** [up] waits for exactly the nodes it started, in order, and only after
    an interrupt or a terminate is set to stop them all *)
Theorem up_waits_for_what_it_started : forall ans pids,
  ntrace ans (up_wait pids) = IoStopOnSignal pids :: map IoWaitPid pids.
Proof.
  intros ans pids. unfold up_wait, cli_do. cbn [ntrace]. f_equal.
  induction pids as [| p r IH]; cbn; [reflexivity | f_equal; exact IH].
Qed.

Example genesis_numbers_are_checked_before_conversion :
  genesis_param_valid "merge_approvals" "one" = false /\
  genesis_param_valid "reveal_window" "-5" = false /\
  genesis_param_valid "term_blocks" "12x" = false /\
  genesis_param_valid "term_blocks" "9999999999999999999" = false /\
  genesis_param_valid "merge_approvals" "0" = true /\
  genesis_param_valid "term_blocks" "007" = true /\
  genesis_param_valid "block_ms" "0" = false /\
  genesis_param_valid "block_ms" "300" = true /\
  genesis_param_valid "label" "two words" = true.
Proof. repeat split; computed. Qed.

Example genesis_network_rejects_malformed_known_numbers :
  genesis_network_error (JObj [("block_ms", JNum "-1")]) =
    Some "block_ms is a positive decimal integer of at most 18 digits" /\
  genesis_network_error (JObj [("block_ms", JStr "200")]) =
    Some "block_ms is a positive decimal integer of at most 18 digits" /\
  genesis_network_error (JObj [("params", JObj [("merge_approvals", JNum "1")])]) =
    Some "parameter merge_approvals must be a string; known numeric parameters require 1 to 18 decimal digits (block_ms is positive)" /\
  genesis_network_error (JObj [("params", JObj [("label", JStr "two words"), ("finish", JStr "1")])]) = None /\
  node_flags ["--bid-window", "one"] [] [] [] [] = inr "--bid-window wants a number, got one".
Proof. repeat split; computed. Qed.
