(** The market: n agents take turns as term leader. The leader posts tasks,
    the others bid patches, and a merge lands when n - (n-1)/3 approve. Up to
    max_open_tasks tasks are open at once, each with its own bids and its own
    record of rejections.

    The market governs git repositories, and holds no file contents: only each
    repository's head tree and, for each path, the version that last changed
    it. A task names a repository. A bid is a list of edits against a version:
    each replaces one exact, unique piece of a file, writes a whole file, or
    deletes one. A bid may be made on any version so far: a pending bid whose
    paths a merge changes stays pending, marked stale, since its edits may
    still apply line by line; one that writes or deletes a whole changed file
    is cleared, since it would undo the merge. Whether they do is the merge check's call: the
    leader clears one whose edits no longer apply (conflict), which isn't a
    rejection, and its bidder writes an updated bid. Attestors apply the edits to the head, and a yes names the tree
    they got. The leader's merge names the tree its own check gave, and an
    attestor's yes counts only for that same tree. A merge needs merge_quorum
    approvals (market.proof): genesis's merge_approvals (1 is the leader
    alone), or by default n-f of the agents whose scope has the repository,
    of which the leader and bidder supply at most two. Every node then checks its own
    checkout reaches it.

    The next leader is drawn from values each agent committed to at genesis:
    the tip of a hash chain, H^K(s). For each term, an agent reveals the
    previous link, which only it can compute. Revealing is all an agent
    controls: a value is fixed in advance, and an agent that withholds it can't
    be drawn. Withholding still lets the last agent to reveal choose between two
    seeds, so an agent that held back in one draw is barred from the next: a
    recent leader can't steer a draw now and be repaid with a term later. *)
Import util shell.
From Stdlib Require Import Ascii.

(** ---- A signed transaction (step 5: decode_tx in Soma) ----
    Its fields [agent; nonce; type; args...], or [] when it's over the byte
    cap, not bounded JSON (depth 4), not a transaction's JSON, its nonce
    isn't 1 to 17 digits, or its signature doesn't verify against the
    genesis key of its agent. The same on every node, given one genesis.
    The shell only reads the JSON's members and checks the signature. *)
Fixpoint digits_only (fuel : nat) (s : string) (i : nat) : bool :=
  match fuel with
  | 0 => true
  | Succ f =>
      match char_at s i with
      | None => true
      | Some c => let n := nat_of_ascii c in if (48 <=? n) && (n <=? 57) then digits_only f s (Succ i) else false
      end
  end.

nonce_ok (s : string) : bool := negb (seq s "") && (slen s <? 18) && digits_only (slen s) s 0.

(** within the byte cap, and bounded JSON; the caps are decimal strings *)
tx_shape_ok (cap items raw : string) : bool :=
  if num cap <? slen raw then false else shallow_json "4" items raw.

(** the parts once read: a nonce that isn't digits is refused before the
    signature is checked *)
tx_decision (parts : option (string * (string * (list string * string))))
    (verified : string -> string -> list string -> string -> bool) : list string :=
  match parts with
  | None => []
  | Some (agent, rest) =>
      let (nonce, more) := rest in
      let (fields, sg) := more in
      if nonce_ok nonce then (if verified agent nonce fields sg then agent :: nonce :: fields else []) else []
  end.

decode_tx (raw : string) : list string :=
  if tx_shape_ok (tx_byte_cap tt) (tx_item_cap tt) raw then tx_decision (tx_parts raw) tx_verify else [].

Inductive status := Pending | Merged | Cleared | Rejected | Withdrawn.
Scheme Boolean Equality for status.

status_name (s : status) : string :=
  match s with
  | Pending => "pending" | Merged => "merged" | Cleared => "cleared"
  | Rejected => "rejected" | Withdrawn => "withdrawn"
  end.

is_pending (s : status) : bool := status_beq s Pending.

(** a task in a repository, with paths a model without tools should read *)
Record task := { tid : nat; spec : string; poster : string; posted_at : nat; topen : bool;
                 trepo : string; tctx : list string }.

(** One edit. eold <> "": replace the one place eold appears in the file with
    enew. eold = "": write the whole file, enew; with enew = "" too, delete it. *)
Record edit := { epath : string; eold : string; enew : string }.

Record bid := { bidn : nat; btask : nat; bidder : string; base : nat; edits : list edit;
                note : string; bst : status; stale : bool; why : string;
                votes : list (string * bool) }.

(** a merge waiting for attestations; ptree is the tree the leader's check gave *)
Record proposal := { pbid : nat; pby : string; pat : nat; pvotes : list (string * bool); ptree : string }.

Fixpoint triples (l : list string) : list edit :=
  match l with p :: o :: n :: r => {| epath := p; eold := o; enew := n |} :: triples r | _ => [] end.

flat_edits (es : list edit) : list string := flat_map (fun e => [epath e, eold e, enew e]) es.

edit_paths (es : list edit) : list string := nodup_s (map epath es).

(** The market's state, an object (see util.soma). *)
agents (m : obj) : list string := getf m "agents".
mheight (m : obj) : nat := getf m "h".
term (m : obj) : nat := getf m "term".
leader (m : obj) : string := getf m "leader".
history (m : obj) : list string := getf m "history".
tstart (m : obj) : nat := getf m "tstart".
active (m : obj) : nat := getf m "active".
merges (m : obj) : nat := getf m "merges".
awaiting (m : obj) : bool := getf m "awaiting".
asince (m : obj) : nat := getf m "asince".
reveals (m : obj) : list (string * string) := getf m "reveals".
(** who didn't reveal in the last draw *)
held_back (m : obj) : list string := getf m "held_back".
tips (m : obj) : list (string * string) := getf m "tips".
version (m : obj) : nat := getf m "version".
(** repository -> its head tree *)
repos (m : obj) : list (string * string) := getf m "repos".
(** "repo:path" -> the version that last changed it *)
paths (m : obj) : list (string * nat) := getf m "paths".
tasks (m : obj) : list task := getf m "tasks".
bids (m : obj) : list bid := getf m "bids".
(** how many bids there have ever been: a bid's number, which pruning settled
    bids (prune) must not make the next bid reuse *)
nbids (m : obj) : nat := getf m "nbids".
pending (m : obj) : option proposal := getf m "pending".
nonces (m : obj) : list (string * nat) := getf m "nonces".
lastbid (m : obj) : list (string * nat) := getf m "lastbid".
counters (m : obj) : list (string * nat) := getf m "counters".
params (m : obj) : list (string * nat) := getf m "params".
(** (agent, repository) pairs from genesis: the repository is outside the
    agent's scope, as its part says ("exclude"). Its node doesn't check that
    repository's bids, so the agent doesn't bid on, post, merge, mark or
    attest them, and a merge there needs a quorum of the agents whose scope
    has it. Empty unless genesis says *)
excluded (m : obj) : list (string * string) := getf m "excluded".
excludes (m : obj) (a r : string) : bool := existsb (fun x => seq (fst x) a && seq (snd x) r) (excluded m).
(** the agents whose scope has repository r: all of them unless genesis excludes some *)
scope (m : obj) (r : string) : list string := filter (fun a => negb (excludes m a r)) (agents m).
in_scope (m : obj) (a : string) (t : task) : bool := negb (excludes m a (trepo t)).

(** Parameters, set at genesis. Block counts. *)
default_params : list (string * nat) :=
  [("term_blocks", 300), ("max_merges", 2), ("stall_blocks", 120), ("attest_window", 120),
   ("fallback_blocks", 60),
   (* tasks open at once: the leader drafts another while fewer are open, when
      it judges one can run beside them (agent.soma); 1 unless genesis says *)
   ("max_open_tasks", 1), ("max_pending_bids", 3), ("bid_cooldown", 5),
   (* approvals a merge or a mark needs, the leader's proposal counting as
      one: 1 is the leader alone, its own check and pick, landing in the block
      it's proposed in; 0 (the default) is n-f of the agents whose scope has
      the repository, every other one an attestor's yes on the same tree *)
   ("merge_approvals", 0),
   ("reveal_window", 10), ("max_files", 20), ("keep_settled", 100), ("max_block_txs", 50),
   (* a leader closes a task no bid could do: this many rejected bids, or open
      this many blocks, with no bid pending *)
   ("task_rejects", 6), ("task_blocks", 3600),
   (* a task's two-worker window moves on by one this often, so a chosen
      worker that never bids (out of credit, offline) can't hold a task until
      task_blocks closes it: past a patch request's deadline with room to spare *)
   ("bid_blocks", 2400)].

param (m : obj) (k : string) : nat := get_or (get_or 0 k default_params) k (params m).

new_market (agents : list string) : obj :=
  [("agents", agents : Any), ("h", 0 : Any), ("term", 0 : Any), ("leader", "" : Any),
   ("history", ([] : list string) : Any), ("tstart", 0 : Any), ("active", 0 : Any), ("merges", 0 : Any),
   (* the chain starts between terms, so even term 1 is drawn *)
   ("awaiting", true : Any), ("asince", 0 : Any),
   ("reveals", ([] : list (string * string)) : Any), ("held_back", ([] : list string) : Any), ("tips", ([] : list (string * string)) : Any),
   ("version", 0 : Any), ("repos", ([] : list (string * string)) : Any), ("paths", ([] : list (string * nat)) : Any),
   ("tasks", ([] : list task) : Any), ("bids", ([] : list bid) : Any), ("nbids", 0 : Any), ("pending", (None : option proposal) : Any),
   ("nonces", ([] : list (string * nat)) : Any), ("lastbid", ([] : list (string * nat)) : Any),
   ("counters", ([] : list (string * nat)) : Any), ("params", ([] : list (string * nat)) : Any),
   ("excluded", ([] : list (string * string)) : Any)].

(** Rotate a task's two-worker window through the nonleaders whose scope
    has the task's repository. A worker is
    spent only after it has bid and every one of its bids was rejected or
    cleared: an unstarted worker or a pending bid keeps the window open. *)
bidder_spent (m : obj) (t : task) (a : string) : bool :=
  let bs := filter (fun b => (btask b =? tid t) && seq (bidder b) a) (bids m) in
  negb (length bs =? 0) &&
    forallb (fun b => match bst b with Rejected | Cleared => true | _ => false end) bs.

rotate_bidders (pool : list string) : list string :=
  match pool with [] => [] | a :: rest => rest ++ [a] end.

Fixpoint next_bidders (fuel : nat) (m : obj) (t : task) (pool : list string) : list string :=
  match fuel with
  | 0 => pool
  | Succ f =>
      if forallb (bidder_spent m t) (firstn 2 pool)
      then next_bidders f m t (rotate_bidders pool)
      else pool
  end.

(** version advances on every merge and survives term changes. Consecutive
    task ids therefore move the window even within the same term. The window
    also moves on by one every bid_blocks while the task is open, so workers
    chosen but silent give way to the next ones. *)
bidders_for (m : obj) (t : task) : list string :=
  let pool := filter (fun a => negb (seq a (leader m))) (nodup_s (scope m (trepo t))) in
  let start := (tid t + version m + (mheight m - posted_at t) / param m "bid_blocks") mod length pool in
  let pool := skipn start pool ++ firstn start pool in
  firstn 2 (filter (fun a => negb (seq a (leader m)))
    (next_bidders (length pool) m t pool)).

nonce_of (m : obj) (a : string) : nat := get_or 0 a (nonces m).

count (m : obj) (a k : string) : obj := setf m "counters" (bump (append a (append "." k)) (counters m)).

task_by (m : obj) (id : nat) : option task := find (fun t => tid t =? id) (tasks m).
bid_by (m : obj) (id : nat) : option bid := find (fun b => bidn b =? id) (bids m).

set_bid (m : obj) (b : bid) : obj := setf m "bids" (map (fun x => if bidn x =? bidn b then b else x) (bids m)).

with_status (b : bid) (s : status) (w : string) : bid :=
  {| bidn := bidn b; btask := btask b; bidder := bidder b; base := base b; edits := edits b; note := note b;
     bst := s; stale := stale b; why := w; votes := votes b |}.

with_votes (b : bid) (v : list (string * bool)) : bid :=
  {| bidn := bidn b; btask := btask b; bidder := bidder b; base := base b; edits := edits b; note := note b;
     bst := bst b; stale := stale b; why := why b; votes := v |}.

mark_stale (b : bid) : bid :=
  {| bidn := bidn b; btask := btask b; bidder := bidder b; base := base b; edits := edits b; note := note b;
     bst := bst b; stale := true; why := why b; votes := votes b |}.

is_leader (m : obj) (a : string) : bool := negb (seq (leader m) "") && seq (leader m) a.

pending_bid_id (m : obj) : nat := match pending m with Some p => pbid p | None => 0 end.

open_tasks (m : obj) : list task := filter topen (tasks m).

path_key (r p : string) : string := append r (append ":" p).

(** has the path in repository r changed since version v? *)
changed_since (m : obj) (r : string) (v : nat) (p : string) : bool :=
  match lookup (path_key r p) (paths m) with Some w => v <? w | None => false end.

bid_repo (m : obj) (b : bid) : string := match task_by m (btask b) with Some t => trepo t | None => "" end.

conflicts (m : obj) (b : bid) : bool := existsb (changed_since m (bid_repo m b) (base b)) (edit_paths (edits b)).

(** A whole-file edit (write or delete) on a path changed since the bid's
    version would undo that change: it conflicts, whatever the lines. *)
overwrites (m : obj) (b : bid) : bool :=
  existsb (fun e => seq (eold e) "" && changed_since m (bid_repo m b) (base b) (epath e)) (edits b).

(** A merge: move the repository's head to the attested tree, mark the paths
    it changed, then clear what now conflicts. The shell applies the edits to
    its checkout and checks it reaches that tree. *)
finalize (m : obj) (p : proposal) : obj * list (list string) :=
  match bid_by m (pbid p) with
  | None => (setf m "pending" (None : option proposal), [])
  | Some b =>
      let r := bid_repo m b in
      let spec_of := match task_by m (btask b) with Some t => spec t | None => "" end in
      let v := version m + 1 in
      let ps := fold_left (fun ps x => put (path_key r x) v ps) (edit_paths (edits b)) (paths m) in
      let m := setf (setf (setf m "paths" ps) "version" v) "repos" (put r (ptree p) (repos m)) in
      let m := set_bid m (with_votes (with_status b Merged "") (pvotes p)) in
      let m := setf (setf m "pending" (None : option proposal)) "merges" (merges m + 1) in
      let m := count m (bidder b) "merges" in
      (* a pending bid whose files this changed is marked stale and stays: its
         edits may still apply, line by line; if they don't, the leader's merge
         check finds it and clears it (conflict) *)
      let reason := append "writes or deletes a whole file that bid " (append (show (bidn b)) " changed") in
      let m := fold_left (fun m x =>
                 if is_pending (bst x) && overwrites m x then count (set_bid m (with_status x Cleared reason)) (bidder x) "cleared"
                 else if is_pending (bst x) && conflicts m x then set_bid m (mark_stale x) else m) (bids m) m in
      (m, [("merge" :: r :: show v :: ptree p :: show (bidn b) :: show (btask b) :: bidder b :: spec_of :: flat_edits (edits b))])
  end.

(** Quorums for a roster of n agents, tolerating f = (n-1)/3 faults.
    The leader approves by proposing; the bidder counts after fallback_blocks.
    f+1 no votes make n-f approvals impossible. *)
faults (n : nat) : nat := (n - 1) / 3.
quorum (n : nat) : nat := n - faults n.
reject_quorum (n : nat) : nat := faults n + 1.

(** the roster a merge's quorums count: the agents whose scope has the bid's
    repository (all of them unless genesis excludes some) *)
merge_n (m : obj) (p : proposal) : nat :=
  length (match bid_by m (pbid p) with Some b => scope m (bid_repo m b) | None => agents m end).

merge_quorum (m : obj) (p : proposal) : nat :=
  match param m "merge_approvals" with 0 => quorum (merge_n m p) | k => k end.

approvals (p : proposal) (age fb : nat) : nat :=
  1 + length (filter snd (pvotes p)) + (if (0 <? fb) && (fb <=? age) then 1 else 0).

settle (m : obj) : obj * list (list string) :=
  match pending m with
  | None => (m, [])
  | Some p =>
      let no := length (filter (fun v => negb (snd v)) (pvotes p)) in
      let age := mheight m - pat p in
      let yes := approvals p age (param m "fallback_blocks") in
      if merge_quorum m p <=? yes then finalize m p
      else if reject_quorum (merge_n m p) <=? no then
        match bid_by m (pbid p) with
        | Some b => (count (setf (set_bid m (with_votes (with_status b Rejected "attestors voted no") (pvotes p))) "pending" (None : option proposal)) (bidder b) "rejected", [])
        | None => (setf m "pending" (None : option proposal), [])
        end
      else if param m "attest_window" <=? age then (setf m "pending" (None : option proposal), [])
      else (m, [])
  end.

(** v is the link just before the agent's tip: hashed once, not up to 64
    times, so an agent has one value to reveal in each draw and can't choose
    the seed among older links (docs/SECURITY-REVIEW-2.md P-8; market.proof
    accepted_reveals_for_a_draw_are_equal) *)
next_link (v tip : string) : bool := seq (sha256 v) tip.

(** A leader's mark: when a leader judges a task done, it may put "+ "
    before the plan item's line in the repository's .plan. Leaders don't bid,
    so the mark is a bid of its own: one edit, of that one line, made by the
    leader and proposed for merge at once. It merges like any bid, with the
    attestors' yes on the tree they get; the bidder fallback counts the
    leader; fallback_attestors_must_approve bounds the attestors needed. *)
mark_note : string := "leader's mark: the task is done, so its plan item is marked done in .plan".

mark_edit (line : string) : edit := {| epath := ".plan"; eold := line; enew := append "+ " line |}.

(** One transaction's effect. A string is the reason it failed, "" for none. *)
apply (m : obj) (a : string) (fields : list string) : obj * list (list string) * string :=
  let fail (why : string) := (m, ([] : list (list string)), why) in
  let ok (m : obj) := (m, ([] : list (list string)), "") in
  let lead := is_leader m a in
  match fields with
  | "post" :: rest =>
      (* post SPEC, with one repository; or post REPO SPEC CONTEXT-PATH... *)
      let '(r, s, ctx) := match rest, repos m with
                          | [s], [(r, _)] => (r, s, [])
                          | r :: s :: ctx, _ => (r, s, ctx)
                          | _, _ => ("", "", [])
                          end in
      if negb lead then fail "only the term leader posts tasks"
      else if seq s "" then fail "empty task, or no repository named: post REPO SPEC [CONTEXT-PATH...]"
      else if negb (plain_text s) then fail "a task's spec has a NUL or control character"
      else if negb (existsb (fun x => seq (fst x) r) (repos m)) then fail "no such repository"
      else if excludes m a r then fail "that repository is outside this leader's scope (its genesis part excludes it): a leader whose scope has it posts its tasks"
      else if (8 <? length ctx) || negb (forallb safe_path ctx) then fail "context is up to 8 safe paths"
      else if param m "max_open_tasks" <=? length (open_tasks m) then fail "too many open tasks"
      else
        let id := length (tasks m) + 1 in
        ok (setf m "tasks" (tasks m ++ [{| tid := id; spec := s; poster := a; posted_at := mheight m; topen := true;
                                           trepo := r; tctx := ctx |}]))
  | "bid" :: t :: v :: n :: es =>
      let w := triples es in
      if negb (plain_text n) then fail "a bid's note has a NUL or control character" else
      match task_by m (num t) with
      | None => fail "no such task"
      | Some tk =>
          if negb (topen tk) then fail "task is closed"
          else if lead || seq (leader m) "" then fail "the leader doesn't bid, and nobody bids between terms"
          else if negb (mem a (bidders_for m tk)) then fail "not an eligible bidder for this task: two rotating bidders only"
          else if (0 <? get_or 0 a (lastbid m)) && (mheight m <? get_or 0 a (lastbid m) + param m "bid_cooldown") then fail "bid cooldown"
          else
            let m := setf m "lastbid" (put a (mheight m) (lastbid m)) in
            (* a bid made on any version so far: whether its edits still apply
               on the head is the merge check's call, by the lines they replace,
               not by which files changed since *)
            if version m <? num v then (m, [], "a bid names a version the market hasn't reached")
            else if existsb (fun e => seq (eold e) "" && changed_since m (trepo tk) (num v) (epath e)) w
            then (m, [], "a bid writes or deletes a whole file changed since its version: write it on the head")
            else if (length w =? 0) || negb (length es =? 3 * length w) then (m, [], "a bid's edits come in threes: path, old, new")
            else if (param m "max_files" <? length (edit_paths w)) || (5 * param m "max_files" <? length w) then (m, [], "a bid edits 1 to max_files files, with up to 5 edits each")
            else if negb (forallb (fun e => safe_path (epath e)) w) then (m, [], "unsafe path")
            else if param m "max_pending_bids" <=? length (filter (fun b => seq (bidder b) a && is_pending (bst b)) (bids m)) then (m, [], "too many pending bids")
            else
              let id := nbids m + 1 in
              (* counted first, then the bid appended to that state's bids: the shape
                 market.proof's lemma for an appended bid states *)
              let m := setf m "nbids" id in
              ok (setf m "bids" (bids m ++ [{| bidn := id; btask := tid tk; bidder := a; base := num v; edits := w;
                                               note := n; bst := Pending; stale := false; why := ""; votes := [] |}]))
      end
  | ["withdraw", i] =>
      match bid_by m (num i) with
      | Some b => if seq (bidder b) a && is_pending (bst b) && negb (bidn b =? pending_bid_id m)
                  then ok (set_bid m (with_status b Withdrawn "")) else fail "can't withdraw that bid"
      | None => fail "no such bid"
      end
  | "merge" :: i :: rest =>
      let tree := match rest with [t] => t | _ => "" end in
      match bid_by m (num i) with
      | Some b =>
          if negb lead then fail "only the term leader merges"
          else if seq tree "" then fail "a merge names the tree its edits give on the head: merge BID TREE"
          else if negb (pending_bid_id m =? 0) then fail "a merge is already pending"
          else if param m "max_merges" <=? merges m then fail "merge limit for this term"
          else if negb (is_pending (bst b)) || seq (bidder b) a then fail "not a bid this leader can merge"
          else if excludes m a (bid_repo m b) then fail "the bid's repository is outside this leader's scope (its genesis part excludes it): a leader whose scope has it merges it"
          else ok (setf m "pending" (Some {| pbid := bidn b; pby := a; pat := mheight m; pvotes := []; ptree := tree |}))
      | None => fail "no such bid"
      end
  | "attest" :: i :: yes :: rest =>
      (* attest BID yes TREE, the tree the edits gave on the head; or attest BID no *)
      match pending m, bid_by m (num i) with
      | Some p, Some b =>
          let tree := match rest with [x] => x | _ => "" end in
          if negb (pbid p =? bidn b) then fail "that bid isn't pending merge"
          else if seq a (pby p) || seq a (bidder b) then fail "the leader and the bidder don't attest"
          else if existsb (fun v => seq (fst v) a) (pvotes p) then fail "already attested"
          else if excludes m a (bid_repo m b) then fail "the bid's repository is outside this agent's scope (its genesis part excludes it): it doesn't attest there"
          else if seq yes "yes" && seq tree "" then fail "a yes names the tree it checked: attest BID yes TREE"
          else
            (* a yes for another tree than the leader's counts as a no *)
            let agree := seq yes "yes" && seq (ptree p) tree in
            let p := {| pbid := pbid p; pby := pby p; pat := pat p; pvotes := (a, agree) :: pvotes p; ptree := ptree p |} in
            let note := if seq yes "yes" && negb agree then [["log", append a (append "'s yes named another tree than the leader's, " (ptree p))]] else [] in
            let '(m, o) := settle (setf m "pending" (Some p)) in (m, o ++ note, "")
      | _, _ => fail "nothing to attest"
      end
  | ["mark", t, line, tree] =>
      match task_by m (num t) with
      | None => fail "no such task"
      | Some tk =>
          if negb lead then fail "only the term leader marks a task done"
          else if negb (topen tk) then fail "task is closed"
          else if excludes m a (trepo tk) then fail "the task's repository is outside this leader's scope (its genesis part excludes it)"
          else if seq tree "" then fail "a mark names the tree its edit gives on the head: mark TASK LINE TREE"
          else if negb (pending_bid_id m =? 0) then fail "a merge is already pending"
          else if seq line "" || negb (plain_text line) || contains newline line then fail "a mark names one line of .plan, as it is there"
          else if marked_line line || starts "#" line then fail "that line is a note or already marked"
          else
            let id := nbids m + 1 in
            (* the bid appended last, the shape market.proof's lemma for an
               appended bid states *)
            let m := setf (setf m "nbids" id) "pending" (Some {| pbid := id; pby := a; pat := mheight m; pvotes := []; ptree := tree |}) in
            ok (setf m "bids" (bids m ++ [{| bidn := id; btask := tid tk; bidder := a; base := version m; edits := [mark_edit line];
                                             note := mark_note; bst := Pending; stale := false; why := ""; votes := [] |}]))
      end
  | ["reject", i, why] =>
      if negb (plain_text why) then fail "a rejection's reason has a NUL or control character" else
      match bid_by m (num i) with
      | Some b => if lead && is_pending (bst b) && negb (bidn b =? pending_bid_id m)
                  then ok (count (set_bid m (with_status b Rejected why)) (bidder b) "rejected") else fail "can't reject that bid"
      | None => fail "no such bid"
      end
  (* conflict BID: its edits no longer apply to the head (a merge since
     replaced the lines they replace). Not a rejection: the bid did nothing
     wrong, and its bidder writes an updated one *)
  | ["conflict", i] =>
      match bid_by m (num i) with
      | Some b => if lead && is_pending (bst b) && negb (bidn b =? pending_bid_id m)
                  then ok (count (set_bid m (with_status b Cleared "its edits no longer apply to the head: a merge since changed the lines they replace")) (bidder b) "cleared")
                  else fail "can't clear that bid"
      | None => fail "no such bid"
      end
  | ["close", t] =>
      match task_by m (num t) with
      | Some tk =>
          if negb lead || negb (topen tk) then fail "can't close that task"
          else if existsb (fun b => (bidn b =? pending_bid_id m) && (btask b =? tid tk)) (bids m) then fail "task has a merge in progress"
          else
            let m := setf m "tasks" (map (fun x => if tid x =? tid tk then {| tid := tid x; spec := spec x; poster := poster x; posted_at := posted_at x; topen := false;
                                                                             trepo := trepo x; tctx := tctx x |} else x) (tasks m)) in
            ok (fold_left (fun m b => if (btask b =? tid tk) && is_pending (bst b) then count (set_bid m (with_status b Cleared "task closed")) (bidder b) "cleared" else m) (bids m) m)
      | None => fail "no such task"
      end
  | ["reveal", v] =>
      if negb (awaiting m) then fail "no draw under way"
      else if existsb (fun r => seq (fst r) a) (reveals m) then fail "already revealed"
      else if negb (next_link v (get_or "" a (tips m))) then fail "not a link of this agent's hash chain"
      else ok (setf (setf m "reveals" (reveals m ++ [(a, v)])) "tips" (put a v (tips m)))
  | _ => fail "unknown transaction"
  end.

(** Who may win a draw: those who revealed, minus anyone who held back in the
    last draw, then minus the last two leaders. Each step is skipped if it
    would leave no one. Pure on lists, so market.proof reasons about it
    directly. *)
draw_pool (revealed held recent latest : list string) : list string :=
  let fresh := match filter (fun a => negb (mem a held)) revealed with [] => revealed | l => l end in
  match filter (fun a => negb (mem a recent)) fresh with
  | [] => match filter (fun a => negb (mem a latest)) fresh with [] => fresh | l => l end
  | l => l
  end.

revealed (m : obj) : list string := filter (fun a => existsb (fun r => seq (fst r) a) (reveals m)) (agents m).

eligible (m : obj) : list string :=
  draw_pool (revealed m) (held_back m) (last_n 2 (history m)) (last_n 1 (history m)).

(** The draw waits for all n reveals, or for n-f once reveal_window blocks
    have passed. The seed hashes the reveals in agent order, so no proposer
    can choose among them. *)
maybe_draw (m : obj) : obj :=
  let n := length (reveals m) in
  if awaiting m && ((n =? length (agents m)) || ((quorum (length (agents m)) <=? n) && (asince m + param m "reveal_window" <=? mheight m))) then
    let el := eligible m in
    let seed := hash_list (map (fun a => get_or "" a (reveals m)) (agents m)) in
    let l := nth (hexnum seed 12 0 mod length el) el "" in
    let held := filter (fun a => negb (mem a (revealed m))) (agents m) in
    let m := fold_left (fun m a => count m a "held_back") held (setf m "held_back" held) in
    let m := setf (setf (setf m "leader" l) "term" (term m + 1)) "history" (last_n 8 (history m ++ [l])) in
    let m := setf (setf (setf m "tstart" (mheight m)) "active" (mheight m)) "merges" 0 in
    count (setf (setf m "awaiting" false) "reveals" ([] : list (string * string))) l "led"
  else m.

(** A term ends after term_blocks, after max_merges, or when its leader has
    done nothing for stall_blocks while bids wait or no task is open, both
    within its scope: bids on a repository outside it wait for a leader whose
    scope has it, and don't count against this one. A pending merge
    finishes first. *)
maybe_end_term (m : obj) : obj :=
  if awaiting m || negb (pending_bid_id m =? 0) then m else
  let idle := param m "stall_blocks" <=? mheight m - active m in
  let waiting := existsb (fun b => is_pending (bst b) && negb (excludes m (leader m) (bid_repo m b))) (bids m) in
  let stalled := idle && (waiting || (length (filter (in_scope m (leader m)) (open_tasks m)) =? 0)) in
  if (param m "term_blocks" <=? mheight m - tstart m) || (param m "max_merges" <=? merges m) || stalled then
    let m := if stalled && waiting then count m (leader m) "stalls" else m in
    setf (setf (setf m "leader" "") "awaiting" true) "asince" (mheight m)
  else m.

(** Settled bids past keep_settled leave the state; the blocks keep them. *)
prune (m : obj) : obj :=
  let settled := filter (fun b => negb (is_pending (bst b))) (bids m) in
  let drop := length settled - param m "keep_settled" in
  let old := map bidn (firstn drop settled) in
  setf m "bids" (filter (fun b => negb (existsb (fun i => i =? bidn b) old)) (bids m)).

(** A block: each transaction in order, then the end-of-block rules. A
    transaction only counts at its sender's next nonce; any that does, even
    a failing one, uses the nonce up, so it can't be replayed later. *)
apply_block (m : obj) (h : nat) (txs : list string) : obj * list (list string) :=
  let m := setf m "h" h in
  let '(m, outs) := fold_left (fun acc raw =>
      let '(m, outs) := acc in
      match decode_tx raw with
      | a :: n :: fields =>
          if num n =? nonce_of m a + 1 then
            let m := setf m "nonces" (put a (num n) (nonces m)) in
            let '(m', o, why) := apply m a fields in
            let m' := if seq why "" && is_leader m' a then setf m' "active" h else m' in
            let note := if seq why "" then [] else [["log", append a (append ": " why)]] in
            (m', outs ++ o ++ note)
          else (m, outs)
      | _ => (m, outs)
      end) txs (m, []) in
  let '(m, o) := settle m in
  (prune (maybe_draw (maybe_end_term m)), outs ++ o).

(** What goes in a block: at most one transaction per agent, at its next
    nonce, and at most max_block_txs. Honest validators refuse any other block. *)
Fixpoint pick (m : obj) (pool : list string) (taken : list string) (k : nat) : list string :=
  match k, pool with
  | 0, _ => []
  | _, [] => []
  | Succ k', raw :: rest =>
      match decode_tx raw with
      | a :: n :: _ => if negb (mem a taken) && (num n =? nonce_of m a + 1)
                       then raw :: pick m rest (a :: taken) k' else pick m rest taken k
      | _ => pick m rest taken k
      end
  end.

build_block (m : obj) (pool : list string) : list string := pick m pool [] (param m "max_block_txs").

block_ok (m : obj) (txs : list string) : bool :=
  (length (pick m txs [] (length txs + 1)) =? length txs) && (length txs <=? param m "max_block_txs").

(** Status lines for people and for `pantheon status`. *)
status_lines (m : obj) : list string :=
  [append "height " (append (show (mheight m)) (append "  term " (append (show (term m)) (append "  leader " (if seq (leader m) "" then "(drawing)" else leader m))))),
   append "version " (show (version m)),
   append "history " (fold_left (fun s a => append s (append " " a)) (history m) "")]
  ++ map (fun r => append "repo " (append (fst r) (append " " (snd r)))) (repos m)
  ++ map (fun t => append "task " (append (show (tid t)) (append (if topen t then " [open] " else " [closed] ") (append (trepo t) (append ": " (spec t)))))) (tasks m)
  ++ map (fun b => append "bid " (append (show (bidn b)) (append " [" (append (status_name (bst b)) (append (if stale b then " stale] task " else "] task ")
                    (append (show (btask b)) (append " by " (append (bidder b) (append " " (why b)))))))))) (bids m)
  ++ map (fun c => append "count " (append (fst c) (append " " (show (snd c))))) (counters m).
