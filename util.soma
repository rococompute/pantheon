(** Helpers that the consensus, the market and the agent share. *)
From Stdlib Require Import Ascii DecimalString ZArith.
From Corelib Require Floats.SpecFloat Floats.FloatOps.
Require Crypto.

(** An object is a record whose fields are looked up by name, each an [Any].
    It keeps the state machines short: reading a field casts it to the type
    it's used at, and a wrong field is a run-time error, not a static one.
    Turning these into typed records with invariants is a job for proofs. *)
obj : Type := list (string * Any).

Abbreviation SNil := Stdlib.Strings.String.EmptyString.
Abbreviation SCons := Stdlib.Strings.String.String.

seq (a b : string) : bool := Stdlib.Strings.String.eqb a b.

(** ---- strings by offset ----
    Strings extract to OCaml's (ExtrOcamlNativeString), where taking one
    apart as [SCons c r] copies [r], and building one copies too: a walk
    that way is quadratic, and a frame per character unless it's a tail
    call. Long text (files, prompts, a transaction's 256 KB) is read by
    offset instead, or as a list of characters, which extract linearly.
    main.soma extracts [slen], [char_at] and [substr] to OCaml's String
    functions; the standard library can't, as they count in [nat]. *)
slen (s : string) : nat := Stdlib.Strings.String.length s.

(** at most [n] characters of [s] from offset [i]; empty past the end *)
substr (s : string) (i n : nat) : string := Stdlib.Strings.String.substring i n s.

char_at (s : string) (i : nat) : option ascii := Stdlib.Strings.String.get i s.

chars (s : string) : list ascii := Stdlib.Strings.String.list_ascii_of_string s.

of_chars (l : list ascii) : string := Stdlib.Strings.String.string_of_list_ascii l.

Fixpoint rev_onto {A : Type} (l acc : list A) : list A :=
  match l with [] => acc | x :: r => rev_onto r (x :: acc) end.

(** [s] with [f] applied to each character, in one pass *)
map_chars (f : ascii -> ascii) (s : string) : string :=
  of_chars (rev_onto (fold_left (fun acc c => f c :: acc) (chars s) []) []).

(** the first offset from [i] on where [p] starts in [s]. The one-character
    check first keeps the cost near one comparison per offset. *)
Fixpoint find_go (fuel : nat) (p s : string) (i : nat) : option nat :=
  match fuel with
  | 0 => None
  | Succ f =>
      if ((slen p =? 0) || seq (substr s i 1) (substr p 0 1)) && seq (substr s i (slen p)) p
      then Some i else find_go f p s (Succ i)
  end.

find_str (p s : string) (i : nat) : option nat :=
  if slen s <? slen p + i then None else find_go (slen s - slen p - i + 1) p s i.

Fixpoint getf (o : obj) (k : string) : Any :=
  match o with [] => unk | (k', v) :: r => if seq k k' then v else getf r k end.

Fixpoint setf (o : obj) (k : string) (v : Any) : obj :=
  match o with
  | [] => [(k, v)]
  | (k', w) :: r => if seq k k' then (k, v) :: r else (k', w) :: setf r k v
  end.

Fixpoint mem (x : string) (l : list string) : bool :=
  match l with [] => false | y :: r => seq x y || mem x r end.

Fixpoint lookup {A : Type} (k : string) (l : list (string * A)) : option A :=
  match l with [] => None | (k', v) :: r => if seq k k' then Some v else lookup k r end.

Fixpoint put {A : Type} (k : string) (v : A) (l : list (string * A)) : list (string * A) :=
  match l with
  | [] => [(k, v)]
  | (k', w) :: r => if seq k k' then (k, v) :: r else (k', w) :: put k v r
  end.

get_or {A : Type} (d : A) (k : string) (l : list (string * A)) : A :=
  match lookup k l with Some v => v | None => d end.

(** add one to a counter in a list of counters *)
bump (k : string) (l : list (string * nat)) : list (string * nat) := put k (get_or 0 k l + 1) l.

digits (s : string) (acc : nat) : nat :=
  fold_left (fun a c => a * 10 + (nat_of_ascii c - 48)) (chars s) acc.

(** a decimal number; anything that isn't one reads as some number, never fails *)
num (s : string) : nat := digits s 0.

(** at most k characters, every one a decimal digit *)
short_digits (s : string) (k : nat) : bool :=
  (slen s <=? k) && forallb (fun c => (48 <=? nat_of_ascii c) && (nat_of_ascii c <=? 57)) (chars s).

(** A nonempty decimal number from an untrusted message, of up to 18 digits
    (it fits an OCaml int). It's read in one pass: the standard library's
    Nat.of_uint counts up in unary once extracted, so a peer's
    "999999999999999999" would stop the node for good. *)
num_opt (s : string) : option nat :=
  match s with
  | SNil => None
  | _ => if short_digits s 18 then Some (num s) else None
  end.

show (n : nat) : string := to_string n.

(** ---- hashes ----
    SHA-256 is Soma's (Soma.Crypto): the kernel computes it, and it runs
    as OCaml with no library, so a unikernel hashes as the binary does.
    [simpl never]: a proof about a hash keeps it as a hash. *)
sha256 (s : string) : string := Crypto.sha256 s.

(** the hex SHA-256 of the strings, each as its decimal length, ":" and
    itself, so that the hash is unambiguous about where each one ends *)
hash_list (l : list string) : string :=
  Crypto.sha256_concat (flat_map (fun x => [show (slen x), ":", x]) l).

Arguments sha256 : simpl never.
Arguments hash_list : simpl never.

Fixpoint nodup_s (l : list string) : list string :=
  match l with [] => [] | x :: r => if mem x r then nodup_s r else x :: nodup_s r end.

distinct (l : list string) : nat := length (nodup_s l).

(** "{{" written as "{ {", so text from other agents or a repository can't
    contain the shell's fence placeholder, {{F}}, and close its own fence *)
Fixpoint defang_go (l acc : list ascii) : list ascii :=
  match l with
  | [] => acc
  | a :: rest =>
      match rest with
      | b :: _ => if Ascii.eqb a "{"%char && Ascii.eqb b "{"%char
                  then defang_go rest (" "%char :: a :: acc) else defang_go rest (a :: acc)
      | [] => a :: acc
      end
  end.

defang (s : string) : string := of_chars (rev_onto (defang_go (chars s) []) []).

Fixpoint remove_s (x : string) (l : list string) : list string :=
  match l with [] => [] | y :: r => if seq x y then remove_s x r else y :: remove_s x r end.

Fixpoint index_of (x : string) (l : list string) : nat :=
  match l with [] => 0 | y :: r => if seq x y then 0 else 1 + index_of x r end.

hexval (c : ascii) : nat := let n := nat_of_ascii c in if n <? 58 then n - 48 else n - 87.

(** the number in the first [k] hex digits of [s] *)
hexnum (s : string) (k acc : nat) : nat :=
  fold_left (fun a c => a * 16 + hexval c) (chars (substr s 0 k)) acc.

starts (p s : string) : bool := seq (substr s 0 (slen p)) p.

contains (p s : string) : bool := match find_str p s 0 with Some _ => true | None => false end.

lower_char (c : ascii) : ascii :=
  let n := nat_of_ascii c in if (65 <=? n) && (n <=? 90) then ascii_of_nat (n + 32) else c.

lower (s : string) : string := map_chars lower_char s.

(** a .gitattributes or .gitmodules in any component of [p], in any case:
    writing one changes how git reads every later edit *)
git_meta_component (p : string) : bool :=
  let w := lower (append "/" (append p "/")) in
  contains "/.gitattributes/" w || contains "/.gitmodules/" w.

(** a path a patch may write: relative, no "..", no backslash, not empty *)
(** a relative path inside a repository: no "..", no empty or "." part, and
    nothing in a .git directory, where writing would mean running code *)
safe_path (p : string) : bool :=
  let w := append "/" (append p "/") in
  negb (seq p "") && negb (starts "/" p) && negb (contains ".." p) && negb (contains "\" p)
  && negb (contains "//" w) && negb (contains "/./" w) && negb (contains "/.git/" w) && negb (contains "/.GIT/" w)
  && negb (git_meta_component p).

(** The shell's path policy, moved without changing its accepted paths.
    Unlike the market's [safe_path], it permits ".." inside a filename,
    rejects NUL, and rejects every ASCII case spelling of a .git component. *)
shell_path_chars (p : string) : bool :=
  forallb (fun c => negb (nat_of_ascii c =? 0) && negb (nat_of_ascii c =? 92)) (chars p).

shell_safe_path (p : string) : bool :=
  let w := append "/" (append p "/") in
  negb (seq p "") && negb (starts "/" p) && shell_path_chars p
  && negb (contains "//" w) && negb (contains "/./" w) && negb (contains "/../" w)
  && negb (contains "/.git/" (lower w)) && negb (git_meta_component p).

(** one character a spec, note or reason may hold: printable, a tab or a
    newline, or a byte of a UTF-8 character; not NUL, DEL or another control
    character (docs/SECURITY-REVIEW-2.md P-17) *)
plain_char (c : ascii) : bool :=
  let n := nat_of_ascii c in ((32 <=? n) && negb (n =? 127)) || (n =? 9) || (n =? 10).

(** text a transaction may carry into the state, and from there into git *)
plain_text (s : string) : bool := forallb plain_char (chars s).

(** text made plain: each control character a space, for what this node
    composes from a model's reply or a check's output *)
clean_text (s : string) : string := map_chars (fun c => if plain_char c then c else " "%char) s.

(** Redacting what looks like a secret in text that goes on chain: a failed
    check's output, which becomes a rejection every agent sees
    (docs/SECURITY-REVIEW-2.md P-12). A word is a run of letters, digits and
    [+ = _ :]. One of 24 characters or more with both letters and digits (a
    key, a token, a hash) becomes [redacted], and so does the value after a
    name ending in key, token, secret, password or passwd and an [=] or [:],
    in the same word or the next. Paths and error messages are left alone:
    [/ . -] split words. *)
secret_char (c : ascii) : bool :=
  let n := nat_of_ascii c in
  ((48 <=? n) && (n <=? 57)) || ((65 <=? n) && (n <=? 90)) || ((97 <=? n) && (n <=? 122))
  || (n =? 43) || (n =? 61) || (n =? 95) || (n =? 58).

ends (p s : string) : bool := (slen p <=? slen s) && seq (substr s (slen s - slen p) (slen p)) p.

redacted : string := "[redacted]".

key_word (w : string) : bool :=
  let l := lower w in existsb (fun k => ends k l) ("key" :: "token" :: "secret" :: "password" :: "passwd" :: []).

looks_secret (w : string) : bool :=
  (24 <=? slen w)
  && existsb (fun c => let n := nat_of_ascii c in (48 <=? n) && (n <=? 57)) (chars w)
  && existsb (fun c => let n := nat_of_ascii (lower_char c) in (97 <=? n) && (n <=? 122)) (chars w).

first_sep (w : string) : option nat :=
  match find_str "=" w 0, find_str ":" w 0 with
  | Some i, Some j => Some (Nat.min i j)
  | Some i, None => Some i
  | None, o => o
  end.

(** a word as it goes out, and whether the next word is a value to hide *)
redact_word (w : string) : string * bool :=
  match first_sep w with
  | Some p =>
      if key_word (substr w 0 p) then
        if slen w =? p + 1 then (w, true) else (append (substr w 0 (p + 1)) redacted, false)
      else (if looks_secret w then redacted else w, false)
  | None => (if looks_secret w then redacted else w, false)
  end.

redact_flush (out : list string) (cur : list ascii) (hide : bool) : list string * bool :=
  match cur with
  | [] => (out, hide)
  | _ => if hide then (redacted :: out, false)
         else let '(o, h) := redact_word (of_chars (rev_onto cur [])) in (o :: out, h)
  end.

redact (s : string) : string :=
  let '(out, cur, hide) :=
    fold_left (fun st c =>
      let '(out, cur, hide) := st in
      if secret_char c then (out, c :: cur, hide)
      else let '(out, hide) := redact_flush out cur hide in
           let n := nat_of_ascii c in
           (of_chars (c :: []) :: out, [], hide && ((n =? 32) || (n =? 9) || (n =? 34) || (n =? 39))))
      (chars s) ([], [], false) in
  Stdlib.Strings.String.concat "" (rev_onto (fst (redact_flush out cur hide)) []).

(** pairs from a flat list: [a; b; c; d] is [(a, b); (c, d)] *)
Fixpoint pairs (l : list string) : list (string * string) :=
  match l with a :: b :: r => (a, b) :: pairs r | _ => [] end.

Fixpoint flat (l : list (string * string)) : list string :=
  match l with [] => [] | (a, b) :: r => a :: b :: flat r end.

last_n {A : Type} (n : nat) (l : list A) : list A := skipn (length l - n) l.

(** ---- .plan parsing, moved from shell.ml (docs/SHELL-IN-SOMA.md) ---- *)

blank_char (c : ascii) : bool :=
  let n := nat_of_ascii c in (n =? 32) || (n =? 9) || (n =? 13) || (n =? 10).

(** the first offset from [i] on that isn't blank *)
Fixpoint skip_blank (fuel : nat) (s : string) (i : nat) : nat :=
  match fuel with
  | 0 => i
  | Succ f => match char_at s i with
              | Some c => if blank_char c then skip_blank f s (Succ i) else i
              | None => i
              end
  end.

(** the end of [s] before [j] once trailing blanks are dropped *)
Fixpoint skip_blank_back (fuel : nat) (s : string) (j : nat) : nat :=
  match fuel, j with
  | Succ f, Succ j' => match char_at s j' with
                       | Some c => if blank_char c then skip_blank_back f s j' else j
                       | None => j
                       end
  | _, _ => j
  end.

trim (s : string) : string :=
  let a := skip_blank (slen s) s 0 in
  let b := skip_blank_back (slen s) s (slen s) in
  if b <=? a then "" else substr s a (b - a).

newline : string := SCons (ascii_of_nat 10) SNil.

Fixpoint split_lines_go (fuel : nat) (s : string) (i : nat) (acc : list string) : list string :=
  match fuel with
  | 0 => rev_onto (substr s i (slen s - i) :: acc) []
  | Succ f => match find_str newline s i with
              | Some j => split_lines_go f s (Succ j) (substr s i (j - i) :: acc)
              | None => rev_onto (substr s i (slen s - i) :: acc) []
              end
  end.

(** the lines of [s], split at each newline: [""] for [""], and a last
    empty line after a final newline, as OCaml's String.split_on_char *)
split_lines (s : string) : list string := split_lines_go (slen s + 1) s 0 [].

all_date_chars (s : string) : bool :=
  forallb (fun c => let n := nat_of_ascii c in ((48 <=? n) && (n <=? 57)) || (n =? 45)) (chars s).

nth_char (n : nat) (s : string) : nat :=
  match char_at s n with Some c => nat_of_ascii c | None => 256 end.

is_date_line (l : string) : bool :=
  (slen l =? 10) && all_date_chars l && (nth_char 4 l =? 45) && (nth_char 7 l =? 45).

marked_line (l : string) : bool :=
  match l with
  | SCons c (SCons d _) =>
      ((nat_of_ascii c =? 42) || (nat_of_ascii c =? 43) || (nat_of_ascii c =? 45))
      && ((nat_of_ascii d =? 32) || (nat_of_ascii d =? 9))
  | _ => false
  end.

take_str (n : nat) (s : string) : string := substr s 0 n.

truncate_line (l : string) : string :=
  if 400 <? slen l then append (take_str 400 l) "..." else l.

open_line (l : string) : bool :=
  negb (seq l "") && negb (starts "#" l) && negb (is_date_line l)
  && negb (marked_line l) && negb (seq l "*") && negb (seq l "+") && negb (seq l "-").

(** A .plan's open items, in order, at most 60 of them, each cut at 400
    characters: an unmarked line is open; "* ", "+ " and "- " mark one done
    or dropped, "#" lines are notes, and a date-only line starts a day. *)
plan_open (text : string) : list string :=
  firstn 60 (map truncate_line (filter open_line (map trim (split_lines text)))).

(** "…", U+2026, in UTF-8: a model may write it for "..." *)
ellipsis : string := SCons (ascii_of_nat 226) (SCons (ascii_of_nat 128) (SCons (ascii_of_nat 166) SNil)).

(** The start of a plan line, from the line as the leader's prompt shows it
    (plan_open): a cut line's "..." comes off, so its first 400 characters
    name it. Most items are longer than that, and a leader that had to give
    the whole line couldn't mark them. A mark edits the line that begins
    with this (market.soma mark_edit). *)
plan_line_start (l : string) : string :=
  let l := trim l in
  if ends "..." l || ends ellipsis l then trim (take_str (slen l - 3) l) else l.

(** [s] after its first [n] characters *)
drop_str (n : nat) (s : string) : string := substr s n (slen s - n).

(** Literal, left-to-right, non-overlapping replacement for shell prompts.
    The shell only uses nonempty placeholders; an empty pattern leaves the
    text alone. *)

(** the pieces of the result, last first: each match adds the text before
    it and the replacement; each match moves past at least one character,
    so [slen s + 1] turns are enough *)
Fixpoint replace_all_go (fuel : nat) (s sub replacement : string) (i : nat) (acc : list string) : list string :=
  match fuel with
  | 0 => drop_str i s :: acc
  | Succ f => match find_str sub s i with
              | Some j => replace_all_go f s sub replacement (j + slen sub) (replacement :: substr s i (j - i) :: acc)
              | None => drop_str i s :: acc
              end
  end.

replace_all (s sub replacement : string) : string :=
  if seq sub "" then s
  else Stdlib.Strings.String.concat "" (rev_onto (replace_all_go (slen s + 1) s sub replacement 0 []) []).

(** ---- edit matching, moved from shell.ml (docs/SHELL-IN-SOMA.md) ---- *)

(** Where [sub] occurs in [s]: the first two places at most, in order. An
    edit applies only when its old text occurs exactly once. An empty [sub]
    occurs nowhere. *)
positions (s sub : string) : list nat :=
  if seq sub "" then []
  else match find_str sub s 0 with
       | None => []
       | Some i => match find_str sub s (Succ i) with None => [i] | Some j => i :: j :: [] end
       end.

(** [s] with the [old] at offset [i] replaced by [repl] *)
replace_at (s : string) (i : nat) (old repl : string) : string :=
  append (take_str i s) (append repl (drop_str (i + slen old) s)).

(** A file's text after an edit: its one [old] replaced by [repl]. None
    when [old] isn't in it, or appears more than once (the edit is then
    ambiguous: it has to give more of the text), or is empty. *)
edit_once (s old repl : string) : option string :=
  match positions s old with [i] => Some (replace_at s i old repl) | _ => None end.

(** Bounded structural scan before JSON parsing, moved from shell.ml.
    This is deliberately not a JSON validator: unmatched closers can make
    depth negative, and unfinished strings are left to the parser. Keeping
    opening and closing counts separately preserves that signed depth.
    Containers, colons and commas each spend one item outside strings. *)
Fixpoint shallow_json_go (fuel : nat) (s : string) (i : nat) (max items opens closes : nat)
    (in_str esc : bool) : bool :=
  match fuel, char_at s i with
  | Succ f, Some c =>
      let n := nat_of_ascii c in
      if in_str then
        if esc then shallow_json_go f s (Succ i) max items opens closes true false
        else if n =? 92 then shallow_json_go f s (Succ i) max items opens closes true true
        else shallow_json_go f s (Succ i) max items opens closes (negb (n =? 34)) false
      else if n =? 34 then shallow_json_go f s (Succ i) max items opens closes true false
      else if (n =? 91) || (n =? 123) then
        if (Succ opens <=? closes + max) && (0 <? items)
        then shallow_json_go f s (Succ i) max (items - 1) (Succ opens) closes false false
        else false
      else if (n =? 58) || (n =? 44) then
        if 0 <? items
        then shallow_json_go f s (Succ i) max (items - 1) opens closes false false
        else false
      else if (n =? 93) || (n =? 125) then
        shallow_json_go f s (Succ i) max items opens (Succ closes) false false
      else shallow_json_go f s (Succ i) max items opens closes false false
  | _, _ => true
  end.

(** Decimal limits avoid exposing extracted nat to shell.ml. Both callers
    use depth 4; transactions/peer messages use max_int items, replies 4096. *)
shallow_json (max max_items s : string) : bool :=
  shallow_json_go (slen s) s 0 (num max) (num max_items) 0 0 false false.

(** the scan without an item cap: a container, colon or comma is one
    character, so a cap past the text's length never runs out, as the
    binary's max_int never did *)
shallow_json_uncapped (max s : string) : bool :=
  shallow_json_go (slen s) s 0 (num max) (Succ (slen s)) 0 0 false false.

(** ---- Floats as text, in Soma ----
    What OCaml's Printf "%.17g" and "%.0f" and float_of_string give, computed
    exactly: a float is m * 2^e (FloatOps.Prim2SF), printed from the exact
    rational with round-half-even, and read back rounded to the nearest
    float by SpecFloat's own rounding (binary_round_aux), so reading
    "%.17g"'s text gives back the float. The binary and a unikernel run
    the same functions. *)

Local Open Scope Z_scope.

pos_of_nat_digits (k : nat) : positive := Nat.iter k (fun p => Pos.mul 10 p) 1%positive.

(** a positive's decimal digits *)
Fixpoint pos_decimal_go (fuel : nat) (n : N) (acc : string) : string :=
  match fuel, n with
  | O, _ => acc
  | _, N0 => acc
  | S f, Npos _ =>
      let (q, r) := N.div_eucl n 10%N in
      pos_decimal_go f q (Stdlib.Strings.String.String (ascii_of_N (48 + r)%N) acc)
  end.

n_decimal (n : N) : string :=
  match n with
  | N0 => "0"
  | Npos p => pos_decimal_go (Pos.size_nat p) n ""
  end.

(** v = num / den, both positive *)
float_ratio (m : positive) (e : Z) : positive * positive :=
  match e with
  | Z0 => (m, 1%positive)
  | Zpos k => (Pos.shiftl m (Npos k), 1%positive)
  | Zneg k => (m, Pos.shiftl 1 (Npos k))
  end.

(** 10^k for a whole k *)
pow10 (k : Z) : positive := match k with Zpos p => Pos.pow 10 p | _ => 1%positive end.

(** num/den >= 10^k *)
ratio_ge_pow10 (num den : positive) (k : Z) : bool :=
  if 0 <=? k then negb (Pos.ltb num (Pos.mul den (pow10 k)))
  else negb (Pos.ltb (Pos.mul num (pow10 (- k))) den).

(** the decimal exponent of num/den: 10^E <= v < 10^(E+1), from an
    estimate by its bits, then adjusted *)
Fixpoint dec_exp_fix (fuel : nat) (num den : positive) (k : Z) : Z :=
  match fuel with
  | O => k
  | S f =>
      if negb (ratio_ge_pow10 num den k) then dec_exp_fix f num den (k - 1)
      else if ratio_ge_pow10 num den (k + 1) then dec_exp_fix f num den (k + 1)
      else k
  end.

dec_exp (m : positive) (e : Z) : Z :=
  let (num, den) := float_ratio m e in
  let bits := Z.of_nat (Pos.size_nat m) + e - 1 in
  dec_exp_fix 8 num den (Z.div (bits * 30103) 100000).

(** round num/den to a whole number, half to even *)
round_half_even (num den : N) : N :=
  let (q, r) := N.div_eucl num den in
  match N.compare (2 * r)%N den with
  | Gt => (q + 1)%N
  | Eq => if N.even q then q else (q + 1)%N
  | Lt => q
  end.

(** 17 significant digits of m * 2^e and the decimal exponent of the
    first: q * 10^(E - 16), 10^16 <= q < 10^17 *)
float_digits17 (m : positive) (e : Z) : N * Z :=
  let (num, den) := float_ratio m e in
  let k := dec_exp m e in
  let s := 16 - k in
  let q := if 0 <=? s then round_half_even (Npos (Pos.mul num (pow10 s))) (Npos den)
           else round_half_even (Npos num) (Npos (Pos.mul den (pow10 (- s)))) in
  if N.eqb q (Npos (pow10 17)) then (Npos (pow10 16), k + 1) else (q, k).

Fixpoint drop_zeros_rev (l : list ascii) : list ascii :=
  match l with "0"%char :: r => drop_zeros_rev r | _ => l end.

(** digits with trailing zeros removed, as %g does *)
strip_zeros (s : string) : string := of_chars (rev_onto (drop_zeros_rev (rev_onto (chars s) [])) []).

point_part (frac : string) : string := let f := strip_zeros frac in if seq f "" then "" else append "." f.

zeros (k : nat) : string := of_chars (List.repeat "0"%char k).

exp_text (k : Z) : string :=
  let a := n_decimal (Z.to_N (Z.abs k)) in
  append (if k <? 0 then "e-" else "e+") (if (slen a <? 2)%nat then append "0" a else a).

(** "%.17g" of m * 2^e, without its sign *)
g17 (m : positive) (e : Z) : string :=
  let (q, k) := float_digits17 m e in
  let ds := n_decimal q in
  if (k <? -4) || (17 <=? k) then
    append (substr ds 0 1) (append (point_part (substr ds 1 16)) (exp_text k))
  else if 0 <=? k then
    append (substr ds 0 (Z.to_nat (k + 1))) (point_part (substr ds (Z.to_nat (k + 1)) 17))
  else append "0" (point_part (append (zeros (Z.to_nat (- k - 1))) ds)).

signed (s : bool) (t : string) : string := if s then append "-" t else t.

(** Printf "%.17g": the text a float crosses the wire as, read back exactly *)
float_wire (f : PrimFloat.float) : string :=
  match FloatOps.Prim2SF f with
  | SpecFloat.S754_zero s => signed s "0"
  | SpecFloat.S754_infinity s => signed s "inf"
  | SpecFloat.S754_nan => "nan"
  | SpecFloat.S754_finite s m e => signed s (g17 m e)
  end.

(** Printf "%.0f": the nearest whole number, half to even, and its sign *)
float_text (f : PrimFloat.float) : string :=
  match FloatOps.Prim2SF f with
  | SpecFloat.S754_zero s => signed s "0"
  | SpecFloat.S754_infinity s => signed s "inf"
  | SpecFloat.S754_nan => "nan"
  | SpecFloat.S754_finite s m e =>
      let (num, den) := float_ratio m e in
      signed s (n_decimal (round_half_even (Npos num) (Npos den)))
  end.

(** the float nearest m * 10^k, with its sign: exact SpecFloat rounding.
    Past 10^310 it is infinite and under 10^-330 zero, which spares
    computing a power of ten that large. *)
float_of_dec (neg : bool) (m : N) (k : Z) : PrimFloat.float :=
  match m with
  | N0 => FloatOps.SF2Prim (SpecFloat.S754_zero neg)
  | Npos p =>
      let size := Z.of_nat (slen (n_decimal m)) + k in
      let sf :=
        if 311 <? size then SpecFloat.S754_infinity false
        else if size <? -330 then SpecFloat.S754_zero false
        else if 0 <=? k then SpecFloat.binary_normalize 53 1024 (Zpos (Pos.mul p (pow10 k))) 0 false
        else
          let q := pow10 (- k) in
          let s := Z.max 0 (55 + Z.of_nat (Pos.size_nat q) - Z.of_nat (Pos.size_nat p)) in
          let (quot, rem) := N.div_eucl (Npos (Pos.shiftl p (Z.to_N s))) (Npos q) in
          let loc := match rem with
                     | N0 => SpecFloat.loc_Exact
                     | _ => SpecFloat.loc_Inexact (N.compare (2 * rem)%N (Npos q))
                     end in
          SpecFloat.binary_round_aux 53 1024 false (Z.of_N quot) (- s) loc in
      let f := FloatOps.SF2Prim sf in
      if neg then PrimFloat.opp f else f
  end.

digit_of (c : ascii) : option N :=
  let n := N_of_ascii c in if ((48 <=? n) && (n <=? 57))%N then Some (n - 48)%N else None.

(** an exponent's digits; past six digits it no longer changes the float *)
Fixpoint exp_digits (cs : list ascii) (acc : Z) (seen : bool) : option Z :=
  match cs with
  | [] => if seen then Some acc else None
  | "_"%char :: r => exp_digits r acc seen
  | c :: r => match digit_of c with
              | Some d => exp_digits r (Z.min 1000000 (acc * 10 + Z.of_N d)) true
              | None => None
              end
  end.

exp_part (cs : list ascii) : option Z :=
  match cs with
  | "-"%char :: r => option_map Z.opp (exp_digits r 0 false)
  | "+"%char :: r => exp_digits r 0 false
  | _ => exp_digits cs 0 false
  end.

(** digits, a point and more digits, then an exponent: m, the fraction's
    length subtracted from the exponent, and whether a digit was seen *)
Fixpoint mant_digits (cs : list ascii) (m : N) (adj : Z) (point seen : bool) : option (N * Z) :=
  match cs with
  | [] => if seen then Some (m, adj) else None
  | "_"%char :: r => if seen then mant_digits r m adj point seen else None
  | "."%char :: r => if point then None else mant_digits r m adj true seen
  | c :: r =>
      match digit_of c with
      | Some d => mant_digits r (m * 10 + d)%N (if point then adj - 1 else adj) point true
      | None =>
          if seen && (Ascii.eqb c "e"%char || Ascii.eqb c "E"%char) then
            match exp_part r with Some x => Some (m, adj + x) | None => None end
          else None
      end
  end.

(** OCaml's float_of_string on decimal text: a sign, digits with a point
    and underscores, an exponent; nan, inf and infinity. What it would
    refuse (hexadecimal included) is nan here. *)
float_of_digits (s : string) : PrimFloat.float :=
  let (neg, rest) := match chars s with
                     | "-"%char :: r => (true, r) | "+"%char :: r => (false, r) | cs => (false, cs) end in
  let word := lower (of_chars rest) in
  if seq word "nan" then PrimFloat.nan
  else if seq word "inf" || seq word "infinity" then (if neg then PrimFloat.neg_infinity else PrimFloat.infinity)
  else match mant_digits rest 0 0 false false with
       | Some (m, k) => float_of_dec neg m k
       | None => PrimFloat.nan
       end.

Local Close Scope Z_scope.

(** ---- JSON, read as the binary's yojson read it ----
    Yojson.Safe.from_string, as tokens in prefix order: "A" count, then
    each key and its value; "L" count, then each value; "S" text; "B"
    true/false; "U" null; "I" an integer's digits; "F" a float, as "%.0f"
    prints it. As yojson does: spaces, tabs, carriage returns, newlines
    and // and /* */ comments between tokens; a key quoted or a bare
    identifier; NaN, Infinity and -Infinity; numbers by the longest match
    (an integer is its own digits, -0 is 0, one past OCaml's int stays as
    written); escapes, \u with surrogate pairs as UTF-8, other bytes as
    they are. None for what it refuses: anything else, a value followed by
    more, or no value. Its tuples and variants are refused, as the
    binary's tokenizer refused them. *)

json_is (s : string) (i n : nat) : bool :=
  match char_at s i with Some c => nat_of_ascii c =? n | None => false end.

json_at_word (s : string) (i : nat) (w : string) : bool := seq (substr s i (slen w)) w.

json_newline : string := Stdlib.Strings.String.String (ascii_of_nat 10) "".

(** past spaces and comments; None in a comment that isn't closed *)
Fixpoint json_space_go (fuel : nat) (s : string) (i : nat) : option nat :=
  match fuel with
  | 0 => Some i
  | Succ f =>
      match char_at s i with
      | Some c =>
          let n := nat_of_ascii c in
          if (n =? 32) || (n =? 9) || (n =? 13) || (n =? 10) then json_space_go f s (Succ i)
          else if (n =? 47) && json_is s (Succ i) 47 then
            match find_str json_newline s (i + 2) with
            | Some j => json_space_go f s (Succ j)
            | None => Some (slen s)
            end
          else if (n =? 47) && json_is s (Succ i) 42 then
            match find_str "*/" s (i + 2) with
            | Some j => json_space_go f s (j + 2)
            | None => None
            end
          else Some i
      | None => Some i
      end
  end.

json_space (s : string) (i : nat) : option nat := json_space_go (Succ (slen s)) s i.

json_digit_at (s : string) (i : nat) : bool :=
  match char_at s i with Some c => let n := nat_of_ascii c in (48 <=? n) && (n <=? 57) | None => false end.

Fixpoint json_digits_end (fuel : nat) (s : string) (i : nat) : nat :=
  match fuel with
  | 0 => i
  | Succ f => if json_digit_at s i then json_digits_end f s (Succ i) else i
  end.

(** where yojson's number starting at i ends, by the longest match, and
    whether it is a float (a fraction or an exponent) *)
json_number_end (s : string) (i : nat) : option (nat * bool) :=
  let j := if json_is s i 45 then Succ i else i in
  if negb (json_digit_at s j) then None else
  let k := if json_is s j 48 then Succ j else json_digits_end (slen s) s j in
  let (k2, fraction) := if json_is s k 46 && json_digit_at s (Succ k)
                        then (json_digits_end (slen s) s (Succ k), true) else (k, false) in
  let m := if json_is s (Succ k2) 43 || json_is s (Succ k2) 45 then k2 + 2 else Succ k2 in
  if (json_is s k2 101 || json_is s k2 69) && json_digit_at s m
  then Some (json_digits_end (slen s) s m, true)
  else Some (k2, fraction).

json_hex (c : ascii) : option nat :=
  let n := nat_of_ascii c in
  if (48 <=? n) && (n <=? 57) then Some (n - 48)
  else if (97 <=? n) && (n <=? 102) then Some (n - 87)
  else if (65 <=? n) && (n <=? 70) then Some (n - 55)
  else None.

json_hex_at (s : string) (i : nat) : option nat :=
  match char_at s i with Some c => json_hex c | None => None end.

json_hex4 (s : string) (i : nat) : option nat :=
  match json_hex_at s i, json_hex_at s (i + 1), json_hex_at s (i + 2), json_hex_at s (i + 3) with
  | Some a, Some b, Some c, Some d => Some (((a * 16 + b) * 16 + c) * 16 + d)
  | _, _, _, _ => None
  end.

(** a code point's UTF-8 bytes, last first (they go on a reversed list) *)
json_utf8_rev (x : nat) : list ascii :=
  let b (n : nat) := ascii_of_nat n in
  if x <? 128 then [b x]
  else if x <? 2048 then [b (128 + x mod 64), b (192 + x / 64)]
  else if x <? 65536 then [b (128 + x mod 64), b (128 + (x / 64) mod 64), b (224 + x / 4096)]
  else [b (128 + x mod 64), b (128 + (x / 64) mod 64), b (128 + (x / 4096) mod 64), b (240 + x / 262144)].

(** a string's text, from just past its opening quote: the text and the
    offset past its closing quote *)
Fixpoint json_string_go (fuel : nat) (s : string) (i : nat) (acc : list ascii) : option (string * nat) :=
  match fuel with
  | 0 => None
  | Succ f =>
      match char_at s i with
      | None => None
      | Some c =>
          let n := nat_of_ascii c in
          if n =? 34 then Some (of_chars (rev_onto acc []), Succ i)
          else if negb (n =? 92) then json_string_go f s (Succ i) (c :: acc)
          else
            match char_at s (Succ i) with
            | None => None
            | Some e =>
                let en := nat_of_ascii e in
                let one (k : nat) := json_string_go f s (i + 2) (ascii_of_nat k :: acc) in
                if (en =? 34) || (en =? 92) || (en =? 47) then json_string_go f s (i + 2) (e :: acc)
                else if en =? 98 then one 8
                else if en =? 102 then one 12
                else if en =? 110 then one 10
                else if en =? 114 then one 13
                else if en =? 116 then one 9
                else if negb (en =? 117) then None
                else
                  match json_hex4 s (i + 2) with
                  | None => None
                  | Some x =>
                      if (55296 <=? x) && (x <=? 56319) then
                        if json_is s (i + 6) 92 && json_is s (i + 7) 117 then
                          match json_hex4 s (i + 8) with
                          | Some y =>
                              if (56320 <=? y) && (y <=? 57343)
                              then json_string_go f s (i + 12)
                                     (json_utf8_rev (65536 + (x - 55296) * 1024 + (y - 56320)) ++ acc)
                              else None
                          | None => None
                          end
                        else None
                      else json_string_go f s (i + 6) (json_utf8_rev x ++ acc)
                  end
            end
      end
  end.

json_ident_char (c : ascii) (first : bool) : bool :=
  let n := nat_of_ascii c in
  ((65 <=? n) && (n <=? 90)) || ((97 <=? n) && (n <=? 122)) || (n =? 95)
  || (negb first && (48 <=? n) && (n <=? 57)).

Fixpoint json_ident_end (fuel : nat) (s : string) (i : nat) : nat :=
  match fuel with
  | 0 => i
  | Succ f => match char_at s i with
              | Some c => if json_ident_char c false then json_ident_end f s (Succ i) else i
              | None => i
              end
  end.

(** a key: quoted, or a bare identifier *)
json_key (s : string) (i : nat) : option (string * nat) :=
  match char_at s i with
  | Some c =>
      if nat_of_ascii c =? 34 then json_string_go (Succ (slen s)) s (Succ i) []
      else if json_ident_char c true then
        let j := json_ident_end (slen s) s (Succ i) in Some (substr s i (j - i), j)
      else None
  | None => None
  end.

(** a value at i, its tokens pushed on [acc] (last first); then an
    array's values after its "[", or an object's members after its "{":
    their tokens, how many, and the offset past the closer *)
Fixpoint json_value (fuel : nat) (s : string) (i : nat) (acc : list string) : option (list string * nat) :=
  match fuel with
  | 0 => None
  | Succ f =>
      match json_space s i with
      | None => None
      | Some i =>
          match char_at s i with
          | None => None
          | Some c =>
              let n := nat_of_ascii c in
              if n =? 123 then
                match json_space s (Succ i) with
                | None => None
                | Some j =>
                    if json_is s j 125 then Some ("0" :: "A" :: acc, Succ j)
                    else match json_members f s j [] 0 with
                         | Some (kids, count, k) => Some (kids ++ show count :: "A" :: acc, k)
                         | None => None
                         end
                end
              else if n =? 91 then
                match json_space s (Succ i) with
                | None => None
                | Some j =>
                    if json_is s j 93 then Some ("0" :: "L" :: acc, Succ j)
                    else match json_items f s j [] 0 with
                         | Some (kids, count, k) => Some (kids ++ show count :: "L" :: acc, k)
                         | None => None
                         end
                end
              else if n =? 34 then
                match json_string_go (Succ (slen s)) s (Succ i) [] with
                | Some (t, k) => Some (t :: "S" :: acc, k)
                | None => None
                end
              else if json_at_word s i "true" then Some ("true" :: "B" :: acc, i + 4)
              else if json_at_word s i "false" then Some ("false" :: "B" :: acc, i + 5)
              else if json_at_word s i "null" then Some ("U" :: acc, i + 4)
              else if json_at_word s i "NaN" then Some ("nan" :: "F" :: acc, i + 3)
              else if json_at_word s i "Infinity" then Some ("inf" :: "F" :: acc, i + 8)
              else if json_at_word s i "-Infinity" then Some ("-inf" :: "F" :: acc, i + 9)
              else
                match json_number_end s i with
                | Some (k, true) => Some (float_text (float_of_digits (substr s i (k - i))) :: "F" :: acc, k)
                | Some (k, false) =>
                    let lexeme := substr s i (k - i) in
                    Some ((if seq lexeme "-0" then "0" else lexeme) :: "I" :: acc, k)
                | None => None
                end
          end
      end
  end
with json_items (fuel : nat) (s : string) (i : nat) (kids : list string) (count : nat)
    : option (list string * nat * nat) :=
  match fuel with
  | 0 => None
  | Succ f =>
      match json_value f s i kids with
      | None => None
      | Some (kids, j) =>
          match json_space s j with
          | None => None
          | Some j =>
              if json_is s j 44 then json_items f s (Succ j) kids (Succ count)
              else if json_is s j 93 then Some (kids, Succ count, Succ j)
              else None
          end
      end
  end
with json_members (fuel : nat) (s : string) (i : nat) (kids : list string) (count : nat)
    : option (list string * nat * nat) :=
  match fuel with
  | 0 => None
  | Succ f =>
      match json_key s i with
      | None => None
      | Some (key, j) =>
          match json_space s j with
          | Some j =>
              if negb (json_is s j 58) then None else
              match json_value f s (Succ j) (key :: kids) with
              | None => None
              | Some (kids, k) =>
                  match json_space s k with
                  | Some k =>
                      if json_is s k 44 then
                        match json_space s (Succ k) with
                        | Some k => json_members f s k kids (Succ count)
                        | None => None
                        end
                      else if json_is s k 125 then Some (kids, Succ count, Succ k)
                      else None
                  | None => None
                  end
              end
          | None => None
          end
      end
  end.

json_tokens (raw : string) : option (list string) :=
  match json_space raw 0 with
  | None => None
  | Some i =>
      if slen raw <=? i then None else
      match json_value (2 * slen raw + 4) raw i [] with
      | Some (acc, j) =>
          match json_space raw j with
          | Some k => if k =? slen raw then Some (rev_onto acc []) else None
          | None => None
          end
      | None => None
      end
  end.
