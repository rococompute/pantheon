(** Helpers that the consensus, the market and the agent share. *)
From Stdlib Require Import Ascii DecimalString.

(** An object is a record whose fields are looked up by name, each an [Any].
    It keeps the state machines short: reading a field casts it to the type
    it's used at, and a wrong field is a run-time error, not a static one.
    Turning these into typed records with invariants is a job for proofs. *)
obj : Type := list (string * Any).

Abbreviation SNil := Stdlib.Strings.String.EmptyString.
Abbreviation SCons := Stdlib.Strings.String.String.

seq (a b : string) : bool := Stdlib.Strings.String.eqb a b.

(** ---- strings by offset ----
    Strings extract to OCaml's (ExtrOcamlNativeString), where taking one
    apart as [SCons c r] copies [r], and building one copies too: a walk
    that way is quadratic, and a frame per character unless it's a tail
    call. Long text (files, prompts, a transaction's 256 KB) is read by
    offset instead, or as a list of characters, which extract linearly.
    main.soma extracts [slen], [char_at] and [substr] to OCaml's String
    functions; the standard library can't, as they count in [nat]. *)
slen (s : string) : nat := Stdlib.Strings.String.length s.

(** at most [n] characters of [s] from offset [i]; empty past the end *)
substr (s : string) (i n : nat) : string := Stdlib.Strings.String.substring i n s.

char_at (s : string) (i : nat) : option ascii := Stdlib.Strings.String.get i s.

chars (s : string) : list ascii := Stdlib.Strings.String.list_ascii_of_string s.

of_chars (l : list ascii) : string := Stdlib.Strings.String.string_of_list_ascii l.

Fixpoint rev_onto {A : Type} (l acc : list A) : list A :=
  match l with [] => acc | x :: r => rev_onto r (x :: acc) end.

(** [s] with [f] applied to each character, in one pass *)
map_chars (f : ascii -> ascii) (s : string) : string :=
  of_chars (rev_onto (fold_left (fun acc c => f c :: acc) (chars s) []) []).

(** the first offset from [i] on where [p] starts in [s]. The one-character
    check first keeps the cost near one comparison per offset. *)
Fixpoint find_go (fuel : nat) (p s : string) (i : nat) : option nat :=
  match fuel with
  | 0 => None
  | Succ f =>
      if ((slen p =? 0) || seq (substr s i 1) (substr p 0 1)) && seq (substr s i (slen p)) p
      then Some i else find_go f p s (Succ i)
  end.

find_str (p s : string) (i : nat) : option nat :=
  if slen s <? slen p + i then None else find_go (slen s - slen p - i + 1) p s i.

Fixpoint getf (o : obj) (k : string) : Any :=
  match o with [] => unk | (k', v) :: r => if seq k k' then v else getf r k end.

Fixpoint setf (o : obj) (k : string) (v : Any) : obj :=
  match o with
  | [] => [(k, v)]
  | (k', w) :: r => if seq k k' then (k, v) :: r else (k', w) :: setf r k v
  end.

Fixpoint mem (x : string) (l : list string) : bool :=
  match l with [] => false | y :: r => seq x y || mem x r end.

Fixpoint lookup {A : Type} (k : string) (l : list (string * A)) : option A :=
  match l with [] => None | (k', v) :: r => if seq k k' then Some v else lookup k r end.

Fixpoint put {A : Type} (k : string) (v : A) (l : list (string * A)) : list (string * A) :=
  match l with
  | [] => [(k, v)]
  | (k', w) :: r => if seq k k' then (k, v) :: r else (k', w) :: put k v r
  end.

get_or {A : Type} (d : A) (k : string) (l : list (string * A)) : A :=
  match lookup k l with Some v => v | None => d end.

(** add one to a counter in a list of counters *)
bump (k : string) (l : list (string * nat)) : list (string * nat) := put k (get_or 0 k l + 1) l.

digits (s : string) (acc : nat) : nat :=
  fold_left (fun a c => a * 10 + (nat_of_ascii c - 48)) (chars s) acc.

(** a decimal number; anything that isn't one reads as some number, never fails *)
num (s : string) : nat := digits s 0.

(** at most k characters, every one a decimal digit *)
short_digits (s : string) (k : nat) : bool :=
  (slen s <=? k) && forallb (fun c => (48 <=? nat_of_ascii c) && (nat_of_ascii c <=? 57)) (chars s).

(** A nonempty decimal number from an untrusted message, of up to 18 digits
    (it fits an OCaml int). It's read in one pass: the standard library's
    Nat.of_uint counts up in unary once extracted, so a peer's
    "999999999999999999" would stop the node for good. *)
num_opt (s : string) : option nat :=
  match s with
  | SNil => None
  | _ => if short_digits s 18 then Some (num s) else None
  end.

show (n : nat) : string := to_string n.

Fixpoint nodup_s (l : list string) : list string :=
  match l with [] => [] | x :: r => if mem x r then nodup_s r else x :: nodup_s r end.

distinct (l : list string) : nat := length (nodup_s l).

(** "{{" written as "{ {", so text from other agents or a repository can't
    contain the shell's fence placeholder, {{F}}, and close its own fence *)
Fixpoint defang_go (l acc : list ascii) : list ascii :=
  match l with
  | [] => acc
  | a :: rest =>
      match rest with
      | b :: _ => if Ascii.eqb a "{"%char && Ascii.eqb b "{"%char
                  then defang_go rest (" "%char :: a :: acc) else defang_go rest (a :: acc)
      | [] => a :: acc
      end
  end.

defang (s : string) : string := of_chars (rev_onto (defang_go (chars s) []) []).

Fixpoint remove_s (x : string) (l : list string) : list string :=
  match l with [] => [] | y :: r => if seq x y then remove_s x r else y :: remove_s x r end.

Fixpoint index_of (x : string) (l : list string) : nat :=
  match l with [] => 0 | y :: r => if seq x y then 0 else 1 + index_of x r end.

hexval (c : ascii) : nat := let n := nat_of_ascii c in if n <? 58 then n - 48 else n - 87.

(** the number in the first [k] hex digits of [s] *)
hexnum (s : string) (k acc : nat) : nat :=
  fold_left (fun a c => a * 16 + hexval c) (chars (substr s 0 k)) acc.

starts (p s : string) : bool := seq (substr s 0 (slen p)) p.

contains (p s : string) : bool := match find_str p s 0 with Some _ => true | None => false end.

lower_char (c : ascii) : ascii :=
  let n := nat_of_ascii c in if (65 <=? n) && (n <=? 90) then ascii_of_nat (n + 32) else c.

lower (s : string) : string := map_chars lower_char s.

(** a .gitattributes or .gitmodules in any component of [p], in any case:
    writing one changes how git reads every later edit *)
git_meta_component (p : string) : bool :=
  let w := lower (append "/" (append p "/")) in
  contains "/.gitattributes/" w || contains "/.gitmodules/" w.

(** a path a patch may write: relative, no "..", no backslash, not empty *)
(** a relative path inside a repository: no "..", no empty or "." part, and
    nothing in a .git directory, where writing would mean running code *)
safe_path (p : string) : bool :=
  let w := append "/" (append p "/") in
  negb (seq p "") && negb (starts "/" p) && negb (contains ".." p) && negb (contains "\" p)
  && negb (contains "//" w) && negb (contains "/./" w) && negb (contains "/.git/" w) && negb (contains "/.GIT/" w)
  && negb (git_meta_component p).

(** The shell's path policy, moved without changing its accepted paths.
    Unlike the market's [safe_path], it permits ".." inside a filename,
    rejects NUL, and rejects every ASCII case spelling of a .git component. *)
shell_path_chars (p : string) : bool :=
  forallb (fun c => negb (nat_of_ascii c =? 0) && negb (nat_of_ascii c =? 92)) (chars p).

shell_safe_path (p : string) : bool :=
  let w := append "/" (append p "/") in
  negb (seq p "") && negb (starts "/" p) && shell_path_chars p
  && negb (contains "//" w) && negb (contains "/./" w) && negb (contains "/../" w)
  && negb (contains "/.git/" (lower w)) && negb (git_meta_component p).

(** one character a spec, note or reason may hold: printable, a tab or a
    newline, or a byte of a UTF-8 character; not NUL, DEL or another control
    character (docs/SECURITY-REVIEW-2.md P-17) *)
plain_char (c : ascii) : bool :=
  let n := nat_of_ascii c in ((32 <=? n) && negb (n =? 127)) || (n =? 9) || (n =? 10).

(** text a transaction may carry into the state, and from there into git *)
plain_text (s : string) : bool := forallb plain_char (chars s).

(** text made plain: each control character a space, for what this node
    composes from a model's reply or a check's output *)
clean_text (s : string) : string := map_chars (fun c => if plain_char c then c else " "%char) s.

(** Redacting what looks like a secret in text that goes on chain: a failed
    check's output, which becomes a rejection every agent sees
    (docs/SECURITY-REVIEW-2.md P-12). A word is a run of letters, digits and
    [+ = _ :]. One of 24 characters or more with both letters and digits (a
    key, a token, a hash) becomes [redacted], and so does the value after a
    name ending in key, token, secret, password or passwd and an [=] or [:],
    in the same word or the next. Paths and error messages are left alone:
    [/ . -] split words. *)
secret_char (c : ascii) : bool :=
  let n := nat_of_ascii c in
  ((48 <=? n) && (n <=? 57)) || ((65 <=? n) && (n <=? 90)) || ((97 <=? n) && (n <=? 122))
  || (n =? 43) || (n =? 61) || (n =? 95) || (n =? 58).

ends (p s : string) : bool := (slen p <=? slen s) && seq (substr s (slen s - slen p) (slen p)) p.

redacted : string := "[redacted]".

key_word (w : string) : bool :=
  let l := lower w in existsb (fun k => ends k l) ("key" :: "token" :: "secret" :: "password" :: "passwd" :: []).

looks_secret (w : string) : bool :=
  (24 <=? slen w)
  && existsb (fun c => let n := nat_of_ascii c in (48 <=? n) && (n <=? 57)) (chars w)
  && existsb (fun c => let n := nat_of_ascii (lower_char c) in (97 <=? n) && (n <=? 122)) (chars w).

first_sep (w : string) : option nat :=
  match find_str "=" w 0, find_str ":" w 0 with
  | Some i, Some j => Some (Nat.min i j)
  | Some i, None => Some i
  | None, o => o
  end.

(** a word as it goes out, and whether the next word is a value to hide *)
redact_word (w : string) : string * bool :=
  match first_sep w with
  | Some p =>
      if key_word (substr w 0 p) then
        if slen w =? p + 1 then (w, true) else (append (substr w 0 (p + 1)) redacted, false)
      else (if looks_secret w then redacted else w, false)
  | None => (if looks_secret w then redacted else w, false)
  end.

redact_flush (out : list string) (cur : list ascii) (hide : bool) : list string * bool :=
  match cur with
  | [] => (out, hide)
  | _ => if hide then (redacted :: out, false)
         else let '(o, h) := redact_word (of_chars (rev_onto cur [])) in (o :: out, h)
  end.

redact (s : string) : string :=
  let '(out, cur, hide) :=
    fold_left (fun st c =>
      let '(out, cur, hide) := st in
      if secret_char c then (out, c :: cur, hide)
      else let '(out, hide) := redact_flush out cur hide in
           let n := nat_of_ascii c in
           (of_chars (c :: []) :: out, [], hide && ((n =? 32) || (n =? 9) || (n =? 34) || (n =? 39))))
      (chars s) ([], [], false) in
  Stdlib.Strings.String.concat "" (rev_onto (fst (redact_flush out cur hide)) []).

(** pairs from a flat list: [a; b; c; d] is [(a, b); (c, d)] *)
Fixpoint pairs (l : list string) : list (string * string) :=
  match l with a :: b :: r => (a, b) :: pairs r | _ => [] end.

Fixpoint flat (l : list (string * string)) : list string :=
  match l with [] => [] | (a, b) :: r => a :: b :: flat r end.

last_n {A : Type} (n : nat) (l : list A) : list A := skipn (length l - n) l.

(** ---- .plan parsing, moved from shell.ml (docs/SHELL-IN-SOMA.md) ---- *)

blank_char (c : ascii) : bool :=
  let n := nat_of_ascii c in (n =? 32) || (n =? 9) || (n =? 13) || (n =? 10).

(** the first offset from [i] on that isn't blank *)
Fixpoint skip_blank (fuel : nat) (s : string) (i : nat) : nat :=
  match fuel with
  | 0 => i
  | Succ f => match char_at s i with
              | Some c => if blank_char c then skip_blank f s (Succ i) else i
              | None => i
              end
  end.

(** the end of [s] before [j] once trailing blanks are dropped *)
Fixpoint skip_blank_back (fuel : nat) (s : string) (j : nat) : nat :=
  match fuel, j with
  | Succ f, Succ j' => match char_at s j' with
                       | Some c => if blank_char c then skip_blank_back f s j' else j
                       | None => j
                       end
  | _, _ => j
  end.

trim (s : string) : string :=
  let a := skip_blank (slen s) s 0 in
  let b := skip_blank_back (slen s) s (slen s) in
  if b <=? a then "" else substr s a (b - a).

newline : string := SCons (ascii_of_nat 10) SNil.

Fixpoint split_lines_go (fuel : nat) (s : string) (i : nat) (acc : list string) : list string :=
  match fuel with
  | 0 => rev_onto (substr s i (slen s - i) :: acc) []
  | Succ f => match find_str newline s i with
              | Some j => split_lines_go f s (Succ j) (substr s i (j - i) :: acc)
              | None => rev_onto (substr s i (slen s - i) :: acc) []
              end
  end.

(** the lines of [s], split at each newline: [""] for [""], and a last
    empty line after a final newline, as OCaml's String.split_on_char *)
split_lines (s : string) : list string := split_lines_go (slen s + 1) s 0 [].

all_date_chars (s : string) : bool :=
  forallb (fun c => let n := nat_of_ascii c in ((48 <=? n) && (n <=? 57)) || (n =? 45)) (chars s).

nth_char (n : nat) (s : string) : nat :=
  match char_at s n with Some c => nat_of_ascii c | None => 256 end.

is_date_line (l : string) : bool :=
  (slen l =? 10) && all_date_chars l && (nth_char 4 l =? 45) && (nth_char 7 l =? 45).

marked_line (l : string) : bool :=
  match l with
  | SCons c (SCons d _) =>
      ((nat_of_ascii c =? 42) || (nat_of_ascii c =? 43) || (nat_of_ascii c =? 45))
      && ((nat_of_ascii d =? 32) || (nat_of_ascii d =? 9))
  | _ => false
  end.

take_str (n : nat) (s : string) : string := substr s 0 n.

truncate_line (l : string) : string :=
  if 400 <? slen l then append (take_str 400 l) "..." else l.

open_line (l : string) : bool :=
  negb (seq l "") && negb (starts "#" l) && negb (is_date_line l)
  && negb (marked_line l) && negb (seq l "*") && negb (seq l "+") && negb (seq l "-").

(** A .plan's open items, in order, at most 60 of them, each cut at 400
    characters: an unmarked line is open; "* ", "+ " and "- " mark one done
    or dropped, "#" lines are notes, and a date-only line starts a day. *)
plan_open (text : string) : list string :=
  firstn 60 (map truncate_line (filter open_line (map trim (split_lines text)))).

(** "…", U+2026, in UTF-8: a model may write it for "..." *)
ellipsis : string := SCons (ascii_of_nat 226) (SCons (ascii_of_nat 128) (SCons (ascii_of_nat 166) SNil)).

(** The start of a plan line, from the line as the leader's prompt shows it
    (plan_open): a cut line's "..." comes off, so its first 400 characters
    name it. Most items are longer than that, and a leader that had to give
    the whole line couldn't mark them. A mark edits the line that begins
    with this (market.soma mark_edit). *)
plan_line_start (l : string) : string :=
  let l := trim l in
  if ends "..." l || ends ellipsis l then trim (take_str (slen l - 3) l) else l.

(** [s] after its first [n] characters *)
drop_str (n : nat) (s : string) : string := substr s n (slen s - n).

(** Literal, left-to-right, non-overlapping replacement for shell prompts.
    The shell only uses nonempty placeholders; an empty pattern leaves the
    text alone. *)

(** the pieces of the result, last first: each match adds the text before
    it and the replacement; each match moves past at least one character,
    so [slen s + 1] turns are enough *)
Fixpoint replace_all_go (fuel : nat) (s sub replacement : string) (i : nat) (acc : list string) : list string :=
  match fuel with
  | 0 => drop_str i s :: acc
  | Succ f => match find_str sub s i with
              | Some j => replace_all_go f s sub replacement (j + slen sub) (replacement :: substr s i (j - i) :: acc)
              | None => drop_str i s :: acc
              end
  end.

replace_all (s sub replacement : string) : string :=
  if seq sub "" then s
  else Stdlib.Strings.String.concat "" (rev_onto (replace_all_go (slen s + 1) s sub replacement 0 []) []).

(** ---- edit matching, moved from shell.ml (docs/SHELL-IN-SOMA.md) ---- *)

(** Where [sub] occurs in [s]: the first two places at most, in order. An
    edit applies only when its old text occurs exactly once. An empty [sub]
    occurs nowhere. *)
positions (s sub : string) : list nat :=
  if seq sub "" then []
  else match find_str sub s 0 with
       | None => []
       | Some i => match find_str sub s (Succ i) with None => [i] | Some j => i :: j :: [] end
       end.

(** [s] with the [old] at offset [i] replaced by [repl] *)
replace_at (s : string) (i : nat) (old repl : string) : string :=
  append (take_str i s) (append repl (drop_str (i + slen old) s)).

(** A file's text after an edit: its one [old] replaced by [repl]. None
    when [old] isn't in it, or appears more than once (the edit is then
    ambiguous: it has to give more of the text), or is empty. *)
edit_once (s old repl : string) : option string :=
  match positions s old with [i] => Some (replace_at s i old repl) | _ => None end.

(** Bounded structural scan before JSON parsing, moved from shell.ml.
    This is deliberately not a JSON validator: unmatched closers can make
    depth negative, and unfinished strings are left to the parser. Keeping
    opening and closing counts separately preserves that signed depth.
    Containers, colons and commas each spend one item outside strings. *)
Fixpoint shallow_json_go (fuel : nat) (s : string) (i : nat) (max items opens closes : nat)
    (in_str esc : bool) : bool :=
  match fuel, char_at s i with
  | Succ f, Some c =>
      let n := nat_of_ascii c in
      if in_str then
        if esc then shallow_json_go f s (Succ i) max items opens closes true false
        else if n =? 92 then shallow_json_go f s (Succ i) max items opens closes true true
        else shallow_json_go f s (Succ i) max items opens closes (negb (n =? 34)) false
      else if n =? 34 then shallow_json_go f s (Succ i) max items opens closes true false
      else if (n =? 91) || (n =? 123) then
        if (Succ opens <=? closes + max) && (0 <? items)
        then shallow_json_go f s (Succ i) max (items - 1) (Succ opens) closes false false
        else false
      else if (n =? 58) || (n =? 44) then
        if 0 <? items
        then shallow_json_go f s (Succ i) max (items - 1) opens closes false false
        else false
      else if (n =? 93) || (n =? 125) then
        shallow_json_go f s (Succ i) max items opens (Succ closes) false false
      else shallow_json_go f s (Succ i) max items opens closes false false
  | _, _ => true
  end.

(** Decimal limits avoid exposing extracted nat to shell.ml. Both callers
    use depth 4; transactions/peer messages use max_int items, replies 4096. *)
shallow_json (max max_items s : string) : bool :=
  shallow_json_go (slen s) s 0 (num max) (num max_items) 0 0 false false.

(** The callbacks still used by the shell. The binding transports this record
    as a product because .definition supports products, not record types. *)
Record shell_helpers := {
  helper_edit_once : string -> string -> string -> option string;
  helper_contains : string -> string -> bool;
  helper_safe_path : string -> bool
}.

node_helpers : shell_helpers :=
  {| helper_edit_once := edit_once; helper_contains := contains;
     helper_safe_path := shell_safe_path |}.

pack_helpers (h : shell_helpers) :=
  (helper_edit_once h, helper_contains h, helper_safe_path h).
