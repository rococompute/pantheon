(** What node.soma's pure effect order does, checked without running a node:
    no sockets, no timers, only [order_effects] on made-up steps. A snapshot
    effect appears only when consensus changed (as [empty_node]'s has not),
    decided outputs come before it, and the rest come after. *)

Example feed_chunks_splits_lines_and_keeps_the_partial :
  feed_chunks [] "one
tw" = (["one"], ["tw"]) /\
  feed_chunks ["tw"] "o
three
" = (["two", "three"], []) /\
  feed_chunks [] "a
b
c
" = (["a", "b", "c"], []) /\
  feed_chunks [] "" = ([], [""]) /\
  feed_chunks ["ab"] "cd" = ([], ["ab", "cd"]) /\
  feed_chunks [] "
" = ([""], []) /\
  feed_chunks [] "no newline at all" = ([], ["no newline at all"]) /\
  chunks_len ["ab", "cde"] = 5 /\ chunks_len [] = 0.
Proof. repeat split; reflexivity. Qed.

Example connection_admission_and_line_cap_edges :
  admit_decision_of 15 63 = AdmitNew /\ admit_decision_of 16 0 = AdmitRefuse /\
  admit_decision_of 0 64 = AdmitEvict /\ admit_decision_of 16 64 = AdmitRefuse /\
  admit_decision_of 15 64 = AdmitEvict /\ admit_decision_of 0 0 = AdmitNew /\
  oldest_conn [] = "" /\ oldest_conn [("a", 5%float)] = "a" /\
  oldest_conn [("a", 5%float), ("b", 3%float), ("c", 3%float)] = "b" /\
  oldest_conn [("a", 1%float), ("b", 2%float)] = "a" /\
  buffer_over 10 10 = false /\ buffer_over 11 10 = true /\ buffer_over 0 0 = false.
Proof. repeat split; reflexivity. Qed.

Example decided_snapshot_rest :
  order_effects ["msg", "peer", "x"] empty_node (with_cons empty_node (new_consensus "me" ["me"] 2))
    [["broadcast", "vote"], ["decided", "1", "tx"], ["status", "s"]]
  = [["perform", "decided", "1", "tx"], ["save_snapshot"], ["perform", "broadcast", "vote"], ["perform", "status", "s"]].
Proof. reflexivity. Qed.

Example refused_tx_is_remembered :
  order_effects ["tx", "raw"] empty_node empty_node []
  = [["refuse", "raw"]]
  /\ order_effects ["tx", "raw"] empty_node (with_pool empty_node ["raw"]) []
  = [].
Proof. repeat split; reflexivity. Qed.

Example empty_step_has_no_effects :
  order_effects ["timeout", "commit", "1", "0"] empty_node empty_node [] = [].
Proof. reflexivity. Qed.

Example only_some_kinds :
  order_effects ["msg", "peer"] empty_node empty_node [["status", "s"], ["log", "hi"]]
  = [["perform", "status", "s"], ["perform", "log", "hi"]]
  /\ order_effects ["msg", "peer"] empty_node (with_cons empty_node (new_consensus "me" ["me"] 2)) [["broadcast", "vote"]]
  = [["save_snapshot"], ["perform", "broadcast", "vote"]]
  /\ order_effects ["msg", "peer"] empty_node empty_node [["decided", "3", "tx"]]
  = [["perform", "decided", "3", "tx"]].
Proof. repeat split; reflexivity. Qed.

Example vote_saves_before_it_sends :
  order_effects ["msg", "peer"] empty_node (with_cons empty_node (new_consensus "me" ["me"] 2)) [["broadcast", "prevote", "1"]]
  = [["save_snapshot"], ["perform", "broadcast", "prevote", "1"]].
Proof. reflexivity. Qed.

(** Step 4's output decisions are pure plans for the actual bindings. *)
Example timer_selects_delay_and_timeout_fields :
  plan_output ["timer", "commit", "7", "2", "350"] =
    SetTimer "350" ["timeout", "commit", "7", "2"].
Proof. reflexivity. Qed.

Example log_selects_exact_text :
  plan_output ["log", "line one
line two"] = WriteLog "line one
line two".
Proof. reflexivity. Qed.

Example height_selects_the_new_height :
  plan_output ["height", "12"] = SetHeight "12" /\
  plan_output ["height"] = LegacyOutput ["height"] /\
  plan_output ["height", "1", "2"] = LegacyOutput ["height", "1", "2"].
Proof. repeat split; reflexivity. Qed.

Example decided_selects_height_and_all_transactions :
  plan_output ["decided", "7", "tx one", "tx two"] =
    DecidedBlock "7" ["tx one", "tx two"] /\
  plan_output ["decided", "8"] = DecidedBlock "8" [].
Proof. split; reflexivity. Qed.

Example malformed_outputs_keep_the_old_fallback :
  plan_output ["timer", "commit", "7", "2"] =
    LegacyOutput ["timer", "commit", "7", "2"] /\
  plan_output ["log", "one", "two"] = LegacyOutput ["log", "one", "two"] /\
  plan_output ["decided"] = LegacyOutput ["decided"] /\
  plan_output ["reveal"] = LegacyOutput ["reveal"].
Proof. repeat split; reflexivity. Qed.

Example reveal_selects_draw_policy :
  plan_output ["reveal", "3"] = RevealLink "3".
Proof. reflexivity. Qed.

Example honest_reveal_queues_the_exact_link :
  reveal_plan "" "4" "secret" "2" =
    [QueueAction ["local_tx", "reveal", sha256 (sha256 "secret")]].
Proof. reflexivity. Qed.

Example withhold_odd_draw_only_logs :
  reveal_plan "withhold" "4" "secret" "3" =
    [LogAction "FAULT INJECTION: holding back my link for draw 3"] /\
  reveal_plan "withhold" "4" "secret" "5" =
    [LogAction "FAULT INJECTION: holding back my link for draw 5"].
Proof. split; reflexivity. Qed.

Example withhold_even_draw_reveals :
  reveal_plan "withhold" "4" "secret" "2" =
    [QueueAction ["local_tx", "reveal", sha256 (sha256 "secret")]].
Proof. reflexivity. Qed.

Example exhausted_chain_queues_nothing :
  reveal_plan "" "4" "secret" "4" = [] /\
  reveal_plan "" "4" "secret" "5" = [] /\
  draw_link 0 "secret" = "secret".
Proof. repeat split; reflexivity. Qed.

Example new_decision_requests_one_store :
  decided_plan "7" ["tx"] None = [StoreAction "7" ["tx"]] /\
  decided_plan "8" [] None = [StoreAction "8" []].
Proof. split; reflexivity. Qed.

Example repeated_decision_requests_no_store :
  decided_plan "7" ["tx"] (Some ["tx"]) = [] /\
  decided_plan "7" ["different"] (Some []) = [].
Proof. split; reflexivity. Qed.

Example startup_saves_before_votes_even_without_a_changed_snapshot :
  startup_effects [["broadcast", "vote"], ["decided", "7", "tx"], ["timer", "commit", "8", "0", "0"]] =
    [["perform", "decided", "7", "tx"], ["save_snapshot"],
     ["perform", "broadcast", "vote"], ["perform", "timer", "commit", "8", "0", "0"]] /\
  startup_effects [] = [["save_snapshot"]].
Proof. split; reflexivity. Qed.

(** Catch-up decisions name the actual table writes, reads, and sends. *)
Example behind_selects_catchup_and_malformed_arity_is_unchanged :
  plan_output ["behind", "peer", "3"] = CatchupPeer "peer" "3" /\
  plan_output ["behind", "peer"] = LegacyOutput ["behind", "peer"] /\
  plan_output ["behind", "peer", "3", "extra"] = LegacyOutput ["behind", "peer", "3", "extra"].
Proof. repeat split; reflexivity. Qed.

Example catchup_remembers_before_reading_each_block :
  catchup_plan "peer" "3" "6" 10%float None true false =
    [RememberPeer "peer" "3" 10%float, ReadPeerBlock "peer" 3,
     ReadPeerBlock "peer" 4, ReadPeerBlock "peer" 5].
Proof. reflexivity. Qed.

Example catchup_duplicate_requests_no_bindings :
  catchup_plan "peer" "3" "6" 10%float (Some 9%float) true false = [].
Proof. reflexivity. Qed.

Example catchup_at_two_seconds_can_send_again :
  catchup_plan "peer" "3" "4" 10%float (Some 8%float) true false =
    [RememberPeer "peer" "3" 10%float, ReadPeerBlock "peer" 3].
Proof. reflexivity. Qed.

Example catchup_backward_clock_still_throttles :
  catchup_plan "peer" "3" "6" 10%float (Some 11%float) true false = [].
Proof. reflexivity. Qed.

Example catchup_silent_or_absent_peer_still_remembers :
  catchup_plan "peer" "3" "6" 10%float None true true =
    [RememberPeer "peer" "3" 10%float] /\
  catchup_plan "peer" "3" "6" 10%float None false false =
    [RememberPeer "peer" "3" 10%float].
Proof. split; reflexivity. Qed.

Example catchup_empty_range_still_remembers :
  catchup_plan "peer" "6" "6" 10%float None true false =
    [RememberPeer "peer" "6" 10%float] /\
  catchup_plan "peer" "7" "6" 10%float None true false =
    [RememberPeer "peer" "7" 10%float].
Proof. split; reflexivity. Qed.

Example catchup_caps_reads_at_fifty_one :
  catchup_plan "peer" "3" "100" 10%float None true false =
    RememberPeer "peer" "3" 10%float :: map (ReadPeerBlock "peer") (List.seq 3 51).
Proof. reflexivity. Qed.

Example catchup_missing_block_requests_no_send :
  catchup_send "peer" 4 None = None.
Proof. reflexivity. Qed.

Example catchup_existing_and_empty_blocks_request_exact_peer_send :
  catchup_send "peer" 4 (Some ["one", "two"]) =
    Some ("peer", ["done", "4", "0", "0", hash_list ["one", "two"], "one", "two"]) /\
  catchup_send "peer" 4 (Some []) =
    Some ("peer", ["done", "4", "0", "0", hash_list []]).
Proof. split; reflexivity. Qed.

Example check_selects_the_ci_job :
  plan_output ["check", "9", "calc", "head1", "e1", "e2"] =
    CheckRequest "9" "calc" "head1" ["e1", "e2"] /\
  plan_output ["check", "9", "calc", "head1"] = CheckRequest "9" "calc" "head1" [] /\
  plan_output ["check", "9", "calc"] = LegacyOutput ["check", "9", "calc"] /\
  plan_output ["check"] = LegacyOutput ["check"].
Proof. repeat split; reflexivity. Qed.

Example peer_line_drops_and_events :
  line_dropped "1" "0" = true /\ line_dropped "0" "1" = true /\
  line_dropped "0" "0" = false /\
  line_event "peer" ["tx", "raw"] = ["tx", "raw"] /\
  line_event "peer" ["prevote", "7", "0"] = ["msg", "peer", "prevote", "7", "0"] /\
  line_event "peer" [] = ["msg", "peer"].
Proof. repeat split; reflexivity. Qed.

Example status_and_submit_select_the_shared_interpreter :
  plan_output ["status"] = WriteStatus [] /\
  plan_output ["status", "version 2", "pool 0"] = WriteStatus ["version 2", "pool 0"] /\
  plan_output ["submit", "7"] = SubmitTransaction "7" [] /\
  plan_output ["submit", "7", "reveal", "link"] = SubmitTransaction "7" ["reveal", "link"] /\
  plan_output ["submit"] = LegacyOutput ["submit"].
Proof. repeat split; reflexivity. Qed.

Example status_preserves_line_order_and_final_newline :
  status_output ["height 3", "version 2"] [("calc", "abc"), ("notes", "def")]
    [("calc", "bad tree")] true "codex" "09:05" "2" "quota" =
  Stdlib.Strings.String.concat newline
    ["height 3", "version 2", "checkout calc abc", "checkout notes def",
     "DIVERGED calc at merge bad tree", "LIMIT codex until 09:05, 2 model requests held: quota", ""].
Proof. reflexivity. Qed.

Example status_without_a_limit_omits_all_limit_fields :
  status_output ["pool 0"] [] [] false "ignored" "ignored" "7" "ignored" =
    append "pool 0" newline /\
  status_output [] [] [] false "" "" "" "" = newline.
Proof. split; reflexivity. Qed.

Example status_limit_uses_a_strict_wall_clock_boundary :
  status_limit_active 9%float 10%float = true /\
  status_limit_active 10%float 10%float = false /\
  status_limit_active 11%float 10%float = false.
Proof. repeat split; reflexivity. Qed.

Example submission_log_keeps_empty_and_short_fields :
  submission_message ["bid", "", "multi word"] = "sending bid  multi word" /\
  submission_message [] = "sending ".
Proof. split; reflexivity. Qed.

Example submission_log_truncates_only_past_sixty_bytes :
  submission_message ["012345678901234567890123456789012345678901234567890123456789"] =
    "sending 012345678901234567890123456789012345678901234567890123456789" /\
  submission_message ["012345678901234567890123456789012345678901234567890123456789X"] =
    "sending 012345678901234567890123456789012345678901234567890123456789...".
Proof. split; reflexivity. Qed.

Example ordinary_submission_publishes_once_with_its_original_nonce :
  submission_plan "" false "007" ["reveal", "link"] =
    [PublishTransaction "007" ["reveal", "link"] (Some "sending reveal link")] /\
  submission_plan "future-nonce" true "7" ["withdraw", "0"] =
    [PublishTransaction "7" ["withdraw", "0"] (Some "sending withdraw 0")].
Proof. split; reflexivity. Qed.

Example future_nonce_marks_before_its_six_hundred_extra_submissions :
  submission_plan "future-nonce" false "7" ["withdraw", "0"] =
    PublishTransaction "7" ["withdraw", "0"] (Some "sending withdraw 0") ::
    MarkNonceFlood :: LogAction "FAULT INJECTION: flooding 600 future-nonce transactions" ::
    map (fun k => PublishTransaction (show (7 + k)) ["withdraw", "0"] None) (List.seq 4 600).
Proof. reflexivity. Qed.

Example future_nonce_range_is_four_through_six_hundred_three :
  length (submission_plan "future-nonce" false "7" []) = 603 /\
  nth 3 (submission_plan "future-nonce" false "7" []) MarkNonceFlood =
    PublishTransaction "11" ["withdraw", "0"] None /\
  nth 602 (submission_plan "future-nonce" false "7" []) MarkNonceFlood =
    PublishTransaction "610" ["withdraw", "0"] None.
Proof. repeat split; reflexivity. Qed.

Example submission_silence_only_suppresses_the_peer_send :
  submission_send "silent" "signed tx" = None /\
  submission_send "" "signed tx" = Some ["tx", "signed tx"] /\
  submission_plan "silent" false "7" ["withdraw", "0"] =
    [PublishTransaction "7" ["withdraw", "0"] (Some "sending withdraw 0")].
Proof. repeat split; reflexivity. Qed.

Example storage_ops_travel_the_one_interface :
  io_wire (IoStore "7" ["tx1", "tx2"]) = ["store", "7", "tx1", "tx2"] /\
  io_of_wire ["store", "7", "tx1", "tx2"] = Some (IoStore "7" ["tx1", "tx2"]) /\
  io_wire (IoStore "8" []) = ["store", "8"] /\
  io_wire (IoSetHeight "9") = ["set_height", "9"] /\
  io_of_wire ["set_height", "9"] = Some (IoSetHeight "9") /\
  io_wire (IoWriteStatus "height 3") = ["write_status", "height 3"] /\
  io_of_wire ["write_status", "height 3"] = Some (IoWriteStatus "height 3") /\
  action_io (StoreAction "7" ["tx1"]) = Some (IoStore "7" ["tx1"]) /\
  io_of_wire ["store"] = None.
Proof. repeat split; reflexivity. Qed.

Example broadcast_selects_its_fields_and_leaves_other_outputs :
  plan_output ["broadcast", "prevote", "1", "0", "-1", "v", "nil"] =
    Broadcast ["prevote", "1", "0", "-1", "v", "nil"] /\
  plan_output ["broadcast"] = Broadcast [] /\
  plan_output ["not-broadcast"] = LegacyOutput ["not-broadcast"].
Proof. repeat split; reflexivity. Qed.

Example broadcast_records_a_new_vote_then_sends_it_to_every_peer :
  broadcast_plan "" 2 ["prevote", "1", "0", "-1", "v", "nil"]
    (Some ("prevote", "1", "0", "v")) None None =
    [RememberVote "prevote/1/0" "v" ["prevote", "1", "0", "-1", "v", "nil"],
     RememberBroadcast "1" "all" ["prevote", "1", "0", "-1", "v", "nil"]
       ["prevote", "1", "0", "-1", "v", "nil"],
     SendEveryone ["prevote", "1", "0", "-1", "v", "nil"]].
Proof. reflexivity. Qed.

Example broadcast_refuses_a_second_value_when_nothing_was_stored :
  broadcast_plan "" 2 ["prevote", "1", "0", "-1", "w", "nil"]
    (Some ("prevote", "1", "0", "w")) (Some "v") None =
    [LogAction "refusing to sign a second prevote at prevote/1/0: already signed v"].
Proof. reflexivity. Qed.

Example broadcast_resends_the_stored_vote :
  broadcast_plan "" 1 ["prevote", "1", "0", "-1", "w", "nil"]
    (Some ("prevote", "1", "0", "w")) (Some "v")
    (Some ["prevote", "1", "0", "-1", "v", "nil"]) =
    [LogAction "already signed a prevote at prevote/1/0: sending that one again",
     RememberBroadcast "1" "all" ["prevote", "1", "0", "-1", "v", "nil"]
       ["prevote", "1", "0", "-1", "v", "nil"],
     SendEveryone ["prevote", "1", "0", "-1", "v", "nil"]].
Proof. reflexivity. Qed.

Example broadcast_silent_records_the_vote_and_sends_nothing :
  broadcast_plan "silent" 2 ["prevote", "1", "0", "-1", "v", "nil"]
    (Some ("prevote", "1", "0", "v")) None None =
    [RememberVote "prevote/1/0" "v" ["prevote", "1", "0", "-1", "v", "nil"]] /\
  broadcast_subject ["done", "4", "0", "0", "abc", "tx"] = None /\
  broadcast_plan "" 1 ["ping"] None None None = [SendEveryone ["ping"]].
Proof. repeat split; reflexivity. Qed.

Example broadcast_equivocates_and_double_votes_per_peer :
  broadcast_plan "equivocate" 2 ["proposal", "3", "1", "0", "vid", "val"] None None None =
    [RememberBroadcast "3" "each" ["proposal", "3", "1", "0", "vid", "val"]
       ["proposal", "3", "1", "0", hash_list ["equivocation", "3", "1"], "equivocation", "3", "1"],
     SendPeer "0" ["proposal", "3", "1", "0", "vid", "val"],
     SendPeer "1" ["proposal", "3", "1", "0", hash_list ["equivocation", "3", "1"], "equivocation", "3", "1"]] /\
  broadcast_plan "double-vote" 2 ["prevote", "3", "1", "0", "vid", "val", "tail"]
    (Some ("prevote", "3", "1", "vid")) (Some "vid") None =
    [RememberBroadcast "3" "each" ["prevote", "3", "1", "0", "vid", "val", "tail"]
       ["prevote", "3", "1", "0", "", "val", "tail"],
     SendPeer "0" ["prevote", "3", "1", "0", "vid", "val", "tail"],
     SendPeer "1" ["prevote", "3", "1", "0", "", "val", "tail"]].
Proof. repeat split; reflexivity. Qed.

(** A decided merge's pure part: its gate, its edits and the texts said. *)
Example merge_output_selects_merge_and_short_forms_stay_legacy :
  plan_output ["merge", "calc", "2", "tree", "7", "3", "codex", "spec", "a.txt", "x", "y"] =
    MergeRequest "calc" "2" "tree" "7" "3" "codex" "spec" ["a.txt", "x", "y"] /\
  plan_output ["merge", "calc", "2", "tree", "7", "3", "codex"] =
    LegacyOutput ["merge", "calc", "2", "tree", "7", "3", "codex"].
Proof. split; reflexivity. Qed.

Example merge_gate_unknown_applied_newer_and_diverged :
  merge_gate_of None "2" false = MergeUnknown /\
  merge_gate_of (Some "2") "2" false = MergeSkip /\
  merge_gate_of (Some "3") "2" false = MergeSkip /\
  merge_gate_of (Some "1") "2" true = MergeSkip /\
  merge_gate_of (Some "1") "2" false = MergeApply.
Proof. repeat split; reflexivity. Qed.

Example merge_triples_in_order_dropping_a_short_tail :
  merge_triples ["a", "o", "n", "b", "", "whole", "c", "x"] = [("a", "o", "n"), ("b", "", "whole")].
Proof. reflexivity. Qed.

Example merge_edit_plan_cases :
  merge_edit_plan "../x" "o" "n" "file" = EditFail "unsafe path ../x" /\
  merge_edit_plan "a" "o" "n" "symlink" = EditFail "a goes through a symlink" /\
  merge_edit_plan "a" "o" "n" "dir" = EditFail "a is a directory" /\
  merge_edit_plan "a" "" "" "file" = EditRemove "a" /\
  merge_edit_plan "a" "" "" "none" = EditFail "a: nothing to delete" /\
  merge_edit_plan "a" "" "whole" "none" = EditWrite "a" "whole" /\
  merge_edit_plan "a" "o" "n" "none" = EditFail "a: no such file to edit" /\
  merge_edit_plan "a" "o" "n" "file" = EditRead "a".
Proof. repeat split; reflexivity. Qed.

Example merge_edit_once_zero_one_several :
  merge_edit_apply "a" "x" "y" "abc" = EditFail "a: the old text isn't in the file" /\
  merge_edit_apply "a" "b" "y" "abc" = EditWrite "a" "ayc" /\
  merge_edit_apply "a" "b" "y" "abcb" = EditFail "a: the old text appears more than once, so give more of it".
Proof. repeat split; reflexivity. Qed.

Example merge_tree_check_and_texts :
  merge_tree_check "t" None = Some "git commit failed" /\
  merge_tree_check "t" (Some ("t", "abc1234")) = None /\
  merge_tree_check "t" (Some ("u", "abc1234")) = Some "got tree u, attested t" /\
  merge_diverged_text "calc" "07" "boom" = "DIVERGED: repository calc, merge 7: boom. Stopped taking merges for it.".
Proof. repeat split; reflexivity. Qed.

(** The llm output: its request, the budget and hold, its log lines, and
    the prompt assembled from what the shell reads. *)
Example llm_output_selects_a_model_request :
  plan_output ["llm", "3", "patch", "P", "calc", "a.txt"] = LlmRequest "3" "patch" "P" ["calc", "a.txt"] /\
  plan_output ["llm", "3", "draft", "P"] = LlmRequest "3" "draft" "P" [] /\
  plan_output ["llm", "3", "draft"] = LegacyOutput ["llm", "3", "draft"].
Proof. repeat split; reflexivity. Qed.

Example llm_gate_budget_then_a_strict_limit :
  llm_gate_of "101" "100" 0%float 50%float = LlmOverBudget /\
  llm_gate_of "100" "100" 5%float 10%float = LlmHeld /\
  llm_gate_of "100" "100" 10%float 10%float = LlmAsk /\
  llm_gate_of "1" "0" 0%float 0%float = LlmOverBudget.
Proof. repeat split; reflexivity. Qed.

Theorem llm_over_budget_whatever_the_limit : forall calls max now until,
  (num max <? num calls) = true -> llm_gate_of calls max now until = LlmOverBudget.
Proof. intros calls max now until H. unfold llm_gate_of. rewrite H. reflexivity. Qed.

Example llm_log_lines :
  llm_budget_text "100" = "model call budget of 100 used up: restart with a higher --max-llm-calls" /\
  llm_hold_text "4" "pick" "claude" "15" = "holding request 4 (a pick): claude is limited for 15 more minutes" /\
  llm_ask_text "codex" "patch" "7" "3" "100" = "asking codex for a patch (request 7, call 3 of 100)".
Proof. repeat split; reflexivity. Qed.

Example llm_fence_and_listing :
  shell_fence "T" "file a" "x" = "<<<UNTRUSTED T file a>>>
x
<<<END UNTRUSTED T>>>
" /\
  listing_text "a
b
c" 2 = "a
b
(and 1 more)" /\
  listing_text "a
b" 2 = "a
b" /\
  listing_text "" 2 = "".
Proof. repeat split; reflexivity. Qed.

Example llm_plan_text_open_none_and_absent :
  plan_text_of "T" [("calc", None)] = "(no repository has a .plan)
" /\
  plan_text_of "T" [("calc", Some "- gone"), ("web", None)] =
    shell_fence "T" "plan of calc: open items" "(none: every item is done or dropped)" /\
  plan_text_of "T" [("calc", Some "one
+ done
two")] = shell_fence "T" "plan of calc: open items" "one
two".
Proof. repeat split; reflexivity. Qed.

(** Each file is cut at the cap, and the budget spends what was quoted,
    the cut note included: once it's spent, a file is only the note. *)
Example llm_repo_files_cap_and_budget :
  repo_files_text "T" 10 100 [("a", Some "hi")] = shell_fence "T" "file a" "hi" /\
  repo_files_text "T" 4 6 [("a", Some "abcdef"), ("b", None), ("c", Some "")] =
    append (shell_fence "T" "file a" (append "abcd" (append newline "(cut here: the file goes on)")))
      (append (shell_fence "T" "file b" (append newline "(cut here: the file goes on)"))
        (shell_fence "T" "file c" "")) /\
  repo_files_text "T" 100 100 [("b", None)] = shell_fence "T" "file b" "(no such file at the head)".
Proof. repeat split; reflexivity. Qed.

Example llm_repo_text_known_and_unknown :
  repo_text_of "T" "nope" None [] 1 1 = "(no repository nope)
" /\
  repo_text_of "T" "calc" (Some "x.txt") [("x.txt", Some "hi")] 10 100 =
    append (shell_fence "T" "files in calc" "x.txt") (shell_fence "T" "file x.txt" "hi").
Proof. repeat split; reflexivity. Qed.

(** Placeholders in order; {{REPO}} needs a context, and text put in for a
    placeholder already done isn't replaced again. *)
Example llm_prompt_assembly :
  prompt_assemble "T" "A {{F}} {{REPOS}} {{PLAN}} {{REPO}}" ["calc", "x"]
    (fun _ => "R") (fun _ => "P") (fun r ps => append r (hd "" ps)) = "A T R P calcx" /\
  prompt_assemble "T" "{{REPO}} {{F}}" [] (fun _ => "R") (fun _ => "P") (fun r _ => r) = "{{REPO}} T" /\
  prompt_assemble "T" "{{REPOS}}" [] (fun _ => "{{F}}") (fun _ => "P") (fun r _ => r) = "{{F}}" /\
  prompt_assemble "T" "plain" ["calc"] (fun _ => "R") (fun _ => "P") (fun r _ => r) = "plain".
Proof. repeat split; reflexivity. Qed.

(** The incremental reader preserves ordering, missing files, and the
    exhausted-budget note, including an empty file after exhaustion. *)
Example llm_incremental_context :
  repo_read_text "T" 4 6
    (fun p => (p, lookup p [("a", "abcdef"), ("c", "")])) ["a", "b", "c"] =
  append (shell_fence "T" "file a" (append "abcd" (append newline "(cut here: the file goes on)")))
    (append (shell_fence "T" "file b" (append newline "(cut here: the file goes on)"))
      (shell_fence "T" "file c" "")) /\
  repo_read_text "T" 4 6 (fun p => (p, Some "unused")) [] = "".
Proof. split; reflexivity. Qed.

(** Held model requests' release: when, how many, and what is said. *)
Example release_plan_cases :
  release_plan_of 0 true false true = ReleaseNone /\
  release_plan_of 2 false false true = ReleaseNone /\
  release_plan_of 2 true true true = ReleaseNone /\
  release_plan_of 2 true false true = ReleaseOne /\
  release_plan_of 2 true false false = ReleaseAll /\
  release_plan_of 1 true false false = ReleaseAll.
Proof. repeat split; reflexivity. Qed.

Example release_texts :
  release_one_text "claude" "3" = "the limit's wait is over: asking claude one held request first (3 held)" /\
  release_all_text "claude" "3" = "claude answers again: asking its 3 held requests".
Proof. split; reflexivity. Qed.

(** What a model's output becomes (step 5): a limit noticed, when it
    resets, how long it holds, and a reply's outcome. *)
Example is_limit_words_any_case :
  is_limit "Error: Rate Limit exceeded" = true /\
  is_limit "You've hit your limit" = true /\
  is_limit "API error (status 402 Payment Required): Grok Build usage balance exhausted" = true /\
  is_limit "RESOURCE_EXHAUSTED" = true /\
  is_limit "all good" = false /\
  is_limit "" = false.
Proof. repeat split; reflexivity. Qed.

Example is_limit_429_only_as_its_own_number :
  is_limit "429" = true /\
  is_limit "HTTP 429 Too" = true /\
  is_limit "status=429." = true /\
  is_limit "k429" = false /\
  is_limit "14290" = false /\
  is_limit "4290 k429 x" = false /\
  is_limit "k429 then 429" = true.
Proof. repeat split; reflexivity. Qed.

Example reset_in_claude_deadline :
  reset_in digits_float 1735999000%float "Claude AI usage limit reached|1736000000" = Some 1000%float /\
  reset_in digits_float 1735999000%float "Claude AI usage limit reached|1736000000
" = Some 1000%float /\
  reset_in digits_float 1736000001%float "Claude AI usage limit reached|1736000000" = None /\
  reset_in digits_float 0%float "limit|1736000000 more" = None /\
  reset_in digits_float 0%float "limit|" = None.
Proof. repeat split; reflexivity. Qed.

Example reset_in_phrases_and_units :
  reset_in digits_float 0%float "Rate limit: try again in 5 minutes" = Some 300%float /\
  reset_in digits_float 0%float "Try again in  2 hours" = Some 7200%float /\
  reset_in digits_float 0%float "quota resets in 30s" = Some 30%float /\
  reset_in digits_float 0%float "try again in 7" = Some 420%float /\
  reset_in digits_float 0%float "try again later; resets in 1h" = Some 3600%float /\
  reset_in digits_float 0%float "try again in a bit" = None /\
  reset_in digits_float 0%float "usage limit" = None /\
  reset_in digits_float 0%float "resets in 3 hours" = Some 10800%float.
Proof. repeat split; reflexivity. Qed.

Example limit_wait_and_backoff :
  limit_wait (Some 300%float) 900%float = 310%float /\
  limit_wait (Some 0%float) 900%float = 900%float /\
  limit_wait None 1800%float = 1800%float /\
  limit_next_backoff 900%float = 1800%float /\
  limit_next_backoff 3600%float = 7200%float /\
  limit_next_backoff 7200%float = 7200%float.
Proof. repeat split; reflexivity. Qed.

Example limit_log_line :
  limit_log_text "claude" "15" "usage limit" =
    "LIMIT: claude says it has hit its limit, so its model calls are held for 15 minutes: usage limit".
Proof. reflexivity. Qed.

Example reply_outcomes :
  reply_outcome_of "!process failed (exit 1): usage limit reached" (fun _ => None) =
    ReplyHold "process failed (exit 1): usage limit reached" /\
  reply_outcome_of "!boom" (fun _ => None) = ReplyError "boom" /\
  reply_outcome_of "!" (fun _ => None) = ReplyError "" /\
  reply_outcome_of "{""a"": ""quota""}" (fun _ => Some ["a", "quota"]) = ReplyFields ["a", "quota"] /\
  reply_outcome_of "sorry, rate limit" (fun _ => None) = ReplyHold "sorry, rate limit" /\
  reply_outcome_of "  hello
there " (fun _ => None) = ReplyError "the reply had no JSON object: hello there" /\
  reply_outcome_of "
 " (fun _ => None) = ReplyError "the reply was empty" /\
  reply_outcome_of "" (fun _ => None) = ReplyError "the reply was empty".
Proof. repeat split; reflexivity. Qed.

Example reply_no_json_cut_at_two_hundred :
  reply_no_json_text (append (Stdlib.Strings.String.concat "" (repeat "0123456789" 20)) "X") =
    append "the reply had no JSON object: " (append (Stdlib.Strings.String.concat "" (repeat "0123456789" 20)) "...") /\
  reply_no_json_text (Stdlib.Strings.String.concat "" (repeat "0123456789" 20)) =
    append "the reply had no JSON object: " (Stdlib.Strings.String.concat "" (repeat "0123456789" 20)).
Proof. split; reflexivity. Qed.

(** A reply with no JSON object never becomes a reply event. *)
Theorem no_json_no_reply : forall text kv,
  reply_outcome_of text (fun _ => None) <> ReplyFields kv.
Proof.
  intros text kv. unfold reply_outcome_of.
  destruct (starts "!" text); destruct (is_limit text); discriminate.
Qed.

(** A failed job never becomes a reply event either, whatever its JSON. *)
Theorem failed_job_no_reply : forall text f kv,
  starts "!" text = true -> reply_outcome_of text f <> ReplyFields kv.
Proof.
  intros text f kv H. unfold reply_outcome_of. rewrite H.
  destruct (is_limit text); discriminate.
Qed.

(** A JSON reply from a job that didn't fail is that reply, limit words or not. *)
Theorem json_reply_is_the_reply : forall text f kv,
  starts "!" text = false -> f text = Some kv -> reply_outcome_of text f = ReplyFields kv.
Proof.
  intros text f kv H J. unfold reply_outcome_of. rewrite H, J. reflexivity.
Qed.

(** A reply's JSON object: the slice from the first "{" through the last
    "}", the cap, and the shallow_json guard. Offsets and the cap are
    decimal strings, the way they cross the binding. *)
Example json_in_reply_slice_bounds_and_depth :
  json_in_reply "{""a"":{""b"":""c""}}" "15" (Some "0") (Some "14") = Some "{""a"":{""b"":""c""}}" /\
  json_in_reply "{""a"":{""b"":""c""}}" "14" (Some "0") (Some "14") = None /\
  json_in_reply "abcd" "4" (Some "0") (Some "3") = Some "abcd" /\
  json_in_reply "abcd" "3" (Some "0") (Some "3") = None /\
  json_in_reply "{""a"":1}" "100" None (Some "6") = None /\
  json_in_reply "{""a"":1}" "100" (Some "0") None = None /\
  json_in_reply "}{" "15" (Some "1") (Some "0") = None /\
  json_in_reply "{}" "15" (Some "0") (Some "0") = None /\
  json_in_reply "{}" "15" (Some "0") (Some "1") = Some "{}" /\
  json_in_reply " pre {""k"":""v""} " "100" (Some "5") (Some "13") = Some "{""k"":""v""}" /\
  json_in_reply "{{{{{x}}}}}" "100" (Some "0") (Some "10") = None /\
  json_in_reply "{{{{x}}}}" "100" (Some "0") (Some "8") = Some "{{{{x}}}}".
Proof. repeat split; reflexivity. Qed.

(** Flattened tokens: nested objects, list indices, scalars, empty and
    duplicate keys, in the old left-to-right order. *)
Example flatten_reply_shapes :
  flatten_reply ["A", "0"] = [] /\
  flatten_reply ["A", "1", "a", "A", "0"] = [] /\
  flatten_reply ["A", "1", "a", "S", "hi"] = ["a", "hi"] /\
  flatten_reply ["A", "2", "b", "S", "1", "a", "A", "1", "c", "S", "2"] = ["b", "1", "a.c", "2"] /\
  flatten_reply ["A", "1", "files", "L", "2", "A", "1", "path", "S", "a", "A", "1", "path", "S", "b"]
    = ["files.0.path", "a", "files.1.path", "b"] /\
  flatten_reply ["A", "4", "ok", "B", "true", "z", "U", "n", "I", "0", "f", "F", "2"]
    = ["ok", "true", "z", "null", "n", "0", "f", "2"] /\
  flatten_reply ["A", "1", "a", "L", "0"] = [] /\
  flatten_reply ["A", "2", "a", "S", "1", "a", "S", "2"] = ["a", "1", "a", "2"] /\
  flatten_reply ["L", "2", "I", "7", "S", "q"] = [".0", "7", ".1", "q"] /\
  flatten_reply ["A", "1", "a", "S", ""] = ["a", ""].
Proof. repeat split; reflexivity. Qed.

(** The slice and the tokens together are the fields. A slice yojson
    refuses, or no slice at all, is no fields. *)
Example reply_fields_of_nested_and_absent :
  reply_fields_of "{""a"":{""b"":""c""}}" "15" (Some "0") (Some "14")
    (fun _ => Some ["A", "1", "a", "A", "1", "b", "S", "c"]) = Some ["a.b", "c"] /\
  reply_fields_of "{x}" "10" (Some "0") (Some "2") (fun _ => None) = None /\
  reply_fields_of "no json here" "100" None None (fun _ => Some ["A", "0"]) = None /\
  reply_fields_of "{}" "1" (Some "0") (Some "1") (fun _ => Some ["A", "0"]) = None /\
  reply_fields_of "{}" "2" (Some "0") (Some "1") (fun _ => Some ["A", "0"]) = Some [].
Proof. repeat split; reflexivity. Qed.

(** No braces: there is no object, so the job is not a reply event. *)
Theorem reply_without_braces_is_not_a_reply : forall text limit tokens kv,
  reply_outcome_of text (fun _ => reply_fields_of text limit None None tokens) <> ReplyFields kv.
Proof.
  intros text limit tokens kv. unfold reply_outcome_of.
  destruct (starts "!" text).
  - destruct (is_limit text); discriminate.
  - unfold reply_fields_of, json_in_reply.
    destruct (num limit <? slen text); destruct (is_limit text); discriminate.
Qed.

(** Past the output cap: not a reply event, whatever the braces were. *)
Theorem reply_over_limit_is_not_a_reply : forall text limit open_at close_at tokens kv,
  (num limit <? slen text) = true ->
  reply_outcome_of text (fun _ => reply_fields_of text limit open_at close_at tokens) <> ReplyFields kv.
Proof.
  intros text limit open_at close_at tokens kv H. unfold reply_outcome_of.
  destruct (starts "!" text).
  - destruct (is_limit text); discriminate.
  - unfold reply_fields_of, json_in_reply. rewrite H.
    destruct (is_limit text); discriminate.
Qed.

(** A slice that parses becomes a reply whose fields are exactly the
    flattened tokens. *)
Theorem flattened_object_is_the_reply : forall text limit open_at close_at tokens raw toks,
  starts "!" text = false ->
  json_in_reply text limit open_at close_at = Some raw ->
  tokens raw = Some toks ->
  reply_outcome_of text (fun _ => reply_fields_of text limit open_at close_at tokens)
    = ReplyFields (flatten_reply toks).
Proof.
  intros text limit open_at close_at tokens raw toks H S T.
  unfold reply_outcome_of. rewrite H.
  unfold reply_fields_of. rewrite S. rewrite T. reflexivity.
Qed.

Example peer_shape_item_and_depth_boundaries :
  peer_line_shape "2" "{""x"":0}" = true /\
  peer_line_shape "1" "{""x"":0}" = false /\
  peer_line_shape "4" "{""x"":0,""y"":1}" = true /\
  peer_line_shape "3" "{""x"":0,""y"":1}" = false /\
  peer_line_shape "100" "{""x"":[[[]]]}" = true /\
  peer_line_shape "100" "{""x"":[[[[]]]]}" = false.
Proof. repeat split; reflexivity. Qed.

Example peer_wire_fields_preserve_sender_signature_and_field_order :
  peer_wire_fields "me" (fun _ => false) (Some ("peer", ("sig", ["prevote", "3", "2"]))) =
    ["peer_line", "0", "0", "peer", "sig", "prevote", "3", "2"] /\
  peer_wire_fields "me" (fun _ => false) (Some ("peer", ("sig", []))) =
    ["peer_line", "0", "0", "peer", "sig"].
Proof. split; reflexivity. Qed.

Example peer_own_and_refused_flags_precede_signature_verification :
  peer_wire_fields "me" (fun _ => false) (Some ("me", ("sig", ["tx", "raw"]))) =
    ["peer_line", "1", "0", "me", "sig", "tx", "raw"] /\
  peer_wire_fields "me" (fun raw => seq raw "bad") (Some ("peer", ("sig", ["tx", "bad"]))) =
    ["peer_line", "0", "1", "peer", "sig", "tx", "bad"] /\
  peer_wire_fields "me" (fun _ => true) (Some ("peer", ("sig", ["tx", "raw", "extra"]))) =
    ["peer_line", "0", "0", "peer", "sig", "tx", "raw", "extra"] /\
  line_dropped "1" "0" = true /\ line_dropped "0" "1" = true.
Proof. repeat split; reflexivity. Qed.

Example peer_bad_members_produce_no_event :
  peer_wire_fields "me" (fun _ => false) None = [] /\
  peer_raw_event "100" "me" "{bad}" (fun _ => None) (fun _ => false) = [] /\
  peer_raw_event "1" "me" "{""x"":0}"
    (fun _ => Some ("peer", ("sig", ["tx", "raw"]))) (fun _ => false) = [].
Proof. repeat split; reflexivity. Qed.

Theorem malformed_peer_shape_needs_no_json_members : forall cap me raw parts refused,
  peer_line_shape cap raw = false -> peer_raw_event cap me raw parts refused = [].
Proof. intros cap me raw parts refused H. unfold peer_raw_event. rewrite H. reflexivity. Qed.

(** U-1: the node's operations as one interface. The dispatch produces
    [node_op] values; each crosses the binding as its wire form, which
    reads back as the same operation (shell.ml's node_io is that match). *)
Theorem io_wire_reads_back : forall op, io_of_wire (io_wire op) = Some op.
Proof. intros op. destruct op; reflexivity. Qed.

Example io_wire_forms :
  io_wire (IoLog "hi there") = ["log", "hi there"] /\
  io_wire (IoTimer "350" ["timeout", "commit", "7", "2"]) = ["timer", "350", "timeout", "commit", "7", "2"] /\
  io_wire (IoQueue ["tx", "raw"]) = ["push", "tx", "raw"] /\
  io_wire (IoSendAll ["prevote", "1"]) = ["send_all", "prevote", "1"] /\
  io_wire (IoSendPeer "0" []) = ["send_peer", "0"] /\
  io_wire (IoPeerSend "codex" ["done", "4"]) = ["peer_send", "codex", "done", "4"] /\
  io_wire IoClock = ["clock"] /\ io_of_wire ["clock"] = Some IoClock /\
  io_of_wire ["clock", "extra"] = None /\
  io_of_wire ["log"] = None /\ io_of_wire ["log", "a", "b"] = None /\
  io_of_wire ["timer"] = None /\ io_of_wire [] = None /\ io_of_wire ["nope", "x"] = None.
Proof. repeat split; reflexivity. Qed.

Example outputs_become_operations :
  output_io ["timer", "commit", "7", "2", "350"] = Some (IoTimer "350" ["timeout", "commit", "7", "2"]) /\
  output_io ["log", "line"] = Some (IoLog "line") /\
  output_io ["timer", "commit", "7", "2"] = None /\
  output_io ["height", "3"] = None.
Proof. repeat split; reflexivity. Qed.

Example plans_become_operations :
  map action_io (reveal_plan "withhold" "4" "secret" "3") =
    [Some (IoLog "FAULT INJECTION: holding back my link for draw 3")] /\
  map action_io (reveal_plan "" "4" "secret" "2") =
    [Some (IoQueue ["local_tx", "reveal", sha256 (sha256 "secret")])] /\
  map action_io (broadcast_plan "equivocate" 2 ["proposal", "3", "1", "0", "vid", "val"] None None None) =
    [None, Some (IoSendPeer "0" ["proposal", "3", "1", "0", "vid", "val"]),
     Some (IoSendPeer "1" ["proposal", "3", "1", "0", hash_list ["equivocation", "3", "1"], "equivocation", "3", "1"])] /\
  map action_io (broadcast_plan "" 2 ["ping"] None None None) = [Some (IoSendAll ["ping"])] /\
  action_io (StoreAction "7" []) = Some (IoStore "7" []).
Proof. repeat split; reflexivity. Qed.

(** U-1: the signed-vote log, the own-transaction table, the nonce-flood
    mark, the CI check and a merge's records are operations too. *)
Example writes_and_check_travel_the_one_interface :
  io_wire (IoSignVote "prevote/1/0" "v" ["prevote", "1"]) = ["sign_vote", "prevote/1/0", "v", "prevote", "1"] /\
  io_of_wire ["sign_vote", "s", "v"] = Some (IoSignVote "s" "v" []) /\
  io_of_wire ["sign_vote", "s"] = None /\
  io_wire (IoTrackTx "raw") = ["track_tx", "raw"] /\
  io_of_wire ["track_tx", "a", "b"] = None /\
  io_wire IoMarkNonceFlood = ["mark_nonce_flood"] /\
  io_wire (IoCheck "9" "calc" "head1" ["a", "o", "n"]) = ["check", "9", "calc", "head1", "a", "o", "n"] /\
  io_of_wire ["check", "9", "calc"] = None /\
  io_wire (IoMergeApplied "calc" "2") = ["merge_applied", "calc", "2"] /\
  io_wire (IoMergeDiverged "calc" "2: boom") = ["merge_diverged", "calc", "2: boom"] /\
  io_of_wire ["merge_applied", "calc"] = None.
Proof. repeat split; reflexivity. Qed.

Example votes_floods_and_checks_become_operations :
  map action_io (broadcast_plan "" 2 ["prevote", "1", "0", "-1", "v", "nil"]
    (Some ("prevote", "1", "0", "v")) None None) =
    [Some (IoSignVote "prevote/1/0" "v" ["prevote", "1", "0", "-1", "v", "nil"]), None,
     Some (IoSendAll ["prevote", "1", "0", "-1", "v", "nil"])] /\
  map action_io (firstn 3 (submission_plan "future-nonce" false "7" ["withdraw", "0"])) =
    [None, Some IoMarkNonceFlood, Some (IoLog "FAULT INJECTION: flooding 600 future-nonce transactions")] /\
  output_io ["check", "9", "calc", "head1", "e1", "e2"] = Some (IoCheck "9" "calc" "head1" ["e1", "e2"]) /\
  output_io ["check", "9", "calc"] = None.
Proof. repeat split; reflexivity. Qed.

(** An action that is one operation is carried out as exactly that
    operation, and so are the timer and log outputs. *)
Theorem single_actions_are_their_operation : forall h action op,
  action_io action = Some op -> carry_output_action h action = io_do h op.
Proof.
  intros h action op H. destruct action; cbn in H; try discriminate H;
    injection H as <-; reflexivity.
Qed.

Theorem single_outputs_are_their_operation : forall h out op,
  output_io out = Some op -> perform_output h out = io_do h op.
Proof.
  intros h out op H. unfold output_io in H. unfold perform_output.
  destruct (plan_output out); try discriminate H; injection H as <-; reflexivity.
Qed.

(** A local transaction from the inbox: a JSON list of strings, and the
    shapes that are malformed. *)
Example inbox_tx_shapes :
  inbox_tx (Some ["L", "2", "S", "post", "S", "calc task"]) = Some ["post", "calc task"] /\
  inbox_tx (Some ["L", "0"]) = Some [] /\
  inbox_tx None = None /\
  inbox_tx (Some ["A", "0"]) = None /\
  inbox_tx (Some ["L", "2", "S", "a", "I", "3"]) = None /\
  inbox_tx (Some ["L", "1", "S", "a", "S", "b"]) = None /\
  inbox_tx (Some ["L", "2", "S", "a"]) = None /\
  inbox_tx (Some ["S", "x"]) = None.
Proof. repeat split; reflexivity. Qed.
