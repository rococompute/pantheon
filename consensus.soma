(** Consensus: Tendermint's algorithm (Buchman, Kwon and Milosevic, "The latest
    gossip on BFT consensus", 2018, Algorithm 1) as a pure state machine. It
    tolerates f faulty validators of n = 3f + 1: here 1 of 4.

    The shell authenticates every message's sender. Values are lists of
    strings (a block's transactions), voted on by their hash. A message for an
    earlier height asks the sender to catch up: the shell sends it the blocks
    it missed, as [Done] messages, and f + 1 matching ones are enough, since
    one of them is honest. *)
Import util.

Inductive kind := Proposal | Prevote | Precommit | Done.
Scheme Boolean Equality for kind.

(** [vr] is Tendermint's validRound plus one, so that 0 is its -1. [vid] is
    the hash of the value, or "" for a vote for nil. *)
Record msg := { kd : kind; frm : string; mh : nat; mr : nat; vr : nat; vid : string; value : list string }.

kind_eq (a b : kind) : bool := kind_beq a b.

kind_name (k : kind) : string :=
  match k with Proposal => "proposal" | Prevote => "prevote" | Precommit => "precommit" | Done => "done" end.

(** The state: who we are, the validators, the height and round, the step
    (0 propose, 1 prevote, 2 precommit), the locked and valid values with
    their rounds plus one, the messages of this height, and which one-time
    rules have fired. *)
Record consensus_state := {
  me : string; nodes : list string; height : nat; round : nat; step : nat;
  lockr : nat; lockv : list string; validr : nat; validv : list string;
  log : list msg; once : list string; block_ms : nat
}.

new_consensus (me : string) (nodes : list string) (h : nat) : consensus_state :=
  {| me := me; nodes := nodes; height := h; round := 0; step := 0;
     lockr := 0; lockv := []; validr := 0; validv := []; log := []; once := []; block_ms := 1000 |}.

faulty (c : consensus_state) : nat := (length (nodes c) - 1) / 3.
quorum (c : consensus_state) : nat := length (nodes c) - faulty c.
weak (c : consensus_state) : nat := faulty c + 1.

proposer (c : consensus_state) (h r : nat) : string := nth ((h + r) mod length (nodes c)) (nodes c) "".

senders (c : consensus_state) (k : kind) (r : nat) (id : string) : nat :=
  distinct (map frm (filter (fun m => kind_eq (kd m) k && (mh m =? height c) && (mr m =? r) && seq (vid m) id) (log c))).

(** The distinct signers of one commit certificate. Keep this separate from
    the count: membership heartbeats need the names, and must not count
    another height, round, value or vote kind as participation. The order
    is nodup_s's deterministic log order, not arrival-independent evidence
    suitable for insertion into a block without consensus. *)
precommitters (c : consensus_state) (r : nat) (id : string) : list string :=
  nodup_s (map frm (filter (fun m => kind_eq (kd m) Precommit && (mh m =? height c)
    && (mr m =? r) && seq (vid m) id) (log c))).

senders_any (c : consensus_state) (k : kind) (r : nat) : nat :=
  distinct (map frm (filter (fun m => kind_eq (kd m) k && (mh m =? height c) && (mr m =? r)) (log c))).

(** The proposal for round r, the first one received from its proposer. *)
proposal (c : consensus_state) (r : nat) : option msg :=
  find (fun m => kind_eq (kd m) Proposal && (mh m =? height c) && (mr m =? r) && seq (frm m) (proposer c (height c) r))
    (rev (log c)).

out (m : msg) : list string :=
  "broadcast" :: kind_name (kd m) :: show (mh m) :: show (mr m) :: show (vr m) :: vid m :: value m.

timer (name : string) (h r ms : nat) : list string := ["timer", name, show h, show r, show ms].

(** Sending a message records it as received from ourselves. *)
send (c : consensus_state) (k : kind) (vround : nat) (id : string) (v : list string) : consensus_state * list (list string) :=
  let m := {| kd := k; frm := me c; mh := height c; mr := round c; vr := vround; vid := id; value := v |} in
  ({| c with log := m :: log c |}, [out m]).

vote (c : consensus_state) (k : kind) (id : string) (next : nat) : consensus_state * list (list string) :=
  let (c', o) := send c k 0 id [] in ({| c' with step := next |}, o).

mark (c : consensus_state) (flag : string) : consensus_state := {| c with once := flag :: once c |}.
fired (c : consensus_state) (flag : string) : bool := mem flag (once c).

start_round (c : consensus_state) (r : nat) (getv : list string) : consensus_state * list (list string) :=
  let c := {| c with round := r; step := 0 |} in
  if seq (proposer c (height c) r) (me c) then
    let v := if validr c =? 0 then getv else validv c in
    send c Proposal (validr c) (hash_list v) v
  else (c, [timer "propose" (height c) r (3000 + 500 * r)]).

(** Deciding moves to the next height. The first round starts after the
    commit timer, which paces blocks and lets transactions gather. *)
decide (c : consensus_state) (v : list string) : consensus_state * list (list string) :=
  let h := height c in
  let c' := new_consensus (me c) (nodes c) (h + 1) in
  let c' := {| c' with block_ms := block_ms c |} in
  let c' := {| c' with log := filter (fun m => h <? mh m) (log c) |} in
  (c', [("decided" :: show h :: v), ["height", show (h + 1)], timer "commit" (h + 1) 0 (block_ms c)]).

(** M-3: the validators follow the roster by height. After a block is
    applied, the node enters the next height's roster, the market's
    [roster_at] for that height: a change takes effect only at a height
    after the one committing it, so the roster is fixed before the height's
    first round. Messages already logged for the new height from agents not
    on it are dropped, so no quorum counts them. The same roster leaves the
    state exactly as it was. *)
Fixpoint same_roster (a b : list string) : bool :=
  match a, b with
  | [], [] => true
  | x :: r, y :: s => seq x y && same_roster r s
  | _, _ => false
  end.

enter_roster (c : consensus_state) (roster : list string) : consensus_state :=
  if same_roster (nodes c) roster then c
  else {| c with nodes := roster; log := filter (fun m => mem (frm m) roster) (log c) |}.

(** A validator the roster doesn't name (removed, catching up, rejoining)
    takes no block as valid: it neither locks nor decides on its own vote,
    which nobody else counts, and moves on only by f + 1 matching [Done]
    messages of the roster's members. *)
member (c : consensus_state) : bool := mem (me c) (nodes c).

member_valid (c : consensus_state) (valid : list string -> bool) (v : list string) : bool :=
  member c && valid v.

can_accept (c : consensus_state) (v : list string) : bool :=
  (lockr c =? 0) || seq (hash_list (lockv c)) (hash_list v).

(** The rules of Algorithm 1, one definition each, by the lines they are in
    the paper. Each changes the step or sets a one-time flag, so none can fire
    forever. *)
step_result : Type := option (consensus_state * list (list string)).

(* lines 22-27: prevote on a fresh proposal, if it's valid and we aren't
   locked on something else *)
r_fresh (c : consensus_state) (valid : list string -> bool) : step_result :=
  match proposal c (round c) with
  | Some p =>
      if (step c =? 0) && (vr p =? 0) then
        if valid (value p) && can_accept c (value p) then Some (vote c Prevote (vid p) 1)
        else
          let (c', o) := vote c Prevote "" 1 in
          Some (c', o ++ [["log", append "prevote nil: proposal from " (append (frm p) (append " at height "
                  (append (show (height c)) (append " round " (append (show (round c))
                  (if valid (value p) then " conflicts with our lock" else " is not a valid block"))))))]])
      else None
  | None => None
  end.

(* lines 28-33: prevote on a re-proposal backed by a quorum in its valid round *)
r_reproposal (c : consensus_state) (valid : list string -> bool) : step_result :=
  match proposal c (round c) with
  | Some p =>
      if (step c =? 0) && (0 <? vr p) && (vr p <=? round c) && (quorum c <=? senders c Prevote (vr p - 1) (vid p)) then
        Some (vote c Prevote (if valid (value p) && ((lockr c <=? vr p) || seq (hash_list (lockv c)) (vid p)) then vid p else "") 1)
      else None
  | None => None
  end.

(* lines 34-35: a quorum of prevotes of any kind starts the prevote timer *)
r_prevote_timer (c : consensus_state) : step_result :=
  let flag := append "tpv" (show (round c)) in
  if (step c =? 1) && (quorum c <=? senders_any c Prevote (round c)) && negb (fired c flag) then
    Some (mark c flag, [timer "prevote" (height c) (round c) (1000 + 500 * round c)])
  else None.

(* lines 36-43: a quorum of prevotes for the proposal: lock on it and precommit *)
r_lock (c : consensus_state) (valid : list string -> bool) : step_result :=
  let r := round c in
  let flag := append "lock" (show r) in
  match proposal c r with
  | Some p =>
      if (1 <=? step c) && negb (fired c flag) && (quorum c <=? senders c Prevote r (vid p)) && valid (value p) then
        let c := mark c flag in
        let c := {| c with validr := r + 1; validv := value p |} in
        if step c =? 1 then Some (vote ({| c with lockr := r + 1; lockv := value p |}) Precommit (vid p) 2)
        else Some (c, [])
      else None
  | None => None
  end.

(* lines 44-46: a quorum of prevotes for nil *)
r_nil (c : consensus_state) : step_result :=
  if (step c =? 1) && (quorum c <=? senders c Prevote (round c) "") then Some (vote c Precommit "" 2) else None.

(* lines 47-48: a quorum of precommits of any kind starts the precommit timer *)
r_precommit_timer (c : consensus_state) : step_result :=
  let flag := append "tpc" (show (round c)) in
  if (quorum c <=? senders_any c Precommit (round c)) && negb (fired c flag) then
    Some (mark c flag, [timer "precommit" (height c) (round c) (1000 + 500 * round c)])
  else None.

(* lines 49-54: a quorum of precommits for a proposal, in any round: decide it *)
r_decide (c : consensus_state) (valid : list string -> bool) : step_result :=
  let h := height c in
  match find (fun m => kind_eq (kd m) Proposal && (mh m =? h) && seq (frm m) (proposer c h (mr m))
                       && (quorum c <=? senders c Precommit (mr m) (vid m)) && valid (value m)) (log c) with
  | Some p => Some (decide c (value p))
  | None => None
  end.

(* catching up: f + 1 validators say this height decided this value, and at
   least one of them is honest *)
r_catch_up (c : consensus_state) : step_result :=
  match find (fun m => kind_eq (kd m) Done && (mh m =? height c) && (weak c <=? senders c Done 0 (vid m))) (log c) with
  | Some d => Some (decide c (value d))
  | None => None
  end.

(* line 55: f + 1 validators are in a later round: skip to it *)
in_round (c : consensus_state) (r : nat) : nat :=
  distinct (map frm (filter (fun x => negb (kind_eq (kd x) Done) && (mh x =? height c) && (mr x =? r)) (log c))).

r_skip (c : consensus_state) (getv : list string) : step_result :=
  match find (fun m => negb (kind_eq (kd m) Done) && (mh m =? height c) && (round c <? mr m) && (weak c <=? in_round c (mr m))) (log c) with
  | Some m => Some (start_round c (mr m) getv)
  | None => None
  end.

orelse (a : step_result) (b : unit -> step_result) : step_result :=
  match a with Some x => Some x | None => b tt end.

rule (c : consensus_state) (valid : list string -> bool) (getv : list string) : step_result :=
  orelse (r_fresh c valid) (fun _ =>
  orelse (r_reproposal c valid) (fun _ =>
  orelse (r_prevote_timer c) (fun _ =>
  orelse (r_lock c valid) (fun _ =>
  orelse (r_nil c) (fun _ =>
  orelse (r_precommit_timer c) (fun _ =>
  orelse (r_decide c valid) (fun _ =>
  orelse (r_catch_up c) (fun _ =>
  r_skip c getv)))))))).

(** Applies rules until none does, or until a decision: the caller then
    applies the block, so that the next height's rules judge values against
    the new state. *)
Fixpoint settle (fuel : nat) (c : consensus_state) (valid : list string -> bool) (getv : list string) (outs : list (list string)) : consensus_state * list (list string) :=
  match fuel with
  | 0 => (c, outs)
  | Succ k =>
      match rule c (member_valid c valid) getv with
      | Some (c', o) => if height c' =? height c then settle k c' valid getv (outs ++ o) else (c', outs ++ o)
      | None => (c, outs)
      end
  end.

kind_of (s : string) : option kind :=
  if seq s "proposal" then Some Proposal else if seq s "prevote" then Some Prevote
  else if seq s "precommit" then Some Precommit else if seq s "done" then Some Done else None.

(** A message from a peer, already authenticated by the shell:
    [kind; h; r; vr; vid; value...]. Junk, duplicates, a proposal or block whose
    hash isn't its id, and messages too far ahead are dropped, and so is a
    third message from one sender for one kind and round. *)
receive (c : consensus_state) (from : string) (fields : list string) : consensus_state * list (list string) :=
  match fields with
  | k :: h :: r :: vround :: id :: v =>
      match kind_of k, num_opt h, num_opt r, num_opt vround with
      | Some kd', Some h', Some r', Some vr' =>
          let m := {| kd := kd'; frm := from; mh := h'; mr := r'; vr := vr'; vid := id; value := v |} in
          let same := filter (fun x => kind_eq (kd x) kd' && seq (frm x) from && (mh x =? mh m) && (mr x =? mr m)) (log c) in
          if mh m <? height c then
            (if kind_eq kd' Done then (c, []) else (c, [["behind", from, show (mh m)]]))
          else if (height c + 1 <? mh m) || (round c + 50 <? mr m) || negb (mem from (nodes c)) then (c, [])
          else if existsb (fun x => seq (vid x) id) same || (2 <=? length same) then (c, [])
          else if (kind_eq kd' Proposal || kind_eq kd' Done) && negb (seq id (hash_list v)) then (c, [])
          else ({| c with log := firstn 4000 (m :: log c) |}, [])
      | _, _, _, _ => (c, [])
      end
  | _ => (c, [])
  end.

(** Started again from a snapshot, in the round it was in: the timers that
    round had going, which didn't outlive the process. The propose timer
    when no prevote was cast yet; the prevote and precommit timers when
    they had started (their one-time flags). The node's own messages are
    sent again by the node (node.soma's [resume_signed_prog]), and the
    others' come again with their resends. Going on to the next round
    instead left a node alone in it: with exactly a quorum up, the others,
    who had voted in the round it left, waited there for its vote, and one
    node in a later round isn't f + 1. *)
resume_timers (c : consensus_state) : list (list string) :=
  let h := height c in
  let r := round c in
  (if step c =? 0 then [timer "propose" h r (3000 + 500 * r)] else []) ++
  (if fired c (append "tpv" (show r)) then [timer "prevote" h r (1000 + 500 * r)] else []) ++
  (if fired c (append "tpc" (show r)) then [timer "precommit" h r (1000 + 500 * r)] else []).

(** A timer went off: [name; h; r]. *)
timeout (c : consensus_state) (fields : list string) (getv : list string) : consensus_state * list (list string) :=
  match fields with
  | name :: h :: r :: _ =>
      match num_opt h, num_opt r with
      | Some h', Some r' =>
          let same := (h' =? height c) && (r' =? round c) in
          if seq name "propose" && same && (step c =? 0) then vote c Prevote "" 1
          else if seq name "prevote" && same && (step c =? 1) then vote c Precommit "" 2
          else if seq name "precommit" && same then start_round c (round c + 1) getv
          else if seq name "commit" && (h' =? height c) && (round c =? 0) && (step c =? 0) then start_round c 0 getv
          else (c, [])
      | _, _ => (c, [])
      end
  | _ => (c, [])
  end.

(** M-3 heartbeat validation prerequisite. Certificates must come from agreed
    blocks, newest first, one per consecutive height. A local message log is
    not such a history: different honest nodes may see different certificates.
    These helpers do not change membership or authorize a removal themselves. *)
Fixpoint missed_blocks (agent : string) (certificates : list (list string)) : nat :=
  match certificates with
  | [] => 0
  | signers :: rest => if mem agent signers then 0 else Succ (missed_blocks agent rest)
  end.

(** Zero disables absence proposals. Only current members are candidates;
    min_roster and the delayed, committed transaction still need checking. *)
removal_candidates (roster : list string) (absent_blocks : nat)
    (certificates : list (list string)) : list string :=
  filter (fun a => (0 <? absent_blocks) && (absent_blocks <=? missed_blocks a certificates))
    (nodup_s roster).

(** M-3 portable evidence, not a claimed signer list. Keep the exact signed
    fields: signatures authenticate their bytes, including numeric spelling.
    [verify] has node_verify_line's interface, already bound to this chain and
    its genesis keys. [c] is the PREVIOUS height's consensus roster; its value
    is the actual previous block. Transport/persistence are not wired yet. *)
Record signed_precommit := {
  commit_signer : string;
  commit_signature : string;
  commit_fields : list string
}.

precommit_shape (c : consensus_state) (r : nat) (id : string)
    (vote : signed_precommit) : bool :=
  match commit_fields vote with
  | ["precommit", ht, rd, valid_round, value_id] =>
      match num_opt ht, num_opt rd, num_opt valid_round with
      | Some h, Some round, Some vr =>
          mem (commit_signer vote) (nodes c) && (h =? height c) && (round =? r) &&
          (vr =? 0) && seq value_id id
      | _, _, _ => false
      end
  | _ => false
  end.

(** Canonical genesis/roster order, independent of certificate arrival order.
    Every included name is distinct, even before checking the certificate. *)
commit_names (c : consensus_state) (votes : list signed_precommit) : list string :=
  filter (fun a => mem a (map commit_signer votes)) (nodup_s (nodes c)).

commit_evidence_ok (verify : string -> string -> list string -> bool)
    (c : consensus_state) (r : nat) (previous_block : list string)
    (votes : list signed_precommit) : bool :=
  let id := hash_list previous_block in
  (0 <? height c) && (0 <? length (nodes c)) && negb (seq id "") &&
  (length votes <=? length (nodes c)) &&
  (length (nodup_s (map commit_signer votes)) =? length votes) &&
  (quorum c <=? length (commit_names c votes)) &&
  forallb (fun vote => precommit_shape c r id vote &&
      verify (commit_signer vote) (commit_signature vote) (commit_fields vote)) votes.

validate_commit_evidence (verify : string -> string -> list string -> bool)
    (c : consensus_state) (r : nat) (previous_block : list string)
    (votes : list signed_precommit) : option (list string) :=
  if commit_evidence_ok verify c r previous_block votes then Some (commit_names c votes) else None.

Record heartbeat_record := {
  heartbeat_height : nat;
  heartbeat_value : string;
  heartbeat_signers : list string
}.

(** One record per consecutive height, starting at 1. No optional heartbeat
    entries may bridge gaps or replay an old certificate. The input prefix
    must already be validated AND agreed on chain; a local log is not one. *)
heartbeat_follows (h : nat) (records : list heartbeat_record) : bool :=
  match records with [] => h =? 1 | latest :: _ => h =? S (heartbeat_height latest) end.

append_commit_evidence (verify : string -> string -> list string -> bool)
    (c : consensus_state) (r : nat) (previous_block : list string)
    (votes : list signed_precommit) (records : list heartbeat_record)
    : option (list heartbeat_record) :=
  if heartbeat_follows (height c) records then
    match validate_commit_evidence verify c r previous_block votes with
    | None => None
    | Some names => Some ({| heartbeat_height := height c;
          heartbeat_value := hash_list previous_block; heartbeat_signers := names |} :: records)
    end
  else None.

(** Certified, bounded history from chain lookups. [agreed_at h] must read
    the certificate for h committed in block h+1, never a local vote cache.
    [block_at] reads the actual block at h. This boundary checks their height,
    value, signatures and roster; no peer availability view is an input. *)
Record commit_certificate := {
  certificate_height : nat;
  certificate_round : nat;
  certificate_votes : list signed_precommit
}.

consensus_at_height (who : string) (roster_of : nat -> list string) (h : nat) : consensus_state :=
  new_consensus who (roster_of h) h.

verify_height_certificate (verify : string -> string -> list string -> bool)
    (roster_of : nat -> list string) (block_at : nat -> option (list string))
    (h : nat) (cert : commit_certificate) : option (list string) :=
  if certificate_height cert =? h then
    match block_at h with
    | None => None
    | Some block => validate_commit_evidence verify (consensus_at_height "" roster_of h)
                      (certificate_round cert) block (certificate_votes cert)
    end
  else None.

Fixpoint certified_commit_window (verify : string -> string -> list string -> bool)
    (roster_of : nat -> list string) (block_at : nat -> option (list string))
    (agreed_at : nat -> option commit_certificate) (latest count : nat) {struct count}
    : option (list (list string)) :=
  match count with
  | 0 => Some []
  | S rest =>
      if latest =? 0 then None else
      match agreed_at latest with
      | None => None
      | Some cert => match verify_height_certificate verify roster_of block_at latest cert with
          | None => None
          | Some names => match certified_commit_window verify roster_of block_at agreed_at (latest - 1) rest with
              | None => None | Some older => Some (names :: older) end
          end
      end
  end.

(** M-3 transport prerequisite. A certificate is a list of string fields,
    with a versioned header and seven fields per signed witness. No delimiter
    is inserted into signed bytes. Decoding is structural only: callers must
    still use verify_height_certificate before trusting participation. *)
Fixpoint encode_commit_votes (votes : list signed_precommit) : option (list string) :=
  match votes with
  | [] => Some []
  | v :: rest =>
      match commit_fields v, encode_commit_votes rest with
      | [k, h, r, vr, id], Some tail =>
          Some (commit_signer v :: commit_signature v :: k :: h :: r :: vr :: id :: tail)
      | _, _ => None
      end
  end.

Fixpoint decode_commit_votes (fuel : nat) (fields : list string) : option (list signed_precommit) :=
  match fields with
  | [] => Some []
  | a :: sg :: k :: h :: r :: vr :: id :: rest =>
      match fuel with
      | 0 => None
      | S remaining => match decode_commit_votes remaining rest with
          | Some votes => Some ({| commit_signer := a; commit_signature := sg;
                                   commit_fields := [k, h, r, vr, id] |} :: votes)
          | None => None
          end
      end
  | _ => None
  end.

encode_commit_certificate (cert : commit_certificate) : option (list string) :=
  match encode_commit_votes (certificate_votes cert) with
  | Some votes => Some (["commit-v1", show (certificate_height cert), show (certificate_round cert)] ++ votes)
  | None => None
  end.

decode_commit_certificate (fields : list string) : option commit_certificate :=
  match fields with
  | "commit-v1" :: h :: r :: rest =>
      match num_opt h, num_opt r, decode_commit_votes (length rest) rest with
      | Some ht, Some rd, Some votes => Some {| certificate_height := ht;
          certificate_round := rd; certificate_votes := votes |}
      | _, _, _ => None
      end
  | _ => None
  end.

(** M-3 block framing prerequisite. A certificate is part of the voted block,
    before its transactions, with an explicit field count. Signed fields and
    transaction strings are never split on delimiters. This opt-in envelope
    is not yet used by build_block/block_ok or live persistence. *)
frame_commit_block (cert : commit_certificate) (txs : list string) : option (list string) :=
  match encode_commit_certificate cert with
  | None => None
  | Some fields => Some (["heartbeat-v1", show (length fields)] ++ fields ++ txs)
  end.

unframe_commit_block (block : list string) : option (commit_certificate * list string) :=
  match block with
  | "heartbeat-v1" :: size :: rest =>
      match num_opt size with
      | None => None
      | Some n => if n <=? length rest then
          match decode_commit_certificate (firstn n rest) with
          | None => None | Some cert => Some (cert, skipn n rest) end
        else None
      end
  | _ => None
  end.

(** Adapter for certified_commit_window/commit_certified_roster_fields.
    The caller MUST supply committed blocks, indexed by their own heights.
    Certificate h is read only from block h+1, never from a peer/local cache.
    Decoding is not verification: the existing certified window authenticates
    every returned witness against block h and roster_of h. *)
chain_commit_at (block_at : nat -> option (list string)) (h : nat)
    : option commit_certificate :=
  if h =? 0 then None else
  match block_at (S h) with
  | None => None
  | Some block => match unframe_commit_block block with
      | None => None
      | Some (cert, _) => if certificate_height cert =? h then Some cert else None
      end
  end.

(** A certificate has three header fields and seven per witness. Bound the
    declared certificate section before copying or decoding it; transaction
    strings after that section are not part of this limit. This reuses the
    committed block envelope and codec rather than defining another format. *)
bounded_commit_block (limit : nat) (block : list string)
    : option (commit_certificate * list string) :=
  match block with
  | tag :: size :: _ =>
      if seq tag "heartbeat-v1" then
        match num_opt size with
        | Some n => if n <=? 3 + 7 * limit then unframe_commit_block block else None
        | None => None
        end
      else None
  | _ => None
  end.

(** At the start of candidate height [before], only earlier carriers count.
    Check this before consulting the chain lookup. The lookup must read the
    unique committed block at its index, never a peer cache. The certificate
    belongs to h and its bound uses roster_of h, not its carrier's roster.
    Structural decoding still does not authenticate any participation. *)
prior_chain_commit_at (roster_of : nat -> list string)
    (block_at : nat -> option (list string)) (before h : nat)
    : option commit_certificate :=
  if (0 <? h) && (S h <? before) then
    match block_at (S h) with
    | None => None
    | Some block => match bounded_commit_block (length (roster_of h)) block with
        | None => None
        | Some (cert, _) => if certificate_height cert =? h then Some cert else None
        end
    end
  else None.

certified_chain_window (verify : string -> string -> list string -> bool)
    (roster_of : nat -> list string) (block_at : nat -> option (list string))
    (before count : nat) : option (list (list string)) :=
  certified_commit_window verify roster_of block_at
    (prior_chain_commit_at roster_of block_at before) (before - 2) count.
