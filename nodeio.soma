(** The node's I/O as one interface (U-1; docs/SHELL-IN-SOMA.md, "Two
    directions, and the unikernel"). Nothing here imports the shell: these
    are values, which the binary interprets through shell.ml (node.soma's
    [run_shell] over the [node_io] binding) and a unikernel can interpret
    with Sandbox (node_sandbox.soma). *)
From Corelib Require PrimFloat.
From Corelib Require PrimInt63.
Require Crypto.

(** Maps by a string key: AVL trees in the order of [String.compare] (the
    binary runs it as OCaml's string comparison, the same order). The
    node's stores are as long as its chain, so a list would cost a scan of
    every block on each one stored, and on each one replayed at startup.
    Their own, not Stdlib's FMapAVL, whose names (height, cons, ...) made
    extraction rename the node's own record fields. *)
Inductive smap (A : Type) : Type :=
| SLeaf
| SNode (l : smap A) (k : string) (v : A) (r : smap A) (h : nat).
Arguments SLeaf {A}.
Arguments SNode {A} l k v r h.

smap_h {A : Type} (m : smap A) : nat := match m with SLeaf => 0 | SNode _ _ _ _ h => h end.

smap_node {A : Type} (l : smap A) (k : string) (v : A) (r : smap A) : smap A :=
  SNode l k v r (S (Nat.max (smap_h l) (smap_h r))).

(** one rotation, or two, when one side is more than one taller *)
smap_balance {A : Type} (l : smap A) (k : string) (v : A) (r : smap A) : smap A :=
  let hl := smap_h l in let hr := smap_h r in
  if Nat.ltb (S hr) hl then
    match l with
    | SNode ll lk lv lr _ =>
        if Nat.leb (smap_h lr) (smap_h ll) then smap_node ll lk lv (smap_node lr k v r)
        else match lr with
             | SNode lrl lrk lrv lrr _ => smap_node (smap_node ll lk lv lrl) lrk lrv (smap_node lrr k v r)
             | SLeaf => smap_node l k v r
             end
    | SLeaf => smap_node l k v r
    end
  else if Nat.ltb (S hl) hr then
    match r with
    | SNode rl rk rv rr _ =>
        if Nat.leb (smap_h rl) (smap_h rr) then smap_node (smap_node l k v rl) rk rv rr
        else match rl with
             | SNode rll rlk rlv rlr _ => smap_node (smap_node l k v rll) rlk rlv (smap_node rlr rk rv rr)
             | SLeaf => smap_node l k v r
             end
    | SLeaf => smap_node l k v r
    end
  else smap_node l k v r.

Fixpoint smap_add {A : Type} (k : string) (v : A) (m : smap A) : smap A :=
  match m with
  | SLeaf => SNode SLeaf k v SLeaf 1
  | SNode l k' v' r h =>
      match Stdlib.Strings.String.compare k k' with
      | Lt => smap_balance (smap_add k v l) k' v' r
      | Gt => smap_balance l k' v' (smap_add k v r)
      | Eq => SNode l k v r h
      end
  end.

Fixpoint smap_find {A : Type} (k : string) (m : smap A) : option A :=
  match m with
  | SLeaf => None
  | SNode l k' v r _ =>
      match Stdlib.Strings.String.compare k k' with
      | Lt => smap_find k l
      | Gt => smap_find k r
      | Eq => Some v
      end
  end.

smap_mem {A : Type} (k : string) (m : smap A) : bool := match smap_find k m with Some _ => true | None => false end.

(** the keys, in order, before [acc] *)
Fixpoint smap_keys_onto {A : Type} (m : smap A) (acc : list string) : list string :=
  match m with SLeaf => acc | SNode l k _ r _ => smap_keys_onto l (k :: smap_keys_onto r acc) end.

Fixpoint smap_size {A : Type} (m : smap A) : nat :=
  match m with SLeaf => 0 | SNode l _ _ r _ => S (smap_size l + smap_size r) end.

(** ---- U-1: the node's I/O as one interface (docs/SHELL-IN-SOMA.md,
    "Two directions, and the unikernel") ----
    The node's effects are values of [node_op], as a Sandbox program's are
    values of Sandbox.io: shell.ml interprets them for the binary through
    one binding, [node_io], and Sandbox could interpret the same values for
    a unikernel. So far: logging, a timer, queueing an event for the loop,
    and sending on peer links (to every peer, to the peer at an index, to a
    peer by name), and the storage writes: storing a decided block, setting
    the height and writing the assembled status file, the signed-vote log,
    the own-transaction retry table and nonce-flood mark, a CI check
    request, and a merge's applied version or divergence. The clock is a read
    of the same interface: interpreting it yields the time, the same
    [Unix.gettimeofday] value as before. Table reads, git, model and CI
    jobs are still bindings of their own: the next parts of U-1. An operation crosses the binding as its
    wire form ([io_wire]), since a .definition takes no Soma inductive;
    [io_of_wire] reads it back, and shell.ml's [node_io] does exactly that
    match. An effect's result is [(true, 0)]; the clock's is [(true, now)]. *)
Inductive node_op :=
| IoLog (text : string)
| IoTimer (ms : string) (event : list string)
| IoQueue (event : list string)
| IoSendAll (fields : list string)
| IoSendPeer (index : string) (fields : list string)
| IoPeerSend (who : string) (fields : list string)
| IoStore (height : string) (txs : list string)
| IoSetHeight (height : string)
| IoWriteStatus (text : string)
| IoSignVote (slot vid : string) (fields : list string)
| IoTrackTx (raw : string)
| IoMarkNonceFlood
| IoCheck (id repo head : string) (edits : list string)
| IoMergeApplied (repo version : string)
| IoMergeDiverged (repo entry : string)
| IoClock
| IoRememberBroadcast (height kind : string) (fields alternate : list string)
(** peer links and job control (U-1): admit, refuse or evict for an
    offered connection, close a connection, kill a job whose output went
    over its cap or that ran past its limit *)
| IoConnAdmit (offer mode target : string)
| IoConnClose (conn : string)
| IoJobFlood (job : string)
| IoJobExpire (job : string)
| IoPeerExists (who : string)
| IoNonceFlooded
| IoIsDiverged (repo : string)
| IoServedAt (who first : string)
| IoMarkServed (who first timestamp : string)
(** reads with data (U-1): the byzantine behavior and the draw's chain
    ([byz, limit, secret]), a stored block's transactions (found or not),
    the height, the number of peers, the vote signed at a slot and the
    message it was signed in, every message signed at a height (framed: what
    catch-up sends again), a transaction signed with the node's key,
    and the check exclusions (the --no-check repositories, then the
    genesis scope's, framed as resend memory is) *)
| IoDraw
| IoBlock (height : string)
| IoHeight
| IoPeerCount
| IoSignedVote (slot : string)
| IoSignedBody (slot : string)
| IoSignedAt (height : string)
| IoEncodeTx (nonce : string) (fields : list string)
| IoCheckExclusions
(** the status file's facts (U-1): each checkout's head and the diverged
    repositories (pairs, flattened: [repo, value, ...]), the model limit
    (the time it lasts until, then [backend, held requests, reason]), and
    a time of day as hours and minutes (for a timestamp in
    node_float_wire's text) *)
| IoCheckoutHeads
| IoDivergences
| IoLimitInfo
| IoLocalTime (stamp : string)
(** a merge's checkout work (U-1): the version applied to a repository
    (found or not: not, for a repository this node doesn't have); reset
    the checkout; look at a path ([kind]: "symlink", "dir", "file" or
    "none"); read a file (found or not); write or remove one ([why] it
    failed, "" if it didn't); commit the merge (found or not: [tree,
    short hash]) *)
| IoAppliedVersion (repo : string)
| IoMergeReset (repo : string)
| IoMergeProbe (repo path : string)
| IoMergeRead (repo path : string)
| IoMergeWrite (repo path text : string)
| IoMergeRemove (repo path : string)
| IoMergeCommit (repo version tree bid task bidder spec : string)
(** a model call's work (U-1): the call count, bumped for this call, and
    the budget ([calls, max]); holding a raw request until the limit is
    over (it comes back as an llm_release event); starting the model
    process (found: the raw output event at once, as when it couldn't
    start; not found: it runs); a cmd: patch's tool checkout ([worktree,
    git directory, "true" or "false"]); the node's own binary; the
    environment; the governed repositories; a
    checkout's git ls-files; a file at a checkout's head (found or not) *)
| IoLlmBudget
| IoLlmHold (id kind prompt : string) (ctx : list string)
| IoLlmStart (id kind raw prompt : string) (ctx clean launch env : list string)
| IoToolCheckout (repo : string)
| IoSelfExe
| IoEnvEntries
| IoRepoNames
| IoLsFiles (repo : string)
| IoHeadFile (repo path : string)
(** what a model's output becomes (U-1): noting a limit (until when and
    the next backoff, in node_float_wire's text, and its reason; the probe
    is over) or clearing it (the backoff after an answer); the backoff and
    whether a release is probing (the backoff, then ["true"] or
    ["false"]); the held requests, newest first, and storing them (each
    [id, kind, prompt, ctx...], framed by [nio_frame_lists]); a finished
    job resumed with its outcome, and CI started for a tree (the events
    each queued, framed); a file's text (found or not) and removing a file
    (no matter whether it's there) *)
| IoLimitSet (until reason backoff : string)
| IoLimitClear (backoff : string)
| IoReleaseState
| IoHeldRequests
| IoHeldStore (probing : string) (requests : list (list string))
| IoJobComplete (job result : string)
| IoCiLaunch (id out tree ci : string)
| IoReadText (path : string)
| IoDiscardFile (path : string)
(** the event loop's own reads and writes (U-1): a refused transaction
    noted, this node's name, whether a transaction was refused before, a
    peer line's signature checked (from, signature, fields); the
    connections ([conn, last read], framed); dialing and resending before
    a turn; the inbox's last poll and directory (the time, then [dir]) and
    its poll noted; a directory's names, removing a file (both need no
    node); the turn's clock; the timers ([deadline, event...], framed;
    deadlines in node_float_wire's text) and storing them; the jobs ([id,
    started, limit, stopped], framed); whether the queue is empty; and one
    select, waiting at most the seconds given (the events, framed) *)
| IoRefuse (raw : string)
| IoIdentity
| IoSeenRefused (raw : string)
| IoPeerKey (who : string)
| IoConns
| IoPollPrep
| IoInboxState
| IoInboxStamp (stamp : string)
| IoDirEntries (path : string)
| IoTurnNow
| IoTimers
| IoSetTimers (timers : list (list string))
| IoJobs
| IoQueueEmpty
| IoEvents (wait : string)
(** startup (U-1): the boot events (genesis, blocks.log's text, the goal,
    the backend; framed), how many blocks were replayed, a replayed block
    remembered for catch-up without appending it again (whether it was),
    signed.log's text ("" when there is none), a vote read back from it
    noted without appending it again, and refusing to start (the message
    on stderr, exit 1: the binary never answers) *)
| IoBootEvents
| IoReplayCount
| IoRememberBlock (height : string) (txs : list string)
| IoSignedText
| IoSignedRestore (slot vid : string) (fields : list string)
| IoFail (message : string)
(** the commands' I/O (cli.soma; their timestamped lines are [IoLog]'s and
    the files they write [IoSave]'s): plain output, an exit status; files
    and directories; this directory; a new RSA key (e = 65537: [size, n, e,
    d, p, q, dp, dq, qinv], hex) and random bytes as hex (a job's fence
    token is 8 of them); git in a checkout (its output), a clone at a
    commit; starting nodes and waiting for them *)
| IoPrint (text : string)
| IoExit (code : string)
| IoFileExists (path : string)
| IoChmod (path mode : string)
| IoMakeDirs (path : string)
| IoCwd
| IoNewKey (bits : string)
| IoRandomHex (count : string)
| IoGit (dir : string) (args : list string)
| IoClone (url dir commit : string)
| IoSpawnNode (log : string) (args : list string)
| IoAwaitNodes (pids : list string)
(** the edits machinery's file and git work (cli.soma's edits_prog,
    checkout_edits_prog and check_tree_prog decide; they need no node): a
    path's kind, without following its last part ([kind, exec]: "file",
    "dir", "symlink", "other" or "none", then "true" when its owner may
    run it); a path in a directory, looked at as a merge's
    [IoMergeProbe] does ([kind]: "symlink" when a part of it is one, else
    "dir", "file" or "none"); writing it, keeping its mode, and removing it
    ([why] it failed, "" if it didn't); a new temporary directory; removing
    a directory's tree, later; git with the environment's entries [extra]
    first, reading [stdin] on its standard input ("": none) (git's output,
    and whether it succeeded) *)
| IoPathStat (path : string)
| IoPathProbe (dir path : string)
| IoPathWrite (dir path text : string)
| IoPathRemove (dir path : string)
| IoTempDir (prefix : string)
| IoRemoveTree (path : string)
| IoGitEnv (dir stdin : string) (extra args : list string)
(** processes (U-1; node_host.soma keeps the jobs): one started from the
    directory [cwd], [stdin] its standard input and [env] its environment
    (found: the runner's name for it; not found: why it couldn't start),
    its output and end coming back as [job_bytes] and [job_ended] events;
    one killed; a program run to its end with the user's environment (its
    output, and whether it succeeded); a new private temporary file with
    [text] in it (its path) *)
| IoProcStart (prog stdin cwd : string) (env args : list string)
| IoProcKill (job : string)
| IoRun (prog : string) (args : list string)
| IoTempFile (prefix suffix text : string)
(** the binary runner's (node_net.soma): the host's sockets by name and
    the node's files by path, which carry out the kernel's [IoNet*] and
    [IoFile*] and the service's [IoServe*] there (a file written whole,
    [IoSave], is the commands' too) *)
| IoSockListen (host port backlog : string)
| IoSockDial (host port : string)
| IoSockSelect (ms : string) (reads writes : list string)
| IoSockAccept (fd nonblock : string)
| IoSockRead (fd : string)
| IoSockWrite (fd data : string)
| IoSockError (fd : string)
| IoSockClose (fd : string)
| IoSave (path durable text : string)
| IoAppendSynced (path text : string)
| IoNoSigpipe
| IoSpawn (prog stdin cwd : string) (env args : list string)
| IoWaitPid (pid : string)
| IoKillPid (pid : string)
(** the consensus snapshot (node.soma's snapshot_text): saved atomically
    and synced before any vote it holds is sent; consensus.state's text,
    absent when there is none *)
| IoSnapshotSave (text : string)
| IoSnapshotLoad
(** the node's service ([pantheon service], node.soma's [service_prog]),
    for a unikernel: listening at an address and port; the next request
    (found or not within [wait] seconds: its connection, then its fields:
    the token and an operation's wire form); the answer sent back on that
    connection, as found, the float's text and its data *)
| IoServeListen (address port : string)
| IoServeNext (wait : string)
| IoServeReply (conn found stamp : string) (fields : list string)
(** the kernel's primitives (node_kernel.soma): what it asks of whatever
    runs it, named after Sandbox's own, which the unikernel does them
    with and shell.ml does them with for the binary. Listening on an
    address and port (not found: why, in its data); what came in on the
    connections since the last look, waiting [ms] milliseconds at most
    when nothing has (framed: ["opened", CONN, HOST], ["bytes", CONN,
    DATA], ["closed", CONN]); a connection opened (found: its name; it
    doesn't wait for the other side, giving up after [ms] if it must
    wait); bytes written on one (not found: it is closed); closing one;
    and the node's named files ([name] in its home, or the unikernel's
    storage device): read (found or not), written whole (synced to disk
    before the answer when [durable] is "true") and appended to (synced:
    blocks.log and signed.log must survive a crash whole) *)
| IoNetListen (address port : string)
| IoNetMailbox (ms : string)
| IoNetConnect (address port ms : string)
| IoNetSend (conn data : string)
| IoNetClose (conn : string)
| IoFileRead (name : string)
| IoFileWrite (name durable text : string)
| IoFileAppend (name text : string).

(** Two arbitrary lists on one wire: tagged field/value pairs, then the
    alternate-list marker. A marker occurring as a value is never a tag.
    This avoids a bounded decimal count in the total round-trip property. *)
Fixpoint resend_fields (fields : list string) : list string :=
  match fields with [] => [] | field :: rest => "field" :: field :: resend_fields rest end.

(** Lists of lists on one wire: each list's values tagged "field", then
    "alternate"; [nio_lists] reads them back (node.proof's
    nio_lists_reads_frames). *)
Fixpoint nio_frame_lists (ls : list (list string)) : list string :=
  match ls with
  | [] => []
  | l :: rest => resend_fields l ++ ("alternate" :: nio_frame_lists rest)
  end.

Fixpoint nio_lists_acc (w cur : list string) : list (list string) :=
  match w with
  | "field" :: v :: rest => nio_lists_acc rest (v :: cur)
  | "alternate" :: rest => List.rev cur :: nio_lists_acc rest []
  | _ => []
  end.

nio_lists (w : list string) : list (list string) := nio_lists_acc w [].

Fixpoint resend_parts (wire : list string) : option (list string * list string) :=
  match wire with
  | "alternate" :: alternate => Some ([], alternate)
  | "field" :: value :: rest =>
      match resend_parts rest with Some (fields, alternate) => Some (value :: fields, alternate) | None => None end
  | _ => None
  end.

io_wire (op : node_op) : list string :=
  match op with
  | IoLog text => ["log", text]
  | IoTimer ms ev => "timer" :: ms :: ev
  | IoQueue ev => "push" :: ev
  | IoSendAll fields => "send_all" :: fields
  | IoSendPeer index fields => "send_peer" :: index :: fields
  | IoPeerSend who fields => "peer_send" :: who :: fields
  | IoStore height txs => "store" :: height :: txs
  | IoSetHeight height => ["set_height", height]
  | IoWriteStatus text => ["write_status", text]
  | IoSignVote slot vid fields => "sign_vote" :: slot :: vid :: fields
  | IoTrackTx raw => ["track_tx", raw]
  | IoMarkNonceFlood => ["mark_nonce_flood"]
  | IoCheck id repo head edits => "check" :: id :: repo :: head :: edits
  | IoMergeApplied repo version => ["merge_applied", repo, version]
  | IoMergeDiverged repo entry => ["merge_diverged", repo, entry]
  | IoClock => ["clock"]
  | IoRememberBroadcast height kind fields alternate =>
      ["remember_broadcast", height, kind] ++ resend_fields fields ++ ("alternate" :: alternate)
  | IoConnAdmit offer mode target => ["conn_admit", offer, mode, target]
  | IoConnClose conn => ["conn_close", conn]
  | IoJobFlood job => ["job_flood", job]
  | IoJobExpire job => ["job_expire", job]
  | IoPeerExists who => ["peer_exists", who]
  | IoNonceFlooded => ["nonce_flooded"]
  | IoIsDiverged repo => ["is_diverged", repo]
  | IoServedAt who first => ["served_at", who, first]
  | IoMarkServed who first timestamp => ["mark_served", who, first, timestamp]
  | IoDraw => ["draw"]
  | IoBlock height => ["block", height]
  | IoHeight => ["height"]
  | IoPeerCount => ["peer_count"]
  | IoSignedVote slot => ["signed_vote", slot]
  | IoSignedBody slot => ["signed_body", slot]
  | IoSignedAt height => ["signed_at", height]
  | IoEncodeTx nonce fields => "encode_tx" :: nonce :: fields
  | IoCheckExclusions => ["check_exclusions"]
  | IoCheckoutHeads => ["checkout_heads"]
  | IoDivergences => ["divergences"]
  | IoLimitInfo => ["limit_info"]
  | IoLocalTime stamp => ["local_time", stamp]
  | IoAppliedVersion repo => ["applied_version", repo]
  | IoMergeReset repo => ["merge_reset", repo]
  | IoMergeProbe repo path => ["merge_probe", repo, path]
  | IoMergeRead repo path => ["merge_read", repo, path]
  | IoMergeWrite repo path text => ["merge_write", repo, path, text]
  | IoMergeRemove repo path => ["merge_remove", repo, path]
  | IoMergeCommit repo version tree bid task bidder spec =>
      ["merge_commit", repo, version, tree, bid, task, bidder, spec]
  | IoLlmBudget => ["llm_budget"]
  | IoLlmHold id kind prompt ctx => "llm_hold" :: id :: kind :: prompt :: ctx
  | IoLlmStart id kind raw prompt ctx clean launch env =>
      ["llm_start", id, kind, raw, prompt] ++ resend_fields ctx ++ ("alternate" ::
        resend_fields clean ++ ("alternate" :: resend_fields launch ++ ("alternate" :: env)))
  | IoToolCheckout repo => ["tool_checkout", repo]
  | IoSelfExe => ["self_exe"]
  | IoEnvEntries => ["env_entries"]
  | IoRepoNames => ["repo_names"]
  | IoLsFiles repo => ["ls_files", repo]
  | IoHeadFile repo path => ["head_file", repo, path]
  | IoLimitSet until reason backoff => ["limit_set", until, reason, backoff]
  | IoLimitClear backoff => ["limit_clear", backoff]
  | IoReleaseState => ["release_state"]
  | IoHeldRequests => ["held_requests"]
  | IoHeldStore probing requests => "held_store" :: probing :: nio_frame_lists requests
  | IoJobComplete job result => ["job_complete", job, result]
  | IoCiLaunch id out tree ci => ["ci_launch", id, out, tree, ci]
  | IoReadText path => ["read_text", path]
  | IoDiscardFile path => ["discard_file", path]
  | IoRefuse raw => ["refuse", raw]
  | IoIdentity => ["identity"]
  | IoSeenRefused raw => ["seen_refused", raw]
  | IoPeerKey who => ["peer_key", who]
  | IoConns => ["conns"]
  | IoPollPrep => ["poll_prep"]
  | IoInboxState => ["inbox_state"]
  | IoInboxStamp stamp => ["inbox_stamp", stamp]
  | IoDirEntries path => ["dir_entries", path]
  | IoTurnNow => ["turn_now"]
  | IoTimers => ["timers"]
  | IoSetTimers timers => "set_timers" :: nio_frame_lists timers
  | IoJobs => ["jobs"]
  | IoQueueEmpty => ["queue_empty"]
  | IoEvents wait => ["events", wait]
  | IoBootEvents => ["boot_events"]
  | IoReplayCount => ["replay_count"]
  | IoRememberBlock height txs => "remember_block" :: height :: txs
  | IoSignedText => ["signed_text"]
  | IoSignedRestore slot vid fields => "signed_restore" :: slot :: vid :: fields
  | IoFail message => ["fail", message]
  | IoPrint text => ["print", text]
  | IoExit code => ["exit", code]
  | IoFileExists path => ["file_exists", path]
  | IoChmod path mode => ["chmod", path, mode]
  | IoMakeDirs path => ["make_dirs", path]
  | IoCwd => ["cwd"]
  | IoNewKey bits => ["new_key", bits]
  | IoRandomHex count => ["random_hex", count]
  | IoGit dir args => "git" :: dir :: args
  | IoClone url dir commit => ["clone", url, dir, commit]
  | IoSpawnNode log args => "spawn_node" :: log :: args
  | IoAwaitNodes pids => "await_nodes" :: pids
  | IoPathStat path => ["path_stat", path]
  | IoPathProbe dir path => ["path_probe", dir, path]
  | IoPathWrite dir path text => ["path_write", dir, path, text]
  | IoPathRemove dir path => ["path_remove", dir, path]
  | IoTempDir prefix => ["temp_dir", prefix]
  | IoRemoveTree path => ["remove_tree", path]
  | IoGitEnv dir stdin extra args => "git_env" :: dir :: stdin :: resend_fields extra ++ ("alternate" :: args)
  | IoProcStart prog stdin cwd env args => "proc_start" :: prog :: stdin :: cwd :: resend_fields env ++ ("alternate" :: args)
  | IoProcKill job => ["proc_kill", job]
  | IoRun prog args => "run" :: prog :: args
  | IoTempFile prefix suffix text => ["temp_file", prefix, suffix, text]
  | IoSockListen host port backlog => ["sock_listen", host, port, backlog]
  | IoSockDial host port => ["sock_dial", host, port]
  | IoSockSelect ms reads writes => "sock_select" :: ms :: resend_fields reads ++ ("alternate" :: writes)
  | IoSockAccept fd nonblock => ["sock_accept", fd, nonblock]
  | IoSockRead fd => ["sock_read", fd]
  | IoSockWrite fd data => ["sock_write", fd, data]
  | IoSockError fd => ["sock_error", fd]
  | IoSockClose fd => ["sock_close", fd]
  | IoSave path durable text => ["save", path, durable, text]
  | IoAppendSynced path text => ["append_synced", path, text]
  | IoNoSigpipe => ["no_sigpipe"]
  | IoSpawn prog stdin cwd env args => "spawn" :: prog :: stdin :: cwd :: resend_fields env ++ ("alternate" :: args)
  | IoWaitPid pid => ["wait_pid", pid]
  | IoKillPid pid => ["kill_pid", pid]
  | IoSnapshotSave text => ["snapshot_save", text]
  | IoSnapshotLoad => ["snapshot_load"]
  | IoServeListen address port => ["serve_listen", address, port]
  | IoServeNext wait => ["serve_next", wait]
  | IoServeReply conn found stamp fields => "serve_reply" :: conn :: found :: stamp :: fields
  | IoNetListen address port => ["net_listen", address, port]
  | IoNetMailbox ms => ["net_mailbox", ms]
  | IoNetConnect address port ms => ["net_connect", address, port, ms]
  | IoNetSend conn data => ["net_send", conn, data]
  | IoNetClose conn => ["net_close", conn]
  | IoFileRead name => ["file_read", name]
  | IoFileWrite name durable text => ["file_write", name, durable, text]
  | IoFileAppend name text => ["file_append", name, text]
  end.

io_of_wire (w : list string) : option node_op :=
  match w with
  | ["log", text] => Some (IoLog text)
  | "timer" :: ms :: ev => Some (IoTimer ms ev)
  | "push" :: ev => Some (IoQueue ev)
  | "send_all" :: fields => Some (IoSendAll fields)
  | "send_peer" :: index :: fields => Some (IoSendPeer index fields)
  | "peer_send" :: who :: fields => Some (IoPeerSend who fields)
  | "store" :: height :: txs => Some (IoStore height txs)
  | ["set_height", height] => Some (IoSetHeight height)
  | ["write_status", text] => Some (IoWriteStatus text)
  | "sign_vote" :: slot :: vid :: fields => Some (IoSignVote slot vid fields)
  | ["track_tx", raw] => Some (IoTrackTx raw)
  | ["mark_nonce_flood"] => Some IoMarkNonceFlood
  | "check" :: id :: repo :: head :: edits => Some (IoCheck id repo head edits)
  | ["merge_applied", repo, version] => Some (IoMergeApplied repo version)
  | ["merge_diverged", repo, entry] => Some (IoMergeDiverged repo entry)
  | ["clock"] => Some IoClock
  | "remember_broadcast" :: height :: kind :: parts =>
      match resend_parts parts with
      | Some (fields, alternate) => Some (IoRememberBroadcast height kind fields alternate)
      | None => None
      end
  | ["conn_admit", offer, mode, target] => Some (IoConnAdmit offer mode target)
  | ["conn_close", conn] => Some (IoConnClose conn)
  | ["job_flood", job] => Some (IoJobFlood job)
  | ["job_expire", job] => Some (IoJobExpire job)
  | ["peer_exists", who] => Some (IoPeerExists who)
  | ["nonce_flooded"] => Some IoNonceFlooded
  | ["is_diverged", repo] => Some (IoIsDiverged repo)
  | ["served_at", who, first] => Some (IoServedAt who first)
  | ["mark_served", who, first, timestamp] => Some (IoMarkServed who first timestamp)
  | ["draw"] => Some IoDraw
  | ["block", height] => Some (IoBlock height)
  | ["height"] => Some IoHeight
  | ["peer_count"] => Some IoPeerCount
  | ["signed_vote", slot] => Some (IoSignedVote slot)
  | ["signed_body", slot] => Some (IoSignedBody slot)
  | ["signed_at", height] => Some (IoSignedAt height)
  | "encode_tx" :: nonce :: fields => Some (IoEncodeTx nonce fields)
  | ["check_exclusions"] => Some IoCheckExclusions
  | ["checkout_heads"] => Some IoCheckoutHeads
  | ["divergences"] => Some IoDivergences
  | ["limit_info"] => Some IoLimitInfo
  | ["local_time", stamp] => Some (IoLocalTime stamp)
  | ["applied_version", repo] => Some (IoAppliedVersion repo)
  | ["merge_reset", repo] => Some (IoMergeReset repo)
  | ["merge_probe", repo, path] => Some (IoMergeProbe repo path)
  | ["merge_read", repo, path] => Some (IoMergeRead repo path)
  | ["merge_write", repo, path, text] => Some (IoMergeWrite repo path text)
  | ["merge_remove", repo, path] => Some (IoMergeRemove repo path)
  | ["merge_commit", repo, version, tree, bid, task, bidder, spec] =>
      Some (IoMergeCommit repo version tree bid task bidder spec)
  | ["llm_budget"] => Some IoLlmBudget
  | "llm_hold" :: id :: kind :: prompt :: ctx => Some (IoLlmHold id kind prompt ctx)
  | "llm_start" :: id :: kind :: raw :: prompt :: rest =>
      match resend_parts rest with
      | Some (ctx, rest) =>
          match resend_parts rest with
          | Some (clean, rest) =>
              match resend_parts rest with
              | Some (launch, env) => Some (IoLlmStart id kind raw prompt ctx clean launch env)
              | None => None
              end
          | None => None
          end
      | None => None
      end
  | ["tool_checkout", repo] => Some (IoToolCheckout repo)
  | ["self_exe"] => Some IoSelfExe
  | ["env_entries"] => Some IoEnvEntries
  | ["repo_names"] => Some IoRepoNames
  | ["ls_files", repo] => Some (IoLsFiles repo)
  | ["head_file", repo, path] => Some (IoHeadFile repo path)
  | ["limit_set", until, reason, backoff] => Some (IoLimitSet until reason backoff)
  | ["limit_clear", backoff] => Some (IoLimitClear backoff)
  | ["release_state"] => Some IoReleaseState
  | ["held_requests"] => Some IoHeldRequests
  | "held_store" :: probing :: requests => Some (IoHeldStore probing (nio_lists requests))
  | ["job_complete", job, result] => Some (IoJobComplete job result)
  | ["ci_launch", id, out, tree, ci] => Some (IoCiLaunch id out tree ci)
  | ["read_text", path] => Some (IoReadText path)
  | ["discard_file", path] => Some (IoDiscardFile path)
  | ["refuse", raw] => Some (IoRefuse raw)
  | ["identity"] => Some IoIdentity
  | ["seen_refused", raw] => Some (IoSeenRefused raw)
  | ["peer_key", who] => Some (IoPeerKey who)
  | ["conns"] => Some IoConns
  | ["poll_prep"] => Some IoPollPrep
  | ["inbox_state"] => Some IoInboxState
  | ["inbox_stamp", stamp] => Some (IoInboxStamp stamp)
  | ["dir_entries", path] => Some (IoDirEntries path)
  | ["turn_now"] => Some IoTurnNow
  | ["timers"] => Some IoTimers
  | "set_timers" :: timers => Some (IoSetTimers (nio_lists timers))
  | ["jobs"] => Some IoJobs
  | ["queue_empty"] => Some IoQueueEmpty
  | ["events", wait] => Some (IoEvents wait)
  | ["boot_events"] => Some IoBootEvents
  | ["replay_count"] => Some IoReplayCount
  | "remember_block" :: height :: txs => Some (IoRememberBlock height txs)
  | ["signed_text"] => Some IoSignedText
  | "signed_restore" :: slot :: vid :: fields => Some (IoSignedRestore slot vid fields)
  | ["fail", message] => Some (IoFail message)
  | ["print", text] => Some (IoPrint text)
  | ["exit", code] => Some (IoExit code)
  | ["file_exists", path] => Some (IoFileExists path)
  | ["chmod", path, mode] => Some (IoChmod path mode)
  | ["make_dirs", path] => Some (IoMakeDirs path)
  | ["cwd"] => Some IoCwd
  | ["new_key", bits] => Some (IoNewKey bits)
  | ["random_hex", count] => Some (IoRandomHex count)
  | "git" :: dir :: args => Some (IoGit dir args)
  | ["clone", url, dir, commit] => Some (IoClone url dir commit)
  | "spawn_node" :: log :: args => Some (IoSpawnNode log args)
  | "await_nodes" :: pids => Some (IoAwaitNodes pids)
  | ["path_stat", path] => Some (IoPathStat path)
  | ["path_probe", dir, path] => Some (IoPathProbe dir path)
  | ["path_write", dir, path, text] => Some (IoPathWrite dir path text)
  | ["path_remove", dir, path] => Some (IoPathRemove dir path)
  | ["temp_dir", prefix] => Some (IoTempDir prefix)
  | ["remove_tree", path] => Some (IoRemoveTree path)
  | "git_env" :: dir :: stdin :: rest =>
      match resend_parts rest with
      | Some (extra, args) => Some (IoGitEnv dir stdin extra args)
      | None => None
      end
  | "proc_start" :: prog :: stdin :: cwd :: rest =>
      match resend_parts rest with
      | Some (env, args) => Some (IoProcStart prog stdin cwd env args)
      | None => None
      end
  | ["proc_kill", job] => Some (IoProcKill job)
  | "run" :: prog :: args => Some (IoRun prog args)
  | ["temp_file", prefix, suffix, text] => Some (IoTempFile prefix suffix text)
  | ["sock_listen", host, port, backlog] => Some (IoSockListen host port backlog)
  | ["sock_dial", host, port] => Some (IoSockDial host port)
  | "sock_select" :: ms :: rest =>
      match resend_parts rest with
      | Some (reads, writes) => Some (IoSockSelect ms reads writes)
      | None => None
      end
  | ["sock_accept", fd, nonblock] => Some (IoSockAccept fd nonblock)
  | ["sock_read", fd] => Some (IoSockRead fd)
  | ["sock_write", fd, data] => Some (IoSockWrite fd data)
  | ["sock_error", fd] => Some (IoSockError fd)
  | ["sock_close", fd] => Some (IoSockClose fd)
  | ["save", path, durable, text] => Some (IoSave path durable text)
  | ["append_synced", path, text] => Some (IoAppendSynced path text)
  | ["no_sigpipe"] => Some IoNoSigpipe
  | "spawn" :: prog :: stdin :: cwd :: rest =>
      match resend_parts rest with
      | Some (env, args) => Some (IoSpawn prog stdin cwd env args)
      | None => None
      end
  | ["wait_pid", pid] => Some (IoWaitPid pid)
  | ["kill_pid", pid] => Some (IoKillPid pid)
  | ["snapshot_save", text] => Some (IoSnapshotSave text)
  | ["snapshot_load"] => Some IoSnapshotLoad
  | ["serve_listen", address, port] => Some (IoServeListen address port)
  | ["serve_next", wait] => Some (IoServeNext wait)
  | "serve_reply" :: conn :: found :: stamp :: fields => Some (IoServeReply conn found stamp fields)
  | ["net_listen", address, port] => Some (IoNetListen address port)
  | ["net_mailbox", ms] => Some (IoNetMailbox ms)
  | ["net_connect", address, port, ms] => Some (IoNetConnect address port ms)
  | ["net_send", conn, data] => Some (IoNetSend conn data)
  | ["net_close", conn] => Some (IoNetClose conn)
  | ["file_read", name] => Some (IoFileRead name)
  | ["file_write", name, durable, text] => Some (IoFileWrite name durable text)
  | ["file_append", name, text] => Some (IoFileAppend name text)
  | _ => None
  end.

(** What a unikernel asks its service for (docs/SHELL-IN-SOMA.md, "The
    node's service"): what the binary runs as processes or keeps on the
    host's disk: git and paths in the checkouts, temporary files,
    processes and the events they give, the model's reply files and the
    inbox (the kernel's node_host.soma decides what a merge, a model call,
    a check or CI asks of them). Everything else is the image's own: its
    votes, blocks, peers and tables, and what the host's work keeps (the
    model's budget and limit, the held requests, the jobs). A service
    answers these and nothing else. *)
service_op (op : node_op) : bool :=
  match op with
  | IoGit _ _ | IoGitEnv _ _ _ _ | IoPathStat _ | IoPathProbe _ _ | IoPathWrite _ _ _ | IoPathRemove _ _
  | IoTempDir _ | IoRemoveTree _ | IoProcStart _ _ _ _ _ | IoProcKill _ | IoRun _ _ | IoTempFile _ _ _
  | IoSelfExe | IoEnvEntries | IoRandomHex _ | IoReadText _ | IoDiscardFile _ | IoDirEntries _
  | IoEvents _ => true
  | _ => false
  end.


(** ---- Node programs (U-1) ----
    What the node does, as data, the way a Sandbox program is a value of
    [Sandbox.io]: [NDone a] has finished with [a]; [NStep op k] does [op],
    then goes on as [k] says, given the operation's answer. An answer is
    a [nanswer], what [node_io] gives. Building a program
    does nothing; an interpreter runs it, so the binary and a unikernel
    can run the same one. *)
(** An operation's answer, the same shape for every operation so one
    binding carries them all: whether it was carried out (or the boolean a
    table read gives), a number (the clock's time, a served timestamp) and
    data (what a read returns: a stored block's transactions, the height).
    An effect's is [(true, (0, []))]. *)
nanswer : Type := bool * (PrimFloat.float * list string).

ans_ok : nanswer := (true, (PrimFloat.zero, [])).
ans_flag (b : bool) : nanswer := (b, (PrimFloat.zero, [])).
ans_time (t : PrimFloat.float) : nanswer := (true, (t, [])).
ans_data (found : bool) (l : list string) : nanswer := (found, (PrimFloat.zero, l)).
ans_float (a : nanswer) : PrimFloat.float := fst (snd a).
ans_list (a : nanswer) : list string := snd (snd a).

(** The data reads' answers, read back. A malformed answer reads as
    nothing found (the binary never gives one). *)
ans_one (a : nanswer) : string := match ans_list a with [x] => x | _ => "" end.
ans_found (a : nanswer) : option (list string) := if fst a then Some (ans_list a) else None.
(** pairs on the wire, flattened: [a, b, c, d] is [(a, b), (c, d)] *)
Fixpoint nio_pairs (l : list string) : list (string * string) :=
  match l with a :: b :: rest => (a, b) :: nio_pairs rest | _ => [] end.

Fixpoint nio_flat_pairs (l : list (string * string)) : list string :=
  match l with [] => [] | (a, b) :: rest => a :: b :: nio_flat_pairs rest end.

ans_pairs (a : nanswer) : list (string * string) := nio_pairs (ans_list a).

ans_found_one (a : nanswer) : option string :=
  match ans_found a with Some [x] => Some x | _ => None end.
ans_draw (a : nanswer) : string * (string * string) :=
  match ans_list a with [byz, limit, secret] => (byz, (limit, secret)) | _ => ("", ("0", "")) end.
ans_exclusions (a : nanswer) : list string * list string :=
  match resend_parts (ans_list a) with Some p => p | None => ([], []) end.

Inductive nprog (A : Type) : Type :=
| NDone (a : A)
| NStep (op : node_op) (k : nanswer -> nprog A).

Arguments NDone {A} a.
Arguments NStep {A} op k.

(** [p], then [f] on its result *)
Fixpoint nbind {A B : Type} (p : nprog A) (f : A -> nprog B) : nprog B :=
  match p with
  | NDone a => f a
  | NStep op k => NStep op (fun r => nbind (k r) f)
  end.

(** One operation; the result is its answer. *)
nask (op : node_op) : nprog nanswer := NStep op (fun r => NDone r).

(** One operation; the result is whether it was carried out (an effect)
    or the boolean it read (a table read): the first of its answer. *)
nexec (op : node_op) : nprog bool := NStep op (fun r => NDone (fst r)).

(** [op], then [rest] when it was carried out: the program of
    [io_do h op && rest]. [rest] is built only then, so a binding read
    inside it happens after [op], as it did in the [&&] chain. *)
ndo (op : node_op) (rest : unit -> nprog bool) : nprog bool :=
  NStep op (fun r => if fst r then rest tt else NDone false).

(** [p], then [q] when [p] gave true: [&&] on programs. *)
nand (p : nprog bool) (q : unit -> nprog bool) : nprog bool :=
  nbind p (fun b => if b then q tt else NDone false).

(** Each program of the list in order, stopping at the first false. *)
Fixpoint nall (ps : list (unit -> nprog bool)) : nprog bool :=
  match ps with
  | [] => NDone true
  | p :: rest => nand (p tt) (fun _ => nall rest)
  end.

(** The operations a program does, in order, when [ans] answers each: what
    any interpreter that gives those answers carries out. *)
Fixpoint ntrace {A : Type} (ans : node_op -> nanswer) (p : nprog A) : list node_op :=
  match p with
  | NDone _ => []
  | NStep op k => op :: ntrace ans (k (ans op))
  end.

(** And what it ends with. *)
Fixpoint nresult {A : Type} (ans : node_op -> nanswer) (p : nprog A) : A :=
  match p with
  | NDone a => a
  | NStep op k => nresult ans (k (ans op))
  end.

(** ---- What the operations write and keep (U-1) ----
    Pure, so any interpreter uses the same bytes and the same tables: the
    lines shell.ml appends to blocks.log and signed.log (Yojson's output,
    byte for byte), and the tables it keeps in memory for the operations,
    as one record. node_sandbox.soma interprets the operations with them;
    shell.ml keeps its own copies today. *)

(** Yojson.Safe.to_string of a string's characters: a quote, a backslash
    and \b \f \n \r \t named, every other control character and DEL as
    \u00XX (lowercase hex), the rest as they are. *)
nio_char (n : nat) : Ascii.ascii := Ascii.ascii_of_nat n.

nio_hex (n : nat) : Ascii.ascii := nio_char (if Nat.ltb n 10 then 48 + n else 87 + n).

(** by character code: 34 is the quote, 92 the backslash *)
nio_escape (c : Ascii.ascii) : list Ascii.ascii :=
  let n := Ascii.nat_of_ascii c in
  let bs := nio_char 92 in
  if Nat.eqb n 34 then [bs, c] else
  if Nat.eqb n 92 then [bs, bs] else
  if Nat.eqb n 8 then [bs, nio_char 98] else
  if Nat.eqb n 12 then [bs, nio_char 102] else
  if Nat.eqb n 10 then [bs, nio_char 110] else
  if Nat.eqb n 13 then [bs, nio_char 114] else
  if Nat.eqb n 9 then [bs, nio_char 116] else
  if Nat.ltb n 32 || Nat.eqb n 127 then
    [bs, nio_char 117, nio_char 48, nio_char 48, nio_hex (Nat.div n 16), nio_hex (Nat.modulo n 16)]
  else [c].

nio_json_string (s : string) : string :=
  Stdlib.Strings.String.string_of_list_ascii
    (nio_char 34 :: List.flat_map nio_escape (Stdlib.Strings.String.list_ascii_of_string s) ++ [nio_char 34]).

(** A list of strings as JSON, as Yojson writes it: no spaces. *)
nio_json_strings (l : list string) : string :=
  Stdlib.Strings.String.append "["
    (Stdlib.Strings.String.append (Stdlib.Strings.String.concat "," (List.map nio_json_string l)) "]").

(** blocks.log's line for a decided block, and signed.log's for a vote. *)
nio_block_line (height : string) (txs : list string) : string :=
  Stdlib.Strings.String.concat "" ["{""h"":", height, ",""txs"":", nio_json_strings txs, "}"].

nio_vote_line (slot vid : string) (fields : list string) : string :=
  Stdlib.Strings.String.concat " " [slot, vid, nio_json_strings fields].

(** ---- signatures ----
    What the binary signs and the lines it sends, as shell.ml makes them
    (tx_bytes, msg_bytes, encode_tx, wire), with Soma's RSA (Soma.Crypto:
    PKCS #1 v1.5 of SHA-256, a signature as lowercase hex), so that an
    interpreter without Cryptokit signs and checks the same bytes. A key's
    numbers are big-endian bytes; [nk_bytes] is its size in bytes (the
    key file's "size" over 8). A public key's private fields are empty. *)
Record nio_key := {
  nk_bytes : nat; nk_n : list PrimInt63.int; nk_e : list PrimInt63.int;
  nk_p : list PrimInt63.int; nk_q : list PrimInt63.int; nk_dp : list PrimInt63.int;
  nk_dq : list PrimInt63.int; nk_qinv : list PrimInt63.int }.

nio_nul : string := Stdlib.Strings.String.String (nio_char 0) "".

nio_tx_bytes (chain agent nonce : string) (fields : list string) : string :=
  Stdlib.Strings.String.concat nio_nul ["tx", chain, agent, nonce, nio_json_strings fields].

nio_msg_bytes (chain from : string) (fields : list string) : string :=
  Stdlib.Strings.String.concat nio_nul ["msg", chain, from, nio_json_strings fields].

nio_sign (k : nio_key) (msg : string) : string :=
  Crypto.hex_of_bytes (Crypto.rsa_sign (nk_bytes k) (nk_p k) (nk_q k) (nk_dp k) (nk_dq k) (nk_qinv k) msg).

(** whether [sg] is [k]'s signature of [msg]: hex that isn't isn't *)
nio_verify (k : nio_key) (msg sg : string) : bool :=
  match Crypto.bytes_of_hex sg with
  | Some b => Crypto.rsa_verify (nk_bytes k) (nk_n k) (nk_e k) msg b
  | None => false
  end.

(** a signed transaction's line, as [encode_tx]: its fields and the
    signature of its bytes *)
nio_encode_tx (chain agent : string) (k : nio_key) (nonce : string) (fields : list string) : string :=
  Stdlib.Strings.String.concat "" ["{""agent"":", nio_json_string agent, ",""nonce"":", nio_json_string nonce,
    ",""fields"":", nio_json_strings fields, ",""sig"":",
    nio_json_string (nio_sign k (nio_tx_bytes chain agent nonce fields)), "}"].

(** a peer link's line for a message, as [wire] (which ends it with a
    newline, as Sandbox's [send_line] does): who, the fields and the
    signature of its bytes *)
nio_wire_line_signed (me : string) (fields : list string) (sg : string) : string :=
  Stdlib.Strings.String.concat "" ["{""from"":", nio_json_string me, ",""fields"":", nio_json_strings fields,
    ",""sig"":", nio_json_string sg, "}"].

nio_wire_line (chain me : string) (k : nio_key) (fields : list string) : string :=
  nio_wire_line_signed me fields (nio_sign k (nio_msg_bytes chain me fields)).

(** The tables an interpreter keeps for the operations: timers (when, in
    the clock's seconds, and the event), events queued for the loop, the
    catch-up served table, the nonce-flood mark, diverged repositories,
    the versions applied, resend memory, the node's own transactions, and
    the height. *)
Record nio_tables := {
  t_timers : list (PrimFloat.float * list string);
  t_queue : list (list string);
  t_served : smap PrimFloat.float;
  t_flood : bool;
  t_diverged : list (string * string);
  t_applied : list (string * string);
  t_mine : list (string * (string * (list string * list string)));
  t_txs : list (PrimFloat.float * string);
  t_height : string;
  t_blocks : smap (list string);
  t_signed : smap (list (string * (string * list string)));
  t_refused : nat * smap unit }.

nio_empty : nio_tables :=
  {| t_timers := []; t_queue := []; t_served := SLeaf; t_flood := false; t_diverged := [];
     t_applied := []; t_mine := []; t_txs := []; t_height := "0"; t_blocks := SLeaf;
     t_signed := SLeaf; t_refused := (0, SLeaf) |}.

nio_eq (a b : string) : bool := Stdlib.Strings.String.eqb a b.

Fixpoint nio_find {A : Type} (eq : string * string -> bool) (l : list ((string * string) * A)) : option A :=
  match l with
  | [] => None
  | (k, v) :: rest => if eq k then Some v else nio_find eq rest
  end.

nio_key_is (who first : string) (k : string * string) : bool :=
  nio_eq (fst k) who && nio_eq (snd k) first.

Fixpoint nio_has (k : string) (l : list (string * string)) : bool :=
  match l with [] => false | (x, _) :: rest => nio_eq x k || nio_has k rest end.

(** A small whole number as a float, by adding ones: digits and ten. *)
Fixpoint nio_small (n : nat) : PrimFloat.float :=
  match n with 0 => PrimFloat.zero | S k => PrimFloat.add (nio_small k) PrimFloat.one end.

nio_ten : PrimFloat.float := nio_small 10.

(** digits from the front: their value, how many, and what follows *)
Fixpoint nio_digits (cs : list Ascii.ascii) (acc : PrimFloat.float) (count : nat)
    : PrimFloat.float * nat * list Ascii.ascii :=
  match cs with
  | c :: rest =>
      let n := Ascii.nat_of_ascii c in
      if Nat.leb 48 n && Nat.leb n 57 then
        nio_digits rest (PrimFloat.add (PrimFloat.mul acc nio_ten) (nio_small (n - 48))) (S count)
      else (acc, count, cs)
  | [] => (acc, count, cs)
  end.

Fixpoint nio_pow10 (k : nat) : PrimFloat.float :=
  match k with 0 => PrimFloat.one | S j => PrimFloat.mul nio_ten (nio_pow10 j) end.

Fixpoint nio_nat_digits (cs : list Ascii.ascii) (acc : nat) : nat * list Ascii.ascii :=
  match cs with
  | c :: rest =>
      let n := Ascii.nat_of_ascii c in
      if Nat.leb 48 n && Nat.leb n 57 then nio_nat_digits rest (acc * 10 + (n - 48)) else (acc, cs)
  | [] => (acc, cs)
  end.

(** A decimal number as the clock's text has it: an optional minus,
    digits, an optional fraction, an optional exponent (e, a sign, digits).
    Within rounding; None if the text is anything else. *)
nio_decimal (s : string) : option PrimFloat.float :=
  let cs := Stdlib.Strings.String.list_ascii_of_string s in
  let (neg, cs) := match cs with
                   | c :: r => if Nat.eqb (Ascii.nat_of_ascii c) 45 then (true, r) else (false, cs)
                   | [] => (false, cs) end in
  match nio_digits cs PrimFloat.zero 0 with
  | (whole, n, rest) =>
      let (frac, rest) := match rest with
        | c :: r => if Nat.eqb (Ascii.nat_of_ascii c) 46 then
                      match nio_digits r PrimFloat.zero 0 with
                      | (f, m, after) => (PrimFloat.div f (nio_pow10 m), after)
                      end
                    else (PrimFloat.zero, rest)
        | [] => (PrimFloat.zero, rest) end in
      let (exp, rest) := match rest with
        | c :: r => if Nat.eqb (Ascii.nat_of_ascii c) 101 || Nat.eqb (Ascii.nat_of_ascii c) 69 then
                      match r with
                      | d :: r' => if Nat.eqb (Ascii.nat_of_ascii d) 45 then
                                     let (k, after) := nio_nat_digits r' 0 in (PrimFloat.div PrimFloat.one (nio_pow10 k), after)
                                   else if Nat.eqb (Ascii.nat_of_ascii d) 43 then
                                     let (k, after) := nio_nat_digits r' 0 in (nio_pow10 k, after)
                                   else let (k, after) := nio_nat_digits r 0 in (nio_pow10 k, after)
                      | [] => (PrimFloat.one, rest)
                      end
                    else (PrimFloat.one, rest)
        | [] => (PrimFloat.one, rest) end in
      match n, rest with
      | 0, _ => None
      | _, [] => let v := PrimFloat.mul (PrimFloat.add whole frac) exp in
                 Some (if neg then PrimFloat.opp v else v)
      | _, _ :: _ => None
      end
  end.

nio_num (s : string) : PrimFloat.float :=
  match nio_decimal s with Some f => f | None => PrimFloat.zero end.

nio_ok : nanswer := ans_ok.

nio_with_timers (t : nio_tables) (v : list (PrimFloat.float * list string)) : nio_tables :=
  {| t_timers := v; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := t_refused t |}.
nio_with_queue (t : nio_tables) (v : list (list string)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := v; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := t_refused t |}.
nio_with_served (t : nio_tables) (v : smap PrimFloat.float) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := v; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := t_refused t |}.
nio_with_flood (t : nio_tables) (v : bool) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := v;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := t_refused t |}.
nio_with_diverged (t : nio_tables) (v : list (string * string)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := v; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := t_refused t |}.
nio_with_applied (t : nio_tables) (v : list (string * string)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := v; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := t_refused t |}.
nio_with_mine (t : nio_tables) (v : list (string * (string * (list string * list string)))) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := v; t_txs := t_txs t;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := t_refused t |}.
nio_with_txs (t : nio_tables) (v : list (PrimFloat.float * string)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := v;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := t_refused t |}.
nio_with_height (t : nio_tables) (v : string) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := v; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := t_refused t |}.

nio_with_refused (t : nio_tables) (v : nat * smap unit) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := t_signed t; t_refused := v |}.

(** a count in decimal, as the binary's [string_of_int] *)
Fixpoint nio_count_digits (fuel n : nat) (acc : string) : string :=
  match fuel with
  | 0 => acc
  | S f =>
      let acc' := Stdlib.Strings.String.String (Ascii.ascii_of_nat (48 + Nat.modulo n 10)) acc in
      if Nat.ltb n 10 then acc' else nio_count_digits f (Nat.div n 10) acc'
  end.
nio_count (n : nat) : string := nio_count_digits (S n) n Stdlib.Strings.String.EmptyString.

Fixpoint nio_lookup {A : Type} (k : string) (l : list (string * A)) : option A :=
  match l with [] => None | (x, v) :: rest => if nio_eq x k then Some v else nio_lookup k rest end.

(** What an operation does to the tables, at the clock's [now], as
    the kernel does it: a timer is due [ms] milliseconds from now;
    the height drops resend memory below it; the served table and the
    applied versions keep one entry a key. [None]: the operation isn't a
    table's (logging, the clock, storage, peer links, CI, jobs). *)
(** a peer and a height, as one key: a name has no NUL *)
nio_served_key (who first : string) : string :=
  Stdlib.Strings.String.append who (Stdlib.Strings.String.String (Ascii.ascii_of_nat 0) first).

nio_table_op (now : PrimFloat.float) (t : nio_tables) (op : node_op)
    : option (nanswer * nio_tables) :=
  match op with
  | IoTimer ms ev =>
      Some (nio_ok, nio_with_timers t ((PrimFloat.add now (PrimFloat.div (nio_num ms) (nio_small 1000)), ev) :: t_timers t))
  | IoQueue ev => Some (nio_ok, nio_with_queue t (t_queue t ++ [ev]))
  | IoSetHeight h =>
      let floor := nio_num h in
      Some (nio_ok, nio_with_mine (nio_with_height t h)
                      (List.filter (fun m => PrimFloat.leb floor (nio_num (fst m))) (t_mine t)))
  | IoTrackTx raw => Some (nio_ok, nio_with_txs t ((now, raw) :: t_txs t))
  | IoMarkNonceFlood => Some (nio_ok, nio_with_flood t true)
  | IoNonceFlooded => Some (ans_flag (t_flood t), t)
  | IoMergeApplied r v =>
      Some (nio_ok, nio_with_applied t ((r, v) :: List.filter (fun p => negb (nio_eq (fst p) r)) (t_applied t)))
  | IoMergeDiverged r entry => Some (nio_ok, nio_with_diverged t ((r, entry) :: t_diverged t))
  | IoIsDiverged r => Some (ans_flag (nio_has r (t_diverged t)), t)
  | IoDivergences => Some (ans_data true (nio_flat_pairs (t_diverged t)), t)
  | IoAppliedVersion r =>
      match nio_lookup r (t_applied t) with
      | Some v => Some (ans_data true [v], t)
      | None => Some (ans_data false [], t)
      end
  | IoRememberBroadcast h kind fields alt => Some (nio_ok, nio_with_mine t ((h, (kind, (fields, alt))) :: t_mine t))
  | IoServedAt who first =>
      match smap_find (nio_served_key who first) (t_served t) with
      | Some time => Some (ans_time time, t)
      | None => Some (ans_flag false, t)
      end
  | IoMarkServed who first stamp =>
      Some (nio_ok, nio_with_served t (smap_add (nio_served_key who first) (nio_num stamp) (t_served t)))
  | _ => None
  end.

nio_with_blocks (t : nio_tables) (v : smap (list string)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t; t_blocks := v; t_signed := t_signed t; t_refused := t_refused t |}.
nio_with_signed (t : nio_tables) (v : smap (list (string * (string * list string)))) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t; t_blocks := t_blocks t; t_signed := v; t_refused := t_refused t |}.

(** A slot is KIND/HEIGHT/ROUND: whether it is at [h]. *)
Fixpoint nio_after_slash (cs : list Ascii.ascii) : list Ascii.ascii :=
  match cs with [] => [] | c :: rest => if Ascii.eqb c (nio_char 47) then rest else nio_after_slash rest end.

Fixpoint nio_starts (p cs : list Ascii.ascii) : bool :=
  match p, cs with
  | [], _ => true
  | a :: p', c :: cs' => Ascii.eqb a c && nio_starts p' cs'
  | _ :: _, [] => false
  end.

nio_slot_at (h slot : string) : bool :=
  nio_starts (Stdlib.Strings.String.list_ascii_of_string h ++ [nio_char 47])
    (nio_after_slash (Stdlib.Strings.String.list_ascii_of_string slot)).

(** a slot's height: what is between its first and second "/" *)
Fixpoint nio_upto_slash (cs : list Ascii.ascii) : list Ascii.ascii :=
  match cs with [] => [] | c :: rest => if Ascii.eqb c (nio_char 47) then [] else c :: nio_upto_slash rest end.

nio_slot_height (slot : string) : string :=
  Stdlib.Strings.String.string_of_list_ascii (nio_upto_slash (nio_after_slash (Stdlib.Strings.String.list_ascii_of_string slot))).

(** the votes signed at a height, by slot, newest first: one a slot *)
nio_sign_slot (slot vid : string) (fields : list string) (m : smap (list (string * (string * list string))))
    : smap (list (string * (string * list string))) :=
  let h := nio_slot_height slot in
  let here := match smap_find h m with Some l => l | None => [] end in
  smap_add h ((slot, (vid, fields)) :: List.filter (fun v => negb (nio_eq (fst v) slot)) here) m.

nio_signed_find (slot : string) (m : smap (list (string * (string * list string)))) : option (string * list string) :=
  match smap_find (nio_slot_height slot) m with Some l => nio_lookup slot l | None => None end.

(** The stores the binary keeps in memory beside its files: decided blocks
    by height (what catch-up and [IoBlock] read) and the vote signed at
    each slot (what [IoSignedVote] and [IoSignedBody] read), one entry a
    key; the height, read back; the refused transactions; and the queue
    a select drains ([IoEvents]: a unikernel's events are its queue's, as
    its links' lines come through their listen handlers). *)
nio_store_op (now : PrimFloat.float) (t : nio_tables) (op : node_op) : option (nanswer * nio_tables) :=
  match op with
  | IoStore h txs => Some (ans_ok, nio_with_blocks t (smap_add h txs (t_blocks t)))
  | IoSignVote slot vid fields => Some (ans_ok, nio_with_signed t (nio_sign_slot slot vid fields (t_signed t)))
  | IoBlock h =>
      match smap_find h (t_blocks t) with
      | Some txs => Some (ans_data true txs, t)
      | None => Some (ans_data false [], t)
      end
  | IoHeight => Some (ans_data true [t_height t], t)
  | IoSignedVote slot =>
      match nio_signed_find slot (t_signed t) with
      | Some v => Some (ans_data true [fst v], t)
      | None => Some (ans_data false [], t)
      end
  | IoSignedBody slot =>
      match nio_signed_find slot (t_signed t) with
      | Some v => Some (ans_data true (snd v), t)
      | None => Some (ans_data false [], t)
      end
  | IoSignedAt h =>
      Some (ans_data true (nio_frame_lists (List.map (fun v => snd (snd v))
        (List.rev (match smap_find h (t_signed t) with Some l => l | None => [] end)))), t)
  | IoRememberBlock h txs => Some (ans_ok, nio_with_blocks t (smap_add h txs (t_blocks t)))
  | IoSignedRestore slot vid fields => Some (ans_ok, nio_with_signed t (nio_sign_slot slot vid fields (t_signed t)))
  | IoReplayCount => Some (ans_data true [nio_count (smap_size (t_blocks t))], t)
  (* at most 10000 kept, as the binary kept them *)
  | IoRefuse raw =>
      let (n, m) := t_refused t in
      if smap_mem raw m || Nat.leb 10000 n then Some (ans_ok, t)
      else Some (ans_ok, nio_with_refused t (S n, smap_add raw tt m))
  | IoSeenRefused raw => Some (ans_flag (smap_mem raw (snd (t_refused t))), t)
  | IoQueueEmpty => Some (ans_flag (match t_queue t with [] => true | _ => false end), t)
  | IoEvents _ => Some (ans_data true (nio_frame_lists (t_queue t)), nio_with_queue t [])
  | IoSetTimers ts =>
      Some (ans_ok, nio_with_timers t (List.flat_map (fun l => match l with d :: ev => [(nio_num d, ev)] | [] => [] end) ts))
  | _ => nio_table_op now t op
  end.

(** ---- keys, as the binary gives them ----
    An agent's public key and the chain's id in [IoPeerKey]'s and
    [tx_key]'s form: the chain id, the key's size in bytes (decimal), n and
    e as hex. Anything else, an unknown agent's empty list included, is no
    key, and no signature checks against it. *)
nio_key_of_wire (l : list string) : option (string * nio_key) :=
  match l with
  | [chain, size, n, e] =>
      match nio_nat_digits (Stdlib.Strings.String.list_ascii_of_string size) 0,
            Crypto.bytes_of_hex n, Crypto.bytes_of_hex e with
      | (bytes, []), Some nb, Some eb =>
          Some (chain, {| nk_bytes := bytes; nk_n := nb; nk_e := eb; nk_p := []; nk_q := [];
                          nk_dp := []; nk_dq := []; nk_qinv := [] |})
      | _, _, _ => None
      end
  | _ => None
  end.

(** a transaction's signature checked against its agent's key *)
nio_tx_verify (key : list string) (agent nonce : string) (fields : list string) (sg : string) : bool :=
  match nio_key_of_wire key with
  | Some (chain, k) => nio_verify k (nio_tx_bytes chain agent nonce fields) sg
  | None => false
  end.

(** a peer line's signature checked against its sender's key *)
nio_line_verify (key : list string) (from sg : string) (fields : list string) : bool :=
  match nio_key_of_wire key with
  | Some (chain, k) => nio_verify k (nio_msg_bytes chain from fields) sg
  | None => false
  end.
