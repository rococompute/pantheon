(** The node's I/O as one interface (U-1; docs/SHELL-IN-SOMA.md, "Two
    directions, and the unikernel"). Nothing here imports the shell: these
    are values, which the binary interprets through shell.ml (node.soma's
    [run_shell] over the [node_io] binding) and a unikernel can interpret
    with Sandbox (node_sandbox.soma). *)
From Corelib Require PrimFloat.

(** ---- U-1: the node's I/O as one interface (docs/SHELL-IN-SOMA.md,
    "Two directions, and the unikernel") ----
    The node's effects are values of [node_op], as a Sandbox program's are
    values of Sandbox.io: shell.ml interprets them for the binary through
    one binding, [node_io], and Sandbox could interpret the same values for
    a unikernel. So far: logging, a timer, queueing an event for the loop,
    and sending on peer links (to every peer, to the peer at an index, to a
    peer by name), and the storage writes: storing a decided block, setting
    the height and writing the assembled status file, the signed-vote log,
    the own-transaction retry table and nonce-flood mark, a CI check
    request, and a merge's applied version or divergence. The clock is a read
    of the same interface: interpreting it yields the time, the same
    [Unix.gettimeofday] value as before. Table reads, git, model and CI
    jobs are still bindings of their own: the next parts of U-1. An operation crosses the binding as its
    wire form ([io_wire]), since a .definition takes no Soma inductive;
    [io_of_wire] reads it back, and shell.ml's [node_io] does exactly that
    match. An effect's result is [(true, 0)]; the clock's is [(true, now)]. *)
Inductive node_op :=
| IoLog (text : string)
| IoTimer (ms : string) (event : list string)
| IoQueue (event : list string)
| IoSendAll (fields : list string)
| IoSendPeer (index : string) (fields : list string)
| IoPeerSend (who : string) (fields : list string)
| IoStore (height : string) (txs : list string)
| IoSetHeight (height : string)
| IoWriteStatus (text : string)
| IoSignVote (slot vid : string) (fields : list string)
| IoTrackTx (raw : string)
| IoMarkNonceFlood
| IoCheck (id repo head : string) (edits : list string)
| IoMergeApplied (repo version : string)
| IoMergeDiverged (repo entry : string)
| IoClock
| IoRememberBroadcast (height kind : string) (fields alternate : list string)
(** peer links and job control (U-1): admit, refuse or evict for an
    offered connection, close a connection, kill a job whose output went
    over its cap or that ran past its limit *)
| IoConnAdmit (offer mode target : string)
| IoConnClose (conn : string)
| IoJobFlood (job : string)
| IoJobExpire (job : string)
| IoPeerExists (who : string)
| IoNonceFlooded
| IoIsDiverged (repo : string)
| IoServedAt (who first : string)
| IoMarkServed (who first timestamp : string).

(** Two arbitrary lists on one wire: tagged field/value pairs, then the
    alternate-list marker. A marker occurring as a value is never a tag.
    This avoids a bounded decimal count in the total round-trip property. *)
Fixpoint resend_fields (fields : list string) : list string :=
  match fields with [] => [] | field :: rest => "field" :: field :: resend_fields rest end.

Fixpoint resend_parts (wire : list string) : option (list string * list string) :=
  match wire with
  | "alternate" :: alternate => Some ([], alternate)
  | "field" :: value :: rest =>
      match resend_parts rest with Some (fields, alternate) => Some (value :: fields, alternate) | None => None end
  | _ => None
  end.

io_wire (op : node_op) : list string :=
  match op with
  | IoLog text => ["log", text]
  | IoTimer ms ev => "timer" :: ms :: ev
  | IoQueue ev => "push" :: ev
  | IoSendAll fields => "send_all" :: fields
  | IoSendPeer index fields => "send_peer" :: index :: fields
  | IoPeerSend who fields => "peer_send" :: who :: fields
  | IoStore height txs => "store" :: height :: txs
  | IoSetHeight height => ["set_height", height]
  | IoWriteStatus text => ["write_status", text]
  | IoSignVote slot vid fields => "sign_vote" :: slot :: vid :: fields
  | IoTrackTx raw => ["track_tx", raw]
  | IoMarkNonceFlood => ["mark_nonce_flood"]
  | IoCheck id repo head edits => "check" :: id :: repo :: head :: edits
  | IoMergeApplied repo version => ["merge_applied", repo, version]
  | IoMergeDiverged repo entry => ["merge_diverged", repo, entry]
  | IoClock => ["clock"]
  | IoRememberBroadcast height kind fields alternate =>
      ["remember_broadcast", height, kind] ++ resend_fields fields ++ ("alternate" :: alternate)
  | IoConnAdmit offer mode target => ["conn_admit", offer, mode, target]
  | IoConnClose conn => ["conn_close", conn]
  | IoJobFlood job => ["job_flood", job]
  | IoJobExpire job => ["job_expire", job]
  | IoPeerExists who => ["peer_exists", who]
  | IoNonceFlooded => ["nonce_flooded"]
  | IoIsDiverged repo => ["is_diverged", repo]
  | IoServedAt who first => ["served_at", who, first]
  | IoMarkServed who first timestamp => ["mark_served", who, first, timestamp]
  end.

io_of_wire (w : list string) : option node_op :=
  match w with
  | ["log", text] => Some (IoLog text)
  | "timer" :: ms :: ev => Some (IoTimer ms ev)
  | "push" :: ev => Some (IoQueue ev)
  | "send_all" :: fields => Some (IoSendAll fields)
  | "send_peer" :: index :: fields => Some (IoSendPeer index fields)
  | "peer_send" :: who :: fields => Some (IoPeerSend who fields)
  | "store" :: height :: txs => Some (IoStore height txs)
  | ["set_height", height] => Some (IoSetHeight height)
  | ["write_status", text] => Some (IoWriteStatus text)
  | "sign_vote" :: slot :: vid :: fields => Some (IoSignVote slot vid fields)
  | ["track_tx", raw] => Some (IoTrackTx raw)
  | ["mark_nonce_flood"] => Some IoMarkNonceFlood
  | "check" :: id :: repo :: head :: edits => Some (IoCheck id repo head edits)
  | ["merge_applied", repo, version] => Some (IoMergeApplied repo version)
  | ["merge_diverged", repo, entry] => Some (IoMergeDiverged repo entry)
  | ["clock"] => Some IoClock
  | "remember_broadcast" :: height :: kind :: parts =>
      match resend_parts parts with
      | Some (fields, alternate) => Some (IoRememberBroadcast height kind fields alternate)
      | None => None
      end
  | ["conn_admit", offer, mode, target] => Some (IoConnAdmit offer mode target)
  | ["conn_close", conn] => Some (IoConnClose conn)
  | ["job_flood", job] => Some (IoJobFlood job)
  | ["job_expire", job] => Some (IoJobExpire job)
  | ["peer_exists", who] => Some (IoPeerExists who)
  | ["nonce_flooded"] => Some IoNonceFlooded
  | ["is_diverged", repo] => Some (IoIsDiverged repo)
  | ["served_at", who, first] => Some (IoServedAt who first)
  | ["mark_served", who, first, timestamp] => Some (IoMarkServed who first timestamp)
  | _ => None
  end.


(** ---- Node programs (U-1) ----
    What the node does, as data, the way a Sandbox program is a value of
    [Sandbox.io]: [NDone a] has finished with [a]; [NStep op k] does [op],
    then goes on as [k] says, given the operation's answer. An answer is
    what [node_io] gives: [(true, 0)] for an effect carried out, the
    clock's [(true, now)], a table read's [(value, 0)]. Building a program
    does nothing; an interpreter runs it, so the binary and a unikernel
    can run the same one. *)
Inductive nprog (A : Type) : Type :=
| NDone (a : A)
| NStep (op : node_op) (k : bool * PrimFloat.float -> nprog A).

Arguments NDone {A} a.
Arguments NStep {A} op k.

(** [p], then [f] on its result *)
Fixpoint nbind {A B : Type} (p : nprog A) (f : A -> nprog B) : nprog B :=
  match p with
  | NDone a => f a
  | NStep op k => NStep op (fun r => nbind (k r) f)
  end.

(** One operation; the result is its answer. *)
nask (op : node_op) : nprog (bool * PrimFloat.float) := NStep op (fun r => NDone r).

(** One operation; the result is whether it was carried out (an effect)
    or the boolean it read (a table read): the first of its answer. *)
nexec (op : node_op) : nprog bool := NStep op (fun r => NDone (fst r)).

(** [op], then [rest] when it was carried out: the program of
    [io_do h op && rest]. [rest] is built only then, so a binding read
    inside it happens after [op], as it did in the [&&] chain. *)
ndo (op : node_op) (rest : unit -> nprog bool) : nprog bool :=
  NStep op (fun r => if fst r then rest tt else NDone false).

(** [p], then [q] when [p] gave true: [&&] on programs. *)
nand (p : nprog bool) (q : unit -> nprog bool) : nprog bool :=
  nbind p (fun b => if b then q tt else NDone false).

(** Each program of the list in order, stopping at the first false. *)
Fixpoint nall (ps : list (unit -> nprog bool)) : nprog bool :=
  match ps with
  | [] => NDone true
  | p :: rest => nand (p tt) (fun _ => nall rest)
  end.

(** The operations a program does, in order, when [ans] answers each: what
    any interpreter that gives those answers carries out. *)
Fixpoint ntrace {A : Type} (ans : node_op -> bool * PrimFloat.float) (p : nprog A) : list node_op :=
  match p with
  | NDone _ => []
  | NStep op k => op :: ntrace ans (k (ans op))
  end.

(** And what it ends with. *)
Fixpoint nresult {A : Type} (ans : node_op -> bool * PrimFloat.float) (p : nprog A) : A :=
  match p with
  | NDone a => a
  | NStep op k => nresult ans (k (ans op))
  end.

(** ---- What the operations write and keep (U-1) ----
    Pure, so any interpreter uses the same bytes and the same tables: the
    lines shell.ml appends to blocks.log and signed.log (Yojson's output,
    byte for byte), and the tables it keeps in memory for the operations,
    as one record. node_sandbox.soma interprets the operations with them;
    shell.ml keeps its own copies today. *)

(** Yojson.Safe.to_string of a string's characters: a quote, a backslash
    and \b \f \n \r \t named, every other control character and DEL as
    \u00XX (lowercase hex), the rest as they are. *)
nio_char (n : nat) : Ascii.ascii := Ascii.ascii_of_nat n.

nio_hex (n : nat) : Ascii.ascii := nio_char (if Nat.ltb n 10 then 48 + n else 87 + n).

(** by character code: 34 is the quote, 92 the backslash *)
nio_escape (c : Ascii.ascii) : list Ascii.ascii :=
  let n := Ascii.nat_of_ascii c in
  let bs := nio_char 92 in
  if Nat.eqb n 34 then [bs, c] else
  if Nat.eqb n 92 then [bs, bs] else
  if Nat.eqb n 8 then [bs, nio_char 98] else
  if Nat.eqb n 12 then [bs, nio_char 102] else
  if Nat.eqb n 10 then [bs, nio_char 110] else
  if Nat.eqb n 13 then [bs, nio_char 114] else
  if Nat.eqb n 9 then [bs, nio_char 116] else
  if Nat.ltb n 32 || Nat.eqb n 127 then
    [bs, nio_char 117, nio_char 48, nio_char 48, nio_hex (Nat.div n 16), nio_hex (Nat.modulo n 16)]
  else [c].

nio_json_string (s : string) : string :=
  Stdlib.Strings.String.string_of_list_ascii
    (nio_char 34 :: List.flat_map nio_escape (Stdlib.Strings.String.list_ascii_of_string s) ++ [nio_char 34]).

(** A list of strings as JSON, as Yojson writes it: no spaces. *)
nio_json_strings (l : list string) : string :=
  Stdlib.Strings.String.append "["
    (Stdlib.Strings.String.append (Stdlib.Strings.String.concat "," (List.map nio_json_string l)) "]").

(** blocks.log's line for a decided block, and signed.log's for a vote. *)
nio_block_line (height : string) (txs : list string) : string :=
  Stdlib.Strings.String.concat "" ["{""h"":", height, ",""txs"":", nio_json_strings txs, "}"].

nio_vote_line (slot vid : string) (fields : list string) : string :=
  Stdlib.Strings.String.concat " " [slot, vid, nio_json_strings fields].

(** The tables an interpreter keeps for the operations: timers (when, in
    the clock's seconds, and the event), events queued for the loop, the
    catch-up served table, the nonce-flood mark, diverged repositories,
    the versions applied, resend memory, the node's own transactions, and
    the height. *)
Record nio_tables := {
  t_timers : list (PrimFloat.float * list string);
  t_queue : list (list string);
  t_served : list ((string * string) * PrimFloat.float);
  t_flood : bool;
  t_diverged : list (string * string);
  t_applied : list (string * string);
  t_mine : list (string * (string * (list string * list string)));
  t_txs : list (PrimFloat.float * string);
  t_height : string }.

nio_empty : nio_tables :=
  {| t_timers := []; t_queue := []; t_served := []; t_flood := false; t_diverged := [];
     t_applied := []; t_mine := []; t_txs := []; t_height := "0" |}.

nio_eq (a b : string) : bool := Stdlib.Strings.String.eqb a b.

Fixpoint nio_find {A : Type} (eq : string * string -> bool) (l : list ((string * string) * A)) : option A :=
  match l with
  | [] => None
  | (k, v) :: rest => if eq k then Some v else nio_find eq rest
  end.

nio_key_is (who first : string) (k : string * string) : bool :=
  nio_eq (fst k) who && nio_eq (snd k) first.

Fixpoint nio_has (k : string) (l : list (string * string)) : bool :=
  match l with [] => false | (x, _) :: rest => nio_eq x k || nio_has k rest end.

(** A small whole number as a float, by adding ones: digits and ten. *)
Fixpoint nio_small (n : nat) : PrimFloat.float :=
  match n with 0 => PrimFloat.zero | S k => PrimFloat.add (nio_small k) PrimFloat.one end.

nio_ten : PrimFloat.float := nio_small 10.

(** digits from the front: their value, how many, and what follows *)
Fixpoint nio_digits (cs : list Ascii.ascii) (acc : PrimFloat.float) (count : nat)
    : PrimFloat.float * nat * list Ascii.ascii :=
  match cs with
  | c :: rest =>
      let n := Ascii.nat_of_ascii c in
      if Nat.leb 48 n && Nat.leb n 57 then
        nio_digits rest (PrimFloat.add (PrimFloat.mul acc nio_ten) (nio_small (n - 48))) (S count)
      else (acc, count, cs)
  | [] => (acc, count, cs)
  end.

Fixpoint nio_pow10 (k : nat) : PrimFloat.float :=
  match k with 0 => PrimFloat.one | S j => PrimFloat.mul nio_ten (nio_pow10 j) end.

Fixpoint nio_nat_digits (cs : list Ascii.ascii) (acc : nat) : nat * list Ascii.ascii :=
  match cs with
  | c :: rest =>
      let n := Ascii.nat_of_ascii c in
      if Nat.leb 48 n && Nat.leb n 57 then nio_nat_digits rest (acc * 10 + (n - 48)) else (acc, cs)
  | [] => (acc, cs)
  end.

(** A decimal number as the clock's text has it: an optional minus,
    digits, an optional fraction, an optional exponent (e, a sign, digits).
    Within rounding; None if the text is anything else. *)
nio_decimal (s : string) : option PrimFloat.float :=
  let cs := Stdlib.Strings.String.list_ascii_of_string s in
  let (neg, cs) := match cs with
                   | c :: r => if Nat.eqb (Ascii.nat_of_ascii c) 45 then (true, r) else (false, cs)
                   | [] => (false, cs) end in
  match nio_digits cs PrimFloat.zero 0 with
  | (whole, n, rest) =>
      let (frac, rest) := match rest with
        | c :: r => if Nat.eqb (Ascii.nat_of_ascii c) 46 then
                      match nio_digits r PrimFloat.zero 0 with
                      | (f, m, after) => (PrimFloat.div f (nio_pow10 m), after)
                      end
                    else (PrimFloat.zero, rest)
        | [] => (PrimFloat.zero, rest) end in
      let (exp, rest) := match rest with
        | c :: r => if Nat.eqb (Ascii.nat_of_ascii c) 101 || Nat.eqb (Ascii.nat_of_ascii c) 69 then
                      match r with
                      | d :: r' => if Nat.eqb (Ascii.nat_of_ascii d) 45 then
                                     let (k, after) := nio_nat_digits r' 0 in (PrimFloat.div PrimFloat.one (nio_pow10 k), after)
                                   else if Nat.eqb (Ascii.nat_of_ascii d) 43 then
                                     let (k, after) := nio_nat_digits r' 0 in (nio_pow10 k, after)
                                   else let (k, after) := nio_nat_digits r 0 in (nio_pow10 k, after)
                      | [] => (PrimFloat.one, rest)
                      end
                    else (PrimFloat.one, rest)
        | [] => (PrimFloat.one, rest) end in
      match n, rest with
      | 0, _ => None
      | _, [] => let v := PrimFloat.mul (PrimFloat.add whole frac) exp in
                 Some (if neg then PrimFloat.opp v else v)
      | _, _ :: _ => None
      end
  end.

nio_num (s : string) : PrimFloat.float :=
  match nio_decimal s with Some f => f | None => PrimFloat.zero end.

nio_ok : bool * PrimFloat.float := (true, PrimFloat.zero).

nio_with_timers (t : nio_tables) (v : list (PrimFloat.float * list string)) : nio_tables :=
  {| t_timers := v; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t |}.
nio_with_queue (t : nio_tables) (v : list (list string)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := v; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t |}.
nio_with_served (t : nio_tables) (v : list ((string * string) * PrimFloat.float)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := v; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t |}.
nio_with_flood (t : nio_tables) (v : bool) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := v;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t |}.
nio_with_diverged (t : nio_tables) (v : list (string * string)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := v; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t |}.
nio_with_applied (t : nio_tables) (v : list (string * string)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := v; t_mine := t_mine t; t_txs := t_txs t;
     t_height := t_height t |}.
nio_with_mine (t : nio_tables) (v : list (string * (string * (list string * list string)))) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := v; t_txs := t_txs t;
     t_height := t_height t |}.
nio_with_txs (t : nio_tables) (v : list (PrimFloat.float * string)) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := v;
     t_height := t_height t |}.
nio_with_height (t : nio_tables) (v : string) : nio_tables :=
  {| t_timers := t_timers t; t_queue := t_queue t; t_served := t_served t; t_flood := t_flood t;
     t_diverged := t_diverged t; t_applied := t_applied t; t_mine := t_mine t; t_txs := t_txs t;
     t_height := v |}.

(** What an operation does to the tables, at the clock's [now], as
    shell.ml's handle does it: a timer is due [ms] milliseconds from now;
    the height drops resend memory below it; the served table and the
    applied versions keep one entry a key. [None]: the operation isn't a
    table's (logging, the clock, storage, peer links, CI, jobs). *)
nio_table_op (now : PrimFloat.float) (t : nio_tables) (op : node_op)
    : option ((bool * PrimFloat.float) * nio_tables) :=
  match op with
  | IoTimer ms ev =>
      Some (nio_ok, nio_with_timers t ((PrimFloat.add now (PrimFloat.div (nio_num ms) (nio_small 1000)), ev) :: t_timers t))
  | IoQueue ev => Some (nio_ok, nio_with_queue t (t_queue t ++ [ev]))
  | IoSetHeight h =>
      let floor := nio_num h in
      Some (nio_ok, nio_with_mine (nio_with_height t h)
                      (List.filter (fun m => PrimFloat.leb floor (nio_num (fst m))) (t_mine t)))
  | IoTrackTx raw => Some (nio_ok, nio_with_txs t ((now, raw) :: t_txs t))
  | IoMarkNonceFlood => Some (nio_ok, nio_with_flood t true)
  | IoNonceFlooded => Some ((t_flood t, PrimFloat.zero), t)
  | IoMergeApplied r v =>
      Some (nio_ok, nio_with_applied t ((r, v) :: List.filter (fun p => negb (nio_eq (fst p) r)) (t_applied t)))
  | IoMergeDiverged r entry => Some (nio_ok, nio_with_diverged t ((r, entry) :: t_diverged t))
  | IoIsDiverged r => Some ((nio_has r (t_diverged t), PrimFloat.zero), t)
  | IoRememberBroadcast h kind fields alt => Some (nio_ok, nio_with_mine t ((h, (kind, (fields, alt))) :: t_mine t))
  | IoServedAt who first =>
      match nio_find (nio_key_is who first) (t_served t) with
      | Some time => Some ((true, time), t)
      | None => Some ((false, PrimFloat.zero), t)
      end
  | IoMarkServed who first stamp =>
      Some (nio_ok, nio_with_served t (((who, first), nio_num stamp) ::
              List.filter (fun e => negb (nio_key_is who first (fst e))) (t_served t)))
  | _ => None
  end.
