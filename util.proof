(** What util.soma's string functions do, checked whenever util.soma is
    built. They read strings by offset or as lists of characters, not as
    [SCons c r], which copies once extracted (util.soma, "strings by
    offset"); these pin the results the character-at-a-time versions gave. *)

Example substr_is_total : substr "abc" 1 5 = "bc" /\ substr "abc" 7 1 = "" /\ substr "abc" 0 0 = "".
Proof. repeat split; reflexivity. Qed.

Example find_str_finds : find_str "b" "abcb" 0 = Some 1 /\ find_str "b" "abcb" 2 = Some 3
  /\ find_str "x" "abc" 0 = None /\ find_str "abcd" "abc" 0 = None /\ find_str "" "ab" 0 = Some 0.
Proof. repeat split; reflexivity. Qed.

Example starts_and_contains : starts "ab" "abc" = true /\ starts "abc" "ab" = false /\ starts "" "" = true
  /\ contains "/./" "/a/./b/" = true /\ contains ".." "a.b" = false /\ contains "" "" = true.
Proof. repeat split; reflexivity. Qed.

Example trim_drops_blanks : trim "  a b  " = "a b" /\ trim "   " = "" /\ trim "" = "" /\ trim "a" = "a".
Proof. repeat split; reflexivity. Qed.

Example split_lines_as_ocaml : split_lines "" = [""] /\ split_lines "a" = ["a"]
  /\ split_lines (append "a" (append newline "b")) = "a" :: "b" :: []
  /\ split_lines (append "a" newline) = "a" :: "" :: [].
Proof. repeat split; reflexivity. Qed.

Example replace_all_is_literal : replace_all "{{F}} x {{F}}" "{{F}}" "T" = "T x T"
  /\ replace_all "aaa" "aa" "b" = "ba" /\ replace_all "abc" "" "x" = "abc"
  /\ replace_all "abc" "{{F}}" "x" = "abc" /\ replace_all "ab" "b" "{{b}}" = "a{{b}}".
Proof. repeat split; reflexivity. Qed.

(** The prompt's placeholders: overlapping matches go left to right without
    overlap, an empty pattern changes nothing, an absent one changes
    nothing, and the inserted text isn't scanned again. *)
Example replace_all_overlapping_empty_absent :
  replace_all "aaaa" "aa" "b" = "bb" /\ replace_all "aaaaa" "aa" "b" = "bba"
  /\ replace_all "{{REPOS}}" "{{REPO}}" "x" = "{{REPOS}}"
  /\ replace_all "" "" "x" = "" /\ replace_all "" "a" "x" = ""
  /\ replace_all "x {{F}}" "" "T" = "x {{F}}"
  /\ replace_all "no placeholder here" "{{PLAN}}" "P" = "no placeholder here"
  /\ replace_all "{{F}}{{F}}" "{{F}}" "{{F}}" = "{{F}}{{F}}".
Proof. repeat split; reflexivity. Qed.

Theorem replace_all_empty_pattern : forall s r, replace_all s "" r = s.
Proof. intros s r. reflexivity. Qed.

Lemma substring_whole : forall s,
  Stdlib.Strings.String.substring 0 (Stdlib.Strings.String.length s) s = s.
Proof.
  induction s as [| c s IH]; simpl.
  - reflexivity.
  - rewrite IH. reflexivity.
Qed.

(** A prompt without a placeholder comes out of replace_all unchanged:
    filling {{PLAN}} into a prompt that doesn't ask for it changes nothing. *)
Theorem replace_all_absent : forall s sub r,
  contains sub s = false -> replace_all s sub r = s.
Proof.
  intros s sub r H. unfold contains in H.
  destruct (find_str sub s 0) eqn:F; [discriminate |].
  unfold replace_all.
  destruct (seq sub "") eqn:E; [reflexivity |].
  rewrite Nat.add_1_r. cbn [replace_all_go]. rewrite F.
  cbn [rev_onto Stdlib.Strings.String.concat].
  unfold drop_str, substr, slen. rewrite Nat.sub_0_r. apply substring_whole.
Qed.

(** A plan's open items: open lines in order, trimmed; marked done ("* ", "+ "),
    dropped (-), notes (#), dates and blank lines left out. *)
Example plan_open_open_marked_dropped :
  plan_open (append "# a note" (append newline (append "2026-11-10" (append newline
    (append "first open" (append newline (append "+ marked done" (append newline
    (append "* done today" (append newline (append "- dropped" (append newline
    (append "  second open  " (append newline (append "" (append newline "-"))))))))))))))))
  = ["first open", "second open"]
  /\ plan_open "" = [] /\ plan_open "+done" = ["+done"].
Proof. repeat split; reflexivity. Qed.

(** overlapping places count: "aa" is twice in "aaa", so an edit of it is ambiguous *)
Example positions_two_at_most : positions "abab" "ab" = 0 :: 2 :: [] /\ positions "aaa" "aa" = 0 :: 1 :: []
  /\ positions "ababab" "ab" = 0 :: 2 :: [] /\ positions "abc" "c" = [2] /\ positions "abc" "x" = []
  /\ positions "abc" "" = [].
Proof. repeat split; reflexivity. Qed.

Example edit_once_needs_one_place : edit_once "let x = 1" "1" "2" = Some "let x = 2"
  /\ edit_once "a a" "a" "b" = None /\ edit_once "abc" "x" "y" = None.
Proof. repeat split; reflexivity. Qed.

(** What a merge's edit promises: when edit_once gives a text, the old text
    occurs at exactly one offset [i] (the first find finds it, and none is
    found after it), and the result is the file with only that occurrence
    replaced: the text before [i] and after the match are kept as they were. *)
Theorem edit_once_single_match : forall s old r t,
  edit_once s old r = Some t ->
  exists i, find_str old s 0 = Some i /\ find_str old s (Succ i) = None
    /\ t = append (take_str i s) (append r (drop_str (i + slen old) s)).
Proof.
  intros s old r t H. unfold edit_once, positions in H.
  destruct (seq old "") eqn:E; [discriminate |].
  destruct (find_str old s 0) as [i |] eqn:F1; [| discriminate].
  destruct (find_str old s (Succ i)) as [j |] eqn:F2; [discriminate |].
  injection H as <-. exists i. split; [first [exact F1 | reflexivity] | split; [first [exact F2 | reflexivity] |]].
  reflexivity.
Qed.

(** an old text that isn't in the file gives no edit *)
Theorem edit_once_absent : forall s old r,
  find_str old s 0 = None -> edit_once s old r = None.
Proof.
  intros s old r H. unfold edit_once, positions.
  destruct (seq old ""); [reflexivity |]. rewrite H. reflexivity.
Qed.

Example defang_breaks_braces : defang "{{F}}" = "{ {F}}" /\ defang "{{{" = "{ { {" /\ defang "{" = "{".
Proof. repeat split; reflexivity. Qed.

Example text_checks : plain_text "a b" = true /\ clean_text "ab" = "ab" /\ lower "A/.Git" = "a/.git"
  /\ shell_safe_path "src/a..b" = true /\ shell_safe_path "a/../b" = false /\ safe_path "a/.GIT/x" = false.
Proof. repeat split; reflexivity. Qed.

(** a failed check's output on chain: secrets out, errors and paths as they were (P-12) *)
Example redact_hides_secrets :
  redact "File ""agent.soma"", line 512: Error: not found" = "File ""agent.soma"", line 512: Error: not found"
  /\ redact "/tmp/pantheon-check8f3a2c/main.soma: 3 failed" = "/tmp/pantheon-check8f3a2c/main.soma: 3 failed"
  /\ redact "VERS_API_KEY=sk1 rest" = "VERS_API_KEY=[redacted] rest"
  /\ redact "token: hunter2 ok" = "token: [redacted] ok"
  /\ redact "PASSWORD=""a b"" x" = "PASSWORD=""[redacted] b"" x"
  /\ redact "got 3f2a9c4b5d6e7f8091a2b3c4d5e6f708 here" = "got [redacted] here"
  /\ redact "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  /\ redact "secret:" = "secret:" /\ redact "" = "".
Proof. repeat split; reflexivity. Qed.

Example numbers : digits "120" 0 = 120 /\ short_digits "123" 3 = true /\ short_digits "1234" 3 = false
  /\ short_digits "" 0 = true /\ hexnum "ff0" 2 0 = 255 /\ nth_char 1 "ab" = 98 /\ nth_char 5 "ab" = 256.
Proof. repeat split; reflexivity. Qed.

Example plan_lines : is_date_line "2026-11-09" = true /\ is_date_line "2026-11-0" = false
  /\ truncate_line "abc" = "abc"
  /\ plan_line_start "abc..." = "abc" /\ plan_line_start " abc " = "abc"
  /\ plan_line_start (append "abc " ellipsis) = "abc" /\ plan_line_start "abc" = "abc".
Proof. repeat split; reflexivity. Qed.

(** the scan before JSON parsing: depth and items capped, strings skipped *)
Example shallow_json_caps : shallow_json "1" "10" "[1,2]" = true /\ shallow_json "1" "10" "[[1]]" = false
  /\ shallow_json "4" "2" "[1,2,3]" = false /\ shallow_json "1" "10" "[""[[""]" = true
  /\ shallow_json "1" "10" "[""\""[[""]" = true /\ shallow_json "1" "10" "" = true.
Proof. repeat split; reflexivity. Qed.

(** The actual product sent to node_open: project each callback and use it
    on pure inputs, including failures and asymmetric contains arguments. *)
Example packed_node_helpers_work :
  let '(edit, has, path) := pack_helpers node_helpers in
  edit "abc" "b" "X" = Some "aXc" /\
  edit "aaa" "aa" "X" = None /\
  edit "abc" "z" "X" = None /\
  has "bc" "abc" = true /\ has "abc" "bc" = false /\
  path "src/a..b" = true /\ path "../escape" = false /\
  path "sub/.GiT/config" = false.
Proof. repeat split; reflexivity. Qed.

Example helper_record_agrees :
  helper_edit_once node_helpers = edit_once /\
  helper_contains node_helpers = contains /\
  helper_safe_path node_helpers = shell_safe_path.
Proof. repeat split; reflexivity. Qed.
