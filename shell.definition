(** What Soma takes the shell to be. shell.ml does all the I/O: sockets,
    timers, keys, signatures, disk and model processes. The Soma files decide
    everything, and the kernel never computes these, so to a proof each is an
    assumption: soma explore lists them. *)
OCaml Library "cryptokit".
OCaml Library "yojson".

(** hex sha256 of a string *)
sha256 : string -> string.

(** hex sha256 of a list of strings, unambiguous about where each one ends *)
hash_list : list string -> string.

(** A signed transaction, checked against the genesis keys: its fields
    [agent; nonce; type; args...], or [] when it's malformed, oversized, or
    its signature doesn't verify. The same on every node, given one genesis. *)
decode_tx : string -> list string.

(** Process arguments exclude the executable name. Soma chooses the command. *)
argv : unit -> list string.
read_plan : string -> string.
print_lines : list string -> unit.
print_text : string -> unit.
cmd_init : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> list string -> unit.
cmd_keygen : list string -> unit.
cmd_genesis : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string -> string -> unit.
cmd_edits : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string -> list string -> unit.
cmd_apply_edits : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string -> string -> unit.
cmd_check : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string -> string -> string -> string -> unit.
cmd_status : string -> unit.
cmd_tx : string -> list string -> unit.
cmd_up : string -> list string -> unit.

(** The node loop is Soma (node.soma's run_node): the shell binds only the
    handle's setup, one select turn, the small bindings of each output, the
    snapshot, the refused set, startup data, and the endless repetition. The
    handle is a string naming the shell's side of the node. Existing Soma
    helpers are passed once as util.soma's shell_helpers record, packed as a
    product (edit_once, contains, shell_safe_path) at the binding boundary. *)
node_open : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> (string -> string -> string -> bool) -> string -> list string -> string.
events : string -> list (list string).
save_snapshot : forall {C : Type}, string -> C -> bool.
note_refused : string -> string -> bool.
(** Startup is data, interpreted by Soma before entering the event loop. *)
boot_events : string -> list (list string).
boot_snapshot : forall {C : Type}, string -> option C.
replay_count : string -> string.
(** Small I/O bindings; output tags and decisions live in Soma. *)
node_timer : string -> string -> list string -> bool.
node_log : string -> string -> bool.
node_push : string -> list string -> bool.
node_draw : string -> string * (string * string).
node_block : string -> string -> option (list string).
node_store : string -> string -> list string -> bool.
node_height : string -> string -> bool.
forever : forall {A : Type}, (A -> A) -> A -> unit.

(** Raw clock/metadata/table operations and an authenticated peer send.
    Soma chooses whether and which catch-up blocks to send. *)
node_clock : unit -> float.
node_current_height : string -> string.
node_last_served : string -> string -> string -> option float.
node_mark_served : string -> string -> string -> float -> bool.
node_peer_exists : string -> string -> bool.
node_peer_send : string -> string -> list string -> bool.

(** Status metadata and atomic file I/O; Soma assembles every status line. *)
node_checkout_heads : string -> list (string * string).
node_divergences : string -> list (string * string).
node_limit_info : string -> float * (string * (string * string)).
node_local_time : float -> string.
node_write_status : string -> string -> bool.
(** Signing, retry-table access and socket writes; Soma selects submissions. *)
node_encode_tx : string -> string -> list string -> string.
node_track_tx : string -> string -> bool.
node_nonce_flooded : string -> bool.
node_mark_nonce_flood : string -> bool.
node_send_all : string -> list string -> bool.

(** A model call's I/O; node.soma's perform_llm decides and assembles the
    prompt. The call count, bumped for this call, and the budget; holding a
    raw request until the limit's wait is over (it comes back as an
    llm_release event); starting the model process on the assembled prompt
    (the raw one too, held again if the reply says the model is limited);
    the governed repositories; a checkout's git ls-files; a file at a
    checkout's head (none: git show failed); a fresh fence token; a float
    with no decimals. None of these decides anything: the prompt
    node_llm_start gets is complete, assembled by Soma's prompt_assemble. *)
node_llm_budget : string -> string * string.
node_llm_hold : string -> string -> string -> string -> list string -> bool.
node_llm_start : string -> string -> string -> string -> string -> list string -> bool.
node_repo_names : string -> list string.
node_ls_files : string -> string -> string.
node_head_file : string -> string -> string -> option string.
node_token : unit -> string.
node_float_text : float -> string.

(** The CI check job; Soma selects it, the shell runs the process. *)
node_run_check : string -> string -> string -> string -> list string -> bool.
(** A decided merge's I/O; node.soma's perform_merge decides. The version
    applied to a repository (none: this node doesn't have it), whether its
    checkout diverged, a hard reset and clean of it, a path's kind there
    ("symlink", "dir", "file" or "none"), reading, writing (keeping the mode)
    and removing a file ("" or what went wrong), the commit (its tree and
    short id, or none when git commit failed), and recording the version
    applied or a divergence. *)
node_merge_applied : string -> string -> option string.
node_merge_diverged : string -> string -> bool.
node_merge_reset : string -> string -> bool.
node_merge_probe : string -> string -> string -> string.
node_merge_read : string -> string -> string -> option string.
node_merge_write : string -> string -> string -> string -> string.
node_merge_remove : string -> string -> string -> string.
node_merge_commit : string -> string -> string -> string -> string -> string -> string -> string -> option (string * string).
node_merge_set_applied : string -> string -> string -> bool.
node_merge_note_diverged : string -> string -> string -> bool.

(** Vote table, resend memory and socket writes. Soma chooses the message. *)
node_signed_vote : string -> string -> option string.
node_signed_body : string -> string -> option (list string).
node_remember_vote : string -> string -> string -> list string -> bool.
node_remember_broadcast : string -> string -> string -> list string -> list string -> bool.
node_peer_count : string -> string.
node_send_peer : string -> string -> list string -> bool.
