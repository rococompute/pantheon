(** What Soma takes the shell to be. shell.ml does all the I/O: sockets,
    timers, keys, signatures, disk and model processes. The Soma files decide
    everything, and the kernel never computes these, so to a proof each is an
    assumption: soma explore lists them. *)
OCaml Library "cryptokit".
OCaml Library "yojson".

(** hex sha256 of a string *)
sha256 : string -> string.

(** hex sha256 of a list of strings, unambiguous about where each one ends *)
hash_list : list string -> string.

(** A signed transaction, checked against the genesis keys: its fields
    [agent; nonce; type; args...], or [] when it's malformed, oversized, or
    its signature doesn't verify. The same on every node, given one genesis. *)
decode_tx : string -> list string.

(** Runs a node: feeds the state machine its events, one at a time, and does
    what each step's outputs say. The two functions after [step] select the
    consensus snapshot and restore it after block replay; the shell syncs
    that snapshot before sending votes. The last four functions are Soma's
    own [plan_open], [replace_all], [edit_once] and [contains] (util.soma),
    handed in so the shell's command line, edits and node loop use the Soma
    versions. Never returns. *)
run : forall {S C : Type}, S -> (S -> list string -> S * list (list string)) -> (S -> C) -> (S -> C -> S) -> (string -> list string) -> (string -> string -> string -> string) -> (string -> string -> string -> option string) -> (string -> string -> bool) -> unit.
