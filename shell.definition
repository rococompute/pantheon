(** What Soma takes the shell to be. shell.ml does all the I/O: sockets,
    timers, keys, signatures, disk and model processes. The Soma files decide
    everything, and the kernel never computes these, so to a proof each is an
    assumption: soma explore lists them. *)
OCaml Library "cryptokit".
OCaml Library "yojson".

(** hex sha256 of a string *)
sha256 : string -> string.

(** hex sha256 of a list of strings, unambiguous about where each one ends *)
hash_list : list string -> string.

(** A signed transaction's I/O; market.soma's decode_tx decides. Its parts
    as JSON: agent, nonce, fields and signature (none when it isn't that
    JSON); whether the signature verifies against that agent's genesis key
    (an unknown agent's doesn't); the transaction byte cap and the item cap
    of its bounded scan, as decimal strings. *)
tx_parts : string -> option (string * (string * (list string * string))).
tx_verify : string -> string -> list string -> string -> bool.
tx_byte_cap : unit -> string.
tx_item_cap : unit -> string.

(** Process arguments exclude the executable name. Soma chooses the command. *)
argv : unit -> list string.
read_plan : string -> string.
print_lines : list string -> unit.
print_text : string -> unit.
cmd_init : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> list string -> unit.
cmd_keygen : list string -> unit.
cmd_genesis : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string -> string -> unit.
cmd_edits : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string -> list string -> unit.
cmd_apply_edits : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string -> string -> unit.
cmd_check : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string -> string -> string -> string -> unit.
cmd_status : string -> unit.
cmd_tx : string -> list string -> unit.
cmd_up : string -> list string -> unit.

(** The node loop is Soma (node.soma's run_node): the shell binds only the
    handle's setup, one select turn, the small bindings of each output, the
    snapshot, the refused set, startup data, and the endless repetition. The
    handle is a string naming the shell's side of the node. Existing Soma
    helpers are passed once as util.soma's shell_helpers record, packed as a
    product (edit_once, contains, shell_safe_path) at the binding boundary. *)
node_open : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string -> list string -> string.
(** One select. Soma passes the wait in seconds (node.soma's select_wait). *)
events : string -> float -> list (list string).
save_snapshot : forall {C : Type}, string -> C -> bool.
note_refused : string -> string -> bool.
(** Startup is data, interpreted by Soma before entering the event loop. *)
boot_events : string -> list (list string).
boot_snapshot : forall {C : Type}, string -> option C.
replay_count : string -> string.
(** Remember one replayed block in the catch-up table, without appending it
    to blocks.log again. Soma parsed the line and checked it is the next height. *)
node_remember_block : string -> string -> list string -> bool.
(** The node's operations (node.soma's node_op, U-1), carried out: one
    operation in its wire form (node.soma's io_wire): "log" TEXT, "timer"
    MS EVENT..., "push" EVENT..., "send_all" FIELDS..., "send_peer" INDEX
    FIELDS..., "peer_send" PEER FIELDS..., "store" HEIGHT TXS...,
    "set_height" H, "write_status" TEXT, "sign_vote" SLOT VID FIELDS...,
    "track_tx" RAW, "mark_nonce_flood", "check" ID REPO HEAD EDITS...,
    "merge_applied" REPO V, "merge_diverged" REPO ENTRY, "clock". The only
    way the node logs, sets a timer, queues an event, sends on a peer link,
    does those writes, starts a CI check, or reads the clock. An effect returns (true, 0); "clock" returns (true, now),
    the same gettimeofday value the node used to read directly. *)
node_io : string -> list string -> bool * float.
(** Small I/O bindings; output tags and decisions live in Soma. *)
node_draw : string -> string * (string * string).
node_block : string -> string -> option (list string).
forever : forall {A : Type}, (A -> A) -> A -> unit.

(** Metadata and table reads. The clock is node_io's "clock" operation.
    Soma chooses whether and which catch-up blocks to send. *)
node_current_height : string -> string.
node_last_served : string -> string -> string -> option float.
node_mark_served : string -> string -> string -> float -> bool.
node_peer_exists : string -> string -> bool.
(** Verify a peer line's signature; Soma asks only for lines that are
    neither this node's own nor an already-refused transaction. *)
(** Raw Yojson members, the item's cap as decimal text, and metadata reads.
    Soma scans each raw line before invoking the JSON library, then drops
    own/refused lines before invoking node_verify_line. *)
node_line_parts : string -> option (string * (string * list string)).
node_line_item_cap : unit -> string.
node_identity : string -> string.
node_seen_refused : string -> string -> bool.
node_verify_line : string -> string -> string -> list string -> bool.

(** Status metadata and atomic file I/O; Soma assembles every status line. *)
node_checkout_heads : string -> list (string * string).
node_divergences : string -> list (string * string).
node_limit_info : string -> float * (string * (string * string)).
(** Held model requests for node.soma's release_held: the limit backoff in
    seconds and whether one released request is out to probe the limit;
    taking the oldest held request (it becomes the probe) or all of them,
    oldest first, each as an llm_release event. *)
node_release_state : string -> float * bool.
node_release_one : string -> list string.
node_release_all : string -> list (list string).
node_local_time : float -> string.
(** Signing, retry-table access and socket writes; Soma selects submissions. *)
node_encode_tx : string -> string -> list string -> string.
node_nonce_flooded : string -> bool.

(** A model call's I/O; node.soma's perform_llm decides and assembles the
    prompt. The call count, bumped for this call, and the budget; holding a
    raw request until the limit's wait is over (it comes back as an
    llm_release event); starting the model process on the assembled prompt
    (the raw one too, which comes back with the output);
    the governed repositories; a checkout's git ls-files; a file at a
    checkout's head (none: git show failed); a fresh fence token; a float
    with no decimals. None of these decides anything: the prompt
    node_llm_start gets is complete, assembled by Soma's prompt_assemble. *)
node_llm_budget : string -> string * string.
node_llm_hold : string -> string -> string -> string -> list string -> bool.
node_env_entries : unit -> list string.
(** node_llm_start's arguments after the context: the paths to remove when
    the job is over, the launch (node.soma's backend_launch, as llm_launch
    and grok_launch complete it) and the environment. A cmd: patch's fresh
    checkout (its worktree, its git directory, and whether the clone and
    checkout worked); the node's own binary; a string as a JSON string. *)
node_llm_start : string -> string -> string -> string -> string -> list string -> list string -> list string -> list string -> option (list string).
node_tool_checkout : string -> string -> (string * string) * bool.
node_self_exe : unit -> string.
node_json_string : string -> string.
(** What a model's output becomes is decided in Soma (node.soma's
    reply_events and reply_fields). node_llm_start gives the raw output event at once
    when the process couldn't start (none: it runs, and its output comes
    back as an llm_output or codex_output event). The job-output cap as a decimal string;
    the byte offset of the first "{" and of the last "}" (none when that
    byte is absent); a JSON value, parsed by yojson, as tokens ("A" count
    key value..., "L" count value..., "S" text, "B" true/false, "U", "I"
    digits, "F" the %.0f text), none when it does not parse. Soma cuts the
    slice, applies the length and shallow_json guards, and flattens.
    A run of decimal digits as a float (OCaml's float_of_string); noting a
    limit (until when, its reason, the next backoff; the probe is over);
    and setting the backoff after an answer (the probe is over). *)
node_job_output_limit : unit -> string.
(** Resume a completed job with Soma's formatted outcome; invoke its stored
    callback before cleanup and return the events that callback queued, in
    order. Missing/already-completed identifiers return no events. *)
node_job_complete : string -> string -> string -> list (list string).
(** A job's buffered read chunks, in order. Soma's job_feed appends the
    chunk the shell just read and, past the output cap, keeps the tail;
    the shell stores that list and, when the feed says the job is over,
    signals the process once (node.soma job_feed). Reading the bytes stays
    here. *)
node_job_buffer : string -> string -> list string.
node_job_store_buffer : string -> string -> list string -> bool.
node_job_flood : string -> string -> bool.
(** A CI check's result, decided in node.soma (ci_outcome): request id,
    passed, the tree, why (made plain text here) and the stage ("", "ci" or
    "node"), queued as the check_result event. *)
node_check_result : string -> string -> bool -> string -> string -> string -> bool.
node_reply_open : string -> option string.
node_reply_close : string -> option string.
node_json_tokens : string -> option (list string).
node_float_of_digits : string -> float.
node_limit_set : string -> float -> string -> float -> bool.
node_limit_clear : string -> float -> bool.
node_repo_names : string -> list string.
node_ls_files : string -> string -> string.
node_head_file : string -> string -> string -> option string.
node_token : unit -> string.
node_float_text : float -> string.

(** Connection admission and the buffered-line cap are Soma's
    (node.soma admit_decision_of, buffer_over): an offered socket the
    shell is holding, admitted in the mode Soma names (closing the
    named connection when evicting), the live connections and their
    last-activity times, closing one, and the line byte cap as a
    decimal string. The shell only accepts, reads and closes sockets. *)
node_conn_admit : string -> string -> string -> string -> bool.
node_conns : string -> list (string * float).
(** A connection's buffered read chunks, in order, and storing the
    chunks Soma's feed_chunks says to keep: the shell only reads the
    bytes, Soma splits them into lines (node.soma feed_chunks). *)
node_conn_buffer : string -> string -> list string.
node_conn_store_buffer : string -> string -> list string -> bool.
node_conn_close : string -> string -> bool.
node_line_limit : string -> string.
(** Dial, resend and the inbox, then the turn's clock. Soma decides which
    jobs are past their limit and which timers fire, replaces the timer
    list with the ones still waiting, and chooses the select wait. The
    shell only stores those facts, signals a job Soma names, and selects. *)
node_poll_prep : string -> bool.
node_turn_now : string -> float.
node_timers : string -> list (float * list string).
node_set_timers : string -> list (float * list string) -> bool.
node_jobs : string -> list (string * (float * (float * bool))).
node_job_expire : string -> string -> bool.
node_queue_empty : string -> bool.

(** A decided merge's I/O; node.soma's perform_merge decides. The version
    applied to a repository (none: this node doesn't have it), whether its
    checkout diverged, a hard reset and clean of it, a path's kind there
    ("symlink", "dir", "file" or "none"), reading, writing (keeping the mode)
    and removing a file ("" or what went wrong), the commit (its tree and
    short id, or none when git commit failed), and recording the version
    applied or a divergence. *)
node_merge_applied : string -> string -> option string.
node_merge_diverged : string -> string -> bool.
node_merge_reset : string -> string -> bool.
node_merge_probe : string -> string -> string -> string.
node_merge_read : string -> string -> string -> option string.
node_merge_write : string -> string -> string -> string -> string.
node_merge_remove : string -> string -> string -> string.
node_merge_commit : string -> string -> string -> string -> string -> string -> string -> string -> option (string * string).

(** Vote table, resend memory and socket writes. Soma chooses the message. *)
node_signed_vote : string -> string -> option string.
node_signed_body : string -> string -> option (list string).
node_remember_broadcast : string -> string -> string -> list string -> list string -> bool.
node_peer_count : string -> string.
