(** What Soma takes the shell to be. shell.ml does all the I/O: sockets,
    timers, keys, signatures, disk and model processes. The Soma files decide
    everything, and the kernel never computes these, so to a proof each is an
    assumption: soma explore lists them. *)
OCaml Library "cryptokit".
OCaml Library "yojson".

(** sha256 and hash_list are Soma's (util.soma, through Soma.Crypto);
    shell.ml keeps its own, Cryptokit's, for what it hashes itself (the
    genesis, the leader draw's chains), which are the same function. *)

(** A signed transaction is all Soma's: market.soma's decode_tx reads it
    (util.soma's json_tokens), checks the signature with the agent's
    genesis key, which the market keeps from the boot events (nodeio's
    nio_tx_verify, Soma's RSA), and owns the caps. So are JSON tokens,
    floats as text and the job caps (util.soma, node.soma): the binary
    and a unikernel run the same functions. *)

(** Process arguments exclude the executable name. Soma chooses the command. *)
argv : unit -> list string.
(** Test programs print their checks with these. *)
print_lines : list string -> unit.
print_text : string -> unit.
(** The commands are cli.soma's node programs, run through node_io (their
    operations need no node). cli_open hands the edits operations Soma's
    helpers, as node_open does, and names the handle they run under. *)
cli_open : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> string.

(** The node loop is Soma (node.soma's run_node): the shell binds only the
    handle's runtime, built from what cli.soma's node_setup decided (framed:
    the settings, the key, exclusions, CI, agents, repositories, then the
    boot events), and the endless repetition; the rest is node_io
    operations. The handle is a string naming the shell's side of the node. Existing Soma
    helpers are passed once as util.soma's shell_helpers record, packed as a
    product (edit_once, contains, shell_safe_path) at the binding boundary. *)
node_open : (((string -> string -> string -> option string) * (string -> string -> bool)) * (string -> bool)) -> list string -> string.
(** The consensus snapshot is node_io operations: "snapshot_save" TEXT and
    "snapshot_load" (node.soma's snapshot_text and snapshot_of). *)
(** Startup is data, interpreted by Soma before entering the event loop
    (node.soma's boot_prog), through node_io: "boot_events" (framed:
    "field" VALUE... "alternate", per event), "replay_count",
    "remember_block" H TXS... (a replayed block remembered for catch-up,
    not appended again; Soma parsed the line and checked it is the next
    height), "signed_text" (signed.log's bytes, "" when there is none),
    "signed_restore" SLOT VID FIELDS... (a vote read back, not appended
    again) and "fail" MESSAGE (refusing to start: the message on stderr,
    exit 1; it needs no node). *)
(** The node's operations (node.soma's node_op, U-1), carried out: one
    operation in its wire form (node.soma's io_wire): "log" TEXT, "timer"
    MS EVENT..., "push" EVENT..., "send_all" FIELDS..., "send_peer" INDEX
    FIELDS..., "peer_send" PEER FIELDS..., "store" HEIGHT TXS...,
    "set_height" H, "write_status" TEXT, "sign_vote" SLOT VID FIELDS...,
    "track_tx" RAW, "mark_nonce_flood", "check" ID REPO HEAD EDITS...,
    "merge_applied" REPO V, "merge_diverged" REPO ENTRY, "clock",
    "remember_broadcast" HEIGHT KIND ("field" VALUE)... "alternate" ALT... .
    "served_at" WHO FIRST returns (present, exact timestamp), with (false,0)
    for missing. "mark_served" WHO FIRST TIMESTAMP uses node_float_wire's
    lossless decimal text and returns (true,0).
    The tagged prefix frames two arbitrary lists without a count. The only
    way the node logs, sets a timer, queues an event, sends on a peer link,
    does those writes, starts a CI check, or reads the clock. An effect returns (true, 0); "clock" returns (true, now),
    the same gettimeofday value the node used to read directly. The answer
    is nodeio.soma's nanswer: (carried out or the boolean read, (a number,
    data)); an effect's is (true, (0, [])). *)
(** Boolean reads peer_exists WHO, nonce_flooded and is_diverged REPO return
    (value, 0): false is a table value, not an interpreter failure. *)
node_io : string -> list string -> bool * (float * list string).
(** The data reads are node_io operations too (nodeio.soma's IoDraw,
    IoBlock, IoHeight, IoPeerCount, IoSignedVote, IoSignedBody,
    IoSignedAt, IoEncodeTx, IoCheckExclusions): "draw" answers [byz, limit, secret],
    "block" H the stored block's transactions (found or not), "height"
    and "peer_count" one decimal, "signed_vote" SLOT the value id and
    "signed_body" SLOT the message signed there (found or not),
    "signed_at" H every message signed at height H, each framed as
    "field" VALUE... "alternate",
    "encode_tx" NONCE FIELDS the transaction signed with the node's key,
    "check_exclusions" the --no-check names then the scope's, framed as
    "field" NAME... "alternate" NAME... . The status file's facts too:
    "checkout_heads" and "divergences" answer pairs flattened (REPO
    VALUE...), "limit_info" (the time the limit lasts until, [backend,
    held, reason]), "local_time" STAMP (node_float_wire's text) [HH:MM]. *)
forever : forall {A : Type}, (A -> A) -> A -> unit.

(** Metadata reads. The clock and the height are node_io operations.
    Soma chooses whether and which catch-up blocks to send. *)
(** The event loop's own I/O is node_io operations too (nodeio.soma's
    IoRefuse ... IoEvents; node.soma's node_tick_prog decides): "refuse"
    RAW, "identity", "seen_refused" RAW, "verify_line" FROM SIG FIELDS...
    (a flag: the signature checks), "conns" ([conn, last read] framed:
    "field" VALUE... "alternate", per connection), "poll_prep" (sample the
    turn clock, dial and resend), "inbox_state" (the last poll, [dir]),
    "inbox_stamp" STAMP, "dir_entries" PATH and "remove_file" PATH (need
    no node; errors propagate), "turn_now", "timers" ([deadline,
    event...], framed) and "set_timers" (the same), "jobs" ([id, started,
    limit, stopped], framed), "queue_empty" (a flag) and "events" WAIT
    (one select; the events, framed). Times go as node_float_wire's text. *)

(** What a model's output becomes, and the held requests, are node_io
    operations (nodeio.soma's IoLimitSet ... IoDiscardFile; node.soma's
    reply_prog, release_prog and model_output_prog decide): "limit_set"
    UNTIL REASON BACKOFF and "limit_clear" BACKOFF (node_float_wire's
    text; the probe is over), "release_state" (the backoff, then
    [true/false]: probing), "held_requests" (newest first) and
    "held_store" PROBING REQUESTS (each ID KIND PROMPT CTX..., framed:
    "field" VALUE... "alternate", per request), "job_complete" JOB RESULT
    (a finished job resumed with Soma's outcome; its callback's events,
    framed so), "ci_launch" REQ OUT TREE CI (CI started for a tree Soma
    accepted; the events an immediate start failure queued, framed),
    "read_text" PATH (found or not) and "discard_file" PATH (removed, if
    it's there); the last two need no node. *)

(** A model call's I/O is node_io operations (nodeio.soma's IoLlmBudget
    ... IoHeadFile; node.soma's llm_prog decides and assembles the
    prompt): "llm_budget" [calls, max] (the count bumped for this call),
    "llm_hold" ID KIND PROMPT CTX..., "llm_start" ID KIND RAW PROMPT then
    the context, the paths to remove when the job is over and the launch,
    each framed "field" VALUE... "alternate", then the environment (found:
    the raw output event at once; not found: it runs), "tool_checkout"
    REPO [worktree, git directory, "true"/"false"], "self_exe",
    "env_entries", "token" (a fresh fence token), "repo_names", "ls_files"
    REPO [text], "head_file" REPO PATH [text] (not found: git show
    failed). None of these decides anything. The environment, for tests. *)
node_env_entries : unit -> list string.
(** What a model's output becomes is decided in Soma (node.soma's
    reply_events and reply_fields). node_llm_start gives the raw output event at once
    when the process couldn't start (none: it runs, and its output comes
    back as an llm_output or codex_file event). The job-output cap as a decimal string;
    the byte offset of the first "{" and of the last "}" (none when that
    byte is absent); a JSON value, parsed by yojson, as tokens ("A" count
    key value..., "L" count value..., "S" text, "B" true/false, "U", "I"
    digits, "F" the %.0f text), none when it does not parse. Soma cuts the
    slice, applies the length and shallow_json guards, and flattens.
    A run of decimal digits as a float (OCaml's float_of_string); noting a
    limit (until when, its reason, the next backoff; the probe is over);
    and setting the backoff after an answer (the probe is over). *)
(** A job's buffered read chunks, in order. Soma's job_feed appends the
    chunk the shell just read and, past the output cap, keeps the tail;
    the shell stores that list and, when the feed says the job is over,
    signals the process once (node.soma job_feed). Reading the bytes stays
    here. *)

(** Connection admission and the buffered-line cap are Soma's
    (node.soma admit_decision_of, buffer_over; the per-host and total
    counts are conn_offer_counts, over the hosts the shell lists in the
    conn_offer event): an offered socket the
    shell is holding, admitted in the mode Soma names (closing the
    named connection when evicting, node.soma conn_admit_plan), the
    live connections and their last-activity times, and closing one.
    The line byte cap is Soma's too (node.soma peer_line_cap, from
    tx_byte_cap). The shell only accepts, reads and closes sockets. *)
(** A connection's buffered read chunks live in Soma's node state:
    the shell only reads the bytes, Soma splits them into lines
    (node.soma feed_chunks) and keeps what is left. *)

(** A decided merge's I/O is node_io operations (nodeio.soma's
    IoAppliedVersion ... IoMergeCommit; node.soma's merge_prog decides):
    "applied_version" REPO the version applied (not found: this node
    doesn't have it), "merge_reset" REPO a hard reset and clean,
    "merge_probe" REPO PATH a path's kind ("symlink", "dir", "file" or
    "none"), "merge_read" REPO PATH a file (found or not), "merge_write"
    REPO PATH TEXT (keeping the mode) and "merge_remove" REPO PATH answer
    "" or what went wrong, "merge_commit" REPO V TREE BID TASK BIDDER SPEC
    [tree, short id] (not found when git commit failed). *)

