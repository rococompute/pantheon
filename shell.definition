(** What Soma takes the shell to be. shell.ml does the host's I/O: its
    sockets by name and its files (what node_net.soma makes of the
    kernel's network and named files, and the service's socket), the
    clock, paths, processes and the commands' I/O. The Soma files decide
    everything, including the node's tables, peer links, timers and
    signatures (node_kernel.soma), what its checkouts, model calls, checks
    and CI ask of the host (node_host.soma), git and programs
    (node_git.soma), and which primitive each operation is
    (node_shell.soma's host_prim), and Rocq's kernel never computes these,
    so to a proof each is an assumption: soma explore lists them. *)
OCaml Library "unix".
(** sha256, hash_list, RSA signing and a new key are Soma's (util.soma,
    nodeio.soma and cli.soma, through Soma.Crypto), in the binary as in
    the unikernel; the shell gives only random bytes (host_random_bytes). *)

(** A signed transaction is all Soma's: market.soma's decode_tx reads it
    (util.soma's json_tokens), checks the signature with the agent's
    genesis key, which the market keeps from the boot events (nodeio's
    nio_tx_verify, Soma's RSA), and owns the caps. So are JSON tokens,
    floats as text and the job caps (util.soma, node.soma): the binary
    and a unikernel run the same functions. *)

(** Process arguments exclude the executable name. Soma chooses the command. *)
argv : unit -> list string.
(** Test programs print their checks with this. *)
print_lines : list string -> unit.
forever : forall {A : Type}, (A -> A) -> A -> unit.

(** The primitives. node_shell.soma's host_prim carries out each of the
    node's operations that is one (nodeio.soma's node_op) with one of
    these, its fields the arguments; the commands (cli.soma), the node's
    loop (node_shell.soma's run_node, the kernel's boot and turns), its
    network and named files (node_net.soma), its git and programs
    (node_git.soma), paths (node_path.soma) and files (node_file.soma)
    are Soma over them. The answer is nodeio.soma's nanswer: (carried out
    or the boolean read, (a number, data)); an effect's is (true, (0,
    [])); one that failed and says why is (false, (0, [why])). None
    decides anything. *)

(** the clock (true, (now, [])), the log (a timestamped line), STAMP
    (node_float_wire's text) as local [HH:MM] for the status file, and
    refusing to start: the message on stderr, exit 1 *)
host_clock : unit -> bool * (float * list string).
host_log : string -> bool * (float * list string).
host_local_time : string -> bool * (float * list string).
host_fail : string -> bool * (float * list string).

(** the commands' I/O (cli.soma): plain output, an exit status, this
    directory, and COUNT random bytes from the system ([the bytes]; Soma
    makes them hex) *)
host_print : string -> bool * (float * list string).
host_exit : string -> bool * (float * list string).
host_cwd : unit -> bool * (float * list string).
host_random_bytes : string -> bool * (float * list string).

(** files: one read whole (found or not), whether a path is there, a
    directory's entries, a mode set (octal; whether it was), text
    appended in one write and then on disk (a block or a signed vote
    survives a crash whole), TEXT put in PATH (created or emptied first;
    SYNC "true": on disk before the answer), a file's mode ([octal],
    found when it's there), a rename, a directory synced, one directory
    made, one file removed, a new private temporary file (PREFIX SUFFIX:
    [its path]) and a new temporary directory ([its path]). node_file.soma
    writes a file whole, makes directories and removes files with these. *)
host_read_text : string -> bool * (float * list string).
host_file_exists : string -> bool * (float * list string).
host_dir_entries : string -> bool * (float * list string).
host_chmod : string -> string -> bool * (float * list string).
host_append_synced : string -> string -> bool * (float * list string).
host_file_put : string -> string -> string -> bool * (float * list string).
host_file_mode : string -> bool * (float * list string).
host_rename : string -> string -> bool * (float * list string).
host_sync_dir : string -> bool * (float * list string).
host_make_dir : string -> bool * (float * list string).
host_remove_file : string -> bool * (float * list string).
host_temp_new : string -> string -> bool * (float * list string).
host_temp_dir : string -> bool * (float * list string).

(** PROG ARGS started on its own and not waited for, its parent the
    system's, its input and output /dev/null (node_file.soma removes a
    tree in the background, rm -rf -- PATH, with this); the binary's own
    path, absolute, fixed when it started; the environment's entries *)
host_start_detached : string -> list string -> bool * (float * list string).
host_self_exe : unit -> bool * (float * list string).
host_env_entries : unit -> bool * (float * list string).

(** a path, its last part not followed: [kind, exec] ("file", "dir",
    "symlink", "other" or "none"; whether its owner may run it).
    node_path.soma's probe walks a path's parts with it. *)
host_path_stat : string -> bool * (float * list string).

(** processes: PROG STDIN CWD ENV ARGS run from CWD ("" for where the
    binary is) with that environment, its standard input from the file
    STDIN ("" for none; node_git.soma's spawn_fed makes the file and
    removes it after the start), its output on a pipe named among the
    descriptors and its errors discarded (found: [its pid, the pipe's
    name]; not found: [why it couldn't start]); a process's end waited
    for ([HOW, VALUE]: exit, signal or stop, and its number); one killed;
    a broken pipe not ending the binary. node_net.soma's jobs and
    node_git.soma's programs run to their end are these. *)
host_spawn : string -> string -> string -> list string -> list string -> bool * (float * list string).
host_wait_pid : string -> bool * (float * list string).
host_kill_pid : string -> bool * (float * list string).
host_no_sigpipe : unit -> bool * (float * list string).

(** `pantheon up`'s (cli.soma's cmd_up and up_wait): PROG LOG ARGS started
    with its output and errors appended to LOG ([its pid]), and from then
    on, an interrupt or a terminate terminates those PIDS and ends the
    command with 0 *)
host_start_logged : string -> string -> list string -> bool * (float * list string).
host_stop_on_signal : list string -> bool * (float * list string).

(** the host's sockets, by name (node_net.soma keeps the node's listener,
    links and buffers, and the service's clients, and decides what each
    select's answer becomes): a listener on HOST PORT BACKLOG ([its
    name], or not found and why), a dial that doesn't wait ([its name,
    "connected" or "connecting"]), one select of MS milliseconds over
    names to read and to write ((true, (those ready to read, those
    ready to write)), none when interrupted; (false, ([why], [])) when
    the select failed), an accept (NONBLOCK "true": the connection doesn't
    block; [its name, the peer's address]), a read (["bytes", DATA],
    ["again"] or ["closed"]), a write (["wrote", COUNT], ["again"] or
    ["failed"]), a dial's outcome (found: it failed) and a close *)
host_sock_listen : string -> string -> string -> bool * (float * list string).
host_sock_dial : string -> string -> bool * (float * list string).
host_sock_select : string -> list string -> list string -> bool * (list string * list string).
host_sock_accept : string -> string -> bool * (float * list string).
host_sock_read : string -> bool * (float * list string).
host_sock_write : string -> string -> bool * (float * list string).
host_sock_error : string -> bool * (float * list string).
host_sock_close : string -> bool * (float * list string).

(** A job's buffered read chunks, in order, are the node's: Soma's
    job_feed appends the chunk the shell just read and, past the output
    cap, keeps the tail; when the feed says the job printed too much, the
    kernel kills it once (IoJobFlood, node_host.soma). Connection
    admission, the buffered-line cap and a connection's buffered bytes
    are Soma's (node.soma admit_decision_of, conn_admit_plan,
    peer_line_cap, feed_chunks; node_kernel.soma keeps the live
    connections and their last-activity times). A decided merge's
    checkout work is the kernel's (node_host.soma, over git and the path
    operations); node.soma's merge_prog decides it. The edits machinery
    is cli.soma's (edits_prog, checkout_edits_prog and check_tree_prog).
    Reading the bytes, accepting, writing and closing stay here. *)
