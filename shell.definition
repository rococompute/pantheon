(** What Soma takes the shell to be. shell.ml does the host's I/O: the
    kernel's eight primitives (node_kernel.soma: listen, wait for the
    mailbox, connect, send, close; read, write and append a named file),
    the clock, git, paths, processes and the commands' I/O. The Soma files
    decide everything, including the node's tables, peer links, timers
    and signatures (node_kernel.soma) and what its checkouts, model calls,
    checks and CI ask of the host (node_host.soma), and Rocq's kernel never
    computes these, so to a proof each is an assumption: soma explore
    lists them. *)
OCaml Library "cryptokit".

(** sha256, hash_list and RSA signing are Soma's (util.soma and nodeio.soma,
    through Soma.Crypto); the binary runs shell.ml's, Cryptokit's, the same
    functions, about ten times faster (main.soma's Extract Constant). *)

(** A signed transaction is all Soma's: market.soma's decode_tx reads it
    (util.soma's json_tokens), checks the signature with the agent's
    genesis key, which the market keeps from the boot events (nodeio's
    nio_tx_verify, Soma's RSA), and owns the caps. So are JSON tokens,
    floats as text and the job caps (util.soma, node.soma): the binary
    and a unikernel run the same functions. *)

(** Process arguments exclude the executable name. Soma chooses the command. *)
argv : unit -> list string.
(** Test programs print their checks with these. *)
print_lines : list string -> unit.
print_text : string -> unit.
(** The commands are cli.soma's node programs, run through node_io under
    the handle "cli" (their operations need no node). *)

(** The node loop is Soma (node_shell.soma's run_node, the kernel's boot
    and turns): the shell binds only the handle, built from what cli.soma's
    node_setup decided (framed: the settings, the key, exclusions, CI,
    agents, repositories, then the boot events; the shell reads only the
    home, where the node's named files are), and the endless repetition;
    the rest is node_io operations. The handle is a string naming the
    shell's side of the node: its listener and connections. *)
node_open : list string -> string.
(** The node's service (node.soma's service_tick_prog, node_shell.soma's
    run_service) is node_io operations too: "serve_listen" HOST PORT,
    "serve_next" WAIT (the next whole request: its connection, then its
    fields), "serve_reply" CONN FIELDS... (the answer, framed as a request
    is: a frame of frames, Sandbox's). The shell listens, reads and writes;
    Soma checks the token, which operations it answers, and runs them. *)
(** The node's operations (nodeio.soma's node_op) are the kernel's to
    carry out (node_kernel.soma's kernel_run): the consensus snapshot,
    startup's replay, the block and vote logs, timers, the event queue,
    peer links, signing, the draw, the tables and the host's work
    (node_host.soma). It hands the shell, in node_io's wire form
    (nodeio.soma's io_wire), only primitives:
    "net_listen" ADDRESS PORT, "net_mailbox" MS (what the peers'
    connections did within MS: ["opened", CONN, HOST], ["bytes", CONN,
    DATA], ["closed", CONN], framed), "net_connect" ADDRESS PORT MS (the
    connection's name, or not found), "net_send" CONN DATA (a flag: still
    open), "net_close" CONN, "file_read" NAME (found or not), "file_write"
    NAME DURABLE TEXT (DURABLE "true": synced and renamed into place) and
    "file_append" NAME TEXT (synced); "log" TEXT, "clock", "local_time"
    STAMP, "fail" MESSAGE (refusing to start: the message on stderr, exit
    1), "events" "0" (the processes' output and ends, below), and
    nodeio.soma's service_op operations below. *)
(** The answer is nodeio.soma's nanswer: (carried out or the boolean
    read, (a number, data)); an effect's is (true, (0, [])); "clock"
    returns (true, now). *)
node_io : string -> list string -> bool * (float * list string).
(** "local_time" STAMP (node_float_wire's text) [HH:MM], for the status
    file; its other facts are the kernel's. *)
forever : forall {A : Type}, (A -> A) -> A -> unit.

(** The host's primitives (nodeio.soma's service_op: what a unikernel
    asks its service for), which need no node; none decides anything:
    "dir_entries" PATH, "read_text" PATH (found or not), "discard_file" PATH (removed, if it's
    there), "self_exe", "env_entries", "token" (a fresh fence token).
    Processes: "proc_start" PROG STDIN CWD ("field" ENTRY)... "alternate"
    ARGS... (PROG run from CWD with that environment, STDIN its standard
    input from a file: found, [its name]; not found, [why it couldn't
    start]), "proc_kill" JOB (killed, and it ends at the next look without
    waiting for its pipe), and "events" "0" giving their output as it comes
    (["job_bytes", JOB, CHUNK]) and their ends (["job_ended", JOB, HOW,
    VALUE]: exit, signal or stop, and its number), framed; "run" PROG
    ARGS... (run to its end with the user's environment: [its output],
    found when it succeeded); "temp_file" PREFIX SUFFIX TEXT (a new private
    file with TEXT in it: [path]). What a job is for, its limit, what goes
    with it and what its end becomes are node_host.soma's. *)
(** A job's buffered read chunks, in order, are the node's: Soma's
    job_feed appends the chunk the shell just read and, past the output
    cap, keeps the tail; when the feed says the job printed too much, the
    kernel kills it once (IoJobFlood, node_host.soma). Reading the bytes
    stays here. *)

(** Connection admission, the buffered-line cap and a connection's
    buffered bytes are Soma's (node.soma admit_decision_of, conn_admit_plan,
    peer_line_cap, feed_chunks; node_kernel.soma keeps the live
    connections and their last-activity times). The shell only accepts,
    reads, writes and closes sockets, as the kernel's primitives. *)

(** A decided merge's checkout work is the kernel's (node_host.soma, over
    "git", "git_env" and the path operations below); node.soma's
    merge_prog decides it. *)

(** The edits machinery's work is node_io operations that need no node
    (nodeio.soma's IoPathStat ... IoGitEnv; cli.soma's edits_prog,
    checkout_edits_prog and check_tree_prog decide): "path_stat" PATH
    [kind, exec] (its last part not followed), "path_probe" DIR PATH
    [kind: "symlink", "dir", "file" or "none"], "path_write" DIR PATH TEXT
    (keeping the mode) and
    "path_remove" DIR PATH ["" or what went wrong], "temp_dir" PREFIX
    [path], "remove_tree" PATH (later, in the background), "git" DIR
    ARGS... and "git_env" DIR STDIN ("field" ENTRY)... "alternate" ARGS...
    (git with no user or system config, no hooks and no signing; with
    those environment entries first and STDIN its standard input, "" for
    none: [its output], found when it succeeded). *)
